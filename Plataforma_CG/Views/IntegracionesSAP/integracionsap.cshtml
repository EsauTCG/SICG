@model Plataforma_CG.ViewModels.IntegracionSapIndexVM
@using System.Linq
@removeTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Integraciones SAP";

    var rows = Model.Rows ?? new List<Plataforma_CG.ViewModels.IntegracionSapRowVM>();
    var tipo = Model.Filtro.Tipo ?? "ENTRADA";
    var src = Model.Filtro.Source ?? "P1";
    var desdeTxt = Model.Filtro.Desde.ToString("yyyy-MM-dd");
    var hastaTxt = Model.Filtro.Hasta.ToString("yyyy-MM-dd");

    // Cada documento cae en UN solo estado, con la misma prioridad que la etiqueta de la tabla.
    // (Antes las bloqueadas también se contaban como pendientes o enviadas y los totales no cuadraban.)
    Func<Plataforma_CG.ViewModels.IntegracionSapRowVM, string> estadoDe = x =>
        x.TieneErrorConfiguracion ? "bloqueada"
        : x.Enviado ? "enviada"
        : x.UltimoExitoso == false ? "fallida"
        : "pendiente";

    var total = rows.Count;
    var bloqueadas = rows.Count(x => estadoDe(x) == "bloqueada");
    var enviados = rows.Count(x => estadoDe(x) == "enviada");
    var fallidos = rows.Count(x => estadoDe(x) == "fallida");
    var pendientes = rows.Count(x => estadoDe(x) == "pendiente");
    var limiteAlcanzado = total >= 500;

    var tipoNombre = tipo == "SALIDA" ? "Salidas de mercancía"
        : tipo == "TRANSFERENCIA_ENTRADA" ? "Transferencias de entrada"
        : "Entradas de mercancía";
    var plantaNombre = src == "TIF" ? "Planta TIF" : "Planta 1";
}

<style>
    /* =====================================================================
       INTEGRACIONES SAP · SIGO — hoja de estilos única (mismo sistema visual
       que Entregas SAP y Costeo). Sustituye las capas anteriores y
       integraciones-sap-erp-final.css. Incluye modo oscuro del layout.
       ===================================================================== */
    :root {
        --es-tinto: #8d3e46;
        --es-tinto-deep: #5c2229;
        --es-tinto-soft: #f7eced;
        --es-tinto-line: #e8d3d6;
        --es-paper: #f6f4f4;
        --es-surface: #ffffff;
        --es-field: #ffffff;
        --es-head: #faf7f7;
        --es-hover: #fcf9f9;
        --es-row-line: #f0eaeb;
        --es-ink: #231a1c;
        --es-muted: #76686b;
        --es-line: #e6dfe0;
        --es-line-strong: #cfc4c6;
        --es-ok: #2f7a55;
        --es-ok-bg: #e7f3ec;
        --es-warn: #9a6410;
        --es-warn-bg: #fbf1de;
        --es-bad: #b42d2d;
        --es-bad-bg: #fbe9e8;
        --es-info: #2f5d86;
        --es-info-bg: #e9f0f7;
        --es-neutral: #6b6466;
        --es-neutral-bg: #efecec;
        --es-font: "Poppins", "Segoe UI", system-ui, -apple-system, Arial, sans-serif;
        --es-mono: ui-monospace, "Cascadia Mono", Consolas, monospace;
    }

    body[data-theme="dark"] {
        --es-tinto: #c56b74;
        --es-tinto-deep: #7a2d36;
        --es-tinto-soft: #3a2427;
        --es-tinto-line: #5a3439;
        --es-paper: #16181c;
        --es-surface: #202328;
        --es-field: #181a1e;
        --es-head: #262a30;
        --es-hover: #2a2e34;
        --es-row-line: #30343b;
        --es-ink: #edf0f3;
        --es-muted: #a9b0b9;
        --es-line: #363b43;
        --es-line-strong: #4a5059;
        --es-ok: #6cc596;
        --es-ok-bg: #1d3328;
        --es-warn: #e0b061;
        --es-warn-bg: #3a2f1b;
        --es-bad: #f08a83;
        --es-bad-bg: #3d2223;
        --es-info: #8bb8e0;
        --es-info-bg: #1e2b38;
        --es-neutral: #b9c0c9;
        --es-neutral-bg: #2c3036;
    }

    /* Ajuste heredado: el módulo ocupa todo el ancho que deja el sidebar de _Layout2. */
    .container, .container-fluid { max-width: 100% !important; }

    .esap { font-family: var(--es-font); color: var(--es-ink); font-size: 13px; line-height: 1.4; background: var(--es-paper); padding: 16px 18px 10px; min-height: calc(100dvh - 60px); }
    .esap *, .es-dialog * { box-sizing: border-box; }
    .es-muted { color: var(--es-muted); }
    .es-num { font-variant-numeric: tabular-nums; }

    /* ---------- Encabezado ---------- */
    .es-header { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 14px; }
    .es-header__title { display: flex; align-items: center; gap: 12px; }
    .es-header__icon { width: 40px; height: 40px; border-radius: 10px; display: grid; place-items: center; background: var(--es-tinto); color: #fff; font-size: 17px; }
    .es-header h1 { margin: 0; font-size: 20px; font-weight: 700; letter-spacing: -.01em; line-height: 1.15; }
    .es-header p { margin: 2px 0 0; font-size: 12px; color: var(--es-muted); }
    .es-chips { display: flex; gap: 6px; flex-wrap: wrap; }
    .es-chip { display: inline-flex; align-items: center; gap: 6px; height: 28px; padding: 0 11px; border: 1px solid var(--es-line); border-radius: 999px; background: var(--es-surface); font-size: 12px; font-weight: 500; white-space: nowrap; max-width: 340px; overflow: hidden; text-overflow: ellipsis; }
    .es-chip i { color: var(--es-tinto); }

    /* ---------- Tipos de integración ---------- */
    .es-types { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin-bottom: 12px; }
    .es-type { display: grid; grid-template-columns: 38px minmax(0, 1fr); gap: 12px; align-items: center; padding: 12px 14px; border: 1px solid var(--es-line); border-radius: 10px; background: var(--es-surface); color: var(--es-ink); text-decoration: none; transition: border-color .12s, background .12s; }
    .es-type:hover { border-color: var(--es-tinto-line); background: var(--es-hover); color: var(--es-ink); }
    .es-type:focus-visible { outline: 2px solid var(--es-tinto); outline-offset: 2px; }
    .es-type.is-active { border-color: var(--es-tinto); box-shadow: inset 0 0 0 1px var(--es-tinto); background: var(--es-tinto-soft); }
    .es-type__icon { width: 38px; height: 38px; border-radius: 9px; display: grid; place-items: center; background: var(--es-tinto-soft); color: var(--es-tinto); font-size: 15px; }
    .es-type.is-active .es-type__icon { background: var(--es-tinto); color: #fff; }
    .es-type__name { display: block; font-size: 14px; font-weight: 600; }
    .es-type__desc { display: block; font-size: 12px; color: var(--es-muted); }
    .es-type__meta { display: block; margin-top: 3px; font-size: 11px; color: var(--es-muted); font-family: var(--es-mono); }

    /* ---------- Tarjetas ---------- */
    .es-card { background: var(--es-surface); border: 1px solid var(--es-line); border-radius: 10px; margin-bottom: 12px; }

    /* ---------- Controles ---------- */
    .es-label { display: block; margin: 0 0 5px; font-size: 12px; font-weight: 600; color: var(--es-muted); white-space: nowrap; }
    .es-input { display: block; width: 100%; height: 36px; padding: 0 10px; border: 1px solid var(--es-line-strong); border-radius: 7px; background: var(--es-field); color: var(--es-ink); font: 500 13px/1 var(--es-font); transition: border-color .12s, box-shadow .12s; }
    .es-input:focus { outline: none; border-color: var(--es-tinto); box-shadow: 0 0 0 3px rgba(141,62,70,.16); }
    body[data-theme="dark"] .es-input { color-scheme: dark; }

    .es-btn { display: inline-flex; align-items: center; justify-content: center; gap: 6px; height: 36px; padding: 0 14px; border: 1px solid var(--es-line-strong); border-radius: 7px; background: var(--es-field); color: var(--es-ink); font: 600 12.5px/1 var(--es-font); white-space: nowrap; cursor: pointer; text-decoration: none; transition: background .12s, border-color .12s, color .12s; }
    .es-btn:hover { background: var(--es-tinto-soft); border-color: var(--es-tinto-line); color: var(--es-ink); }
    .es-btn:focus-visible { outline: 2px solid var(--es-tinto); outline-offset: 2px; }
    .es-btn:disabled { opacity: .5; cursor: not-allowed; }
    .es-btn--primary { background: var(--es-tinto); border-color: var(--es-tinto); color: #fff; }
    .es-btn--primary:hover { background: var(--es-tinto-deep); border-color: var(--es-tinto-deep); color: #fff; }
    .es-btn--sm { height: 28px; padding: 0 10px; font-size: 11.5px; gap: 5px; border-radius: 6px; }
    .es-btn--ghost { background: transparent; border-color: transparent; }
    .es-count { min-width: 20px; height: 20px; padding: 0 6px; border-radius: 999px; display: inline-grid; place-items: center; background: rgba(255,255,255,.25); font-size: 11px; font-variant-numeric: tabular-nums; }

    .es-toggle .es-dot { width: 8px; height: 8px; border-radius: 50%; background: #bdb2b4; flex: none; }
    .es-toggle.is-on { background: var(--es-ok-bg); border-color: var(--es-ok); color: var(--es-ok); }
    .es-toggle.is-on .es-dot { background: var(--es-ok); box-shadow: 0 0 0 3px rgba(47,122,85,.2); }
    .es-toggle.is-busy .es-dot { background: var(--es-warn); }
    .es-toggle.is-error { border-color: var(--es-bad); color: var(--es-bad); }
    .es-auto-text { font-size: 12px; color: var(--es-muted); white-space: nowrap; }

    /* ---------- Filtros ---------- */
    .es-filters { display: grid; grid-template-columns: 150px 210px 150px 150px 150px 130px auto; gap: 10px 12px; align-items: end; padding: 12px 14px; margin: 0; }
    .es-filters__actions { display: flex; gap: 8px; }
    .es-limit { margin: 0 14px 12px; }

    /* ---------- Estado (barra + indicadores) ---------- */
    .es-status { padding: 14px; }
    .es-status__bar { display: flex; height: 10px; border-radius: 999px; overflow: hidden; background: var(--es-neutral-bg); margin-bottom: 12px; }
    .es-status__bar span { display: block; height: 100%; }
    .es-status__bar .s-ok { background: var(--es-ok); }
    .es-status__bar .s-pend { background: #c9bfc1; }
    .es-status__bar .s-fail { background: var(--es-bad); }
    .es-status__bar .s-block { background: #d9a24a; }
    .es-kpis { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 8px; }
    .es-kpi { display: flex; flex-direction: column; gap: 2px; padding: 10px 12px; border: 1px solid var(--es-line); border-radius: 8px; background: var(--es-surface); text-align: left; font-family: var(--es-font); color: var(--es-ink); cursor: pointer; transition: border-color .12s, background .12s; }
    .es-kpi:hover { border-color: var(--es-tinto-line); background: var(--es-hover); }
    .es-kpi:focus-visible { outline: 2px solid var(--es-tinto); outline-offset: 2px; }
    .es-kpi.is-active { border-color: var(--es-tinto); box-shadow: inset 0 0 0 1px var(--es-tinto); background: var(--es-tinto-soft); }
    .es-kpi__label { display: flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 600; color: var(--es-muted); }
    .es-kpi__label::before { content: ""; width: 8px; height: 8px; border-radius: 2px; background: var(--k, var(--es-neutral)); }
    .es-kpi strong { font-size: 24px; font-weight: 700; line-height: 1.1; font-variant-numeric: tabular-nums; }
    .es-kpi small { font-size: 11px; color: var(--es-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .es-kpi--total { --k: var(--es-ink); }
    .es-kpi--ok { --k: var(--es-ok); }
    .es-kpi--pend { --k: #b9adb0; }
    .es-kpi--fail { --k: var(--es-bad); }
    .es-kpi--block { --k: #d9a24a; }

    /* ---------- Tabla ---------- */
    .es-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; padding: 10px 14px; border-bottom: 1px solid var(--es-line); }
    .es-toolbar__left, .es-toolbar__right { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .es-search { position: relative; width: 300px; max-width: 100%; }
    .es-search i { position: absolute; left: 10px; top: 50%; transform: translateY(-50%); color: var(--es-muted); font-size: 12px; pointer-events: none; }
    .es-search .es-input { padding-left: 30px; }
    .es-divider { width: 1px; height: 22px; background: var(--es-line); margin: 0 2px; }

    .es-table-wrap { overflow: auto; max-height: calc(100dvh - 430px); min-height: 240px; }
    .es-table { width: 100%; min-width: 1180px; border-collapse: separate; border-spacing: 0; font-size: 12.5px; }
    .es-table thead th { position: sticky; top: 0; z-index: 2; padding: 9px 10px; background: var(--es-head); border-bottom: 1px solid var(--es-line); color: var(--es-muted); font-size: 11.5px; font-weight: 600; text-align: left; white-space: nowrap; }
    .es-table tbody td { padding: 8px 10px; border-bottom: 1px solid var(--es-row-line); vertical-align: middle; white-space: nowrap; }
    .es-table tbody tr:hover td { background: var(--es-hover); }
    .es-table tr[hidden] { display: none; }
    .es-table .text-end { text-align: right; }
    .es-table input[type="checkbox"] { width: 15px; height: 15px; margin: 0; accent-color: var(--es-tinto); cursor: pointer; }
    .es-table input[type="checkbox"]:disabled { cursor: not-allowed; opacity: .4; }
    .es-table tbody tr.is-selected td { background: var(--es-tinto-soft); }
    .es-table tbody tr.is-selected td:first-child { box-shadow: inset 3px 0 0 var(--es-tinto); }
    .es-table tbody tr[data-state="fallida"]:not(.is-selected) td:first-child { box-shadow: inset 3px 0 0 var(--es-bad); }
    .es-table tbody tr[data-state="bloqueada"]:not(.is-selected) td:first-child { box-shadow: inset 3px 0 0 #d9a24a; }
    .c-check { width: 44px; text-align: center !important; }
    .c-ref, .c-partner { max-width: 220px; overflow: hidden; text-overflow: ellipsis; }
    .c-actions { text-align: right !important; }
    .es-row-actions { display: flex; justify-content: flex-end; gap: 4px; }
    .es-empty { display: flex; flex-direction: column; align-items: center; gap: 6px; padding: 40px 10px; color: var(--es-muted); white-space: normal; }
    .es-empty i { font-size: 24px; color: var(--es-line-strong); }
    .es-nomatch { padding: 18px 14px; color: var(--es-muted); text-align: center; border-top: 1px solid var(--es-line); }

    .es-pill { display: inline-flex; align-items: center; gap: 6px; height: 22px; padding: 0 9px; border-radius: 999px; font-size: 11.5px; font-weight: 600; white-space: nowrap; background: var(--es-neutral-bg); color: var(--es-neutral); }
    .es-pill::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentColor; flex: none; }
    .es-pill--ok { background: var(--es-ok-bg); color: var(--es-ok); }
    .es-pill--bad { background: var(--es-bad-bg); color: var(--es-bad); }
    .es-pill--warn { background: var(--es-warn-bg); color: var(--es-warn); }
    .es-pill--info { background: var(--es-info-bg); color: var(--es-info); }
    .es-pill--info::before { display: none; }
    .es-pill[title] { cursor: help; }

    .es-footnote { display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; padding: 10px 14px; border-top: 1px solid var(--es-line); font-size: 12px; color: var(--es-muted); }
    .es-footnote strong { color: var(--es-ink); font-weight: 600; }

    .es-alert { display: flex; align-items: flex-start; gap: 10px; padding: 10px 12px; border-radius: 8px; border: 1px solid; font-size: 12.5px; }
    .es-alert--warn { background: var(--es-warn-bg); border-color: #ecd3a5; color: var(--es-warn); }

    .es-spin { display: inline-block; width: 13px; height: 13px; border: 2px solid currentColor; border-right-color: transparent; border-radius: 50%; animation: es-spin .8s linear infinite; }
    @@keyframes es-spin { to { transform: rotate(360deg); } }

    /* ---------- Modal JSON (propio, no Bootstrap) ---------- */
    .es-backdrop { position: fixed; inset: 0; z-index: 3000; display: none; align-items: center; justify-content: center; padding: 18px; background: rgba(20, 10, 12, .55); }
    .es-backdrop.open { display: flex; }
    .es-dialog { width: min(980px, 96vw); max-height: 88vh; display: flex; flex-direction: column; border-radius: 12px; overflow: hidden; background: var(--es-surface); color: var(--es-ink); font-family: var(--es-font); box-shadow: 0 22px 70px rgba(0,0,0,.35); }
    .es-dialog__head { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 14px 18px; background: var(--es-tinto-deep); color: #fff; font-size: 15px; font-weight: 600; }
    .es-dialog__close { width: 30px; height: 30px; border: 0; border-radius: 7px; background: rgba(255,255,255,.12); color: #fff; cursor: pointer; }
    .es-dialog__close:hover { background: rgba(255,255,255,.22); }
    .es-dialog__body { overflow: auto; padding: 14px 18px; }
    .es-json { min-height: 300px; margin: 0; padding: 14px; overflow: auto; border-radius: 8px; background: #1e1a1b; color: #f3ecec; font: 12px/1.5 var(--es-mono); white-space: pre-wrap; word-break: break-word; }
    .es-dialog__foot { display: flex; justify-content: flex-end; gap: 8px; padding: 12px 18px; border-top: 1px solid var(--es-line); background: var(--es-head); }

    /* ---------- Avisos ---------- */
    .es-toasts { position: fixed; right: 16px; bottom: 16px; z-index: 5000; display: grid; gap: 8px; width: min(430px, calc(100vw - 32px)); }
    .es-toast { position: relative; padding: 11px 38px 11px 14px; border: 1px solid var(--es-line); border-left: 5px solid var(--es-info); border-radius: 10px; background: var(--es-surface); color: var(--es-ink); box-shadow: 0 10px 30px rgba(0,0,0,.2); font-family: var(--es-font); font-size: 12.5px; line-height: 1.45; white-space: pre-wrap; word-break: break-word; }
    .es-toast.ok { border-left-color: var(--es-ok); background: var(--es-ok-bg); }
    .es-toast.error { border-left-color: var(--es-bad); background: var(--es-bad-bg); }
    .es-toast.info { border-left-color: var(--es-info); background: var(--es-info-bg); }
    .es-toast button { position: absolute; top: 6px; right: 8px; border: 0; background: transparent; color: inherit; font-size: 20px; line-height: 1; cursor: pointer; }

    @@media (prefers-reduced-motion: reduce) { .es-spin { animation-duration: 2s; } }

    /* ---------- Responsive ---------- */
    @@media (max-width: 1300px) {
        .es-filters { grid-template-columns: repeat(3, minmax(0, 1fr)); }
        .es-filters__actions { grid-column: 1 / -1; justify-content: flex-end; }
        .es-row-actions .es-btn-label { display: none; }
    }
    @@media (max-width: 900px) {
        .es-types { grid-template-columns: 1fr; }
        .es-kpis { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    }
    @@media (max-width: 640px) {
        .esap { padding: 10px; }
        .es-filters { grid-template-columns: 1fr 1fr; }
        .es-kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .es-search { width: 100%; }
        .es-backdrop { padding: 0; }
        .es-dialog { width: 100vw; max-height: 100dvh; min-height: 100dvh; border-radius: 0; }
    }
</style>

<div class="esap" id="esApp">

    <header class="es-header">
        <div class="es-header__title">
            <span class="es-header__icon"><i class="fa-solid fa-arrows-rotate"></i></span>
            <div>
                <h1>Integraciones de inventario SAP</h1>
                <p>Consulta, valida y envía movimientos de mercancía de Meat a SAP Business One</p>
            </div>
        </div>
        <div class="es-chips">
            <span class="es-chip"><i class="fa-solid fa-industry"></i> @plantaNombre</span>
            <span class="es-chip"><i class="fa-solid fa-database"></i> @Model.BaseDatos</span>
            <span class="es-chip" title="@Model.Endpoint"><i class="fa-solid fa-link"></i> @Model.Endpoint</span>
        </div>
    </header>

    <!-- Tipo de integración -->
    <nav class="es-types" aria-label="Tipo de integración">
        <a class="es-type @(tipo == "ENTRADA" ? "is-active" : null)" aria-current="@(tipo == "ENTRADA" ? "page" : null)"
           href="@Url.Action("Index", "IntegracionesSap", new { source = src, tipo = "ENTRADA", desde = desdeTxt, hasta = hastaTxt })">
            <span class="es-type__icon"><i class="fa-solid fa-arrow-right-to-bracket"></i></span>
            <span>
                <span class="es-type__name">Entrada de mercancía</span>
                <span class="es-type__desc">Recepción basada o no en orden de compra</span>
                <span class="es-type__meta">PurchaseDeliveryNotes · Tipo 1</span>
            </span>
        </a>
        <a class="es-type @(tipo == "TRANSFERENCIA_ENTRADA" ? "is-active" : null)" aria-current="@(tipo == "TRANSFERENCIA_ENTRADA" ? "page" : null)"
           href="@Url.Action("Index", "IntegracionesSap", new { source = "P1", tipo = "TRANSFERENCIA_ENTRADA", desde = desdeTxt, hasta = hastaTxt })">
            <span class="es-type__icon"><i class="fa-solid fa-truck-ramp-box"></i></span>
            <span>
                <span class="es-type__name">Transferencia de entrada</span>
                <span class="es-type__desc">Transferencias recibidas en Planta 1</span>
                <span class="es-type__meta">PurchaseDeliveryNotes · Tipo 2</span>
            </span>
        </a>
        <a class="es-type @(tipo == "SALIDA" ? "is-active" : null)" aria-current="@(tipo == "SALIDA" ? "page" : null)"
           href="@Url.Action("Index", "IntegracionesSap", new { source = src, tipo = "SALIDA", desde = desdeTxt, hasta = hastaTxt })">
            <span class="es-type__icon"><i class="fa-solid fa-arrow-right-from-bracket"></i></span>
            <span>
                <span class="es-type__name">Salida de mercancía</span>
                <span class="es-type__desc">Salida de inventario por líneas, lotes y ubicaciones</span>
                <span class="es-type__meta">InventoryGenExits · Cuenta @Model.CuentaSalida · Tipo 4</span>
            </span>
        </a>
    </nav>

    <!-- Filtros -->
    <section class="es-card">
        <form method="get" action="@Url.Action("Index", "IntegracionesSap")" class="es-filters" id="frmFiltros">
            <div>
                <label class="es-label" for="fSource">Planta / base de datos</label>
                <select id="fSource" name="source" class="es-input">
                    <option value="P1" selected="@(src == "P1")">Planta 1</option>
                    <option value="TIF" selected="@(src == "TIF")">Planta TIF</option>
                </select>
            </div>
            <div>
                <label class="es-label" for="fTipo">Tipo de integración</label>
                <select id="fTipo" name="tipo" class="es-input">
                    <option value="ENTRADA" selected="@(tipo == "ENTRADA")">Entrada de mercancía</option>
                    <option value="TRANSFERENCIA_ENTRADA" selected="@(tipo == "TRANSFERENCIA_ENTRADA")">Transferencia de entrada</option>
                    <option value="SALIDA" selected="@(tipo == "SALIDA")">Salida de mercancía</option>
                </select>
            </div>
            <div>
                <label class="es-label" for="fDesde">Desde</label>
                <input id="fDesde" type="date" name="desde" class="es-input" value="@desdeTxt" />
            </div>
            <div>
                <label class="es-label" for="fHasta">Hasta</label>
                <input id="fHasta" type="date" name="hasta" class="es-input" value="@hastaTxt" />
            </div>
            <div>
                <label class="es-label" for="fEstatus">Estatus en Meat</label>
                <select id="fEstatus" name="estatus" class="es-input">
                    <option value="" selected="@(Model.Filtro.Estatus == null)">Todos</option>
                    <option value="0" selected="@(Model.Filtro.Estatus == 0)">Pendientes</option>
                    <option value="1" selected="@(Model.Filtro.Estatus == 1)">Procesados</option>
                </select>
            </div>
            <div>
                <label class="es-label" for="fFolio">Folio</label>
                <input id="fFolio" type="number" name="folio" class="es-input" value="@(Model.Filtro.Folio?.ToString() ?? "")" placeholder="Todos" />
            </div>
            <div class="es-filters__actions">
                <button class="es-btn es-btn--primary" type="submit"><i class="fa-solid fa-magnifying-glass"></i> Consultar</button>
                <a class="es-btn" href="@Url.Action("Index", "IntegracionesSap", new { source = src, tipo = tipo })" title="Quitar filtros de fecha, estatus y folio">
                    <i class="fa-solid fa-eraser"></i> Limpiar
                </a>
            </div>
        </form>
        @if (limiteAlcanzado)
        {
            <div class="es-alert es-alert--warn es-limit">
                <i class="fa-solid fa-triangle-exclamation"></i>
                <div>La consulta llegó al máximo de 500 registros, así que puede haber más documentos. Acota el rango de fechas o filtra por estatus para verlos todos.</div>
            </div>
        }
    </section>

    <!-- Estado (clic en un indicador = filtrar la tabla) -->
    <section class="es-card es-status" aria-label="Resumen de integraciones">
        @{
            Func<int, string> pct = n => total > 0 ? (n * 100.0 / total).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "%" : "0%";
        }
        <div class="es-status__bar" title="Proporción de documentos por estatus">
            <span class="s-ok" style="width:@pct(enviados)"></span>
            <span class="s-pend" style="width:@pct(pendientes)"></span>
            <span class="s-fail" style="width:@pct(fallidos)"></span>
            <span class="s-block" style="width:@pct(bloqueadas)"></span>
        </div>
        <div class="es-kpis">
            <button type="button" class="es-kpi es-kpi--total" data-filter="todos">
                <span class="es-kpi__label">Documentos</span>
                <strong>@total.ToString("N0")</strong>
                <small>Resultado del filtro actual</small>
            </button>
            <button type="button" class="es-kpi es-kpi--ok" data-filter="enviada">
                <span class="es-kpi__label">Enviados</span>
                <strong>@enviados.ToString("N0")</strong>
                <small>Procesados en SAP</small>
            </button>
            <button type="button" class="es-kpi es-kpi--pend" data-filter="pendiente">
                <span class="es-kpi__label">Pendientes</span>
                <strong>@pendientes.ToString("N0")</strong>
                <small>Listos para enviar</small>
            </button>
            <button type="button" class="es-kpi es-kpi--fail" data-filter="fallida">
                <span class="es-kpi__label">Fallidos</span>
                <strong>@fallidos.ToString("N0")</strong>
                <small>SAP rechazó el último intento</small>
            </button>
            <button type="button" class="es-kpi es-kpi--block" data-filter="bloqueada">
                <span class="es-kpi__label">Bloqueados</span>
                <strong>@bloqueadas.ToString("N0")</strong>
                <small>Sin líneas o ubicación sin resolver</small>
            </button>
        </div>
    </section>

    <!-- Documentos -->
    <section class="es-card">
        @Html.AntiForgeryToken()

        <div class="es-toolbar">
            <div class="es-toolbar__left">
                <div class="es-search">
                    <i class="fa-solid fa-filter"></i>
                    <input id="txtBuscarTabla" type="search" class="es-input" placeholder="Filtrar por ID, folio, referencia o proveedor" autocomplete="off" />
                </div>
                <span class="es-muted">Mostrando <strong class="es-num" id="visibleCount">0 de 0</strong></span>
            </div>
            <div class="es-toolbar__right">
                <button type="button" class="es-btn es-toggle is-busy" id="btnAuto" disabled aria-pressed="false" title="Consultando estado del envío automático…">
                    <span class="es-dot"></span> Envío automático
                </button>
                <span class="es-auto-text" id="autoStatusText">Consultando…</span>
                <span class="es-divider"></span>
                <button type="button" class="es-btn" id="btnSelectPending" title="Selecciona los pendientes y fallidos visibles">
                    <i class="fa-solid fa-check-double"></i> Seleccionar enviables
                </button>
                <button type="button" class="es-btn es-btn--primary" id="btnSendSelected" disabled>
                    <i class="fa-solid fa-paper-plane"></i> Enviar seleccionadas <span class="es-count" id="selectedCount">0</span>
                </button>
            </div>
        </div>

        <div class="es-table-wrap">
            <table class="es-table" id="tblIntegraciones">
                <thead>
                    <tr>
                        <th class="c-check"><input type="checkbox" id="checkAll" aria-label="Seleccionar todos los enviables visibles" /></th>
                        <th>ID</th>
                        <th>Fecha</th>
                        <th>Folio</th>
                        <th>Referencia</th>
                        <th>Proveedor</th>
                        <th class="text-end">Líneas</th>
                        <th class="text-end">Lotes</th>
                        <th>Cuenta</th>
                        <th>Estatus</th>
                        <th>Documento SAP</th>
                        <th class="c-actions">Acciones</th>
                    </tr>
                </thead>
                <tbody id="tbodyIntegraciones">
                    @if (rows.Count == 0)
                    {
                        <tr>
                            <td colspan="12">
                                <div class="es-empty">
                                    <i class="fa-solid fa-inbox"></i>
                                    <div>No hay integraciones con estos filtros. Amplía el rango de fechas o cambia el estatus.</div>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var row in rows)
                        {
                            var estado = estadoDe(row);
                            var enviable = estado == "pendiente" || estado == "fallida";
                            var proveedor = row.SocioNegocio ?? (tipo == "SALIDA" ? "No aplica" : "-");
                            var bloqueoMotivo = row.UbicacionesSinResolver > 0
                                ? $"{row.UbicacionesSinResolver} ubicación(es) sin resolver"
                                : "Documento sin líneas";

                            <tr data-id="@row.IntegracionId"
                                data-state="@estado"
                                data-enviado="@(row.Enviado ? "1" : "0")"
                                data-blocked="@(row.TieneErrorConfiguracion ? "1" : "0")"
                                data-search="@($"{row.IntegracionId} {row.Folio} {row.Referencia} {row.SocioNegocio}".ToLowerInvariant())">
                                <td class="c-check">
                                    <input type="checkbox" class="row-check" value="@row.IntegracionId" disabled="@(!enviable)"
                                           aria-label="Seleccionar integración @row.IntegracionId" />
                                </td>
                                <td class="es-num"><strong>@row.IntegracionId</strong></td>
                                <td class="es-num">@row.FechaDocumento.ToString("dd/MM/yyyy")</td>
                                <td class="es-num">@(row.Folio?.ToString() ?? "-")</td>
                                <td class="c-ref" title="@row.Referencia">@(row.Referencia ?? "-")</td>
                                <td class="c-partner" title="@proveedor">@proveedor</td>
                                <td class="text-end es-num">@row.CantidadLineas</td>
                                <td class="text-end es-num">@row.CantidadLotes</td>
                                <td class="es-num">@(row.CuentaContable ?? "-")</td>
                                <td>
                                    @if (estado == "bloqueada")
                                    {
                                        <span class="es-pill es-pill--warn" title="@bloqueoMotivo">Bloqueada</span>
                                    }
                                    else if (estado == "enviada")
                                    {
                                        <span class="es-pill es-pill--ok">Enviada</span>
                                    }
                                    else if (estado == "fallida")
                                    {
                                        <span class="es-pill es-pill--bad" title="@row.UltimoMensaje">Falló</span>
                                    }
                                    else
                                    {
                                        <span class="es-pill">Pendiente</span>
                                    }
                                </td>
                                <td>
                                    @if (row.SapDocNum.HasValue || row.SapDocEntry.HasValue)
                                    {
                                        <span class="es-pill es-pill--info es-num" title="DocEntry: @(row.SapDocEntry?.ToString() ?? "-")">
                                            #@(row.SapDocNum?.ToString() ?? row.SapDocEntry?.ToString())
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="es-muted">-</span>
                                    }
                                </td>
                                <td class="c-actions">
                                    <div class="es-row-actions">
                                        <button type="button" class="es-btn es-btn--sm btn-json" data-id="@row.IntegracionId" title="Ver el JSON que se envía a SAP">
                                            <i class="fa-solid fa-code"></i><span class="es-btn-label">JSON</span>
                                        </button>
                                        <button type="button" class="es-btn es-btn--sm es-btn--primary btn-send" data-id="@row.IntegracionId" disabled="@(!enviable)"
                                                title="@(estado == "bloqueada" ? bloqueoMotivo : estado == "enviada" ? "Ya enviada a SAP" : "Enviar a SAP")">
                                            <i class="fa-solid fa-paper-plane"></i><span class="es-btn-label">Enviar</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <div class="es-nomatch" id="esNoMatch" hidden>Ningún documento coincide con el filtro. Quita la búsqueda o elige otro indicador.</div>

        <div class="es-footnote">
            <span>Endpoint activo: <strong>@Model.Endpoint</strong></span>
            <span>
                @if (tipo == "SALIDA")
                {
                    <text>Cada línea se envía con la cuenta <strong>@Model.CuentaSalida</strong>.</text>
                }
                else if (tipo == "TRANSFERENCIA_ENTRADA")
                {
                    <text>Las transferencias tipo 2 se envían como entrada mediante <strong>PurchaseDeliveryNotes</strong>.</text>
                }
                else
                {
                    <text>Las entradas con BaseEntry se generan contra orden de compra.</text>
                }
            </span>
        </div>
    </section>
</div>

<!-- Modal JSON -->
<div class="es-backdrop" id="jsonModal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
    <div class="es-dialog">
        <div class="es-dialog__head">
            <span id="modalTitle">JSON SAP</span>
            <button type="button" class="es-dialog__close" id="btnCloseModal" aria-label="Cerrar"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div class="es-dialog__body">
            <pre class="es-json" id="jsonContent">Cargando…</pre>
        </div>
        <div class="es-dialog__foot">
            <button type="button" class="es-btn" id="btnCopyJson"><i class="fa-solid fa-copy"></i> Copiar JSON</button>
            <button type="button" class="es-btn es-btn--primary" id="btnCloseModal2">Cerrar</button>
        </div>
    </div>
</div>

<div class="es-toasts" id="toastArea" aria-live="polite"></div>

<script>
(() => {
    const SOURCE = '@src';
    const TYPE = '@tipo';
    const ENDPOINT = '@Model.Endpoint';

    // Rutas absolutas para evitar problemas con el enrutamiento por atributos.
    const URL_SEND = '@Url.Content("~/IntegracionesSAP/Enviar")';
    const URL_SEND_BATCH = '@Url.Content("~/IntegracionesSAP/EnviarLote")';
    const URL_JSON = '@Url.Content("~/IntegracionesSAP/Json")';
    const URL_AUTO_STATUS = '@Url.Content("~/IntegracionesSAP/AutomaticoEstado")';
    const URL_AUTO_SET = '@Url.Content("~/IntegracionesSAP/AutomaticoCambiar")';

    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    const $ = id => document.getElementById(id);

    const checkAll = $('checkAll');
    const selectedCount = $('selectedCount');
    const btnSendSelected = $('btnSendSelected');
    const btnSelectPending = $('btnSelectPending');
    const btnAuto = $('btnAuto');
    const autoStatusText = $('autoStatusText');
    const modal = $('jsonModal');
    const modalTitle = $('modalTitle');
    const jsonContent = $('jsonContent');

    let automaticoEstado = { activo: false, procesando: false };
    let envioEnCurso = false; // bloquea envíos simultáneos (individual + lote)
    let filtroEstado = 'todos';
    let filtroTexto = '';

    /* ---------------- Filas, filtros y selección ---------------- */
    const allRows = () => Array.from(document.querySelectorAll('#tbodyIntegraciones tr[data-id]'));
    const visibleRows = () => allRows().filter(r => !r.hidden);
    // Solo checkboxes habilitados de filas visibles.
    const rowChecks = () => visibleRows().map(r => r.querySelector('.row-check')).filter(x => x && !x.disabled);
    const selectedIds = () => allRows()
        .map(r => r.querySelector('.row-check'))
        .filter(x => x && !x.disabled && x.checked)
        .map(x => Number(x.value))
        .filter(x => Number.isInteger(x) && x > 0);

    function aplicarFiltros() {
        const rows = allRows();
        let visibles = 0;
        rows.forEach(r => {
            const ok = (filtroEstado === 'todos' || r.dataset.state === filtroEstado) &&
                (!filtroTexto || (r.dataset.search || '').includes(filtroTexto));
            r.hidden = !ok;
            if (ok) visibles++;
            // Al ocultar una fila se quita su selección para no enviar algo que no se ve.
            if (!ok) {
                const ck = r.querySelector('.row-check');
                if (ck?.checked) { ck.checked = false; r.classList.remove('is-selected'); }
            }
        });
        $('visibleCount').textContent = `${visibles.toLocaleString('es-MX')} de ${rows.length.toLocaleString('es-MX')}`;
        $('esNoMatch').hidden = !(rows.length > 0 && visibles === 0);
        document.querySelectorAll('.es-kpi[data-filter]').forEach(k =>
            k.classList.toggle('is-active', filtroEstado !== 'todos' && k.dataset.filter === filtroEstado));
        updateSelection();
    }

    function updateSelection() {
        const enabled = rowChecks();
        const selected = selectedIds();
        if (selectedCount) selectedCount.textContent = selected.length.toLocaleString('es-MX');
        if (btnSendSelected) btnSendSelected.disabled = selected.length === 0 || envioEnCurso;
        if (checkAll) {
            const marcados = enabled.filter(x => x.checked).length;
            checkAll.checked = enabled.length > 0 && marcados === enabled.length;
            checkAll.indeterminate = marcados > 0 && marcados < enabled.length;
            checkAll.disabled = enabled.length === 0;
        }
    }

    function marcar(ck, on) {
        ck.checked = !!on;
        ck.closest('tr')?.classList.toggle('is-selected', !!on);
    }

    /* ---------------- Avisos ---------------- */
    function toast(message, type = 'info', timeout = 8000) {
        const area = $('toastArea');
        if (!area) return;
        const node = document.createElement('div');
        node.className = `es-toast ${type}`;
        node.setAttribute('role', type === 'error' ? 'alert' : 'status');
        node.textContent = message || '';
        const close = document.createElement('button');
        close.type = 'button';
        close.setAttribute('aria-label', 'Cerrar aviso');
        close.textContent = '×';
        close.addEventListener('click', () => node.remove());
        node.appendChild(close);
        area.appendChild(node);
        if (timeout > 0) window.setTimeout(() => node.remove(), timeout);
    }

    async function parseResponse(response) {
        const text = await response.text();
        if (!text) return { ok: response.ok, status: response.status };
        try { return JSON.parse(text); }
        catch {
            const html = /<html|<!doctype/i.test(text);
            return {
                ok: false, status: response.status,
                msg: html ? 'El servidor regresó una página en lugar de datos. Posible sesión vencida: recarga la página.' : text,
                detalle: html ? '' : text
            };
        }
    }

    function buildErrorMessage(response, data, fallback) {
        const principal = data?.msg || data?.mensaje || data?.message || data?.error || fallback || 'No se pudo completar la operación.';
        const partes = [principal];
        const detalle = data?.detalle || data?.respuestaSap || data?.response || data?.inner;
        if (detalle && detalle !== principal) partes.push(detalle);
        if (response?.status) partes.push(`HTTP ${response.status} ${response.statusText || ''}`.trim());
        return partes.filter(Boolean).join('\n\n');
    }

    function errorUsuario(msg, ms = 20000) { toast(msg, 'error', ms); window.alert(msg); }

    function setBusy(button, busy, busyText = 'Procesando…') {
        if (!button) return;
        if (busy) {
            if (!button.dataset.original) button.dataset.original = button.innerHTML;
            button.disabled = true;
            button.innerHTML = `<span class="es-spin"></span> ${busyText}`;
        } else {
            button.innerHTML = button.dataset.original || button.innerHTML;
            delete button.dataset.original;
            button.disabled = false;
        }
    }

    function bloquearEnvios(on) {
        envioEnCurso = on;
        document.querySelectorAll('.btn-send').forEach(b => {
            if (on) { b.dataset.wasDisabled = b.disabled ? '1' : '0'; b.disabled = true; }
            else if (b.dataset.wasDisabled === '0') b.disabled = false;
        });
        updateSelection();
    }

    /* ---------------- Envío automático ---------------- */
    function renderAutomatico(estado) {
        if (!estado || !btnAuto || !autoStatusText) return;
        automaticoEstado = estado;
        btnAuto.disabled = false;
        btnAuto.classList.remove('is-on', 'is-busy', 'is-error');
        btnAuto.setAttribute('aria-pressed', estado.activo ? 'true' : 'false');

        if (estado.activo) {
            btnAuto.classList.add(estado.procesando ? 'is-busy' : 'is-on');
            btnAuto.title = 'El envío automático está encendido. Presiona para apagarlo.';
            autoStatusText.textContent = estado.procesando ? 'Procesando…' : 'Encendido';
        } else {
            if (estado.procesando) btnAuto.classList.add('is-busy');
            btnAuto.title = 'El envío automático está apagado. Presiona para encenderlo.';
            autoStatusText.textContent = estado.procesando ? 'Terminando envío…' : 'Apagado';
        }
    }

    async function cargarEstadoAutomatico(mostrarError = false) {
        try {
            const response = await fetch(URL_AUTO_STATUS, {
                method: 'GET', credentials: 'same-origin', cache: 'no-store',
                headers: { 'Accept': 'application/json' }
            });
            const data = await parseResponse(response);
            if (!response.ok || data?.ok === false) {
                throw new Error(buildErrorMessage(response, data, 'No se pudo consultar el estado del envío automático.'));
            }
            renderAutomatico(data.estado || data);
        } catch (error) {
            console.error('INTEGRACIÓN SAP - estado automático', error);
            if (btnAuto) {
                btnAuto.disabled = true;
                btnAuto.classList.remove('is-on', 'is-busy');
                btnAuto.classList.add('is-error');
                btnAuto.title = error?.message || String(error);
            }
            if (autoStatusText) autoStatusText.textContent = 'Estado no disponible';
            // Antes se mostraba un alert al cargar; ahora solo un aviso para no interrumpir.
            if (mostrarError) toast(error?.message || String(error), 'error', 15000);
        }
    }

    async function cambiarAutomatico() {
        if (!btnAuto || btnAuto.disabled) return;
        if (!token) { errorUsuario('No se encontró el token de seguridad. Recarga la página e inténtalo de nuevo.', 15000); return; }

        const nuevoEstado = !automaticoEstado.activo;
        if (!window.confirm(`¿Deseas ${nuevoEstado ? 'encender' : 'apagar'} el envío automático de integraciones SAP?\n\nAfecta a todos los usuarios.`)) return;

        btnAuto.disabled = true;
        btnAuto.classList.remove('is-on', 'is-error');
        btnAuto.classList.add('is-busy');
        autoStatusText.textContent = nuevoEstado ? 'Encendiendo…' : 'Apagando…';

        try {
            const response = await fetch(URL_AUTO_SET, {
                method: 'POST', credentials: 'same-origin', cache: 'no-store',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify({ activo: nuevoEstado })
            });
            const data = await parseResponse(response);
            if (!response.ok || data?.ok === false) {
                throw new Error(buildErrorMessage(response, data, 'No se pudo cambiar el envío automático.'));
            }
            renderAutomatico(data.estado || data);
            toast(data?.msg || data?.mensaje || (nuevoEstado ? 'Envío automático encendido.' : 'Envío automático apagado.'), 'ok', 9000);
        } catch (error) {
            console.error('INTEGRACIÓN SAP - cambiar automático', error);
            errorUsuario(error?.message || String(error));
            await cargarEstadoAutomatico(false);
        }
    }

    /* ---------------- Envío individual ---------------- */
    async function sendOne(id, button) {
        if (envioEnCurso) { toast('Hay un envío en proceso. Espera a que termine.', 'info'); return; }
        if (!Number.isInteger(id) || id <= 0) { errorUsuario('El identificador de la integración no es válido.', 15000); return; }
        if (!token) { errorUsuario('No se encontró el token de seguridad. Recarga la página e inténtalo de nuevo.', 15000); return; }
        if (!window.confirm(`¿Enviar la integración ${id} a SAP mediante ${ENDPOINT}?`)) return;

        bloquearEnvios(true);
        setBusy(button, true, 'Enviando');
        let recargar = false;
        try {
            const response = await fetch(URL_SEND, {
                method: 'POST', credentials: 'same-origin', cache: 'no-store',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify({ integracionId: id, source: SOURCE, tipo: TYPE, forzar: false })
            });
            const data = await parseResponse(response);
            console.log('INTEGRACIÓN SAP - respuesta manual', response.status, data);

            if (!response.ok || data?.ok === false) {
                errorUsuario(buildErrorMessage(response, data, 'SAP rechazó la integración.'));
                return;
            }
            const mensaje = data?.mensaje || data?.msg || (data?.yaEnviado ? 'La integración ya estaba enviada.' : 'Integración enviada correctamente a SAP.');
            const documento = data?.docNum ? `\nDocumento SAP: ${data.docNum}` : data?.docEntry ? `\nDocEntry SAP: ${data.docEntry}` : '';
            toast(mensaje + documento, 'ok', 12000);
            recargar = true;
        } catch (error) {
            console.error('INTEGRACIÓN SAP - error manual', error);
            errorUsuario((error?.message || String(error) || 'Error desconocido al enviar la integración.') +
                '\n\nAntes de reintentar, revisa si el documento ya aparece en SAP.');
        } finally {
            setBusy(button, false);
            bloquearEnvios(false);
            if (recargar) window.setTimeout(() => window.location.reload(), 900);
        }
    }

    /* ---------------- Envío por lote ---------------- */
    async function sendBatch(ids) {
        if (envioEnCurso) { toast('Hay un envío en proceso. Espera a que termine.', 'info'); return; }
        ids = Array.from(new Set((ids || []).map(Number).filter(x => Number.isInteger(x) && x > 0)));
        if (!ids.length) { errorUsuario('Selecciona al menos una integración pendiente.', 12000); return; }
        if (!token) { errorUsuario('No se encontró el token de seguridad. Recarga la página e inténtalo de nuevo.', 15000); return; }
        if (!window.confirm(`¿Enviar ${ids.length} integración(es) seleccionada(s) a SAP?`)) return;

        bloquearEnvios(true);
        setBusy(btnSendSelected, true, `Enviando ${ids.length}`);
        let recargar = false;
        try {
            const response = await fetch(URL_SEND_BATCH, {
                method: 'POST', credentials: 'same-origin', cache: 'no-store',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'RequestVerificationToken': token },
                body: JSON.stringify({ integracionIds: ids, source: SOURCE, tipo: TYPE, forzar: false })
            });
            const data = await parseResponse(response);
            console.log('INTEGRACIÓN SAP - respuesta por lote', response.status, data);

            if (!response.ok || data?.ok === false) {
                errorUsuario(buildErrorMessage(response, data, 'No se pudo completar el envío múltiple.'));
                return;
            }
            const fallidos = data?.fallidos || 0;
            const message = `Envío terminado.\nEnviadas: ${data?.enviados || 0}\nYa estaban enviadas: ${data?.yaEnviados || 0}\nFallidas: ${fallidos}`;
            toast(message, fallidos > 0 ? 'error' : 'ok', 15000);
            if (fallidos > 0) window.alert(message + '\n\nRevisa el detalle de las fallidas en la columna Estatus.');
            recargar = true;
        } catch (error) {
            console.error('INTEGRACIÓN SAP - error por lote', error);
            errorUsuario((error?.message || String(error) || 'Error desconocido durante el envío múltiple.') +
                '\n\nAntes de reintentar, recarga la página para ver cuáles sí se enviaron.');
        } finally {
            setBusy(btnSendSelected, false);
            bloquearEnvios(false);
            if (recargar) window.setTimeout(() => window.location.reload(), 1200);
        }
    }

    /* ---------------- JSON ---------------- */
    async function openJson(id) {
        modal?.classList.add('open');
        if (modalTitle) modalTitle.textContent = `JSON SAP · Integración ${id}`;
        if (jsonContent) jsonContent.textContent = 'Cargando…';
        $('btnCloseModal')?.focus();
        try {
            const url = URL_JSON + `?integracionId=${encodeURIComponent(id)}&source=${encodeURIComponent(SOURCE)}&tipo=${encodeURIComponent(TYPE)}`;
            const response = await fetch(url, { credentials: 'same-origin', cache: 'no-store' });
            const text = await response.text();
            if (!response.ok) throw new Error(text || `No se pudo obtener el JSON. HTTP ${response.status}`);
            try { jsonContent.textContent = JSON.stringify(JSON.parse(text), null, 2); }
            catch { jsonContent.textContent = text; }
        } catch (error) {
            if (jsonContent) jsonContent.textContent = error?.message || String(error);
        }
    }
    function closeModal() { modal?.classList.remove('open'); }

    async function copiarJson() {
        const texto = jsonContent?.textContent || '';
        try {
            await navigator.clipboard.writeText(texto);
            toast('JSON copiado al portapapeles.', 'ok');
        } catch {
            // Respaldo para navegadores o sitios sin permiso de portapapeles (http).
            try {
                const ta = document.createElement('textarea');
                ta.value = texto;
                ta.style.cssText = 'position:fixed;opacity:0';
                document.body.appendChild(ta);
                ta.select();
                const ok = document.execCommand('copy');
                ta.remove();
                if (!ok) throw new Error();
                toast('JSON copiado al portapapeles.', 'ok');
            } catch {
                errorUsuario('No fue posible copiar el JSON automáticamente. Selecciónalo y cópialo manualmente.', 10000);
            }
        }
    }

    /* ---------------- Eventos ---------------- */
    $('tbodyIntegraciones')?.addEventListener('change', e => {
        if (e.target.classList?.contains('row-check')) { marcar(e.target, e.target.checked); updateSelection(); }
    });
    $('tbodyIntegraciones')?.addEventListener('click', e => {
        const send = e.target.closest('.btn-send');
        if (send && !send.disabled) { sendOne(Number(send.dataset.id), send); return; }
        const json = e.target.closest('.btn-json');
        if (json) openJson(Number(json.dataset.id));
    });

    checkAll?.addEventListener('change', () => { rowChecks().forEach(x => marcar(x, checkAll.checked)); updateSelection(); });
    btnSelectPending?.addEventListener('click', () => { rowChecks().forEach(x => marcar(x, true)); updateSelection(); });
    btnSendSelected?.addEventListener('click', () => sendBatch(selectedIds()));
    btnAuto?.addEventListener('click', cambiarAutomatico);

    document.querySelectorAll('.es-kpi[data-filter]').forEach(k => k.addEventListener('click', () => {
        const f = k.dataset.filter;
        filtroEstado = (filtroEstado === f || f === 'todos') ? 'todos' : f;
        aplicarFiltros();
    }));

    let tBusqueda = null;
    $('txtBuscarTabla')?.addEventListener('input', function () {
        clearTimeout(tBusqueda);
        tBusqueda = setTimeout(() => { filtroTexto = this.value.trim().toLowerCase(); aplicarFiltros(); }, 150);
    });

    $('frmFiltros')?.addEventListener('submit', e => {
        const d = $('fDesde')?.value, h = $('fHasta')?.value;
        if (d && h && d > h) { e.preventDefault(); window.alert('La fecha "Desde" no puede ser posterior a "Hasta".'); }
    });

    $('btnCloseModal')?.addEventListener('click', closeModal);
    $('btnCloseModal2')?.addEventListener('click', closeModal);
    modal?.addEventListener('click', e => { if (e.target === modal) closeModal(); });
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });
    $('btnCopyJson')?.addEventListener('click', copiarJson);

    // Evita salir de la página a media operación (el envío seguiría en el servidor sin que el usuario vea el resultado).
    window.addEventListener('beforeunload', e => { if (envioEnCurso) { e.preventDefault(); e.returnValue = ''; } });

    aplicarFiltros();
    cargarEstadoAutomatico(true);

    // Mantiene el botón sincronizado con el worker aunque otro usuario lo cambie.
    // Solo consulta mientras la pestaña está visible.
    window.setInterval(() => { if (!document.hidden) cargarEstadoAutomatico(false); }, 10000);
    document.addEventListener('visibilitychange', () => { if (!document.hidden) cargarEstadoAutomatico(false); });
})();
</script>
