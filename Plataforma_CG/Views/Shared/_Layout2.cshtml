<!DOCTYPE html>
<html lang="es">
<head>
    @* @RenderSection("Scripts", required: false) *@
    @RenderSection("Styles", required: false)
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SIGO | Sistema Integral De Gestión Operativa</title>
    <link rel="icon" type="image/png" href="~/images/ico_sigo.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/fonts/fonts.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/fonts/bootstrap-icons.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@100;200;300;400;500;600;700;800;900&display=swap" rel="stylesheet">
   @*  <link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" /> *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/layout2-grid.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout2-mobile-sidebar-fix.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout2-mobile-sidebar-gapfix.css" asp-append-version="true" />
</head>

<body class="layout-body @(ViewContext.RouteData.Values["controller"]) @(ViewContext.RouteData.Values["action"])" data-theme="light">

    <!-- HEADER -->
    <header>
        <nav class="layout-navbar navbar navbar-expand-lg navbar-dark">
            <div class="layout-navbar-container">
                <a class="layout-navbar-brand" asp-controller="Home" asp-action="Inicio">
                    <img src="~/images/logSIGO.png" alt="SIGO" class="layout-logo-navbar" />
                </a>

                <div class="layout-navbar-tools d-flex align-items-center ms-auto me-3">
                    <div class="layout-clock text-white d-none d-sm-flex flex-column text-end">
                        <span id="layout-clock-time"></span>
                        <span id="layout-clock-date"></span>
                    </div>
                    <div class="layout-vr vr d-none d-sm-block"></div>

                    <button type="button"
                            id="theme-toggle-btn"
                            class="theme-switch-btn"
                            title="Cambiar tema claro/oscuro"
                            aria-label="Cambiar tema claro/oscuro">
                        <span class="theme-switch-thumb">
                            <i id="theme-toggle-icon" class="fa-solid fa-sun"></i>
                        </span>
                    </button> 

                    <button type="button" class="btn btn-sm btn-outline-light layout-btn-about"
                            data-bs-toggle="modal" data-bs-target="#layoutAboutModal">
                        <i class="bi bi-info-circle me-1"></i> <span>Acerca de</span>
                    </button>

                    <button class="btn btn-sm text-white border-0" data-bs-toggle="modal" data-bs-target="#reporteModal" title="Levantar Reporte">
                        <i class="fa-solid fa-headset fa-lg"></i>
                    </button>
                </div>
            </div>
        </nav>
    </header>

    <!-- Hover zone -->
    <div class="layout-sidebar-hover-zone"></div>

    <!-- ========== SIDEBAR MEJORADO ========== -->
    <div class="layout-sidebar layout-hidden" id="layout-sidebar-dinamico">

        <!-- Tarjeta usuario -->
        <div class="sb-user-section">
            <!-- Botón PIN -->
            <button id="layout-pin-btn" title="Fijar sidebar">
                <i class="fas fa-thumbtack"></i>
            </button>

            <div class="sb-user-card">
                <img src="~/images/Usr.png" alt="Usuario" class="sb-avatar" />
                <div class="sb-user-info">
                    <span class="sb-user-name">@User.Identity.Name</span>
                    <small id="dynamic-greeting" class="sb-user-greeting"></small>
                    <small id="dynamic-message" class="sb-user-greeting" style="margin-top:1px;"></small>
                </div>
                <div class="sb-user-status"></div>
            </div>
        </div>

        <!-- Búsqueda -->
        <div class="sb-search">
            <i class="fas fa-search sb-search-icon"></i>
            <input type="text" class="sb-search-input" id="sb-search-input" placeholder="Buscar módulo..." autocomplete="off" />
        </div>

        <!-- Menú dinámico -->
        <nav class="layout-sidebar-nav" id="layout-menu-contenedor"></nav>

        <!-- Logout -->
        <div class="sb-footer">
            <a href="@Url.Action("Logout", "Acceso")" id="layout-logout-link">
                <div class="sb-icon-wrap">
                    <i class="fas fa-sign-out-alt"></i>
                </div>
                <span class="sb-item-label">Cerrar Sesión</span>
            </a>
        </div>

    </div>

    <!-- Fondo para cerrar el menú lateral en móvil -->
    <div id="layout-sidebar-overlay"
         class="layout-sidebar-overlay"
         aria-hidden="true"></div>

    <!-- Botón flotante toggle -->
    <button id="layout-toggle-sidebar-btn"
            class="layout-toggle-sidebar-btn"
            type="button"
            aria-label="Abrir menú lateral"
            aria-controls="layout-sidebar-dinamico"
            aria-expanded="false">
        <i class="bi bi-list"></i>
    </button>

    <!-- MAIN -->
    <main role="main" class="layout-main-content">
        <div class="layout-container-fluid container-fluid">
            @RenderBody()
        </div>
    </main>

    <footer class="layout-footer">
        <div class="container">
            <p>&copy; 2026 - Carnes G - Todos los derechos reservados</p>
        </div>
    </footer>

    <!-- Modal Acerca de -->
    <div class="modal fade" id="layoutAboutModal" tabindex="-1" aria-labelledby="layoutAboutModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow">
                <div class="modal-header" style="background: var(--layout-brand);">
                    <h5 class="modal-title text-white" id="layoutAboutModalLabel">
                        <i class="bi bi-info-circle me-2"></i>Acerca de SIGO
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <h6 class="mb-1">SIGO — Sistema Integral de Gestión Operativa</h6>
                    <p>Plataforma interna para visualizar, controlar y autorizar procesos clave de la organización: mercados, área comercial, administración, operaciones y autorizaciones. Su objetivo es estandarizar la información y agilizar la toma de decisiones.</p>
                    <hr>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <h6>Desarrollador</h6>
                            <ul class="list-unstyled small mb-0">
                                <li><i class="bi bi-person-badge me-1"></i><strong>Nombre:</strong> Sistemas Carnes G</li>
                                <li><i class="bi bi-envelope me-1"></i><strong>Correo:</strong> sistemascg@carnesg.net</li>
                                <li><i class="bi bi-gear me-1"></i><strong>Versión:</strong> 1.1.0</li>
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <h6>Tecnologías</h6>
                            <ul class="list-unstyled small mb-0">
                                <li>ASP.NET Core MVC</li>
                                <li>Bootstrap 5 · Font Awesome · Bootstrap Icons</li>
                                <li>jQuery / JavaScript</li>
                                <li>SQL Server</li>
                            </ul>
                        </div>
                    </div>
                    <div class="alert alert-light border mt-3 mb-0 small">© 2026 Carnes G — Todos los derechos reservados.</div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Chat FAB -->
    <button id="layout-chat-fab" class="layout-chat-fab" type="button" title="Abrir chat interno">
        <i class="fas fa-comments"></i>
    </button>

    <!-- Manual FAB -->
    <button id="layout-manual-fab" class="layout-chat-fab" type="button" title="Manual de usuario"
            style="bottom: 90px; background: radial-gradient(circle at 30% 30%, #eef6ff, #0d6efd);">
        <i class="fas fa-book"></i>
    </button>

    <!-- Chat panel -->
    <div id="layout-chat-panel" class="layout-chat-panel d-none">
        <div class="layout-chat-panel-header">
            <i class="fas fa-headset"></i>
            <div class="layout-chat-title">
                Chat interno
                <small id="layout-chat-area-label">Selecciona un área para comenzar</small>
            </div>
            <button type="button" id="layout-chat-close-btn"><i class="fas fa-times"></i></button>
        </div>
        <div class="layout-chat-panel-body">
            <div class="layout-chat-area-select">
                <label for="layout-chat-area">Área / responsable</label>
                <select id="layout-chat-area" class="form-select form-select-sm">
                    <option value=""> Selecciona área </option>
                    <option value="presupuestos">Presupuestos</option>
                    <option value="precios">Precios</option>
                    <option value="logistica">Logística</option>
                </select>
            </div>
            <div class="layout-chat-hint">Este chat enviará los mensajes sólo al área seleccionada.</div>
        </div>
        <div id="layout-chat-messages" class="layout-chat-messages">
            <div class="text-muted small text-center mt-2">Selecciona un área para iniciar la conversación.</div>
        </div>
        <div class="layout-chat-input">
            <textarea id="layout-chat-text" rows="1" placeholder="Escribe un mensaje..." disabled></textarea>
            <button id="layout-chat-send" class="btn btn-primary btn-sm" disabled>
                <i class="fas fa-paper-plane"></i>
            </button>
        </div>
    </div>

    <!-- Modal Manual -->
    <div class="modal fade" id="layoutManualModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-white">
                        <i class="fas fa-book me-2"></i>
                        <span id="layoutManualTitle">Manual de Usuario - SIGO</span>
                    </h5>
                    <button type="button" class="btn btn-close-white" data-bs-dismiss="modal">X</button>
                </div>
                <div class="modal-body">
                    <button class="manual-toggle-sidebar" onclick="toggleManualSidebar()"><i class="fas fa-bars"></i></button>
                    <div class="manual-overlay" onclick="toggleManualSidebar()"></div>
                    <div class="manual-container">
                        <aside class="manual-sidebar" id="manualSidebar">
                            <div class="manual-sidebar-header">
                                <h6><i class="fas fa-list me-2"></i>Índice de Contenidos</h6>
                            </div>
                            <nav class="manual-toc" id="manualToc"></nav>
                        </aside>
                        <div class="manual-content" id="manualContent">
                            <div class="manual-progress">
                                <div class="manual-progress-bar" id="manualProgressBar"></div>
                            </div>
                            <div class="manual-content-inner" id="manualSections"></div>
                        </div>
                    </div>
                    <button class="manual-scroll-top" id="manualScrollTopBtn" onclick="scrollManualToTop()">
                        <i class="fas fa-arrow-up"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Reporte -->
    <div class="modal fade" id="reporteModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow" style="overflow:hidden;">
                <div class="modal-header" style="background:var(--layout-brand);">
                    <h5 class="modal-title text-white"><i class="fa-solid fa-headset me-2"></i> Solicitud Sistemas</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body p-0" style="height: 85vh;">
                    <iframe src="https://forms.monday.com/forms/embed/7e2f46f5a3bb77bd42b6b28ee3a8317b?r=use1"
                            style="width: 100%; height: 100%; border: 0;" title="Formulario de Solicitud"></iframe>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/fonts/fonts.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>

        // ========================================
        // SIDEBAR RESPONSIVO — ESCRITORIO + MÓVIL
        // ========================================
        const layoutSidebar    = document.querySelector('.layout-sidebar');
        const layoutMain       = document.querySelector('.layout-main-content');
        const layoutToggleBtn  = document.getElementById('layout-toggle-sidebar-btn');
        const layoutToggleIcon = layoutToggleBtn?.querySelector('i');
        const layoutPinBtn     = document.getElementById('layout-pin-btn');
        const layoutOverlay    = document.getElementById('layout-sidebar-overlay');
        const mobileSidebarMq  = window.matchMedia('(max-width: 991.98px)');

        let sidebarPinned = localStorage.getItem('sidebarPinned') === 'true';

        function isMobileSidebar() {
            return mobileSidebarMq.matches;
        }

        function setToggleIcon(open) {
            if (!layoutToggleIcon || !layoutToggleBtn) return;

            if (isMobileSidebar()) {
                layoutToggleIcon.className = open ? 'bi bi-x-lg' : 'bi bi-list';
            } else {
                layoutToggleIcon.className = open
                    ? 'bi bi-chevron-left'
                    : 'bi bi-chevron-right';
            }

            layoutToggleBtn.setAttribute('aria-expanded', String(open));
            layoutToggleBtn.setAttribute(
                'aria-label',
                open ? 'Cerrar menú lateral' : 'Abrir menú lateral'
            );
        }

        function openLayoutSidebar() {
            if (!layoutSidebar) return;

            layoutSidebar.classList.remove('layout-hidden');

            if (isMobileSidebar()) {
                layoutMain?.classList.remove('layout-sidebar-open');
                document.body.classList.add('layout-mobile-sidebar-open');
                layoutOverlay?.classList.add('show');
                layoutOverlay?.setAttribute('aria-hidden', 'false');
            } else {
                layoutMain?.classList.add('layout-sidebar-open');
            }

            setToggleIcon(true);
        }

        function closeLayoutSidebar() {
            if (!layoutSidebar) return;

            layoutSidebar.classList.add('layout-hidden');
            layoutMain?.classList.remove('layout-sidebar-open');
            document.body.classList.remove('layout-mobile-sidebar-open');
            layoutOverlay?.classList.remove('show');
            layoutOverlay?.setAttribute('aria-hidden', 'true');
            setToggleIcon(false);
        }

        function applyPinState() {
            if (isMobileSidebar()) {
                closeLayoutSidebar();
                return;
            }

            if (sidebarPinned) {
                openLayoutSidebar();
                layoutPinBtn?.classList.add('pinned');
                if (layoutPinBtn) layoutPinBtn.title = 'Desfijar sidebar';
            } else {
                closeLayoutSidebar();
                layoutPinBtn?.classList.remove('pinned');
                if (layoutPinBtn) layoutPinBtn.title = 'Fijar sidebar';
            }
        }

        applyPinState();

        layoutPinBtn?.addEventListener('click', () => {
            if (isMobileSidebar()) return;

            sidebarPinned = !sidebarPinned;
            localStorage.setItem('sidebarPinned', String(sidebarPinned));
            applyPinState();
        });

        layoutSidebar?.addEventListener('mouseleave', () => {
            if (isMobileSidebar() || sidebarPinned) return;
            closeLayoutSidebar();
        });

        layoutToggleBtn?.addEventListener('click', () => {
            const estaAbierto = !layoutSidebar?.classList.contains('layout-hidden');

            if (isMobileSidebar()) {
                estaAbierto ? closeLayoutSidebar() : openLayoutSidebar();
                return;
            }

            if (sidebarPinned) return;
            estaAbierto ? closeLayoutSidebar() : openLayoutSidebar();
        });

        layoutOverlay?.addEventListener('click', closeLayoutSidebar);

        document.addEventListener('keydown', event => {
            if (event.key === 'Escape' && isMobileSidebar()) {
                closeLayoutSidebar();
            }
        });

        layoutSidebar?.querySelectorAll('a[href]').forEach(link => {
            link.addEventListener('click', () => {
                if (isMobileSidebar()) closeLayoutSidebar();
            });
        });

        function handleSidebarBreakpointChange() {
            applyPinState();
        }

        if (typeof mobileSidebarMq.addEventListener === 'function') {
            mobileSidebarMq.addEventListener('change', handleSidebarBreakpointChange);
        } else {
            mobileSidebarMq.addListener(handleSidebarBreakpointChange);
        }

        // ========================================
        // RELOJ
        // ========================================
        (function initLayoutLiveClock() {
            const elTime = document.getElementById('layout-clock-time');
            const elDate = document.getElementById('layout-clock-date');
            if (!elTime || !elDate) return;
            function tick() {
                const now = new Date();
                elTime.textContent = new Intl.DateTimeFormat('es-MX', { hour:'2-digit', minute:'2-digit', second:'2-digit', hour12:true, timeZone:'America/Mexico_City' }).format(now);
                elDate.textContent = new Intl.DateTimeFormat('es-MX', { weekday:'short', year:'numeric', month:'short', day:'2-digit', timeZone:'America/Mexico_City' }).format(now);
            }
            tick();
            setInterval(tick, 1000);
        })();

        // ========================================
        // SALUDO DINÁMICO
        // ========================================
        (function initDynamicGreeting() {
            const greetingEl = document.getElementById('dynamic-greeting');
            const messageEl  = document.getElementById('dynamic-message');
            if (!greetingEl || !messageEl) return;
            const hora = new Date().getHours();
            const saludo = hora >= 5 && hora < 12 ? 'Buenos días' : hora >= 12 && hora < 19 ? 'Buenas tardes' : 'Buenas noches';
            const msgs = hora >= 5 && hora < 12
                ? ['¡Que tengas un excelente día!','¡Mucho éxito hoy!','¡Listo para conquistar el día!','¡A darle con todo!']
                : hora >= 12 && hora < 19
                ? ['¡Sigue así!','¡Vas muy bien!','¡Ánimo con la tarde!','¡A terminar fuerte!']
                : ['¡Buen trabajo hoy!','¡A descansar!','¡Casi terminas!','¡Gran esfuerzo!'];
            greetingEl.textContent = saludo;
            messageEl.textContent  = msgs[Math.floor(Math.random() * msgs.length)];
        })();

        // ========================================
        // MÓDULOS DINÁMICOS CON SIDEBAR MEJORADO
        // ========================================
 const SECTION_ORDER = [
    "Principal",
    "Operaciones",
    "Almacén",
    "Gestión",
    "Calidad",
    "Auditoria y Procesos",
    "Sistema"
];

const SECTION_ALIAS = {
    "mercados": "Principal",
    "area comercial": "Principal",
    "área comercial": "Principal",
    "comercial": "Principal",
    "autorizaciones": "Principal",

    "operaciones": "Operaciones",
    "logistica": "Operaciones",
    "logística": "Operaciones",
    "procesos cg": "Operaciones",
    "integraciones": "Operaciones",

        "almacen": "Almacén",
        "almacén": "Almacén",
        "almacenes": "Almacén",
        "inventario": "Almacén",
        "inventarios": "Almacén",

    "administracion": "Gestión",
    "administración": "Gestión",
    "reporteadores": "Gestión",
    "reportes": "Gestión",
    "kpi": "Gestión",
    "kpi's": "Gestión",

    "calidad": "Calidad",
    "auditoria Y procesos": "Auditoria Y procesos",

    "configuracion": "Sistema",
    "configuración": "Sistema",
    "chat": "Sistema",
    "sigo chat": "Sistema",
    "sistema": "Sistema",
    "sistemas": "Sistema",
    "gestion de sistemas": "Sistema",
    "gestión de sistemas": "Sistema"
};

        const ICON_MAP = {
    'Mercados':        'fas fa-chart-line',
    'Comercial':       'fas fa-handshake',
    'Autorizaciones':  'fas fa-lock',
    'Operaciones':     'fas fa-cogs',
    'Logística':       'fas fa-truck-fast',
    'Logistica':       'fas fa-truck-fast',
    'Carnes G':        'fas fa-drumstick-bite',
    'Administración':  'fas fa-folder-open',
    'Reportes':        'fas fa-chart-bar',
    'KPI':             'fas fa-chart-pie',
    'Configuración':   'fas fa-sliders',
    'SIGO Chat':       'fas fa-comments',
    'SIGO Core':       'fas fa-layer-group'
};

        const BADGE_MAP = {
            'Autorizaciones': { text: '!', cls: '' },
            'SIGO Chat':      { text: 'Chat', cls: '' },
            'Carnes G':       { text: 'Nuevo', cls: 'sb-badge-new' },
        };

        function normalizeText(text) {
        return (text || "")
        .toString()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .toLowerCase()
        .trim();
        }

        function getIconForMod(nombre) {
        const cleanNombre = normalizeText(nombre);

        for (const [key, val] of Object.entries(ICON_MAP)) {
        if (cleanNombre.includes(normalizeText(key))) {
        return val;
        }
        }

        return 'fas fa-folder';
        }

        function getSectionForMod(mod) {
        const raw = mod.categoriaNombre || mod.categoria || "Principal";
        const normalized = normalizeText(raw);

        return SECTION_ALIAS[normalized] || raw.trim();
        }

        document.addEventListener("DOMContentLoaded", async () => {
            try {
                const res = await fetch("/Sidebar/CargarModulos", {
    method: "GET",
    headers: {
        "X-Requested-With": "XMLHttpRequest",
        "Accept": "application/json"
    },
    cache: "no-store"
});
                if (!res.ok) throw new Error("Error al cargar módulos");

                if (res.redirected) {
    window.location.href = "/Home/Inicio";
    return;
}

if (!res.ok) {
    if (res.status === 401 || res.status === 403) {
        window.location.href = "/Home/Inicio";
    }
    return;
}

const ct = (res.headers.get("content-type") || "").toLowerCase();

if (!ct.includes("application/json")) {
    window.location.href = "/Home/Inicio";
    return;
}

                const modulos = await res.json();
                const contenedor = document.getElementById("layout-menu-contenedor");
                if (!contenedor) return;
                contenedor.innerHTML = "";

               function crearLayoutItemModulo(mod) {
    const modItem = document.createElement("div");
    modItem.classList.add("layout-menu-item");

    const iconClass = mod.icono || getIconForMod(mod.nombre || "");
    const badgeInfo = BADGE_MAP[mod.nombre] || null;

    const modLink = document.createElement("a");
    modLink.classList.add("layout-dropdown-btn");
    modLink.href = mod.url || "#";

    const iconWrap = document.createElement("div");
    iconWrap.className = "sb-icon-wrap";
    iconWrap.innerHTML = `<i class="${iconClass}"></i>`;
    modLink.appendChild(iconWrap);

    const labelSpan = document.createElement("span");
    labelSpan.className = "sb-item-label";
    labelSpan.textContent = mod.nombre || "";
    modLink.appendChild(labelSpan);

    if (badgeInfo) {
        const badge = document.createElement("span");
        badge.className = "sb-badge " + (badgeInfo.cls || "");
        badge.textContent = badgeInfo.text;
        modLink.appendChild(badge);
    }

    const subModulos = mod.subModulos || mod.submodulos || [];

    if (Array.isArray(subModulos) && subModulos.length > 0) {
        modLink.href = "#";

        const arrow = document.createElement("i");
        arrow.classList.add("fas", "fa-chevron-down", "layout-arrow");
        modLink.appendChild(arrow);

        const subContainer = document.createElement("div");
        subContainer.classList.add("layout-dropdown-container");

        subModulos.forEach(sub => {
            const subLink = document.createElement("a");
            subLink.href = sub.url || "#";

            const subIcon = sub.icono || "fas fa-caret-right";
            subLink.innerHTML = `<i class="${subIcon} me-1"></i>${sub.nombre || ""}`;

            subContainer.appendChild(subLink);
        });

        modItem.appendChild(modLink);
        modItem.appendChild(subContainer);
    } else {
        modItem.appendChild(modLink);
    }

    return modItem;
}

const grouped = {};

modulos.forEach(mod => {
    const section = getSectionForMod(mod);

    if (!grouped[section]) {
        grouped[section] = [];
    }

    grouped[section].push(mod);
});

const sectionNamesBase = [
    ...SECTION_ORDER.filter(section => grouped[section]?.length),
    ...Object.keys(grouped)
        .filter(section => !SECTION_ORDER.includes(section))
        .sort((a, b) => a.localeCompare(b))
];

// Cambio aislado: mantiene todo el orden actual y mueve únicamente
// la categoría Sistema al final del menú.
function esCategoriaSistema(nombre) {
    const valor = normalizeText(nombre);

    return valor === "sistema" ||
           valor === "sistemas" ||
           valor === "gestion de sistemas";
}

const sectionNames = [
    ...sectionNamesBase.filter(section => !esCategoriaSistema(section)),
    ...sectionNamesBase.filter(section => esCategoriaSistema(section))
];

sectionNames.forEach((section, index) => {
    const items = grouped[section];

    if (index > 0) {
        const div = document.createElement("div");
        div.className = "sb-divider";
        contenedor.appendChild(div);
    }

    const lbl = document.createElement("div");
    lbl.className = "sb-section-label";
    lbl.textContent = section.toUpperCase();
    contenedor.appendChild(lbl);

    items.forEach(mod => {
        contenedor.appendChild(crearLayoutItemModulo(mod));
    });
});

                // Activar dropdowns
                document.querySelectorAll('.layout-dropdown-btn').forEach(btn => {
                    btn.addEventListener('click', e => {
                        const item = btn.parentElement;
                        const hasSub = item.querySelector('.layout-dropdown-container');
                        if (hasSub) {
                            e.preventDefault();
                            document.querySelectorAll('.layout-menu-item').forEach(it => {
                                if (it !== item) it.classList.remove('layout-open');
                            });
                            item.classList.toggle('layout-open');
                        }
                    });
                });

                // Búsqueda en tiempo real
                const searchInput = document.getElementById("sb-search-input");
                if (searchInput) {
                    searchInput.addEventListener("input", function () {
                        const q = this.value.trim().toLowerCase();
                        document.querySelectorAll(".layout-menu-item").forEach(item => {
                            const label = item.querySelector(".sb-item-label");
                            const text = label ? label.textContent.toLowerCase() : "";
                            const subTexts = Array.from(item.querySelectorAll(".layout-dropdown-container a"))
                                .map(a => a.textContent.toLowerCase()).join(" ");
                            const match = !q || text.includes(q) || subTexts.includes(q);
                            item.style.display = match ? "" : "none";
                            if (q && subTexts.includes(q)) item.classList.add("layout-open");
                            else if (!q) item.classList.remove("layout-open");
                        });
                        document.querySelectorAll(".sb-section-label").forEach(lbl => {
                            let next = lbl.nextElementSibling;
                            let hasVisible = false;
                            while (next && !next.classList.contains("sb-section-label") && !next.classList.contains("sb-divider")) {
                                if (next.classList.contains("layout-menu-item") && next.style.display !== "none") hasVisible = true;
                                next = next.nextElementSibling;
                            }
                            lbl.style.display = hasVisible ? "" : "none";
                        });
                    });
                }

            } catch (e) {
                console.error("Error cargando el sidebar dinámico:", e);
            }
        });

        // ========================================
        // CHAT FLOTANTE INTERNO
        // ========================================
        (function initLayoutInternalChat() {
            const fab = document.getElementById("layout-chat-fab");
            const panel = document.getElementById("layout-chat-panel");
            const closeBtn = document.getElementById("layout-chat-close-btn");
            const areaSelect = document.getElementById("layout-chat-area");
            const areaLabel = document.getElementById("layout-chat-area-label");
            const messages = document.getElementById("layout-chat-messages");
            const txt = document.getElementById("layout-chat-text");
            const btnSend = document.getElementById("layout-chat-send");
            if (!fab || !panel) return;
            let currentConversationId = null, pollTimer = null, currentAreaName = "";

            function togglePanel(show) { show ? panel.classList.remove("d-none") : panel.classList.add("d-none"); }
            fab.addEventListener("click", () => togglePanel(panel.classList.contains("d-none")));
            closeBtn.addEventListener("click", () => togglePanel(false));

            async function cargarAreas() {
                try {
                    const res = await fetch("/Chat/Areas");
                    if (!res.ok) throw new Error();
                    const data = await res.json();
                    areaSelect.innerHTML = `<option value="">-- Selecciona área --</option>`;
                    data.forEach(a => { const opt = document.createElement("option"); opt.value = a.idArea; opt.textContent = a.nombre; areaSelect.appendChild(opt); });
                } catch { areaSelect.innerHTML = `<option value="">(Error al cargar áreas)</option>`; }
            }
            cargarAreas();

            areaSelect.addEventListener("change", async () => {
                if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
                currentConversationId = null; messages.innerHTML = "";
                const val = areaSelect.value;
                if (!val) { areaLabel.textContent = "Selecciona un área para comenzar"; txt.value = ""; txt.disabled = true; btnSend.disabled = true; messages.innerHTML = `<div class="text-muted small text-center mt-2">Selecciona un área para iniciar.</div>`; return; }
                currentAreaName = areaSelect.options[areaSelect.selectedIndex].text;
                try {
                    const res = await fetch("/Chat/NuevaConversacion", { method:"POST", headers:{"Content-Type":"application/json"}, body: JSON.stringify({ idArea: parseInt(val,10) }) });
                    const data = await res.json();
                    if (!res.ok || !data.ok) throw new Error(data.mensaje || "Error");
                    currentConversationId = data.idConversacion; areaLabel.textContent = `Conversando con: ${currentAreaName}`; txt.disabled = false; btnSend.disabled = false;
                    await cargarMensajes(); pollTimer = setInterval(cargarMensajes, 5000);
                } catch (e) { alert(e.message || "Error"); areaSelect.value = ""; areaLabel.textContent = "Selecciona un área"; txt.disabled = true; btnSend.disabled = true; }
            });

            function renderMensajes(lista) {
                messages.innerHTML = "";
                if (!lista || !lista.length) { messages.innerHTML = `<div class="text-muted small text-center mt-2">No hay mensajes aún 👋</div>`; return; }
                lista.forEach(m => {
                    const w = document.createElement("div"); w.classList.add("layout-chat-msg", m.esMio ? "layout-me" : "layout-other");
                    const b = document.createElement("div"); b.classList.add("layout-bubble");
                    const h = new Date(m.fecha).toLocaleTimeString("es-MX",{hour:"2-digit",minute:"2-digit"});
                    b.innerHTML = `<div>${m.texto}</div><span class="layout-meta">${m.esMio?"Tú":"Área "+currentAreaName} · ${h}</span>`;
                    w.appendChild(b); messages.appendChild(w);
                });
                messages.scrollTop = messages.scrollHeight;
            }

            async function cargarMensajes() {
                if (!currentConversationId) return;
                try { const res = await fetch(`/Chat/Mensajes/${currentConversationId}`); if (!res.ok) throw new Error(); const data = await res.json(); if (!data.ok) throw new Error(); renderMensajes(data.mensajes); } catch {}
            }

            btnSend.addEventListener("click", async () => {
                if (!currentConversationId) return; const raw = txt.value.trim(); if (!raw) return;
                try { const res = await fetch("/Chat/Enviar",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({idConversacion:currentConversationId,texto:raw})}); const data = await res.json(); if (!res.ok || !data.ok) throw new Error(data.mensaje||"Error"); txt.value=""; txt.focus(); await cargarMensajes(); } catch(e) { alert(e.message||"No se pudo enviar."); }
            });
            txt.addEventListener("keydown", e => { if (e.key==="Enter" && !e.shiftKey) { e.preventDefault(); btnSend.click(); } });
        })();

        // ========================================
        // MANUAL DE USUARIO
        // ========================================
        (function initLayoutUserManual() {
            const btn = document.getElementById("layout-manual-fab");
            const modalEl = document.getElementById("layoutManualModal");
            if (!btn || !modalEl) return;
            const modal = new bootstrap.Modal(modalEl);
            const titleEl = document.getElementById("layoutManualTitle");
            btn.addEventListener("click", () => {
                if (!window.manualConfig) {
                    titleEl.textContent = "Manual no disponible";
                    document.getElementById("manualSections").innerHTML = `<div class="alert alert-warning m-4">Por el momento este módulo aún no cuenta con manual de usuario disponible.</div>`;
                    modal.show(); return;
                }
                titleEl.textContent = window.manualConfig.title || "Manual de Usuario - SIGO";
                generarManualLibro();
                modal.show();
                setTimeout(() => { initManualListeners(); }, 300);
            });
        })();

        function generarManualLibro() {
            const tocNav = document.getElementById('manualToc');
            const sectionsContainer = document.getElementById('manualSections');
            if (!window.manualConfig || !window.manualConfig.sections) return;
            tocNav.innerHTML = ''; sectionsContainer.innerHTML = '';
            window.manualConfig.sections.forEach((section, index) => {
                const tocItem = document.createElement('div');
                tocItem.className = 'manual-toc-item';
                tocItem.setAttribute('data-section', section.id);
                tocItem.innerHTML = `<i class="fas ${section.icon}"></i><span>${section.title}</span>`;
                tocItem.onclick = () => scrollToManualSection(section.id);
                tocNav.appendChild(tocItem);
                const sectionDiv = document.createElement('section');
                sectionDiv.className = 'manual-section'; sectionDiv.id = section.id;
                let stepsHTML = '';
                section.steps.forEach(step => {
                    stepsHTML += `<div class="manual-step"><h4 class="manual-step-title"><i class="fas fa-chevron-right"></i>${step.title}</h4><p class="manual-step-text">${step.text}</p>${renderManualMedia(step)}</div>`;
                });
                sectionDiv.innerHTML = `<div class="manual-section-header"><div class="manual-section-number">${index+1}</div><h2 class="manual-section-title">${section.title}</h2></div><div class="manual-section-content">${stepsHTML}</div>`;
                sectionsContainer.appendChild(sectionDiv);
            });
        }

        function initManualListeners() {
            const contentArea = document.getElementById('manualContent');
            const scrollTopBtn = document.getElementById('manualScrollTopBtn');
            const progressBar = document.getElementById('manualProgressBar');
            if (!contentArea) return;
            contentArea.addEventListener('scroll', () => {
                updateActiveManualTocItem();
                scrollTopBtn.classList.toggle('show', contentArea.scrollTop > 300);
                progressBar.style.width = ((contentArea.scrollTop / (contentArea.scrollHeight - contentArea.clientHeight)) * 100) + '%';
            });
        }

        function updateActiveManualTocItem() {
            const sections = document.querySelectorAll('.manual-section');
            const tocItems = document.querySelectorAll('.manual-toc-item');
            let currentSection = null;
            sections.forEach(s => { if (s.getBoundingClientRect().top <= 150) currentSection = s.id; });
            tocItems.forEach(i => i.classList.toggle('active', i.getAttribute('data-section') === currentSection));
        }

        function scrollToManualSection(sectionId) {
            const section = document.getElementById(sectionId);
            const contentArea = document.getElementById('manualContent');
            if (section && contentArea) {
                contentArea.scrollTo({ top: section.offsetTop - 20, behavior: 'smooth' });
                if (window.innerWidth < 992) toggleManualSidebar();
            }
        }

        function scrollManualToTop() { document.getElementById('manualContent').scrollTo({ top: 0, behavior: 'smooth' }); }

        function toggleManualSidebar() {
            const sidebar = document.getElementById('manualSidebar');
            const overlay = document.querySelector('.manual-overlay');
            if (sidebar && overlay) { sidebar.classList.toggle('show'); overlay.classList.toggle('show'); }
        }

        function renderManualMedia(step) {
            if (step.video) return `<video class="manual-step-video" controls preload="metadata"><source src="${step.video}" type="video/mp4">Tu navegador no soporta video HTML5.</video>`;
            if (step.image) return `<img src="${step.image}" alt="${step.title||''}" class="manual-step-image">`;
            return "";
        }

         // ========================================
            // MODO OSCURO GLOBAL - PRUEBA
            // ========================================
            (function initGlobalThemeSwitch() {
                const body = document.body;
                const btn = document.getElementById('theme-toggle-btn');
                const icon = document.getElementById('theme-toggle-icon');

                if (!body || !btn || !icon) return;

                function setSwitchIcon(theme) {
                    icon.classList.remove('fa-sun', 'fa-moon');

                    if (theme === 'dark') {
                        icon.classList.add('fa-moon');
                        btn.title = 'Cambiar a modo claro';
                        btn.setAttribute('aria-label', 'Cambiar a modo claro');
                    } else {
                        icon.classList.add('fa-sun');
                        btn.title = 'Cambiar a modo oscuro';
                        btn.setAttribute('aria-label', 'Cambiar a modo oscuro');
                    }
                }

                function applyTheme(theme) {
                    body.setAttribute('data-theme', theme);
                    localStorage.setItem('sigoTheme', theme);
                    setSwitchIcon(theme);
                }

                const savedTheme = localStorage.getItem('sigoTheme') || 'light';
                applyTheme(savedTheme);

                btn.addEventListener('click', function () {
                    const currentTheme = body.getAttribute('data-theme') || 'light';
                    const nextTheme = currentTheme === 'dark' ? 'light' : 'dark';

                    applyTheme(nextTheme);
                });
            })();

            window.SIGO_SESSION = {
                loginUrl: '@Url.Action("Index", "Home")',
                estadoSesionUrl: '@Url.Action("EstadoSesion", "Acceso")'
            };

            function getVistaActualUrl() {
                return window.location.pathname + window.location.search + window.location.hash;
            }

                (function () {
                    if (window.__sigoSessionWatcherInstalled) {
                        return;
                    }

                    window.__sigoSessionWatcherInstalled = true;

                    const loginUrl = window.SIGO_SESSION.loginUrl;
                    const estadoSesionUrl = window.SIGO_SESSION.estadoSesionUrl;

                    let redirigiendo = false;

                    function construirLoginUrl(redirectUrl) {
                        const vistaActual = getVistaActualUrl();

                        // Aunque el servidor mande redirectUrl, preferimos reconstruirlo desde la vista visible.
                        // Así evitamos regresar a endpoints tipo /api, /Chat/Mensajes, /Tif/Listar, etc.
                        return loginUrl
                            + '?expirada=1&returnUrl='
                            + encodeURIComponent(vistaActual);
                    }

                    function mostrarAvisoYRedirigir(redirectUrl) {
                        if (redirigiendo) return;
                        redirigiendo = true;

                        const destino = construirLoginUrl(redirectUrl);

                        let aviso = document.getElementById('sigo-session-expired-overlay');

                        if (!aviso) {
                            aviso = document.createElement('div');
                            aviso.id = 'sigo-session-expired-overlay';
                            aviso.innerHTML = `
                                <div class="sigo-session-expired-card">
                                    <div class="sigo-session-expired-icon">
                                        <i class="fas fa-clock"></i>
                                    </div>
                                    <h3>Sesión expirada</h3>
                                    <p>Tu sesión terminó por inactividad. Te enviaremos al inicio de sesión para continuar trabajando.</p>
                                    <div class="sigo-session-expired-loader"></div>
                                </div>
                            `;
                            document.body.appendChild(aviso);
                        }

                        setTimeout(function () {
                            window.location.href = destino;
                        }, 900);
                    }

                    function revisarRespuesta(response) {
                        if (!response) return response;

                        if (response.status === 401) {
                            response.clone().json()
                                .then(function (data) {
                                    if (data && data.sessionExpired) {
                                        mostrarAvisoYRedirigir(data.redirectUrl);
                                    } else {
                                        mostrarAvisoYRedirigir(null);
                                    }
                                })
                                .catch(function () {
                                    mostrarAvisoYRedirigir(null);
                                });
                        }

                        return response;
                    }

                    // Intercepta fetch global
                    if (window.fetch) {
                        const fetchOriginal = window.fetch;

                        window.fetch = function (input, init) {
                            init = init || {};
                            init.headers = init.headers || {};
                        if (init.headers instanceof Headers) {
                            if (!init.headers.has('X-Requested-With')) {
                                init.headers.set('X-Requested-With', 'XMLHttpRequest');
                            }

                            if (!init.headers.has('Accept')) {
                                init.headers.set('Accept', 'application/json');
                            }

                            init.headers.set('X-SIGO-Current-Url', getVistaActualUrl());
                        } else if (Array.isArray(init.headers)) {
                            init.headers.push(['X-Requested-With', 'XMLHttpRequest']);
                            init.headers.push(['Accept', 'application/json']);
                            init.headers.push(['X-SIGO-Current-Url', getVistaActualUrl()]);
                        } else {
                            init.headers['X-Requested-With'] = init.headers['X-Requested-With'] || 'XMLHttpRequest';
                            init.headers['Accept'] = init.headers['Accept'] || 'application/json';
                            init.headers['X-SIGO-Current-Url'] = getVistaActualUrl();
                        }

                            return fetchOriginal(input, init)
                                .then(function (response) {
                                    return revisarRespuesta(response);
                                });
                        };
                    }

                    // Intercepta jQuery AJAX
                    if (window.jQuery) {
                        $(document).ajaxSend(function (event, jqxhr) {
                            jqxhr.setRequestHeader('X-Requested-With', 'XMLHttpRequest');
                            jqxhr.setRequestHeader('Accept', 'application/json');
                            jqxhr.setRequestHeader('X-SIGO-Current-Url', getVistaActualUrl());
                        });

                        $(document).ajaxError(function (event, jqxhr) {
                            if (jqxhr.status === 401) {
                                let redirectUrl = null;

                                try {
                                    const data = JSON.parse(jqxhr.responseText);
                                    if (data && data.sessionExpired) {
                                        redirectUrl = data.redirectUrl;
                                    }
                                } catch (e) {
                                    redirectUrl = null;
                                }

                                mostrarAvisoYRedirigir(redirectUrl);
                            }
                        });
                    }

                    // Revisión silenciosa cada minuto
                    async function revisarSesionActual() {
                        if (redirigiendo) return;

                        try {
                            const response = await fetch(estadoSesionUrl, {
                                method: 'GET',
                                cache: 'no-store',
                                headers: {
                                    'Accept': 'application/json',
                                    'X-Requested-With': 'XMLHttpRequest',
                                    'X-SIGO-Current-Url': getVistaActualUrl()
                                }
                            });

                            if (response.status === 401) {
                                let redirectUrl = null;

                                try {
                                    const data = await response.json();
                                    if (data && data.sessionExpired) {
                                        redirectUrl = data.redirectUrl;
                                    }
                                } catch (e) {
                                    redirectUrl = null;
                                }

                                mostrarAvisoYRedirigir(redirectUrl);
                            }
                        } catch (e) {
                            // Si se cae la red o el servidor tarda, no redirigimos.
                            // Solo redirigimos cuando el servidor confirma 401.
                        }
                    }

                    setInterval(revisarSesionActual, 30000);
                })();

    </script>

    @RenderSection("Scripts", required: false)

