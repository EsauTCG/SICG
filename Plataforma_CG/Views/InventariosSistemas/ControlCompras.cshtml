<div class="cti-loading" id="ctiLoading">
    <div class="cti-loader-card"><span class="cti-spinner"></span><br /><span id="ctiLoadingText">Procesando...</span></div>
</div>
<div class="cti-toast-host" id="ctiToastHost"></div>

<script>
    (() => {
        'use strict';

        const urls = {
            permisos: '@Url.Action("ObtenerPermisosVistaComprasTi", "InventariosSistemas")',
            dashboard: '@Url.Action("GetDashboardComprasTi", "InventariosSistemas")',
            solicitudes: '@Url.Action("GetSolicitudesCompraTi", "InventariosSistemas")',
            detalle: '@Url.Action("GetDetalleCompraTi", "InventariosSistemas")',
            syncProveedores: '@Url.Action("SincronizarProveedoresComprasTi", "InventariosSistemas")',
            proveedores: '@Url.Action("ObtenerProveedoresComprasTi", "InventariosSistemas")',
            asignarProveedor: '@Url.Action("AsignarProveedorCompraTi", "InventariosSistemas")',
            articulos: '@Url.Action("ObtenerArticulosSapComprasTi", "InventariosSistemas")',
            solicitudesSap: '@Url.Action("BuscarSolicitudesCompraSapTi", "InventariosSistemas")',
            solicitudSapDetalle: '@Url.Action("ObtenerSolicitudCompraSapTi", "InventariosSistemas")',
            ordenesCompraSap: '@Url.Action("ObtenerOrdenesCompraRelacionadasSapTi", "InventariosSistemas")',
            sincronizarOrdenesCompraSap: '@Url.Action("SincronizarOrdenesCompraSapTi", "InventariosSistemas")',
            centrosCostoSap: '@Url.Action("ObtenerCentrosCostoSapTi", "InventariosSistemas")',
            crear: '@Url.Action("CrearSolicitudCompraTi", "InventariosSistemas")',
            cotizacion: '@Url.Action("RegistrarCotizacionCompraTi", "InventariosSistemas")',
            autorizar: '@Url.Action("AutorizarCompraTi", "InventariosSistemas")',
            recepcion: '@Url.Action("RegistrarRecepcionCompraTi", "InventariosSistemas")',
            factura: '@Url.Action("RegistrarFacturaCompraTi", "InventariosSistemas")',
            pago: '@Url.Action("LiberarCompraTiAPago", "InventariosSistemas")'
        };

        const state = {
            page: 1,
            pageSize: 50,
            total: 0,
            solicitudes: [],
            selectedId: 0,
            detalle: null,
            permisos: { puedeLeer: false, puedeEscribir: false, puedeEliminar: false },
            sapSolicitudSeleccionada: null,
            sapSolicitudes: [],
            sapOrdenesCompra: [],
            centrosCostoSap: [],
            proveedoresIniciales: [],
            lineCounter: 0,
            busy: 0
        };

        const $ = id => document.getElementById(id);
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        const moneyFormatter = new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN', minimumFractionDigits: 2 });
        const dateFormatter = new Intl.DateTimeFormat('es-MX', { dateStyle: 'medium', timeStyle: 'short' });

        function escapeHtml(value) {
            return String(value ?? '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        function money(value, currency = 'MXN') {
            const amount = Number(value || 0);
            try {
                return new Intl.NumberFormat('es-MX', { style: 'currency', currency: currency || 'MXN', minimumFractionDigits: 2 }).format(amount);
            } catch {
                return moneyFormatter.format(amount);
            }
        }

        function dateText(value, withTime = true) {
            if (!value) return '-';
            const date = new Date(value);
            if (Number.isNaN(date.getTime())) return escapeHtml(value);
            return withTime ? dateFormatter.format(date) : date.toLocaleDateString('es-MX');
        }

        function localDateInput(date = new Date()) {
            const offset = date.getTimezoneOffset();
            return new Date(date.getTime() - offset * 60000).toISOString().slice(0, 10);
        }

        function localDateTimeInput(date = new Date()) {
            const offset = date.getTimezoneOffset();
            return new Date(date.getTime() - offset * 60000).toISOString().slice(0, 16);
        }

        function statusInfo(status) {
            const map = {
                BORRADOR: ['Borrador', 'cti-b-gray'],
                COTIZACION_REGISTRADA: ['Cotización registrada', 'cti-b-amber'],
                AUTORIZADA: ['Autorizada', 'cti-b-blue'],
                RECHAZADA: ['Rechazada', 'cti-b-red'],
                RECEPCION_PARCIAL: ['Recepción parcial', 'cti-b-amber'],
                RECIBIDA_CONFORME: ['Recibida conforme', 'cti-b-blue'],
                RECEPCION_NO_CONFORME: ['Recepción no conforme', 'cti-b-red'],
                FACTURA_CONCILIADA: ['Factura conciliada', 'cti-b-green'],
                DIFERENCIA_FACTURA: ['Diferencia en factura', 'cti-b-red'],
                LIBERADA_PAGO: ['Liberada a pago', 'cti-b-green']
            };
            return map[status] || [status || 'Sin estatus', 'cti-b-gray'];
        }

        function showLoading(text = 'Procesando...') {
            state.busy++;
            $('ctiLoadingText').textContent = text;
            $('ctiLoading').classList.add('cti-show');
        }

        function hideLoading() {
            state.busy = Math.max(0, state.busy - 1);
            if (state.busy === 0) $('ctiLoading').classList.remove('cti-show');
        }

        function toast(message, type = 'info', duration = 4200) {
            const item = document.createElement('div');
            item.className = `cti-toast cti-toast-${type}`;
            item.textContent = message;
            $('ctiToastHost').appendChild(item);
            window.setTimeout(() => item.remove(), duration);
        }

        async function parseResponse(response) {
            const contentType = response.headers.get('content-type') || '';
            let data;
            if (contentType.includes('application/json')) {
                data = await response.json();
            } else {
                const text = await response.text();
                const textoPlano = String(text || '')
                    .replace(/<script[\s\S]*?<\/script>/gi, ' ')
                    .replace(/<style[\s\S]*?<\/style>/gi, ' ')
                    .replace(/<[^>]+>/g, ' ')
                    .replace(/\s+/g, ' ')
                    .trim();

                data = {
                    ok: response.ok,
                    mensaje: contentType.includes('text/html')
                        ? `El servidor devolvió un error HTTP ${response.status}. Revisa el log de la aplicación.`
                        : (textoPlano || `Error HTTP ${response.status}`),
                    detalleTecnico: textoPlano.slice(0, 1500)
                };
            }
            if (!response.ok || data?.ok === false) {
                const error = new Error(data?.mensaje || `Error HTTP ${response.status}`);
                error.data = data;
                error.status = response.status;
                throw error;
            }
            return data;
        }

        async function getJson(url) {
            const response = await fetch(url, { credentials: 'same-origin', headers: { 'Accept': 'application/json' } });
            return parseResponse(response);
        }

        async function postJson(url, payload) {
            const response = await fetch(url, {
                method: 'POST',
                credentials: 'same-origin',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(payload)
            });
            return parseResponse(response);
        }

        async function postForm(url, formData) {
            if (!formData.has('__RequestVerificationToken')) formData.append('__RequestVerificationToken', token);
            const response = await fetch(url, {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Accept': 'application/json', 'RequestVerificationToken': token },
                body: formData
            });
            return parseResponse(response);
        }

        async function postUrlEncoded(url, values) {
            const body = new URLSearchParams(values);
            body.append('__RequestVerificationToken', token);
            const response = await fetch(url, {
                method: 'POST',
                credentials: 'same-origin',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
                    'Accept': 'application/json',
                    'RequestVerificationToken': token
                },
                body
            });
            return parseResponse(response);
        }

        function openModal(id) {
            $(id)?.classList.add('cti-show');
            document.body.style.overflow = 'hidden';
        }

        function closeModal(id) {
            $(id)?.classList.remove('cti-show');
            if (!document.querySelector('.cti-modal-backdrop.cti-show')) document.body.style.overflow = '';
        }

        function canWrite() { return !!state.permisos.puedeEscribir; }

        async function loadPermisos() {
            try {
                const data = await getJson(urls.permisos);
                state.permisos = data;
                $('ctiBadgePermiso').className = `cti-badge ${data.puedeEscribir ? 'cti-b-green' : data.puedeLeer ? 'cti-b-blue' : 'cti-b-red'}`;
                $('ctiBadgePermiso').textContent = data.puedeEscribir ? 'Lectura y escritura' : data.puedeLeer ? 'Solo lectura' : 'Sin permiso';
                $('ctiBtnNueva').disabled = !data.puedeEscribir;
                $('ctiBtnSyncProveedores').disabled = !data.puedeEscribir;
            } catch (error) {
                $('ctiBadgePermiso').className = 'cti-badge cti-b-red';
                $('ctiBadgePermiso').textContent = 'Permiso no disponible';
                toast(error.message, 'error');
            }
        }

        async function loadDashboard() {
            const data = await getJson(urls.dashboard);
            $('ctiKpiTotal').textContent = data.total ?? 0;
            $('ctiKpiAutorizacion').textContent = data.pendientesAutorizacion ?? 0;
            $('ctiKpiOrdenCompra').textContent = data.pendientesOrdenCompra ?? 0;
            $('ctiKpiRecepcion').textContent = data.pendientesRecepcion ?? 0;
            $('ctiKpiDiferencias').textContent = data.diferencias ?? 0;
            $('ctiKpiPago').textContent = data.listasPago ?? 0;
            $('ctiKpiLiberadas').textContent = data.liberadasPago ?? 0;
        }

        function buildListUrl() {
            const params = new URLSearchParams({
                page: String(state.page),
                pageSize: String(state.pageSize),
                search: $('ctiFiltroBuscar').value.trim(),
                estatus: $('ctiFiltroEstatus').value
            });
            return `${urls.solicitudes}?${params}`;
        }

        async function loadSolicitudes(selectId = 0) {
            const data = await getJson(buildListUrl());
            state.total = data.total ?? 0;
            state.solicitudes = data.solicitudes ?? [];
            renderSolicitudes();
            updatePager();

            if (selectId) {
                await selectSolicitud(selectId);
            } else if (state.selectedId && state.solicitudes.some(x => x.id === state.selectedId)) {
                await selectSolicitud(state.selectedId);
            } else if (state.solicitudes.length) {
                await selectSolicitud(state.solicitudes[0].id);
            } else {
                state.selectedId = 0;
                state.detalle = null;
                renderInspector();
            }
        }

        function renderSolicitudes() {
            const tbody = $('ctiSolicitudesBody');
            if (!state.solicitudes.length) {
                tbody.innerHTML = '<tr><td colspan="11" class="cti-empty">No se encontraron expedientes con los filtros seleccionados.</td></tr>';
                $('ctiResumenLista').textContent = '0 expedientes';
                return;
            }

            tbody.innerHTML = state.solicitudes.map(item => {
                const [label, badge] = statusInfo(item.estatus);
                const selected = item.id === state.selectedId ? 'cti-selected' : '';
                const differenceClass = Math.abs(Number(item.diferenciaFacturaCotizacion || 0)) > .02 ? 'color:var(--cti-red)' : 'color:var(--cti-green)';
                return `<tr class="${selected}" data-id="${item.id}">
                    <td><span class="cti-folio">${escapeHtml(item.folio)}</span><br><small>${escapeHtml(item.solicitudSap)}</small></td>
                    <td><b>${escapeHtml(typeLabel(item.tipoCompra))}</b><br><small>${escapeHtml(item.titulo)}</small></td>
                    <td>${item.proveedorNombreSnapshot ? `<b>${escapeHtml(item.proveedorNombreSnapshot)}</b><br><small>${escapeHtml(item.proveedorSapCodigo || '')}</small>` : '<span class="cti-badge cti-b-amber">Sin proveedor</span>'}</td>
                    <td>${item.ordenCompraSapDocNum
                        ? `<span class="cti-badge cti-b-blue">OC ${escapeHtml(item.ordenCompraSapDocNum)}</span><br><small>${escapeHtml(item.ordenesCompraSap || 1)} orden(es)</small>`
                        : '<span class="cti-badge cti-b-amber">Pendiente</span>'}</td>
                    <td><b>${escapeHtml(item.planta || '-')}</b><br><small>${escapeHtml(item.centroCosto || '-')}</small></td>
                    <td><span class="cti-badge ${badge}">${escapeHtml(label)}</span></td>
                    <td class="cti-money">${money(item.totalCotizado, item.moneda)}</td>
                    <td class="cti-money">${money(item.totalFactura, item.moneda)}</td>
                    <td class="cti-money" style="${differenceClass}">${money(item.diferenciaFacturaCotizacion, item.moneda)}</td>
                    <td><small>Cot. ${item.cotizaciones || 0} · Fac. ${item.facturas || 0} · Rec. ${item.recepciones || 0}</small></td>
                    <td>${dateText(item.fechaModificacion || item.fechaCreacion)}</td>
                </tr>`;
            }).join('');

            const first = (state.page - 1) * state.pageSize + 1;
            const last = Math.min(state.page * state.pageSize, state.total);
            $('ctiResumenLista').textContent = `${first}-${last} de ${state.total} expedientes`;
        }

        function updatePager() {
            const pages = Math.max(1, Math.ceil(state.total / state.pageSize));
            $('ctiPageLabel').textContent = `Página ${state.page} de ${pages}`;
            $('ctiPrevPage').disabled = state.page <= 1;
            $('ctiNextPage').disabled = state.page >= pages;
        }

        async function selectSolicitud(id) {
            state.selectedId = Number(id);
            renderSolicitudes();
            $('ctiInspector').innerHTML = '<div class="cti-empty"><span class="cti-spinner"></span><br>Consultando expediente...</div>';
            try {
                state.detalle = await getJson(`${urls.detalle}?id=${encodeURIComponent(id)}`);
                renderInspector();
            } catch (error) {
                state.detalle = null;
                $('ctiInspector').innerHTML = `<div class="cti-notice cti-notice-red">${escapeHtml(error.message)}</div>`;
            }
        }

        function typeLabel(type) {
            return ({ ACTIVO_FIJO: 'Activo fijo', CONSUMIBLE: 'Consumible', SERVICIO: 'Servicio', ARTICULO: 'Artículo' })[type] || type || '-';
        }

        function documentLink(path, label) {
            if (!path) return '<span class="cti-muted">Sin archivo</span>';
            const safe = escapeHtml(path);
            return `<a class="cti-btn cti-btn-sm" href="${safe}" target="_blank" rel="noopener"><i class="bi bi-box-arrow-up-right me-1"></i>${escapeHtml(label)}</a>`;
        }

        function renderInspector() {
            const host = $('ctiInspector');
            if (!state.detalle?.solicitud) {
                host.innerHTML = '<div class="cti-empty"><i class="bi bi-folder2-open" style="font-size:34px"></i><br>Selecciona un expediente de la tabla.</div>';
                return;
            }

            const d = state.detalle;
            const s = d.solicitud;
            const [statusLabel, statusBadge] = statusInfo(s.estatus);
            const blockers = d.bloqueosPago || [];
            const closed = s.liberadaPago || s.estatus === 'RECHAZADA';
            const write = canWrite();

