                : '<span class="cti-muted">No se ha registrado factura.</span>';

            const authHtml = (d.autorizaciones || []).length
                ? `<div class="cti-timeline">${d.autorizaciones.map(x => `<div class="cti-event"><b>${escapeHtml(x.etapa)} · ${escapeHtml(x.decision)}</b><small>${escapeHtml(x.usuario)} · ${dateText(x.fecha)}</small><p>${escapeHtml(x.comentario || '')}</p></div>`).join('')}</div>`
                : '<span class="cti-muted">Sin autorizaciones.</span>';

            const logHtml = (d.bitacora || []).length
                ? `<div class="cti-timeline">${d.bitacora.map(x => `<div class="cti-event"><b>${escapeHtml(x.accion)}</b><small>${escapeHtml(x.usuario)} · ${dateText(x.fecha)}</small><p>${escapeHtml(x.detalle || '')}</p></div>`).join('')}</div>`
                : '<span class="cti-muted">Sin movimientos en la bitácora.</span>';

            host.innerHTML = `
                <div class="cti-exp-title">
                    <div><h4>${escapeHtml(s.folio)} · ${escapeHtml(s.titulo)}</h4><small class="cti-muted">Solicitud SAP ${escapeHtml(s.solicitudSap)} · DocEntry ${escapeHtml(s.solicitudSapDocEntry ?? '-')} · ${escapeHtml(s.solicitante)}</small></div>
                    <span class="cti-badge ${statusBadge}">${escapeHtml(statusLabel)}</span>
                </div>

                ${s.liberadaPago ? `<div class="cti-notice cti-notice-green"><b>Expediente liberado a pago.</b><br>${dateText(s.fechaLiberacionPago)} por ${escapeHtml(s.liberadoPagoPor)}</div>` : ''}
                ${blockers.length ? `<div class="cti-notice cti-notice-red"><b>Bloqueos para pago:</b><ul style="margin:5px 0 0;padding-left:18px">${blockers.map(x => `<li>${escapeHtml(x)}</li>`).join('')}</ul></div>` : `<div class="cti-notice cti-notice-green"><b>Validación completa.</b> El expediente puede liberarse a pago.</div>`}

                <div class="cti-summary-grid">
                    <div class="cti-summary"><span>Tipo de compra</span><b>${escapeHtml(typeLabel(s.tipoCompra))}</b></div>
                    <div class="cti-summary"><span>Planta / centro</span><b>${escapeHtml(s.planta || '-')} · ${escapeHtml(s.centroCosto || '-')}</b></div>
                    <div class="cti-summary"><span>Proveedor SAP</span><b>${escapeHtml(s.proveedorSapCodigo || 'Pendiente')}<br>${escapeHtml(s.proveedorNombreSnapshot || '')}</b></div>
                    <div class="cti-summary"><span>RFC proveedor</span><b>${escapeHtml(s.proveedorRfcSnapshot || '-')}</b></div>
                    <div class="cti-summary"><span>Solicitud SAP</span><b>DocEntry ${escapeHtml(s.solicitudSapDocEntry ?? '-')} · ${escapeHtml(s.solicitudSapEstatus || '-')}</b></div>
                    <div class="cti-summary"><span>Orden de compra SAP</span><b>${(d.ordenesCompraSap || []).length
                        ? d.ordenesCompraSap.map(x => `OC ${escapeHtml(x.docNum)}`).join(', ')
                        : 'Pendiente'}</b></div>
                    <div class="cti-summary"><span>Solicitante SAP / fecha</span><b>${escapeHtml(s.solicitudSapSolicitante || '-')}<br>${dateText(s.solicitudSapFecha, false)}</b></div>
                </div>

                <div class="cti-match">
                    <h5>Conciliación económica</h5>
                    <div class="cti-match-row"><span>Cotización</span><strong>${money(s.totalCotizado, s.moneda)}</strong></div>
                    <div class="cti-match-row"><span>Factura</span><strong>${money(s.totalFactura, s.moneda)}</strong></div>
                    <div class="cti-match-row"><span>Diferencia</span><strong style="color:${Math.abs(Number(s.diferenciaFacturaCotizacion || 0)) > .02 ? 'var(--cti-red)' : 'var(--cti-green)'}">${money(s.diferenciaFacturaCotizacion, s.moneda)}</strong></div>
                    <div class="cti-match-row"><span>Autorización / recepción / conciliación</span><strong>${s.autorizada ? '✓' : '✕'} / ${s.recibidaConforme ? '✓' : '✕'} / ${s.conciliacionOk ? '✓' : '✕'}</strong></div>
                </div>

                <div class="cti-action-grid">
                    <button class="cti-btn" data-action="proveedor" ${!write || closed || s.autorizada ? 'disabled' : ''}><i class="bi bi-building me-1"></i>${s.proveedorSapCodigo ? 'Cambiar proveedor' : 'Asignar proveedor'}</button>
                    <button class="cti-btn" data-action="cotizacion" ${!write || closed || !s.proveedorSapCodigo ? 'disabled' : ''}><i class="bi bi-file-earmark-arrow-up me-1"></i>Subir cotización</button>
                    <button class="cti-btn cti-btn-primary" data-action="autorizar" ${!write || closed || s.estatus !== 'COTIZACION_REGISTRADA' ? 'disabled' : ''}><i class="bi bi-person-check me-1"></i>Autorizar / rechazar</button>
                    <button class="cti-btn" data-action="ordenes" ${!write || !s.solicitudSapDocEntry ? 'disabled' : ''}><i class="bi bi-arrow-repeat me-1"></i>Actualizar orden SAP</button>
                    <button class="cti-btn" data-action="recepcion" ${!write || closed || !s.autorizada ? 'disabled' : ''}><i class="bi bi-box-seam me-1"></i>Registrar recepción</button>
                    <button class="cti-btn" data-action="factura" ${!write || closed || !s.autorizada ? 'disabled' : ''}><i class="bi bi-receipt me-1"></i>Registrar factura</button>
                    <button class="cti-btn cti-btn-success" data-action="pago" ${!write || !d.puedeLiberarPago ? 'disabled' : ''}><i class="bi bi-cash-coin me-1"></i>Liberar a pago</button>
                    <button class="cti-btn cti-wide" data-action="imprimir"><i class="bi bi-printer me-1"></i>Expediente ejecutivo para Dirección</button>
                </div>

                <div class="cti-section"><div class="cti-section-title">Conceptos <span>${d.detalles?.length || 0}</span></div><div class="cti-section-body">${detailsHtml}</div></div>
                <div class="cti-section"><div class="cti-section-title">Cotizaciones <span>${d.cotizaciones?.length || 0}</span></div><div class="cti-section-body">${quoteHtml}</div></div>
                <div class="cti-section"><div class="cti-section-title">Órdenes de compra SAP <span>${d.ordenesCompraSap?.length || 0}</span></div><div class="cti-section-body">${orderHtml}</div></div>
                <div class="cti-section"><div class="cti-section-title">Seguimiento del expediente <span>${d.pendientesSeguimiento?.length || 0} pendientes</span></div><div class="cti-section-body">${seguimientoHtml}</div></div>
                <div class="cti-section"><div class="cti-section-title">Recepciones <span>${d.recepciones?.length || 0}</span></div><div class="cti-section-body">${receiptHtml}</div></div>
                <div class="cti-section"><div class="cti-section-title">Facturas <span>${d.facturas?.length || 0}</span></div><div class="cti-section-body">${invoiceHtml}</div></div>
                <div class="cti-section"><div class="cti-section-title">Autorizaciones <span>${d.autorizaciones?.length || 0}</span></div><div class="cti-section-body">${authHtml}</div></div>
                <div class="cti-section"><div class="cti-section-title">Bitácora completa <span>${d.bitacora?.length || 0}</span></div><div class="cti-section-body">${logHtml}</div></div>
            `;
        }


        function sapStatusBadge(status) {
            const value = String(status || '').toUpperCase();
            if (value === 'ABIERTA') return 'cti-b-green';
            if (value === 'CERRADA') return 'cti-b-amber';
            if (value === 'CANCELADA') return 'cti-b-red';
            return 'cti-b-gray';
        }

        async function loadSapPurchaseRequests() {
            const term = $('ctiSapSolicitudBuscar').value.trim();
            const incluirCerradas = $('ctiSapIncluirCerradas').checked;
            const body = $('ctiSapSolicitudesBody');

            body.innerHTML = '<tr><td colspan="8" class="cti-picker-empty"><span class="cti-spinner"></span><br>Consultando SAP...</td></tr>';

            try {
                const params = new URLSearchParams({
                    term,
                    top: '100',
                    incluirCerradas: String(incluirCerradas)
                });

                const data = await getJson(`${urls.solicitudesSap}?${params}`);
                state.sapSolicitudes = data.solicitudes || [];

                if (!state.sapSolicitudes.length) {
                    body.innerHTML = '<tr><td colspan="8" class="cti-picker-empty">No se encontraron solicitudes con esos criterios.</td></tr>';
                } else {
                    body.innerHTML = state.sapSolicitudes.map((item, index) => `
                        <tr>
                            <td><b>${escapeHtml(item.docNum)}</b><br><small>DocEntry ${escapeHtml(item.docEntry)}</small></td>
                            <td>${dateText(item.fechaDocumento, false)}<br><small>Requerida: ${dateText(item.fechaRequerida, false)}</small></td>
                            <td>${escapeHtml(item.solicitante || '-')}</td>
                            <td><b>${escapeHtml(item.primeraDescripcion || 'Sin descripción')}</b><br><small>${escapeHtml(item.comentarios || '')}</small><br><span class="cti-sap-chip">${escapeHtml(item.lineas || 0)} líneas</span></td>
                            <td>${escapeHtml(item.centroCosto || '-')}<br><small>${escapeHtml(item.proveedorPreferido || 'Sin proveedor preferido')}</small></td>
                            <td>${escapeHtml(item.plantaSugerida || 'PLANTA 1')}</td>
                            <td><span class="cti-badge ${sapStatusBadge(item.estado)}">${escapeHtml(item.estado)}</span></td>
                            <td><button type="button" class="cti-btn cti-btn-primary cti-btn-sm" data-select-sap="${index}">Seleccionar</button></td>
                        </tr>`).join('');
                }

                $('ctiSapSolicitudesResumen').textContent =
                    `${state.sapSolicitudes.length} solicitudes recuperadas desde SAP.`;
            } catch (error) {
                state.sapSolicitudes = [];
                body.innerHTML = `<tr><td colspan="8" class="cti-picker-empty">${escapeHtml(error.message)}</td></tr>`;
                $('ctiSapSolicitudesResumen').textContent = 'La consulta a SAP presentó un error.';
                toast(error.message, 'error', 7000);
            }
        }

        async function selectSapPurchaseRequest(index) {
            const selected = state.sapSolicitudes[Number(index)];
            if (!selected) return;

            showLoading(`Consultando solicitud SAP ${selected.docNum}...`);

            try {
                const data = await getJson(
                    `${urls.solicitudSapDetalle}?docEntry=${encodeURIComponent(selected.docEntry)}`
                );

                const sap = data.solicitud;
                const detalles = data.detalles || [];
                const ordenesCompra = data.ordenesCompra || [];

                state.sapSolicitudSeleccionada = sap;
                state.sapOrdenesCompra = ordenesCompra;
                $('ctiNuevaSapDocEntry').value = sap.docEntry;
                $('ctiNuevaSap').value = sap.docNum;

                const ordenesResumen = ordenesCompra.length
                    ? ordenesCompra
                        .map(x => `OC ${escapeHtml(x.docNum)} · ${escapeHtml(x.estado)} · ${money(x.total, x.moneda)}`)
                        .join('<br>')
                    : '<span class="cti-badge cti-b-amber">Todavía sin orden de compra SAP relacionada</span>';

                $('ctiNuevaSapInfo').innerHTML = `
                    <strong>SAP ${escapeHtml(sap.docNum)}</strong> · DocEntry ${escapeHtml(sap.docEntry)}
                    · ${escapeHtml(sap.estado)}<br>
                    <small>${dateText(sap.fechaDocumento, false)} · ${escapeHtml(sap.solicitante || 'Sin solicitante')}
                    · ${escapeHtml(sap.lineas || 0)} líneas</small>
                    <div style="margin-top:7px">${ordenesResumen}</div>`;

                if (sap.tipoCompraSugerido) {
                    $('ctiNuevaTipo').value = sap.tipoCompraSugerido;
                }

                if (sap.plantaSugerida &&
                    [...$('ctiNuevaPlanta').options].some(x => x.value === sap.plantaSugerida)) {
                    $('ctiNuevaPlanta').value = sap.plantaSugerida;
                } else {
                    $('ctiNuevaPlanta').value = 'PLANTA 1';
                }

                if (!$('ctiNuevaTitulo').value.trim()) {
                    $('ctiNuevaTitulo').value =
                        sap.comentarios ||
                        sap.primeraDescripcion ||
                        `Solicitud SAP ${sap.docNum}`;
                }

                if (!$('ctiNuevaJustificacion').value.trim()) {
                    $('ctiNuevaJustificacion').value =
                        sap.comentarios ||
                        `Necesidad registrada en la solicitud SAP ${sap.docNum}.`;
                }

                if (sap.centroCosto) {
                    selectCostCenter({
                        codigo: sap.centroCosto,
                        nombre: 'Centro obtenido de la solicitud SAP',
                        grupo: '',
                        dimension: 0
                    }, false);
                }

                if (sap.proveedorPreferidoDisponible && sap.proveedorPreferidoDetalle) {
                    selectInitialProvider(sap.proveedorPreferidoDetalle, false);
                } else if (sap.proveedorPreferidoCodigoSap) {
                    $('ctiNuevaProveedorCodigo').value = '';
                    $('ctiNuevaProveedorText').value = '';
                    $('ctiNuevaProveedorInfo').innerHTML =
                        `<span class="cti-badge cti-b-amber">Proveedor SAP ${escapeHtml(sap.proveedorPreferidoCodigoSap)} no pertenece al grupo permitido</span>`;
                }

                $('ctiLineasSolicitud').innerHTML = '';
                state.lineCounter = 0;

                detalles.forEach(line => addRequestLine(line.tipoLinea || '', {
                    lineaSap: line.lineaSap,
                    itemCode: line.itemCode,
                    descripcion: line.descripcion,
                    cantidad: line.cantidad,
                    unidad: line.unidad,
                    centroCostoSap: line.centroCostoSap,
                    almacenSap: line.almacenSap,
                    proveedorPreferidoSap: line.proveedorPreferidoSap
                }));

                if (!detalles.length) addRequestLine();

                closeModal('ctiModalSolicitudSap');
                toast(`Solicitud SAP ${sap.docNum} ligada al formulario.`, 'success');
            } catch (error) {
                toast(error.message, 'error', 7000);
            } finally {
                hideLoading();
            }
        }

        async function loadCostCenters() {
            const term = $('ctiCentroCostoBuscar').value.trim();
            const dimension = Number($('ctiCentroCostoDimension').value || 0);
            const body = $('ctiCentrosCostoBody');

            body.innerHTML = '<tr><td colspan="6" class="cti-picker-empty"><span class="cti-spinner"></span><br>Consultando SAP...</td></tr>';

            try {
                const params = new URLSearchParams({
                    term,
                    dimension: String(dimension)
                });

                const data = await getJson(`${urls.centrosCostoSap}?${params}`);
                state.centrosCostoSap = data.centros || [];

                body.innerHTML = state.centrosCostoSap.length
                    ? state.centrosCostoSap.map((item, index) => `
                        <tr>
                            <td><b>${escapeHtml(item.codigo)}</b></td>
                            <td>${escapeHtml(item.nombre || '-')}</td>
                            <td>${escapeHtml(item.grupo || '-')}</td>
                            <td>${escapeHtml(item.dimension || '-')}</td>
                            <td>${dateText(item.vigenciaDesde, false)} — ${dateText(item.vigenciaHasta, false)}</td>
                            <td><button type="button" class="cti-btn cti-btn-primary cti-btn-sm" data-select-centro="${index}">Seleccionar</button></td>
                        </tr>`).join('')
                    : '<tr><td colspan="6" class="cti-picker-empty">No se encontraron centros de costo.</td></tr>';

                $('ctiCentrosCostoResumen').textContent =
                    `${state.centrosCostoSap.length} centros de costo disponibles.`;
            } catch (error) {
                state.centrosCostoSap = [];
                body.innerHTML = `<tr><td colspan="6" class="cti-picker-empty">${escapeHtml(error.message)}</td></tr>`;
                $('ctiCentrosCostoResumen').textContent = 'La consulta a SAP presentó un error.';
                toast(error.message, 'error', 7000);
            }
        }

        function selectCostCenter(item, close = true) {
            if (!item?.codigo) return;

            $('ctiNuevaCentroCosto').value = item.codigo;
            $('ctiNuevaCentroCostoInfo').innerHTML = `
                <strong>${escapeHtml(item.codigo)}</strong> · ${escapeHtml(item.nombre || 'Centro de costo SAP')}<br>
                <small>${item.dimension ? `Dimensión ${escapeHtml(item.dimension)}` : 'Origen: solicitud SAP'}
                ${item.grupo ? ` · ${escapeHtml(item.grupo)}` : ''}</small>`;

            document.querySelectorAll('#ctiLineasSolicitud .cti-line-row').forEach(row => {
                if (!row.dataset.costingCode) row.dataset.costingCode = item.codigo;
            });

            if (close) closeModal('ctiModalCentroCosto');
        }

        async function loadInitialProviders() {
            const term = $('ctiProveedorInicialBuscar').value.trim();
            const body = $('ctiProveedorInicialBody');

            body.innerHTML = '<tr><td colspan="7" class="cti-picker-empty"><span class="cti-spinner"></span><br>Consultando catálogo...</td></tr>';

            try {
                const data = await getJson(
                    `${urls.proveedores}?term=${encodeURIComponent(term)}`
                );

                state.proveedoresIniciales = Array.isArray(data) ? data : [];

                body.innerHTML = state.proveedoresIniciales.length
                    ? state.proveedoresIniciales.map((item, index) => `
                        <tr>
                            <td><b>${escapeHtml(item.codigo)}</b></td>
                            <td>${escapeHtml(item.nombre || '-')}<br><small>${escapeHtml(item.correo || '')}</small></td>
                            <td>${escapeHtml(item.rfc || '-')}</td>
                            <td>${escapeHtml(item.grupo || '-')}</td>
                            <td>${escapeHtml(item.moneda || 'MXN')}</td>
                            <td>${escapeHtml(item.condicionPago || '-')}</td>
                            <td><button type="button" class="cti-btn cti-btn-primary cti-btn-sm" data-select-provider="${index}">Seleccionar</button></td>
                        </tr>`).join('')
                    : '<tr><td colspan="7" class="cti-picker-empty">No se encontraron proveedores autorizados.</td></tr>';

                $('ctiProveedorInicialResumen').textContent =
                    `${state.proveedoresIniciales.length} proveedores disponibles.`;
            } catch (error) {
                state.proveedoresIniciales = [];
                body.innerHTML = `<tr><td colspan="7" class="cti-picker-empty">${escapeHtml(error.message)}</td></tr>`;
                $('ctiProveedorInicialResumen').textContent = 'No se pudo consultar el catálogo.';
                toast(error.message, 'error', 7000);
            }
        }

        function selectInitialProvider(item, close = true) {
            if (!item?.codigo) return;

            $('ctiNuevaProveedorCodigo').value = item.codigo;
