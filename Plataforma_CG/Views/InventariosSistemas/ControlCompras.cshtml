        function updateQuoteAnalysis() {
            const subtotal = Number($('ctiCotSubtotal').value || 0);
            const iva = Number($('ctiCotIva').value || 0);
            const total = Number($('ctiCotTotal').value || 0);
            const diff = Math.round(((subtotal + iva) - total) * 100) / 100;
            const box = $('ctiCotAnalisis');
            if (!subtotal && !iva && !total) {
                box.className = 'cti-notice cti-notice-amber';
                box.textContent = 'Captura los importes para validar subtotal + IVA contra total.';
            } else if (Math.abs(diff) <= .02) {
                box.className = 'cti-notice cti-notice-green';
                box.innerHTML = `<b>Aritmética correcta.</b> Subtotal + IVA coincide con el total. IVA efectivo: ${subtotal ? ((iva / subtotal) * 100).toFixed(2) : '0.00'}%.`;
            } else {
                box.className = 'cti-notice cti-notice-red';
                box.innerHTML = `<b>Diferencia aritmética.</b> Subtotal + IVA difiere del total por ${money(diff)}.`;
            }
        }

