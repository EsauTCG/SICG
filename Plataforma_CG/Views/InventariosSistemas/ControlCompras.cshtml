    /* ============================================================
               PANTALLA COMPLETA Y DISEÑO RESPONSIVO
               ============================================================ */
    html, body {
        width: 100%;
        min-height: 100%;
        overflow-x: clip;
    }

    body {
        margin: 0;
    }

    /*
             * Full-bleed: rompe el límite de ancho del container del Layout
             * sin depender de la resolución del monitor.
             */
    .cti-app {
        position: relative;
        /* Evita que el encabezado fijo de _Layout2 cubra la parte superior. */
        top: var(--cti-header-clearance, 0px);
        left: 50%;
        width: 100dvw;
        max-width: none;
        min-height: calc(100dvh - var(--cti-top-offset, 0px));
        margin: 0 0 0 -50dvw;
        padding: clamp(6px, .7vw, 16px);
        font-size: clamp(11px, .68vw, 14px);
        overflow-x: clip;
    }

        .cti-app:fullscreen,
        .cti-app:-webkit-full-screen {
            top: 0;
            left: 0;
            width: 100vw;
            max-width: 100vw;
            height: 100vh;
            min-height: 100vh;
            margin: 0;
            padding: clamp(6px, .7vw, 16px);
            overflow: auto;
            background: var(--cti-page);
        }

