    /* ============================================================
               LIMPIEZA DEL CONTENEDOR HEREDADO DE _Layout2
               El layout coloca la vista dentro de una tarjeta blanca.
               Estas clases se asignan por JavaScript solo a los ancestros
               de #ctiApp, sin modificar el resto del sistema.
               ============================================================ */
    body.cti-page-active {
        background: var(--cti-page) !important;
    }

    .cti-layout-shell-clean {
        background: transparent !important;
        background-image: none !important;
        border: 0 !important;
        border-radius: 0 !important;
        box-shadow: none !important;
        outline: 0 !important;
    }

        .cti-layout-shell-clean.cti-layout-shell-inner {
            /* Conserva el padding superior de _Layout2: normalmente reserva
                   el espacio del header fijo. Solo se limpian laterales y fondo. */
            padding-right: 0 !important;
            padding-bottom: 0 !important;
            padding-left: 0 !important;
        }

        .cti-layout-shell-clean::before,
        .cti-layout-shell-clean::after {
            background: transparent !important;
            border: 0 !important;
            box-shadow: none !important;
        }

    /* ============================================================
           CONTROL DE COMPRAS TI — SIDEBAR RÁPIDO
           Pantalla completa dentro del espacio real de _Layout2.
           ============================================================ */

    .cti-sidebar-host {
        width: 100% !important;
        max-width: none !important;
        min-width: 0 !important;
        box-sizing: border-box !important;
    }

    .cti-sidebar-host-clean {
        padding-left: 0 !important;
        padding-right: 0 !important;
        border: 0 !important;
        border-radius: 0 !important;
        background: transparent !important;
        box-shadow: none !important;
    }

    /*
         * Sustituye únicamente el cálculo anterior basado en 100dvw,
         * left:50% y margen negativo. La posición y el ancho exterior
         * quedan controlados por _Layout2 y por el ajuste rápido del menú.
         */
    #ctiApp.cti-app {
        position: relative !important;
        top: var(--cti-header-clearance, 0px) !important;
        right: auto !important;
        transform: none !important;
        width: 100% !important;
        max-width: 100% !important;
        min-width: 0 !important;
        margin-left: 0 !important;
        margin-right: 0 !important;
        margin-bottom: 0 !important;
        align-self: stretch !important;
        overflow-x: hidden !important;
        transition: width .18s ease, max-width .18s ease, left .18s ease;
    }

    #ctiApp,
    #ctiApp .cti-hero,
    #ctiApp .cti-kpis,
    #ctiApp .cti-toolbar,
    #ctiApp .cti-workspace,
    #ctiApp .cti-panel,
    #ctiApp .cti-table-wrap,
    #ctiApp .cti-inspector-body,
    #ctiApp .cti-pager {
        min-width: 0 !important;
        max-width: 100% !important;
        box-sizing: border-box !important;
    }

        /*
         * Las tablas conservan su desplazamiento interno y nunca obligan
         * al área principal a mantener el ancho del sidebar cerrado.
         */
        #ctiApp .cti-table-wrap,
        #ctiApp .cti-inspector-body {
            overflow-x: auto !important;
            overflow-y: auto !important;
            overscroll-behavior: contain;
            scrollbar-gutter: stable;
        }

        #ctiApp .cti-table {
            max-width: none !important;
        }

    @@media (max-width: 720px) {
        #ctiApp.cti-app {
            left: 0 !important;
            width: 100% !important;
            max-width: 100% !important;
        }
    }
</style>

