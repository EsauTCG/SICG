        function wireRemoteSearch({ inputId, hiddenId, resultsId, url, onSelect, renderExtra }) {
            const input = $(inputId);
            const hidden = $(hiddenId);
            const results = $(resultsId);
            let timer;
            let request = 0;

            async function search() {
                const term = input.value.trim();
                hidden.value = '';
                if (term.length < 2) {
                    results.classList.remove('cti-open');
                    results.innerHTML = '';
                    return;
                }
                const current = ++request;
                try {
                    const data = await getJson(`${url}?term=${encodeURIComponent(term)}`);
                    if (current !== request) return;
                    if (!data.length) {
                        results.innerHTML = '<div class="cti-search-item"><small>Sin coincidencias.</small></div>';
                    } else {
                        results.innerHTML = data.map((item, index) => `<div class="cti-search-item" data-index="${index}"><b>${escapeHtml(item.text)}</b>${renderExtra ? renderExtra(item) : ''}</div>`).join('');
                        results.querySelectorAll('[data-index]').forEach(el => {
                            el.addEventListener('click', () => {
                                const item = data[Number(el.dataset.index)];
                                hidden.value = item.id;
                                input.value = item.text;
                                results.classList.remove('cti-open');
                                onSelect?.(item);
                            });
                        });
                    }
                    results.classList.add('cti-open');
                } catch (error) {
                    results.innerHTML = `<div class="cti-search-item"><small>${escapeHtml(error.message)}</small></div>`;
                    results.classList.add('cti-open');
                }
            }

            input.addEventListener('input', () => {
                clearTimeout(timer);
                timer = setTimeout(search, 260);
            });
            input.addEventListener('focus', () => { if (results.innerHTML) results.classList.add('cti-open'); });
            document.addEventListener('click', e => { if (!input.closest('.cti-search-box')?.contains(e.target)) results.classList.remove('cti-open'); });
        }

        function addRequestLine(defaultType = '', data = {}) {
            state.lineCounter++;
            const id = state.lineCounter;
            const row = document.createElement('div');
            row.className = 'cti-line-row';
            row.dataset.lineId = id;
            row.dataset.sapLine = data.lineaSap ?? '';
            row.dataset.costingCode = data.centroCostoSap ?? '';
            row.dataset.warehouseCode = data.almacenSap ?? '';
            row.dataset.preferredVendor = data.proveedorPreferidoSap ?? '';

            row.innerHTML = `
                <div class="cti-field"><label>Tipo</label><select class="cti-control cti-line-type"><option value="ARTICULO">Artículo</option><option value="ACTIVO_FIJO">Activo fijo</option><option value="CONSUMIBLE">Consumible</option><option value="SERVICIO">Servicio</option></select></div>
                <div class="cti-field"><label>Artículo SAP</label><div class="cti-search-box"><input class="cti-control cti-line-art-text" placeholder="Buscar SAP" autocomplete="off"><input type="hidden" class="cti-line-art-code"><div class="cti-search-results cti-line-art-results"></div></div></div>
                <div class="cti-field cti-line-description"><label>Descripción *</label><input class="cti-control cti-line-desc" maxlength="500" required></div>
                <div class="cti-field"><label>Cantidad *</label><input type="number" class="cti-control cti-line-qty" min="0.0001" step="0.0001" value="1" required></div>
                <div class="cti-field"><label>Unidad</label><input class="cti-control cti-line-unit" maxlength="30" value="PZA"></div>
                <button type="button" class="cti-btn cti-btn-danger cti-btn-sm cti-line-remove" title="Eliminar">×</button>
                <div class="cti-span-3 cti-muted" style="padding:0 8px 7px; font-size:10px;">
                    ${data.lineaSap !== undefined && data.lineaSap !== null ? `Línea SAP ${escapeHtml(data.lineaSap)} · ` : ''}
                    Centro ${escapeHtml(data.centroCostoSap || '-')} ·
                    Almacén ${escapeHtml(data.almacenSap || '-')} ·
                    Proveedor preferido ${escapeHtml(data.proveedorPreferidoSap || '-')}
                </div>`;

            $('ctiLineasSolicitud').appendChild(row);

            const type = row.querySelector('.cti-line-type');
            const artText = row.querySelector('.cti-line-art-text');
            const artCode = row.querySelector('.cti-line-art-code');
            const artResults = row.querySelector('.cti-line-art-results');
            const desc = row.querySelector('.cti-line-desc');
            const qty = row.querySelector('.cti-line-qty');
            const unit = row.querySelector('.cti-line-unit');
            let timer;

            type.value =
                defaultType ||
                data.tipoLinea ||
                ($('ctiNuevaTipo').value === 'SERVICIO'
                    ? 'SERVICIO'
                    : $('ctiNuevaTipo').value);

            artCode.value = data.itemCode || '';
            artText.value = data.itemCode || '';
            desc.value = data.descripcion || '';
            qty.value = Number(data.cantidad || 1);
            unit.value = data.unidad || 'PZA';

            type.addEventListener('change', () => {
                const service = type.value === 'SERVICIO';
                artText.disabled = service;

                if (service) {
                    artText.value = '';
                    artCode.value = '';
                    artResults.classList.remove('cti-open');
                } else if (data.itemCode && !artText.value) {
                    artText.value = data.itemCode;
                    artCode.value = data.itemCode;
                }
            });

            type.dispatchEvent(new Event('change'));

            artText.addEventListener('input', () => {
                artCode.value = '';
                clearTimeout(timer);

                timer = setTimeout(async () => {
                    const term = artText.value.trim();

                    if (term.length < 2) {
                        artResults.classList.remove('cti-open');
                        return;
                    }

                    try {
                        const list = await getJson(
                            `${urls.articulos}?term=${encodeURIComponent(term)}`
                        );

                        artResults.innerHTML = list.length
                            ? list.map((x, i) => `
                                <div class="cti-search-item" data-i="${i}">
                                    <b>${escapeHtml(x.codigo)}</b>
                                    <small>${escapeHtml(x.nombre)}</small>
                                </div>`).join('')
                            : '<div class="cti-search-item"><small>Sin coincidencias.</small></div>';

                        artResults.querySelectorAll('[data-i]').forEach(el =>
                            el.addEventListener('click', () => {
                                const item = list[Number(el.dataset.i)];
                                artCode.value = item.codigo;
                                artText.value = item.text;
                                if (!desc.value.trim()) desc.value = item.nombre;
                                artResults.classList.remove('cti-open');
                            })
                        );

                        artResults.classList.add('cti-open');
                    } catch (error) {
                        toast(error.message, 'error');
                    }
                }, 260);
            });

            row.querySelector('.cti-line-remove').addEventListener('click', () => {
                if ($('ctiLineasSolicitud').children.length <= 1) {
                    return toast('Debe existir al menos un concepto.', 'error');
                }

                row.remove();
            });
        }

