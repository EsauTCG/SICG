@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Control de Compras TI";
}

@Html.AntiForgeryToken()

<style>
    :root {
        --cti-wine: #7a1014;
        --cti-wine-2: #a5151c;
        --cti-wine-3: #4f080b;
        --cti-rose: #f6e7e7;
        --cti-rose-2: #ead0d1;
        --cti-paper: #fffafa;
        --cti-page: #e9edf2;
        --cti-line: #d9b5b7;
        --cti-ink: #301316;
        --cti-muted: #765b5d;
        --cti-green: #15803d;
        --cti-green-bg: #dcfce7;
        --cti-amber: #a16207;
        --cti-amber-bg: #fef3c7;
        --cti-red: #b91c1c;
        --cti-red-bg: #fee2e2;
        --cti-blue: #1d4ed8;
        --cti-blue-bg: #dbeafe;
        --cti-gray: #64748b;
        --cti-gray-bg: #f1f5f9;
        --cti-shadow: 0 14px 30px rgba(70, 12, 12, .13);
    }

    body {
        background: var(--cti-page) !important;
    }

    .cti-app {
        width: min(100%, 1900px);
        margin: 0 auto;
        padding: 10px;
        color: var(--cti-ink);
        font-family: "Segoe UI", Tahoma, sans-serif;
        font-size: 13px;
    }

        .cti-app *, .cti-app *::before, .cti-app *::after {
            box-sizing: border-box;
        }

    .cti-hero {
        margin-bottom: 12px;
        padding: 18px;
        color: #fff;
        border: 1px solid #6d292c;
        background: linear-gradient(180deg, var(--cti-wine-2), var(--cti-wine) 58%, var(--cti-wine-3));
        box-shadow: var(--cti-shadow);
    }

    .cti-hero-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
    }

    .cti-hero h1 {
        margin: 0 0 3px;
        font-size: 23px;
        font-weight: 900;
    }

    .cti-hero p {
        margin: 0;
        opacity: .86;
    }

    .cti-hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .cti-btn {
        min-height: 36px;
        padding: 8px 12px;
        border: 1px solid var(--cti-line);
        border-radius: 0;
        background: linear-gradient(#fff, #f1dddd);
        color: #4a171a;
        font-weight: 800;
        cursor: pointer;
        transition: .16s ease;
    }

        .cti-btn:hover:not(:disabled) {
            border-color: var(--cti-wine);
            filter: brightness(.98);
            transform: translateY(-1px);
        }

        .cti-btn:disabled {
            opacity: .42;
            cursor: not-allowed;
            transform: none;
        }

    .cti-btn-primary {
        color: #fff;
        border-color: #5e171a;
        background: linear-gradient(180deg, #c1161e, var(--cti-wine), var(--cti-wine-3));
    }

    .cti-btn-light {
        color: var(--cti-wine);
        border-color: rgba(255,255,255,.5);
        background: #fff;
    }

    .cti-btn-danger {
        color: #fff;
        border-color: #6f0d11;
        background: linear-gradient(#c9333a, #8b1116);
    }

    .cti-btn-success {
        color: #fff;
        border-color: #116932;
        background: linear-gradient(#22a65a, #13753c);
    }

    .cti-btn-sm {
        min-height: 29px;
        padding: 5px 8px;
        font-size: 11px;
    }

    .cti-kpis {
        display: grid;
        grid-template-columns: repeat(7, minmax(125px, 1fr));
        gap: 9px;
        margin-top: 16px;
    }

    .cti-kpi {
        position: relative;
        min-height: 90px;
        overflow: hidden;
        padding: 13px 15px;
        border: 1px solid rgba(255,255,255,.25);
        background: rgba(255,255,255,.12);
        box-shadow: inset 4px 0 rgba(255,255,255,.18);
        cursor: pointer;
    }

        .cti-kpi::after {
            content: "";
            position: absolute;
            right: -32px;
            bottom: -42px;
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: rgba(255,255,255,.13);
        }

        .cti-kpi span, .cti-kpi strong {
            position: relative;
            z-index: 1;
            display: block;
        }

        .cti-kpi span {
            font-size: 9px;
            font-weight: 900;
            letter-spacing: .07em;
            text-transform: uppercase;
            opacity: .92;
        }

        .cti-kpi strong {
            margin-top: 8px;
            font-size: 27px;
            line-height: 1;
        }

        .cti-kpi.cti-alert {
            background: linear-gradient(135deg, #b7791f, #d99a28, #8a4f05);
        }

        .cti-kpi.cti-danger {
            background: linear-gradient(135deg, #b91c1c, #dc2626, #7f1d1d);
        }

        .cti-kpi.cti-ok {
            background: linear-gradient(135deg, #157f49, #22a65a, #0f5132);
        }

        .cti-kpi.cti-blue {
            background: linear-gradient(135deg, #1d4ed8, #2563eb, #1e3a8a);
        }

    .cti-toolbar {
        display: grid;
        grid-template-columns: minmax(260px, 2fr) minmax(180px, 1fr) minmax(120px, .6fr) auto auto;
        gap: 8px;
        align-items: end;
        margin-bottom: 10px;
        padding: 10px;
        border: 1px solid var(--cti-line);
        background: #f1dede;
    }

    .cti-field label {
        display: block;
        margin-bottom: 3px;
        color: #6a3a3a;
        font-size: 9px;
        font-weight: 900;
        letter-spacing: .07em;
        text-transform: uppercase;
    }

    .cti-control {
        width: 100%;
        min-height: 37px;
        padding: 7px 9px;
        border: 1px solid #b48787;
        border-radius: 0;
        outline: 0;
        background: var(--cti-paper);
        color: #421414;
        font: inherit;
    }

        .cti-control:focus {
            border-color: var(--cti-wine);
            box-shadow: 0 0 0 3px rgba(139,0,0,.1);
        }

    textarea.cti-control {
        min-height: 80px;
        resize: vertical;
    }

    .cti-workspace {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(350px, 410px);
        gap: 10px;
    }

    .cti-panel {
        border: 1px solid var(--cti-line);
        background: var(--cti-paper);
        box-shadow: 0 5px 15px rgba(70,12,12,.05);
    }

    .cti-panel-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding: 11px 13px;
        border-bottom: 1px solid var(--cti-line);
        background: #f1dede;
    }

        .cti-panel-head h3 {
            margin: 0;
            color: #5c1a1a;
            font-size: 13px;
            font-weight: 900;
        }

        .cti-panel-head small {
            color: var(--cti-muted);
        }

    .cti-table-wrap {
        max-height: 66vh;
        overflow: auto;
    }

    .cti-table {
        width: 100%;
        min-width: 1120px;
        border-collapse: separate;
        border-spacing: 0;
        font-size: 11px;
    }

        .cti-table th {
            position: sticky;
            top: 0;
            z-index: 3;
            padding: 8px 7px;
            border-right: 1px solid #8e3b3b;
            background: linear-gradient(180deg, var(--cti-wine-2), var(--cti-wine), var(--cti-wine-3));
            color: #fff;
            text-align: left;
            white-space: nowrap;
        }

        .cti-table td {
            padding: 8px 7px;
            border-right: 1px solid #d8bcbc;
            border-bottom: 1px solid #d8bcbc;
            background: var(--cti-paper);
            vertical-align: middle;
        }

        .cti-table tbody tr:nth-child(even) td {
            background: #f9eded;
        }

        .cti-table tbody tr:hover td, .cti-table tbody tr.cti-selected td {
            background: #f3dada;
        }

        .cti-table tbody tr {
            cursor: pointer;
        }

    .cti-folio {
        color: var(--cti-wine);
        font-weight: 900;
    }

    .cti-money {
        text-align: right;
        font-variant-numeric: tabular-nums;
        font-weight: 800;
    }

    .cti-muted {
        color: var(--cti-muted);
    }

    .cti-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 3px 7px;
        border: 1px solid transparent;
        font-size: 9px;
        font-weight: 900;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .cti-b-green {
        color: #166534;
        border-color: #86efac;
        background: var(--cti-green-bg);
    }

    .cti-b-amber {
        color: #854d0e;
        border-color: #fde68a;
        background: var(--cti-amber-bg);
    }

    .cti-b-red {
        color: #991b1b;
        border-color: #fca5a5;
        background: var(--cti-red-bg);
    }

    .cti-b-blue {
        color: #1e40af;
        border-color: #93c5fd;
        background: var(--cti-blue-bg);
    }

    .cti-b-gray {
        color: #475569;
        border-color: #cbd5e1;
        background: var(--cti-gray-bg);
    }

    .cti-inspector-body {
        max-height: 66vh;
        overflow: auto;
        padding: 12px;
    }

    .cti-empty {
        padding: 55px 15px;
        color: var(--cti-muted);
        text-align: center;
    }

    .cti-exp-title {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 8px;
        margin-bottom: 10px;
        padding-bottom: 10px;
        border-bottom: 1px solid var(--cti-line);
    }

        .cti-exp-title h4 {
            margin: 0;
            font-size: 15px;
        }

    .cti-summary-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 7px;
        margin-bottom: 11px;
    }

    .cti-summary {
        min-width: 0;
        padding: 8px;
        border: 1px solid var(--cti-line);
        background: #fff;
    }

        .cti-summary span {
            display: block;
            color: var(--cti-muted);
            font-size: 8px;
            font-weight: 900;
            text-transform: uppercase;
        }

        .cti-summary b {
            display: block;
            margin-top: 3px;
            overflow-wrap: anywhere;
            font-size: 11px;
        }

    .cti-section {
        margin-top: 12px;
        border: 1px solid var(--cti-line);
        background: #fff;
    }

    .cti-section-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 6px;
        padding: 8px 9px;
        border-bottom: 1px solid var(--cti-line);
        background: #f7eaea;
        color: var(--cti-wine);
        font-size: 10px;
        font-weight: 900;
        text-transform: uppercase;
    }

    .cti-section-body {
        padding: 9px;
    }

    .cti-mini-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 10px;
    }

        .cti-mini-table th, .cti-mini-table td {
            padding: 6px;
            border: 1px solid #e1c4c6;
            text-align: left;
            vertical-align: top;
        }

        .cti-mini-table th {
            background: #f5e3e4;
            color: #5c1a1a;
        }

    .cti-match {
        margin-bottom: 11px;
        padding: 10px;
        border: 1px solid var(--cti-line);
        background: #fff;
    }

        .cti-match h5 {
            margin: 0 0 8px;
            font-size: 11px;
        }

    .cti-match-row {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 8px;
        padding: 5px 0;
        border-bottom: 1px dashed #e3c7c8;
    }

        .cti-match-row:last-child {
            border: 0;
        }

        .cti-match-row strong {
            font-variant-numeric: tabular-nums;
        }

    .cti-notice {
        margin-bottom: 9px;
        padding: 9px 10px;
        border-left: 4px solid;
    }

    .cti-notice-red {
        border-color: var(--cti-red);
        background: var(--cti-red-bg);
        color: #7f1d1d;
    }

    .cti-notice-amber {
        border-color: #d97706;
        background: var(--cti-amber-bg);
        color: #78350f;
    }

    .cti-notice-green {
        border-color: var(--cti-green);
        background: var(--cti-green-bg);
        color: #14532d;
    }

    .cti-notice-blue {
        border-color: var(--cti-blue);
        background: var(--cti-blue-bg);
        color: #1e3a8a;
    }

    .cti-action-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 7px;
        margin-top: 12px;
    }

        .cti-action-grid .cti-wide {
            grid-column: 1 / -1;
        }

    .cti-timeline {
        margin-left: 7px;
        padding-left: 14px;
        border-left: 2px solid #c99b9e;
    }

    .cti-event {
        position: relative;
        margin-bottom: 13px;
    }

        .cti-event::before {
            content: "";
            position: absolute;
            left: -20px;
            top: 3px;
            width: 10px;
            height: 10px;
            border: 2px solid #fff;
            border-radius: 50%;
            background: var(--cti-wine);
            box-shadow: 0 0 0 1px var(--cti-line);
        }

        .cti-event b {
            display: block;
            font-size: 10px;
        }

        .cti-event small {
            color: var(--cti-muted);
            font-size: 9px;
        }

        .cti-event p {
            margin: 3px 0 0;
            font-size: 10px;
            white-space: pre-wrap;
        }

    .cti-pager {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 7px;
        padding: 9px;
        border-top: 1px solid var(--cti-line);
        background: #f8eeee;
    }

    .cti-modal-backdrop {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 1055;
        place-items: center;
        overflow: auto;
        padding: 14px;
        background: rgba(30,5,7,.72);
    }

        .cti-modal-backdrop.cti-show {
            display: grid;
        }

    .cti-modal {
        width: min(940px, 100%);
        max-height: calc(100vh - 28px);
        overflow: auto;
        border: 1px solid #7d4949;
        background: #f7eaea;
        box-shadow: 0 24px 70px rgba(0,0,0,.42);
    }

    .cti-modal-sm {
        width: min(620px, 100%);
    }

    .cti-modal-lg {
        width: min(1120px, 100%);
    }

    .cti-modal-head {
        position: sticky;
        top: 0;
        z-index: 3;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding: 12px 15px;
        background: linear-gradient(180deg, var(--cti-wine-2), var(--cti-wine), var(--cti-wine-3));
        color: #fff;
    }

        .cti-modal-head h3 {
            margin: 0;
            font-size: 14px;
        }

    .cti-modal-close {
        border: 0;
        background: transparent;
        color: #fff;
        font-size: 23px;
        cursor: pointer;
    }

    .cti-modal-body {
        padding: 14px;
    }

    .cti-modal-foot {
        position: sticky;
        bottom: 0;
        z-index: 3;
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        padding: 10px 14px;
        border-top: 1px solid var(--cti-line);
        background: #f7eaea;
    }

    .cti-form-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
    }

    .cti-span-2 {
        grid-column: span 2;
    }

    .cti-span-3 {
        grid-column: 1 / -1;
    }

    .cti-check-row {
        display: flex;
        align-items: center;
        gap: 8px;
        min-height: 37px;
        padding: 7px 9px;
        border: 1px solid #b48787;
        background: #fffafa;
    }

    .cti-line-editor {
        margin-top: 12px;
        border: 1px solid var(--cti-line);
        background: #fff;
    }

    .cti-line-editor-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding: 8px 10px;
        border-bottom: 1px solid var(--cti-line);
        background: #f1dede;
    }

    .cti-line-row {
        display: grid;
        grid-template-columns: 125px minmax(140px, .8fr) minmax(250px, 2fr) 95px 85px 38px;
        gap: 6px;
        align-items: end;
        padding: 8px;
        border-bottom: 1px solid #ead0d1;
    }

        .cti-line-row:last-child {
            border-bottom: 0;
        }

    .cti-search-box {
        position: relative;
    }

    .cti-search-results {
        display: none;
        position: absolute;
        left: 0;
        right: 0;
        top: 100%;
        z-index: 20;
        max-height: 220px;
        overflow: auto;
        border: 1px solid #9e6d70;
        background: #fff;
        box-shadow: 0 10px 22px rgba(70,12,12,.18);
    }

        .cti-search-results.cti-open {
            display: block;
        }

    .cti-search-item {
        padding: 8px 9px;
        border-bottom: 1px solid #ead7d8;
        cursor: pointer;
    }

        .cti-search-item:hover {
            background: #f6e4e5;
        }

        .cti-search-item b {
            display: block;
            color: var(--cti-wine);
        }

        .cti-search-item small {
            color: var(--cti-muted);
        }

    .cti-picker-control {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 6px;
        align-items: stretch;
    }

        .cti-picker-control .cti-control[readonly] {
            background: #fff !important;
            cursor: pointer;
        }

    .cti-selection-card {
        min-height: 42px;
        margin-top: 6px;
        padding: 8px 10px;
        border: 1px solid var(--cti-line);
        background: #fff;
        color: var(--cti-muted);
        font-size: 11px;
        line-height: 1.35;
    }

        .cti-selection-card strong {
            color: var(--cti-wine);
        }

    .cti-modal-xl {
        width: min(1280px, 100%);
    }

    .cti-picker-toolbar {
        display: grid;
        grid-template-columns: minmax(240px, 1fr) minmax(130px, 180px) auto;
        gap: 8px;
        align-items: end;
        margin-bottom: 10px;
    }

    .cti-picker-table-wrap {
        max-height: 58vh;
        overflow: auto;
        border: 1px solid var(--cti-line);
        background: #fff;
    }

    .cti-picker-table {
        width: 100%;
        min-width: 900px;
        border-collapse: separate;
        border-spacing: 0;
        font-size: 11px;
    }

        .cti-picker-table th {
            position: sticky;
            top: 0;
            z-index: 2;
            padding: 8px;
            border-right: 1px solid #8e3b3b;
            background: linear-gradient(180deg, var(--cti-wine-2), var(--cti-wine), var(--cti-wine-3));
            color: #fff;
            text-align: left;
            white-space: nowrap;
        }

        .cti-picker-table td {
            padding: 8px;
            border-right: 1px solid #ead0d1;
            border-bottom: 1px solid #ead0d1;
            vertical-align: top;
        }

        .cti-picker-table tbody tr:hover td {
            background: #f7e5e6;
        }

    .cti-picker-empty {
        padding: 35px 15px !important;
        color: var(--cti-muted);
        text-align: center;
    }

    .cti-sap-chip {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        margin: 2px 3px 2px 0;
        padding: 2px 6px;
        border: 1px solid #c5d5f5;
        background: #eef4ff;
        color: #1e4f9f;
        font-size: 9px;
        font-weight: 800;
    }


    .cti-doc-box {
        margin-bottom: 10px;
        padding: 14px;
        border: 2px dashed #c79d9d;
        background: #fffafa;
        text-align: center;
    }

    .cti-compare {
        width: 100%;
        margin-top: 10px;
        border-collapse: collapse;
    }

        .cti-compare th, .cti-compare td {
            padding: 7px;
            border: 1px solid var(--cti-line);
            text-align: right;
        }

            .cti-compare th:first-child, .cti-compare td:first-child {
                text-align: left;
            }

    .cti-loading {
        position: fixed;
        inset: 0;
        z-index: 1080;
        display: none;
        place-items: center;
        background: rgba(255,255,255,.64);
        backdrop-filter: blur(1px);
    }

        .cti-loading.cti-show {
            display: grid;
        }

    .cti-loader-card {
        min-width: 220px;
        padding: 18px;
        border: 1px solid var(--cti-line);
        background: #fff;
        box-shadow: var(--cti-shadow);
        text-align: center;
        font-weight: 900;
    }

    .cti-spinner {
        display: inline-block;
        width: 28px;
        height: 28px;
        margin-bottom: 8px;
        border: 3px solid #ead0d1;
        border-top-color: var(--cti-wine);
        border-radius: 50%;
        animation: cti-spin .7s linear infinite;
    }

    @@keyframes cti-spin {
        to {
            transform: rotate(360deg);
        }
    }

    .cti-toast-host {
        position: fixed;
        right: 16px;
        bottom: 16px;
        z-index: 1100;
        display: grid;
        gap: 8px;
        width: min(390px, calc(100vw - 32px));
    }

    .cti-toast {
        padding: 11px 13px;
        border: 1px solid;
        background: #fff;
        box-shadow: 0 12px 28px rgba(0,0,0,.18);
        animation: cti-in .18s ease-out;
    }

