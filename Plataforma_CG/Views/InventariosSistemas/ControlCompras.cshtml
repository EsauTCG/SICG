        }

    .cti-hero-actions {
        align-items: center;
    }

    .cti-kpis {
        grid-template-columns: repeat(auto-fit, minmax(clamp(128px, 10.5vw, 210px), 1fr));
        gap: clamp(6px, .55vw, 11px);
        margin-top: clamp(10px, .9vw, 18px);
    }

    .cti-kpi {
        min-height: clamp(72px, 6vw, 104px);
        padding: clamp(9px, .8vw, 16px);
    }

        .cti-kpi span {
            font-size: clamp(8px, .52vw, 10px);
        }

        .cti-kpi strong {
            font-size: clamp(22px, 1.7vw, 34px);
        }

    .cti-toolbar {
        grid-template-columns: minmax(240px, 2.4fr) minmax(165px, 1fr) minmax(105px, .55fr) auto auto;
        gap: clamp(6px, .5vw, 10px);
        padding: clamp(7px, .65vw, 12px);
    }

    /*
             * En escritorio, tabla e inspector ocupan toda la altura disponible.
             * JavaScript calcula --cti-workspace-height según el monitor.
             */
    .cti-workspace {
        grid-template-columns: minmax(0, 1fr) clamp(350px, 25vw, 540px);
        height: var(--cti-workspace-height, auto);
        min-height: 390px;
        gap: clamp(7px, .6vw, 12px);
    }

        .cti-workspace > .cti-panel {
            display: flex;
            min-width: 0;
            min-height: 0;
            overflow: hidden;
            flex-direction: column;
        }

    .cti-table-wrap,
    .cti-inspector-body {
        flex: 1 1 auto;
        min-height: 0;
        max-height: none;
        overflow: auto;
        overscroll-behavior: contain;
        scrollbar-gutter: stable;
    }

    .cti-table {
        width: 100%;
        min-width: max(1120px, 72vw);
    }

    .cti-panel-head,
    .cti-pager {
        flex: 0 0 auto;
    }

    .cti-modal-backdrop {
        padding: clamp(5px, 1vw, 18px);
    }

    .cti-modal {
        width: min(1000px, calc(100dvw - 20px));
        max-width: calc(100dvw - 20px);
        max-height: calc(100dvh - 20px);
    }

    .cti-modal-sm {
        width: min(680px, calc(100dvw - 20px));
    }

    .cti-modal-lg {
        width: min(1240px, calc(100dvw - 20px));
    }

    .cti-modal-xl {
        width: min(1680px, calc(100dvw - 20px));
    }

    .cti-modal-body {
        padding: clamp(9px, .9vw, 16px);
    }

    .cti-picker-table-wrap {
        max-height: min(64dvh, 760px);
    }

    .cti-form-grid {
        grid-template-columns: repeat(12, minmax(0, 1fr));
    }

        .cti-form-grid > .cti-field {
            grid-column: span 4;
            min-width: 0;
        }

        .cti-form-grid > .cti-span-2 {
            grid-column: span 8;
        }

        .cti-form-grid > .cti-span-3 {
            grid-column: 1 / -1;
        }

    .cti-line-row {
        grid-template-columns: minmax(118px, .75fr) minmax(145px, 1fr) minmax(260px, 3fr) minmax(85px, .55fr) minmax(78px, .55fr) 38px;
