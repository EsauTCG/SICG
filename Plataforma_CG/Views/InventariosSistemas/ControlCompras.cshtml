        // ============================================================
        // PANTALLA COMPLETA Y ALTURA RESPONSIVA
        // ============================================================
        function isCtiFullscreen() {
            return document.fullscreenElement === $('ctiApp') ||
                   document.webkitFullscreenElement === $('ctiApp');
        }

        function updateFullscreenButton() {
            const active = isCtiFullscreen();
            const icon = $('ctiFullscreenIcon');
            const label = $('ctiFullscreenText');

            if (icon) {
                icon.className = active
                    ? 'bi bi-fullscreen-exit me-1'
                    : 'bi bi-arrows-fullscreen me-1';
            }

            if (label) {
                label.textContent = active
                    ? 'Salir de pantalla completa'
                    : 'Pantalla completa';
            }
        }

        async function toggleCtiFullscreen() {
            const app = $('ctiApp');

            try {
                if (!isCtiFullscreen()) {
                    if (app.requestFullscreen) {
                        await app.requestFullscreen();
                    } else if (app.webkitRequestFullscreen) {
                        app.webkitRequestFullscreen();
                    } else {
                        return toast(
                            'Este navegador no permite el modo de pantalla completa.',
                            'error'
                        );
                    }
                } else if (document.exitFullscreen) {
                    await document.exitFullscreen();
                } else if (document.webkitExitFullscreen) {
                    document.webkitExitFullscreen();
                }
            } catch (error) {
                toast(
                    `No fue posible cambiar a pantalla completa. ${error.message || ''}`,
                    'error'
                );
            } finally {
                window.setTimeout(() => {
                    updateFullscreenButton();
                    updateResponsiveWorkspace();
                }, 80);
            }
        }

        function getCtiFixedHeaderBottom() {
            if (isCtiFullscreen()) return 0;

            const selectors = [
                'body > header',
                'header',
                'nav',
                '.navbar',
                '.topbar',
                '.main-header',
                '.app-header',
                '.fixed-top',
                '[class*="topbar"]',
                '[class*="header"]'
            ];

            let bottom = 0;

            document.querySelectorAll(selectors.join(','))
                .forEach(element => {
                    if (element.closest('#ctiApp')) return;

                    const style = window.getComputedStyle(element);
                    const rect = element.getBoundingClientRect();
                    const isFixed = style.position === 'fixed' ||
                                    style.position === 'sticky';
                    const isVisible = style.display !== 'none' &&
                                      style.visibility !== 'hidden' &&
                                      Number(style.opacity || 1) > 0 &&
                                      rect.width > 0 &&
                                      rect.height > 0;
                    const isTopBar = rect.bottom > 0 &&
                                     rect.top < Math.min(240, window.innerHeight * .30) &&
                                     rect.width >= window.innerWidth * .45;

                    if (isFixed && isVisible && isTopBar) {
                        bottom = Math.max(bottom, rect.bottom);
                    }
                });

            return Math.max(0, Math.ceil(bottom));
        }

        function updateResponsiveWorkspace() {
            const app = $('ctiApp');
            const workspace = document.querySelector('.cti-workspace');

            if (!app || !workspace) return;

            /*
             * Primero se mide la posición natural de la vista sin corrección.
             * Después se desplaza únicamente lo necesario para terminar debajo
             * del encabezado fijo de _Layout2.
             */
            app.style.setProperty('--cti-header-clearance', '0px');

            const naturalTop = app.getBoundingClientRect().top;
            const headerBottom = getCtiFixedHeaderBottom();
            const clearance = isCtiFullscreen()
                ? 0
                : Math.max(0, headerBottom - naturalTop + 6);

            app.style.setProperty(
                '--cti-header-clearance',
                `${Math.ceil(clearance)}px`
            );

            const appTop = Math.max(0, naturalTop + clearance);
            app.style.setProperty(
                '--cti-top-offset',
                `${Math.round(appTop)}px`
            );

            /*
             * En tablet/móvil la pantalla fluye verticalmente.
             * En escritorio tabla e inspector aprovechan el alto restante.
             */
            if (window.matchMedia('(max-width: 1180px)').matches) {
                app.style.removeProperty('--cti-workspace-height');
                return;
            }

            const workspaceTop = workspace.getBoundingClientRect().top;
            const bottomSpace = isCtiFullscreen() ? 8 : 12;
            const viewportHeight = window.visualViewport?.height ||
                                   window.innerHeight;
            const available = Math.max(
                390,
                viewportHeight - workspaceTop - bottomSpace
            );

            app.style.setProperty(
                '--cti-workspace-height',
                `${Math.floor(available)}px`
            );
        }

        let ctiResizeTimer = 0;
        function scheduleResponsiveUpdate() {
            window.clearTimeout(ctiResizeTimer);
            ctiResizeTimer = window.setTimeout(
                updateResponsiveWorkspace,
                80
            );
        }

        // Eventos generales
        document.querySelectorAll('[data-close-modal]').forEach(btn => btn.addEventListener('click', () => closeModal(btn.dataset.closeModal)));
        document.querySelectorAll('.cti-modal-backdrop').forEach(backdrop => backdrop.addEventListener('click', e => { if (e.target === backdrop) closeModal(backdrop.id); }));
        document.addEventListener('keydown', e => { if (e.key === 'Escape') document.querySelectorAll('.cti-modal-backdrop.cti-show').forEach(x => closeModal(x.id)); });

        $('ctiSolicitudesBody').addEventListener('click', e => {
            const row = e.target.closest('tr[data-id]');
            if (row) selectSolicitud(Number(row.dataset.id));
        });

        $('ctiInspector').addEventListener('click', e => {
            const action = e.target.closest('[data-action]')?.dataset.action;
            if (!action) return;
            ({
                proveedor: openProviderModal,
                cotizacion: openQuoteModal,
                autorizar: openAuthorizationModal,
                ordenes: syncPurchaseOrders,
                recepcion: openReceiptModal,
                factura: openInvoiceModal,
                pago: openPaymentModal,
                imprimir: printExecutive
            })[action]?.();
        });

        $('ctiBtnNueva').addEventListener('click', () => { resetNewRequest(); openModal('ctiModalNueva'); });
        $('ctiBtnFullscreen').addEventListener('click', toggleCtiFullscreen);
        $('ctiBtnRecargar').addEventListener('click', () => refreshAll(state.selectedId));

        window.addEventListener('resize', scheduleResponsiveUpdate, { passive: true });
        window.addEventListener('orientationchange', scheduleResponsiveUpdate, { passive: true });
        window.visualViewport?.addEventListener(
            'resize',
            scheduleResponsiveUpdate,
            { passive: true }
        );
        document.addEventListener('fullscreenchange', () => {
            updateFullscreenButton();
            scheduleResponsiveUpdate();
        });
        document.addEventListener('webkitfullscreenchange', () => {
            updateFullscreenButton();
            scheduleResponsiveUpdate();
        });
        $('ctiBtnBuscar').addEventListener('click', () => { state.page = 1; refreshAll(); });
        $('ctiBtnLimpiar').addEventListener('click', () => { $('ctiFiltroBuscar').value = ''; $('ctiFiltroEstatus').value = ''; state.page = 1; refreshAll(); });
        $('ctiFiltroBuscar').addEventListener('keydown', e => { if (e.key === 'Enter') { state.page = 1; refreshAll(); } });
        $('ctiFiltroEstatus').addEventListener('change', () => { state.page = 1; refreshAll(); });
        $('ctiPageSize').addEventListener('change', () => { state.pageSize = Number($('ctiPageSize').value); state.page = 1; refreshAll(); });
        $('ctiPrevPage').addEventListener('click', () => { if (state.page > 1) { state.page--; refreshAll(); } });
        $('ctiNextPage').addEventListener('click', () => { if (state.page * state.pageSize < state.total) { state.page++; refreshAll(); } });
        document.querySelectorAll('.cti-kpi[data-kpi-status]').forEach(kpi => kpi.addEventListener('click', () => { $('ctiFiltroEstatus').value = kpi.dataset.kpiStatus; state.page = 1; refreshAll(); }));


        $('ctiBtnBuscarSolicitudSap').addEventListener('click', () => {
            openModal('ctiModalSolicitudSap');
            loadSapPurchaseRequests();
        });

        $('ctiBtnConsultarSolicitudesSap').addEventListener('click', loadSapPurchaseRequests);
        $('ctiSapSolicitudBuscar').addEventListener('keydown', e => {
            if (e.key === 'Enter') {
                e.preventDefault();
                loadSapPurchaseRequests();
            }
        });

        $('ctiSapSolicitudesBody').addEventListener('click', e => {
            const button = e.target.closest('[data-select-sap]');
            if (button) selectSapPurchaseRequest(button.dataset.selectSap);
        });

        $('ctiBtnBuscarCentroCosto').addEventListener('click', () => {
            openModal('ctiModalCentroCosto');
            loadCostCenters();
        });

        $('ctiBtnConsultarCentrosCosto').addEventListener('click', loadCostCenters);
        $('ctiCentroCostoBuscar').addEventListener('keydown', e => {
            if (e.key === 'Enter') {
                e.preventDefault();
                loadCostCenters();
            }
        });

        $('ctiCentrosCostoBody').addEventListener('click', e => {
            const button = e.target.closest('[data-select-centro]');
            if (!button) return;
            const item = state.centrosCostoSap[Number(button.dataset.selectCentro)];
            selectCostCenter(item);
        });

        $('ctiBtnBuscarProveedorInicial').addEventListener('click', () => {
            openModal('ctiModalProveedorInicial');
            loadInitialProviders();
        });

        $('ctiBtnConsultarProveedorInicial').addEventListener('click', loadInitialProviders);
        $('ctiProveedorInicialBuscar').addEventListener('keydown', e => {
            if (e.key === 'Enter') {
                e.preventDefault();
                loadInitialProviders();
            }
        });

        $('ctiProveedorInicialBody').addEventListener('click', e => {
            const button = e.target.closest('[data-select-provider]');
            if (!button) return;
            const item =
                state.proveedoresIniciales[Number(button.dataset.selectProvider)];
            selectInitialProvider(item);
        });

        $('ctiBtnLimpiarProveedorInicial').addEventListener('click', () => {
            clearInitialProvider();
            closeModal('ctiModalProveedorInicial');
        });

        $('ctiBtnSyncProveedores').addEventListener('click', async () => {
            if (!canWrite()) return;
            showLoading('Sincronizando proveedores con SAP...');
            try {
                const data = await postForm(urls.syncProveedores, new FormData());
                toast(`${data.mensaje} Insertados: ${data.insertados}; actualizados: ${data.actualizados}.`, 'success', 6000);
            } catch (error) { toast(error.message, 'error'); }
            finally { hideLoading(); }
        });

        wireRemoteSearch({
            inputId: 'ctiAsignarProveedorText', hiddenId: 'ctiAsignarProveedorCodigo', resultsId: 'ctiAsignarProveedorResults', url: urls.proveedores,
            renderExtra: item => `<small>RFC ${escapeHtml(item.rfc || '-')} · ${escapeHtml(item.condicionPago || '')}</small>`
        });

        $('ctiBtnAgregarLinea').addEventListener('click', () => addRequestLine());
        $('ctiNuevaTipo').addEventListener('change', () => {
            document.querySelectorAll('#ctiLineasSolicitud .cti-line-type').forEach(select => {
                if (select.value !== 'SERVICIO') {
                    select.value = $('ctiNuevaTipo').value === 'SERVICIO' ? 'SERVICIO' : $('ctiNuevaTipo').value;
                    select.dispatchEvent(new Event('change'));
                }
            });
        });

        $('ctiFormNueva').addEventListener('submit', async e => {
            e.preventDefault();
            const details = requestLinesPayload();

            if (!$('ctiNuevaSapDocEntry').value) {
                return toast('Selecciona una solicitud directamente desde SAP.', 'error');
            }

            if (!$('ctiNuevaCentroCosto').value) {
                return toast('Selecciona un centro de costo del catálogo SAP.', 'error');
            }

            if (details.some(x => !x.descripcion || x.cantidad <= 0)) return toast('Revisa descripción y cantidad de todos los conceptos.', 'error');
            const payload = {
                solicitudSap: $('ctiNuevaSap').value.trim(),
                solicitudSapDocEntry: Number($('ctiNuevaSapDocEntry').value || 0),
                tipoCompra: $('ctiNuevaTipo').value,
                titulo: $('ctiNuevaTitulo').value.trim(),
                justificacion: $('ctiNuevaJustificacion').value.trim(),
                centroCosto: $('ctiNuevaCentroCosto').value.trim(),
                planta: $('ctiNuevaPlanta').value.trim(),
                proveedorSapCodigo: $('ctiNuevaProveedorCodigo').value,
                detalles: details
            };
            showLoading('Creando expediente...');
            try {
                const data = await postJson(urls.crear, payload);
                closeModal('ctiModalNueva');
                toast(`Expediente ${data.folio} creado correctamente.`, 'success');
                await refreshAll(data.solicitudId);
            } catch (error) { toast(error.message, 'error'); }
            finally { hideLoading(); }
        });

        $('ctiFormProveedor').addEventListener('submit', async e => {
            e.preventDefault();
            const codigo = $('ctiAsignarProveedorCodigo').value;
            if (!codigo) return toast('Selecciona un proveedor del catálogo.', 'error');
            showLoading('Asignando proveedor...');
            try {
                await postUrlEncoded(urls.asignarProveedor, { solicitudId: $('ctiProveedorSolicitudId').value, proveedorSapCodigo: codigo });
                closeModal('ctiModalProveedor');
                toast('Proveedor asignado correctamente.', 'success');
                await refreshAll(state.selectedId);
            } catch (error) { toast(error.message, 'error'); }
            finally { hideLoading(); }
        });

        ['ctiCotSubtotal', 'ctiCotIva', 'ctiCotTotal'].forEach(id => $(id).addEventListener('input', updateQuoteAnalysis));
        $('ctiCotSubtotal').addEventListener('change', () => {
            const subtotal = Number($('ctiCotSubtotal').value || 0);
            if (!$('ctiCotIva').value && subtotal) $('ctiCotIva').value = (subtotal * .16).toFixed(2);
            if (!$('ctiCotTotal').value && subtotal) $('ctiCotTotal').value = (subtotal + Number($('ctiCotIva').value || 0)).toFixed(2);
            updateQuoteAnalysis();
        });

        $('ctiFormCotizacion').addEventListener('submit', async e => {
            e.preventDefault();
            const fd = new FormData();
            fd.append('SolicitudId', $('ctiCotSolicitudId').value);
            fd.append('NumeroCotizacion', $('ctiCotNumero').value.trim());
            fd.append('FechaCotizacion', $('ctiCotFecha').value);
            fd.append('VigenciaHasta', $('ctiCotVigencia').value);
            fd.append('Subtotal', $('ctiCotSubtotal').value);
            fd.append('Iva', $('ctiCotIva').value);
            fd.append('Total', $('ctiCotTotal').value);
            fd.append('Moneda', $('ctiCotMoneda').value);
            const file = $('ctiCotArchivo').files[0];
            if (!file) return toast('Adjunta el archivo de cotización.', 'error');
            fd.append('Archivo', file);
            showLoading('Registrando y validando cotización...');
            try {
                await postForm(urls.cotizacion, fd);
                closeModal('ctiModalCotizacion');
                toast('Cotización registrada y enviada a autorización.', 'success');
                await refreshAll(state.selectedId);
            } catch (error) { toast(error.message, 'error'); }
            finally { hideLoading(); }
        });

        $('ctiFormAutorizacion').addEventListener('submit', async e => {
            e.preventDefault();
            showLoading('Registrando decisión...');
            try {
                await postJson(urls.autorizar, {
                    solicitudId: Number($('ctiAutSolicitudId').value),
                    autorizar: $('ctiAutDecision').value === 'true',
                    comentario: $('ctiAutComentario').value.trim()
                });
                closeModal('ctiModalAutorizacion');
                toast('Decisión registrada correctamente.', 'success');
                await refreshAll(state.selectedId);
            } catch (error) { toast(error.message, 'error'); }
            finally { hideLoading(); }
        });

        $('ctiRecParcial').addEventListener('change', () => { if ($('ctiRecParcial').checked) $('ctiRecConforme').checked = true; });
        $('ctiFormRecepcion').addEventListener('submit', async e => {
            e.preventDefault();
            const fd = new FormData();
            fd.append('SolicitudId', $('ctiRecSolicitudId').value);
            fd.append('FechaRecepcion', $('ctiRecFecha').value);
            fd.append('RecibidaConforme', String($('ctiRecConforme').checked));
            fd.append('RecepcionParcial', String($('ctiRecParcial').checked));
            fd.append('Observaciones', $('ctiRecObservaciones').value.trim());
            const file = $('ctiRecEvidencia').files[0];
            if ($('ctiRecConforme').checked && !file) return toast('La evidencia es obligatoria para una recepción conforme.', 'error');
            if (file) fd.append('Evidencia', file);
            showLoading('Registrando recepción...');
            try {
                await postForm(urls.recepcion, fd);
                closeModal('ctiModalRecepcion');
                toast('Recepción registrada correctamente.', 'success');
                await refreshAll(state.selectedId);
            } catch (error) { toast(error.message, 'error'); }
            finally { hideLoading(); }
        });

        ['ctiFacSubtotal', 'ctiFacIva', 'ctiFacTotal'].forEach(id => $(id).addEventListener('input', updateInvoiceComparison));
        $('ctiFormFactura').addEventListener('submit', async e => {
            e.preventDefault();
            const pdf = $('ctiFacPdf').files[0];
            const xml = $('ctiFacXml').files[0];
            if (!pdf && !xml) return toast('Adjunta al menos el PDF o el XML de la factura.', 'error');
            const fd = new FormData();
            fd.append('SolicitudId', $('ctiFacSolicitudId').value);
            fd.append('Serie', $('ctiFacSerie').value.trim());
            fd.append('Folio', $('ctiFacFolio').value.trim());
            fd.append('Uuid', $('ctiFacUuid').value.trim());
            fd.append('RfcEmisor', $('ctiFacRfc').value.trim());
            fd.append('FechaFactura', $('ctiFacFecha').value);
            fd.append('Subtotal', $('ctiFacSubtotal').value || '0');
            fd.append('Iva', $('ctiFacIva').value || '0');
            fd.append('Total', $('ctiFacTotal').value || '0');
            if (pdf) fd.append('Pdf', pdf);
            if (xml) fd.append('Xml', xml);
            showLoading('Analizando XML y conciliando factura...');
            try {
                const data = await postForm(urls.factura, fd);
                closeModal('ctiModalFactura');
                toast(data.conciliacionOk ? 'Factura conciliada correctamente.' : 'Factura registrada con diferencias; el pago quedó bloqueado.', data.conciliacionOk ? 'success' : 'error', 6500);
                await refreshAll(state.selectedId);
            } catch (error) { toast(error.message, 'error', 6500); }
            finally { hideLoading(); }
        });

        $('ctiFormPago').addEventListener('submit', async e => {
            e.preventDefault();
            showLoading('Liberando expediente a pago...');
            try {
                await postJson(urls.pago, { solicitudId: Number($('ctiPagoSolicitudId').value), comentario: $('ctiPagoComentario').value.trim() });
                closeModal('ctiModalPago');
                toast('Expediente liberado a pago correctamente.', 'success');
                await refreshAll(state.selectedId);
            } catch (error) {
                const blockers = error.data?.bloqueos;
                toast(blockers?.length ? `${error.message} ${blockers.join(' ')}` : error.message, 'error', 7000);
            } finally { hideLoading(); }
        });


        function cleanCtiLayoutShell() {
            const app = $('ctiApp');
            if (!app) return;

            document.body.classList.add('cti-page-active');

            let node = app.parentElement;
            let level = 0;

            /*
             * Solo se revisan los ancestros inmediatos de la vista.
             * Se limpian aquellos que tengan fondo, sombra o borde
             * redondeado, que son los que generan la tarjeta blanca.
             */
            while (node && node !== document.body && level < 5) {
                const css = window.getComputedStyle(node);
                const background = css.backgroundColor;

                const hasVisibleBackground =
                    background &&
                    background !== 'transparent' &&
                    background !== 'rgba(0, 0, 0, 0)';

                const hasShadow =
                    css.boxShadow &&
                    css.boxShadow !== 'none';

                const hasRadius =
                    Number.parseFloat(css.borderTopLeftRadius || '0') > 0 ||
                    Number.parseFloat(css.borderTopRightRadius || '0') > 0 ||
                    Number.parseFloat(css.borderBottomLeftRadius || '0') > 0 ||
                    Number.parseFloat(css.borderBottomRightRadius || '0') > 0;

                if (level === 0 || hasVisibleBackground || hasShadow || hasRadius) {
                    node.classList.add('cti-layout-shell-clean');

                    /*
                     * El espacio blanco de la captura viene principalmente
                     * del padding vertical del contenedor inmediato.
                     */
                    if (level <= 1) {
                        node.classList.add('cti-layout-shell-inner');
                    }
                }

                if (node.tagName === 'MAIN') break;

                node = node.parentElement;
                level++;
            }
        }

        async function init() {
            cleanCtiLayoutShell();
            updateFullscreenButton();
            updateResponsiveWorkspace();
            showLoading('Inicializando Control de Compras TI...');

            try {
                await loadPermisos();
                await Promise.all([loadDashboard(), loadSolicitudes()]);
            } catch (error) {
                toast(error.message, 'error', 7000);
            } finally {
                hideLoading();
                window.requestAnimationFrame(updateResponsiveWorkspace);
            }
        }

        init();
    })();
</script>
