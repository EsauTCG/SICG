@model Plataforma_CG.ViewModels.CobranzaReporteViewModel

@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Compromisos de cobranza";

    // Sin fechas seleccionadas, ambas inician en hoy; si el usuario filtró, se conserva su rango.
    var fechaDesde = Model.Desde ?? DateTime.Today;
    var fechaHasta = Model.Hasta ?? DateTime.Today;
    var hoy = DateTime.Today;

    var fechaEntregaPorCompromiso = ViewBag.FechaEntregaPorCompromiso as System.Collections.Generic.Dictionary<int, DateTime?>
        ?? new System.Collections.Generic.Dictionary<int, DateTime?>();
    var montoPorCompromiso = ViewBag.MontoPorCompromiso as System.Collections.Generic.Dictionary<int, decimal>
        ?? new System.Collections.Generic.Dictionary<int, decimal>();

    var estatusTexto = new System.Collections.Generic.Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        ["PENDIENTE"] = "Pendiente",
        ["VENCE_HOY"] = "Vence hoy",
        ["PARCIAL"] = "Parcial",
        ["INCUMPLIDO"] = "Incumplido",
        ["CUMPLIDO"] = "Cumplido",
        ["REVISAR"] = "Revisar"
    };
    var estatusActual = string.IsNullOrWhiteSpace(Model.Estatus) ? "TODOS" : Model.Estatus.ToUpperInvariant();
    var inv = System.Globalization.CultureInfo.InvariantCulture;

    string UrlEstatus(string est) => Url.Action("Compromisos", "Cobranza", new
    {
        estatus = est,
        cliente = Model.Cliente,
        desde = fechaDesde.ToString("yyyy-MM-dd"),
        hasta = fechaHasta.ToString("yyyy-MM-dd")
    });
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    /* =====================================================================
           COMPROMISOS DE COBRANZA · SIGO — hoja de estilos única
           ===================================================================== */
    #cobranzaApp {
        --es-tinto: #8d3e46;
        --es-tinto-deep: #5c2229;
        --es-tinto-soft: #f7eced;
        --es-tinto-line: #e8d3d6;
        --es-paper: #f6f4f4;
        --es-surface: #ffffff;
        --es-field: #ffffff;
        --es-head: #faf7f7;
        --es-hover: #fcf9f9;
        --es-row-line: #f0eaeb;
        --es-ink: #231a1c;
        --es-muted: #76686b;
        --es-line: #e6dfe0;
        --es-line-strong: #cfc4c6;
        --es-ok: #2f7a55;
        --es-ok-bg: #e7f3ec;
        --es-warn: #9a6410;
        --es-warn-bg: #fbf1de;
        --es-bad: #b42d2d;
        --es-bad-bg: #fbe9e8;
        --es-info: #2f5d86;
        --es-info-bg: #e9f0f7;
        --es-orange: #b4561a;
        --es-orange-bg: #fcefe4;
        --es-teal: #2b7a72;
        --es-neutral-bg: #efecec;
        --es-font: "Poppins", "Segoe UI", system-ui, -apple-system, Arial, sans-serif;
        font-family: var(--es-font);
        color: var(--es-ink);
        font-size: 13px;
        line-height: 1.4;
        display: flex;
        flex-direction: column;
        gap: 10px;
        height: calc(100dvh - 92px);
        min-height: 600px;
        padding: 14px 16px 8px;
        background: var(--es-paper);
        overflow: hidden;
        min-width: 0;
    }

    body[data-theme="dark"] #cobranzaApp {
        --es-tinto: #c56b74;
        --es-tinto-deep: #7a2d36;
        --es-tinto-soft: #3a2427;
        --es-tinto-line: #5a3439;
        --es-paper: #16181c;
        --es-surface: #202328;
        --es-field: #181a1e;
        --es-head: #262a30;
        --es-hover: #2a2e34;
        --es-row-line: #30343b;
        --es-ink: #edf0f3;
        --es-muted: #a9b0b9;
        --es-line: #363b43;
        --es-line-strong: #4a5059;
        --es-ok: #6cc596;
        --es-ok-bg: #1d3328;
        --es-warn: #e0b061;
        --es-warn-bg: #3a2f1b;
        --es-bad: #f08a83;
        --es-bad-bg: #3d2223;
        --es-info: #8bb8e0;
        --es-info-bg: #1e2b38;
        --es-orange: #f0a36b;
        --es-orange-bg: #3a2a1d;
        --es-teal: #6cc5ba;
        --es-neutral-bg: #2c3036;
    }

    #cobranzaApp *, #cobranzaApp *::before, #cobranzaApp *::after {
        box-sizing: border-box;
    }

    #cobranzaApp .bi {
        font-family: "bootstrap-icons" !important;
    }

    #cobranzaApp .num {
        text-align: right;
        font-variant-numeric: tabular-nums;
    }

    #cobranzaApp .center {
        text-align: center;
    }

    /* Encabezado */
    .cob-header {
        flex: none;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        flex-wrap: wrap;
    }

    .cob-header__title {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .cob-header__icon {
        width: 40px;
        height: 40px;
        flex: none;
        border-radius: 10px;
        display: grid;
        place-items: center;
        background: var(--es-tinto);
        color: #fff;
        font-size: 19px;
    }

    .cob-header h1 {
        margin: 0;
        font-size: 20px;
        font-weight: 700;
        letter-spacing: -.01em;
        line-height: 1.15;
        color: var(--es-ink);
    }

    .cob-header p {
        margin: 2px 0 0;
        font-size: 12px;
        color: var(--es-muted);
    }

    .cob-live {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 5px 6px 5px 12px;
        border-radius: 999px;
        background: var(--es-surface);
        border: 1px solid var(--es-line);
        font-size: 12px;
        color: var(--es-muted);
    }

        .cob-live .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--es-ok);
        }

        .cob-live.is-paused .dot {
            background: var(--es-line-strong);
        }

        .cob-live.is-loading .dot {
            background: var(--es-warn);
            animation: cob-pulse 1s infinite;
        }

    @@keyframes cob-pulse {
        50% {
            opacity: .3;
        }
    }

    .cob-live b {
        color: var(--es-ink);
        font-variant-numeric: tabular-nums;
    }

    .cob-live button {
        height: 26px;
        padding: 0 10px;
        border: 1px solid var(--es-line-strong);
        border-radius: 999px;
        background: var(--es-field);
        color: var(--es-ink);
        font: 600 11.5px var(--es-font);
        cursor: pointer;
    }

        .cob-live button:hover {
            background: var(--es-tinto-soft);
        }

    .cob-alert {
        flex: none;
        display: flex;
        gap: 8px;
        align-items: center;
        padding: 9px 12px;
        border-radius: 8px;
        font-size: 12.5px;
    }

        .cob-alert.ok {
            background: var(--es-ok-bg);
            color: var(--es-ok);
        }

        .cob-alert.err {
            background: var(--es-bad-bg);
            color: var(--es-bad);
        }

    /* Botones */
    .cob-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        height: 36px;
        padding: 0 14px;
        border: 1px solid var(--es-line-strong);
        border-radius: 7px;
        background: var(--es-field);
        color: var(--es-ink);
        font: 600 12.5px/1 var(--es-font);
        white-space: nowrap;
        cursor: pointer;
        text-decoration: none;
    }

        .cob-btn:hover {
            background: var(--es-tinto-soft);
            border-color: var(--es-tinto-line);
            color: var(--es-ink);
            text-decoration: none;
        }

        .cob-btn.primary {
            background: var(--es-tinto);
            border-color: var(--es-tinto);
            color: #fff;
        }

            .cob-btn.primary:hover {
                background: var(--es-tinto-deep);
                border-color: var(--es-tinto-deep);
                color: #fff;
            }

        .cob-btn i.ok {
            color: var(--es-ok);
        }

        .cob-btn:focus-visible {
            outline: 2px solid var(--es-tinto);
            outline-offset: 2px;
        }

    /* Filtros */
    .cob-card {
        background: var(--es-surface);
        border: 1px solid var(--es-line);
        border-radius: 10px;
        min-width: 0;
    }

    .cob-filtros {
        flex: none;
        padding: 10px 14px;
    }

    .cob-filters {
        display: grid;
        grid-template-columns: 170px minmax(220px, 1.6fr) 150px 150px auto;
        gap: 10px;
        align-items: end;
        margin: 0;
    }

    .cob-field label {
        display: block;
        margin: 0 0 5px;
        font-size: 12px;
        font-weight: 600;
        color: var(--es-muted);
    }

    #cobranzaApp .cob-field .form-control, #cobranzaApp .cob-field .form-select {
        width: 100%;
        height: 36px;
        padding: 0 10px;
        border: 1px solid var(--es-line-strong);
        border-radius: 7px;
        background-color: var(--es-field);
        color: var(--es-ink);
        font: 500 13px var(--es-font);
        box-shadow: none;
    }

    #cobranzaApp .cob-field .form-select {
        padding-right: 28px;
    }

        #cobranzaApp .cob-field .form-control:focus, #cobranzaApp .cob-field .form-select:focus {
            border-color: var(--es-tinto);
            box-shadow: 0 0 0 3px rgba(141,62,70,.16);
            outline: none;
        }

    body[data-theme="dark"] #cobranzaApp .cob-field .form-control, body[data-theme="dark"] #cobranzaApp .cob-field .form-select {
        color-scheme: dark;
    }

    .cob-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .cob-aviso {
        grid-column: 1 / -1;
        font-size: 12px;
        color: var(--es-warn);
    }

        .cob-aviso:empty {
            display: none;
        }

    /* Indicadores (clic = filtrar por estatus) */
    .cob-kpis {
        flex: none;
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr)) minmax(0, 1.4fr);
        gap: 10px;
    }

    .cob-kpi {
        position: relative;
        display: block;
        padding: 10px 14px;
        border-radius: 10px;
        background: var(--es-surface);
        border: 1px solid var(--es-line);
        border-top: 3px solid var(--k);
        color: var(--es-ink);
        text-decoration: none;
        min-width: 0;
        transition: box-shadow .12s, border-color .12s;
    }

    a.cob-kpi:hover {
        box-shadow: 0 4px 14px rgba(35,26,28,.08);
        color: var(--es-ink);
        text-decoration: none;
    }

    .cob-kpi.is-on {
        border-color: var(--k);
        box-shadow: inset 0 0 0 1px var(--k);
        background: color-mix(in srgb, var(--k) 6%, var(--es-surface));
    }

    .cob-kpi-label {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 11.5px;
        font-weight: 600;
        color: var(--es-muted);
    }

        .cob-kpi-label i {
            color: var(--k);
        }

    .cob-kpi-value {
        margin-top: 2px;
        font-size: clamp(18px, 1.5vw, 24px);
        font-weight: 700;
        color: var(--k-txt, var(--es-ink));
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
        line-height: 1.2;
    }

    .cob-kpi-note {
        font-size: 11px;
        color: var(--es-muted);
    }

    .cob-kpi-bar {
        display: flex;
        height: 6px;
        margin-top: 6px;
        border-radius: 999px;
        overflow: hidden;
        background: var(--es-neutral-bg);
    }

        .cob-kpi-bar span {
            height: 100%;
        }

    .kpi-total {
        --k: var(--es-tinto);
    }

    .kpi-pendientes {
        --k: var(--es-orange);
        --k-txt: var(--es-orange);
    }

    .kpi-incumplidos {
        --k: var(--es-bad);
        --k-txt: var(--es-bad);
    }

    .kpi-parciales {
        --k: var(--es-warn);
        --k-txt: var(--es-warn);
    }

    .kpi-cumplidos {
        --k: var(--es-ok);
        --k-txt: var(--es-ok);
    }

    .kpi-saldo {
        --k: var(--es-teal);
    }

    /* Tabla: 12 columnas sin desplazamiento horizontal */
    .cob-table-card {
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
        min-height: 0;
        overflow: hidden;
    }

    .cob-table-head {
        flex: none;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
        padding: 9px 14px;
        border-bottom: 1px solid var(--es-line);
        font-size: 13px;
        font-weight: 600;
    }

        .cob-table-head i {
            color: var(--es-tinto);
        }

        .cob-table-head small {
            font-size: 11.5px;
            font-weight: 500;
            color: var(--es-muted);
        }

    .cob-table-wrap {
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
        overflow-x: hidden;
    }

    .cob-table {
        width: 100%;
        table-layout: fixed;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
        font-size: 12px;
        color: var(--es-ink);
    }

        .cob-table thead th {
            position: sticky;
            top: 0;
            z-index: 2;
            padding: 8px 7px;
            background: var(--es-head);
            border-bottom: 1px solid var(--es-line);
            color: var(--es-muted);
            font-size: 11px;
            font-weight: 600;
            line-height: 1.2;
            white-space: normal;
            vertical-align: bottom;
            text-align: left;
        }

            .cob-table thead th.num {
                text-align: right;
            }

            .cob-table thead th.center {
                text-align: center;
            }

        .cob-table tbody td {
            padding: 7px 7px;
            border-bottom: 1px solid var(--es-row-line);
            background: var(--es-surface);
            vertical-align: middle;
            overflow-wrap: anywhere;
        }

            .cob-table tbody td.num, .cob-table tbody td.fecha {
                white-space: nowrap;
                overflow-wrap: normal;
            }

        .cob-table tbody tr:hover > td {
            background: var(--es-hover);
        }

        .cob-table tbody tr.is-vencido > td:first-child {
            box-shadow: inset 3px 0 0 var(--es-bad);
        }

        .cob-table tbody tr.is-recien > td {
            animation: cob-flash 1.6s ease-out;
        }

    @@keyframes cob-flash {
        from {
            background: var(--es-warn-bg);
        }
    }

    .cob-ov {
        font-weight: 700;
    }

    .cob-client-name {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        font-weight: 600;
        line-height: 1.25;
    }

    .cob-client-code {
        display: block;
        margin-top: 1px;
        font-size: 11px;
        color: var(--es-muted);
    }

    .cob-strong {
        font-weight: 700;
    }

    .cob-muted {
        color: var(--es-muted);
    }

    .cob-saldo-bar {
        height: 4px;
        margin-top: 4px;
        border-radius: 999px;
        background: var(--es-neutral-bg);
        overflow: hidden;
    }

        .cob-saldo-bar span {
            display: block;
            height: 100%;
            border-radius: 999px;
            background: var(--es-ok);
        }

    .cob-saldo-pct {
        display: block;
        margin-top: 2px;
        font-size: 10.5px;
        color: var(--es-muted);
    }

    .cob-compromiso.vencido {
        color: var(--es-bad);
        font-weight: 700;
    }

    .cob-compromiso small {
        display: block;
        font-size: 10.5px;
        font-weight: 500;
    }

    .cob-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 3px 9px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 600;
        white-space: nowrap;
    }

        .cob-badge::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: currentColor;
        }

    .badge-pendiente {
        background: var(--es-orange-bg);
        color: var(--es-orange);
    }

    .badge-vence {
        background: var(--es-info-bg);
        color: var(--es-info);
    }

    .badge-parcial {
        background: var(--es-warn-bg);
        color: var(--es-warn);
    }

    .badge-incumplido {
        background: var(--es-bad-bg);
        color: var(--es-bad);
    }

    .badge-cumplido {
        background: var(--es-ok-bg);
        color: var(--es-ok);
    }

    .badge-revisar {
        background: var(--es-neutral-bg);
        color: var(--es-muted);
    }

    .cob-btn-detail {
        display: inline-grid;
        place-items: center;
        width: 30px;
        height: 30px;
        border: 1px solid var(--es-line-strong);
        border-radius: 7px;
        background: var(--es-field);
        color: var(--es-tinto);
        text-decoration: none;
    }

        .cob-btn-detail:hover {
            background: var(--es-tinto);
            border-color: var(--es-tinto);
            color: #fff;
        }

    .cob-empty {
        padding: 48px 12px !important;
        text-align: center;
        color: var(--es-muted);
    }

        .cob-empty i {
            display: block;
            font-size: 28px;
            margin-bottom: 6px;
            color: var(--es-line-strong);
        }

    .cob-table tfoot th {
        position: sticky;
        bottom: 0;
        z-index: 1;
        padding: 8px 7px;
        background: var(--es-head);
        border-top: 1px solid var(--es-line-strong);
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
        font-variant-numeric: tabular-nums;
    }

    .cob-statusbar {
        flex: none;
        display: flex;
        gap: 18px;
        flex-wrap: wrap;
        font-size: 11.5px;
        color: var(--es-muted);
    }

        .cob-statusbar strong {
            color: var(--es-ink);
        }

    @@media (max-width: 1300px) {
        .cob-kpis {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .cob-filters {
            grid-template-columns: 160px 1fr 140px 140px;
        }

        .cob-actions {
            grid-column: 1 / -1;
        }
    }

    @@media (max-width: 1200px) {
        .cob-table-wrap {
            overflow-x: auto;
        }

        .cob-table {
            min-width: 1060px;
        }
    }

    @@media (max-width: 760px) {
        #cobranzaApp {
            height: auto;
            overflow: visible;
        }

        .cob-table-card {
            min-height: 520px;
        }

        .cob-kpis, .cob-filters {
            grid-template-columns: 1fr 1fr;
        }
    }
</style>

<div id="cobranzaApp">
    <header class="cob-header">
        <div class="cob-header__title">
            <span class="cob-header__icon"><i class="bi bi-cash-coin"></i></span>
            <div>
                <h1>Compromisos de cobranza</h1>
                <p>Seguimiento de las promesas de pago de clientes con saldo vencido, validado automáticamente contra los pagos en SAP Business One.</p>
            </div>
        </div>
        <div class="cob-live" id="cobLive" role="status" aria-live="polite">
            <span class="dot" aria-hidden="true"></span>
            <span id="cobLiveTxt">Actualización automática en <b id="cobCuenta">60</b> s</span>
            <button type="button" id="cobPausa" aria-pressed="false"><i class="bi bi-pause-fill"></i> Pausar</button>
        </div>
    </header>

    @if (TempData["Success"] != null)
    {
        <div class="cob-alert ok"><i class="bi bi-check-circle-fill"></i> @TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="cob-alert err"><i class="bi bi-x-circle-fill"></i> @TempData["Error"]</div>
    }

    <section class="cob-card cob-filtros">
        <form method="get" asp-controller="Cobranza" asp-action="Compromisos" class="cob-filters" id="cobForm">
            <div class="cob-field">
                <label for="f-estatus">Estatus</label>
                <select name="estatus" id="f-estatus" class="form-select">
                    <option value="TODOS" selected="@(estatusActual == "TODOS")">Todos</option>
                    @foreach (var e in estatusTexto)
                    {
                        <option value="@e.Key" selected="@(estatusActual == e.Key)">@e.Value</option>
                    }
                </select>
            </div>
            <div class="cob-field">
                <label for="f-cliente">Cliente, código u OV</label>
                <input name="cliente" id="f-cliente" value="@Model.Cliente" class="form-control" placeholder="Ej. C00123, nombre del cliente u OV-…" autocomplete="off" />
            </div>
            <div class="cob-field">
                <label for="fechaDesde">Compromiso desde</label>
                <input type="date" id="fechaDesde" name="desde" value="@fechaDesde.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="cob-field">
                <label for="fechaHasta">Compromiso hasta</label>
                <input type="date" id="fechaHasta" name="hasta" value="@fechaHasta.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="cob-actions">
                <a asp-controller="Cobranza" asp-action="Compromisos" class="cob-btn"><i class="bi bi-eraser"></i> Limpiar</a>
                <a class="cob-btn" asp-controller="Cobranza" asp-action="ExportarCsv"
                   asp-route-estatus="@Model.Estatus" asp-route-cliente="@Model.Cliente"
                   asp-route-desde="@fechaDesde.ToString("yyyy-MM-dd")" asp-route-hasta="@fechaHasta.ToString("yyyy-MM-dd")"><i class="bi bi-filetype-csv ok"></i> Exportar CSV</a>
                <button type="submit" class="cob-btn primary"><i class="bi bi-search"></i> Buscar</button>
            </div>
            <div class="cob-aviso" id="cobAviso" role="status" aria-live="polite"></div>
        </form>
    </section>

    <section class="cob-kpis" id="cobKpis" aria-label="Resumen (clic para filtrar)">
        @{
            var total = Math.Max(1, Model.Total);
            string Pct(int n) => (n * 100.0 / total).ToString("0.##", inv);
        }
        <a class="cob-kpi kpi-total @(estatusActual == "TODOS" ? "is-on" : "")" href="@UrlEstatus("TODOS")" title="Ver todos">
            <div class="cob-kpi-label"><i class="bi bi-list-check"></i> Total de compromisos</div>
            <div class="cob-kpi-value">@Model.Total.ToString("N0")</div>
            <div class="cob-kpi-bar" aria-hidden="true">
                <span style="width:@Pct(Model.Cumplidos)%;background:var(--es-ok)"></span>
                <span style="width:@Pct(Model.Parciales)%;background:var(--es-warn)"></span>
                <span style="width:@Pct(Model.Pendientes)%;background:var(--es-orange)"></span>
                <span style="width:@Pct(Model.Incumplidos)%;background:var(--es-bad)"></span>
            </div>
        </a>
        <a class="cob-kpi kpi-pendientes @(estatusActual == "PENDIENTE" ? "is-on" : "")" href="@UrlEstatus("PENDIENTE")" title="Filtrar pendientes">
            <div class="cob-kpi-label"><i class="bi bi-hourglass-split"></i> Pendientes</div>
            <div class="cob-kpi-value">@Model.Pendientes.ToString("N0")</div>
            <div class="cob-kpi-note">@((Model.Pendientes * 100.0 / total).ToString("0"))% del total</div>
        </a>
        <a class="cob-kpi kpi-incumplidos @(estatusActual == "INCUMPLIDO" ? "is-on" : "")" href="@UrlEstatus("INCUMPLIDO")" title="Filtrar incumplidos">
            <div class="cob-kpi-label"><i class="bi bi-x-octagon"></i> Incumplidos</div>
            <div class="cob-kpi-value">@Model.Incumplidos.ToString("N0")</div>
            <div class="cob-kpi-note">@((Model.Incumplidos * 100.0 / total).ToString("0"))% del total</div>
        </a>
        <a class="cob-kpi kpi-parciales @(estatusActual == "PARCIAL" ? "is-on" : "")" href="@UrlEstatus("PARCIAL")" title="Filtrar parciales">
            <div class="cob-kpi-label"><i class="bi bi-circle-half"></i> Parciales</div>
            <div class="cob-kpi-value">@Model.Parciales.ToString("N0")</div>
            <div class="cob-kpi-note">@((Model.Parciales * 100.0 / total).ToString("0"))% del total</div>
        </a>
        <a class="cob-kpi kpi-cumplidos @(estatusActual == "CUMPLIDO" ? "is-on" : "")" href="@UrlEstatus("CUMPLIDO")" title="Filtrar cumplidos">
            <div class="cob-kpi-label"><i class="bi bi-check-circle"></i> Cumplidos</div>
            <div class="cob-kpi-value">@Model.Cumplidos.ToString("N0")</div>
            <div class="cob-kpi-note">@((Model.Cumplidos * 100.0 / total).ToString("0"))% de cumplimiento</div>
        </a>
        <div class="cob-kpi kpi-saldo">
            <div class="cob-kpi-label"><i class="bi bi-wallet2"></i> Saldo pendiente</div>
            <div class="cob-kpi-value">@Model.SaldoPendiente.ToString("C2")</div>
            @if (Model.Revisar > 0)
            {
                <a class="cob-kpi-note" href="@UrlEstatus("REVISAR")" style="color:var(--es-warn);font-weight:600"><i class="bi bi-exclamation-triangle"></i> @Model.Revisar requieren revisión</a>
            }
            else
            {
                <div class="cob-kpi-note">Por cobrar en los compromisos listados</div>
            }
        </div>
    </section>

    <section class="cob-card cob-table-card">
        <div class="cob-table-head">
            <span><i class="bi bi-table"></i> Compromisos <small id="cobConteo">· @Model.Items.Count registro(s)</small></span>
            <small>Barra izquierda roja = compromiso vencido sin cumplir · clic derecho para copiar a Excel</small>
        </div>
        <div class="cob-table-wrap">
            <table class="cob-table" id="cobTabla">
                <colgroup>
                    <col style="width:8.5%">
                    <col style="width:7.5%">
                    <col style="width:16%">
                    <col style="width:7%">
                    <col style="width:9%">
                    <col style="width:9%">
                    <col style="width:10.5%">
                    <col style="width:8.5%">
                    <col style="width:5.5%">
                    <col style="width:7.5%">
                    <col style="width:8%">
                    <col style="width:3%">
                </colgroup>
                <thead>
                    <tr>
                        <th>Estatus</th>
                        <th>OV</th>
                        <th>Cliente</th>
                        <th class="center">Entrega OV</th>
                        <th class="num">Monto OV</th>
                        <th class="num">Saldo inicial</th>
                        <th class="num">Saldo actual</th>
                        <th>Compromiso</th>
                        <th class="center">Facturas</th>
                        <th>Último pago SAP</th>
                        <th>Última validación</th>
                        <th class="no-copy"></th>
                    </tr>
                </thead>
                <tbody id="cobTbody">
                    @if (Model.Items.Count == 0)
                    {
                        <tr><td colspan="12" class="cob-empty"><i class="bi bi-inbox"></i>No hay compromisos con estos filtros.</td></tr>
                    }
                    else
                    {
                        foreach (var x in Model.Items)
                        {
                            var est = (x.Estatus ?? "").ToUpperInvariant();
                            var badgeClass = est switch
                            {
                                "CUMPLIDO" => "badge-cumplido",
                                "PARCIAL" => "badge-parcial",
                                "INCUMPLIDO" => "badge-incumplido",
                                "VENCE_HOY" => "badge-vence",
                                "REVISAR" => "badge-revisar",
                                _ => "badge-pendiente"
                            };
                            var fechaEntrega = fechaEntregaPorCompromiso.TryGetValue(x.Id, out var fechaOv) ? fechaOv : null;
                            var montoOv = montoPorCompromiso.TryGetValue(x.Id, out var montoTotal) ? montoTotal : 0m;
                            var pagado = x.SaldoVencidoInicial > 0 ? Math.Max(0m, Math.Min(100m, (x.SaldoVencidoInicial - x.SaldoPendienteActual) / x.SaldoVencidoInicial * 100m)) : 0m;
                            var vencido = x.FechaCompromiso.Date < hoy && est != "CUMPLIDO";
                            var diasVencido = (hoy - x.FechaCompromiso.Date).Days;

                            <tr data-id="@x.Id" class="@(vencido ? "is-vencido" : "")">
                                <td data-copy="@(estatusTexto.TryGetValue(est, out var t1) ? t1 : x.Estatus)"><span class="cob-badge @badgeClass">@(estatusTexto.TryGetValue(est, out var t) ? t : x.Estatus)</span></td>
                                <td class="cob-ov">@x.OrdenVentaConsecutivo</td>
                                <td data-copy="@x.ClienteCodigo - @x.ClienteNombre" title="@x.ClienteNombre">
                                    <span class="cob-client-name">@x.ClienteNombre</span>
                                    <span class="cob-client-code">@x.ClienteCodigo</span>
                                </td>
                                <td class="center fecha">@(fechaEntrega?.ToString("dd/MM/yyyy") ?? "—")</td>
                                <td class="num" data-copy="@montoOv.ToString("0.00", inv)">@montoOv.ToString("C2")</td>
                                <td class="num" data-copy="@x.SaldoVencidoInicial.ToString("0.00", inv)">@x.SaldoVencidoInicial.ToString("C2")</td>
                                <td class="num" data-copy="@x.SaldoPendienteActual.ToString("0.00", inv)" title="Pagado: @pagado.ToString("0.#")% del saldo inicial">
                                    <span class="cob-strong">@x.SaldoPendienteActual.ToString("C2")</span>
                                    @if (x.SaldoVencidoInicial > 0)
                                    {
                                        <div class="cob-saldo-bar" aria-hidden="true"><span style="width:@pagado.ToString("0.##", inv)%"></span></div>
                                        <span class="cob-saldo-pct">@pagado.ToString("0")% pagado</span>
                                    }
                                </td>
                                <td class="fecha cob-compromiso @(vencido ? "vencido" : "")" data-copy="@x.FechaCompromiso.ToString("dd/MM/yyyy")">
                                    @x.FechaCompromiso.ToString("dd/MM/yyyy")
                                    @if (vencido)
                                    {
                                        <small>hace @diasVencido @(diasVencido == 1 ? "día" : "días")</small>
                                    }
                                    else if (x.FechaCompromiso.Date == hoy && est != "CUMPLIDO")
                                    {
                                        <small style="color:var(--es-info)">hoy</small>
                                    }
                                </td>
                                <td class="center">@x.Facturas</td>
                                <td class="fecha @(x.UltimoPagoSap.HasValue ? "" : "cob-muted")">@(x.UltimoPagoSap?.ToString("dd/MM/yyyy") ?? "Sin pagos")</td>
                                <td class="fecha @(x.FechaUltimaValidacion.HasValue ? "" : "cob-muted")">@(x.FechaUltimaValidacion?.ToString("dd/MM HH:mm") ?? "Pendiente")</td>
                                <td class="center no-copy">
                                    <a class="cob-btn-detail" asp-controller="Cobranza" asp-action="Detalle" asp-route-id="@x.Id" title="Ver detalle del compromiso de @x.OrdenVentaConsecutivo" aria-label="Ver detalle de @x.OrdenVentaConsecutivo"><i class="bi bi-arrow-right"></i></a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
                @if (Model.Items.Count > 0)
                {
                    <tfoot>
                        <tr>
                            <th colspan="4" class="num">Totales de la lista</th>
                            <th class="num">@Model.Items.Sum(x => montoPorCompromiso.TryGetValue(x.Id, out var m) ? m : 0m).ToString("C2")</th>
                            <th class="num">@Model.Items.Sum(x => x.SaldoVencidoInicial).ToString("C2")</th>
                            <th class="num">@Model.Items.Sum(x => x.SaldoPendienteActual).ToString("C2")</th>
                            <th colspan="5"></th>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </section>

    <footer class="cob-statusbar">
        <span>Periodo de compromisos: <strong>@fechaDesde.ToString("dd/MM/yyyy")</strong> al <strong>@fechaHasta.ToString("dd/MM/yyyy")</strong></span>
        <span>Usuario: @(User?.Identity?.Name ?? "")</span>
        <span>Comercial · Cobranza</span>
    </footer>
</div>

<script>
    (() => {
        const $ = id => document.getElementById(id);

        // ---------- Fechas invertidas ----------
        // CORRECCIÓN: si "desde" es posterior a "hasta" se intercambian antes de buscar (antes no traía nada sin explicar)
        $('cobForm')?.addEventListener('submit', () => {
            const d = $('fechaDesde'), h = $('fechaHasta');
            if (d.value && h.value && d.value > h.value) { [d.value, h.value] = [h.value, d.value]; }
        });

        // ---------- Actualización automática sin recargar la página ----------
        // CORRECCIÓN: antes se recargaba toda la página cada 60 s aunque la pestaña estuviera oculta o
        // estuvieras escribiendo en un filtro (se perdía lo escrito y la posición de la tabla).
        // Ahora solo se actualizan indicadores y tabla, se puede pausar y espera si estás escribiendo.
        const INTERVALO = 60;
        let restante = INTERVALO, pausado = false, cargando = false;
        const live = $('cobLive'), cuenta = $('cobCuenta'), txt = $('cobLiveTxt'), btnPausa = $('cobPausa');
        const escribiendo = () => document.activeElement?.closest?.('#cobForm');

        async function actualizar() {
            if (cargando) return;
            cargando = true;
            live.classList.add('is-loading');
            try {
                const resp = await fetch(location.href, { cache: 'no-store', credentials: 'same-origin', headers: { 'Accept': 'text/html' } });
                if (!resp.ok) throw new Error('HTTP ' + resp.status);
                const doc = new DOMParser().parseFromString(await resp.text(), 'text/html');
                const nuevoTbody = doc.getElementById('cobTbody'), nuevosKpis = doc.getElementById('cobKpis'), nuevaTabla = doc.getElementById('cobTabla');
                if (!nuevoTbody || !nuevosKpis) throw new Error('respuesta inesperada');
                const antes = new Set([...document.querySelectorAll('#cobTbody tr[data-id]')].map(tr => tr.dataset.id));
                const wrap = document.querySelector('.cob-table-wrap'), scroll = wrap.scrollTop;
                $('cobKpis').innerHTML = nuevosKpis.innerHTML;
                $('cobTbody').innerHTML = nuevoTbody.innerHTML;
                const pie = $('cobTabla').tFoot, pieNuevo = nuevaTabla?.tFoot;
                if (pie && pieNuevo) pie.innerHTML = pieNuevo.innerHTML; else if (pie && !pieNuevo) pie.remove(); else if (!pie && pieNuevo) $('cobTabla').appendChild(pieNuevo);
                if (antes.size) document.querySelectorAll('#cobTbody tr[data-id]').forEach(tr => { if (!antes.has(tr.dataset.id)) tr.classList.add('is-recien'); });
                $('cobConteo').textContent = `· ${document.querySelectorAll('#cobTbody tr[data-id]').length} registro(s)`;
                wrap.scrollTop = scroll;
                txt.innerHTML = `Actualizado ${new Date().toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' })} · siguiente en <b id="cobCuenta">${INTERVALO}</b> s`;
            } catch (e) {
                console.error('No se pudo actualizar:', e);
                txt.innerHTML = `No se pudo actualizar; reintento en <b id="cobCuenta">${INTERVALO}</b> s`;
            } finally {
                cargando = false;
                live.classList.remove('is-loading');
                restante = INTERVALO;
            }
        }

        setInterval(() => {
            if (pausado || cargando || document.hidden) return;
            if (escribiendo()) return; // espera a que termines de escribir
            restante--;
            const c = $('cobCuenta'); if (c) c.textContent = Math.max(0, restante);
            if (restante <= 0) actualizar();
        }, 1000);

        document.addEventListener('visibilitychange', () => { if (!document.hidden && !pausado && restante <= 0) actualizar(); });

        btnPausa.addEventListener('click', () => {
            pausado = !pausado;
            live.classList.toggle('is-paused', pausado);
            btnPausa.setAttribute('aria-pressed', String(pausado));
            btnPausa.innerHTML = pausado ? '<i class="bi bi-play-fill"></i> Reanudar' : '<i class="bi bi-pause-fill"></i> Pausar';
            if (pausado) txt.textContent = 'Actualización automática en pausa';
            else { restante = INTERVALO; txt.innerHTML = `Actualización automática en <b id="cobCuenta">${INTERVALO}</b> s`; }
        });
    })();
</script>
