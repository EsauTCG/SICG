@* VERSION BASCULA-CANTIDAD-RUTA-V3 *@
@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Báscula Camionera";
}

<link rel="stylesheet" href="~/css/bascula-camionera-grid.css" asp-append-version="true" />


<div class="window" id="basculaApp" data-version="BASCULA-CANTIDAD-RUTA-V3">
    <div class="app-header">
        <div class="brand-block">
            <div class="brand-mark">CG</div>
            <div>
                <div class="eyebrow">Caseta de control</div>
                <h1>Báscula Camionera</h1>
                <p>Entradas, salidas, ganado, cajas de carne, insumos, bitácora y ticket Epson.</p>
            </div>
        </div>

        <div class="toolbar header-actions">
            <button class="tool-btn primary" type="button" id="btnNuevo">Nuevo</button>
            <button class="tool-btn" type="button" id="btnImprimirActual">Imprimir ticket</button>
            <button class="tool-btn" type="button" id="btnExportCsv">Exportar Excel</button>
            <button class="tool-btn danger" type="button" id="btnLimpiarDemo">Limpiar demo</button>
        </div>
    </div>

    <div class="operator-strip">
        <div class="strip-item"><span>Caseta</span><strong></strong></div>
        <div class="strip-item"><span>Operador</span><strong>@(User?.Identity?.Name ?? "Supervisor Báscula")</strong></div>
        <div class="strip-item"><span>Empresa</span><strong>Carnes G SA de CV</strong></div>
        <div class="strip-item"><span>Ambiente</span><strong>Demo local / TCP listo</strong></div>
    </div>

    <div class="content">
        <div class="workspace">
            <div class="tabs">
                <button class="tab active" type="button" data-view="registro">Registro de pesaje</button>
                <button class="tab" type="button" data-view="pendientes">Pendientes de salida</button>
                <button class="tab" type="button" data-view="historial">Historial</button>
                <button class="tab" type="button" data-view="bitacora">Bitácora</button>
                <button class="tab" type="button" data-view="configuracion">Configuración TCP / Epson</button>
            </div>

            <div class="section">
                <div class="section-title">
                    <div>Panel operativo de báscula</div>
                    <span></span>
                </div>

                <div class="bascula-resumen">
                    <div class="peso-panel">
                        <div class="peso-status">
                            <span class="connection-wrap"><i class="dot" id="connectionDot"></i><span id="connectionText">Modo demo / sin conexión TCP</span></span>
                            <span class="scale-tools"><span id="stableBadge" class="stable-badge warn">Estabilizando</span><span class="scale-name">Báscula 776</span></span>
                        </div>

                        <div class="indicador-head">
                            <span class="indicador-brand">INDICADOR DIGITAL</span>
                            <span class="indicador-mode">PESO BRUTO</span>
                        </div>

                        <div class="peso-display">
                            <div class="peso-display-label">PESO EN VIVO</div>
                            <div class="peso-display-readout">
                                <span id="liveWeight">0.00</span>
                                <small>kg</small>
                            </div>
                        </div>

                        <div class="indicador-meta">
                            <span class="indicador-meta-item">BÁSCULA CAMIONERA</span>
                            <span class="indicador-meta-item">LECTURA ESTABLE</span>
                        </div>

                        <div class="truck-scene" id="truckScene" aria-hidden="true">
                            <div class="truck-scale-lane"></div>
                            <div class="truck-scale-platform">
                                <span class="truck-scale-mark"></span>
                                <span class="truck-scale-mark"></span>
                                <span class="truck-scale-mark"></span>
                                <span class="truck-scale-mark"></span>
                                @*   <span class="truck-scale-label">PLATAFORMA DE BÁSCULA</span> *@
                            </div>
                            <div class="truck-vehicle truck-vehicle-img" id="truckVehicle">
                                <img src="/images/trailer-bascula.png?v=1"
                                     class="truck-img"
                                     alt="Tráiler báscula"
                                     draggable="false" />
                                <div class="truck-img-shadow"></div>
                            </div>
                        </div>
@* 
                        <div class="peso-actions peso-actions-test">
                            <button class="tool-btn primary" type="button" id="btnCapturarPeso">Capturar peso</button>
                            <button class="tool-btn" type="button" id="btnSimularPeso">Simular peso</button> *@
                           @*  <button class="tool-btn danger" type="button" id="btnProbarCero">Probar 0 kg</button>
                        </div> *@
                    </div>

                    <div class="kpi kpi-movimientos">
                        <label>Movimientos hoy</label>
                        <strong id="kpiMovimientos">0</strong>
                        <span class="muted">Registros generados</span>
                    </div>

                    <div class="kpi kpi-pendientes">
                        <label>Pendientes salida</label>
                        <strong id="kpiPendientes">0</strong>
                        <span class="muted">Falta segundo peso</span>
                    </div>

                    <div class="kpi kpi-netos">
                        <label>Kg netos cerrados</label>
                        <strong id="kpiKg">0</strong>
                        <span class="muted">Solo tickets cerrados</span>
                    </div>

                    <div class="kpi kpi-folio">
                        <label>Último folio</label>
                        <strong id="kpiFolio">---</strong>
                        <span class="muted">Último movimiento</span>
                    </div>

                <div class="panic-actions-bar" aria-label="Acciones principales de pesaje">
                    <div class="panic-actions-title">
                       
                        
                    </div>

                    <div class="panic-actions-buttons">
                        <button class="panic-btn panic-btn-entry"
                                type="button"
                                id="btnGuardarEntrada"
                                title="Guardar el primer peso como entrada">
                            <span class="panic-btn-icon"><i class="bi bi-box-arrow-in-down"></i></span>
                            <span class="panic-btn-copy">
                                <small>PRIMER PESO</small>
                                <strong>GUARDAR ENTRADA</strong>
                            </span>
                        </button>

                        <button class="panic-btn panic-btn-exit"
                                type="button"
                                id="btnCerrarSalida"
                                title="Guardar el segundo peso y cerrar la salida">
                            <span class="panic-btn-icon"><i class="bi bi-box-arrow-up"></i></span>
                            <span class="panic-btn-copy">
                                <small>SEGUNDO PESO</small>
                                <strong>CERRAR SALIDA</strong>
                            </span>
                        </button>
                    </div>
                </div>
                </div>


                <div class="pre-registro-panel pre-registro-panel-operativo">
                    <div class="section-title">
                        <div>Escaneo de pre-registro / QR / código de barras</div>
                       @*  <span>CEDIS, Compras, Embarques o Producción capturan antes; caseta solo escanea y pesa.</span> *@
                    </div>

                    <div class="form-grid compact">
                        <div class="form-group span-2">
                            <label>Escanear QR / código</label>
                            <input id="scanPreRegistro"
                                   type="text"
                                   placeholder="Escanee aquí el QR o código de barras de la hoja"
                                   autocomplete="off" />
                            @*   <span class="pre-registro-help">
                                Formatos aceptados: BASPRE|TOKEN, URL con ?token=TOKEN o solo TOKEN.
                            </span> *@
                        </div>

                        <div class="form-group">
                            <label>Acción</label>
                            <button class="pm-btn pm-btn-primary" type="button" id="btnBuscarPreRegistro">
                                Cargar datos
                            </button>
                        </div>

                        <div class="form-group">
                            <label>Estatus</label>
                            <span id="estatusPreRegistro" class="pre-registro-status warn">Sin escaneo</span>
                        </div>

                        <div class="form-group">
                            <label>Folio previo</label>
                            <input id="folioPreRegistroVista" type="text" readonly value="" />
                        </div>

                        <div class="form-group">
                            <label>Área origen</label>
                            <input id="areaPreRegistroVista" type="text" readonly value="" />
                        </div>

                        <div class="form-group">
                            <label>Modo</label>
                            <button class="pm-btn" type="button" id="btnLiberarCapturaManual">
                                Captura manual
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="view-panel active" id="view-registro">
                <div class="section">
                    <div class="section-title">
                        <div>Datos generales</div>
                        <span id="folioPreview">Folio nuevo</span>
                    </div>

                    <form id="frmBascula" autocomplete="off">
                        <div class="form-grid">
                            <div class="form-group">
                                <label>Tipo movimiento</label>
                                <select id="tipoMovimiento">
                                    <option value="Entrada proveedor">Entrada proveedor</option>
                                    <option value="Salida cliente">Salida cliente</option>
                                    <option value="Traspaso interno">Traspaso interno</option>
                                    <option value="Devolución">Devolución</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label>Clasificación</label>
                                <select id="clasificacion">
                                    <option value="Ganado en pie">Ganado en pie</option>
                                    <option value="Cajas de carne">Cajas de carne</option>
                                    <option value="Canal / medias canales">Canal / medias canales</option>
                                    <option value="Insumos">Insumos</option>
                                    <option value="Subproducto">Subproducto</option>
                                    <option value="Material de empaque">Material de empaque</option>
                                    <option value="Otro">Otro</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label id="cantidadLabel">Cantidad de animales</label>
                                <input id="cantidad"
                                       type="number"
                                       min="1"
                                       step="1"
                                       value="1"
                                       inputmode="numeric"
                                       placeholder="Número de animales" />
                                <div class="hint" id="cantidadHint">Capture cuántos animales ingresan.</div>
                            </div>

                            <div class="form-group">
                                <label>Código SAP / ID</label>
                                <input id="codigoSap" type="text" placeholder="Se llena desde catálogo" readonly tabindex="-1" title="Campo bloqueado. Se llena automáticamente desde el catálogo de proveedor/cliente." />
                            </div>

                            <div class="form-group span-2">
                                <label id="terceroLabel">Proveedor</label>
                                <div class="lookup-row">
                                    <input id="tercero" type="text" autocomplete="off" placeholder="Buscar proveedor por código o nombre" />
                                    <button class="lookup-btn" type="button" id="btnBuscarClientes">Catálogo</button>
                                </div>
                                <div id="clientesSapPanel" class="lookup-panel"></div>
                            </div>

                            <div class="form-group">
                                <label>Placas</label>
                                <input id="placas" type="text" placeholder="AB-123-CD" />
                            </div>

                            <div class="form-group">
                                <label>SKU</label>
                                <input id="sku" type="text" placeholder="Se llena desde catálogo" readonly tabindex="-1" title="Campo bloqueado. Se llena automáticamente desde el catálogo de producto." />
                            </div>

                            <div class="form-group span-2">
                                <label>Producto / Descripción</label>
                                <div class="lookup-row">
                                    <input id="producto" type="text" autocomplete="off" placeholder="Buscar artículo por código o nombre" />
                                    <button class="lookup-btn" type="button" id="btnBuscarArticulos">Catálogo</button>
                                </div>
                                <div id="articulosSapPanel" class="lookup-panel"></div>
                            </div>

                          

                            <div class="form-group">
                                <label>Documento origen</label>
                                <input id="documento" type="text" placeholder="Remisión, factura, guía, OC" />
                            </div>

                            <div class="form-group">
                                <label>Chofer</label>
                                <input id="chofer" type="text" placeholder="Nombre operador" />
                            </div>

                            <div class="form-group">
                                <label>Origen</label>
                                <input id="origen"
                                       type="text"
                                       list="ubicacionesBascula"
                                       value="PLANTA 1"
                                       placeholder="PLANTA 1, TIF 776 u otro origen" />
                            </div>

                            <div class="form-group">
                                <label>Destino</label>
                                <input id="destino"
                                       type="text"
                                       list="ubicacionesBascula"
                                       value="TIF 776"
                                       placeholder="TIF 776, PLANTA 1 u otro destino" />
                                <datalist id="ubicacionesBascula">
                                    <option value="PLANTA 1"></option>
                                    <option value="TIF 776"></option>
                                </datalist>
                            </div>

                            <div class="form-group">
                                <label>Condición</label>
                                <input id="condicion" type="text" placeholder="Refrigerado, seco, vivo" />
                            </div>

                            <div class="form-group">
                                <label>Peso entrada kg</label>
                                <input id="pesoEntrada" type="number" min="0" step="0.01" placeholder="0.00" readonly title="Se llena desde la báscula. Para editar requiere captura manual autorizada." />
                            </div>

                            <div class="form-group">
                                <label>Peso salida kg</label>
                                <input id="pesoSalida" type="number" min="0" step="0.01" placeholder="0.00" readonly title="Se llena desde la báscula. Para editar requiere captura manual autorizada." />
                            </div>

                            <div class="form-group">
                                <label>Captura manual</label>
                                <select id="capturaManual">
                                    <option value="No">No</option>
                                    <option value="Sí">Sí</option>
                                </select>
                            </div>

                            <div class="form-group span-2">
                                <label>Motivo manual</label>
                                <input id="motivoManual" type="text" placeholder="Solo si hubo captura manual autorizada" readonly />
                            </div>

                            <div class="form-group full">
                                <label>Observaciones</label>
                                <textarea id="observaciones" placeholder="Notas operativas, sello, condición de carga, diferencias, incidencias"></textarea>
                            </div>
                        </div>
                    </form>

                    <div class="operation-summary">
                        <div class="summary-card">
                            <label>Folio actual</label>
                            <strong id="sumFolio">---</strong>
                            <div class="sub">Estatus: <span id="sumEstatus" class="estado-operativo nuevo">SIN GUARDAR</span></div>
                        </div>
                        <div class="summary-card">
                            <label>Peso entrada</label>
                            <strong id="sumEntrada">0.00 kg</strong>
                            <div class="sub">Primer peso registrado</div>
                        </div>
                        <div class="summary-card">
                            <label>Peso salida</label>
                            <strong id="sumSalida">0.00 kg</strong>
                            <div class="sub">Segundo peso de cierre</div>
                        </div>
                        <div class="summary-card">
                            <label>Peso neto</label>
                            <strong id="sumNeto">0.00 kg</strong>
                            <div class="sub">Diferencia automática</div>
                        </div>
                        <div class="summary-card">
                            <label>Unidad / carga</label>
                            <strong id="sumPlacas">---</strong>
                            <div class="sub">
                                <span id="sumCantidad">1 animal</span> ·
                                <span id="sumTercero">---</span> ·
                                <span id="sumProducto">---</span>
                            </div>
                        </div>
                    </div>

                    <div class="pm-actions">
                        <button class="pm-btn" type="button" id="btnNuevo2">Nuevo movimiento</button>
                        @*  <button class="pm-btn pm-btn-primary" type="button" id="btnImprimirActual2">Imprimir ticket</button> *@
                    </div>
                </div>


            </div>

            <div class="view-panel" id="view-pendientes">
                <div class="section">
                    <div class="section-title">
                        <div>Movimientos pendientes de salida</div>
                        <span></span>
                    </div>

                    <div class="table-wrap">
                        <table>
                            <thead>
                                <tr>
                                    <th>Folio</th>
                                    <th>Fecha entrada</th>
                                    <th>Tipo</th>
                                    <th>Proveedor/Cliente</th>
                                    <th>Producto</th>
                                    <th>Cantidad</th>
                                    <th>Placas</th>
                                    <th class="num">Peso entrada</th>
                                    <th class="center">Acción</th>
                                </tr>
                            </thead>
                            <tbody id="pendingTable"></tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="view-panel" id="view-historial">
                <div class="section">
                    <div class="section-title">
                        <div>Historial de pesajes</div>

                    </div>

                    <div class="form-grid compact">
                        <div class="form-group span-2">
                            <label>Buscar</label>
                            <input id="searchHistory" type="text" placeholder="Folio / placas / proveedor / cliente / SKU" />
                        </div>

                        <div class="form-group">
                            <label>Estatus</label>
                            <select id="filterEstatus">
                                <option value="">Todos</option>
                                <option value="PENDIENTE">Pendiente</option>
                                <option value="CERRADO">Cerrado</option>
                            </select>
                        </div>

                        <div class="form-group">
                            <label>Desde</label>
                            <input id="filterFechaDesde" type="date" />
                        </div>

                        <div class="form-group">
                            <label>Hasta</label>
                            <input id="filterFechaHasta" type="date" />
                        </div>

                        <div class="form-group">
                            <label>Exportación</label>
                            <div class="history-actions-group">
                                <button class="pm-btn pm-btn-primary" type="button" id="btnExportExcelHistory">Exportar Excel</button>
                            </div>
                        </div>
                    </div>

                    <div class="table-wrap">
                        <table>
                            <thead>
                                <tr>
                                    <th>Folio</th>
                                    <th>Estatus</th>
                                    <th>Fecha entrada</th>
                                    <th>Fecha salida</th>
                                    <th>Tipo</th>
                                    <th>Clasificación</th>
                                    <th>Cantidad</th>
                                    <th>Proveedor/Cliente</th>
                                    <th>SKU/Lote</th>
                                    <th class="num">Entrada</th>
                                    <th class="num">Salida</th>
                                    <th class="num">Neto</th>
                                    <th>Usuario</th>
                                    <th class="center">Ticket</th>
                                </tr>
                            </thead>
                            <tbody id="historyTable"></tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="view-panel" id="view-bitacora">
                <div class="section">
                    <div class="section-title">
                        <div>Bitácora de movimientos</div>

                    </div>

                    <div class="table-wrap">
                        <table>
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Usuario</th>
                                    <th>Acción</th>
                                    <th>Folio</th>
                                </tr>
                            </thead>
                            <tbody id="logTable"></tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="view-panel" id="view-configuracion">
                <div class="section">
                    <div class="section-title">
                        <div>Configuración TCP/IP báscula</div>

                    </div>

                    <div class="form-grid compact">
                        <div class="form-group">
                            <label>IP báscula</label>
                            <input id="scaleHost" type="text" placeholder="192.168.1.100" />
                        </div>

                        <div class="form-group">
                            <label>Puerto TCP</label>
                            <input id="scalePort" type="number" placeholder="4001" />
                        </div>

                        <div class="form-group">
                            <label>Comando lectura</label>
                            <input id="scaleCommand" type="text" placeholder="W\r\n" />
                        </div>

                        <div class="form-group">
                            <label>Impresora Epson</label>
                            <input id="printerName" type="text" value="EPSON TM-T20IV Receipt" placeholder="EPSON TM-T20IV Receipt" />
                        </div>

                        <div class="form-group">
                            <label>Tolerancia estabilizador kg</label>
                            <input id="stableTolerance" type="number" min="0" step="0.10" value="20" placeholder="20" />
                        </div>

                        <div class="form-group">
                            <label>Lecturas estables</label>
                            <input id="stableSamples" type="number" min="2" max="10" step="1" value="4" placeholder="4" />
                        </div>
                    </div>

                    <div class="pm-actions">
                        <button class="pm-btn pm-btn-success" type="button" id="btnConnectScale">Probar TCP</button>
                        <button class="pm-btn" type="button" id="btnReadCommand">Leer peso real</button>
                        <button class="pm-btn pm-btn-danger" type="button" id="btnDisconnectScale">Desconectar</button>
                        <button class="pm-btn" type="button" id="btnDetectarImpresoras">Detectar impresoras</button>
                        <button class="pm-btn pm-btn-primary" type="button" id="btnSaveConfig">Guardar configuración</button>
                    </div>

                    <pre id="rawScale" class="raw-box">Esperando datos de báscula...</pre>
                    <div id="printerList" style="padding:10px;background:#fffafa;border-top:1px solid #d8bcbc;font-size:12px;"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="statusbar">
        <div>Registro listo</div>
        <div>Usuario: @(User?.Identity?.Name ?? "Usuario SIGO")</div>
        <div>Empresa: Carnes G SA de CV</div>
        <div>Módulo: Báscula Camionera</div>
    </div>
</div>



<div class="catalog-modal-backdrop" id="catalogModalBackdrop" aria-hidden="true">
    <div class="catalog-modal" role="dialog" aria-modal="true" aria-labelledby="catalogModalTitle">
        <div class="catalog-modal-header">
            <div>
                <h2 class="catalog-modal-title" id="catalogModalTitle">Catálogo</h2>
                <div class="catalog-modal-subtitle" id="catalogModalSubtitle">Seleccione un registro del catálogo.</div>
            </div>
            <button class="catalog-close" type="button" id="btnCloseCatalogModal" aria-label="Cerrar">×</button>
        </div>
        <div class="catalog-modal-search">
            <input id="catalogSearch" type="text" autocomplete="off" placeholder="Buscar por código, nombre o razón social" />
            <button class="lookup-btn" type="button" id="btnCatalogSearch">Buscar</button>
        </div>
        <div class="catalog-modal-body">
            <table class="catalog-modal-table">
                <thead>
                    <tr>
                        <th style="width:150px;">Código</th>
                        <th>Nombre / Razón social</th>
                        <th style="width:150px;">Tipo / Canal</th>
                        <th style="width:120px;" class="center">Acción</th>
                    </tr>
                </thead>
                <tbody id="catalogModalBody">
                    <tr><td colspan="4" class="catalog-empty">Escriba una búsqueda para consultar el catálogo.</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div id="ticketPrintArea">
    <div class="ticket-impresion">
        <div class="center">
            <img class="ticket-logo-img" src="@Url.Content("~/images/logoPDF.png")" alt="Carnes G" />
            <div class="subtitulo">TICKET</div>
            <div class="folio-ticket" id="pFolio">SIN-GUARDAR</div>
        </div>

        <div class="line"></div>

        <div class="row"><span>Estatus</span><strong id="pEstatus"></strong></div>
        <div class="row"><span>Movimiento</span><strong id="pMovimiento"></strong></div>
        <div class="row"><span>Clasificación</span><strong id="pClasificacion"></strong></div>
        <div class="row"><span>Cantidad</span><strong id="pCantidad"></strong></div>
        <div class="row"><span>Fecha entrada</span><strong id="pFechaEntrada"></strong></div>
        <div class="row"><span>Fecha salida</span><strong id="pFechaSalida"></strong></div>

        <div class="line"></div>

        <div class="row"><span>Proveedor/Cliente</span><strong id="pTercero"></strong></div>
