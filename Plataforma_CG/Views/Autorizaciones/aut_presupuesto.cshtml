@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Autorización de Presupuesto (Kg por mes)";
}

<style>
@@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap');:root{--auth-font:"Poppins","Segoe UI",Arial,sans-serif;--auth-bg:#efe3e3;--auth-panel:#fffafa;--auth-panel2:#f7eeee;--auth-line:#d6baba;--auth-line2:#9b6262;--auth-text:#341515;--auth-muted:#775252;--auth-brand:#8b0000;--auth-brand2:#5b0000;--auth-head:linear-gradient(180deg,#b30000 0%,#870000 57%,#5c0000 100%);--auth-toolbar:linear-gradient(#fff8f8,#ecd9d9)}*{box-sizing:border-box}html,body{width:100%!important;max-width:100%!important;margin:0!important;padding:0!important;overflow-x:hidden!important}body{background:transparent!important;color:var(--auth-text)!important;font-family:var(--auth-font)!important}body:has(.autorizacion-presupuesto-app) .layout-main-content, body:has(.autorizacion-presupuesto-app) .layout-main-content .layout-container-fluid, body:has(.autorizacion-presupuesto-app) main[role="main"]{min-height:0!important;height:auto!important;max-height:none!important}body:has(.autorizacion-presupuesto-app) .layout-main-content{flex:0 0 auto!important;width:auto!important;max-width:100%!important;min-width:0!important;overflow-x:hidden!important;overflow-y:visible!important}body:has(.autorizacion-presupuesto-app) .layout-main-content .layout-container-fluid{width:100%!important;max-width:100%!important;min-width:0!important;margin:0!important;padding:0!important}body:has(.autorizacion-presupuesto-app) footer, body:has(.autorizacion-presupuesto-app) .footer, body:has(.autorizacion-presupuesto-app) .layout-footer{position:static!important;min-height:29px!important;height:auto!important;margin-top:4px!important;padding:4px 0!important;font-family:var(--auth-font)!important;font-size:10.5px!important;line-height:1.15!important}.autorizacion-presupuesto-app{width:100%!important;max-width:100%!important;min-width:0!important;margin:0!important;padding:0!important;border:1px solid #865050!important;border-radius:0!important;background:var(--auth-panel)!importan