nter!important;gap:5px 14px!important;flex-wrap:wrap!important;border:1px solid var(--auth-line)!important;background:#fff!important;color:#4a1d1d!important;font-size:9.5px!important;line-height:1.12!important}#modalOV .header-row strong{color:#750000!important}#modalOV #btnAutorizarTodo{margin-bottom:5px!important}#modalOV .modal-table-wrap,#modalConsumo .modal-table-wrap{width:100%!important;max-height:60dvh!important;overflow:auto!important;border:1px solid var(--auth-line)!important;background:#fff!important}#modalOV .modal-table-wrap table,#modalConsumo .modal-table-wrap table{width:100%!important;min-width:920px!important;margin:0!important;border-collapse:separate!important;border-spacing:0!important;background:#fff!important;color:var(--auth-text)!important;font-size:10.2px!important}#modalConsumo .modal-table-wrap table{min-width:650px!important}#modalOV .modal-table-wrap thead th,#modalConsumo .modal-table-wrap thead th{position:sticky!important;top:0!important;z-index:5!important;padding:5px 4px!important;border-right:1px solid #742727!important;border-bottom:1px solid #540000!important;background:var(--auth-head)!important;color:#fff!important;font-size:9.2px!important;font-weight:600!important;line-height:1.08!important;white-space:nowrap!important}#modalOV .modal-table-wrap tbody td,#modalConsumo .modal-table-wrap tbody td{padding:4px!important;border-right:1px solid #dfc9c9!important;border-bottom:1px solid #dfc9c9!important;background:#fffafa!important;color:#291414!important;font-size:10.2px!important;line-height:1.12!important;vertical-align:middle!important}#modalOV .modal-table-wrap tbody tr:nth-child(even) td,#modalConsumo .modal-table-wrap tbody tr:nth-child(even) td{background:#f9eeee!important}#modalOV .modal-table-wrap tbody tr:hover td,#modalConsumo .modal-table-wrap tbody tr:hover td{background:#f1dddd!important}#modalConsumo .modal-table-wrap tfoot th{padding:5px 4px!important;border-top:1px solid var(--auth-line)!important;border-right:1px solid #dfc9c9!important;background:#f2e5e5!important;color:#4a1818!important;font-size:9.8px!important;font-weight:600!important}body[data-theme="dark"]{--auth-bg:#101216;--auth-panel:#17191f;--auth-panel2:#20232a;--auth-line:#414650;--auth-line2:#5b616a;--auth-text:#f1eaea;--auth-muted:#c3b0b0;--auth-head:linear-gradient(180deg,#7f1d1d 0%,#5f1212 55%,#2b0505 100%);--auth-toolbar:linear-gradient(180deg,#22252c 0%,#17191f 100%)}body[data-theme="dark"] .autorizacion-presupuesto-app, body[data-theme="dark"] .autorizacion-presupuesto-app .content, body[data-theme="dark"] .autorizacion-presupuesto-app .section{background:var(--auth-panel)!important;color:var(--auth-text)!important}body[data-theme="dark"] .autorizacion-presupuesto-app .table-wrap tbody td, body[data-theme="dark"] #modalOV .modal-table-wrap tbody td, body[data-theme="dark"] #modalConsumo .modal-table-wrap tbody td{background:#17191f!important;color:#f2eaea!important;border-color:#3d424b!important}@@container auth-presupuesto (max-width:900px){.autorizacion-presupuesto-app .section-title{align-items:flex-start!important}.autorizacion-presupuesto-app .section-title>div{width:100%!important;justify-content:flex-start!important}.autorizacion-presupuesto-app .statusbar{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important}}@@container auth-presupuesto (max-width:520px){.autorizacion-presupuesto-app .content{padding:3px!important}.autorizacion-presupuesto-app .section-title{font-size:9.8px!important}.autorizacion-presupuesto-app .statusbar{grid-template-columns:1fr!important;gap:2px!important}#modalOV .modal-dialog,#modalConsumo .modal-dialog{max-width:100vw!important;width:100vw!important;margin:0!important}#modalOV .modal-content,#modalConsumo .modal-content{min-height:100dvh!important;border-left:0!important;border-right:0!important}}
