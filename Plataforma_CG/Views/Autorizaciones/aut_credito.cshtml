@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Autorización de Crédito";
}

<style>
@@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap');:root{--ac-font:"Poppins","Segoe UI",Arial,sans-serif;--ac-bg:#efe3e3;--ac-panel:#fffafa;--ac-panel2:#f7eeee;--ac-line:#d6baba;--ac-line2:#9b6262;--ac-text:#341515;--ac-muted:#775252;--ac-brand:#8b0000;--ac-brand2:#5b0000;--ac-head:linear-gradient(180deg,#b30000 0%,#870000 57%,#5c0000 100%);--ac-toolbar:linear-gradient(#fff8f8,#ecd9d9)}*{box-sizing:border-box}html,body{width:100%!important;max-width:100%!important;margin:0!important;padding:0!important;overflow-x:hidden!important}body{background:transparent!important;color:var(--ac-text)!important;font-family:var(--ac-font)!important}body:has(.autorizacion-credito-app) .layout-main-content, body:has(.autorizacion-credito-app) .layout-main-content .layout-container-fluid, body:has(.autorizacion-credito-app) main[role="main"]{min-height:0!important;height:auto!important;max-height:none!important}body:has(.autorizacion-credito-app) .layout-main-content{flex:0 0 auto!important;width:auto!important;max-width:100%!important;min-width:0!important;overflow-x:hidden!important;overflow-y:visible!important}body:has(.autorizacion-credito-app) .layout-main-content .layout-container-fluid{width:100%!important;max-width:100%!important;min-width:0!important;margin:0!important;padding:0!important}body:has(.autorizacion-credito-app) footer, body:has(.autorizacion-credito-app) .footer, body:has(.autorizacion-credito-app) .layout-footer{position:static!important;min-height:29px!important;height:auto!important;margin-top:4px!important;padding:4px 0!important;font-family:var(--ac-font)!important;font-size:10.5px!important;line-height:1.15!important}.autorizacion-credito-app{width:100%!important;max-width:100%!important;min-width:0!important;margin:0!important;padding:0!important;border:1px solid #865050!important;border-radius:0!important;background:var(--ac-panel)!important;color:var(--ac-text)!important;box-shadow:none!important;overflow:hidden!important;font-family:var(--ac-font)!important;font-size:10.6px!important;line-height:1.2!important;container-type:inline-size;container-name:aut-credito}.autorizacion-credito-app *, #mensajeModal,#mensajeModal *, #confirmModal,#confirmModal *{font-family:var(--ac-font)!important}.autorizacion-credito-app .titlebar{display:none!important}.autorizacion-credito-app .toolbar{display:none!important}.autorizacion-credito-app .content{width:100%!important;max-width:100%!important;min-width:0!important;margin:0!important;padding:4px!important;background:var(--ac-bg)!important}.autorizacion-credito-app .workspace{width:100%!important;max-width:100%!important;min-width:0!important;margin:0!important;padding:0!important;border:0!important;background:transparent!important}.autorizacion-credito-app .section{width:100%!important;max-width:100%!important;min-width:0!important;margin:0!important;border:1px solid var(--ac-line)!important;border-radius:0!important;background:var(--ac-panel)!important;overflow:hidden!important}.autorizacion-credito-app .section-title{min-height:31px!important;margin:0!important;padding:4px 6px!important;display:flex!important;align-items:center!important;justify-content:space-between!important;gap:5px!important;flex-wrap:wrap!important;border:0!important;border-bottom:1px solid #540000!important;background:var(--ac-head)!important;color:#fff!important;font-size:10.2px!important;font-weight:600!important;line-height:1.05!important}.autorizacion-credito-app .section-title>div{display:flex!important;align-items:center!important;gap:5px!important;flex-wrap:wrap!important}.autorizacion-credito-app .section-title>div>span:last-child{font-size:8.2px!important;font-weight:400!important;color:#f0cece!important}.autorizacion-credito-app .estado-badge{min-height:20px!important;padding:2px 5px!important;display:inline-flex!important;align-items:center!important;gap:4px!important;border:1px solid transparent!important;border-radius:2px!important;font-size:8.3px!important;font-weight:600!important;line-height:1!important}.autorizacion-credito-app .est-dot{width:7px!important;height:7px!important;display:inline-block!important;border-radius:50%!important;background:#aaa!important}.autorizacion-credito-app .est-ok{background:#dff3e2!important;border-color:#6aa84f!important;color:#2f6b1f!important}.autorizacion-credito-app .est-ok .est-dot{background:#16a34a!important}.autorizacion-credito-app .est-warn{background:#fff4cc!important;border-color:#d6b656!important;color:#7a5a00!important}.autorizacion-credito-app .est-warn .est-dot{background:#d97706!important}.autorizacion-credito-app .est-err{background:#fde2e2!important;border-color:#d9534f!important;color:#b00000!important}.autorizacion-credito-app .est-err .est-dot{background:#dc2626!important}.autorizacion-credito-app .est-info{background:#e8f4fd!important;border-color:#7ab8d4!important;color:#064b6b!important}.autorizacion-credito-app .est-info .est-dot{background:#2563eb!important}.autorizacion-credito-app .est-light{background:#f4f4f4!important;border-color:#ccc!important;color:#555!important}.autorizacion-credito-app .table-wrap{width:100%!important;max-width:100%!important;min-width:0!important;max-height:none!important;height:auto!important;overflow-x:auto!important;overflow-y:visible!important;background:#fff!important;border-top:0!important;scrollbar-gutter:auto!important}.autorizacion-credito-app .table-wrap table{width:100%!important;min-width:1280px!important;margin:0!important;border-collapse:separate!important;border-spacing:0!important;table-layout:fixed!important;background:#fff!important;color:var(--ac-text)!important;font-size:10.5px!important}.autorizacion-credito-app .table-wrap thead th{position:sticky!important;top:0!important;z-index:10!important;padding:5px 4px!important;border-top:0!important;border-right:1px solid #742727!important;border-bottom:1px solid #540000!important;background:var(--ac-head)!important;color:#fff!important;font-size:9.4px!important;font-weight:600!important;line-height:1.08!important;white-space:nowrap!important;text-transform:none!important;letter-spacing:0!important;box-shadow:none!important;vertical-align:middle!important}.autorizacion-credito-app .table-wrap tbody td{padding:4px!important;border-right:1px solid #dfc9c9!important;border-bottom:1px solid #dfc9c9!important;background:#fffafa!important;color:#291414!important;font-size:10.5px!important;line-height:1.12!important;white-space:nowrap!important;overflow:hidden!important;text-overflow:ellipsis!important;vertical-align:middle!important}.autorizacion-credito-app .table-wrap tbody tr:nth-child(even) td{background:#f9eeee!important}.autorizacion-credito-app .table-wrap tbody tr:hover td{background:#f1dddd!important}.autorizacion-credito-app .table-wrap tbody tr.row-danger td{background:#f9e2e2!important}.autorizacion-credito-app .table-wrap tbody tr.row-ok td{background:#e3f1e6!important}.autorizacion-credito-app .table-wrap tbody tr.row-muted td{background:#eeeeee!important;color:#777!important}.autorizacion-credito-app .col-ov{width:115px!important}.autorizacion-credito-app .col-client{width:250px!important}.autorizacion-credito-app .col-kg{width:95px!important}.autorizacion-credito-app .col-num{width:125px!important}.autorizacion-credito-app .col-acc{width:175px!important}.autorizacion-credito-app .td-num{text-align:right!important;font-variant-numeric:tabular-nums!important}.autorizacion-credito-app .text-danger{color:#b00000!important;font-weight:600!important}.autorizacion-credito-app .text-center{text-align:center!important}.autorizacion-credito-app .pm-btn, #mensajeModal .pm-btn,#confirmModal .pm-btn{min-width:0!important;min-height:27px!important;height:27px!important;padding:0 7px!important;display:inline-flex!important;align-items:center!important;justify-content:center!important;gap:4px!important;border:1px solid var(--ac-line2)!important;border-radius:0!important;background:linear-gradient(#fffefe,#ecd7d7)!important;color:#4a1111!important;font-size:8.8px!important;font-weight:600!important;line-height:1!important;text-decoration:none!important;white-space:nowrap!important;box-shadow:none!important;cursor:pointer!important}.autorizacion-credito-app .pm-btn:hover,#mensajeModal .pm-btn:hover,#confirmModal .pm-btn:hover{filter:brightness(.98)}.autorizacion-credito-app .pm-btn:disabled,#mensajeModal .pm-btn:disabled,#confirmModal .pm-btn:disabled{opacity:.58!important;cursor:not-allowed!important}.autorizacion-credito-app .pm-btn-success{border-color:#157347!important;background:linear-gradient(180deg,#28a745 0%,#218838 58%,#196f31 100%)!important;color:#fff!important}.autorizacion-credito-app .pm-btn-danger{border-color:#a11!important;background:linear-gradient(180deg,#dc3545 0%,#c0392b 55%,#a93226 100%)!important;color:#fff!important}.autorizacion-credito-app .pm-btn-primary, #mensajeModal .pm-btn-primary,#confirmModal .pm-btn-primary{border-color:#750000!important;background:var(--ac-head)!important;color:#fff!important}.autorizacion-credito-app .pm-btn-secondary,#confirmModal .pm-btn-secondary{border-color:var(--ac-line2)!important;background:linear-gradient(#fffefe,#ecd7d7)!important;color:#4a1111!important}.autorizacion-credito-app .acciones-ov{display:flex!important;align-items:center!important;justify-content:center!important;gap:3px!important;flex-wrap:nowrap!important}.autorizacion-credito-app .statusbar{min-height:21px!important;padding:3px 6px!important;display:flex!important;align-items:center!important;justify-content:space-between!important;gap:5px!important;border-top:1px solid var(--ac-line)!important;background:var(--ac-toolbar)!important;color:#674343!important;font-size:8.4px!important;line-height:1!important;flex-wrap:wrap!important}#mensajeModal .modal-dialog,#confirmModal .modal-dialog{max-width:min(420px,94vw)!important;margin:.5rem auto!important}#mensajeModal .modal-content,#confirmModal .modal-content{border:1px solid #6e3737!important;border-radius:0!important;background:var(--ac-panel)!important;box-shadow:0 10px 28px rgba(50,0,0,.20)!important;overflow:hidden!important}#mensajeModal .modal-header,#confirmModal .modal-header{min-height:36px!important;padding:5px 7px!important;border:0!important;border-bottom:1px solid #540000!important;background:var(--ac-head)!important;color:#fff!important}#mensajeModal .modal-title,#confirmModal .modal-title{margin:0!important;color:#fff!important;font-size:11.2px!important;font-weight:600!important;line-height:1.08!important}#mensajeModal .btn-close,#confirmModal .btn-close{filter:invert(1) grayscale(1)!important;opacity:.95!important}#mensajeModal .modal-body,#confirmModal .modal-body{min-height:70px!important;padding:9px!important;display:flex!important;align-items:center!important;justify-content:center!important;background:var(--ac-bg)!important;color:var(--ac-text)!important;font-size:10.3px!important;line-height:1.25!important;text-align:center!important}#mensajeModal .modal-footer,#confirmModal .modal-footer{min-height:36px!important;padding:4px 6px!important;display:flex!important;justify-content:center!important;gap:4px!important;border-top:1px solid var(--ac-line)!important;background:#f5e8e8!important}body[data-theme="dark"]{--ac-bg:#101216;--ac-panel:#17191f;--ac-panel2:#20232a;--ac-line:#414650;--ac-line2:#5b616a;--ac-text:#f1eaea;--ac-muted:#c3b0b0;--ac-head:linear-gradient(180deg,#7f1d1d 0%,#5f1212 55%,#2b0505 100%);--ac-toolbar:linear-gradient(180deg,#22252c 0%,#17191f 100%)}body[data-theme="dark"] .autorizacion-credito-app, body[data-theme="dark"] .autorizacion-credito-app .content, body[data-theme="dark"] .autorizacion-credito-app .section{background:var(--ac-panel)!important;color:var(--ac-text)!important}body[data-theme="dark"] .autorizacion-credito-app .table-wrap tbody td{background:#17191f!important;color:#f2eaea!important;border-color:#3d424b!important}@@container aut-credito (max-width:980px){.autorizacion-credito-app .section-title{align-items:flex-start!important}.autorizacion-credito-app .section-title>div{width:100%!important;justify-content:flex-start!important}.autorizacion-credito-app .statusbar{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important}}@@container aut-credito (max-width:560px){.autorizacion-credito-app .content{padding:3px!important}.autorizacion-credito-app .statusbar{grid-template-columns:1fr!important;gap:2px!important}#mensajeModal .modal-dialog,#confirmModal .modal-dialog{width:100vw!important;max-width:100vw!important;margin:0!important}#mensajeModal .modal-content,#confirmModal .modal-content{min-height:100dvh!important;border-left:0!important;border-right:0!important}}
</style>

<div class="window autorizacion-credito-app">

    <div class="titlebar">
        <div>Autorización de Crédito</div>
        <div class="actions">
            <div class="win-btn"></div>
            <div class="win-btn"></div>
            <div class="win-btn"></div>
        </div>
    </div>

 @*    <div class="toolbar">
        <button class="tool-btn" type="button" onclick="cargar()">Actualizar</button>
    </div> *@

    <div class="content">

       

        <div class="workspace">

            @Html.AntiForgeryToken()

            <div class="section">
                <div class="section-title">
                    Órdenes con validación de crédito
                    <div style="display:flex;align-items:center;gap:8px;">
                        <span class="estado-badge est-info" id="badgeEstado">
                            <span class="est-dot"></span>
                            <span id="lastStatusCredito">Cargando…</span>
                        </span>
                        <span style="font-size:11px;font-weight:400;color:rgba(255,255,255,.8);">
                            Actualizado: <span id="lastUpdatedCredito">—</span>
                        </span>
                    </div>
                </div>

                <div class="table-wrap">
                    <table>
                        <colgroup>
                            <col class="col-ov">
                            <col class="col-client">
                            <col class="col-kg">
                            <col class="col-num">
                            <col class="col-num">
                            <col class="col-num">
                            <col class="col-num">
                            <col class="col-num">
                            <col class="col-num">
                            <col class="col-acc">
                        </colgroup>
                        <thead>
                            <tr>
                                <th>Orden Venta</th>
                                <th>Cliente</th>
                                <th class="td-num">KG OV</th>
                                <th class="td-num">Importe Pedido</th>
                                <th class="td-num">Límite Crédito</th>
                                <th class="td-num">Saldo Actual</th>
                                <th class="td-num">Otros Pedidos</th>
                                <th class="td-num">Disponible</th>
                                <th class="td-num">Excedente</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyCredito">
                            <tr>
                                <td colspan="10" class="text-center" style="padding:16px;color:#6a3a3a;">Cargando...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>

    <div class="statusbar">
        <div>Registro listo</div>
        <div>Usuario: @User.Identity.Name</div>
        <div>Empresa: Carnes G SA de CV</div>
        <div>Módulo: Autorización de Crédito</div>
    </div>

</div>

<!-- Modal mensaje -->
<div class="modal fade" id="mensajeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="mensajeModalTitulo">Mensaje</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="mensajeModalTexto">...</div>
            <div class="modal-footer">
                <button type="button" class="pm-btn pm-btn-primary" data-bs-dismiss="modal">Aceptar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal confirmación -->
<div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmModalTitulo">Confirmar acción</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="confirmModalTexto">¿Desea continuar?</div>
            <div class="modal-footer">
                <button type="button" class="pm-btn pm-btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="pm-btn pm-btn-primary" id="confirmModalAceptar">Aceptar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    $(function () {
        const fechaEntrega = (() => {
            const d = new Date();
            return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
        })();

        const esc = s => String(s??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
        const money = n => Number(n||0).toLocaleString("es-MX", { style:"currency", currency:"MXN" });
        const kgFmt = n => Number(n||0).toLocaleString("es-MX", { minimumFractionDigits:2, maximumFractionDigits:2 }) + " kg";

        function mostrarMensajeCentro(texto, titulo="Mensaje") {
            $("#mensajeModalTitulo").text(titulo);
            $("#mensajeModalTexto").text(texto);
            new bootstrap.Modal(document.getElementById("mensajeModal")).show();
        }

        function mostrarConfirmacion(texto, titulo="Confirmar acción") {
            return new Promise(resolve => {
                $("#confirmModalTitulo").text(titulo);
                $("#confirmModalTexto").text(texto);
                const modalEl = document.getElementById("confirmModal");
                const modal = new bootstrap.Modal(modalEl);
                let resuelto = false;
                $("#confirmModalAceptar").off("click").on("click", function() {
                    resuelto = true; modal.hide(); resolve(true);
                });
                $(modalEl).off("hidden.bs.modal.confirm").on("hidden.bs.modal.confirm", function() {
                    if (!resuelto) resolve(false);
                });
                modal.show();
            });
        }

        const POLL = 15000, MAX_BACK = 120000;
        let timer = null, inFlight = false, backoff = POLL;

        function setStatus(txt, cls) {
            $("#lastStatusCredito").text(txt);
            const $b = $("#badgeEstado");
            $b.removeClass("est-ok est-warn est-err est-info est-light");
            const map = { ok:'est-ok', warn:'est-warn', err:'est-err', info:'est-info' };
            $b.addClass(map[cls] || 'est-light');
        }

        function setUpdated() {
            $("#lastUpdatedCredito").text(new Date().toLocaleTimeString('es-MX'));
        }

        function renderTablaCredito(items) {
            const $tb = $("#tbodyCredito").empty();
            if (!items || !items.length) {
                $tb.append("<tr><td colspan='10' class='text-center' style='padding:16px;color:#6a3a3a;'>No hay órdenes pendientes</td></tr>");
                return;
            }
            items.forEach(it => {
                const ov = it.ordenVenta ?? '';
                const excede = Number(it.excede||0) > 0;
                const rowClass = excede ? 'row-danger' : '';
                const clienteNombre = it.clienteNombre ?? '';
                const clienteCodigo = it.cliente ?? '';
                const clienteTxt = clienteNombre || clienteCodigo;
                const kgOv = it.kgOv ?? it.kilogramos ?? 0;

                $tb.append(`
                  <tr data-ov="${esc(ov)}" class="${rowClass}">
                    <td class="col-ov" title="${esc(ov)}"><b>${esc(ov)}</b></td>
                    <td class="col-client" title="${esc(clienteNombre ? (clienteNombre+' • '+clienteCodigo) : clienteCodigo)}">${esc(clienteTxt)}</td>
                    <td class="td-num col-kg">${kgFmt(kgOv)}</td>
                    <td class="td-num col-num">${money(it.importePedido)}</td>
                    <td class="td-num col-num">${money(it.limiteCredito)}</td>
                    <td class="td-num col-num">${money(it.saldoActual)}</td>
                    <td class="td-num col-num">${money(it.otrosPedidos)}</td>
                    <td class="td-num col-num">${money(it.disponible)}</td>
                    <td class="td-num col-num">
                        ${excede ? `<span class="text-danger">${money(it.montoExcedido)}</span>` : '-'}
                    </td>
                    <td class="text-center col-acc">
                        <div class="acciones-ov">
                            <button class="pm-btn pm-btn-success autorizar" data-ov="${esc(ov)}">✔ Autorizar</button>
                            <button class="pm-btn pm-btn-danger rechazar" data-ov="${esc(ov)}">✖ Rechazar</button>
                        </div>
                    </td>
                  </tr>`);
            });
        }

        window.cargar = function() {
            if (inFlight) return;
            inFlight = true;
            setStatus("Actualizando…", "info");
            $.ajax({ url:'/Comercial/ObtenerOrdenesConCredito', type:'GET', data:{ fechaEntrega }, cache:false })
                .done(data => { renderTablaCredito(data); backoff = POLL; setUpdated(); setStatus("Al día", "ok"); })
                .fail((xhr, st, err) => {
                    console.error("Error AJAX (crédito):", st, err);
                    setStatus("Error. Reintentando…", "err");
                    backoff = Math.min(backoff*2, MAX_BACK);
                    if (timer) clearInterval(timer);
                    timer = setInterval(window.cargar, backoff);
                })
                .always(() => { inFlight = false; });
        };

        function start() {
            if (timer) clearInterval(timer);
            timer = setInterval(window.cargar, POLL);
        }

        window.cargar();
        start();

        document.addEventListener('visibilitychange', () => {
            if (document.hidden) { clearInterval(timer); timer = null; }
            else { window.cargar(); start(); }
        });

        $("#tbodyCredito").on('click', '.autorizar', async function() {
            const ov = $(this).data('ov');
            if (!ov) { mostrarMensajeCentro("Consecutivo de OV ausente.", "Aviso"); return; }
            const confirmado = await mostrarConfirmacion(`¿Desea autorizar la ${ov}?`, "Autorizar crédito");
            if (!confirmado) return;
            const token = $('input[name="__RequestVerificationToken"]').val();
            if (timer) { clearInterval(timer); timer = null; }
            $.ajax({ url:'/Comercial/AutorizarCredito', type:'POST',
                data:{ __RequestVerificationToken:token, idOrdenVenta:ov },
                headers:{ 'RequestVerificationToken':token }
            })
            .done(res => {
                mostrarMensajeCentro(res?.mensaje || "Crédito autorizado correctamente.", "Autorización");
                const $tr = $(`tr[data-ov='${ov}']`);
                $tr.removeClass('row-danger').addClass('row-ok');
                $tr.find('button').prop('disabled', true);
                window.cargar();
            })
            .fail(xhr => {
                mostrarMensajeCentro(xhr.responseJSON?.mensaje || xhr.responseJSON?.error || "Error al autorizar crédito", "Error");
            })
            .always(start);
        });

        $("#tbodyCredito").on('click', '.rechazar', async function() {
            const ov = $(this).data('ov');
            if (!ov) { mostrarMensajeCentro("Consecutivo de OV ausente.", "Aviso"); return; }
            const confirmado = await mostrarConfirmacion(`¿Desea rechazar la OV ${ov}?`, "Rechazar crédito");
            if (!confirmado) return;
            const token = $('input[name="__RequestVerificationToken"]').val();
            if (timer) { clearInterval(timer); timer = null; }
            $.ajax({ url:'/Comercial/RechazarCredito', type:'POST',
                data:{ __RequestVerificationToken:token, idOrdenVenta:ov },
                headers:{ 'RequestVerificationToken':token }
            })
            .done(res => {
                mostrarMensajeCentro(res?.mensaje || "Crédito rechazado correctamente.", "Rechazo");
                const $tr = $(`tr[data-ov='${ov}']`);
                $tr.removeClass('row-danger').addClass('row-muted');
                $tr.find('button').prop('disabled', true);
                window.cargar();
            })
            .fail(xhr => {
                mostrarMensajeCentro(xhr.responseJSON?.mensaje || xhr.responseJSON?.error || "Error al rechazar crédito", "Error");
            })
            .always(start);
        });
    });
</script>
}
