                            <tr>
                                <th>Orden de venta</th>
                                <th>Serie</th>
                                <th>Cliente</th>

                                <th class="text-end">
                                    Importe Pedido
                                </th>

                                <th class="text-end">
                                    Límite Crédito
                                </th>

                                <th class="text-end">
                                    Saldo Actual
                                </th>

                                <th class="text-end">
                                    Otros Pedidos
                                </th>

                                <th class="text-end">
                                    Disponible
                                </th>

                                <th class="text-end">
                                    Excedente
                                </th>

                                <th>Autorizó</th>
                                <th>Acción</th>
                                <th>Motivo</th>
                                <th>Fecha Registro</th>
                            </tr>
                        </thead>

                        <tbody id="tbodyHistoricoCredito">

                            <tr>
                                <td colspan="13"
                                    class="text-center">

                                    Selecciona un rango de fechas y consulta.

                                </td>
                            </tr>

                        </tbody>

                    </table>

                </div>

            </div>

            <div class="modal-footer">

                <button
                    class="pm-btn pm-btn-secondary"
                    data-bs-dismiss="modal"
                    type="button">

                    Cerrar

                </button>

            </div>

        </div>
    </div>
</div>


<!-- =========================================================
     MODAL MOTIVO AUTORIZACIÓN DE CRÉDITO
     ========================================================= -->
<div class="modal fade"
     id="motivoCreditoModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    Autorizar crédito
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar">
                </button>
            </div>

            <div class="modal-body"
                 style="display:block!important;text-align:left!important;">

                <div style="margin-bottom:8px;font-weight:600;">
                    Orden de venta:
                    <span id="motivoCreditoOv"></span>
                </div>

                <label for="motivoCreditoTexto"
                       style="display:block;margin-bottom:4px;font-weight:600;">
                    Motivo de autorización *
                </label>

                <textarea id="motivoCreditoTexto"
                          maxlength="500"
                          rows="4"
                          placeholder="Ej. Autorizado por acuerdo comercial con cliente..."
                          style="
                              width:100%;
                              resize:vertical;
                              border:1px solid #9b6262;
                              padding:8px;
                              font-family:Poppins,Arial,sans-serif;
                              font-size:11px;
                              outline:none;
                          "></textarea>

                <div style="
                    margin-top:4px;
                    font-size:9px;
                    color:#775252;
                ">
                    El motivo es obligatorio y quedará registrado en el histórico.
                </div>

                <div id="motivoCreditoError"
                     style="
                         display:none;
                         margin-top:6px;
                         color:#b00000;
                         font-size:10px;
                         font-weight:600;
                     ">
                    Debes capturar el motivo de la autorización.
                </div>

            </div>

            <div class="modal-footer">

                <button type="button"
                        class="pm-btn pm-btn-secondary"
                        data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button type="button"
                        class="pm-btn pm-btn-primary"
                        id="btnConfirmarMotivoCredito">
                    Autorizar crédito
                </button>

            </div>

        </div>
    </div>
</div>

@section Scripts {
<script>
    $(function () {
        const fechaEntrega = (() => {
            const d = new Date();
            return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
        })();

        const esc = s => String(s??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
        const money = n => Number(n||0).toLocaleString("es-MX", { style:"currency", currency:"MXN" });
        const kgFmt = n => Number(n||0).toLocaleString("es-MX", { minimumFractionDigits:2, maximumFractionDigits:2 }) + " kg";

        function mostrarMensajeCentro(texto, titulo="Mensaje") {
            $("#mensajeModalTitulo").text(titulo);
            $("#mensajeModalTexto").text(texto);
            new bootstrap.Modal(document.getElementById("mensajeModal")).show();
        }


        // =========================================================
// HISTÓRICO AUTORIZACIONES DE CRÉDITO
// =========================================================

function inicializarFechasHistoricoCredito() {

    const hoy = new Date();

    const fecha =
        `${hoy.getFullYear()}-` +
        `${String(hoy.getMonth() + 1).padStart(2, '0')}-` +
        `${String(hoy.getDate()).padStart(2, '0')}`;

    if (!$("#filtroFechaInicioHistCredito").val()) {
        $("#filtroFechaInicioHistCredito").val(fecha);
    }

    if (!$("#filtroFechaFinHistCredito").val()) {
        $("#filtroFechaFinHistCredito").val(fecha);
    }
}


function cargarHistoricoCredito() {

    const $tb =
        $("#tbodyHistoricoCredito");

    $tb.html(`
        <tr>
            <td colspan="13"
                class="text-center">
                Cargando...
            </td>
        </tr>
    `);

    $.ajax({
        url:
            '/Comercial/ObtenerHistoricoAutorizacionCredito',

        type:
            'GET',

        data: {
            fechaInicio:
                $("#filtroFechaInicioHistCredito").val(),

            fechaFin:
                $("#filtroFechaFinHistCredito").val()
        }
    })
    .done(function (data) {

        $tb.empty();

        if (!Array.isArray(data) ||
            !data.length) {

            $tb.append(`
                <tr>
                    <td colspan="13"
                        class="text-center">

                        No hay registros para ese rango.

                    </td>
                </tr>
            `);

            return;
        }

        data.forEach(x => {

            const fechaTxt =
                x.fechaRegistro
                    ? new Date(
                        x.fechaRegistro
                      ).toLocaleString(
                        'es-MX'
                      )
                    : '-';

            const accion =
                (x.accion ?? '')
                .toUpperCase();

            const accionHtml =
                accion === 'AUTORIZADO'
                    ? `<span class="hist-credito-ok">
                           AUTORIZADO
                       </span>`
                    : `<span class="hist-credito-warn">
                           ${esc(accion || '-')}
                       </span>`;

            $tb.append(`
                <tr>

                    <td>
                        <b>
                            ${esc(
                                x.ordenVentaConsecutivo ?? '-'
                            )}
                        </b>
                    </td>

                    <td>
                        ${esc(x.serie ?? '-')}
                    </td>

                    <td>
                        ${esc(
                            x.clienteNombre ??
                            x.clienteId ??
                            '-'
                        )}
                    </td>

                    <td class="text-end">
                        ${money(x.importePedido)}
                    </td>

                    <td class="text-end">
                        ${money(x.limiteCredito)}
                    </td>

                    <td class="text-end">
                        ${money(x.saldoActual)}
                    </td>

                    <td class="text-end">
                        ${money(x.otrosPedidos)}
                    </td>

                    <td class="text-end">
                        ${money(x.disponible)}
                    </td>

                    <td class="text-end hist-excedente">
                        ${money(x.montoExcedido)}
                    </td>

                    <td class="hist-autorizador">
                        ${esc(x.usuario ?? '-')}
                    </td>

                    <td>
                        ${accionHtml}
                    </td>

                    <td>
                        ${esc(x.motivo ?? '-')}
                    </td>

                    <td>
                        ${fechaTxt}
                    </td>

                </tr>
            `);
        });
    })
    .fail(function (xhr) {

        console.error(
            "Error histórico crédito:",
            xhr
        );

        $tb.html(`
            <tr>
                <td colspan="13"
                    class="text-center text-danger">

                    Error al consultar histórico.

                </td>
            </tr>
        `);
    });
}


$("#modalReporteHistoricoCredito")
    .on(
        "show.bs.modal",
        function () {

            inicializarFechasHistoricoCredito();
        }
    );


$("#modalReporteHistoricoCredito")
    .on(
        "shown.bs.modal",
        function () {

            cargarHistoricoCredito();
        }
    );


$("#btnBuscarHistCredito")
    .on(
        "click",
        cargarHistoricoCredito
    );


$("#btnDescargarHistCreditoExcel")
    .on(
        "click",
        function () {

            const fechaInicio =
                $("#filtroFechaInicioHistCredito")
                    .val();

            const fechaFin =
                $("#filtroFechaFinHistCredito")
                    .val();

            if (!fechaInicio ||
                !fechaFin) {

                mostrarMensajeCentro(
                    "Selecciona fecha inicio y fecha fin.",
                    "Aviso"
                );

                return;
            }

            const url =
                '/Comercial/DescargarHistoricoAutorizacionCreditoExcel' +
                '?fechaInicio=' +
                encodeURIComponent(fechaInicio) +
                '&fechaFin=' +
                encodeURIComponent(fechaFin);

            window.open(
                url,
                '_blank'
            );
        }
    );

        function mostrarConfirmacion(texto, titulo="Confirmar acción") {
            return new Promise(resolve => {
                $("#confirmModalTitulo").text(titulo);
                $("#confirmModalTexto").text(texto);
                const modalEl = document.getElementById("confirmModal");
                const modal = new bootstrap.Modal(modalEl);
                let resuelto = false;
                $("#confirmModalAceptar").off("click").on("click", function() {
                    resuelto = true; modal.hide(); resolve(true);
                });
                $(modalEl).off("hidden.bs.modal.confirm").on("hidden.bs.modal.confirm", function() {
                    if (!resuelto) resolve(false);
                });
                modal.show();
            });
        }

        const POLL = 15000, MAX_BACK = 120000;
        let timer = null, inFlight = false, backoff = POLL;

        function setStatus(txt, cls) {
            $("#lastStatusCredito").text(txt);
            const $b = $("#badgeEstado");
            $b.removeClass("est-ok est-warn est-err est-info est-light");
            const map = { ok:'est-ok', warn:'est-warn', err:'est-err', info:'est-info' };
            $b.addClass(map[cls] || 'est-light');
        }

        function setUpdated() {
            $("#lastUpdatedCredito").text(new Date().toLocaleTimeString('es-MX'));
        }

        function renderTablaCredito(items) {
            const $tb = $("#tbodyCredito").empty();
            if (!items || !items.length) {
                $tb.append("<tr><td colspan='10' class='text-center' style='padding:16px;color:#6a3a3a;'>No hay órdenes pendientes</td></tr>");
                return;
            }
            items.forEach(it => {
                const ov = it.ordenVenta ?? '';
                const excede = Number(it.excede||0) > 0;
                const rowClass = excede ? 'row-danger' : '';
                const clienteNombre = it.clienteNombre ?? '';
                const clienteCodigo = it.cliente ?? '';
                const clienteTxt = clienteNombre || clienteCodigo;
                const kgOv = it.kgOv ?? it.kilogramos ?? 0;

                $tb.append(`
                  <tr data-ov="${esc(ov)}" class="${rowClass}">
                    <td class="col-ov" title="${esc(ov)}"><b>${esc(ov)}</b></td>
                    <td class="col-client" title="${esc(clienteNombre ? (clienteNombre+' • '+clienteCodigo) : clienteCodigo)}">${esc(clienteTxt)}</td>
                    <td class="td-num col-kg">${kgFmt(kgOv)}</td>
                    <td class="td-num col-num">${money(it.importePedido)}</td>
                    <td class="td-num col-num">${money(it.limiteCredito)}</td>
                    <td class="td-num col-num">${money(it.saldoActual)}</td>
                    <td class="td-num col-num">${money(it.otrosPedidos)}</td>
                    <td class="td-num col-num">${money(it.disponible)}</td>
                    <td class="td-num col-num">
                        ${excede ? `<span class="text-danger">${money(it.montoExcedido)}</span>` : '-'}
                    </td>
                    <td class="text-center col-acc">
                        <div class="acciones-ov">
                            <button class="pm-btn pm-btn-success autorizar" data-ov="${esc(ov)}">✔ Autorizar</button>
                            <button class="pm-btn pm-btn-danger rechazar" data-ov="${esc(ov)}">✖ Rechazar</button>
                        </div>
                    </td>
                  </tr>`);
            });
        }

        window.cargar = function() {
            if (inFlight) return;
            inFlight = true;
            setStatus("Actualizando…", "info");
            $.ajax({ url:'/Comercial/ObtenerOrdenesConCredito', type:'GET', data:{ fechaEntrega }, cache:false })
                .done(data => { renderTablaCredito(data); backoff = POLL; setUpdated(); setStatus("Al día", "ok"); })
                .fail((xhr, st, err) => {
                    console.error("Error AJAX (crédito):", st, err);
                    setStatus("Error. Reintentando…", "err");
                    backoff = Math.min(backoff*2, MAX_BACK);
                    if (timer) clearInterval(timer);
                    timer = setInterval(window.cargar, backoff);
                })
                .always(() => { inFlight = false; });
        };

        function start() {
            if (timer) clearInterval(timer);
            timer = setInterval(window.cargar, POLL);
        }

        window.cargar();
        start();

        document.addEventListener('visibilitychange', () => {
            if (document.hidden) { clearInterval(timer); timer = null; }
            else { window.cargar(); start(); }
        });

   // =========================================================
// AUTORIZAR CRÉDITO CON MOTIVO OBLIGATORIO
// =========================================================
$("#tbodyCredito").on(
    'click',
    '.autorizar',
    function () {

        const ov =
            $(this).data('ov');

        if (!ov) {
            mostrarMensajeCentro(
                "Consecutivo de OV ausente.",
                "Aviso"
            );
            return;
        }

        // Limpiar modal
        $("#motivoCreditoOv").text(ov);
        $("#motivoCreditoTexto").val('');
        $("#motivoCreditoError").hide();

        // Guardar OV temporalmente
        $("#motivoCreditoModal")
            .data('ov', ov);

        const modalEl =
            document.getElementById(
                "motivoCreditoModal"
            );

        const modal =
            bootstrap.Modal.getOrCreateInstance(
                modalEl
            );

        modal.show();

        setTimeout(function () {
            $("#motivoCreditoTexto")
                .trigger('focus');
        }, 250);
    }
);


// =========================================================
// CONFIRMAR AUTORIZACIÓN
// =========================================================
$("#btnConfirmarMotivoCredito")
    .on(
        'click',
        function () {

            const modalEl =
                document.getElementById(
                    "motivoCreditoModal"
                );

            const modal =
                bootstrap.Modal.getOrCreateInstance(
                    modalEl
                );

            const ov =
                $("#motivoCreditoModal")
                    .data('ov');

            const motivo =
                (
                    $("#motivoCreditoTexto")
                        .val() || ''
                ).trim();


            // =============================================
            // VALIDAR MOTIVO
            // =============================================
            if (!motivo) {

                $("#motivoCreditoError")
                    .text(
                        "Debes capturar el motivo de la autorización."
                    )
                    .show();

                $("#motivoCreditoTexto")
                    .trigger('focus');

                return;
            }


            if (motivo.length < 3) {

                $("#motivoCreditoError")
                    .text(
                        "El motivo debe contener al menos 3 caracteres."
                    )
                    .show();

                $("#motivoCreditoTexto")
                    .trigger('focus');

                return;
            }


            $("#motivoCreditoError").hide();


            const token =
                $(
                    'input[name="__RequestVerificationToken"]'
                ).val();


            const $btn =
                $(this);

            $btn
                .prop('disabled', true)
                .text('Autorizando...');


            if (timer) {
                clearInterval(timer);
                timer = null;
            }


            $.ajax({

                url:
                    '/Comercial/AutorizarCredito',

                type:
                    'POST',

                data: {
                    __RequestVerificationToken:
                        token,

                    idOrdenVenta:
                        ov,

                    motivo:
                        motivo
                },

                headers: {
                    'RequestVerificationToken':
                        token
                }
            })
            .done(function (res) {

                modal.hide();

                mostrarMensajeCentro(
                    res?.mensaje ||
                    "Crédito autorizado correctamente.",
                    "Autorización"
                );


                const $tr =
                    $(
                        `tr[data-ov='${ov}']`
                    );

                $tr
                    .removeClass(
                        'row-danger'
                    )
                    .addClass(
                        'row-ok'
                    );

                $tr
                    .find('button')
                    .prop(
                        'disabled',
                        true
                    );


                window.cargar();
            })
            .fail(function (xhr) {

                mostrarMensajeCentro(
                    xhr.responseJSON?.mensaje ||
                    xhr.responseJSON?.error ||
                    "Error al autorizar crédito.",
                    "Error"
                );
            })
            .always(function () {

                $btn
                    .prop(
                        'disabled',
                        false
                    )
                    .text(
                        'Autorizar crédito'
                    );

                start();
            });
        }
    );

        $("#tbodyCredito").on('click', '.rechazar', async function() {
            const ov = $(this).data('ov');
            if (!ov) { mostrarMensajeCentro("Consecutivo de OV ausente.", "Aviso"); return; }
            const confirmado = await mostrarConfirmacion(`¿Desea rechazar la OV ${ov}?`, "Rechazar crédito");
            if (!confirmado) return;
            const token = $('input[name="__RequestVerificationToken"]').val();
            if (timer) { clearInterval(timer); timer = null; }
            $.ajax({ url:'/Comercial/RechazarCredito', type:'POST',
                data:{ __RequestVerificationToken:token, idOrdenVenta:ov },
                headers:{ 'RequestVerificationToken':token }
            })
            .done(res => {
                mostrarMensajeCentro(res?.mensaje || "Crédito rechazado correctamente.", "Rechazo");
                const $tr = $(`tr[data-ov='${ov}']`);
                $tr.removeClass('row-danger').addClass('row-muted');
                $tr.find('button').prop('disabled', true);
                window.cargar();
            })
            .fail(xhr => {
                mostrarMensajeCentro(xhr.responseJSON?.mensaje || xhr.responseJSON?.error || "Error al rechazar crédito", "Error");
            })
            .always(start);
        });
    });
</script>
}
