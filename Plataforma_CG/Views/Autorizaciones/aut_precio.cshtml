(1)!important;opacity:.95!important}#modalOVPrecio .modal-body,#modalReporteHistoricoPrecio .modal-body{padding:6px!important;background:var(--ap-bg)!important;color:var(--ap-text)!important;font-size:10.2px!important;line-height:1.2!important}#modalOVPrecio .modal-footer,#modalReporteHistoricoPrecio .modal-footer{min-height:34px!important;padding:4px 6px!important;border-top:1px solid var(--ap-line)!important;background:#f5e8e8!important}#modalOVPrecio #btnAutorizarTodoPrecio{margin-bottom:5px!important}#modalOVPrecio .modal-table-wrap,#modalReporteHistoricoPrecio .modal-table-wrap{width:100%!important;max-height:60dvh!important;overflow:auto!important;border:1px solid var(--ap-line)!important;background:#fff!important}#modalOVPrecio .modal-table-wrap table,#modalReporteHistoricoPrecio .modal-table-wrap table{width:100%!important;margin:0!important;border-collapse:separate!important;border-spacing:0!important;background:#fff!important;color:var(--ap-text)!important;font-size:10.2px!important}#modalOVPrecio .modal-table-wrap table{min-width:930px!important}#modalReporteHistoricoPrecio .modal-table-wrap table{min-width:1250px!important}#modalOVPrecio .modal-table-wrap thead th,#modalReporteHistoricoPrecio .modal-table-wrap thead th{position:sticky!important;top:0!important;z-index:5!important;padding:5px 4px!important;border-right:1px solid #742727!important;border-bottom:1px solid #540000!important;background:var(--ap-head)!important;color:#fff!important;font-size:9.2px!important;font-weight:600!important;line-height:1.08!important;white-space:nowrap!important;text-transform:none!important}#modalOVPrecio .modal-table-wrap tbody td,#modalReporteHistoricoPrecio .modal-table-wrap tbody td{padding:4px!important;border-right:1px solid #dfc9c9!important;border-bottom:1px solid #dfc9c9!important;background:#fffafa!important;color:#291414!important;font-size:10.2px!important;line-height:1.12!important;vertical-align:middle!important}#modalOVPrecio .modal-table-wrap tbody tr:nth-child(even) td,#modalReporteHistoricoPrecio .modal-table-wrap tbody tr:nth-child(even) td{background:#f9eeee!important}#modalOVPrecio .modal-table-wrap tbody tr:hover td,#modalReporteHistoricoPrecio .modal-table-wrap tbody tr:hover td{background:#f1dddd!important}#modalReporteHistoricoPrecio .filters-inline{margin:0 0 5px!important;padding:5px!important;display:grid!important;grid-template-columns:150px 150px auto auto!important;gap:4px!important;align-items:end!important;border:1px solid var(--ap-line)!important;background:var(--ap-panel2)!important}#modalReporteHistoricoPrecio .filters-inline label{display:block!important;margin:0 0 2px!important;color:#5c2b2b!important;font-size:8.7px!important;font-weight:600!important;line-height:1!important}#modalReporteHistoricoPrecio input[type="date"], #modalReporteHistoricoPrecio input[type="text"], #modalReporteHistoricoPrecio input[type="number"], #modalReporteHistoricoPrecio select{width:100%!important;min-height:29px!important;height:29px!important;padding:3px 6px!important;border:1px solid var(--ap-line2)!important;border-radius:0!important;background:#fff!important;color:var(--ap-text)!important;font-size:9.8px!important;box-shadow:none!important}#modalReporteHistoricoPrecio table tbody td:nth-child(5), #modalReporteHistoricoPrecio table tbody td:nth-child(7), #modalReporteHistoricoPrecio table tbody td:nth-child(9){background:#fff4c9!important;color:#5a4300!important;font-weight:600!important}#modalReporteHistoricoPrecio table thead th:nth-child(5), #modalReporteHistoricoPrecio table thead th:nth-child(7), #modalReporteHistoricoPrecio table thead th:nth-child(9){background:linear-gradient(180deg,#e8bf3e 0%,#c99812 56%,#a97800 100%)!important;color:#fff!important;border-right:1px solid #8d6800!important}#modalReporteHistoricoPrecio table tbody tr:hover td:nth-child(5), #modalReporteHistoricoPrecio table tbody tr:hover td:nth-child(7), #modalReporteHistoricoPrecio table tbody tr:hover td:nth-child(9){background:#ffe69a!important;color:#4a3700!important}body[data-theme="dark"]{--ap-bg:#101216;--ap-panel:#17191f;--ap-panel2:#20232a;--ap-line:#414650;--ap-line2:#5b616a;--ap-text:#f1eaea;--ap-muted:#c3b0b0;--ap-head:linear-gradient(180deg,#7f1d1d 0%,#5f1212 55%,#2b0505 100%);--ap-toolbar:linear-gradient(180deg,#22252c 0%,#17191f 100%)}body[data-theme="dark"] .autorizacion-precio-app, body[data-theme="dark"] .autorizacion-precio-app .content, body[data-theme="dark"] .autorizacion-precio-app .section{background:var(--ap-panel)!important;color:var(--ap-text)!important}body[data-theme="dark"] .autorizacion-precio-app .table-wrap tbody td, body[data-theme="dark"] #modalOVPrecio .modal-table-wrap tbody td, body[data-theme="dark"] #modalReporteHistoricoPrecio .modal-table-wrap tbody td{background:#17191f!important;color:#f2eaea!important;border-color:#3d424b!important}@@container aut-precio (max-width:900px){.autorizacion-precio-app .section-title{align-items:flex-start!important}.autorizacion-precio-app .section-title>div{width:100%!important;justify-content:flex-start!important}.autorizacion-precio-app .statusbar{display:grid!important;grid-template-columns:repeat(2,minmax(0,1fr))!important}#modalReporteHistoricoPrecio .filters-inline{grid-template-columns:repeat(2,minmax(0,1fr))!important}}@@container aut-precio (max-width:520px){.autorizacion-precio-app .content{padding:3px!important}.autorizacion-precio-app .toolbar{display:grid!important;grid-template-columns:1fr!important}.autorizacion-precio-app .tool-btn{width:100%!important}.autorizacion-precio-app .statusbar{grid-template-columns:1fr!important;gap:2px!important}#modalReporteHistoricoPrecio .filters-inline{grid-template-columns:1fr!important}#modalOVPrecio .modal-dialog,#modalReporteHistoricoPrecio .modal-dialog{max-width:100vw!important;width:100vw!important;margin:0!important}#modalOVPrecio .modal-content,#modalReporteHistoricoPrecio .modal-content{min-height:100dvh!important;border-left:0!important;border-right:0!important}}
