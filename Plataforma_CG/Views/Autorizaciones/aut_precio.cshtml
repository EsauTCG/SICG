@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Autorización de Precio";
}

<style>
@@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap');:root{--ap-font:"Poppins","Segoe UI",Arial,sans-serif;--ap-bg:#efe3e3;--ap-panel:#fffafa;--ap-panel2:#f7eeee;--ap-line:#d6baba;--ap-line2:#9b6262;--ap-text:#341515;--ap-muted:#775252;--ap-brand:#8b0000;--ap-brand2:#5b0000;--ap-head:linear-gradient(180deg,#b30000 0%,#870000 57%,#5c0000 100%);--ap-toolbar:linear-gradient(#fff8f8,#ecd9d9)}*{box-sizing:border-box}html,body{width:100%!important;max-width:100%!important;margin:0!important;padding:0!important;overflow-x:hidden!important}body{background:transparent!important;color:var(--ap-text)!important;font-family:var(--ap-font)!important}body:has(.autorizacion-precio-app) .layout-main-content, body:has(.autorizacion-precio-app) .layout-main-content .layout-container-fluid, body:has(.autorizacion-precio-app) main[role="main"]{min-height:0!important;height:auto!important;max-height:none!important}body:has(.autorizacion-precio-app) .layout-main-content{flex:0 0 auto!important;width:auto!important;max-width:100%!important;min-width:0!important;overflow-x:hidden!important;overflow-y:visible!important}body:has(.autorizacion-precio-app) .layout-main-content .layout-container-fluid{width:100%!important;max-width:100%!important;min-width:0!important;margin:0!important;padding:0!important}body:has(.autorizacion-precio-app) footer, body:has(.autorizacion-precio-app) .footer, body:has(.autorizacion-precio-app) .layout-footer{position:static!important;min-height:29px!important;height:auto!important;margin-top:4px!important;padding:4px 0!important;font-family:var(--ap-font)!important;font-size:10.5px!important;line-height:1.15!important}.autorizacion-precio-app{width:100%!important;max-width:100%!important;min-width:0!important;margin:0!important;padding:0!important;border:1px solid #865050!important;border-radius:0!important;background:var(--ap-panel)!important;color:var(--ap-text)!important;box-shadow:none!important;overflow:hidden!important;font-family:var(--ap-font)!important;font-size:10.6px!important;line-height:1.2!important;container-type:inline-size;container-name:aut-precio}.autorizacion-precio-app *, #modalOVPrecio,#modalOVPrecio *, #modalReporteHistoricoPrecio,#modalReporteHistoricoPrecio *{font-family:var(--ap-font)!important}.autorizacion-precio-app .titlebar{display:none!important}.autorizacion-precio-app .toolbar{width:100%!important;min-height:35px!important;margin:0!important;padding:3px 4px!important;display:flex!important;align-items:center!important;justify-content:flex-end!important;gap:3px!important;flex-wrap:wrap!important;border:0!important;border-bottom:1px solid var(--ap-line)!important;background:var(--ap-toolbar)!important;font-size:9px!important}.autorizacion-precio-app .tool-btn{min-width:0!important;min-height:28px!important;height:28px!important;padding:0 8px!important;display:inline-flex!important;align-items:center!important;justify-content:center!important;gap:4px!important;border:1px solid var(--ap-line2)!important;border-radius:0!important;background:linear-gradient(#fffefe,#ecd7d7)!important;color:#4a1111!important;font-size:8.9px!important;font-weight:600!important;line-height:1!important;text-decoration:none!important;box-shadow:none!important;cursor:pointer!important}.autorizacion-precio-app .tool-btn-historico{border-color:#0d4f8c!important;background:linear-gradient(180deg,#4da3ff 0%,#1f78d1 55%,#0f5ea8 100%)!important;color:#fff!important}.autorizacion-precio-app .content{width:100%!important;max-width:100%!important;min-width:0!important;margin:0!important;padding:4px!important;background:var(--ap-bg)!important}.autorizacion-precio-app .workspace{width:100%!important;max-width:100%!important;min-width:0!important;margin:0!important;padding:0!important;border:0!important;background:transparent!important}.autorizacion-precio-app .section{width:100%!important;max-width:100%!important;min-width:0!important;margin:0!important;border:1px solid var(--ap-line)