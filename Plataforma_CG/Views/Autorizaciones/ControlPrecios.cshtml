<script>
/* Ajusta solamente la altura del área de resultados.
   El ancho siempre lo controla el contenedor real de _Layout2. */
function ajustarAltoControlPrecios() {
    const tabla = document.querySelector('#tab-lista .table-responsive');
    const app = document.querySelector('.window');

    if (!tabla || !app) return;

    if (window.matchMedia('(max-width: 1180px)').matches) {
        app.style.removeProperty('--control-work-height');
        return;
    }

    const top = Math.max(0, tabla.getBoundingClientRect().top);
    const alto = Math.max(360, window.innerHeight - top - 94);

    app.style.setProperty(
        '--control-work-height',
        `${Math.floor(alto)}px`
    );
}

let controlResizeTimer = 0;

function programarAjusteControlPrecios() {
    window.clearTimeout(controlResizeTimer);
    controlResizeTimer = window.setTimeout(ajustarAltoControlPrecios, 70);
}

window.requestAnimationFrame(ajustarAltoControlPrecios);
window.addEventListener('resize', programarAjusteControlPrecios, { passive: true });
window.addEventListener('orientationchange', programarAjusteControlPrecios, { passive: true });
window.visualViewport?.addEventListener('resize', programarAjusteControlPrecios, { passive: true });

document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('shown.bs.tab', programarAjusteControlPrecios);
});

if ('ResizeObserver' in window) {
    const appControl = document.querySelector('.window');
    const padreControl = appControl?.parentElement;

    if (padreControl) {
        const controlObserver = new ResizeObserver(programarAjusteControlPrecios);
        controlObserver.observe(padreControl);
    }
}


