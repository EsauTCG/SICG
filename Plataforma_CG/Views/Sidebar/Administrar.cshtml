@model Plataforma_CG.Models.ViewModels.SideAdminViewModel
@using System.Linq

@{
    ViewData["Title"] = "Administrar Sidebar";
    Layout = "~/Views/Shared/_Layout2.cshtml";

    var totalCategorias = Model.CategoriasExistentes.Count();
    var totalModulos = Model.ModulosExistentes.Count();
    var totalPadres = Model.ModulosExistentes.Count(m => m.PadreId == null);
    var totalHijos = Model.ModulosExistentes.Count(m => m.PadreId != null);
}

@await Html.PartialAsync("_KpiAdminTheme")

<style>
    /* ============================================================
           ADMINISTRACIÓN SIDEBAR - NUEVO DISEÑO
        ============================================================ */

    .sidebar-admin-page .dashboard-panel {
        overflow: visible;
    }

    .sidebar-form-panel {
        background: var(--kpi-panel-soft);
        border: 1px solid var(--kpi-border);
        border-radius: 14px;
        padding: 1rem;
    }

    .sidebar-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 1rem;
    }

    .module-list {
        border: 1px solid var(--kpi-border);
        border-radius: 14px;
        overflow: hidden;
        background: var(--kpi-card-bg);
        box-shadow: var(--kpi-shadow);
    }

        .module-list .list-group-item {
            background: var(--kpi-card-bg);
            color: var(--kpi-text);
            border-color: var(--kpi-border);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.85rem;
            flex-wrap: wrap;
            padding: 0.85rem 1rem;
            transition: background .2s ease, border-color .2s ease, transform .2s ease;
        }

            .module-list .list-group-item:hover {
                background: var(--kpi-active-bg);
                border-color: var(--kpi-border-strong);
            }

            .module-list .list-group-item:active {
                cursor: grabbing;
            }

    .module-main {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        min-width: 0;
        flex: 1;
    }

    .module-icon {
        width: 38px;
        height: 38px;
        border-radius: 11px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(122,11,11,0.10);
        color: var(--brand-main);
        border: 1px solid rgba(122,11,11,0.18);
        flex-shrink: 0;
    }

    body[data-theme="dark"] .module-icon {
        background: rgba(248,113,113,0.12);
        color: #fca5a5;
        border-color: rgba(248,113,113,0.30);
    }

    .module-title {
        color: var(--kpi-text-strong);
        font-weight: 900;
        line-height: 1.15;
        margin: 0;
        word-break: break-word;
    }

    .module-url {
        color: var(--kpi-text-muted);
        font-size: 0.78rem;
        margin: 0.25rem 0 0;
        font-weight: 700;
        word-break: break-all;
    }

    .module-actions {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        flex-shrink: 0;
    }

    .category-block {
        border: 1px solid var(--kpi-border);
        border-radius: 16px;
        background: var(--kpi-card-bg);
        box-shadow: var(--kpi-shadow);
        overflow: hidden;
        margin: 1rem;
    }

    .category-head {
        background: var(--kpi-panel-bg);
        border-bottom: 1px solid var(--kpi-border);
        padding: 0.9rem 1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

    .category-title {
        color: var(--kpi-text-strong);
        font-weight: 900;
        text-transform: uppercase;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 0.55rem;
        letter-spacing: .2px;
    }

    .category-count {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        border-radius: 999px;
        padding: 0.32rem 0.65rem;
        font-size: 0.74rem;
        font-weight: 900;
        background: rgba(122,11,11,0.08);
        color: var(--brand-main);
        border: 1px solid rgba(122,11,11,0.18);
        white-space: nowrap;
    }

    body[data-theme="dark"] .category-count {
        background: rgba(248,113,113,0.12);
        color: #fecaca;
        border-color: rgba(248,113,113,0.30);
    }

    .category-body {
        padding: 1rem;
    }

    .section-label {
        color: var(--kpi-text-muted);
        font-size: 0.74rem;
        font-weight: 900;
        text-transform: uppercase;
        margin: 0 0 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    .empty-mini {
        border: 1px dashed var(--kpi-border);
        border-radius: 12px;
        color: var(--kpi-text-muted);
        background: var(--kpi-panel-soft);
        padding: 0.85rem 1rem;
        font-size: 0.82rem;
        font-weight: 700;
        text-align: center;
    }

    .sortable-ghost,
    .bg-light {
        background: rgba(122,11,11,0.10) !important;
        border: 1px dashed var(--brand-main) !important;
        color: var(--kpi-text-strong) !important;
    }

    body[data-theme="dark"] .sortable-ghost,
    body[data-theme="dark"] .bg-light {
        background: rgba(248,113,113,0.18) !important;
        border-color: rgba(248,113,113,0.45) !important;
        color: #ffffff !important;
    }

    .search-sidebar-wrap {
        min-width: 280px;
        max-width: 420px;
    }

    .sidebar-alert {
        display: none;
    }

    @@media (max-width: 768px) {
        .module-list .list-group-item {
            align-items: flex-start;
        }

        .module-actions {
            width: 100%;
            justify-content: flex-end;
        }

        .category-block {
            margin: 0.75rem;
        }

        .search-sidebar-wrap {
            min-width: 100%;
            max-width: 100%;
        }
    }

    /* ============================================================
       FIX DRAG & DROP SORTABLE
    ============================================================ */

    .module-list .list-group-item {
        cursor: grab;
        user-select: none;
    }

        .module-list .list-group-item:active {
            cursor: grabbing;
        }

    .module-actions,
    .module-actions button {
        cursor: pointer;
    }

    .sortable-chosen {
        background: rgba(122,11,11,0.08) !important;
        border-color: var(--brand-main) !important;
    }

    .sortable-drag {
        opacity: 0.95;
        box-shadow: var(--kpi-shadow-strong);
    }

    .sortable-ghost {
        opacity: 0.45;
        background: rgba(122,11,11,0.12) !important;
        border: 1px dashed var(--brand-main) !important;
    }

    body[data-theme="dark"] .sortable-chosen,
    body[data-theme="dark"] .sortable-ghost {
        background: rgba(248,113,113,0.18) !important;
        border-color: rgba(248,113,113,0.45) !important;
    }

</style>

<div class="container-fluid py-4 px-3 px-md-4 container-custom sidebar-admin-page">

    <div class="top-banner d-flex justify-content-between align-items-center flex-wrap gap-3 shadow-sm">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-ui-checks-grid me-2"></i> Administración del Sidebar
            </h2>
            <p class="mb-0" style="font-size: 0.85rem; opacity: 0.85;">
                Agrega, edita, elimina y ordena los módulos visibles en el menú lateral del sistema.
            </p>
        </div>

        <div>
            <a class="btn btn-sm btn-outline-light fw-bold px-3 border-2" href="@Url.Action("Inicio", "Home")">
                <i class="bi bi-arrow-left-circle me-1"></i> Volver al inicio
            </a>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-3 mb-4">

        <div class="action-group shadow-sm">
            <div class="action-label">
                <i class="bi bi-sliders me-1"></i> Acciones
            </div>

            <div class="d-flex gap-2">
                <button class="btn-rojo" type="button" onclick="document.getElementById('formModulo').scrollIntoView({ behavior: 'smooth', block: 'start' })">
                    <i class="bi bi-plus-circle"></i> Crear módulo
                </button>

                <button type="button" class="btn-rojo" onclick="location.href='@Url.Action("Categorias", "Sidebar")'">
                    <i class="bi bi-folder-plus"></i> Categorías
                </button>

                <button type="button" class="btn-rojo" onclick="location.reload()">
                    <i class="bi bi-arrow-clockwise"></i> Refrescar
                </button>
            </div>
        </div>

        <div class="action-group shadow-sm">
            <div class="action-label">
                <i class="bi bi-shield-check me-1"></i> Permisos
            </div>

            <div class="d-flex gap-2">
                <a class="btn-rojo" href="@Url.Action("AdminSidebar", "SidebarAdmin")">
                    <i class="bi bi-file-earmark-medical-fill"></i> Otorgar vistas
                </a>
            </div>
        </div>

        <div class="action-group shadow-sm">
            <div class="action-label">
                <i class="bi bi-search me-1"></i> Buscar
            </div>

            <div class="search-sidebar-wrap">
                <div class="input-group input-group-sm">
                    <span class="input-group-text">
                        <i class="bi bi-funnel"></i>
                    </span>
                    <input id="searchSidebar"
                           type="search"
                           class="form-control"
                           placeholder="Buscar módulo, categoría o URL..." />
                </div>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <div class="stat-card">
                <div class="stat-label">Categorías</div>
                <div class="stat-value">@totalCategorias</div>
            </div>

            <div class="stat-card">
                <div class="stat-label">Módulos</div>
                <div class="stat-value">@totalModulos</div>
            </div>

            <div class="stat-card">
                <div class="stat-label">Padres</div>
                <div class="stat-value">@totalPadres</div>
            </div>

            <div class="stat-card">
                <div class="stat-label">Submódulos</div>
                <div class="stat-value">@totalHijos</div>
            </div>
        </div>

    </div>

    <div id="sidebarAlert" class="alert sidebar-alert"></div>

    <div class="dashboard-panel mb-4">
        <div class="dashboard-panel-head">
            <div>
                <h6 class="dashboard-panel-title">
                    <i class="bi bi-pencil-square me-1"></i> Crear nuevo módulo
                </h6>
                <p class="dashboard-panel-subtitle">
                    Registra módulos principales o submódulos asociados a una categoría.
                </p>
            </div>
        </div>

        <div class="p-3 p-md-4">
            <form id="formModulo">
                @Html.AntiForgeryToken()

                <div class="sidebar-form-panel">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-muted small">NOMBRE DEL MÓDULO O SUBMÓDULO</label>
                            <input type="text"
                                   id="nombre"
                                   class="form-control"
                                   placeholder="Ej. Reportes de calidad"
                                   required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold text-muted small">ÍCONO FONT AWESOME</label>
                            <input type="text"
                                   id="icono"
                                   class="form-control"
                                   placeholder="fas fa-box" />
                            <small class="text-muted">Ejemplo: <code>fas fa-box</code>, <code>bi bi-grid</code></small>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold text-muted small">URL OPCIONAL</label>
                            <input type="text"
                                   id="url"
                                   class="form-control"
                                   placeholder="/Controlador/Accion" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold text-muted small">CATEGORÍA</label>
                            <select id="categoriaId" class="form-select">
                                <option value="">(Sin categoría)</option>

                                @foreach (var c in Model.CategoriasExistentes)
                                {
                                    <option value="@c.Id">@c.Nombre</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold text-muted small">MÓDULO PADRE</label>
                            <select id="padreId" class="form-select">
                                <option value="">(Ninguno, será módulo principal)</option>

                                @foreach (var m in Model.ModulosExistentes)
                                {
                                    <option value="@m.Id">@m.Nombre</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-6 d-flex align-items-end justify-content-md-end">
                            <button type="submit" class="btn btn-brand fw-bold px-4">
                                <i class="bi bi-save me-1"></i> Guardar módulo
                            </button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="dashboard-panel mb-4">
        <div class="dashboard-panel-head">
            <div>
                <h6 class="dashboard-panel-title">
                    <i class="bi bi-list-nested me-1"></i> Orden global de módulos principales
                </h6>
                <p class="dashboard-panel-subtitle">
                    Arrastra los módulos padres para definir su posición principal en el sidebar.
                </p>
            </div>
        </div>

        <div class="p-3">
            <ul class="list-group list-group-flush module-list lista-padres" id="lista-padres-global">
                @foreach (var padre in Model.ModulosExistentes
                                .Where(m => m.PadreId == null)
                                .OrderBy(m => m.Orden))
                {
                    <li class="list-group-item sidebar-search-item" data-id="@padre.Id">
                        <div class="module-main">
                            <div class="module-icon">
                                <i class="@padre.Icono"></i>
                            </div>

                            <div>
                                <p class="module-title">@padre.Nombre</p>
                                <p class="module-url">
                                    @(string.IsNullOrWhiteSpace(padre.Url) ? "(sin URL)" : padre.Url)
                                </p>
                            </div>
                        </div>

                        <div class="module-actions">
                            <button type="button"
                                    class="btn btn-sm btn-outline-primary fw-bold"
                                    onclick="location.href='@Url.Action("EditarModulo", "Sidebar")?id=@padre.Id'">
                                <i class="bi bi-pencil-square"></i>
                            </button>

                            <button type="button"
                                    class="btn btn-sm btn-outline-danger fw-bold btn-eliminar"
                                    data-id="@padre.Id">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </li>
                }
            </ul>
        </div>
    </div>

    <div class="dashboard-panel">
        <div class="dashboard-panel-head">
            <div>
                <h6 class="dashboard-panel-title">
                    <i class="bi bi-diagram-3 me-1"></i> Organización por categoría
                </h6>
                <p class="dashboard-panel-subtitle">
                    Consulta y ordena módulos principales y submódulos dentro de cada categoría.
                </p>
            </div>
        </div>

        @{
            var grupos = Model.ModulosExistentes
            .GroupBy(m => m.CategoriaId)
            .OrderBy(g => g.Key ?? int.MaxValue);
        }

        @foreach (var grupo in grupos)
        {
            var categoria = Model.CategoriasExistentes.FirstOrDefault(c => c.Id == grupo.Key);
            string nombreCategoria = categoria?.Nombre ?? "Sin Categoría";
            string iconoCategoria = categoria?.Icono ?? "bi bi-folder";
            string categoriaKey = grupo.Key?.ToString() ?? "sin_categoria";

            var padres = grupo.Where(m => m.PadreId == null).OrderBy(m => m.Orden).ToList();
            var hijos = grupo.Where(m => m.PadreId != null).OrderBy(m => m.Orden).ToList();
            var totalGrupo = padres.Count + hijos.Count;

            <div class="category-block sidebar-search-block">
                <div class="category-head">
                    <h6 class="category-title">
                        <i class="@iconoCategoria"></i> @nombreCategoria
                    </h6>

                    <span class="category-count">
                        <i class="bi bi-boxes"></i> @totalGrupo elementos
                    </span>
                </div>

                <div class="category-body">
                    <div class="mb-3">
                        <p class="section-label">
                            <i class="bi bi-folder2-open"></i> Módulos principales
                        </p>

                        @if (!padres.Any())
                        {
                            <div class="empty-mini">
                                No hay módulos principales en esta categoría.
                            </div>
                        }
                        else
                        {
                            <ul class="list-group list-group-flush module-list lista-padres" id="padres-@categoriaKey">
                                @foreach (var modulo in padres)
                                {
                                    <li class="list-group-item sidebar-search-item" data-id="@modulo.Id">
                                        <div class="module-main">
                                            <div class="module-icon">
                                                <i class="@modulo.Icono"></i>
                                            </div>

                                            <div>
                                                <p class="module-title">@modulo.Nombre</p>
                                                <p class="module-url">
                                                    @(string.IsNullOrWhiteSpace(modulo.Url) ? "(sin URL)" : modulo.Url)
                                                </p>
                                            </div>
                                        </div>

                                        <div class="module-actions">
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary fw-bold"
                                                    onclick="location.href='@Url.Action("EditarModulo", "Sidebar")?id=@modulo.Id'">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger fw-bold btn-eliminar"
                                                    data-id="@modulo.Id">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                    </div>

                    <div>
                        <p class="section-label">
                            <i class="bi bi-node-plus"></i> Submódulos
                        </p>

                        @if (!hijos.Any())
                        {
                            <div class="empty-mini">
                                No hay submódulos en esta categoría.
                            </div>
                        }
                        else
                        {
                            <ul class="list-group list-group-flush module-list lista-hijos" id="hijos-@categoriaKey">
                                @foreach (var modulo in hijos)
                                {
                                    <li class="list-group-item sidebar-search-item" data-id="@modulo.Id">
                                        <div class="module-main">
                                            <div class="module-icon">
                                                <i class="@modulo.Icono"></i>
                                            </div>

                                            <div>
                                                <p class="module-title">@modulo.Nombre</p>
                                                <p class="module-url">
                                                    @(string.IsNullOrWhiteSpace(modulo.Url) ? "(sin URL)" : modulo.Url)
                                                </p>
                                            </div>
                                        </div>

                                        <div class="module-actions">
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-primary fw-bold"
                                                    onclick="location.href='@Url.Action("EditarModulo", "Sidebar")?id=@modulo.Id'">
                                                <i class="bi bi-pencil-square"></i>
                                            </button>

                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger fw-bold btn-eliminar"
                                                    data-id="@modulo.Id">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

    <script>
        const tokenSidebar = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        function mostrarSidebarAlert(mensaje, tipo = "info") {
            const alert = document.getElementById("sidebarAlert");
            if (!alert) return;

            const icono = tipo === "danger"
                ? "bi-exclamation-triangle-fill"
                : tipo === "success"
                    ? "bi-check-circle-fill"
                    : "bi-info-circle-fill";

            alert.className = `alert alert-${tipo} sidebar-alert`;
            alert.innerHTML = `<i class="bi ${icono} me-2"></i>${mensaje}`;
            alert.style.display = "block";

            setTimeout(() => {
                alert.style.display = "none";
            }, 3500);
        }

        document.getElementById("formModulo").addEventListener("submit", async e => {
            e.preventDefault();

            const data = {
                Nombre: document.getElementById("nombre").value,
                Icono: document.getElementById("icono").value,
                Url: document.getElementById("url").value,
                PadreId: document.getElementById("padreId").value || null,
                CategoriaId: document.getElementById("categoriaId").value || null
            };

            try {
                const res = await fetch("/Sidebar/CrearModulo", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "RequestVerificationToken": tokenSidebar || ""
                    },
                    body: JSON.stringify(data)
                });

                const result = await res.json();

                if (!res.ok) {
                    mostrarSidebarAlert(result.mensaje || "No se pudo guardar el módulo.", "danger");
                    return;
                }

                mostrarSidebarAlert(result.mensaje || "Módulo guardado correctamente.", "success");

                setTimeout(() => {
                    location.reload();
                }, 650);
            }
            catch (error) {
                console.error(error);
                mostrarSidebarAlert("Ocurrió un error al guardar el módulo.", "danger");
            }
        });

        function inicializarEliminar() {
            document.querySelectorAll(".btn-eliminar").forEach(btn => {
                btn.addEventListener("click", async () => {
                    const li = btn.closest("li");
                    const id = li.dataset.id;
                    const nombre = li.querySelector(".module-title")?.innerText || "este módulo";

                    if (!confirm(`¿Seguro que deseas eliminar el módulo "${nombre}"?`)) return;

                    try {
                        const res = await fetch(`/Sidebar/EliminarModulo?id=${id}`, {
                            method: "POST",
                            headers: {
                                "RequestVerificationToken": tokenSidebar || ""
                            }
                        });

                        const result = await res.json();

                        if (!res.ok) {
                            mostrarSidebarAlert(result.mensaje || "No se pudo eliminar el módulo.", "danger");
                            return;
                        }

                        mostrarSidebarAlert(result.mensaje || "Módulo eliminado correctamente.", "success");

                        li.style.transition = "opacity .25s ease, transform .25s ease";
                        li.style.opacity = "0";
                        li.style.transform = "translateX(20px)";

                        setTimeout(() => {
                            li.remove();
                        }, 250);
                    }
                    catch (error) {
                        console.error(error);
                        mostrarSidebarAlert("Ocurrió un error al eliminar el módulo.", "danger");
                    }
                });
            });
        }

        inicializarEliminar();



        function inicializarSortableSidebar() {
            if (typeof Sortable === "undefined") {
                console.error("SortableJS no está cargado. Revisa que el script de Sortable exista en la vista o en el Layout.");
                mostrarSidebarAlert("No se pudo activar el arrastre: SortableJS no está cargado.", "danger");
                return;
            }

            const listasOrdenables = document.querySelectorAll(
                "#lista-padres-global, .category-block .lista-padres, .category-block .lista-hijos"
            );

            listasOrdenables.forEach(lista => {
                if (!lista || lista.dataset.sortableReady === "1") return;

                lista.dataset.sortableReady = "1";

                new Sortable(lista, {
                    animation: 150,
                    ghostClass: "sortable-ghost",
                    chosenClass: "sortable-chosen",
                    dragClass: "sortable-drag",
                    forceFallback: true,
                    fallbackOnBody: true,
                    swapThreshold: 0.65,

                    // Evita que al presionar editar/eliminar intente arrastrar
                    filter: "button, a, input, select, textarea",
                    preventOnFilter: false,

                    onEnd: async function () {
                        const nuevoOrden = Array.from(lista.querySelectorAll("li[data-id]"))
                            .map(li => parseInt(li.dataset.id))
                            .filter(id => !isNaN(id));

                        if (!nuevoOrden.length) {
                            mostrarSidebarAlert("No se encontraron módulos para ordenar.", "danger");
                            return;
                        }

                        try {
                            const res = await fetch("@Url.Action("ActualizarOrden", "Sidebar")", {
                                method: "POST",
                                headers: {
                                    "Content-Type": "application/json",
                                    "RequestVerificationToken": tokenSidebar || ""
                                },
                                body: JSON.stringify(nuevoOrden)
                            });

                            const result = await res.json();

                            console.log(`[${lista.id}] ->`, result);

                            if (res.ok) {
                                const esGlobal = lista.id === "lista-padres-global";
                                mostrarSidebarAlert(
                                    esGlobal
                                        ? "Orden global actualizado correctamente."
                                        : "Orden actualizado correctamente.",
                                    "success"
                                );
                            } else {
                                mostrarSidebarAlert(result.mensaje || "No se pudo actualizar el orden.", "danger");
                            }
                        }
                        catch (error) {
                            console.error(error);
                            mostrarSidebarAlert("Error al actualizar el orden.", "danger");
                        }
                    }
                });
            });
        }

        document.addEventListener("DOMContentLoaded", inicializarSortableSidebar);

        const searchSidebar = document.getElementById("searchSidebar");

        searchSidebar?.addEventListener("input", () => {
            const txt = (searchSidebar.value || "").toLowerCase().trim();

            document.querySelectorAll(".sidebar-search-item").forEach(item => {
                const contenido = item.textContent.toLowerCase();
                item.style.display = !txt || contenido.includes(txt) ? "" : "none";
            });

            document.querySelectorAll(".sidebar-search-block").forEach(block => {
                const visibles = Array.from(block.querySelectorAll(".sidebar-search-item"))
                    .some(item => item.style.display !== "none");

                const contenidoBloque = block.textContent.toLowerCase();
                const coincideCategoria = !txt || contenidoBloque.includes(txt);

                block.style.display = visibles || coincideCategoria ? "" : "none";
            });
        });
    </script>
}