@model Plataforma_CG.Models.ViewModels.SidebarAdminViewModel
@using System.Linq

@{
    ViewBag.Title = "Administración del Sidebar";
    Layout = "~/Views/Shared/_Layout2.cshtml";

    var totalCategorias = Model.Categorias.Count;
    var totalPerfiles = Model.Perfiles.Count;
    var totalModulos = Model.Categorias.Sum(c => c.Modulos.Count);
    var totalSubmodulos = Model.Categorias.Sum(c => c.Modulos.Sum(m => m.Submodulos.Count));
}

@await Html.PartialAsync("_KpiAdminTheme")

<style>
    /* ============================================================
           SIDEBAR PERMISOS POR PERFIL - NUEVO DISEÑO
        ============================================================ */

    .sidebar-permisos-page .dashboard-panel {
        overflow: visible;
    }

    .perfil-select-wrap {
        min-width: 290px;
        max-width: 460px;
    }

    .perfil-select {
        font-weight: 800;
    }

    .sidebar-alert {
        display: none;
    }

    .permission-summary {
        display: none;
        background: var(--kpi-panel-soft);
        border: 1px solid var(--kpi-border);
        border-radius: 14px;
        padding: 1rem;
        margin-bottom: 1rem;
    }

        .permission-summary.active {
            display: block;
        }

    .permission-summary-title {
        color: var(--kpi-text-strong);
        font-weight: 900;
        margin: 0;
    }

    .permission-summary-sub {
        color: var(--kpi-text-muted);
        font-size: 0.82rem;
        margin: 0.25rem 0 0;
        font-weight: 700;
    }

    .permission-progress {
        width: 100%;
        height: 8px;
        border-radius: 999px;
        background: var(--kpi-card-bg);
        border: 1px solid var(--kpi-border);
        overflow: hidden;
        margin-top: 0.75rem;
    }

    .permission-progress-bar {
        height: 100%;
        width: 0%;
        border-radius: 999px;
        background: linear-gradient(90deg, var(--brand-main), #ef4444);
        transition: width .25s ease;
    }

    .categoria-card {
        border: 1px solid var(--kpi-border);
        border-radius: 16px;
        background: var(--kpi-card-bg);
        color: var(--kpi-text);
        margin-bottom: 0.9rem;
        box-shadow: var(--kpi-shadow);
        overflow: hidden;
        transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease;
    }

        .categoria-card:hover {
            border-color: var(--kpi-border-strong);
            box-shadow: var(--kpi-shadow-strong);
            transform: translateY(-1px);
        }

    .categoria-header {
        padding: 1rem 1.15rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        background: var(--kpi-card-bg);
    }

    .categoria-main {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        min-width: 0;
    }

    .categoria-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(122, 11, 11, 0.10);
        color: var(--brand-main);
        border: 1px solid rgba(122, 11, 11, 0.18);
        flex-shrink: 0;
    }

    body[data-theme="dark"] .categoria-icon {
        background: rgba(248,113,113,0.12);
        color: #fca5a5;
        border-color: rgba(248,113,113,0.30);
    }

    .categoria-title {
        color: var(--kpi-text-strong);
        font-weight: 900;
        line-height: 1.15;
        margin: 0;
        word-break: break-word;
    }

    .categoria-sub {
        color: var(--kpi-text-muted);
        font-size: 0.78rem;
        margin: 0.25rem 0 0;
        font-weight: 700;
    }

    .categoria-actions {
        display: flex;
        align-items: center;
        gap: 0.7rem;
        flex-shrink: 0;
    }

    .categoria-count {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        border-radius: 999px;
        padding: 0.32rem 0.65rem;
        font-size: 0.74rem;
        font-weight: 900;
        background: rgba(122,11,11,0.08);
        color: var(--brand-main);
        border: 1px solid rgba(122,11,11,0.18);
        white-space: nowrap;
    }

    body[data-theme="dark"] .categoria-count {
        background: rgba(248,113,113,0.12);
        color: #fecaca;
        border-color: rgba(248,113,113,0.30);
    }

    .categoria-chevron {
        color: var(--kpi-text-muted);
        transition: transform .2s ease, color .2s ease;
        font-weight: 900;
    }

    .categoria-card.active .categoria-chevron {
        transform: rotate(90deg);
        color: var(--brand-main);
    }

    body[data-theme="dark"] .categoria-card.active .categoria-chevron {
        color: #fca5a5;
    }

    .modulos-panel {
        background: var(--kpi-panel-soft);
        max-height: 0;
        overflow: hidden;
        transition: max-height .35s ease;
        border-top: 1px solid transparent;
    }

    .categoria-card.active .modulos-panel {
        max-height: 99999px;
        border-top-color: var(--kpi-border);
    }

    .modulos-panel-inner {
        padding: 1rem;
    }

    .modulo-item {
        background: var(--kpi-card-bg);
        border: 1px solid var(--kpi-border);
        border-radius: 12px;
        padding: 0.75rem 0.9rem;
        margin-bottom: 0.65rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 0.9rem;
        transition: border-color .2s ease, box-shadow .2s ease, background-color .2s ease, transform .2s ease;
    }

        .modulo-item:hover {
            border-color: var(--kpi-border-strong);
            box-shadow: var(--kpi-shadow);
            transform: translateY(-1px);
        }

        .modulo-item.active {
            border-color: var(--kpi-active-border);
            background: var(--kpi-active-bg);
        }

    .modulo-left {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        min-width: 0;
        flex: 1;
    }

    .permiso-checkbox {
        transform: scale(1.22);
        accent-color: var(--brand-main);
        flex-shrink: 0;
    }

    body[data-theme="dark"] .permiso-checkbox {
        accent-color: #ef4444;
    }

    .modulo-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(122, 11, 11, 0.08);
        color: var(--brand-main);
        border: 1px solid rgba(122, 11, 11, 0.14);
        flex-shrink: 0;
    }

    body[data-theme="dark"] .modulo-icon {
        background: rgba(248,113,113,0.10);
        color: #fca5a5;
        border-color: rgba(248,113,113,0.25);
    }

    .modulo-label {
        cursor: pointer;
        min-width: 0;
        margin: 0;
    }

    .modulo-title {
        color: var(--kpi-text-strong);
        font-weight: 900;
        line-height: 1.15;
        margin: 0;
        word-break: break-word;
    }

    .modulo-url {
        color: var(--kpi-text-muted);
        font-size: 0.76rem;
        font-weight: 700;
        margin: 0.25rem 0 0;
        word-break: break-all;
    }

    .permiso-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        border-radius: 999px;
        padding: 0.28rem 0.6rem;
        font-size: 0.72rem;
        font-weight: 900;
        border: 1px solid var(--kpi-border);
        color: var(--kpi-text-muted);
        background: rgba(107,114,128,0.10);
        white-space: nowrap;
    }

    .modulo-item.active .permiso-pill {
        background: rgba(25,135,84,0.12);
        color: #198754;
        border-color: rgba(25,135,84,0.25);
    }

    body[data-theme="dark"] .modulo-item.active .permiso-pill {
        background: rgba(34,197,94,0.14);
        color: #bbf7d0;
        border-color: rgba(34,197,94,0.35);
    }

    .submodule-list {
        margin-left: 3.2rem;
        margin-top: -0.25rem;
        margin-bottom: 0.75rem;
        border-left: 2px dashed var(--kpi-border);
        padding-left: 0.9rem;
    }

        .submodule-list .modulo-item {
            margin-bottom: 0.45rem;
            padding: 0.62rem 0.8rem;
        }

        .submodule-list .modulo-icon {
            width: 32px;
            height: 32px;
            border-radius: 9px;
        }

    .select-empty-state {
        text-align: center;
        color: var(--kpi-text-muted);
        padding: 3rem 1rem;
    }

        .select-empty-state i {
            font-size: 2.2rem;
            display: block;
            margin-bottom: 0.75rem;
            opacity: 0.6;
        }

    .empty-filter-msg {
        display: none;
        text-align: center;
        color: var(--kpi-text-muted);
        padding: 1.5rem 1rem;
        border: 1px dashed var(--kpi-border);
        border-radius: 12px;
        background: var(--kpi-card-bg);
        font-weight: 700;
    }

    @@media (max-width: 768px) {
        .perfil-select-wrap {
            min-width: 100%;
            max-width: 100%;
        }

        .categoria-header {
            align-items: flex-start;
        }

        .categoria-actions {
            flex-direction: column;
            align-items: flex-end;
        }

        .modulo-item {
            align-items: flex-start;
            flex-direction: column;
        }

        .modulo-left {
            width: 100%;
        }

        .permiso-pill {
            margin-left: 2rem;
        }

        .submodule-list {
            margin-left: 1rem;
        }
    }
</style>

<div class="container-fluid py-4 px-3 px-md-4 container-custom sidebar-permisos-page">

    <div class="top-banner d-flex justify-content-between align-items-center flex-wrap gap-3 shadow-sm">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-menu-button-wide me-2"></i> Administración del Sidebar
            </h2>
            <p class="mb-0" style="font-size: 0.85rem; opacity: 0.85;">
                Gestiona qué módulos y submódulos son visibles para cada perfil del sistema.
            </p>
        </div>

        <div>
            <a class="btn btn-sm btn-outline-light fw-bold px-3 border-2" href="@Url.Action("Administrar", "Sidebar")">
                <i class="bi bi-arrow-left-circle me-1"></i> Volver a Sidebar
            </a>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-3 mb-4">

        <div class="action-group shadow-sm">
            <div class="action-label">
                <i class="bi bi-sliders me-1"></i> Acciones
            </div>

            <div class="d-flex gap-2">
                <button type="button" class="btn-rojo" onclick="guardarCambios()">
                    <i class="bi bi-save"></i> Guardar
                </button>

                <button type="button" class="btn-rojo" onclick="expandirTodos(true)">
                    <i class="bi bi-arrows-angle-expand"></i> Expandir
                </button>

                <button type="button" class="btn-rojo" onclick="expandirTodos(false)">
                    <i class="bi bi-arrows-angle-contract"></i> Colapsar
                </button>

                <button type="button" class="btn-rojo" onclick="location.href='/Home/Inicio'">
                    <i class="bi bi-door-closed"></i> Salir
                </button>
            </div>
        </div>

        <div class="action-group shadow-sm">
            <div class="action-label">
                <i class="bi bi-person-badge me-1"></i> Perfil
            </div>

            <div class="perfil-select-wrap">
                <select id="perfilSelect" class="form-select form-select-sm perfil-select" onchange="cargarPermisosPerfil()">
                    <option value="">-- Selecciona un perfil --</option>

                    @foreach (var perfil in Model.Perfiles)
                    {
                        <option value="@perfil.Id">@perfil.Nombre</option>
                    }
                </select>
            </div>
        </div>

        <div class="action-group shadow-sm">
            <div class="action-label">
                <i class="bi bi-search me-1"></i> Buscar
            </div>

            <div class="perfil-select-wrap">
                <div class="input-group input-group-sm">
                    <span class="input-group-text">
                        <i class="bi bi-funnel"></i>
                    </span>
                    <input id="searchModulo"
                           type="search"
                           class="form-control"
                           placeholder="Buscar módulo, submódulo o categoría..." />
                </div>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <div class="stat-card">
                <div class="stat-label">Perfiles</div>
                <div class="stat-value">@totalPerfiles</div>
            </div>

            <div class="stat-card">
                <div class="stat-label">Categorías</div>
                <div class="stat-value">@totalCategorias</div>
            </div>

            <div class="stat-card">
                <div class="stat-label">Módulos</div>
                <div class="stat-value">@totalModulos</div>
            </div>

            <div class="stat-card">
                <div class="stat-label">Submódulos</div>
                <div class="stat-value">@totalSubmodulos</div>
            </div>
        </div>

    </div>

    <div id="sidebarPermisosAlert" class="alert sidebar-alert"></div>

    <div class="permission-summary" id="permissionSummary">
        <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
            <div>
                <h6 class="permission-summary-title">
                    <i class="bi bi-shield-check me-1"></i>
                    Permisos del perfil seleccionado
                </h6>
                <p class="permission-summary-sub" id="permissionSummaryText">
                    Selecciona un perfil para cargar sus permisos.
                </p>
            </div>

            <span class="status-pill on" id="permissionCounter">
                <i class="bi bi-check-circle-fill"></i> 0 asignados
            </span>
        </div>

        <div class="permission-progress">
            <div class="permission-progress-bar" id="permissionProgressBar"></div>
        </div>
    </div>

    <div class="dashboard-panel">
        <div class="dashboard-panel-head">
            <div>
                <h6 class="dashboard-panel-title">
                    <i class="bi bi-diagram-3 me-1"></i> Asignar módulos a perfiles
                </h6>
                <p class="dashboard-panel-subtitle">
                    Marca o desmarca módulos; los cambios se guardan automáticamente.
                </p>
            </div>
        </div>

        <div class="p-3" id="selectProfileState">
            <div class="select-empty-state">
                <i class="bi bi-person-lines-fill"></i>
                <span class="fw-bold">Selecciona un perfil para comenzar.</span><br />
                <small>Después podrás activar o desactivar los módulos visibles para ese perfil.</small>
            </div>
        </div>

        <div class="p-3" id="modulosContainer" style="display:none;">

            @foreach (var categoria in Model.Categorias)
            {
                var totalItemsCategoria = categoria.Modulos.Count + categoria.Modulos.Sum(m => m.Submodulos.Count);

                <div class="categoria-card sidebar-search-block"
                     data-categoria="@categoria.Nombre.ToLowerInvariant()">

                    <div class="categoria-header">
                        <div class="categoria-main">
                            <div class="categoria-icon">
                                <i class="@categoria.Icono"></i>
                            </div>

                            <div>
                                <p class="categoria-title">@categoria.Nombre</p>
                                <p class="categoria-sub">Módulos disponibles para asignar</p>
                            </div>
                        </div>

                        <div class="categoria-actions">
                            <span class="categoria-count">
                                <i class="bi bi-boxes"></i> @totalItemsCategoria elementos
                            </span>

                            <span class="categoria-chevron">
                                <i class="bi bi-chevron-right"></i>
                            </span>
                        </div>
                    </div>

                    <div class="modulos-panel">
                        <div class="modulos-panel-inner">
                            @foreach (var modulo in categoria.Modulos)
                            {
                                <div class="modulo-item sidebar-search-item"
                                     data-moduloid="@modulo.Id"
                                     data-search="@($"{categoria.Nombre} {modulo.Nombre} {modulo.Url}".ToLowerInvariant())">

                                    <div class="modulo-left">
                                        <input type="checkbox"
                                               class="permiso-checkbox"
                                               id="chk-mod-@modulo.Id"
                                               data-moduloid="@modulo.Id" />

                                        <div class="modulo-icon">
                                            <i class="@modulo.Icono"></i>
                                        </div>

                                        <label class="modulo-label" for="chk-mod-@modulo.Id">
                                            <p class="modulo-title">@modulo.Nombre</p>
                                            <p class="modulo-url">
                                                @(string.IsNullOrWhiteSpace(modulo.Url) ? "(sin URL)" : modulo.Url)
                                            </p>
                                        </label>
                                    </div>

                                    <span class="permiso-pill">
                                        <i class="bi bi-circle"></i> Disponible
                                    </span>
                                </div>

                                @if (modulo.Submodulos != null && modulo.Submodulos.Any())
                                {
                                    <div class="submodule-list">
                                        @foreach (var sub in modulo.Submodulos)
                                        {
                                            <div class="modulo-item sidebar-search-item"
                                                 data-moduloid="@sub.Id"
                                                 data-search="@($"{categoria.Nombre} {modulo.Nombre} {sub.Nombre} {sub.Url}".ToLowerInvariant())">

                                                <div class="modulo-left">
                                                    <input type="checkbox"
                                                           class="permiso-checkbox"
                                                           id="chk-mod-@sub.Id"
                                                           data-moduloid="@sub.Id" />

                                                    <div class="modulo-icon">
                                                        <i class="@sub.Icono"></i>
                                                    </div>

                                                    <label class="modulo-label" for="chk-mod-@sub.Id">
                                                        <p class="modulo-title">@sub.Nombre</p>
                                                        <p class="modulo-url">
                                                            @(string.IsNullOrWhiteSpace(sub.Url) ? "(sin URL)" : sub.Url)
                                                        </p>
                                                    </label>
                                                </div>

                                                <span class="permiso-pill">
                                                    <i class="bi bi-circle"></i> Disponible
                                                </span>
                                            </div>
                                        }
                                    </div>
                                }
                            }

                            <div class="empty-filter-msg">
                                <i class="bi bi-search me-1"></i>
                                No hay módulos que coincidan con la búsqueda.
                            </div>
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

    <script>
        const totalPermisosDisponibles = document.querySelectorAll(".permiso-checkbox").length;

        function mostrarSidebarPermisosAlert(mensaje, tipo = "info") {
            const alert = document.getElementById("sidebarPermisosAlert");
            if (!alert) return;

            const icono = tipo === "danger"
                ? "bi-exclamation-triangle-fill"
                : tipo === "success"
                    ? "bi-check-circle-fill"
                    : "bi-info-circle-fill";

            alert.className = `alert alert-${tipo} sidebar-alert`;
            alert.innerHTML = `<i class="bi ${icono} me-2"></i>${mensaje}`;
            alert.style.display = "block";

            setTimeout(() => {
                alert.style.display = "none";
            }, 3200);
        }

        document.querySelectorAll(".categoria-header").forEach(header => {
            header.addEventListener("click", () => {
                const card = header.closest(".categoria-card");
                const active = card.classList.contains("active");

                document.querySelectorAll(".categoria-card").forEach(c => c.classList.remove("active"));

                if (!active) {
                    card.classList.add("active");
                }

                aplicarFiltroModulo();
            });
        });

        function expandirTodos(expand) {
            document.querySelectorAll(".categoria-card").forEach(c => {
                c.classList.toggle("active", !!expand);
            });

            aplicarFiltroModulo();
        }

        function actualizarResumenPermisos() {
            const perfilSelect = document.getElementById("perfilSelect");
            const perfilNombre = perfilSelect.options[perfilSelect.selectedIndex]?.text || "";
            const summary = document.getElementById("permissionSummary");
            const summaryText = document.getElementById("permissionSummaryText");
            const counter = document.getElementById("permissionCounter");
            const bar = document.getElementById("permissionProgressBar");

            const asignados = document.querySelectorAll(".permiso-checkbox:checked").length;
            const porcentaje = totalPermisosDisponibles === 0
                ? 0
                : Math.round((asignados * 100) / totalPermisosDisponibles);

            if (summary) {
                summary.classList.add("active");
            }

            if (summaryText) {
                summaryText.textContent = `${perfilNombre}: ${asignados} de ${totalPermisosDisponibles} módulos/submódulos asignados.`;
            }

            if (counter) {
                counter.innerHTML = `<i class="bi bi-check-circle-fill"></i> ${asignados} asignados`;
            }

            if (bar) {
                bar.style.width = `${porcentaje}%`;
            }
        }

        function setModuloActivo(checkbox, activo) {
            checkbox.checked = activo;

            const item = checkbox.closest(".modulo-item");
            const pill = item?.querySelector(".permiso-pill");

            item?.classList.toggle("active", activo);

            if (pill) {
                pill.innerHTML = activo
                    ? `<i class="bi bi-check-circle"></i> Asignado`
                    : `<i class="bi bi-circle"></i> Disponible`;
            }
        }

        async function cargarPermisosPerfil() {
            const perfilId = document.getElementById("perfilSelect").value;
            const modulosContainer = document.getElementById("modulosContainer");
            const emptyState = document.getElementById("selectProfileState");
            const summary = document.getElementById("permissionSummary");

            if (!perfilId) {
                modulosContainer.style.display = "none";
                emptyState.style.display = "block";
                summary.classList.remove("active");
                return;
            }

            try {
                const resp = await fetch(`/SidebarAdmin/GetPermisosPerfil?perfilId=${perfilId}`);

                if (!resp.ok) {
                    throw new Error("No se pudieron cargar los permisos.");
                }

                const permisos = await resp.json();

                emptyState.style.display = "none";
                modulosContainer.style.display = "block";

                document.querySelectorAll(".permiso-checkbox").forEach(chk => {
                    const modId = parseInt(chk.dataset.moduloid);
                    const activo = permisos.includes(modId);

                    setModuloActivo(chk, activo);

                    chk.onchange = () => togglePermiso(perfilId, modId, chk);
                });

                const primeraCategoria = document.querySelector(".categoria-card");

                if (primeraCategoria && !document.querySelector(".categoria-card.active")) {
                    primeraCategoria.classList.add("active");
                }

                actualizarResumenPermisos();
                aplicarFiltroModulo();
                mostrarSidebarPermisosAlert("Permisos cargados correctamente.", "success");
            }
            catch (error) {
                console.error(error);
                mostrarSidebarPermisosAlert("No se pudieron cargar los permisos del perfil.", "danger");
            }
        }

        async function togglePermiso(perfilId, moduloId, checkbox) {
            const activo = checkbox.checked;

            setModuloActivo(checkbox, activo);
            actualizarResumenPermisos();

            try {
                const resp = await fetch('/SidebarAdmin/TogglePermiso', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        perfilId: parseInt(perfilId),
                        moduloId: parseInt(moduloId),
                        activo: activo
                    })
                });

                if (!resp.ok) {
                    throw new Error("No se pudo actualizar el permiso.");
                }

                mostrarSidebarPermisosAlert(
                    activo ? "Permiso asignado correctamente." : "Permiso revocado correctamente.",
                    "success"
                );
            }
            catch (error) {
                console.error(error);

                setModuloActivo(checkbox, !activo);
                actualizarResumenPermisos();

                mostrarSidebarPermisosAlert("No se pudo actualizar el permiso.", "danger");
            }
        }

        function guardarCambios() {
            const perfilId = document.getElementById("perfilSelect").value;

            if (!perfilId) {
                mostrarSidebarPermisosAlert("Primero selecciona un perfil.", "danger");
                return;
            }

            const btn = document.querySelector(".action-group .btn-rojo");

            if (btn) {
                const original = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = `<i class="bi bi-check-circle"></i> Guardado`;

                setTimeout(() => {
                    btn.disabled = false;
                    btn.innerHTML = original;
                }, 900);
            }

            mostrarSidebarPermisosAlert("Los permisos se guardan automáticamente al marcar o desmarcar módulos.", "info");
        }

        const searchModulo = document.getElementById("searchModulo");

        function aplicarFiltroModulo() {
            const txt = (searchModulo?.value || "").toLowerCase().trim();

            document.querySelectorAll(".sidebar-search-item").forEach(item => {
                const contenido = item.getAttribute("data-search") || item.textContent.toLowerCase();
                item.style.display = !txt || contenido.includes(txt) ? "" : "none";
            });

            document.querySelectorAll(".categoria-card").forEach(card => {
                const categoria = card.getAttribute("data-categoria") || "";
                const coincideCategoria = !txt || categoria.includes(txt);

                const visibles = Array.from(card.querySelectorAll(".sidebar-search-item"))
                    .some(item => item.style.display !== "none");

                const mostrarCategoria = coincideCategoria || visibles || !txt;

                card.style.display = mostrarCategoria ? "" : "none";

                const emptyMsg = card.querySelector(".empty-filter-msg");

                if (emptyMsg) {
                    emptyMsg.style.display = !visibles && txt ? "block" : "none";
                }

                if (txt && mostrarCategoria) {
                    card.classList.add("active");
                }
            });
        }

        searchModulo?.addEventListener("input", aplicarFiltroModulo);
    </script>
}