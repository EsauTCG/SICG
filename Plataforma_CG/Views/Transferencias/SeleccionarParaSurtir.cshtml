@model Plataforma_CG.ViewModels.SeleccionarTransferenciaVM
@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
}

<link rel="stylesheet" href="~/css/seleccionar-transferencia-grid.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/seleccionar-transferencia-erp.css" asp-append-version="true" />


<style>
    /* =========================================================
       FIX MÓVIL - ALINEAR VISTA A LA IZQUIERDA
       No agrega barra de progreso ni cambia funcionalidad.
       ========================================================= */
    @@media (max-width: 768px) {

        body:has(.transferencias-seleccion-app) .layout-main-content,
        body:has(.transferencias-seleccion-app) .layout-main-content.layout-sidebar-open,
        body:has(.layout-sidebar.layout-hidden):has(.transferencias-seleccion-app) .layout-main-content,
        body:has(.layout-sidebar.layout-hidden):has(.transferencias-seleccion-app) .layout-main-content.layout-sidebar-open {
            width: 100% !important;
            max-width: 100% !important;
            margin-left: 0 !important;
            transform: none !important;
            padding-left: 4px !important;
            padding-right: 4px !important;
            overflow-x: hidden !important;
            box-sizing: border-box !important;
        }

        body:has(.transferencias-seleccion-app) .layout-main-content .layout-container-fluid,
        body:has(.layout-sidebar.layout-hidden):has(.transferencias-seleccion-app) .layout-main-content .layout-container-fluid {
            width: 100% !important;
            max-width: 100% !important;
            margin-left: 0 !important;
            margin-right: 0 !important;
            padding-left: 0 !important;
            padding-right: 0 !important;
            box-sizing: border-box !important;
        }

        .transferencias-seleccion-app.window,
        body:not([data-theme="dark"]) .transferencias-seleccion-app.window {
            width: 100% !important;
            max-width: 100% !important;
            margin-left: 0 !important;
            margin-right: 0 !important;
        }

        .transferencias-seleccion-app .content,
        .transferencias-seleccion-app .workspace,
        .transferencias-seleccion-app .section,
        .transferencias-seleccion-app .mobile-cards {
            width: 100% !important;
            max-width: 100% !important;
            margin-left: 0 !important;
            margin-right: 0 !important;
            box-sizing: border-box !important;
        }
    }
</style>

<div class="window transferencias-seleccion-app">

    <div class="titlebar">
        <div class="transfer-title">
            <i class="bi bi-arrow-left-right"></i>
            Seleccionar Transferencia :: SIGO
        </div>

        <div class="actions">
            <div class="win-btn"></div>
            <div class="win-btn"></div>
            <div class="win-btn"></div>
        </div>
    </div>

    <div class="toolbar"></div>

    <div class="content">
        <div class="workspace">

            <div class="section filter-section">
                <div class="section-title">
                    <i class="bi bi-funnel"></i>
                    Filtros de búsqueda
                </div>

                <form id="frmBuscar"
                      method="get"
                      action="/Transferencias/SeleccionarParaSurtir">

                    <div class="filters">
                        <div class="filter-input-wrap">
                            <i class="bi bi-search filter-search-icon"></i>

                            <input name="buscar"
                                   value="@Model.Buscar"
                                   placeholder="Buscar por folio, sucursal u observación..."
                                   autocomplete="off" />
                        </div>

                        <div>
                            <button class="pm-btn pm-btn-primary"
                                    type="submit">
                                <i class="bi bi-search"></i>
                                Buscar
                            </button>
                        </div>
                    </div>
                </form>
            </div>

            <div class="section results-section">

                @if (!Model.Resultados.Any())
                {
                    <div class="no-results">
                        <div class="no-results-icon">
                            <i class="bi bi-inbox"></i>
                        </div>
                        <strong>No hay transferencias registradas</strong>
                        <span>Prueba cambiando el texto de búsqueda.</span>
                    </div>
                }
                else
                {
                    <div class="results-head">
                        <div>
                            <strong>Transferencias disponibles</strong>
                            <small>Selecciona una transferencia para comenzar el surtido.</small>
                        </div>

                        <span class="results-count">
                            <i class="bi bi-list-check"></i>
                            @Model.Resultados.Count registro(s)
                        </span>
                    </div>

                    <!-- Desktop -->
                    <div class="table-wrap desktop-table">
                        <table class="tbl-sel">
                            <thead>
                                <tr>
                                    <th>Folio</th>
                                    <th>Sucursal</th>
                                    <th>Fecha</th>
                                    <th class="text-center">Estatus</th>
                                    <th class="text-end">Acción</th>
                                </tr>
                            </thead>

                            <tbody>
                                @foreach (var t in Model.Resultados)
                                {
                                    <tr>
                                        <td>
                                            <span class="folio-cell">
                                                <i class="bi bi-file-earmark-text"></i>
                                                <b>@t.Consecutivo</b>
                                            </span>
                                        </td>

                                        <td title="@t.SucursalNombre">
                                            <span class="sucursal-cell">
                                                <i class="bi bi-building"></i>
                                                @t.SucursalNombre
                                            </span>
                                        </td>

                                        <td>
                                            <span class="fecha-cell">
                                                <i class="bi bi-calendar3"></i>
                                                @(t.FechaSolicitud?.ToString("yyyy-MM-dd") ?? "")
                                            </span>
                                        </td>

                                        <td class="text-center">
                                            <span class="badge-est">
                                                <i class="bi bi-check-circle"></i>
                                                Registrada
                                            </span>
                                        </td>

                                        <td class="text-end">
                                            <a class="pm-btn pm-btn-success btn-surtir"
                                               href="/Transferencias/OTransferencia?id=@t.Id"
                                               data-btn-surtir="@t.Id">
                                                <i class="bi bi-box-arrow-right"></i>
                                                <span>Surtir</span>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- Móvil -->
                    <div class="mobile-cards">
                        @foreach (var t in Model.Resultados)
                        {
                            <div class="tr-card">

                                <div class="tr-card-head">
                                    <div>
                                        <small>Folio</small>
                                        <span class="tr-card-folio">
                                            @t.Consecutivo
                                        </span>
                                    </div>

                                    <span class="badge-est">
                                        <i class="bi bi-check-circle"></i>
                                        Registrada
                                    </span>
                                </div>

                                <div class="tr-card-info">
                                    <div class="tr-info-row">
                                        <span class="tr-info-icon">
                                            <i class="bi bi-building"></i>
                                        </span>

                                        <div>
                                            <small>Sucursal</small>
                                            <strong>@t.SucursalNombre</strong>
                                        </div>
                                    </div>

                                    <div class="tr-info-row">
                                        <span class="tr-info-icon">
                                            <i class="bi bi-calendar3"></i>
                                        </span>

                                        <div>
                                            <small>Fecha</small>
                                            <strong>
                                                @(t.FechaSolicitud?.ToString("yyyy-MM-dd") ?? "")
                                            </strong>
                                        </div>
                                    </div>
                                </div>

                                <a class="pm-btn pm-btn-success btn-surtir-mobile"
                                   href="/Transferencias/OTransferencia?id=@t.Id"
                                   data-btn-surtir="@t.Id">
                                    <i class="bi bi-box-arrow-right"></i>
                                    <span>Surtir transferencia</span>
                                </a>

                            </div>
                        }
                    </div>
                }
            </div>

        </div>
    </div>

    <div class="statusbar">
        <div>
            <i class="bi bi-circle-fill status-dot"></i>
            Registro listo
        </div>

        <div>
            <i class="bi bi-person"></i>
            Usuario: @User.Identity.Name
        </div>

        <div>
            <i class="bi bi-building"></i>
            Empresa: Carnes G SA de CV
        </div>

        <div>
            <i class="bi bi-arrow-left-right"></i>
            Módulo: Transferencias
        </div>
    </div>

</div>

<script>
(function () {
    let refrescando = false;
    let ultimoEstado = null;

    // estado por transferenciaId: 'procesando' | 'error' | null
    const estadosBotones = {};

    function actualizarBotones(jobs) {
        // Resetear todos primero
        document.querySelectorAll('[data-btn-surtir]').forEach(btn => {
            const id = parseInt(btn.dataset.btnSurtir);
            const job = (jobs || []).find(j => j.transferenciaId === id);

            if (!job) {
                // Sin job activo → botón normal
                btn.removeAttribute('disabled');
                btn.style.opacity = '';
                btn.title = '';
                btn.innerHTML = '<i class="bi bi-box-arrow-right"></i><span>' +
                    (btn.classList.contains('btn-surtir-mobile')
                        ? 'Surtir transferencia'
                        : 'Surtir') +
                    '</span>';
                btn.style.pointerEvents = '';
                btn.classList.remove('is-processing', 'is-error');
                return;
            }

            const estado = (job.estado || '').toLowerCase();

            if (estado === 'error' || estado === 'errorparcial') {
                // Error → puede reintentar
                btn.removeAttribute('disabled');
                btn.style.opacity = '1';
                btn.title = `Error: ${job.fallidas} fallidas de ${job.total}`;
                btn.innerHTML =
                    '<i class="bi bi-arrow-clockwise"></i><span>Reintentar</span>';
                btn.style.pointerEvents = '';
                btn.classList.remove('is-processing');
                btn.classList.add('is-error');
            } else {
                // Pendiente / EnProceso / Completado en proceso
                btn.setAttribute('disabled', 'disabled');
                btn.style.opacity = '0.65';
                btn.style.pointerEvents = 'none';

                const pct = job.total > 0
                    ? Math.round((job.procesadas / job.total) * 100)
                    : 0;

                btn.title =
                    `Procesando... ${job.procesadas}/${job.total} (${pct}%)`;

                btn.innerHTML =
                    `<span class="spinner-border spinner-border-sm" aria-hidden="true"></span>` +
                    `<span>${pct}%</span>`;

                btn.classList.remove('is-error');
                btn.classList.add('is-processing');
            }
        });
    }

    async function revisarEstatus() {
        if (refrescando) return;

        try {
            const resp = await fetch(
                '/Transferencias/EstatusTransferencias',
                {
                    cache: 'no-store',
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                }
            );

            if (!resp.ok) return;

            const data = await resp.json();
            const existen = !!data.existen;

            actualizarBotones(data.jobs || []);

            if (ultimoEstado === null) {
                ultimoEstado = existen;
                return;
            }

            if (ultimoEstado === true && existen === false) {
                refrescando = true;
                window.location.reload();
                return;
            }

            ultimoEstado = existen;
        }
        catch (e) {
            console.error(
                'Error al validar estatus:',
                e
            );
        }
    }

    window.addEventListener(
        'pageshow',
        function (e) {
            const nav =
                performance.getEntriesByType('navigation')[0];

            if (
                e.persisted ||
                nav?.type === 'back_forward'
            ) {
                window.location.reload();
            }
        }
    );

    revisarEstatus();

    setInterval(
        revisarEstatus,
        10000
    );
})();
</script>
