@using Plataforma_CG.ViewModels
@model SolicitudTransferenciaViewModel
@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Nueva Solicitud de Transferencia";
    var items = Model?.Productos ?? new List<SolicitudTransferenciaProductoVM>();
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    /* =====================================================================
           NUEVA SOLICITUD DE TRANSFERENCIA · SIGO — hoja de estilos única
           Mismo sistema visual que la Orden de Venta y el resto de módulos.
           Sustituye las capas anteriores y el script de ancho del sidebar.
           ===================================================================== */
    :root {
        --es-tinto: #8d3e46;
        --es-tinto-deep: #5c2229;
        --es-tinto-soft: #f7eced;
        --es-tinto-line: #e8d3d6;
        --es-paper: #f6f4f4;
        --es-surface: #ffffff;
        --es-field: #ffffff;
        --es-field-ro: #f6f3f3;
        --es-head: #faf7f7;
        --es-hover: #fcf9f9;
        --es-row-line: #f0eaeb;
        --es-ink: #231a1c;
        --es-muted: #76686b;
        --es-line: #e6dfe0;
        --es-line-strong: #cfc4c6;
        --es-ok: #2f7a55;
        --es-ok-bg: #e7f3ec;
        --es-warn: #9a6410;
        --es-warn-bg: #fbf1de;
        --es-bad: #b42d2d;
        --es-bad-bg: #fbe9e8;
        --es-info: #2f5d86;
        --es-info-bg: #e9f0f7;
        --es-font: "Poppins", "Segoe UI", system-ui, -apple-system, Arial, sans-serif;
    }

    body[data-theme="dark"] {
        --es-tinto: #c56b74;
        --es-tinto-deep: #7a2d36;
        --es-tinto-soft: #3a2427;
        --es-tinto-line: #5a3439;
        --es-paper: #16181c;
        --es-surface: #202328;
        --es-field: #181a1e;
        --es-field-ro: #262a30;
        --es-head: #262a30;
        --es-hover: #2a2e34;
        --es-row-line: #30343b;
        --es-ink: #edf0f3;
        --es-muted: #a9b0b9;
        --es-line: #363b43;
        --es-line-strong: #4a5059;
        --es-ok: #6cc596;
        --es-ok-bg: #1d3328;
        --es-warn: #e0b061;
        --es-warn-bg: #3a2f1b;
        --es-bad: #f08a83;
        --es-bad-bg: #3d2223;
        --es-info: #8bb8e0;
        --es-info-bg: #1e2b38;
    }

    .layout-main-content {
        min-width: 0 !important;
    }

        .layout-main-content .container, .layout-main-content .container-fluid {
            max-width: 100% !important;
        }

    .stx, .stx-modal, .ui-autocomplete {
        font-family: var(--es-font) !important;
    }

    .stx {
        color: var(--es-ink);
        font-size: 13px;
        line-height: 1.4;
        background: var(--es-paper);
        padding: 16px 18px 0;
        min-width: 0;
    }

        .stx *, .stx-modal * {
            box-sizing: border-box;
        }

        .stx .bi, .stx-modal .bi {
            font-family: "bootstrap-icons" !important;
        }

    .es-muted {
        color: var(--es-muted) !important;
    }

    /* ---------- Encabezado ---------- */
    .st-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 14px;
    }

    .st-header__title {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .st-header__icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: grid;
        place-items: center;
        background: var(--es-tinto);
        color: #fff;
        font-size: 19px;
    }

    .st-header h1 {
        margin: 0;
        font-size: 20px;
        font-weight: 700;
        letter-spacing: -.01em;
        line-height: 1.15;
        color: var(--es-ink);
    }

    .st-header p {
        margin: 2px 0 0;
        font-size: 12px;
        color: var(--es-muted);
    }

    .st-header__actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    /* ---------- Botones ---------- */
    .stx .btn, .stx-modal .btn, .tbtn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        height: 36px;
        padding: 0 14px;
        border: 1px solid var(--es-line-strong);
        border-radius: 7px;
        background: var(--es-field);
        color: var(--es-ink);
        font: 600 12.5px/1 var(--es-font);
        white-space: nowrap;
        cursor: pointer;
        text-decoration: none;
        box-shadow: none;
        transition: background .12s, border-color .12s, color .12s;
    }

        .stx .btn:hover, .stx-modal .btn:hover, .tbtn:hover {
            background: var(--es-tinto-soft);
            border-color: var(--es-tinto-line);
            color: var(--es-ink);
        }

        .stx .btn:focus-visible, .stx-modal .btn:focus-visible, .tbtn:focus-visible {
            outline: 2px solid var(--es-tinto);
            outline-offset: 2px;
            box-shadow: none;
        }

        .stx .btn:disabled, .tbtn:disabled {
            opacity: .5;
            cursor: not-allowed;
        }

        .tbtn.primary, .stx .btn-reflejo, .stx-modal .btn-danger {
            background: var(--es-tinto);
            border-color: var(--es-tinto);
            color: #fff;
        }

            .tbtn.primary:hover, .stx .btn-reflejo:hover, .stx-modal .btn-danger:hover {
                background: var(--es-tinto-deep);
                border-color: var(--es-tinto-deep);
                color: #fff;
            }

    .stx .cell-btn {
        width: 32px;
        height: 30px;
        padding: 0;
        border-radius: 6px;
    }

        .stx .cell-btn.btn-outline-danger {
            color: var(--es-muted);
        }

            .stx .cell-btn.btn-outline-danger:hover {
                background: var(--es-bad-bg);
                border-color: var(--es-bad);
                color: var(--es-bad);
            }

    .stx .note-exists {
        background: var(--es-info-bg);
        border-color: var(--es-info);
        color: var(--es-info);
    }

    /* ---------- Campos ---------- */
    .stx .form-label, .stx-modal .form-label {
        display: block;
        margin: 0 0 5px;
        font-size: 12px;
        font-weight: 600;
        color: var(--es-muted);
        text-transform: none;
        letter-spacing: 0;
    }

    .stx .form-control, .stx .form-select, .stx-modal .form-control {
        height: 36px;
        min-height: 36px;
        padding: 0 10px;
        border: 1px solid var(--es-line-strong);
        border-radius: 7px;
        background-color: var(--es-field);
        color: var(--es-ink);
        font: 500 13px/1.2 var(--es-font);
        box-shadow: none;
    }

    .stx .form-select {
        padding-right: 30px;
    }

    body[data-theme="dark"] .stx .form-control, body[data-theme="dark"] .stx .form-select, body[data-theme="dark"] .stx-modal .form-control {
        color-scheme: dark;
    }

    .stx textarea.form-control, .stx-modal textarea.form-control {
        height: auto;
        padding: 9px 10px;
        line-height: 1.45;
        resize: vertical;
    }

    .stx .form-control:focus, .stx .form-select:focus, .stx-modal .form-control:focus {
        border-color: var(--es-tinto);
        box-shadow: 0 0 0 3px rgba(141,62,70,.16);
        outline: none;
        background-color: var(--es-field);
        color: var(--es-ink);
    }

    .stx .form-control[readonly], .stx .form-control.bg-light {
        background: var(--es-field-ro) !important;
        color: var(--es-ink);
    }

    .stx .form-control::placeholder {
        color: var(--es-muted);
        opacity: .8;
    }

    .stx .form-text {
        margin-top: 5px;
        font-size: 11.5px;
        color: var(--es-muted);
        line-height: 1.35;
    }

        .stx .form-text.text-danger {
            color: var(--es-bad) !important;
            font-weight: 500;
        }

    .stx .text-danger.small, .stx [data-valmsg-for] {
        display: block;
        margin-top: 4px;
        font-size: 11.5px;
        color: var(--es-bad);
    }

    .stx .is-invalid {
        border-color: var(--es-bad) !important;
        background-color: var(--es-bad-bg) !important;
    }

    .st-primary-field {
        font-weight: 600 !important;
    }

    /* ---------- Tarjetas ---------- */
    .st-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 12px;
        margin-bottom: 12px;
        align-items: start;
    }

    .st-card {
        background: var(--es-surface);
        border: 1px solid var(--es-line);
        border-radius: 10px;
        min-width: 0;
    }

    .st-card__head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
        padding: 11px 14px;
        border-bottom: 1px solid var(--es-line);
    }

    .st-card__title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 0;
        font-size: 14px;
        font-weight: 600;
        color: var(--es-ink);
    }

    .st-step {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        display: inline-grid;
        place-items: center;
        background: var(--es-tinto-soft);
        color: var(--es-tinto);
        font-size: 12px;
        font-weight: 700;
        flex: none;
        transition: background .2s, color .2s;
    }

        .st-step.is-active {
            background: var(--es-ok);
            color: #fff;
        }

    .st-card__body {
        padding: 14px;
    }

    .st-fields {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
    }

    .st-col-2 {
        grid-column: span 2;
    }

    /* Resumen */
    .st-summary {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 8px;
    }

    .st-sum {
        padding: 10px 12px;
        border: 1px solid var(--es-line);
        border-radius: 8px;
        background: var(--es-head);
        border-top: 3px solid var(--k, var(--es-line-strong));
    }

        .st-sum span {
            display: block;
            font-size: 11.5px;
            color: var(--es-muted);
        }

        .st-sum strong {
            display: block;
            font-size: 20px;
            font-weight: 700;
            font-variant-numeric: tabular-nums;
            color: var(--es-ink);
        }

        .st-sum.is-ok {
            --k: var(--es-ok);
        }

        .st-sum.is-warn {
            --k: var(--es-warn);
        }

        .st-sum.is-bad {
            --k: var(--es-bad);
        }

    #stEstadoCaptura {
        font-size: 14px !important;
        line-height: 1.3;
        padding-top: 4px;
    }

    .st-help {
        margin-top: 12px;
        padding: 9px 12px;
        border-radius: 8px;
        background: var(--es-info-bg);
        color: var(--es-info);
        font-size: 12.5px;
        display: flex;
        gap: 8px;
        align-items: flex-start;
    }

    /* ---------- Productos ---------- */
    .st-table-wrap {
        overflow: auto;
        max-height: 56vh;
    }

    .stx .st-table {
        width: 100%;
        min-width: 1050px;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
        font-size: 12.5px;
        color: var(--es-ink);
        --bs-table-bg: transparent;
        --bs-table-color: var(--es-ink);
        --bs-table-hover-bg: transparent;
    }

        .stx .st-table thead th {
            position: sticky;
            top: 0;
            z-index: 2;
            padding: 9px 8px;
            background: var(--es-head);
            border-bottom: 1px solid var(--es-line);
            color: var(--es-muted);
            font-size: 11.5px;
            font-weight: 600;
            text-align: left;
            white-space: nowrap;
            text-transform: none;
        }

        .stx .st-table tbody td {
            padding: 6px 8px;
            border-bottom: 1px solid var(--es-row-line);
            background: var(--es-surface);
            color: var(--es-ink);
            vertical-align: middle;
            box-shadow: none;
        }

        .stx .st-table tbody tr:hover td {
            background: var(--es-hover);
        }

        .stx .st-table td:first-child {
            width: 44px;
            text-align: center;
            color: var(--es-muted);
            font-variant-numeric: tabular-nums;
        }

        .stx .st-table .form-control {
            height: 32px;
            min-height: 32px;
            padding: 0 8px;
            font-size: 12.5px;
        }

        .stx .st-table .cant, .stx .st-table .cajas, .stx .st-table input[name$='.Presupuesto'], .stx .st-table input[name$='.Disponible'] {
            text-align: right;
            font-variant-numeric: tabular-nums;
        }

        .stx .st-table .productoInput {
            text-transform: uppercase;
            font-weight: 600;
        }

        .stx .st-table tbody tr.table-danger td {
            background: var(--es-bad-bg) !important;
        }

            .stx .st-table tbody tr.table-danger td:first-child {
                box-shadow: inset 3px 0 0 var(--es-bad);
            }

    .st-products-tools {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
        padding: 10px 14px;
        border-top: 1px solid var(--es-line);
        font-size: 11.5px;
        color: var(--es-muted);
    }

    /* ---------- Pie fijo ---------- */
    .st-savebar {
        position: sticky;
        bottom: 0;
        z-index: 50;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        flex-wrap: wrap;
        margin: 12px -18px 0;
        padding: 12px 18px;
        background: var(--es-surface);
        border-top: 1px solid var(--es-line);
        box-shadow: 0 -6px 18px rgba(35,26,28,.08);
    }

    .st-totals {
        display: flex;
        align-items: baseline;
        gap: 22px;
        flex-wrap: wrap;
    }

    .st-total span {
        display: block;
        font-size: 11.5px;
        color: var(--es-muted);
    }

    .st-total strong {
        font-size: 20px;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
        color: var(--es-ink);
    }

    .st-savebar__actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    /* ---------- Overlay y avisos ---------- */
    #savingOverlay {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 1070;
        background: rgba(246,244,244,.7);
        align-items: center;
        justify-content: center;
        flex-direction: column;
        gap: 10px;
        font-family: var(--es-font);
        color: var(--es-ink);
        font-weight: 600;
    }

    body[data-theme="dark"] #savingOverlay {
        background: rgba(22,24,28,.8);
    }

    .st-spinner {
        width: 34px;
        height: 34px;
        border: 3px solid var(--es-tinto-line);
        border-top-color: var(--es-tinto);
        border-radius: 50%;
        animation: st-spin .8s linear infinite;
    }

    @@keyframes st-spin {
        to {
            transform: rotate(360deg);
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .st-spinner {
            animation-duration: 2s;
        }
    }

    #saveToast {
        font-family: var(--es-font);
        border-radius: 10px;
        border: 1px solid var(--es-line);
        background: var(--es-surface);
        color: var(--es-ink);
        box-shadow: 0 10px 28px rgba(0,0,0,.2);
    }

        #saveToast .toast-header {
            background: var(--es-head);
            color: var(--es-ink);
            border-bottom: 1px solid var(--es-line);
        }

        #saveToast .toast-body {
            white-space: pre-line;
            font-size: 12.5px;
        }

    /* ---------- Modal comentario ---------- */
    .stx-modal {
        border: 0;
        border-radius: 12px;
        overflow: hidden;
        background: var(--es-surface);
        color: var(--es-ink);
        box-shadow: 0 18px 50px rgba(35,26,28,.25);
    }

        .stx-modal .modal-header {
            padding: 13px 18px;
            background: var(--es-tinto-deep);
            color: #fff;
            border-bottom: 0;
        }

        .stx-modal .modal-title {
            font-size: 15px;
            font-weight: 600;
            color: #fff;
        }

        .stx-modal .btn-close {
            filter: invert(1) grayscale(1) brightness(2);
            opacity: .9;
        }

        .stx-modal .modal-body {
            background: var(--es-surface);
        }

        .stx-modal .modal-footer {
            background: var(--es-head);
            border-top: 1px solid var(--es-line);
        }

    #comentarioModal .modal-dialog {
        max-width: 560px;
    }

    /* ---------- Autocompletar ---------- */
    .ui-autocomplete {
        z-index: 2000 !important;
        max-height: 320px;
        overflow-y: auto;
        overflow-x: hidden;
        padding: 4px !important;
        border: 1px solid var(--es-line-strong) !important;
        border-radius: 8px;
        background: var(--es-surface) !important;
        box-shadow: 0 10px 28px rgba(0,0,0,.15);
    }

    .ui-menu .ui-menu-item-wrapper {
        padding: 7px 10px !important;
        border: 0 !important;
        border-radius: 6px;
        font-size: 12.5px;
        color: var(--es-ink);
    }

        .ui-menu .ui-menu-item-wrapper.ui-state-active {
            background: var(--es-tinto-soft) !important;
            color: var(--es-ink) !important;
            margin: 0 !important;
        }

    @@media (max-width: 1200px) {
        .st-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 640px) {
        .stx {
            padding: 10px 10px 0;
        }

        .st-fields, .st-summary {
            grid-template-columns: 1fr;
        }

        .st-col-2 {
            grid-column: auto;
        }

        .st-savebar {
            margin: 12px -10px 0;
            padding: 10px;
        }

        .st-savebar__actions, .st-savebar__actions .tbtn {
            width: 100%;
        }
    }
</style>

<div class="stx st-page">

    <header class="st-header">
        <div class="st-header__title">
            <span class="st-header__icon"><i class="bi bi-arrow-left-right"></i></span>
            <div>
                <h1>Nueva solicitud de transferencia</h1>
                <p>Sucursal, fecha y productos. El presupuesto y el disponible se calculan solos; al guardar se validan.</p>
            </div>
        </div>
        <div class="st-header__actions" role="toolbar" aria-label="Acciones principales">
            <button type="submit" form="formST" name="accion" value="salir" class="tbtn primary" title="Guardar y salir">
                <i class="bi bi-check2-circle"></i> Guardar y salir
            </button>
            <button type="submit" form="formST" name="accion" value="nuevo" class="tbtn primary" title="Guardar y capturar otra solicitud">
                <i class="bi bi-plus-circle"></i> Guardar y nueva
            </button>
            <a href="@Url.Content("~/Home/inicio")" class="tbtn" title="Salir sin guardar">
                <i class="bi bi-x-lg"></i> Cancelar
            </a>
        </div>
    </header>

    <form id="formST" asp-action="Guardar" asp-controller="Transferencias" method="post">
        <input type="hidden" name="accion" id="accionField" value="salir" />
        @Html.AntiForgeryToken()

        <div class="st-grid">
            <!-- 1-2. Datos -->
            <section class="st-card">
                <div class="st-card__head">
                    <h2 class="st-card__title"><span class="st-step" id="stStepSucursal">1</span> Datos de la solicitud</h2>
                    <span class="st-step" id="stStepFecha" title="Fecha" aria-hidden="true">2</span>
                </div>
                <div class="st-card__body">
                    <div class="st-fields">
                        <div>
                            <label class="form-label">Consecutivo</label>
                            <input asp-for="Consecutivo" class="form-control" readonly />
                        </div>
                        <div>
                            <label class="form-label" for="FechaSolicitud">Fecha de solicitud</label>
                            <input asp-for="FechaSolicitud" type="date" class="form-control st-primary-field" />
                            <span asp-validation-for="FechaSolicitud" class="text-danger small"></span>
                        </div>
                        <div class="st-col-2">
                            <label class="form-label" for="Sucursal">Sucursal</label>
                            <select asp-for="Sucursal" class="form-select st-primary-field" asp-items="Model.SeriesDisponibles">
                                <option value="">Selecciona sucursal</option>
                            </select>
                            <span asp-validation-for="Sucursal" class="text-danger small"></span>
                        </div>
                        <div class="st-col-2">
                            <label class="form-label" for="LogisticaFolioId">Folio de transporte (opcional)</label>
                            <select id="LogisticaFolioId" name="LogisticaFolioId" class="form-select">
                                <option value="">Sin folio de transporte</option>
                            </select>
                            <div id="logisticaFolioTransferenciaInfo" class="form-text">
                                Si ya existe una solicitud de transporte para esta fecha, puedes ligar esta transferencia al mismo camión.
                            </div>
                        </div>
                        <div class="st-col-2">
                            <label class="form-label" for="Observacion">Observación</label>
                            <textarea asp-for="Observacion" rows="2" class="form-control" placeholder="Prioridad, referencia o indicaciones de la transferencia…"></textarea>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Resumen -->
            <section class="st-card">
                <div class="st-card__head">
                    <h2 class="st-card__title"><i class="bi bi-clipboard-check" style="color:var(--es-tinto)"></i> Resumen</h2>
                </div>
                <div class="st-card__body">
                    <div class="st-summary">
                        <div class="st-sum"><span>Productos con cantidad</span><strong id="stItemCount">0</strong></div>
                        <div class="st-sum"><span>Total kg</span><strong id="totKg">0.00</strong></div>
                        <div class="st-sum" id="stEstadoCard"><span>Estado</span><strong id="stEstadoCaptura">Pendiente</strong></div>
                    </div>
                    <div class="st-help">
                        <i class="bi bi-info-circle"></i>
                        <span>Escribe dos letras del producto y selecciónalo. Captura cajas <b>o</b> kilos: el otro se calcula con los kilos por caja del SKU. Si el disponible queda negativo, la fila se marca en rojo.</span>
                    </div>
                </div>
            </section>
        </div>

        <!-- 3. Productos -->
        <section class="st-card">
            <div class="st-card__head">
                <h2 class="st-card__title"><span class="st-step" id="stStepProductos">3</span> Productos solicitados</h2>
                <a href="#" onclick="agregarFila();return false;" class="btn btn-reflejo">
                    <i class="bi bi-plus-circle"></i> Agregar producto
                </a>
            </div>

            <div class="st-table-wrap">
                <table class="table table-sm align-middle mb-0 st-table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Producto</th>
                            <th class="text-end" style="width:140px">Cantidad kg</th>
                            <th class="text-end" style="width:120px">Cajas</th>
                            <th class="text-end" style="width:140px">Presupuesto</th>
                            <th class="text-end" style="width:140px">Disponible</th>
                            <th class="text-center" style="width:100px">Comentario</th>
                            <th class="text-center" style="width:70px">Quitar</th>
                        </tr>
                    </thead>
                    <tbody id="tbodyArt">
                        @for (int i = 0; i < items.Count; i++)
                        {
                            <tr>
                                <td>@(i + 1)</td>
                                <td>
                                    <input name="Productos[@i].ProductoNombre" class="form-control productoInput" placeholder="Buscar producto…" value="@items[i].ProductoNombre" />
                                    <input type="hidden" name="Productos[@i].ProductoCodigo" class="productoCodigo" value="@items[i].ProductoCodigo" />
                                </td>
                                <td><input name="Productos[@i].CantidadKg" type="number" step="0.01" min="0.01" class="form-control cant" value="@(items[i].CantidadKg == 0 ? 0 : items[i].CantidadKg)" /></td>
                                <td><input name="Productos[@i].Cajas" type="number" step="1" min="0" inputmode="numeric" pattern="[0-9]*" class="form-control cajas" value="@(items[i].Cajas <= 0 ? 0 : (int)Math.Round(items[i].Cajas))" /></td>
                                <td><input name="Productos[@i].Presupuesto" type="number" step="0.01" min="0" class="form-control bg-light" value="@(items[i].Presupuesto == 0 ? 0 : items[i].Presupuesto)" readonly /></td>
                                <td><input name="Productos[@i].Disponible" type="number" step="0.01" min="0" class="form-control bg-light" value="@(items[i].Disponible == 0 ? 0 : items[i].Disponible)" readonly /></td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-light btn-sm cell-btn btn-nota @(string.IsNullOrWhiteSpace(items[i].Nota) ? "" : "note-exists")"
                                            title="@(string.IsNullOrWhiteSpace(items[i].Nota) ? "Agregar comentario" : items[i].Nota)"
                                            aria-label="Comentario del producto" onclick="abrirComentarioModal(this)">
                                        <i class="bi bi-chat-left-text"></i>
                                    </button>
                                    <input type="hidden" name="Productos[@i].Nota" class="notaHidden" value="@items[i].Nota" />
                                </td>
                                <td class="text-center">
                                    <a href="#" class="btn btn-outline-danger btn-sm cell-btn" title="Quitar producto" aria-label="Quitar producto" onclick="eliminarFila(this);return false;"><i class="bi bi-trash"></i></a>
                                </td>
                            </tr>
                        }
                        @if (!items.Any())
                        {
                            <tr>
                                <td>1</td>
                                <td>
                                    <input name="Productos[0].ProductoNombre" class="form-control productoInput" placeholder="Buscar producto…" />
                                    <input type="hidden" name="Productos[0].ProductoCodigo" class="productoCodigo" />
                                </td>
                                <td><input name="Productos[0].CantidadKg" type="number" step="0.01" min="0.01" class="form-control cant" value="0" /></td>
                                <td><input name="Productos[0].Cajas" type="number" step="1" min="0" inputmode="numeric" pattern="[0-9]*" class="form-control cajas" value="0" /></td>
                                <td><input name="Productos[0].Presupuesto" type="number" step="0.01" min="0" class="form-control bg-light" value="0" readonly /></td>
                                <td><input name="Productos[0].Disponible" type="number" step="0.01" min="0" class="form-control bg-light" value="0" readonly /></td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-light btn-sm cell-btn btn-nota" title="Agregar comentario" aria-label="Comentario del producto" onclick="abrirComentarioModal(this)"><i class="bi bi-chat-left-text"></i></button>
                                    <input type="hidden" name="Productos[0].Nota" class="notaHidden" />
                                </td>
                                <td class="text-center">
                                    <a href="#" class="btn btn-outline-danger btn-sm cell-btn" title="Quitar producto" aria-label="Quitar producto" onclick="eliminarFila(this);return false;"><i class="bi bi-trash"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="st-products-tools">
                <span>Cada producto necesita presupuesto, kilos y cajas mayores a 0, y disponible que no quede negativo.</span>
                <span>Enter no envía el formulario.</span>
            </div>
        </section>

        <!-- 4. Guardar -->
        <div class="st-savebar">
            <div class="st-totals">
                <span class="st-step" id="stStepGuardar">4</span>
                <div class="st-total"><span>Productos con cantidad</span><strong id="sbLineas">0</strong></div>
                <div class="st-total"><span>Total kg</span><strong id="sbKg">0.00</strong></div>
            </div>
            <div class="st-savebar__actions">
                <button type="submit" name="accion" value="salir" class="tbtn primary"><i class="bi bi-check2-circle"></i> Guardar y salir</button>
                <button type="submit" name="accion" value="nuevo" class="tbtn primary"><i class="bi bi-plus-circle"></i> Guardar y nueva</button>
                <a class="tbtn" href="@Url.Content("~/Home/inicio")"><i class="bi bi-x-lg"></i> Cancelar</a>
            </div>
        </div>
    </form>
</div>

<!-- MODAL: Comentario -->
<div class="modal fade" id="comentarioModal" tabindex="-1" aria-labelledby="comentarioLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content stx-modal">
            <div class="modal-header">
                <h5 class="modal-title" id="comentarioLabel">Comentario del producto</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2"><strong id="skuInfo">SKU: -</strong></p>
                <label class="form-label" for="comentarioText">Instrucciones u observaciones</label>
                <textarea id="comentarioText" class="form-control" rows="4" placeholder="Escribe instrucciones, observaciones o aclaraciones del producto…"></textarea>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="btnGuardarComentario" class="btn btn-danger"><i class="bi bi-check2-circle"></i> Guardar comentario</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js"></script>

    <script>
        /* =====================================================================
           SOLICITUD DE TRANSFERENCIA — misma lógica y endpoints.
           Cambios marcados con "CORRECCIÓN".
        ===================================================================== */

        // ===== Aviso y overlay =====
        let toastInst = null;
        let pendingPresupuestos = 0;
        let guardando = false;

        function ensureToast() {
            if (document.getElementById('saveToast')) return;
            const wrap = document.createElement('div');
            wrap.innerHTML = `
                        <div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1080">
                            <div id="saveToast" class="toast" role="status" aria-live="polite" aria-atomic="true">
                                <div class="toast-header">
                                    <i class="bi bi-arrow-left-right me-2"></i>
                                    <strong class="me-auto">Transferencia</strong>
                                    <button type="button" class="btn-close ms-2" data-bs-dismiss="toast" aria-label="Cerrar"></button>
                                </div>
                                <div class="toast-body" id="saveToastBody">Listo.</div>
                            </div>
                        </div>`;
            document.body.appendChild(wrap);
        }
        function showToast(msg, delay = 4000) {
            ensureToast();
            document.getElementById('saveToastBody').innerText = msg || 'Listo.';
            const el = document.getElementById('saveToast');
            if (window.bootstrap?.Toast) {
                toastInst = bootstrap.Toast.getOrCreateInstance(el, { delay });
                toastInst.show();
            } else alert(msg || 'Listo.');
        }
        function ensureOverlay() {
            if (document.getElementById('savingOverlay')) return;
            const ov = document.createElement('div');
            ov.id = 'savingOverlay';
            ov.setAttribute('role', 'status');
            ov.innerHTML = `<div class="st-spinner"></div><div id="savingOverlayText">Procesando…</div>`;
            document.body.appendChild(ov);
        }
        // En consultas de presupuesto no bloquea toques; en guardado sí, para evitar doble envío.
        function showOverlay(blocking, texto) {
            ensureOverlay();
            const el = document.getElementById('savingOverlay');
            document.getElementById('savingOverlayText').textContent = texto || 'Procesando…';
            el.style.pointerEvents = blocking ? 'auto' : 'none';
            el.style.display = 'flex';
        }
        function hideOverlay() {
            if (guardando) return; // CORRECCIÓN: no se oculta mientras se guarda o redirige
            const el = document.getElementById('savingOverlay');
            if (el) { el.style.display = 'none'; el.style.pointerEvents = 'none'; }
        }

        // ===== Utilidades =====
        let modalInstance = null, currentRow = null;
        const toUpper = (s) => (s ?? "").toString().toUpperCase().trim();
        const num = (v) => { const x = parseFloat(String(v ?? "").replace(",", ".")); return isFinite(x) ? x : 0; };

        function renumerar() {
            $("#tbodyArt tr").each(function (i) {
                $(this).find("td:first").text(i + 1);
                $(this).find("input").each(function () {
                    const n = $(this).attr("name");
                    if (n) $(this).attr("name", n.replace(/Productos\[\d+\]/, `Productos[${i}]`));
                });
            });
        }

        function agregarFila() {
            const i = $("#tbodyArt tr").length;
            $("#tbodyArt").append(`
                        <tr>
                            <td>${i + 1}</td>
                            <td>
                                <input name="Productos[${i}].ProductoNombre" class="form-control productoInput" placeholder="Buscar producto…" />
                                <input type="hidden" name="Productos[${i}].ProductoCodigo" class="productoCodigo" />
                            </td>
                            <td><input name="Productos[${i}].CantidadKg" type="number" step="0.01" min="0.01" class="form-control cant" value="0" /></td>
                            <td><input name="Productos[${i}].Cajas" type="number" step="1" min="0" inputmode="numeric" pattern="[0-9]*" class="form-control cajas" value="0" /></td>
                            <td><input name="Productos[${i}].Presupuesto" type="number" step="0.01" min="0" class="form-control bg-light" value="0" readonly /></td>
                            <td><input name="Productos[${i}].Disponible" type="number" step="0.01" class="form-control bg-light" value="0" readonly /></td>
                            <td class="text-center">
                                <button type="button" class="btn btn-light btn-sm cell-btn btn-nota" title="Agregar comentario" aria-label="Comentario del producto" onclick="abrirComentarioModal(this)"><i class="bi bi-chat-left-text"></i></button>
                                <input type="hidden" name="Productos[${i}].Nota" class="notaHidden" />
                            </td>
                            <td class="text-center">
                                <a href="#" class="btn btn-outline-danger btn-sm cell-btn" title="Quitar producto" aria-label="Quitar producto" onclick="eliminarFila(this);return false;"><i class="bi bi-trash"></i></a>
                            </td>
                        </tr>`);
            const $last = $("#tbodyArt tr:last .productoInput");
            initAutoComplete($last);
            setTimeout(() => $last.trigger("focus"), 50);
            refrescarEstado();
        }

        function eliminarFila(a) {
            a.closest("tr").remove();
            if ($("#tbodyArt tr").length === 0) agregarFila();
            renumerar();
            calcKg();
        }

        function totalKgTransferenciaCapturada() {
            let total = 0;
            $("#tbodyArt .cant").each(function () { const kg = num($(this).val()); if (kg > 0) total += kg; });
            return total;
        }

        let calcKgRaf = null;
        function calcKg() {
            if (calcKgRaf) cancelAnimationFrame(calcKgRaf);
            calcKgRaf = requestAnimationFrame(function () {
                calcKgRaf = null;
                let t = 0;
                $("#tbodyArt .cant").each(function () { t += num($(this).val()); });
                const txt = t.toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                $("#totKg").text(txt);
                $("#sbKg").text(txt);
                refrescarEstado();
            });
        }

        /* ---------- Kilos por caja (factor) ---------- */
        // Acepta el factor aunque el servidor lo mande con distintos nombres.
        function parseFactorFromObject(obj) {
            if (!obj) return 0;
            const posibles = ["factorCaja", "FactorCaja", "kilosCaja", "KilosCaja", "kgCaja", "KgCaja", "KGCaja", "KgPorCaja",
                "pesoCaja", "PesoCaja", "pesoPorCaja", "PesoPorCaja", "kilogramosCaja", "KilogramosCaja"];
            for (const k of posibles) { const v = num(obj[k]); if (v > 0) return v; }
            return 0;
        }
        const factorPorSku = {};
        function setFactor($row, factor) {
            factor = num(factor);
            const $cajas = $row.find(".cajas");
            if (factor <= 0) { $row.data("factorCaja", 0); $cajas.attr("placeholder", ""); return 0; }
            const sku = toUpper($row.find(".productoCodigo").val());
            if (sku) factorPorSku[sku] = factor;
            $row.data("factorCaja", factor);
            $cajas.attr("placeholder", `1 caja = ${factor.toFixed(2)} kg`).attr("title", `1 caja = ${factor.toFixed(2)} kg`);
            return factor;
        }
        function getFactor($row) {
            const sku = toUpper($row.find(".productoCodigo").val());
            return num($row.data("factorCaja")) || (sku ? num(factorPorSku[sku]) : 0);
        }

        // Si la fila no tiene factor (p. ej. venía precargada), se consulta una vez.
        function obtenerFactor($row, callback) {
            const f = getFactor($row);
            if (f > 0) { callback(f); return; }
            const sku = toUpper($row.find(".productoCodigo").val());
            const sucursal = ($("select[name='Sucursal']").val() || "").toString().trim();
            const fecha = $("input[name='FechaSolicitud']").val();
            if (!sku || !sucursal || !fecha) { callback(0); return; }
            $.getJSON('/Transferencias/PresupuestoDisponible', { sucursal, sku, fechaSolicitud: fecha })
                .done(d => callback(setFactor($row, parseFactorFromObject(d))))
                .fail(() => callback(0));
        }

        function resetRow($row) {
            $row.find(".productoInput").val("");
            $row.find(".productoCodigo").val("");
            $row.find(".cant").val("0.00");
            $row.find(".cajas").val("0");
            $row.find("input[name$='.Presupuesto']").val("0.00");
            $row.find("input[name$='.Disponible']").val("0.00").data("base", 0);
            setFactor($row, 0);
            $row.find(".notaHidden").val("");
            $row.find(".btn-nota").removeClass("note-exists").attr("title", "Agregar comentario");
            $row.removeClass("table-danger");
            calcKg();
        }

        // Disponible mostrado = base del servidor − kg de esta solicitud.
        function recalcularFila($row) {
            const cant = num($row.find(".cant").val());
            const $disp = $row.find("input[name$='.Disponible']");
            const base = parseFloat($disp.data("base"));
            const original = isFinite(base) ? base : num($disp.val());
            const final = original - cant;
            $disp.val(final.toFixed(2));
            $row.toggleClass("table-danger", final < 0);
            return final;
        }

        /* ---------- CORRECCIÓN: conversión cajas ↔ kg con UN solo manejador ----------
           Antes había dos manejadores encimados y, si el SKU no tenía kilos por caja,
           al escribir cajas se borraban los kilos (y viceversa). Ahora, sin factor,
           el otro campo se deja como está. */
        $(document).on("input", "#tbodyArt .cant", function () {
            const $row = $(this).closest("tr");
            obtenerFactor($row, function (factor) {
                const kg = num($row.find(".cant").val()); // valor vigente (la consulta del factor puede tardar)
                if (factor > 0) $row.find(".cajas").val(Math.round(kg / factor));
                recalcularFila($row);
                calcKg();
                actualizarResumenFolioTransferencia();
            });
        });
        $(document).on("input", "#tbodyArt .cajas", function () {
            const $row = $(this).closest("tr");
            obtenerFactor($row, function (factor) {
                const cajas = num($row.find(".cajas").val());
                if (factor > 0) $row.find(".cant").val((cajas * factor).toFixed(2));
                recalcularFila($row);
                calcKg();
                actualizarResumenFolioTransferencia();
            });
        });

        /* ---------- Comentario por producto ---------- */
        function abrirComentarioModal(btn) {
            currentRow = $(btn).closest("tr");
            const sku = toUpper(currentRow.find(".productoCodigo").val());
            $("#skuInfo").text(`SKU: ${sku || "-"}`);
            $("#comentarioText").val(currentRow.find(".notaHidden").val() || "");
            modalInstance = bootstrap.Modal.getOrCreateInstance(document.getElementById('comentarioModal'));
            modalInstance.show();
            setTimeout(() => $("#comentarioText").trigger("focus"), 250);
        }
        $("#btnGuardarComentario").on("click", function () {
            if (!currentRow) return;
            const txt = $("#comentarioText").val() || "";
            currentRow.find(".notaHidden").val(txt);
            currentRow.find(".btn-nota")
                .toggleClass("note-exists", !!txt.trim())
                .attr("title", txt.trim() ? txt : "Agregar comentario");
            modalInstance?.hide();
        });

        /* ---------- Autocompletar producto ---------- */
        function initAutoComplete($el) {
            $el.autocomplete({
                appendTo: 'body',
                position: { my: "left top+2", at: "left bottom" },
                minLength: 2,
                source: function (request, response) {
                    $.getJSON('/Transferencias/BuscarProductosAutocomplete', { term: request.term }, data => response(data || []));
                },
                focus: function () { return false; },
                select: function (e, ui) {
                    const row = $(this).closest("tr");
                    const label = (ui.item.label || "").toString().toUpperCase();
                    const sku = (ui.item.value || "").toString().toUpperCase();
                    $(this).val(label);
                    row.find(".productoCodigo").val(sku);
                    setFactor(row, parseFactorFromObject(ui.item));
                    cargarPresupuestoRow(row);
                    return false;
                },
                open: function () { $(this).autocomplete("widget").css("width", $(this).outerWidth()); }
            }).on('input', function () {
                const s = this.selectionStart, e = this.selectionEnd;
                this.value = toUpper(this.value);
                this.setSelectionRange(s, e);
                const $row = $(this).closest("tr");
                $row.find(".productoCodigo").val("");
                setFactor($row, 0);
            });
        }

        /* ---------- Errores del servidor ---------- */
        function clearErrors() {
            $('.is-invalid').removeClass('is-invalid');
            $('[data-valmsg-for]').text('');
        }
        function renderErrors(errors) {
            Object.entries(errors || {}).forEach(([key, msgs]) => {
                if (!msgs || !msgs.length) return;
                if (key) {
                    $(`[name="${key}"]`).addClass('is-invalid');
                    const $span = $(`[data-valmsg-for="${key}"]`);
                    if ($span.length) $span.text(msgs[0]);
                } else showToast(msgs[0]);
            });
            const $first = $('.is-invalid').first();
            if ($first.length) $('html, body').animate({ scrollTop: Math.max(0, $first.offset().top - 120) }, 250);
        }

        /* ---------- Presupuesto y disponible por fila ---------- */
        function limpiarPresupuestoFila($row) {
            $row.find("input[name$='.Presupuesto']").val("0.00");
            $row.find("input[name$='.Disponible']").val("0.00").data("base", 0);
            $row.find(".cajas").val("0");
            setFactor($row, 0);
            $row.removeClass('table-danger');
        }

        function cargarPresupuestoRow($row) {
            const sku = toUpper($row.find(".productoCodigo").val());
            const sucursal = ($("select[name='Sucursal']").val() || "").toString().trim();
            const fecha = $("input[name='FechaSolicitud']").val();

            if (!sku || !sucursal || !fecha) {
                limpiarPresupuestoFila($row);
                if (sku && (!sucursal || !fecha)) showToast("Selecciona sucursal y fecha para calcular presupuesto y disponible.");
                return;
            }

            pendingPresupuestos++;
            $.getJSON('/Transferencias/PresupuestoDisponible', { sucursal, sku, fechaSolicitud: fecha })
                .done(function (data) {
                    if (!data) return;
                    const pres = num(data.presupuesto);
                    const disp = num(data.disponible);

                    if (disp <= 0) {
                        showToast(`No puedes agregar el SKU ${sku}: no tiene disponible para esta sucursal y fecha.`);
                        resetRow($row);
                        setTimeout(() => $row.find(".productoInput").trigger("focus"), 150);
                        return;
                    }

                    $row.find("input[name$='.Presupuesto']").val(pres.toFixed(2));
                    $row.find("input[name$='.Disponible']").val(disp.toFixed(2)).data("base", disp);

                    const factorSrv = parseFactorFromObject(data);
                    if (factorSrv > 0) setFactor($row, factorSrv);

                    // Al recargar por cambio de sucursal/fecha se reaplica lo capturado.
                    const final = recalcularFila($row);
                    if (final < 0) showToast(`El SKU ${sku} se pasa del presupuesto. Disponible final: ${final.toFixed(2)} kg`);
                })
                .fail(function (xhr) {
                    console.error(xhr);
                    limpiarPresupuestoFila($row);
                    $row.addClass('table-danger');
                })
                .always(function () {
                    pendingPresupuestos--;
                    if (pendingPresupuestos <= 0) hideOverlay();
                    refrescarEstado();
                });
        }

        // Cambio de sucursal o fecha: se recalculan todas las filas con SKU.
        $(document).on('change', "select[name='Sucursal'], input[name='FechaSolicitud']", function () {
            const sucursal = ($("select[name='Sucursal']").val() || "").toString().trim();
            const fecha = $("input[name='FechaSolicitud']").val();
            const haySku = $("#tbodyArt .productoCodigo").toArray().some(x => toUpper(x.value));

            if (!sucursal || !fecha || !haySku) {
                $("#tbodyArt tr").each(function () { limpiarPresupuestoFila($(this)); });
                calcKg();
                hideOverlay();
                return;
            }

            showOverlay(false, "Recalculando presupuesto…");
            pendingPresupuestos = 0;
            $("#tbodyArt tr").each(function () {
                const $row = $(this);
                if (toUpper($row.find(".productoCodigo").val())) cargarPresupuestoRow($row);
                else limpiarPresupuestoFila($row);
            });
            if (pendingPresupuestos <= 0) hideOverlay();
        });

        /* ---------- Folio de transporte (opcional) ---------- */
        function fmtKgLogistica(v) {
            return Number(v || 0).toLocaleString("es-MX", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function actualizarResumenFolioTransferencia() {
            const $folio = $("#LogisticaFolioId");
            const $info = $("#logisticaFolioTransferenciaInfo");
            if (!$folio.length || !$info.length) return;
            const option = $folio[0]?.selectedOptions?.[0];

            if (!option || !option.value) {
                $info.removeClass("text-danger").text("Si ya existe una solicitud de transporte para esta fecha, puedes ligar esta transferencia al mismo camión.");
                return;
            }
            const cargados = Number(option.dataset.kgCargados || 0);
            const disponible = Number(option.dataset.kgDisponible || 0);
            const maximo = Number(option.dataset.capacidadMaximaKg || 0);
            const documentos = Number(option.dataset.cantidadDocumentos || 0);
            const transferencia = totalKgTransferenciaCapturada();
            const restante = disponible - transferencia;

            $info.text(
                `Cargado: ${fmtKgLogistica(cargados)} kg · Disponible: ${fmtKgLogistica(disponible)} kg · Máximo: ${fmtKgLogistica(maximo)} kg · ` +
                `Documentos ligados: ${documentos} · Esta transferencia: ${fmtKgLogistica(transferencia)} kg · ` +
                (restante >= 0 ? `Quedarían ${fmtKgLogistica(restante)} kg` : `EXCESO: ${fmtKgLogistica(Math.abs(restante))} kg`)
            ).toggleClass("text-danger", restante < 0);
        }

        async function cargarFoliosLogisticaTransferencia() {
            const fecha = ($("input[name='FechaSolicitud']").val() || "").trim();
            const $folio = $("#LogisticaFolioId");
            const $info = $("#logisticaFolioTransferenciaInfo");
            if (!$folio.length) return;
            const valorAnterior = ($folio.val() || "").toString();
            $folio.empty();

            if (!fecha) {
                $folio.append('<option value="">Selecciona primero la fecha…</option>');
                $info.text("Selecciona la fecha para consultar transportes disponibles.");
                return;
            }

            $folio.prop("disabled", true).append('<option value="">Buscando folios disponibles…</option>');
            $info.removeClass("text-danger").text("Consultando capacidad de transporte…");

            try {
                const response = await fetch(`/Transferencias/FoliosLogisticaDisponiblesTransferencia?fechaSolicitud=${encodeURIComponent(fecha)}`,
                    { method: "GET", headers: { "Accept": "application/json" } });
                const result = await response.json().catch(() => null);
                if (!response.ok) throw new Error(result?.mensaje || result?.message || `HTTP ${response.status}`);

                const lista = Array.isArray(result) ? result : [];
                $folio.empty().append('<option value="">Sin folio de transporte</option>');
                lista.forEach(x => {
                    const option = document.createElement("option");
                    option.value = x.id;
                    option.textContent =
                        `${x.folio} | ${x.tipoTransporte || "TRANSPORTE"} | Cargado ${fmtKgLogistica(x.kgCargados)} kg | ` +
                        `Disponible ${fmtKgLogistica(x.kgDisponible)} kg | Máx ${fmtKgLogistica(x.capacidadMaximaKg)} kg` +
                        (x.destino ? ` | ${x.destino}` : "");
                    option.dataset.kgCargados = String(x.kgCargados || 0);
                    option.dataset.kgDisponible = String(x.kgDisponible || 0);
                    option.dataset.capacidadMaximaKg = String(x.capacidadMaximaKg || 0);
                    option.dataset.cantidadDocumentos = String(x.cantidadDocumentos || 0);
                    option.dataset.tipoTransporte = x.tipoTransporte || "";
                    $folio.append(option);
                });

                if (valorAnterior && $folio.find(`option[value="${CSS.escape(valorAnterior)}"]`).length) $folio.val(valorAnterior);

                $info.text(lista.length
                    ? `${lista.length} folio(s) con capacidad disponible para ${fecha}.`
                    : "No hay folios con capacidad disponible para esta fecha. La transferencia puede guardarse sin folio.");
                actualizarResumenFolioTransferencia();
            } catch (error) {
                console.error("Folios logística transferencia:", error);
                $folio.empty().append('<option value="">Sin folio / error al consultar</option>');
                $info.text(error?.message || "No se pudieron consultar los folios de transporte.");
            } finally {
                $folio.prop("disabled", false);
            }
        }

        /* ---------- CORRECCIÓN: estado del resumen y de los pasos ----------
           Antes el contador de productos y el estado nunca se actualizaban
           (el script buscaba elementos que no existían). */
        let estadoRaf = null;
        function refrescarEstado() {
            if (estadoRaf) return;
            estadoRaf = requestAnimationFrame(function () {
                estadoRaf = null;
                const sucursal = ($("select[name='Sucursal']").val() || "").toString().trim();
                const fecha = ($("input[name='FechaSolicitud']").val() || "").trim();
                let lineas = 0, enRojo = 0;
                $("#tbodyArt tr").each(function () {
                    const sku = toUpper($(this).find(".productoCodigo").val());
                    if (sku && num($(this).find(".cant").val()) > 0) lineas++;
                    if ($(this).hasClass("table-danger")) enRojo++;
                });

                $("#stItemCount, #sbLineas").text(lineas.toLocaleString('es-MX'));
                $("#stStepSucursal").toggleClass("is-active", !!sucursal);
                $("#stStepFecha").toggleClass("is-active", !!fecha);
                $("#stStepProductos").toggleClass("is-active", lineas > 0);
                $("#stStepGuardar").toggleClass("is-active", lineas > 0 && !!sucursal && !!fecha && enRojo === 0);

                const $card = $("#stEstadoCard").removeClass("is-ok is-warn is-bad");
                let estado;
                if (!sucursal || !fecha) { estado = "Falta sucursal o fecha"; $card.addClass("is-warn"); }
                else if (lineas === 0) { estado = "Agrega al menos un producto"; $card.addClass("is-warn"); }
                else if (enRojo > 0) { estado = `${enRojo} fila(s) por corregir`; $card.addClass("is-bad"); }
                else { estado = "Lista para guardar"; $card.addClass("is-ok"); }
                $("#stEstadoCaptura").text(estado);
            });
        }

        /* ---------- Inicio ---------- */
        $(function () {
            $(".productoInput").each(function () { initAutoComplete($(this)); });

            $('#formST').on('keydown', 'input, select', function (e) {
                if (e.key === 'Enter') { e.preventDefault(); e.stopPropagation(); return false; }
            });

            const hoy = new Date();
            $("input[name='FechaSolicitud']").attr("min",
                `${hoy.getFullYear()}-${String(hoy.getMonth() + 1).padStart(2, '0')}-${String(hoy.getDate()).padStart(2, '0')}`);

            $(document).on('click', 'button[form="formST"][type="submit"], #formST button[type="submit"]', function () {
                $('#accionField').val((this.value || 'salir').toLowerCase());
            });

            $(document).on("change.logisticaTransferencia", "input[name='FechaSolicitud']", cargarFoliosLogisticaTransferencia);
            $(document).on("change.logisticaTransferencia", "#LogisticaFolioId", actualizarResumenFolioTransferencia);
            $(document).on("change input", "select[name='Sucursal'], input[name='FechaSolicitud']", refrescarEstado);
            cargarFoliosLogisticaTransferencia();
            calcKg();

            $('#formST').on('submit', async function (e) {
                e.preventDefault();
                if (guardando) return false; // CORRECCIÓN: evita doble envío

                const sucursal = ($("select[name='Sucursal']").val() || "").toString().trim();
                const fecha = $("input[name='FechaSolicitud']").val();
                const $folioLogistica = $("#LogisticaFolioId");
                const folioLogisticaId = Number($folioLogistica.val() || 0);
                const kgDisponibleFolio = Number($folioLogistica[0]?.selectedOptions?.[0]?.dataset?.kgDisponible || 0);
                const kgTransferencia = totalKgTransferenciaCapturada();

                let ok = true, msg = "";
                if (!sucursal) { ok = false; msg += "- Selecciona una sucursal.\n"; }
                if (folioLogisticaId > 0 && kgTransferencia > kgDisponibleFolio + 0.001) {
                    ok = false;
                    msg += `- La transferencia tiene ${fmtKgLogistica(kgTransferencia)} kg, pero el folio seleccionado solo tiene ${fmtKgLogistica(kgDisponibleFolio)} kg disponibles.\n`;
                }

                let alMenosUno = false;
                $("#tbodyArt tr").each(function () {
                    const $row = $(this);
                    const code = toUpper($row.find(".productoCodigo").val());
                    const kg = num($row.find(".cant").val());
                    const cajas = num($row.find(".cajas").val());
                    const disp = num($row.find("input[name$='.Disponible']").val());
                    const pres = num($row.find("input[name$='.Presupuesto']").val());
                    $row.removeClass('table-danger');
                    if (!code) return;
                    if (pres <= 0) { ok = false; msg += `- El producto ${code} no tiene presupuesto asignado.\n`; $row.addClass('table-danger'); return; }
                    if (kg <= 0 || cajas <= 0) { ok = false; msg += `- El producto ${code} necesita cantidad y cajas mayores a 0. Corrige o quita la línea.\n`; $row.addClass('table-danger'); return; }
                    if (disp < 0) { ok = false; msg += `- El producto ${code} deja el disponible en ${disp.toFixed(2)} kg (debe ser 0 o más).\n`; $row.addClass('table-danger'); return; }
                    alMenosUno = true;
                });
                if (!alMenosUno) { ok = false; msg += "- Agrega al menos un producto con cantidad.\n"; }
                if (!fecha) { ok = false; msg += "- Selecciona la fecha de solicitud.\n"; }

                refrescarEstado();
                if (!ok) { alert("Corrige lo siguiente antes de guardar:\n\n" + msg); return false; }

                clearErrors();
                guardando = true;
                showOverlay(true, "Guardando la solicitud… no cierres la página.");
                $('button[type="submit"]').prop('disabled', true);

                try {
                    const form = document.getElementById('formST');
                    const fd = new FormData(form);
                    const token = $('input[name="__RequestVerificationToken"]').val();
                    const resp = await fetch(form.action, {
                        method: 'POST',
                        body: fd,
                        headers: { 'X-Requested-With': 'XMLHttpRequest', 'RequestVerificationToken': token || '' },
                        credentials: 'same-origin'
                    });
                    const raw = await resp.text();
                    let data = {};
                    try { data = JSON.parse(raw); } catch { }

                    if (!resp.ok || !data.ok) {
                        guardando = false;
                        hideOverlay();
                        $('button[type="submit"]').prop('disabled', false);
                        if (!data || data.ok === undefined) {
                            console.warn('Respuesta no JSON:', raw.slice(0, 300));
                            showToast('No se pudo guardar. Posible sesión vencida: revisa la captura o recarga la página.', 7000);
                            return false;
                        }
                        if (data.errors) renderErrors(data.errors);
                        showToast(data.message || 'Revisa la captura de la solicitud.', 7000);
                        return false;
                    }

                    if (data.sobrePresupuesto && data.skusSobrePresupuesto && data.skusSobrePresupuesto.length) {
                        showToast(`Transferencia guardada con folio ${data.folio}.\nSKU sobre presupuesto: ${data.skusSobrePresupuesto.join(', ')}. Queda pendiente de autorización.`, 6000);
                    } else {
                        showToast(`Transferencia guardada con folio ${data.folio}.`);
                    }
                    document.getElementById('savingOverlayText').textContent = `Guardada con folio ${data.folio}. Redirigiendo…`;

                    const accionSel = (data.accion || $('#accionField').val() || 'salir').toLowerCase();
                    const url = data.redirect || (accionSel === 'nuevo' ? '/Transferencias/TransferenciasCedis' : '/Home/inicio');
                    setTimeout(() => { window.location.href = url; }, 1200);
                } catch (err) {
                    guardando = false;
                    hideOverlay();
                    $('button[type="submit"]').prop('disabled', false);
                    console.error(err);
                    showToast('Error de red. Antes de reintentar, revisa si la transferencia ya aparece registrada.', 8000);
                }
            });
        });
    </script>
}
