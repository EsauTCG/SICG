                        </td>
                        <td>${escapeHtml(x.destino || 'Sin definir')}</td>
                        <td>${renderTipoViajeChip(x.tipoViaje)}</td>
                        <td>${escapeHtml((x.rutas || []).join(', '))}</td>
                        <td>${escapeHtml(x.vendedor)}</td>
                        <td>${escapeHtml(x.presentacion)}</td>
                        <td title="Solicitado: ${nf.format(x.cargaSolicitadaKg || 0)} kg">${nf.format(x.kilos)}</td>
                        <td>${escapeHtml(x.fletera || 'Sin asignar')}</td>
                        <td><span class="status-chip ${getChipClass(x.estatus)}">${escapeHtml(x.estatus)}</span></td>
                        <td>${escapeHtml(x.espacioTarimas || 0)}</td>
                        <td>${escapeHtml(x.horaLlegadaUnidad || '')}</td>
                        <td>${escapeHtml(x.observacionLogistica || '')}</td>
                        <td>${escapeHtml(getMotivoResumen(x))}</td>
                        <td>
                            ${x.estatus === 'CANCELADO'
                                ? `<span class="status-chip status-cancelado">Cancelado</span>`
                                : (
                                    puedeEditarLogistica
                                        ? `<button type="button"
                                                   class="mini-btn js-edit"
                                                   data-id="${x.id}">
                                               <i class="bi bi-pencil-square"></i> Editar
                                           </button>

                                           <button type="button"
                                                   class="mini-btn js-fletera"
                                                   data-id="${x.id}">
                                               <i class="bi bi-truck"></i> Fletera
                                           </button>`
                                        : `<button type="button"
                                                   class="mini-btn js-edit"
                                                   data-id="${x.id}">
                                               <i class="bi bi-eye"></i> Ver
                                           </button>`
                                )
                            }

                            ${!x.tieneOv
                                ? `<br><span class="badge-mini">Aún sin OV ligada</span>`
                                : ''}
