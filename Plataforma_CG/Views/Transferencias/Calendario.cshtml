            async function cargarPermisosLogisticaActual() {
                try {
                    const response = await fetch(URL_PERMISOS_LOGISTICA, {
                        method: 'GET',
                        headers: {
                            'Accept': 'application/json'
                        }
                    });

                    const result = await response.json().catch(() => null);

                    if (!response.ok || !result || result.ok === false) {
                        throw new Error(
                            result?.mensaje ||
                            result?.error ||
                            `HTTP ${response.status}`
                        );
                    }

                    puedeEditarLogistica =
                        Boolean(
                            result.puedeEditarLogistica ??
                            result.PuedeEditarLogistica
                        );

                    puedeSolicitarTransporte =
                        Boolean(
                            result.puedeSolicitarTransporte ??
                            result.PuedeSolicitarTransporte
                        );

                    usuarioEsVendedor =
                        Boolean(
                            result.esVendedor ??
                            result.EsVendedor
                        );

                    permisosCargados = true;

                    // Sólo vendedores solicitan transporte.
                    if ($btnNuevoFolio) {
                        $btnNuevoFolio.style.display =
                            puedeSolicitarTransporte
                                ? ''
                                : 'none';
                    }

                    // Guardar logística sólo existe para usuarios de logística.
                    if ($btnGuardar) {
                        $btnGuardar.style.display =
                            puedeEditarLogistica
                                ? ''
                                : 'none';
                    }

                    return true;
                }
                catch (error) {
                    console.error('Permisos logística:', error);

                    permisosCargados = true;
                    puedeEditarLogistica = false;
                    puedeSolicitarTransporte = false;
                    usuarioEsVendedor = false;

                    if ($btnNuevoFolio) {
                        $btnNuevoFolio.style.display = 'none';
                    }

                    if ($btnGuardar) {
                        $btnGuardar.style.display = 'none';
                    }

                    alert(
                        error?.message ||
                        'No se pudieron determinar los permisos de logística.'
                    );

                    return false;
                }
            }


