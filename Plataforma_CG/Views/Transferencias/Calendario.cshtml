            async function cargarVendedorSolicitud() {
                vendedorSolicitudActual = null;

                if ($solVendedorNombre) {
                    $solVendedorNombre.value = 'Cargando vendedor...';
                }

                try {
                    const response = await fetch(URL_VENDEDORES_FOLIO, {
                        method: 'GET',
                        headers: { 'Accept': 'application/json' }
                    });

                    const result = await response.json().catch(() => null);

                    if (!response.ok || !result || result.ok === false) {
                        throw new Error(
                            result?.mensaje ||
                            result?.error ||
                            `HTTP ${response.status}`
                        );
                    }

                    const vendedorId = Number(
                        result.vendedorId ??
                        result.VendedorId ??
                        result.id ??
                        0
                    );

                    const vendedorNombre = String(
                        result.vendedor ??
                        result.Vendedor ??
                        result.nombre ??
                        result.Nombre ??
                        ''
                    ).trim();

                    if (!vendedorId) {
                        throw new Error(
                            'Tu usuario no tiene un VendedorId configurado en UsuarioSQL.'
                        );
                    }

                    vendedorSolicitudActual = {
                        id: vendedorId,
                        nombre: vendedorNombre
                    };

                    if ($solVendedorNombre) {
                        $solVendedorNombre.value =
                            vendedorNombre || `Vendedor ${vendedorId}`;
                    }

                    $solInfo.textContent =
                        `Vendedor automático: ${vendedorNombre || `Vendedor ${vendedorId}`} ` +
                        `(ID ${vendedorId}). Captura la fecha y los kg requeridos.`;

                    return true;
                }
                catch (error) {
                    console.error('Vendedor de logística:', error);

                    vendedorSolicitudActual = null;

                    if ($solVendedorNombre) {
                        $solVendedorNombre.value = 'SIN VENDEDOR CONFIGURADO';
                    }

                    $solInfo.textContent =
                        error?.message ||
                        'No se pudo obtener el vendedor ligado al usuario actual.';

                    return false;
                }
            }

            async function abrirSolicitudFolio() {
                if (!puedeSolicitarTransporte) {
                    alert(
                        'Este usuario no tiene VendedorId. ' +
                        'Las solicitudes de transporte corresponden al vendedor.'
                    );
                    return;
                }

                const hoy = toDateString(getTodayNoon());
                const fechaSugerida = $fechaBase.value || hoy;

                $solFecha.min = hoy;
                $solFecha.value = fechaSugerida < hoy ? hoy : fechaSugerida;
                $solToneladas.value = '';
                $solDestino.value = '';
                $solTipoViaje.value = 'TENTATIVO';
                actualizarPreviewTipoViaje($solTipoViaje, $solTipoViajePreview);

                $solInfo.textContent =
                    'Captura fecha, kg, destino y si el viaje es tentativo o ya está confirmado. ' +
                    'El vendedor se toma automáticamente de tu usuario.';

                await cargarVendedorSolicitud();
                $modalSolicitudFolio.classList.add('show');
                setTimeout(() => $solToneladas.focus(), 80);
            }

            function cerrarSolicitudFolio() {
                $modalSolicitudFolio.classList.remove('show');
            }

            async function guardarSolicitudFolio() {
                const fechaEmbarque = ($solFecha.value || '').trim();
                const toneladas = Number($solToneladas.value || 0);
                const destino = ($solDestino.value || '').trim().toUpperCase();
                const tipoViaje = normalizeTipoViaje($solTipoViaje.value);

                if (!fechaEmbarque) {
                    alert('Selecciona la fecha para embarcar.');
                    return;
                }

                if (!Number.isFinite(toneladas) || toneladas <= 0) {
                    alert('Captura los kilogramos solicitados.');
                    return;
                }

                if (!destino) {
                    alert('Captura el destino del viaje.');
                    $solDestino.focus();
                    return;
                }

                if (!['TENTATIVO', 'CONFIRMADO'].includes(tipoViaje)) {
                    alert('Selecciona si el viaje es TENTATIVO o CONFIRMADO.');
                    return;
                }

                if (!vendedorSolicitudActual?.id) {
                    alert(
                        'No se pudo identificar el vendedor ligado a tu usuario. ' +
                        'Revisa UsuarioSQL.VendedorId.'
                    );
                    return;
                }

                const headers = {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                };

                const token = getAntiForgeryToken();
                if (token) {
                    headers['RequestVerificationToken'] = token;
                    headers['__RequestVerificationToken'] = token;
                }

                try {
                    $btnGuardarSolicitudFolio.disabled = true;
                    $solInfo.textContent = 'Generando folio...';

                    const response = await fetch(URL_CREAR_FOLIO, {
                        method: 'POST',
                        headers,
                        body: JSON.stringify({
                            FechaEmbarque: fechaEmbarque,
                            Toneladas: toneladas,
                            Destino: destino,
                            TipoViaje: tipoViaje
                        })
                    });

                    const result = await response.json().catch(() => ({}));

                    if (!response.ok || !(result.ok ?? false)) {
                        throw new Error(result.mensaje || `HTTP ${response.status}`);
                    }

                    alert(`Folio ${result.folio} generado correctamente.`);

                    currentDate = parseDate(fechaEmbarque);
                    cerrarSolicitudFolio();
                    await renderAll();
                }
                catch (error) {
                    console.error(error);
                    $solInfo.textContent = 'No fue posible generar el folio.';
                    alert(error.message || 'No se pudo generar el folio de transporte.');
                }
                finally {
                    $btnGuardarSolicitudFolio.disabled = false;
                }
            }

            function getCardClass(estatus) {
                if (estatus === 'RESERVADO VENTA') return 'programado';
                if (estatus === 'ASIGNADO') return 'asignado';
                if (estatus === 'PENDIENTE FLETERA') return 'pendiente';
                if (estatus === 'FLETERA CANCELADA') return 'cancelado-fletera';
                if (estatus === 'CANCELADO') return 'cancelado';
                return 'programado';
            }

            function getChipClass(estatus) {
                if (estatus === 'RESERVADO VENTA') return 'status-programado';
                if (estatus === 'ASIGNADO') return 'status-asignado';
                if (estatus === 'PENDIENTE FLETERA') return 'status-pendiente';
                if (estatus === 'FLETERA CANCELADA') return 'status-cancelado-fletera';
                if (estatus === 'CANCELADO') return 'status-cancelado';
                return 'status-programado';
            }

            function getVisibleDays() {
                if ($vistaTipo.value === 'day') return [cloneDate(currentDate)];
                const monday = getMonday(currentDate);
                return Array.from({ length: 7 }, (_, i) => addDays(monday, i));
            }

            function getFilteredData() {
                const days = getVisibleDays();
                const minDate = toDateString(days[0]);
                const maxDate = toDateString(days[days.length - 1]);

                return data.filter(x => {
                    const okRange = x.fecha >= minDate && x.fecha <= maxDate;
                    const okVend = !$filtroVendedor.value || x.vendedor === $filtroVendedor.value;
                    const okEst = !$filtroEstatus.value || x.estatus === $filtroEstatus.value;
                    return okRange && okVend && okEst;
                });
            }

            function mapPedidoToItem(x) {
                const fecha = normalizeDateOnly(
                    pick(x, 'FechaEmbarque', 'fechaEmbarque', 'FechaEntrega', 'fechaEntrega')
                );

                const ordenVentaId = Number(pick(x, 'OrdenVentaId', 'ordenVentaId') || 0);
                const folio = normalizeText(pick(x, 'Folio', 'folio'));
                const consecutivoOv = normalizeText(pick(x, 'Consecutivo', 'consecutivo'));

                const item = {
                    id: Number(pick(x, 'FolioLogisticaId', 'folioLogisticaId', 'Id', 'id') || 0),
                    folioLogisticaId: Number(pick(x, 'FolioLogisticaId', 'folioLogisticaId', 'Id', 'id') || 0),
                    folio: folio,
                    ordenVentaId: ordenVentaId,
                    tieneOv: ordenVentaId > 0,

                    consecutivo: consecutivoOv || folio,
                    serie: normalizeText(pick(x, 'Serie', 'serie')),
                    nombreSerie: normalizeText(pick(x, 'NombreSerie', 'nombreSerie')),
                    sucursal: normalizeText(pick(x, 'Sucursal', 'sucursal')),
                    sucursalId: normalizeText(pick(x, 'SucursalId', 'sucursalId', 'sucursalid')),

                    fecha: fecha,
                    fechaEmbarque: fecha,
                    horaEmbarque: normalizeTime(pick(x, 'HoraEmbarque', 'horaEmbarque')),

                    clienteCodigo: normalizeText(pick(x, 'ClienteCodigo', 'clienteCodigo')),
                    clienteNombre: normalizeText(pick(x, 'ClienteNombre', 'clienteNombre')),
                    cliente: normalizeText(pick(x, 'ClienteNombre', 'clienteNombre')) || 'SIN OV',
                    vendedorId: Number(pick(x, 'VendedorId', 'vendedorId') || 0),
                    vendedor: normalizeText(pick(x, 'Vendedor', 'vendedor')),
                    destino: normalizeText(pick(x, 'Destino', 'destino')),
                    tipoViaje: normalizeTipoViaje(pick(x, 'TipoViaje', 'tipoViaje')),
                    rutas: [normalizeText(pick(x, 'Ruta', 'ruta')) || 'SIN RUTA'],
                    presentacion: normalizeText(pick(x, 'Presentacion', 'presentacion')),
                    observaciones: normalizeText(pick(x, 'Observacion', 'observacion')),

                    cargaSolicitadaKg: Number(pick(x, 'CargaSolicitadaKg', 'cargaSolicitadaKg') || 0),
                    kgOrdenVenta: Number(pick(x, 'KgOrdenVenta', 'kgOrdenVenta') || 0),
                    kilos: Number(pick(x, 'Saldo', 'saldo') || 0),
                    otrosPedidos: Number(pick(x, 'OtrosPedidos', 'otrosPedidos') || 0),
                    credito: Number(pick(x, 'Credito', 'credito') || 0),

                    fletera: normalizeText(pick(x, 'Fletera', 'fletera')),
                    espacioTarimas: Number(pick(x, 'EspacioTarimas', 'espacioTarimas') || 0),
                    horaLlegadaUnidad: normalizeTime(pick(x, 'HoraLlegadaUnidad', 'horaLlegadaUnidad')),
                    estatus: normalizeText(pick(x, 'EstatusLogistico', 'estatusLogistico')) || 'RESERVADO VENTA',
                    observacionLogistica: normalizeText(pick(x, 'ObservacionLogistica', 'observacionLogistica')),

                    cancelado: Boolean(pick(x, 'Cancelado', 'cancelado')),
                    canceladoFletera: Boolean(pick(x, 'CanceladoFletera', 'canceladoFletera')),
                    motivoCancelacion: normalizeText(pick(x, 'MotivoCancelacion', 'motivoCancelacion')),
                    motivoCancelacionFletera: normalizeText(pick(x, 'MotivoCancelacionFletera', 'motivoCancelacionFletera'))
                };

                item.estatus = normalizeStatusByCarrier(item);
                return item;
            }

            async function cargarPedidosDesdeBD() {
                const days = getVisibleDays();
                const fechaInicio = toDateString(days[0]);
                const fechaFin = toDateString(days[days.length - 1]);

                const url = `${URL_GET_PEDIDOS}?fechaInicio=${encodeURIComponent(fechaInicio)}&fechaFin=${encodeURIComponent(fechaFin)}`;

                setLoading(true);

                try {
                    const response = await fetch(url, {
                        method: 'GET',
                        headers: {
                            'Accept': 'application/json'
                        }
                    });

                    const result = await response.json().catch(() => null);

                    if (!response.ok) {
                        const detalle = [
                            result?.mensaje,
                            result?.error,
                            result?.inner,
                            result?.servidor ? `Servidor: ${result.servidor}` : '',
                            result?.baseDatos ? `Base: ${result.baseDatos}` : '',
                            result?.sugerencia
                        ]
                        .filter(Boolean)
                        .join('\n');

                        throw new Error(
                            detalle || `HTTP ${response.status}`
                        );
                    }

                    const pedidos = result;
                    data = Array.isArray(pedidos) ? pedidos.map(mapPedidoToItem) : [];
                } catch (error) {
                    console.error('GetPedidosLogistica:', error);
                    data = [];

                    alert(
                        'Error cargando planeación de transporte:\n\n' +
                        (error?.message || 'Error desconocido')
                    );
                } finally {
                    setLoading(false);
                }
            }

            async function guardarLogisticaRequest(payload) {
                const headers = {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                };

                const token = getAntiForgeryToken();
                if (token) {
                    headers['RequestVerificationToken'] = token;
                    headers['__RequestVerificationToken'] = token;
                }

                const response = await fetch(URL_GUARDAR_LOGISTICA, {
                    method: 'POST',
                    headers: headers,
                    body: JSON.stringify(payload)
                });

                if (!response.ok) {
                    throw new Error(`HTTP ${response.status}`);
                }

                const result = await response.json();
                const ok = result.ok ?? result.Ok ?? result.success ?? result.Success ?? false;

                if (!ok) {
                    throw new Error(result.mensaje || result.Mensaje || result.message || 'No se pudo guardar la logística.');
                }

                return result;
            }

            function renderVendedores() {
                const vendedores = [...new Set(data.map(x => x.vendedor).filter(Boolean))].sort();
                const selected = $filtroVendedor.value;

                $filtroVendedor.innerHTML = '<option value="">Todos</option>' +
                    vendedores.map(v => `<option value="${escapeHtml(v)}">${escapeHtml(v)}</option>`).join('');

                $filtroVendedor.value = vendedores.includes(selected) ? selected : '';
            }

            function renderRangeTitle() {
                const days = getVisibleDays();

                if ($vistaTipo.value === 'day') {
                    const d = days[0];
                    $rangeTitle.textContent = `${nombresDias[d.getDay()]} ${d.getDate()} de ${nombresMeses[d.getMonth()]} de ${d.getFullYear()}`;
                    return;
                }

                const first = days[0];
                const last = days[days.length - 1];

                if (first.getMonth() === last.getMonth() && first.getFullYear() === last.getFullYear()) {
                    $rangeTitle.textContent = `${first.getDate()} - ${last.getDate()} de ${nombresMeses[first.getMonth()]} de ${first.getFullYear()}`;
                } else if (first.getFullYear() === last.getFullYear()) {
                    $rangeTitle.textContent = `${first.getDate()} de ${nombresMeses[first.getMonth()]} - ${last.getDate()} de ${nombresMeses[last.getMonth()]} de ${first.getFullYear()}`;
                } else {
                    $rangeTitle.textContent = `${first.getDate()} de ${nombresMeses[first.getMonth()]} de ${first.getFullYear()} - ${last.getDate()} de ${nombresMeses[last.getMonth()]} de ${last.getFullYear()}`;
                }
            }

            function renderKpis(items) {
                $kpiEmbarques.textContent = nf.format(items.length);
                $kpiKilos.textContent = nf.format(items.reduce((a, b) => a + Number(b.kilos || 0), 0));
                $kpiPendientes.textContent = nf.format(items.filter(x => x.estatus === 'PENDIENTE FLETERA').length);
                $kpiAsignados.textContent = nf.format(items.filter(x => x.estatus === 'ASIGNADO').length);
                $kpiCancelados.textContent = nf.format(items.filter(x => x.estatus === 'CANCELADO' || x.estatus === 'FLETERA CANCELADA').length);
            }

            function renderRutas(rutas = ['SIN RUTA']) {
                $rutasContainer.innerHTML = rutas.map(ruta => `
                    <div class="ruta-row">
                        <input type="text"
                               class="form-control js-ruta"
                               value="${escapeHtml(ruta)}"
                               readonly />
                    </div>
                `).join('');
            }

            function getMotivoResumen(item) {
                if (item.motivoCancelacion) return item.motivoCancelacion;
                if (item.motivoCancelacionFletera) return item.motivoCancelacionFletera;
                return '';
            }

            function renderBoard() {
                const visibleDays = getVisibleDays();
                const items = getFilteredData();

                $board.classList.toggle('calendar-empty', items.length === 0);

                const minCol = window.innerWidth >= 1700 ? 'minmax(0, 1fr)' : 'minmax(230px, 1fr)';
                $board.style.gridTemplateColumns = `repeat(${visibleDays.length}, ${minCol})`;

                let html = '';

                visibleDays.forEach(d => {
                    html += `
                        <div class="day-head sticky-top">
                            <div class="day-num">${d.getDate()}</div>
                            <div class="day-name">${nombresDias[d.getDay()]}</div>
                            <div class="day-date">${pad(d.getDate())}/${pad(d.getMonth() + 1)}/${d.getFullYear()}</div>
                        </div>`;
