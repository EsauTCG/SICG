                $listadoCount.textContent = `${items.length} folio${items.length !== 1 ? 's' : ''} en el rango`;
                $modalListadoTitle.textContent = `Listado de folios / embarques — ${items.length} registro${items.length !== 1 ? 's' : ''}`;

                if (!items.length) {
                    $tbodyListado.innerHTML = `<tr><td colspan="17" style="text-align:center;">Sin solicitudes de transporte en este rango</td></tr>`;
