@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewBag.Title = "Calendario de Logística";
}

@Html.AntiForgeryToken()


<link rel="stylesheet" href="~/css/calendario-logistica-grid.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/calendario-logistica-erp.css" asp-append-version="true" />

<style>
    /*
         * ================================================================
         * CALENDARIO COMPACTO
         * ================================================================
         * Reduce la altura de los encabezados rojos de cada día y,
         * cuando toda la semana/día está sin órdenes, elimina el espacio
         * vertical innecesario del calendario.
         * ================================================================
         */

    .calendario-logistica-app .section-calendar .section-body {
        padding-top: 4px !important;
        padding-bottom: 4px !important;
    }

    .calendario-logistica-app .calendar-wrap {
        min-height: 0 !important;
        height: auto !important;
        max-height: none !important;
    }

    .calendario-logistica-app .calendar-board {
        min-height: 0 !important;
        height: auto !important;
        align-items: stretch !important;
        grid-auto-rows: auto !important;
    }

    /*
         * Encabezado rojo del día.
         * Antes ocupaba demasiado alto incluso sin información.
         */
    .calendario-logistica-app .day-head {
        min-height: 58px !important;
        height: 58px !important;
        max-height: 58px !important;
        padding: 5px 7px !important;
        display: flex !important;
        flex-direction: column !important;
        justify-content: flex-start !important;
        gap: 0 !important;
        overflow: hidden !important;
    }

        .calendario-logistica-app .day-head .day-num {
            font-size: 18px !important;
            line-height: 18px !important;
            margin: 0 !important;
        }

        .calendario-logistica-app .day-head .day-name {
            font-size: 9px !important;
            line-height: 11px !important;
            margin-top: 2px !important;
        }

        .calendario-logistica-app .day-head .day-date {
            font-size: 8px !important;
            line-height: 10px !important;
            margin-top: 0 !important;
        }

    /*
         * Días sin órdenes.
         */
    .calendario-logistica-app .day-col {
        min-height: 0 !important;
        height: auto !important;
    }

    .calendario-logistica-app .day-slot {
        height: auto !important;
    }

    .calendario-logistica-app .empty-cell {
        min-height: 54px !important;
        height: auto !important;
        padding: 8px 7px !important;
        display: flex !important;
        align-items: flex-start !important;
        font-size: 10px !important;
        line-height: 13px !important;
    }

    /*
         * Si NO existe ninguna orden en todo el rango visible,
         * el calendario completo se hace compacto.
         */
    .calendario-logistica-app .calendar-board.calendar-empty .day-col,
    .calendario-logistica-app .calendar-board.calendar-empty .day-slot {
        min-height: 54px !important;
        height: 54px !important;
        max-height: 54px !important;
    }

    .calendario-logistica-app .calendar-board.calendar-empty .empty-cell {
        min-height: 54px !important;
        height: 54px !important;
        max-height: 54px !important;
        overflow: hidden !important;
    }

    /*
         * Si hay órdenes, se permite crecer normalmente con el contenido.
         */
    .calendario-logistica-app .calendar-board:not(.calendar-empty) .day-col,
    .calendario-logistica-app .calendar-board:not(.calendar-empty) .day-slot {
        height: auto !important;
        max-height: none !important;
    }

    #btn-nuevo-folio {
        background: #198754 !important;
        border-color: #198754 !important;
        color: #fff !important;
    }

        #btn-nuevo-folio:hover {
            background: #157347 !important;
            border-color: #146c43 !important;
            color: #fff !important;
        }

        #btn-nuevo-folio:focus,
        #btn-nuevo-folio:active {
            background: #146c43 !important;
            border-color: #13653f !important;
            color: #fff !important;
            box-shadow: 0 0 0 0.15rem rgba(25, 135, 84, 0.25) !important;
        }

    #btn-exportar-excel {
        background: #198754 !important;
        border-color: #198754 !important;
        color: #fff !important;
    }

        #btn-exportar-excel:hover {
            background: #157347 !important;
            border-color: #146c43 !important;
            color: #fff !important;
        }

        #btn-exportar-excel:disabled {
            opacity: .65 !important;
            cursor: not-allowed !important;
        }

    /* =============================================================
       TIPO DE VIAJE / SEMÁFORO
       Verde  = CONFIRMADO
       Amarillo = TENTATIVO
       Gris = SIN DEFINIR (registros anteriores)
       ============================================================= */
    .viaje-chip {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 3px 7px;
        border-radius: 999px;
        font-size: 9px;
        line-height: 1;
        font-weight: 800;
        white-space: nowrap;
        border: 1px solid transparent;
    }

    .viaje-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        display: inline-block;
        flex: 0 0 9px;
        box-shadow: 0 0 0 2px rgba(0,0,0,.06);
    }

    .viaje-confirmado {
        background: #e4f4e9;
        color: #146c43;
        border-color: #9fd0af;
    }

        .viaje-confirmado .viaje-dot {
            background: #198754;
        }

    .viaje-tentativo {
        background: #fff5d6;
        color: #7a5a00;
        border-color: #e6cd7d;
    }

        .viaje-tentativo .viaje-dot {
            background: #d39e00;
        }

    .viaje-sin-definir {
        background: #edf1f3;
        color: #5c6970;
        border-color: #c8d2d7;
    }

        .viaje-sin-definir .viaje-dot {
            background: #7d8a91;
        }

    .viaje-preview {
        margin-top: 5px;
        min-height: 20px;
        display: flex;
        align-items: center;
    }
</style>

<div class="cal-window calendario-logistica-app">
    <div class="cal-titlebar">
        <div>
            <i class="bi bi-calendar2-week"></i> Planeación de Transporte / Logística
            @*  <small>Órdenes de venta de MATRIZ por FechaEntrega</small> *@
        </div>
        <div id="title-clock"></div>
    </div>

    <div class="cal-content">

        <div class="section">
            <div class="section-title">Navegación y filtros</div>
            <div class="section-body">
                <div class="toolbar">
                    <div class="toolbar-group">
                        <div>
                            <label class="form-label">Vista</label>
                            <select id="vista-tipo" class="form-select" style="width:120px;">
                                <option value="week">Semana</option>
                                <option value="day">Día</option>
                            </select>
                        </div>

                        <div>
                            <label class="form-label">Ir a fecha de embarque</label>
                            <input type="date" id="fecha-base" class="form-control" style="width:155px;" />
                        </div>
                    </div>

                    <div class="toolbar-sep"></div>

                    <div class="toolbar-group">
                        <div>
                            <label class="form-label">Vendedor</label>
                            <select id="filtro-vendedor" class="form-select" style="width:190px;">
                                <option value="">Todos</option>
                            </select>
                        </div>

                        <div>
                            <label class="form-label">Estatus logística</label>
                            <select id="filtro-estatus" class="form-select" style="width:195px;">
                                <option value="">Todos</option>
                                <option value="RESERVADO VENTA">Reservado por venta</option>
                                <option value="PROGRAMADO">Programado</option>
                                <option value="PENDIENTE FLETERA">Pendiente fletera</option>
                                <option value="ASIGNADO">Asignado</option>
                                <option value="FLETERA CANCELADA">Fletera cancelada</option>
                                <option value="CANCELADO">Cancelado</option>
                            </select>
                        </div>
                    </div>

                    <div class="toolbar-sep"></div>

                    <div class="toolbar-group">
                        <div>
                            <label class="form-label">&nbsp;</label>
                            <div style="display:flex;gap:6px;">
                                <button type="button" class="btn-light" id="btn-prev"><i class="bi bi-chevron-left"></i> Anterior</button>
                                <button type="button" class="btn-light" id="btn-hoy"><i class="bi bi-calendar3"></i> Hoy</button>
                                <button type="button" class="btn-light" id="btn-next">Siguiente <i class="bi bi-chevron-right"></i></button>
                            </div>
                        </div>
                    </div>

                    <div class="toolbar-sep"></div>

                    <div class="toolbar-group">
                        <div>
                            <label class="form-label">&nbsp;</label>
                            <div style="display:flex;gap:6px;">
                                <button type="button" class="btn-main" id="btn-nuevo-folio"><i class="bi bi-plus-circle"></i> Solicitar transporte</button>
                                <button type="button" class="btn-main" id="btn-filtrar"><i class="bi bi-arrow-clockwise"></i> Actualizar</button>
                                <button type="button" class="btn-main" id="btn-exportar-excel"><i class="bi bi-file-earmark-excel"></i> Excel</button>
                                @*    <button type="button" class="btn-light" id="btn-reset"><i class="bi bi-x-circle"></i> Reset</button> *@
                            </div>
                        </div>
                    </div>
                </div>

                <div class="range-title" id="range-title"></div>
                <div class="loading-bar" id="loading-bar">Cargando planeación de transporte...</div>
            </div>
        </div>

        <div class="section">
            <div class="section-title">Resumen</div>
            <div class="section-body">
                <div class="kpis">
                    <div class="kpi-card kpi-ordenes">
                        <div class="kpi-title">Folios / embarques</div>
                        <div class="kpi-value" id="kpi-embarques">0</div>
                    </div>
                    <div class="kpi-card kpi-kilos">
                        <div class="kpi-title">Kg planeados / OV</div>
                        <div class="kpi-value" id="kpi-kilos">0</div>
                    </div>
                    <div class="kpi-card kpi-pendientes">
                        <div class="kpi-title">Pendiente fletera</div>
                        <div class="kpi-value" id="kpi-pendientes">0</div>
                    </div>
                    <div class="kpi-card kpi-asignados">
                        <div class="kpi-title">Con fletera</div>
                        <div class="kpi-value" id="kpi-asignados">0</div>
                    </div>
                    <div class="kpi-card kpi-cancelados">
                        <div class="kpi-title">Cancelados</div>
                        <div class="kpi-value" id="kpi-cancelados">0</div>
                    </div>
                </div>

                <div class="legend">
                    <div class="legend-item"><span class="legend-box lg-programado"></span> Reservado / programado</div>
                    <div class="legend-item"><span class="legend-box lg-pendiente"></span> Pendiente fletera</div>
                    <div class="legend-item"><span class="legend-box lg-asignado"></span> Asignado</div>
                    <div class="legend-item"><span class="legend-box lg-cancelado-fletera"></span> Fletera cancelada</div>
                    <div class="legend-item"><span class="legend-box lg-cancelado"></span> Cancelado</div>
                </div>
            </div>
        </div>

        <div class="section section-calendar">
            <div class="section-title">Calendario por fecha de embarque</div>
            <div class="section-body">
                <div class="calendar-wrap">
                    <div id="calendar-board" class="calendar-board"></div>
                </div>
            </div>
        </div>

        <div class="section">
            <div class="section-title">Listado rápido</div>
            <div class="section-body">
                <div class="listado-header">
                    <div class="listado-count" id="listado-count">0 folios en el rango</div>
                    <button type="button" class="btn-main" id="btn-ver-listado">
                        <i class="bi bi-list-ul"></i> Ver listado completo
                    </button>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- MODAL: AJUSTAR LOGÍSTICA -->
<div class="modal-mask" id="modal-mask">
    <div class="modal-box" style="width:min(1700px, calc(100vw - 28px)); max-height:calc(100vh - 28px); display:flex; flex-direction:column;">
        <div class="modal-title">
            <span id="modal-title">Ajustar logística</span>
            <button type="button" class="modal-close" id="btn-cancelar">✕</button>
        </div>

        <div class="modal-body">
            <div class="split-grid">
                <!-- BLOQUE ORDEN DE VENTA -->
                <div class="section" style="margin-bottom:0;">
                    <div class="section-title">Datos de la orden de venta</div>
                    <div class="section-body">
                        <div class="modal-grid">
                            <div>
                                <label class="form-label">Pedido / consecutivo</label>
                                <input type="text" id="m-consecutivo" class="form-control" readonly />
                            </div>

                            <div>
                                <label class="form-label">Serie</label>
                                <input type="text" id="m-serie" class="form-control" readonly />
                            </div>

                            <div>
                                <label class="form-label">Fecha entrega</label>
                                <input type="date" id="m-fecha" class="form-control" readonly />
                            </div>

                            <div>
                                <label class="form-label">Cliente</label>
                                <input type="text" id="m-cliente" class="form-control" readonly />
                            </div>

                            <div>
                                <label class="form-label">Vendedor</label>
                                <input type="text" id="m-vendedor" class="form-control" readonly />
                            </div>

                            <div>
                                <label class="form-label">Kg</label>
                                <input type="number" id="m-kilos" class="form-control" readonly />
                            </div>

                            <div>
                                <label class="form-label">Presentación</label>
                                <input type="text" id="m-presentacion" class="form-control" readonly />
                            </div>

                            <div class="full">
                                <label class="form-label">Ruta</label>
                                <div id="rutas-container"></div>
                            </div>

                            <div class="full">
                                <label class="form-label">Observación de venta</label>
                                <textarea id="m-observacion-venta" class="form-control" style="height:70px;" readonly></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- BLOQUE LOGISTICA -->
                <div class="section" style="margin-bottom:0;">
                    <div class="section-title">Datos de logística</div>
                    <div class="section-body">
                        <div class="modal-grid">
                            <div>
                                <label class="form-label">Fletera</label>
                                <input type="text" id="m-fletera" class="form-control" placeholder="Nombre de fletera" />
                            </div>

                            <div>
                                <label class="form-label">Estatus automático</label>
                                <input type="text" id="m-estatus-display" class="form-control" readonly />
                                <input type="hidden" id="m-estatus" />
                            </div>

                            <div class="full">
                                <label class="form-label">Destino</label>
                                <input type="text"
                                       id="m-destino"
                                       class="form-control"
                                       maxlength="200"
                                       placeholder="Ej. CEDIS TIJUANA, SUCURSAL MEXICALI, CLIENTE..." />
                            </div>

                            <div>
                                <label class="form-label">Tipo de viaje</label>
                                <select id="m-tipo-viaje" class="form-select">
                                    <option value="TENTATIVO">Tentativo</option>
                                    <option value="CONFIRMADO">Confirmado</option>
                                </select>
                            </div>

                            <div>
                                <label class="form-label">Semáforo</label>
                                <div id="m-tipo-viaje-preview" class="viaje-preview"></div>
                            </div>

                            <div>
                                <label class="form-label">Espacio de tarimas</label>
                                <input type="number" id="m-espacio-tarimas" class="form-control" min="0" />
                            </div>

                            <div>
                                <label class="form-label">Hora llegada de unidad</label>
                                <input type="time" id="m-hora-llegada" class="form-control" />
                            </div>

                            <div class="full">
                                <label class="form-label">Observación logística</label>
                                <textarea id="m-observacion-logistica" class="form-control" style="height:80px;" placeholder="Comentarios de logística, transporte, unidad, indicaciones..."></textarea>
                            </div>

                        </div>

                        <div style="display:flex; gap:8px; flex-wrap:wrap; margin-top:10px;">
                            @*   <button type="button" class="btn-orange-soft" id="btn-cancelar-fletera"><i class="bi bi-truck"></i> Cancelar fletera</button> *@
                            @* <button type="button" class="btn-danger-soft" id="btn-cancelar-registro"><i class="bi bi-ban"></i> Cancelar registro</button> *@
                        </div>

                        <div class="motivo-box" id="motivo-info" style="display:none;"></div>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal-actions">
            <button type="button" class="btn-light" id="btn-cancelar2"><i class="bi bi-x-lg"></i> Cancelar</button>
            <button type="button" class="btn-main" id="btn-guardar"><i class="bi bi-check2-square"></i> Guardar logística</button>
        </div>
    </div>
</div>

<!-- MODAL: MOTIVO DE CANCELACIÓN -->
<div class="modal-mask" id="modal-cancelacion-mask">
    <div class="modal-box" style="width:min(620px, 96vw);">
        <div class="modal-title">
            <span id="cancelacion-title">Cancelar</span>
            <button type="button" class="modal-close" id="btn-cerrar-cancelacion">✕</button>
        </div>

        <div class="modal-body">
            <div class="motivo-box" id="cancelacion-resumen" style="margin-top:0;"></div>

            <div style="margin-top:12px;">
                <label class="form-label">Motivo de cancelación</label>
                <textarea id="cancelacion-motivo"
                          class="form-control"
                          style="height:120px;"
                          placeholder="Captura el motivo obligatorio..."></textarea>
            </div>
        </div>

        <div class="modal-actions">
            <button type="button" class="btn-light" id="btn-cancelar-cancelacion"><i class="bi bi-x-lg"></i> Cerrar</button>
            <button type="button" class="btn-danger-soft" id="btn-confirmar-cancelacion"><i class="bi bi-exclamation-triangle"></i> Confirmar cancelación</button>
        </div>
    </div>
</div>

<!-- MODAL: LISTADO COMPLETO -->
<div class="modal-mask" id="modal-listado-mask">
    <div class="modal-box wide">
        <div class="modal-title">
            <span id="modal-listado-title">Listado de folios / embarques</span>
            <button type="button" class="modal-close" id="btn-cerrar-listado">✕</button>
        </div>
        <div class="modal-body">
            <div class="table-responsive">
                <table class="table-list">
                    <thead>
                        <tr>
                            <th>Fecha embarque</th>
                            <th>Folio / OV</th>
                            <th>Serie</th>
                            <th>Cliente</th>
                            <th>Destino</th>
                            <th>Viaje</th>
                            <th>Ruta</th>
                            <th>Vendedor</th>
                            <th>Presentación</th>
                            <th>Kg</th>
                            <th>Fletera</th>
                            <th>Estatus</th>
                            <th>Tarimas</th>
                            <th>Llegada unidad</th>
                            <th>Obs. logística</th>
                            <th>Motivo cancelación</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="tbody-listado"></tbody>
                </table>
            </div>
        </div>
        <div class="modal-actions">
            <button type="button" class="btn-light" id="btn-cerrar-listado2"><i class="bi bi-x-lg"></i> Cerrar</button>
        </div>
    </div>
</div>


<!-- =============================================================
     MODAL: SOLICITUD DE TRANSPORTE PREVIA A LA ORDEN DE VENTA
     El vendedor captura primero fecha + toneladas.
     ============================================================= -->
<div class="modal-mask" id="modal-solicitud-folio">
    <div class="modal-box" style="width:min(650px, 96vw);">
        <div class="modal-title">
            <span><i class="bi bi-truck"></i> Solicitud de transporte</span>
            <button type="button" class="modal-close" id="btn-cerrar-solicitud-folio">✕</button>
        </div>

        <div class="modal-body">
            <div class="modal-grid">
                <div>
                    <label class="form-label">Fecha para embarcar</label>
                    <input type="date" id="sol-fecha-embarque" class="form-control" />
                </div>

                <div>
                    <label class="form-label">Carga solicitada (kg)</label>
                    <input type="number"
                           id="sol-toneladas"
                           class="form-control"
                           min="1"
                           step="1"
                           placeholder="Ej. 8000" />
                </div>

                <div class="full">
                    <label class="form-label">Destino</label>
                    <input type="text"
                           id="sol-destino"
                           class="form-control"
                           maxlength="200"
                           placeholder="Ej. CEDIS TIJUANA, SUCURSAL MEXICALI, CLIENTE..." />
                </div>

                <div>
                    <label class="form-label">Tipo de viaje</label>
                    <select id="sol-tipo-viaje" class="form-select">
                        <option value="TENTATIVO" selected>Tentativo</option>
                        <option value="CONFIRMADO">Confirmado</option>
                    </select>
                </div>

                <div>
                    <label class="form-label">Semáforo</label>
                    <div id="sol-tipo-viaje-preview" class="viaje-preview"></div>
                </div>

                <div class="full">
                    <label class="form-label">Vendedor</label>
                    <input type="text"
                           id="sol-vendedor-nombre"
                           class="form-control"
                           value=""
                           placeholder="Se tomará automáticamente de tu usuario"
                           readonly />
                    <div class="form-text">
                        Se toma automáticamente del VendedorId ligado a tu usuario.
                    </div>
                </div>
            </div>

            <div class="motivo-box" id="sol-info" style="margin-top:12px;">
                Al guardar se genera un folio LOG. Después ese folio aparecerá en la Orden de Venta
                cuando coincidan fecha y vendedor.
            </div>
        </div>

        <div class="modal-actions">
            <button type="button" class="btn-light" id="btn-cancelar-solicitud-folio">
                <i class="bi bi-x-lg"></i> Cancelar
            </button>
            <button type="button" class="btn-main" id="btn-guardar-solicitud-folio">
                <i class="bi bi-check2-circle"></i> Generar folio
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const URL_GET_PEDIDOS = '@Url.Action("GetPedidosLogistica", "Calendario")';
            const URL_GUARDAR_LOGISTICA = '@Url.Action("GuardarLogistica", "Calendario")';
            const URL_PERMISOS_LOGISTICA = '@Url.Action("ObtenerPermisosLogisticaActual", "Calendario")';
            const URL_CREAR_FOLIO = '@Url.Action("CrearFolioLogistica", "Comercial")';
            const URL_VENDEDORES_FOLIO = '@Url.Action("ObtenerVendedoresLogisticaActual", "Comercial")';
            const URL_EXPORTAR_EXCEL = '@Url.Action("ExportarExcelLogistica", "Calendario")';

            const nombresDias = ['Domingo','Lunes','Martes','Miércoles','Jueves','Viernes','Sábado'];
            const nombresMeses = ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'];

            let currentEditId = null;
            let currentEditItem = null;
            let tipoCancelacionActual = null;
