                            ${x.tieneOv ? `<br><span class="badge-mini">${escapeHtml(x.consecutivo || '')}</span>` : '<br><span class="badge-mini">Sin OV</span>'}
                        </td>
                        <td>${escapeHtml(x.serie)}</td>
                        <td title="${escapeHtml(x.clienteCodigo || '')}">
                            ${escapeHtml(x.cliente || '')}
