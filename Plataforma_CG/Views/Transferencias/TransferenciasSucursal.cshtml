<div id="trToasts" class="tr-toasts" aria-live="polite"></div>

@section Scripts {
    <script>
        (() => {
            const $id = id => document.getElementById(id);
            const esc = v => String(v ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
            const getAntiForgeryToken = () => document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const fmtNum = (n, d = 2) => n == null ? '' : Number(n).toLocaleString('es-MX', { minimumFractionDigits: d, maximumFractionDigits: d });
            async function leerJson(res) { const raw = await res.text(); try { return { data: JSON.parse(raw), raw }; } catch { return { data: null, raw }; } }

            function showMsg(type, text, ms) {
                const cont = $id('trToasts');
                const icon = { success: 'bi-check-circle-fill', danger: 'bi-x-circle-fill', warning: 'bi-exclamation-triangle-fill', info: 'bi-info-circle-fill' }[type] || 'bi-info-circle-fill';
                const el = document.createElement('div');
                el.className = `tr-toast ${type}`;
                el.setAttribute('role', type === 'danger' ? 'alert' : 'status');
                // CORRECCIÓN: el texto del servidor se muestra como texto (antes se pintaba como HTML)
                el.innerHTML = `<i class="bi ${icon}"></i><span>${esc(text)}</span><button type="button" aria-label="Cerrar">×</button>`;
                el.querySelector('button').onclick = () => el.remove();
                cont.appendChild(el);
                const dur = ms ?? (type === 'danger' ? 9000 : 4000);
                if (dur > 0) setTimeout(() => el.remove(), dur);
            }

            const TEXTO = { 0: 'Cancelada', 1: 'Pendiente', 3: 'Pendiente', 2: 'Autorización presupuesto', 4: 'Validado', 5: 'Surtido' };
            const CLASE = { 0: 'tr-est-0', 1: 'tr-est-1', 3: 'tr-est-1', 2: 'tr-est-2', 4: 'tr-est-4', 5: 'tr-est-5' };
            const estatusTextoTr = e => TEXTO[Number(e)] || 'Otro';
            // CORRECCIÓN: fechas sin hora se toman tal cual (antes podían mostrarse un día antes por zona horaria)
            function toDateInputValue(s) {
                const m = String(s || '').match(/^(\d{4})-(\d{2})-(\d{2})/);
                if (m) return `${m[1]}-${m[2]}-${m[3]}`;
                const d = new Date(s);
                return isNaN(d) ? '' : `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
            }
            const filaDe = id => document.querySelector(`#tr-tbody tr[data-id="${CSS.escape(String(id))}"]`);

            let trIdActual = null, trEstatusAct = null, trFechaSolOriginal = null;

            // ---------- Resumen y filtro rápido ----------
            let filtroLocal = null;
            function actualizarResumen() {
                const filas = [...document.querySelectorAll('#tr-tbody tr[data-index]')];
                const cont = $id('trResumen');
                if (!filas.length) { cont.innerHTML = ''; return; }
                const porEst = {};
                let cajas = 0, kg = 0, vivas = 0;
                filas.forEach(tr => {
                    porEst[tr.dataset.estatus] = (porEst[tr.dataset.estatus] || 0) + 1;
                    if (tr.dataset.estatus !== '0' && tr.style.display !== 'none') { cajas += Number(tr.dataset.cajas || 0); kg += Number(tr.dataset.kg || 0); vivas++; }
                });
                const chips = ['1', '2', '4', '5', '0'].filter(e => porEst[e]).map(e => `<button type="button" class="tr-chip ${filtroLocal === e ? 'is-on' : ''}" data-est="${e}" aria-pressed="${filtroLocal === e}"><span class="badge-est ${CLASE[e]}" style="padding:0;background:none">${e === '2' ? 'Autorización' : TEXTO[e]}</span><b>${porEst[e]}</b></button>`).join('');
                cont.innerHTML = `<span><b>${filas.length}</b> transferencias</span><span class="sep"></span>${chips}<span class="sep"></span><span>Sin canceladas${filtroLocal ? ' (filtro en pantalla)' : ''}: <b>${vivas}</b> · <b>${fmtNum(cajas, 0)}</b> cajas · <b>${fmtNum(kg)}</b> kg</span>`;
            }
            $id('trResumen').addEventListener('click', e => {
                const chip = e.target.closest('.tr-chip');
                if (!chip) return;
                filtroLocal = filtroLocal === chip.dataset.est ? null : chip.dataset.est;
                document.querySelectorAll('#tr-tbody tr[data-index]').forEach(tr => tr.style.display = (!filtroLocal || tr.dataset.estatus === filtroLocal) ? '' : 'none');
                actualizarResumen();
            });

            // ---------- Modal ----------
            const modal = () => bootstrap.Modal.getOrCreateInstance($id('trModal'));
            function toggleCancelarBtnTr(estatus) {
                const btn = $id('btn-cancelar-tr');
                const cancelada = Number(estatus) === 0;
                btn.classList.toggle('d-none', cancelada);
                btn.disabled = cancelada;
            }
            function setFechaEditUI(show) {
                $id('btn-fecha-sol-save').classList.toggle('d-none', !show);
                $id('btn-fecha-sol-cancel').classList.toggle('d-none', !show);
            }
            function toggleEditarFechaPermitido(estatus) {
                const est = Number(estatus);
                const permitido = est === 1 || est === 2; // misma regla que antes
                $id('trm-fecha-sol-input').disabled = !permitido;
                $id('trm-fecha-sol-help').textContent = permitido ? 'Cambia la fecha y presiona ✓ para guardar.' : `No se puede cambiar en estatus "${estatusTextoTr(est)}".`;
                if (!permitido) setFechaEditUI(false);
                return permitido;
            }

            async function guardarFechaSolicitudActual() {
                if (!trIdActual) { showMsg('warning', 'No hay transferencia seleccionada.'); return; }
                const inp = $id('trm-fecha-sol-input');
                const nueva = inp.value;
                if (!nueva) { showMsg('warning', 'Selecciona una fecha válida.'); return; }
                if (nueva === trFechaSolOriginal) { setFechaEditUI(false); return; }
                const btnSave = $id('btn-fecha-sol-save'), btnCancel = $id('btn-fecha-sol-cancel');
                btnSave.disabled = btnCancel.disabled = true;
                try {
                    const res = await fetch('/Transferencias/ActualizarFechaSolicitud', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getAntiForgeryToken() },
                        body: JSON.stringify({ transferenciaId: Number(trIdActual), fechaSolicitud: nueva })
                    });
                    const { data, raw } = await leerJson(res);
                    if (!res.ok || !data?.ok) { showMsg('danger', data?.msg || raw.substring(0, 160) || 'No se pudo guardar la fecha.'); return; }
                    showMsg('success', data.msg || 'Fecha actualizada.');
                    trFechaSolOriginal = nueva;
                    setFechaEditUI(false);
                    // CORRECCIÓN: se actualiza el renglón en lugar de recargar toda la página
                    const tr = filaDe(trIdActual);
                    if (tr) { tr.querySelector('.td-fecha').textContent = nueva; tr.classList.remove('is-actualizada'); void tr.offsetWidth; tr.classList.add('is-actualizada'); }
                } catch (e) { console.error(e); showMsg('danger', 'No se pudo conectar con el servidor.'); }
                finally { btnSave.disabled = btnCancel.disabled = false; }
            }

            async function cancelarTransferenciaActual() {
                if (!trIdActual) { showMsg('warning', 'No hay transferencia seleccionada.'); return; }
                if (Number(trEstatusAct) === 0) { showMsg('warning', 'Esta transferencia ya está cancelada.'); return; }
                const cons = $id('trm-consecutivo').textContent || '';
                const aviso = Number(trEstatusAct) === 5 ? '\n\nATENCIÓN: esta transferencia ya está SURTIDA.' : '';
                if (!confirm(`¿Seguro que quieres CANCELAR la transferencia ${cons}?${aviso}`)) return;
                const btn = $id('btn-cancelar-tr');
                const html = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Cancelando…';
                try {
                    const res = await fetch('/Transferencias/Cancelar', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'RequestVerificationToken': getAntiForgeryToken() },
                        body: JSON.stringify({ transferenciaId: Number(trIdActual) })
                    });
                    const { data, raw } = await leerJson(res);
                    if (!res.ok || data?.ok === false) {
                        console.error('Error al cancelar transferencia:', { status: res.status, raw, data });
                        showMsg('danger', data?.msg || raw.substring(0, 300) || `No se pudo cancelar. HTTP ${res.status}`);
                        return;
                    }
                    showMsg('success', data?.msg || 'Transferencia cancelada.');
                    trEstatusAct = 0;
                    const est = $id('trm-estatus');
                    est.textContent = 'Cancelada'; est.className = 'badge-est tr-est-0';
                    toggleEditarFechaPermitido(0);
                    const tr = filaDe(trIdActual);
                    if (tr) {
                        tr.querySelector('.td-estatus').innerHTML = '<span class="badge-est tr-est-0">Cancelada</span>';
                        tr.dataset.estatus = '0';
                        tr.classList.add('is-cancelada');
                        actualizarResumen();
                    }
                    modal().hide();
                } catch (e) { console.error(e); showMsg('danger', 'No se pudo conectar con el servidor. Revisa el estatus antes de reintentar.'); }
                finally { btn.innerHTML = html; toggleCancelarBtnTr(trEstatusAct); }
            }

            const escapeRegExp = s => (s ?? '').replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
            function soloNombreProducto(nombre, codigo) {
                const d = (nombre ?? '').trim(), c = (codigo ?? '').trim();
                if (!d) return '';
                if (c) {
                    const m = d.match(new RegExp('^' + escapeRegExp(c) + '\\s*\\((.*)\\)\\s*$', 'i'));
                    if (m && m[1]) return m[1].trim();
                    return d.replace(new RegExp('^' + escapeRegExp(c) + '\\s*[-–—:]?\\s*', 'i'), '').trim();
                }
                const m2 = d.match(/^\((.*)\)$/);
                return (m2 && m2[1]) ? m2[1].trim() : d;
            }

            // Tabla única: une líneas pedidas + surtido por SKU (misma lógica)
            let cargandoId = null;
            async function cargarDetalleTr(id, consecutivo) {
                cargandoId = id;
                const compTbody = $id('trm-comp-tbody');
                compTbody.innerHTML = '<tr class="t-msg"><td colspan="12">Cargando…</td></tr>';
                $id('trmKpis').innerHTML = '';
                $id('trm-consecutivo').textContent = consecutivo || '';
                try {
                    const resp = await fetch(`/Transferencias/DetalleApi?id=${encodeURIComponent(id)}`, { cache: 'no-store' });
                    if (!resp.ok) throw new Error('HTTP ' + resp.status);
                    const payload = await resp.json();
                    if (cargandoId !== id) return;
                    const h = payload.header || {}, lineas = payload.lineas || [], surtido = payload.surtido || [];
                    trIdActual = h.id || id;
                    trEstatusAct = Number(h.estatus);

                    $id('trm-consecutivo').textContent = h.consecutivo || consecutivo || '';
                    $id('trm-id').textContent = trIdActual || '';
                    $id('trm-sucursal').textContent = h.sucursalNombre || h.sucursal || '';
                    $id('trm-usuario').textContent = h.usuarioSolicita || '';
                    const est = $id('trm-estatus');
                    est.textContent = estatusTextoTr(h.estatus);
                    est.className = 'badge-est ' + (CLASE[Number(h.estatus)] || '');
                    const obs = String(h.observacion || '').trim();
                    $id('trm-obs').textContent = obs || 'Sin observación.';
                    $id('trm-obs').classList.toggle('vacia', !obs);
                    const inp = $id('trm-fecha-sol-input');
                    inp.value = toDateInputValue(h.fechaSolicitud);
                    trFechaSolOriginal = inp.value;
                    setFechaEditUI(false);
                    toggleCancelarBtnTr(trEstatusAct);
                    toggleEditarFechaPermitido(trEstatusAct);

                    const normSku = s => (s ?? '').toString().trim().toUpperCase();
                    const nuevo = (sku, cod, nom) => ({ sku, productoCodigo: cod || sku, productoNombre: nom || '', kgPedido: 0, cajasPedido: 0, kgConfirmadas: 0, cajasConfirmadas: 0, kgSurtido: 0, cajasSurtidas: 0, etiquetas: 0, kgEscaneado: 0 });
                    const map = new Map();
                    lineas.forEach(l => {
                        const sku = normSku(l.productoCodigo);
                        if (!sku) return;
                        const ex = map.get(sku) || nuevo(sku, l.productoCodigo, l.productoNombre);
                        if (!ex.productoNombre && l.productoNombre) ex.productoNombre = l.productoNombre;
                        ex.kgPedido += Number(l.cantidadKg || l.cantidad || 0);
                        ex.cajasPedido += Number(l.cajas || 0);
                        ex.kgConfirmadas += Number(l.kgConfirmadas || l.kilosConfirmados || l.cantidadKgConfirmada || 0);
                        ex.cajasConfirmadas += Number(l.cajasConfirmadas || l.cajasConfirmadasTotal || l.cajasConfirmada || 0);
                        map.set(sku, ex);
                    });
                    surtido.forEach(s => {
                        const sku = normSku(s.sku);
                        if (!sku) return;
                        const ex = map.get(sku) || nuevo(sku);
                        ex.kgSurtido += Number(s.kgSurtido || 0);
                        ex.cajasSurtidas += Number(s.cajasSurtidas || 0);
                        ex.etiquetas += Number(s.etiquetas || 0);
                        ex.kgEscaneado += Number(s.kgEscaneado || 0);
                        map.set(sku, ex);
                    });
                    const seen = new Set(), rows = [];
                    lineas.map(x => normSku(x.productoCodigo)).filter(Boolean).forEach(sku => { if (!seen.has(sku) && map.has(sku)) { seen.add(sku); rows.push(map.get(sku)); } });
                    for (const [sku, obj] of map.entries()) if (!seen.has(sku)) rows.push(obj);

                    let t = { kgPed: 0, cajPed: 0, kgConf: 0, cajConf: 0, kgSur: 0, cajSur: 0 };
                    const conteo = { COMPLETO: 0, INCOMPLETO: 0, 'NO SURTIDO': 0, otro: 0 };
                    const difClass = v => v < 0 ? 'dif-neg' : v > 0 ? 'dif-pos' : '';
                    compTbody.innerHTML = rows.length ? rows.map((r, i) => {
                        const difKg = (r.kgSurtido || 0) - (r.kgConfirmadas || 0);
                        const difCaj = (r.cajasSurtidas || 0) - (r.cajasConfirmadas || 0);
                        t.kgPed += r.kgPedido; t.cajPed += r.cajasPedido; t.kgConf += r.kgConfirmadas; t.cajConf += r.cajasConfirmadas; t.kgSur += r.kgSurtido; t.cajSur += r.cajasSurtidas;
                        const baseCajas = r.cajasConfirmadas || 0, baseKg = r.kgConfirmadas || 0;
                        const estado = baseCajas > 0 ? (r.cajasSurtidas >= baseCajas ? 'COMPLETO' : (r.cajasSurtidas > 0 ? 'INCOMPLETO' : 'NO SURTIDO'))
                            : baseKg > 0 ? (r.kgSurtido >= baseKg ? 'COMPLETO' : (r.kgSurtido > 0 ? 'INCOMPLETO' : 'NO SURTIDO'))
                                : ((r.kgSurtido > 0 || r.cajasSurtidas > 0) ? 'SURTIDO SIN CONF.' : 'SIN CONFIRMAR');
                        if (conteo[estado] !== undefined) conteo[estado]++; else conteo.otro++;
                        const clsEstado = estado === 'COMPLETO' ? 'estado-completo' : estado === 'INCOMPLETO' ? 'estado-incompleto' : estado === 'NO SURTIDO' ? 'estado-no-surtido' : 'estado-sin-confirmar';
                        const nd = (v, d) => `data-copy="${Math.round(v * 1000) / 1000}"`;
                        return `<tr>
                                    <td>${i + 1}</td>
                                    <td>${esc(r.sku)}</td>
                                    <td>${esc(soloNombreProducto(r.productoNombre, r.productoCodigo))}</td>
                                    <td class="text-end" ${nd(r.kgPedido)}>${fmtNum(r.kgPedido, 2)}</td>
                                    <td class="text-end" ${nd(r.cajasPedido)}>${fmtNum(r.cajasPedido, 0)}</td>
                                    <td class="text-end col-conf" ${nd(r.kgConfirmadas)}>${fmtNum(r.kgConfirmadas, 2)}</td>
                                    <td class="text-end col-conf" ${nd(r.cajasConfirmadas)}>${fmtNum(r.cajasConfirmadas, 0)}</td>
                                    <td class="text-end" ${nd(r.kgSurtido)}>${fmtNum(r.kgSurtido, 2)}</td>
                                    <td class="text-end" ${nd(r.cajasSurtidas)}>${fmtNum(r.cajasSurtidas, 0)}</td>
                                    <td class="text-end ${difClass(difKg)}" ${nd(difKg)}>${fmtNum(difKg, 2)}</td>
                                    <td class="text-end ${difClass(difCaj)}" ${nd(difCaj)}>${fmtNum(difCaj, 0)}</td>
                                    <td class="${clsEstado}"><span class="estado-pill">${estado}</span></td>
                                </tr>`;
                    }).join('') : '<tr class="t-msg"><td colspan="12">Sin artículos.</td></tr>';

                    $id('trm-tot-kg-ped').textContent = fmtNum(t.kgPed, 2);
                    $id('trm-tot-caj-ped').textContent = fmtNum(t.cajPed, 0);
                    $id('trm-tot-kg-conf').textContent = fmtNum(t.kgConf, 2);
                    $id('trm-tot-caj-conf').textContent = fmtNum(t.cajConf, 0);
                    $id('trm-tot-kg-sur').textContent = fmtNum(t.kgSur, 2);
                    $id('trm-tot-caj-sur').textContent = fmtNum(t.cajSur, 0);
                    $id('trm-tot-dif-kg').textContent = fmtNum(t.kgSur - t.kgConf, 2);
                    $id('trm-tot-dif-caj').textContent = fmtNum(t.cajSur - t.cajConf, 0);

                    // Resumen rápido del surtido
                    const pct = t.cajConf > 0 ? t.cajSur * 100 / t.cajConf : (t.kgConf > 0 ? t.kgSur * 100 / t.kgConf : null);
                    const nivel = pct == null ? '' : pct >= 100 ? 'ok' : pct >= 97 ? 'warn' : 'bad';
                    $id('trmKpis').innerHTML = `
                                <div class="tr-kpi ${nivel}"><div class="t">Cumplimiento</div><div class="v">${pct == null ? '—' : fmtNum(pct, 1) + '%'}</div><div class="s">Surtido ÷ confirmado</div></div>
                                <div class="tr-kpi ok"><div class="t">SKU completos</div><div class="v">${conteo.COMPLETO}</div><div class="s">de ${rows.length}</div></div>
                                <div class="tr-kpi ${conteo.INCOMPLETO ? 'warn' : ''}"><div class="t">SKU incompletos</div><div class="v">${conteo.INCOMPLETO}</div><div class="s">Surtido parcial</div></div>
                                <div class="tr-kpi ${conteo['NO SURTIDO'] ? 'bad' : ''}"><div class="t">SKU sin surtir</div><div class="v">${conteo['NO SURTIDO']}</div><div class="s">${conteo.otro ? conteo.otro + ' sin confirmar' : 'Confirmados sin surtido'}</div></div>`;

                    modal().show(); // CORRECCIÓN: se reutiliza el modal (antes se creaba uno nuevo cada vez)
                } catch (e) {
                    console.error(e);
                    compTbody.innerHTML = '<tr class="t-msg"><td colspan="12" style="color:var(--es-bad)">Error al cargar el detalle.</td></tr>';
                    modal().show();
                }
            }

            $id('tr-tbody').addEventListener('click', ev => {
                const a = ev.target.closest('a.ver-tr');
                if (!a) return;
                ev.preventDefault();
                if (a.dataset.id) cargarDetalleTr(a.dataset.id, a.dataset.cons || a.textContent.trim());
            });

            // ---------- Filtros de selección múltiple ----------
            const normTxt = s => (s ?? '').toString().normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
            function initMultiDropdown(rootId, checkClass, hiddenId, hiddenName, vacio) {
                const root = $id(rootId);
                if (!root) return null;
                const label = root.querySelector('.multi-label'), btn = root.querySelector('.btn-select-like');
                const checks = [...root.querySelectorAll('.' + checkClass)];
                const hidden = $id(hiddenId);
                function refresh() {
                    hidden.innerHTML = '';
                    const texts = [];
                    checks.forEach(ch => {
                        if (!ch.checked) return;
                        texts.push(ch.dataset.text || ch.value);
                        // CORRECCIÓN: "Pendiente" manda también el estatus 3 (data-extra); antes se ignoraba
                        // y las transferencias en estatus 3 desaparecían al volver a filtrar.
                        [ch.value, ...(ch.dataset.extra ? ch.dataset.extra.split(',') : [])].forEach(v => {
                            const inp = document.createElement('input');
                            inp.type = 'hidden'; inp.name = hiddenName; inp.value = v.trim();
                            hidden.appendChild(inp);
                        });
                    });
                    label.textContent = !texts.length ? vacio : texts.length <= 2 ? texts.join(', ') : `${texts.length} seleccionados`;
                    btn.classList.toggle('has-value', texts.length > 0);
                }
                checks.forEach(ch => ch.addEventListener('change', refresh));
                root.querySelector('[data-todos]')?.addEventListener('click', () => { checks.forEach(c => { if (c.closest('.multi-picker-option').style.display !== 'none') c.checked = true; }); refresh(); });
                root.querySelector('[data-ninguno]')?.addEventListener('click', () => { checks.forEach(c => c.checked = false); refresh(); });
                const search = root.querySelector('.multi-picker-search');
                search?.addEventListener('input', () => {
                    const words = normTxt(search.value).split(/\s+/).filter(Boolean);
                    root.querySelectorAll('.multi-picker-option').forEach(opt => {
                        const t = normTxt(`${opt.innerText} ${opt.querySelector('input')?.value || ''}`);
                        opt.style.display = words.every(w => t.includes(w)) ? 'flex' : 'none';
                    });
                });
                root.addEventListener('shown.bs.dropdown', () => setTimeout(() => { search?.focus(); search?.select(); }, 0));
                refresh();
                return { refresh };
            }
            const ddSuc = initMultiDropdown('dd-sucursal-tr', 'multi-check-sucursal-tr', 'dd-sucursal-tr-hidden', 'SucursalesSeleccionadas', 'Todas');
            const ddEst = initMultiDropdown('dd-estatus-tr', 'multi-check-estatus-tr', 'dd-estatus-tr-hidden', 'EstatusSeleccionados', 'Todos');
            $id('frmTransferencias').addEventListener('submit', () => { ddSuc?.refresh(); ddEst?.refresh(); });

            // ---------- Ordenar ----------
            const ths = [...document.querySelectorAll('#trTabla thead th')];
            const sortState = { index: null, dir: null };
            function valorCelda(tr, i, type) {
                const td = tr.children[i];
                const v = (td?.dataset.copy ?? td?.innerText ?? '').trim();
                if (type === 'num') { const n = parseFloat(v.replace(/[^\d.-]/g, '')); return isNaN(n) ? 0 : n; }
                if (type === 'date') return v || '0000';
                if (i === 0) return v.toUpperCase().replace(/\d+/g, d => d.padStart(12, '0')); // consecutivo en orden natural
                return v.toUpperCase();
            }
            ths.forEach((th, index) => {
                if (!th.dataset.sortCol) return;
                th.addEventListener('click', () => {
                    if (sortState.index === index) { sortState.dir = sortState.dir === 'asc' ? 'desc' : sortState.dir === 'desc' ? null : 'asc'; if (!sortState.dir) sortState.index = null; }
                    else { sortState.index = index; sortState.dir = 'asc'; }
                    const tbody = $id('tr-tbody');
                    const rows = [...tbody.querySelectorAll('tr[data-index]')];
                    if (sortState.index == null) rows.sort((a, b) => a.dataset.index - b.dataset.index);
                    else {
                        const type = ths[sortState.index].dataset.sortType || 'text';
                        rows.sort((a, b) => { const va = valorCelda(a, sortState.index, type), vb = valorCelda(b, sortState.index, type); return va < vb ? -1 : va > vb ? 1 : 0; });
                        if (sortState.dir === 'desc') rows.reverse();
                    }
                    rows.forEach(r => tbody.appendChild(r));
                    ths.forEach((h, i) => { h.classList.toggle('asc', i === sortState.index && sortState.dir === 'asc'); h.classList.toggle('desc', i === sortState.index && sortState.dir === 'desc'); h.setAttribute('aria-sort', i === sortState.index ? (sortState.dir === 'asc' ? 'ascending' : 'descending') : 'none'); });
                });
            });

            // ---------- Eventos del modal ----------
            $id('btn-cancelar-tr').addEventListener('click', ev => { ev.preventDefault(); cancelarTransferenciaActual(); });
            const inpFecha = $id('trm-fecha-sol-input');
            inpFecha.addEventListener('change', () => { if (!inpFecha.disabled) setFechaEditUI(!!inpFecha.value && inpFecha.value !== trFechaSolOriginal); });
            inpFecha.addEventListener('keydown', e => { if (e.key === 'Enter' && !$id('btn-fecha-sol-save').classList.contains('d-none')) { e.preventDefault(); guardarFechaSolicitudActual(); } });
            $id('btn-fecha-sol-save').addEventListener('click', ev => { ev.preventDefault(); guardarFechaSolicitudActual(); });
            $id('btn-fecha-sol-cancel').addEventListener('click', ev => { ev.preventDefault(); inpFecha.value = trFechaSolOriginal || ''; setFechaEditUI(false); });

            actualizarResumen();
        })();
    </script>
}
