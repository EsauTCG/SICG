            top: 0;
            z-index: 1;
            padding: 8px 10px;
            background: var(--es-head);
            border-bottom: 1px solid var(--es-line);
            color: var(--es-muted);
            font-size: 11.5px;
            font-weight: 600;
            white-space: nowrap;
        }

            .trm-sap thead th.col-conf {
                background: #f7f1e1;
            }

    body[data-theme="dark"] .trm-sap thead th.col-conf {
        background: #2e2c22;
    }

    .trm-sap tbody td {
        padding: 6px 10px;
        border-bottom: 1px solid var(--es-row-line);
        background: var(--es-surface);
        white-space: nowrap;
        vertical-align: middle;
    }

        .trm-sap tbody td.col-conf {
            background: var(--es-accent-col);
            font-weight: 600;
        }

        .trm-sap tbody td:nth-child(2) {
            font-weight: 600;
        }

        .trm-sap tbody td:nth-child(3) {
            white-space: normal;
            min-width: 240px;
        }

    .trm-sap tbody tr:hover td {
        background: var(--es-hover);
    }

    .trm-sap tfoot th {
        position: sticky;
        bottom: 0;
        padding: 9px 10px;
        background: var(--es-head);
        border-top: 1px solid var(--es-line);
        font-weight: 700;
        font-variant-numeric: tabular-nums;
    }

    .trm-sap td.dif-neg {
        color: var(--es-bad);
        font-weight: 700;
    }

    .trm-sap td.dif-pos {
        color: var(--es-warn);
        font-weight: 700;
    }

    .estado-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 2px 9px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .02em;
    }

    .estado-completo .estado-pill {
        background: var(--es-ok-bg);
        color: var(--es-ok);
    }

    .estado-incompleto .estado-pill {
        background: var(--es-warn-bg);
        color: var(--es-warn);
    }

    .estado-no-surtido .estado-pill {
        background: var(--es-bad-bg);
        color: var(--es-bad);
    }

    .estado-sin-confirmar .estado-pill {
        background: var(--es-neutral-bg);
        color: var(--es-muted);
    }

    .tr-toasts {
        position: fixed;
        top: 16px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 2100;
        display: flex;
        flex-direction: column;
        gap: 8px;
        width: min(620px, 92vw);
        pointer-events: none;
    }

    .tr-toast {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 11px 14px;
        border-radius: 10px;
        background: var(--es-surface);
        border: 1px solid var(--es-line);
        border-left: 4px solid var(--c, var(--es-info));
        box-shadow: 0 12px 30px rgba(0,0,0,.18);
        pointer-events: auto;
        animation: tr-in .16s ease-out;
    }

        .tr-toast i {
            color: var(--c);
            font-size: 16px;
            margin-top: 1px;
        }

        .tr-toast span {
            flex: 1;
        }

        .tr-toast button {
            border: 0;
            background: none;
            color: var(--es-muted);
            font-size: 16px;
            line-height: 1;
            cursor: pointer;
        }

        .tr-toast.success {
            --c: var(--es-ok);
        }

        .tr-toast.danger {
            --c: var(--es-bad);
        }

        .tr-toast.warning {
            --c: var(--es-warn);
        }

        .tr-toast.info {
            --c: var(--es-info);
        }

    @@keyframes tr-in {
        from {
            opacity: 0;
            transform: translateY(-6px);
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .tr-toast, .tr-grid tbody tr.is-actualizada > td {
            animation: none;
        }
    }

    @@media (max-width: 1200px) {
        .filters {
            grid-template-columns: 1fr 1fr 1fr;
        }

        .pm-actions {
            grid-column: 1 / -1;
            justify-content: flex-end;
        }
    }

    @@media (max-width: 760px) {
        .trx {
            height: auto;
            overflow: visible;
        }

        .table-card {
            min-height: 520px;
        }

        .filters, .tr-datos, .tr-kpis {
            grid-template-columns: 1fr 1fr;
        }
    }
</style>

<div class="trx window transferencias-app">
    <header class="tr-header">
        <span class="tr-header__icon"><i class="bi bi-arrow-left-right"></i></span>
        <div>
            <h1>Transferencias</h1>
            <p>Solicitudes de traspaso entre sucursales: lo pedido, lo confirmado y lo surtido por SKU.</p>
        </div>
    </header>

    <section class="tr-card tr-filters">
        <form id="frmTransferencias" method="get">
            <div class="filters">
                <div class="filter-group">
                    <label for="f-desde">Desde</label>
                    <input type="date" id="f-desde" name="Desde" value="@desdeDef" />
                </div>
                <div class="filter-group">
                    <label for="f-hasta">Hasta</label>
                    <input type="date" id="f-hasta" name="Hasta" value="@hastaDef" />
                </div>
                <div class="filter-group">
                    <label for="dd-sucursal-btn">Sucursal</label>
                    <div class="dropdown w-100" id="dd-sucursal-tr">
                        <button class="btn-select-like w-100 @(sucSel.Any() ? "has-value" : "")" id="dd-sucursal-btn" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                            <span class="multi-label">@TextoSucursalesFiltro(sucSel)</span>
                        </button>
                        <div class="dropdown-menu multi-picker-menu" onclick="event.stopPropagation();">
                            <input type="text" class="form-control multi-picker-search" placeholder="Buscar sucursal…" autocomplete="off" aria-label="Buscar sucursal" />
                            <div class="multi-picker-list">
                                @if (Model?.Sucursales != null)
                                {
                                    foreach (var s in Model.Sucursales)
                                    {
                                        var text = string.IsNullOrWhiteSpace(s.Nombre) ? s.Codigo : s.Nombre;
                                        <label class="multi-picker-option">
                                            <input class="multi-check-sucursal-tr" type="checkbox" value="@s.Codigo" data-text="@s.Codigo" @(sucSel.Contains(s.Codigo) ? "checked" : null) />
                                            <span>@text</span>
                                        </label>
                                    }
                                }
                            </div>
                            <div class="multi-picker-tools"><button type="button" data-todos>Marcar visibles</button><button type="button" data-ninguno>Ninguna</button></div>
                        </div>
                        <div id="dd-sucursal-tr-hidden">
                            @foreach (var s in sucSel)
                            {
                                <input type="hidden" name="SucursalesSeleccionadas" value="@s" />
                            }
                        </div>
                    </div>
                </div>
                <div class="filter-group">
                    <label for="dd-estatus-btn">Estatus</label>
                    <div class="dropdown w-100" id="dd-estatus-tr">
                        <button class="btn-select-like w-100 @(ests.Any() ? "has-value" : "")" id="dd-estatus-btn" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                            <span class="multi-label">@TextoEstatusFiltro(ests)</span>
                        </button>
                        <div class="dropdown-menu multi-picker-menu" onclick="event.stopPropagation();">
                            <input type="text" class="form-control multi-picker-search" placeholder="Buscar estatus…" autocomplete="off" aria-label="Buscar estatus" />
                            <div class="multi-picker-list">
                                <label class="multi-picker-option"><input class="multi-check-estatus-tr" type="checkbox" value="1" data-extra="3" data-text="Pendiente" @(ests.Contains(1) || ests.Contains(3) ? "checked" : null) /><span class="badge-est tr-est-1">Pendiente</span></label>
                                <label class="multi-picker-option"><input class="multi-check-estatus-tr" type="checkbox" value="2" data-text="Autorización" @(ests.Contains(2) ? "checked" : null) /><span class="badge-est tr-est-2">Autorización</span></label>
                                <label class="multi-picker-option"><input class="multi-check-estatus-tr" type="checkbox" value="4" data-text="Validado" @(ests.Contains(4) ? "checked" : null) /><span class="badge-est tr-est-4">Validado</span></label>
                                <label class="multi-picker-option"><input class="multi-check-estatus-tr" type="checkbox" value="5" data-text="Surtido" @(ests.Contains(5) ? "checked" : null) /><span class="badge-est tr-est-5">Surtido</span></label>
                                <label class="multi-picker-option"><input class="multi-check-estatus-tr" type="checkbox" value="0" data-text="Cancelada" @(ests.Contains(0) ? "checked" : null) /><span class="badge-est tr-est-0">Cancelada</span></label>
                            </div>
                            <div class="multi-picker-tools"><button type="button" data-todos>Todos</button><button type="button" data-ninguno>Ninguno</button></div>
                        </div>
                        <div id="dd-estatus-tr-hidden">
                            @foreach (var e in ests)
                            {
                                <input type="hidden" name="EstatusSeleccionados" value="@e" />
                            }
                        </div>
                    </div>
                </div>
                <div class="filter-group">
                    <label for="f-buscar">Buscar</label>
                    <input type="text" id="f-buscar" name="Buscar" value="@(Model?.Buscar ?? "")" placeholder="Consecutivo, SKU u observación" />
                </div>
                <div class="pm-actions">
                    <button class="pm-btn pm-btn-primary" type="submit"><i class="bi bi-search"></i><span>Aplicar</span></button>
                    <button class="pm-btn" type="submit" form="frmTransferencias" name="Export" value="xlsx"><i class="bi bi-file-earmark-excel" style="color:var(--es-ok)"></i><span>Exportar a Excel</span></button>
                </div>
            </div>
        </form>
    </section>

    <div class="tr-resumen" id="trResumen" aria-live="polite"></div>

    @Html.AntiForgeryToken()

    <section class="table-card">
        <div class="table-responsive-sticky">
            <table class="table tr-grid" id="trTabla">
                <thead>
                    <tr>
                        <th data-sort-col="cons" data-sort-type="text">Consecutivo<span class="sort-ind"></span></th>
                        <th data-sort-col="suc" data-sort-type="text">Sucursal<span class="sort-ind"></span></th>
                        <th class="text-end" data-sort-col="cajas" data-sort-type="num">Total cajas<span class="sort-ind"></span></th>
                        <th class="text-end" data-sort-col="kg" data-sort-type="num">Total kg<span class="sort-ind"></span></th>
                        <th data-sort-col="sol" data-sort-type="text">Solicita<span class="sort-ind"></span></th>
                        <th data-sort-col="obs" data-sort-type="text">Observación<span class="sort-ind"></span></th>
                        <th data-sort-col="fsol" data-sort-type="date">Fecha embarque<span class="sort-ind"></span></th>
                        <th data-sort-col="est" data-sort-type="text">Estatus<span class="sort-ind"></span></th>
                    </tr>
                </thead>
                <tbody id="tr-tbody">
                    @if (resultadosOrdenados != null && resultadosOrdenados.Any())
                    {
                        var idx = 0;
                        foreach (var t in resultadosOrdenados)
                        {
                            var estVal = t?.Estatus ?? -1;
                            var estGrupo = estVal == 3 ? 1 : estVal;
                            var estClass = estVal == 0 ? "tr-est-0" : (estVal == 1 || estVal == 3) ? "tr-est-1" : estVal == 2 ? "tr-est-2" : estVal == 4 ? "tr-est-4" : estVal == 5 ? "tr-est-5" : "";
                            var texto = estVal == 0 ? "Cancelada" : (estVal == 1 || estVal == 3) ? "Pendiente" : estVal == 2 ? "Autorización presupuesto" : estVal == 4 ? "Validado" : estVal == 5 ? "Surtido" : "Otro";
                            <tr data-index="@idx" data-id="@(t?.Id)" data-estatus="@estGrupo" data-cajas="@(t?.TotalCajas ?? 0)" data-kg="@((t?.TotalKg ?? 0m).ToString(inv))" class="@(estVal == 0 ? "is-cancelada" : "")">
                                <td><a href="#" class="ver-tr" data-id="@(t?.Id)" data-cons="@(t?.Consecutivo ?? "")">@(t?.Consecutivo ?? "")</a></td>
                                <td>@(t?.SucursalNombre ?? "")</td>
                                <td class="text-end" data-copy="@(t?.TotalCajas ?? 0)">@((t?.TotalCajas ?? 0).ToString("N0"))</td>
                                <td class="text-end" data-copy="@((t?.TotalKg ?? 0m).ToString("0.##", inv))">@((t?.TotalKg ?? 0m).ToString("N2"))</td>
                                <td>@(t?.UsuarioSolicita ?? "")</td>
                                <td class="td-obs" title="@(t?.Observacion ?? "")">@(t?.Observacion ?? "")</td>
                                <td class="td-fecha">@(t?.FechaSolicitud?.ToString("yyyy-MM-dd") ?? "")</td>
                                <td class="td-estatus"><span class="badge-est @estClass">@texto</span></td>
                            </tr>
                            idx++;
                        }
                    }
                    else
                    {
                        <tr class="t-msg"><td colspan="8">Sin transferencias con estos filtros.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <footer class="statusbar">
        <span>Usuario: @(User?.Identity?.Name ?? "")</span>
        <span>Carnes G SA de CV</span>
        <span>Módulo: Transferencias</span>
        <span>Clic derecho sobre una tabla para copiarla a Excel</span>
    </footer>
</div>

<!-- Modal fuera de la tabla (antes vivía dentro y había que moverlo con código) -->
