</style>

<div class="rmx window romaneo-transferencias-app">

    <!-- ===================== Encabezado de impresión ===================== -->
    <div class="print-only">
        <div class="print-top">
            <div class="print-logo"><img src="@logoUrl" alt="SIGO" /></div>
            <div class="print-title">
                <div class="t1">Embarque concentrado por tarima</div>
                <div class="t2">Información concentrada de cada transferencia surtida, agrupada por tarima.</div>
            </div>
            <div class="print-meta">
                <div><b>Fecha inicial:</b> @(Model?.Desde?.ToString("dd/MM/yyyy") ?? "")</div>
                <div><b>Fecha final:</b> @(Model?.Hasta?.ToString("dd/MM/yyyy") ?? "")</div>
                <div><b>Destino:</b> @(destSel.Any() ? string.Join(", ", destSel) : "TODOS")</div>
                <div><b>Transferencia:</b> @(pedSel.Any() ? string.Join(", ", pedSel) : "TODAS")</div>
                <div><b>Tarima:</b> @(tarSel.Any() ? string.Join(", ", tarSel) : "TODAS")</div>
                @if (!string.IsNullOrWhiteSpace(codigoEtiquetaDef))
                {
                    <div><b>Etiqueta:</b> @codigoEtiquetaDef</div>
                }
                <div><b>Impreso:</b> @DateTime.Now.ToString("dd/MM/yyyy HH:mm") · @(User?.Identity?.Name ?? "")</div>
            </div>
        </div>
        <div class="print-kpis">
            <div class="kpi-box"><b>@totalTransferencias</b><span>Transferencias</span></div>
            <div class="kpi-box"><b>@totalTarimas</b><span>Tarimas</span></div>
            <div class="kpi-box"><b>@totalCajasGlobal.ToString("N0")</b><span>Cajas surtidas</span></div>
            <div class="kpi-box"><b>@totalPesoGlobal.ToString("N0") kg</b><span>Kilogramos surtidos</span></div>
        </div>
    </div>

    <!-- ===================== Encabezado de pantalla ===================== -->
    <header class="rm-header no-print">
        <div class="rm-header__title">
            <span class="rm-header__icon"><i class="bi bi-boxes"></i></span>
            <div>
                <h1>Embarque concentrado por tarima</h1>
                <p>Reporte de transferencias surtidas: qué se cargó en cada tarima, con su detalle de etiquetas, aviso de movilización e impresión.</p>
            </div>
        </div>
        <div class="rm-header__acciones">
            <a id="btnExcelAviso" class="rm-btn excel pm-btn-excel" href="javascript:void(0);"><i class="bi bi-file-earmark-spreadsheet"></i> <span>Aviso de movilización</span></a>
            <button type="button" class="rm-btn primary" id="btnImprimirRomaneo" title="Solo si todas las transferencias están surtidas"><i class="bi bi-printer"></i> Imprimir</button>
        </div>
    </header>

    <!-- ===================== Filtros ===================== -->
    <section class="rm-card rm-filtros no-print">
        <form id="frmRomaneo" method="get">
            <div class="rm-filtros__grid">
                <div>
                    <label class="label" for="f-desde">Fecha inicial</label>
                    <input type="date" id="f-desde" class="in" name="desde" value="@desdeDef" />
                </div>
                <div>
                    <label class="label" for="f-hasta">Fecha final</label>
                    <input type="date" id="f-hasta" class="in" name="hasta" value="@hastaDef" />
                </div>
                @{
                    var multis = new[] {
                        new { Id = "dd-destino", Titulo = "Destino", Lista = Model?.Destinos ?? new List<string>(), Sel = destSel, Vacio = "Todos", Plural = "seleccionados", Name = "destinosSel", Buscar = "Buscar destino…" },
                        new { Id = "dd-pedido", Titulo = "Transferencia", Lista = Model?.Pedidos ?? new List<string>(), Sel = pedSel, Vacio = "Todas", Plural = "seleccionadas", Name = "pedidosSel", Buscar = "Buscar transferencia…" },
                        new { Id = "dd-tarima", Titulo = "Tarima", Lista = Model?.Tarimas ?? new List<string>(), Sel = tarSel, Vacio = "Todas", Plural = "seleccionadas", Name = "tarimasSel", Buscar = "Buscar tarima…" }
                    };
                }
                @foreach (var m in multis)
                {
                    <div>
                        <label class="label" for="@(m.Id)-btn">@m.Titulo</label>
                        <div class="dropdown w-100 multi-dd" id="@m.Id" data-name="@m.Name" data-vacio="@m.Vacio" data-plural="@m.Plural">
                            <button class="in @(m.Sel.Any() ? "has-value" : "")" id="@(m.Id)-btn" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                                <span class="multi-label">@LabelMulti(m.Sel, m.Vacio, m.Plural)</span><i class="bi bi-chevron-down" style="font-size:11px;color:var(--es-muted)"></i>
                            </button>
                            <ul class="dropdown-menu w-100">
                                <li class="mb-2"><input type="text" class="form-control dd-search" placeholder="@m.Buscar" aria-label="@m.Buscar" /></li>
                                @{
                                    var i = 0;
                                }
                                @foreach (var v in m.Lista)
                                {
                                    var id = $"{m.Id}_{i++}";
                                    <li class="dd-item" data-text="@v">
                                        <label for="@id"><input class="dd-check" type="checkbox" value="@v" id="@id" @(m.Sel.Contains(v) ? "checked" : null) /> <span>@v</span></label>
                                    </li>
                                }
                                <li class="dd-actions">
                                    <button type="button" class="rm-btn sm dd-clear">Limpiar</button>
                                    <button type="button" class="rm-btn sm primary dd-apply">Aplicar</button>
                                </li>
                            </ul>
                            <div class="dd-hidden">
                                @foreach (var v in m.Sel)
                                {
                                    <input type="hidden" name="@m.Name" value="@v" />
                                }
                            </div>
                        </div>
                    </div>
                }
                <div>
                    <label class="label" for="f-etiqueta">Código de etiqueta</label>
                    <input type="text" id="f-etiqueta" class="in" name="codigoEtiqueta" value="@codigoEtiquetaDef" placeholder="Ej. DEST0002343115101" autocomplete="off" />
                </div>
            </div>
            <div class="rm-filtros__acciones">
                <a class="rm-btn" href="@Url.Action("RomaneoTransferencia", "Transferencias")"><i class="bi bi-eraser"></i> Limpiar</a>
                <button class="rm-btn primary" type="submit"><i class="bi bi-search"></i> Buscar</button>
            </div>
        </form>
    </section>

    @if (!rows.Any())
    {
        <div class="empty no-print">
            <i class="bi bi-inbox"></i>
            <b>Sin resultados</b>
            No hay transferencias surtidas con los filtros seleccionados. Prueba con otro rango de fechas.
        </div>
    }
    else
    {
        <!-- ===================== Tablero ===================== -->
        <section class="rm-tablero no-print">
            <div class="rm-hero">
                <small>Total surtido en el periodo</small>
                <div class="big">@totalPesoGlobal.ToString("N0") <span>kg</span></div>
                <div class="rm-hero__grid">
                    <div><b>@totalTransferencias</b><em>Transferencias</em></div>
                    <div><b>@totalTarimas</b><em>Tarimas</em></div>
                    <div><b>@totalCajasGlobal.ToString("N0")</b><em>Cajas</em></div>
                    <div><b>@kgPorCaja.ToString("N1")</b><em>Kg por caja</em></div>
                </div>
            </div>
            <div class="rm-card rm-panel">
                <h2>Por destino <small>clic para filtrar</small></h2>
                <div class="rm-barras" id="rmDestinos">
                    @foreach (var d in porDestino)
                    {
                        var w = Math.Round((d.Kg / maxKgDestino) * 100m, 1);
                        <div class="rm-barra" data-destino="@d.Destino" role="button" tabindex="0" title="@d.Destino · @d.Transf transferencia(s) · @d.Cajas cajas">
                            <span class="nom">@d.Destino</span>
                            <span class="rm-track"><span class="rm-fill" style="display:block;width:@(w.ToString(inv))%"></span></span>
                            <span class="val">@d.Kg.ToString("N0") <small>kg</small></span>
                        </div>
                    }
                </div>
            </div>
            <div class="rm-card rm-panel">
                <h2>Productos con más kilos <small>clic para buscar</small></h2>
                <div class="rm-barras" id="rmTopSkus">
                    @foreach (var s in topSkus)
                    {
                        var w = Math.Round((s.Kg / maxKgSku) * 100m, 1);
                        <div class="rm-barra" data-sku="@s.ProductoCodigo" role="button" tabindex="0" title="@s.ProductoCodigo · @s.ProductoNombre · @s.Cajas cajas">
                            <span class="nom">@s.ProductoCodigo</span>
                            <span class="rm-track"><span class="rm-fill gold" style="display:block;width:@(w.ToString(inv))%"></span></span>
                            <span class="val">@s.Kg.ToString("N0") <small>kg</small></span>
                        </div>
                    }
                </div>
            </div>
        </section>

        <!-- ===================== Herramientas ===================== -->
        <div class="rm-tools no-print">
            <div class="rm-busqueda" id="rmBusquedaWrap">
                <i class="bi bi-search"></i>
                <input type="search" id="rmBuscar" placeholder="Buscar folio, destino, tarima, SKU, producto o etiqueta…" aria-label="Buscar dentro de los resultados" autocomplete="off" />
                <button type="button" id="rmBuscarLimpiar" aria-label="Limpiar búsqueda"><i class="bi bi-x"></i></button>
            </div>
            <span id="rmConteo">@totalTransferencias transferencias</span>
            <span class="rm-estado-resumen" id="rmEstadoResumen"></span>
            <span class="sp"></span>
            <button type="button" class="rm-btn sm" id="rmExpandir"><i class="bi bi-arrows-expand"></i> Abrir todas</button>
            <button type="button" class="rm-btn sm" id="rmContraer"><i class="bi bi-arrows-collapse"></i> Cerrar todas</button>
        </div>

        <div class="empty no-print" id="rmSinCoincidencias"><i class="bi bi-search"></i><b>Sin coincidencias</b>Ninguna transferencia contiene lo que buscas.</div>

        <!-- ===================== Transferencias ===================== -->
        <div id="rmLista">
            @{
                var nCard = 0;
            }
            @foreach (var g in grupos)
            {
                var totalCajas = g.Sum(x => x.Cajas);
                var totalPeso = g.Sum(x => x.Peso);
                var transfId = g.First().TransferenciaId;
                var tarimasGrp = g.GroupBy(x => TarimaKey(x.Tarima)).OrderBy(t => t.Key).ToList();
                var cardId = $"tr-{nCard++}";
                var busqueda = string.Join(" ", new[] { g.Key.Pedido, g.Key.Destino }
                    .Concat(g.Select(x => x.Tarima)).Concat(g.Select(x => x.ProductoCodigo)).Concat(g.Select(x => x.ProductoNombre))
                    .Concat(detalle.Where(x => x.TransferenciaId == transfId).Select(x => x.CodigoEtiqueta))
                    .Where(x => !string.IsNullOrWhiteSpace(x))).ToLowerInvariant();

                <article class="order-card avoid-break @(grupos.Count > 3 ? "is-collapsed" : "")" id="@cardId" data-transferencia-id="@transfId" data-destino="@g.Key.Destino" data-buscar="@busqueda" style="animation-delay:@(Math.Min(nCard, 12) * 30)ms">
                    <div class="order-band no-print" role="button" tabindex="0" aria-expanded="@(grupos.Count > 3 ? "false" : "true")" aria-controls="@(cardId)-body">
                        <span class="rm-chevron"><i class="bi bi-chevron-right"></i></span>
                        <div class="rm-folio">
                            <strong>@g.Key.Pedido</strong>
                            <span class="rm-estatus" data-estatus-badge><i class="bi bi-hourglass-split"></i> Consultando…</span>
                            <span class="meta">
                                <span><i class="bi bi-geo-alt"></i>@g.Key.Destino</span>
                                <span><i class="bi bi-calendar3"></i>@g.Key.Fecha.ToString("dd/MM/yyyy")</span>
                                <span><i class="bi bi-stack"></i>@tarimasGrp.Count tarima(s)</span>
                            </span>
                        </div>
                        <div class="rm-totales">
                            <div class="pill"><span>Cajas</span><b>@totalCajas.ToString("N0")</b></div>
                            <div class="pill"><span>Kg</span><b>@totalPeso.ToString("N0")</b></div>
                        </div>
                    </div>
                    <div class="rm-chips no-print">
                        @foreach (var t in tarimasGrp)
                        {
                            <button type="button" class="rm-chip" data-ir-tarima="@(cardId)-@t.Key.GetHashCode()" title="Ir a la tarima @t.Key"><i class="bi bi-stack"></i> @t.Key · <b>@t.Sum(x => x.Cajas)</b> cj · <b>@t.Sum(x => x.Peso).ToString("N0")</b> kg</button>
                        }
                    </div>

                    <div class="order-body" id="@(cardId)-body">
                        <div class="print-only print-bar">
                            <span>Transferencia: @g.Key.Pedido · Destino: @g.Key.Destino</span>
                            <span>Fecha: @g.Key.Fecha.ToString("dd/MM/yyyy") · @totalCajas cajas · @totalPeso.ToString("N2") kg</span>
                        </div>

                        @foreach (var t in tarimasGrp)
                        {
                            var detalleTarima = detalle
                                .Where(x => x.TransferenciaId == transfId && TarimaKey(x.TarimaCodigo) == t.Key)
                                .OrderBy(x => x.Fecha).ToList();
                            var tCajas = t.Sum(x => x.Cajas);
                            var tPeso = t.Sum(x => x.Peso);
                            var share = totalPeso > 0 ? Math.Round(tPeso / totalPeso * 100m, 1) : 0m;

                            <div class="print-only print-bar small">
                                <span>Tarima: @t.Key</span>
                                <span>Cajas: @tCajas &nbsp;|&nbsp; Peso: @tPeso.ToString("N2")</span>
                            </div>

                            <div class="tarima-block" id="@(cardId)-@t.Key.GetHashCode()">
                                <div class="tarima-title no-print">
                                    <span class="nom"><i class="bi bi-stack"></i> Tarima <span class="tag">@t.Key</span></span>
                                    <span class="rm-share" title="Participación de la tarima en los kilos de la transferencia">
                                        <span class="rm-track"><span class="rm-fill" style="display:block;width:@(share.ToString(inv))%"></span></span>
                                        @share.ToString("N1")% del peso
                                    </span>
                                </div>
                                <div class="tablewrap">
                                    <table class="t t-romaneo">
                                        <colgroup><col style="width:14%"><col style="width:50%"><col style="width:14%"><col style="width:22%"></colgroup>
                                        <thead><tr><th>SKU</th><th>Producto</th><th class="text-end">Cajas</th><th class="text-end">Peso (kg)</th></tr></thead>
                                        <tbody>
                                            @foreach (var r in t.OrderBy(x => x.ProductoCodigo))
                                            {
                                                <tr data-sku="@(r.ProductoCodigo?.ToLowerInvariant())">
                                                    <td>@r.ProductoCodigo</td>
                                                    <td>@r.ProductoNombre</td>
                                                    <td class="text-end">@r.Cajas</td>
                                                    <td class="text-end" data-copy="@r.Peso.ToString("0.##", inv)">@r.Peso.ToString("N2")</td>
                                                </tr>
                                            }
                                            <tr class="rm-total">
                                                <td colspan="2" class="text-end">Total tarima</td>
                                                <td class="text-end">@tCajas</td>
                                                <td class="text-end" data-copy="@tPeso.ToString("0.##", inv)">@tPeso.ToString("N2")</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>

                                @if (detalleTarima.Any())
                                {
                                    <details class="detail-toggle no-print">
                                        <summary>
                                            <span class="summary-left"><i class="bi bi-chevron-right summary-icon"></i> Etiquetas escaneadas</span>
                                            <span class="tag">@detalleTarima.Count etiqueta(s) · @detalleTarima.Sum(x => x.Kg).ToString("N1") kg</span>
                                        </summary>
                                        <div class="detail-body">
                                            <div class="tablewrap">
                                                <table class="t t-detalle">
                                                    <colgroup><col style="width:12%"><col style="width:32%"><col style="width:12%"><col style="width:22%"><col style="width:22%"></colgroup>
                                                    <thead><tr><th>SKU</th><th>Código de etiqueta</th><th class="text-end">Kg</th><th>Escaneo</th><th>Usuario</th></tr></thead>
                                                    <tbody>
                                                        @foreach (var d in detalleTarima)
                                                        {
                                                            <tr data-etiqueta="@(d.CodigoEtiqueta?.ToLowerInvariant())">
                                                                <td>@d.Sku</td>
                                                                <td>@d.CodigoEtiqueta</td>
                                                                <td class="text-end" data-copy="@d.Kg.ToString("0.###", inv)">@d.Kg.ToString("N3")</td>
                                                                <td>@d.Fecha.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                                                <td>@d.Usuario</td>
                                                            </tr>
                                                        }
                                                        <tr class="rm-total">
                                                            <td colspan="2" class="text-end">Total</td>
                                                            <td class="text-end" data-copy="@detalleTarima.Sum(x => x.Kg).ToString("0.###", inv)">@detalleTarima.Sum(x => x.Kg).ToString("N3")</td>
                                                            <td colspan="2"></td>
                                                        </tr>
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </details>
                                }
                            </div>
                        }

                        <div class="rm-pie-pedido no-print">
                            <span>Total de la transferencia: <b>@totalCajas.ToString("N0")</b> cajas · <b>@totalPeso.ToString("N2")</b> kg</span>
                        </div>
                    </div>
                </article>
            }
        </div>
    }

    <footer class="statusbar no-print">
        <span>Usuario: @(User?.Identity?.Name ?? "")</span>
        <span>Carnes G SA de CV</span>
        <span>Módulo: Romaneo de transferencias</span>
        <span>Clic derecho sobre una tabla para copiarla a Excel · la impresión incluye todos los resultados</span>
    </footer>
</div>

<div id="excelOverlay" aria-hidden="true">
    <div class="excel-modal" role="status" aria-live="polite">
        <div class="spinner" aria-hidden="true"></div>
        <div class="excel-title">Generando aviso de movilización</div>
        <div class="excel-sub">Por favor espera…</div>
    </div>
</div>

<div id="printStatusToast" class="rm-toast print-status-toast no-print" role="status" aria-live="polite" aria-hidden="true">
    <div class="print-status-icon"><i class="bi bi-exclamation-triangle-fill"></i></div>
    <div class="print-status-text">Solo se puede imprimir cuando todas las transferencias están surtidas.</div>
</div>

@section Scripts {
    <script>
        (function() {
            const $ = id => document.getElementById(id);

            // ================= Filtros de selección múltiple =================
            document.querySelectorAll('.multi-dd').forEach(root => {
                const label = root.querySelector('.multi-label'), btn = root.querySelector('button.in');
                const hidden = root.querySelector('.dd-hidden'), search = root.querySelector('.dd-search');
                const checks = [...root.querySelectorAll('.dd-check')], form = root.closest('form');
                const name = root.dataset.name, vacio = root.dataset.vacio, plural = root.dataset.plural;
                function rebuild() {
                    const sel = checks.filter(c => c.checked).map(c => c.value);
                    label.textContent = !sel.length ? vacio : sel.length <= 2 ? sel.join(', ') : `${sel.length} ${plural}`;
                    btn.classList.toggle('has-value', sel.length > 0);
                    hidden.innerHTML = '';
                    sel.forEach(v => { const i = document.createElement('input'); i.type = 'hidden'; i.name = name; i.value = v; hidden.appendChild(i); });
                }
                search?.addEventListener('input', () => {
                    const q = (search.value || '').toLowerCase().trim();
                    root.querySelectorAll('.dd-item').forEach(li => li.style.display = (!q || (li.dataset.text || '').toLowerCase().includes(q)) ? '' : 'none');
                });
                search?.addEventListener('keydown', e => { if (e.key === 'Enter') e.preventDefault(); });
                root.addEventListener('shown.bs.dropdown', () => setTimeout(() => search?.focus(), 0));
                root.querySelector('.dd-clear')?.addEventListener('click', () => {
                    checks.forEach(c => c.checked = false);
                    if (search) search.value = '';
                    root.querySelectorAll('.dd-item').forEach(li => li.style.display = '');
                    rebuild();
                });
                root.querySelector('.dd-apply')?.addEventListener('click', () => { rebuild(); form?.requestSubmit(); });
                checks.forEach(c => c.addEventListener('change', rebuild));
                rebuild();
            });

            // ================= Tarjetas: abrir / cerrar =================
            const cards = [...document.querySelectorAll('.order-card')];
            function setAbierta(card, abierta) {
                card.classList.toggle('is-collapsed', !abierta);
                card.querySelector('.order-band')?.setAttribute('aria-expanded', String(abierta));
            }
            document.addEventListener('click', e => {
                const band = e.target.closest('.order-band');
                if (band) { const c = band.closest('.order-card'); setAbierta(c, c.classList.contains('is-collapsed')); return; }
                const chip = e.target.closest('[data-ir-tarima]');
                if (chip) {
                    const card = chip.closest('.order-card');
                    setAbierta(card, true);
                    const destino = document.getElementById(chip.dataset.irTarima);
                    if (destino) {
                        destino.scrollIntoView({ behavior: 'smooth', block: 'start' });
                        destino.classList.remove('is-flash'); void destino.offsetWidth; destino.classList.add('is-flash');
                    }
                }
            });
            document.addEventListener('keydown', e => {
                const band = e.target.closest?.('.order-band');
                if (band && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); band.click(); }
            });
            $('rmExpandir')?.addEventListener('click', () => cards.filter(c => !c.classList.contains('is-hidden')).forEach(c => setAbierta(c, true)));
            $('rmContraer')?.addEventListener('click', () => cards.forEach(c => setAbierta(c, false)));

            // ================= Búsqueda dentro de los resultados =================
            const inpBuscar = $('rmBuscar'), wrapBuscar = $('rmBusquedaWrap');
            let filtroDestino = '';
            function aplicarBusqueda() {
                const q = (inpBuscar?.value || '').trim().toLowerCase();
                wrapBuscar?.classList.toggle('has-text', !!q);
                let visibles = 0;
                cards.forEach(card => {
                    const okTexto = !q || (card.dataset.buscar || '').includes(q);
                    const okDestino = !filtroDestino || card.dataset.destino === filtroDestino;
                    const ver = okTexto && okDestino;
                    card.classList.toggle('is-hidden', !ver);
                    // Resalta los renglones (SKU o etiqueta) que coinciden y abre la tarjeta
                    card.querySelectorAll('tr[data-sku], tr[data-etiqueta]').forEach(tr => {
                        const txt = (tr.dataset.sku || tr.dataset.etiqueta || '') + ' ' + tr.innerText.toLowerCase();
                        tr.classList.toggle('rm-match', !!q && q.length >= 2 && txt.includes(q));
                    });
                    if (ver && q && q.length >= 2) {
                        setAbierta(card, true);
                        card.querySelectorAll('tr[data-etiqueta].rm-match').forEach(tr => tr.closest('details')?.setAttribute('open', ''));
                    }
                    if (ver) visibles++;
                });
                const total = cards.length;
                $('rmConteo').textContent = (q || filtroDestino) ? `${visibles} de ${total} transferencias${filtroDestino ? ' · destino ' + filtroDestino : ''}` : `${total} transferencias`;
                const sin = $('rmSinCoincidencias');
                if (sin) sin.style.display = visibles ? 'none' : 'block';
                document.querySelectorAll('#rmDestinos .rm-barra').forEach(b => b.classList.toggle('is-on', b.dataset.destino === filtroDestino));
            }
            let tBuscar = null;
            inpBuscar?.addEventListener('input', () => { clearTimeout(tBuscar); tBuscar = setTimeout(aplicarBusqueda, 150); });
            $('rmBuscarLimpiar')?.addEventListener('click', () => { inpBuscar.value = ''; aplicarBusqueda(); inpBuscar.focus(); });
            const clickBarra = (sel, fn) => {
                const cont = $(sel);
                if (!cont) return;
                const h = e => { const b = e.target.closest('.rm-barra'); if (b) fn(b); };
                cont.addEventListener('click', h);
                cont.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); h(e); } });
            };
            clickBarra('rmDestinos', b => { filtroDestino = filtroDestino === b.dataset.destino ? '' : b.dataset.destino; aplicarBusqueda(); });
            clickBarra('rmTopSkus', b => { inpBuscar.value = inpBuscar.value.trim().toLowerCase() === b.dataset.sku.toLowerCase() ? '' : b.dataset.sku; aplicarBusqueda(); });

            // ================= Estatus de cada transferencia =================
            // Misma consulta que usa la validación de impresión; aquí solo informa en pantalla.
            const TEXTO_EST = { 0: 'Cancelada', 1: 'Pendiente', 2: 'Autorización', 3: 'Pendiente', 4: 'Validada', 5: 'Surtida' };
            async function obtenerEstatusTransferenciaImpresion(id) {
                const resp = await fetch(`/Transferencias/DetalleApi?id=${encodeURIComponent(id)}`, { credentials: 'same-origin', cache: 'no-store', headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                if (!resp.ok) throw new Error(`No se pudo validar la transferencia ${id}.`);
                const data = await resp.json();
                const header = data?.header ?? data?.Header ?? {};
                return { id: Number(id), consecutivo: String(header?.consecutivo ?? header?.Consecutivo ?? `ID ${id}`), estatus: Number(header?.estatus ?? header?.Estatus) };
            }
            async function consultarEnLotes(ids, fn, conc = 5) {
                const out = []; let i = 0;
                await Promise.all(Array.from({ length: Math.min(conc, ids.length) }, async () => { while (i < ids.length) { const id = ids[i++]; out.push(await fn(id)); } }));
                return out;
            }
            async function pintarEstatus() {
                const ids = [...new Set(cards.map(c => c.dataset.transferenciaId).filter(Boolean))];
                if (!ids.length) return;
                const conteo = { ok: 0, pend: 0, err: 0 };
                await consultarEnLotes(ids, async id => {
                    const badges = cards.filter(c => c.dataset.transferenciaId === id).map(c => c.querySelector('[data-estatus-badge]'));
                    try {
                        const r = await obtenerEstatusTransferenciaImpresion(id);
                        const ok = r.estatus === 5, cancel = r.estatus === 0;
                        badges.forEach(b => { b.className = 'rm-estatus ' + (ok ? 'ok' : cancel ? 'bad' : 'warn'); b.innerHTML = `<i class="bi ${ok ? 'bi-check-circle-fill' : cancel ? 'bi-x-circle-fill' : 'bi-clock'}"></i> ${TEXTO_EST[r.estatus] || 'Estatus ' + r.estatus}`; b.title = ok ? 'Lista para imprimir' : 'No se puede imprimir hasta que esté surtida'; });
                        ok ? conteo.ok++ : conteo.pend++;
                    } catch { badges.forEach(b => { b.className = 'rm-estatus'; b.innerHTML = '<i class="bi bi-question-circle"></i> Sin estatus'; }); conteo.err++; }
                    return null;
                }, 4);
                const res = $('rmEstadoResumen');
                if (res) res.innerHTML = `<span class="rm-estatus ok"><i class="bi bi-check-circle-fill"></i> ${conteo.ok} surtida(s)</span>` + (conteo.pend ? `<span class="rm-estatus warn"><i class="bi bi-clock"></i> ${conteo.pend} sin surtir</span>` : '') + (conteo.err ? `<span class="rm-estatus"><i class="bi bi-question-circle"></i> ${conteo.err} sin consultar</span>` : '');
                const btn = $('btnImprimirRomaneo');
                if (btn && conteo.pend) btn.title = `Hay ${conteo.pend} transferencia(s) sin surtir; la impresión se bloqueará.`;
            }

            // ================= Validar estatus 5 antes de imprimir (regla sin cambios) =================
            const btnImprimirRomaneo = $('btnImprimirRomaneo'), printStatusToast = $('printStatusToast');
            const transferenciaIdsImpresion = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(rows.Select(x => x.TransferenciaId).Distinct().ToList()));
            let printToastTimer = null, validandoImpresion = false;

            function mostrarAvisoImpresion(mensaje) {
                if (!printStatusToast) return;
                // CORRECCIÓN: el aviso decía "validado", pero la regla exige estatus 5 (Surtido)
                printStatusToast.querySelector('.print-status-text').textContent = mensaje || 'Solo se puede imprimir cuando todas las transferencias están surtidas.';
                printStatusToast.classList.add('show');
                printStatusToast.setAttribute('aria-hidden', 'false');
                clearTimeout(printToastTimer);
                printToastTimer = setTimeout(() => { printStatusToast.classList.remove('show'); printStatusToast.setAttribute('aria-hidden', 'true'); }, 5500);
            }

            async function validarEImprimirRomaneo() {
                if (validandoImpresion) return;
                if (!Array.isArray(transferenciaIdsImpresion) || !transferenciaIdsImpresion.length) { mostrarAvisoImpresion('No hay transferencias para imprimir.'); return; }
                validandoImpresion = true;
                btnImprimirRomaneo?.classList.add('is-validating');
                if (btnImprimirRomaneo) btnImprimirRomaneo.disabled = true;
                try {
                    // Se consulta el estatus real al momento del clic (no se confía en el que ya está en pantalla)
                    const estados = await consultarEnLotes(transferenciaIdsImpresion, obtenerEstatusTransferenciaImpresion, 6);
                    const noSurtidas = estados.filter(x => x.estatus !== 5);
                    if (noSurtidas.length) {
                        document.body.classList.remove('romaneo-print-autorizado');
                        const folios = noSurtidas.map(x => x.consecutivo).filter(Boolean);
                        mostrarAvisoImpresion(`Solo se puede imprimir cuando todas las transferencias están surtidas. Pendiente(s): ${folios.slice(0, 4).join(', ')}${folios.length > 4 ? ` y ${folios.length - 4} más` : ''}.`);
                        return;
                    }
                    document.body.classList.add('romaneo-print-autorizado');
                    window.print();
                } catch (err) {
                    console.error('Error validando estatus para impresión:', err);
                    document.body.classList.remove('romaneo-print-autorizado');
                    mostrarAvisoImpresion('No se pudo consultar el estatus de las transferencias. Intenta de nuevo.');
                } finally {
                    validandoImpresion = false;
                    btnImprimirRomaneo?.classList.remove('is-validating');
                    if (btnImprimirRomaneo) btnImprimirRomaneo.disabled = false;
                }
            }
            btnImprimirRomaneo?.addEventListener('click', e => { e.preventDefault(); validarEImprimirRomaneo(); });
            document.addEventListener('keydown', e => {
                if ((e.ctrlKey || e.metaKey) && String(e.key || '').toLowerCase() === 'p') { e.preventDefault(); validarEImprimirRomaneo(); }
            });
            window.addEventListener('afterprint', () => document.body.classList.remove('romaneo-print-autorizado'));

            // ================= Aviso de movilización (Excel) =================
            const overlay = $('excelOverlay'), btnExcel = $('btnExcelAviso');
            const showOverlay = () => { overlay?.classList.add('show'); overlay?.setAttribute('aria-hidden', 'false'); };
            const hideOverlay = () => { overlay?.classList.remove('show'); overlay?.setAttribute('aria-hidden', 'true'); };
            function nombreArchivo(disposition) {
                if (!disposition) return null;
                const m = /filename\*?=(?:UTF-8''|")?([^";]+)"?/i.exec(disposition);
                if (!m || !m[1]) return null;
                try { return decodeURIComponent(m[1]); } catch { return m[1]; }
            }
            let descargando = false;
            async function downloadExcel(url) {
                if (descargando) return; // CORRECCIÓN: evita generar el archivo dos veces por doble clic
                descargando = true;
                showOverlay();
                try {
                    const resp = await fetch(url, { credentials: 'same-origin', headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                    if (!resp.ok) { const txt = await resp.text().catch(() => ''); throw new Error(`Error ${resp.status}: ${txt || resp.statusText}`); }
                    const blob = await resp.blob();
                    const blobUrl = URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = blobUrl;
                    a.download = nombreArchivo(resp.headers.get('content-disposition')) || 'AvisoMovilizacion.xlsx';
                    document.body.appendChild(a); a.click(); a.remove();
                    setTimeout(() => URL.revokeObjectURL(blobUrl), 1000);
                } catch (err) {
                    console.error('Error en downloadExcel:', err);
                    alert('No se pudo generar el aviso de movilización. Intenta de nuevo o revisa los filtros.');
                } finally { hideOverlay(); descargando = false; }
            }
            btnExcel?.addEventListener('click', e => {
                e.preventDefault();
                const form = $('frmRomaneo');
                if (!form) return;
                // Se usan los filtros tal como están en pantalla (incluido el código de etiqueta)
                downloadExcel('/Transferencias/ExportCaducidadTransferencias?' + new URLSearchParams(new FormData(form)).toString());
            });

            if (cards.length) pintarEstatus();
        })();
    </script>
}
