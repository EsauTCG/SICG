@using System.Linq
@using Plataforma_CG.Models
@model Plataforma_CG.ViewModels.RomaneoTransferenciasVM
@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Embarque concentrado por tarima";

    var desdeDef = (Model?.Desde ?? DateTime.Today).ToString("yyyy-MM-dd");
    var hastaDef = (Model?.Hasta ?? DateTime.Today).ToString("yyyy-MM-dd");
    var rows = Model?.Rows ?? new List<Plataforma_CG.ViewModels.RomaneoTransferenciasRowVM>();
    var detalle = Model?.DetalleEtiquetas ?? new List<Plataforma_CG.ViewModels.TransferenciaScanEtiquetaDetalleVM>();

    var totalCajasGlobal = rows.Sum(x => x.Cajas);
    var totalPesoGlobal = rows.Sum(x => x.Peso);

    var destSel = Model?.DestinosSeleccionados ?? new List<string>();
    var pedSel = Model?.PedidosSeleccionados ?? new List<string>();
    var tarSel = Model?.TarimasSeleccionadas ?? new List<string>();
    var codigoEtiquetaDef = Model?.CodigoEtiqueta ?? "";

    string LabelMulti(List<string> sel, string emptyText, string pluralText)
    {
        if (sel == null || sel.Count == 0) return emptyText;
        if (sel.Count <= 2) return string.Join(", ", sel);
        return $"{sel.Count} {pluralText}";
    }
    string TarimaKey(string t) => string.IsNullOrWhiteSpace(t) ? "SIN TARIMA" : t.Trim().ToUpperInvariant();

    var grupos = rows
        .GroupBy(r => new { r.Pedido, r.Fecha, r.Destino })
        .OrderBy(g => g.Key.Fecha).ThenBy(g => g.Key.Pedido)
        .ToList();

    var totalTransferencias = grupos.Count;
    var totalTarimas = rows.Select(r => new { r.Pedido, T = TarimaKey(r.Tarima) }).Distinct().Count();
    var totalSkus = rows.Select(r => r.ProductoCodigo).Where(x => !string.IsNullOrWhiteSpace(x)).Distinct().Count();
    var kgPorCaja = totalCajasGlobal > 0 ? totalPesoGlobal / totalCajasGlobal : 0m;
    var porDestino = rows.GroupBy(r => string.IsNullOrWhiteSpace(r.Destino) ? "SIN DESTINO" : r.Destino)
        .Select(g => new { Destino = g.Key, Kg = g.Sum(x => x.Peso), Cajas = g.Sum(x => x.Cajas), Transf = g.Select(x => x.Pedido).Distinct().Count() })
        .OrderByDescending(x => x.Kg).ToList();
    var maxKgDestino = porDestino.Any() ? porDestino.Max(x => x.Kg) : 1m;
    if (maxKgDestino <= 0) maxKgDestino = 1m;
    var topSkus = rows.GroupBy(r => new { r.ProductoCodigo, r.ProductoNombre })
        .Select(g => new { g.Key.ProductoCodigo, g.Key.ProductoNombre, Kg = g.Sum(x => x.Peso), Cajas = g.Sum(x => x.Cajas) })
        .OrderByDescending(x => x.Kg).Take(6).ToList();
    var maxKgSku = topSkus.Any() ? topSkus.Max(x => x.Kg) : 1m;
    if (maxKgSku <= 0) maxKgSku = 1m;

    var logoUrl = Url.Content("~/images/sigoNegro.png");
    var inv = System.Globalization.CultureInfo.InvariantCulture;
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    /* =====================================================================
           EMBARQUE CONCENTRADO POR TARIMA · SIGO — hoja de estilos única
           Sustituye las capas anteriores y romaneo-transferencias-erp-compacto.css.
           Conserva el formato de impresión carta y la regla de impresión.
           ===================================================================== */
    :root {
        --es-tinto: #8d3e46;
        --es-tinto-deep: #5c2229;
        --es-tinto-soft: #f7eced;
        --es-tinto-line: #e8d3d6;
        --es-paper: #f6f4f4;
        --es-surface: #ffffff;
        --es-field: #ffffff;
        --es-head: #faf7f7;
        --es-hover: #fcf9f9;
        --es-row-line: #f0eaeb;
        --es-ink: #231a1c;
        --es-muted: #76686b;
        --es-line: #e6dfe0;
        --es-line-strong: #cfc4c6;
        --es-ok: #2f7a55;
        --es-ok-bg: #e7f3ec;
        --es-warn: #9a6410;
        --es-warn-bg: #fbf1de;
        --es-bad: #b42d2d;
        --es-bad-bg: #fbe9e8;
        --es-info: #2f5d86;
        --es-info-bg: #e9f0f7;
        --es-neutral-bg: #efecec;
        --es-gold: #c08a2e;
        --es-font: "Poppins", "Segoe UI", system-ui, -apple-system, Arial, sans-serif;
    }

    body[data-theme="dark"] {
        --es-tinto: #c56b74;
        --es-tinto-deep: #7a2d36;
        --es-tinto-soft: #3a2427;
        --es-tinto-line: #5a3439;
        --es-paper: #16181c;
        --es-surface: #202328;
        --es-field: #181a1e;
        --es-head: #262a30;
        --es-hover: #2a2e34;
        --es-row-line: #30343b;
        --es-ink: #edf0f3;
        --es-muted: #a9b0b9;
        --es-line: #363b43;
        --es-line-strong: #4a5059;
        --es-ok: #6cc596;
        --es-ok-bg: #1d3328;
        --es-warn: #e0b061;
        --es-warn-bg: #3a2f1b;
        --es-bad: #f08a83;
        --es-bad-bg: #3d2223;
        --es-info: #8bb8e0;
        --es-info-bg: #1e2b38;
        --es-neutral-bg: #2c3036;
        --es-gold: #e0b061;
    }

    .rmx, .rm-toast, #excelOverlay {
        font-family: var(--es-font) !important;
        color: var(--es-ink);
        font-size: 13px;
        line-height: 1.4;
    }

        .rmx *, #excelOverlay * {
            box-sizing: border-box;
        }

        .rmx .bi, .rm-toast .bi {
            font-family: "bootstrap-icons" !important;
        }

    .text-end {
        text-align: right !important;
        font-variant-numeric: tabular-nums;
    }

    .rmx {
        background: var(--es-paper);
        padding: 14px 16px 12px;
        min-width: 0;
    }

    .print-only {
        display: none;
    }

    /* ---------- Encabezado ---------- */
    .rm-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        flex-wrap: wrap;
        margin-bottom: 12px;
    }

    .rm-header__title {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .rm-header__icon {
        width: 40px;
        height: 40px;
        flex: none;
        border-radius: 10px;
        display: grid;
        place-items: center;
        background: var(--es-tinto);
        color: #fff;
        font-size: 19px;
    }

    .rm-header h1 {
        margin: 0;
        font-size: 20px;
        font-weight: 700;
        letter-spacing: -.01em;
        line-height: 1.15;
        color: var(--es-ink);
    }

    .rm-header p {
        margin: 2px 0 0;
        font-size: 12px;
        color: var(--es-muted);
    }

    .rm-header__acciones {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    /* ---------- Botones ---------- */
    .rm-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        height: 36px;
        padding: 0 14px;
        border: 1px solid var(--es-line-strong);
        border-radius: 7px;
        background: var(--es-field);
        color: var(--es-ink);
        font: 600 12.5px/1 var(--es-font);
        white-space: nowrap;
        cursor: pointer;
        text-decoration: none;
        transition: background .12s, border-color .12s;
    }

        .rm-btn:hover {
            background: var(--es-tinto-soft);
            border-color: var(--es-tinto-line);
            color: var(--es-ink);
        }

        .rm-btn.primary {
            background: var(--es-tinto);
            border-color: var(--es-tinto);
            color: #fff;
        }

            .rm-btn.primary:hover {
                background: var(--es-tinto-deep);
                border-color: var(--es-tinto-deep);
                color: #fff;
            }

        .rm-btn.excel i {
            color: var(--es-ok);
        }

        .rm-btn.sm {
            height: 30px;
            padding: 0 10px;
            font-size: 12px;
            border-radius: 6px;
        }

        .rm-btn:disabled, .rm-btn.is-validating {
            opacity: .6;
            cursor: progress;
            pointer-events: none;
        }

        .rm-btn:focus-visible {
            outline: 2px solid var(--es-tinto);
            outline-offset: 2px;
        }

    /* ---------- Filtros ---------- */
    .rm-card {
        background: var(--es-surface);
        border: 1px solid var(--es-line);
        border-radius: 10px;
        min-width: 0;
    }

    .rm-filtros {
        padding: 12px 14px;
        margin-bottom: 12px;
        position: relative;
        z-index: 5;
    }

    .rm-filtros__grid {
        display: grid;
        grid-template-columns: 150px 150px repeat(3, minmax(150px, 1fr)) minmax(200px, 1.3fr);
        gap: 10px;
        align-items: end;
    }

    .rm-filtros__acciones {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        flex-wrap: wrap;
        margin-top: 10px;
        padding-top: 10px;
        border-top: 1px solid var(--es-line);
    }

    .rmx .label {
        display: block;
        margin: 0 0 5px;
        font-size: 12px;
        font-weight: 600;
        color: var(--es-muted);
    }

    .rmx .in {
        width: 100%;
        height: 36px;
        padding: 0 10px;
        border: 1px solid var(--es-line-strong);
        border-radius: 7px;
        background-color: var(--es-field);
        color: var(--es-ink);
        font: 500 13px/1.2 var(--es-font);
        outline: none;
        box-shadow: none;
    }

        .rmx .in:focus, .rmx .in:focus-visible {
            border-color: var(--es-tinto);
            box-shadow: 0 0 0 3px rgba(141,62,70,.16);
        }

    body[data-theme="dark"] .rmx .in {
        color-scheme: dark;
    }

    .multi-dd > button.in {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 6px;
        text-align: left;
        cursor: pointer;
    }

        .multi-dd > button.in.has-value {
            border-color: var(--es-tinto);
            background: var(--es-tinto-soft);
            font-weight: 600;
        }

    .multi-label {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .multi-dd .dropdown-menu {
        padding: 8px !important;
        max-height: 320px;
        overflow-y: auto;
        border: 1px solid var(--es-line-strong) !important;
        border-radius: 10px !important;
        background: var(--es-surface) !important;
        box-shadow: 0 12px 30px rgba(0,0,0,.16) !important;
        font-family: var(--es-font);
    }

    .multi-dd .dd-search {
        height: 32px;
        border: 1px solid var(--es-line-strong) !important;
        border-radius: 7px !important;
        background: var(--es-field) !important;
        color: var(--es-ink) !important;
        font: 500 12.5px var(--es-font) !important;
        box-shadow: none !important;
    }

    .multi-dd .dd-item label {
        display: flex;
        align-items: center;
        gap: 9px;
        width: 100%;
        padding: 6px 8px;
        margin: 0;
        border-radius: 6px;
        font-size: 12.5px;
        color: var(--es-ink);
        cursor: pointer;
    }

        .multi-dd .dd-item label:hover {
            background: var(--es-tinto-soft);
        }

    .multi-dd .dd-check {
        width: 16px;
        height: 16px;
        margin: 0;
        accent-color: var(--es-tinto);
    }

    .multi-dd .dd-actions {
        position: sticky;
        bottom: -8px;
        display: flex;
        justify-content: space-between;
        gap: 8px;
        margin: 6px -8px -8px;
        padding: 8px;
        border-top: 1px solid var(--es-line);
        background: var(--es-head);
    }

    /* ---------- Resumen general (tablero) ---------- */
    .rm-tablero {
        display: grid;
        grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr) minmax(0, 1fr);
        gap: 12px;
        margin-bottom: 12px;
    }

    .rm-hero {
        position: relative;
        overflow: hidden;
        padding: 16px 18px;
        border-radius: 12px;
        color: #fff;
        background: radial-gradient(120% 140% at 100% 0%, #a65059 0%, #8d3e46 40%, #5c2229 100%);
    }

        .rm-hero::after {
            content: "";
            position: absolute;
            right: -40px;
            bottom: -60px;
            width: 200px;
            height: 200px;
            border-radius: 50%;
            background: rgba(255,255,255,.08);
        }

        .rm-hero small {
            display: block;
            font-size: 12px;
            opacity: .85;
        }

        .rm-hero .big {
            display: flex;
            align-items: baseline;
            gap: 8px;
            margin: 2px 0 10px;
            font-size: 34px;
            font-weight: 800;
            letter-spacing: -.02em;
            font-variant-numeric: tabular-nums;
        }

            .rm-hero .big span {
                font-size: 14px;
                font-weight: 600;
                opacity: .85;
            }

    .rm-hero__grid {
        position: relative;
        z-index: 1;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 8px;
    }

        .rm-hero__grid div {
            padding: 8px 10px;
            border-radius: 8px;
            background: rgba(255,255,255,.12);
        }

        .rm-hero__grid b {
            display: block;
            font-size: 17px;
            font-weight: 700;
            font-variant-numeric: tabular-nums;
        }

        .rm-hero__grid em {
            font-style: normal;
            font-size: 11px;
            opacity: .85;
        }

    .rm-panel {
        padding: 12px 14px;
    }

        .rm-panel h2 {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            margin: 0 0 10px;
            font-size: 13.5px;
            font-weight: 600;
        }

            .rm-panel h2 small {
                font-size: 11px;
                font-weight: 500;
                color: var(--es-muted);
            }

    .rm-barras {
        display: grid;
        gap: 8px;
        max-height: 190px;
        overflow-y: auto;
    }

    .rm-barra {
        display: grid;
        grid-template-columns: minmax(90px, .9fr) minmax(0, 1.4fr) auto;
        gap: 8px;
        align-items: center;
        font-size: 12px;
        cursor: pointer;
        padding: 2px 4px;
        border-radius: 6px;
    }

        .rm-barra:hover {
            background: var(--es-hover);
        }

        .rm-barra.is-on {
            background: var(--es-tinto-soft);
        }

        .rm-barra .nom {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            font-weight: 600;
        }

        .rm-barra .val {
            font-weight: 700;
            font-variant-numeric: tabular-nums;
            white-space: nowrap;
        }

            .rm-barra .val small {
                font-weight: 500;
                color: var(--es-muted);
            }

    .rm-track {
        height: 8px;
        border-radius: 999px;
        background: var(--es-neutral-bg);
        overflow: hidden;
    }

    .rm-fill {
        height: 100%;
        border-radius: 999px;
        background: linear-gradient(90deg, var(--es-tinto), #b5636b);
        transform-origin: left;
        animation: rm-grow .7s ease-out both;
    }

        .rm-fill.gold {
            background: linear-gradient(90deg, var(--es-gold), #e2b46a);
        }

    @@keyframes rm-grow {
        from {
            transform: scaleX(0);
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .rm-fill {
            animation: none;
        }
    }

    /* ---------- Barra de herramientas de resultados ---------- */
    .rm-tools {
        position: sticky;
        top: 0;
        z-index: 4;
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        padding: 10px 12px;
        margin-bottom: 12px;
        border-radius: 10px;
        background: var(--es-surface);
        border: 1px solid var(--es-line);
        box-shadow: 0 6px 16px rgba(35,26,28,.06);
    }

    .rm-busqueda {
        position: relative;
        flex: 1 1 280px;
        max-width: 460px;
    }

        .rm-busqueda i {
            position: absolute;
            left: 11px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--es-muted);
        }

        .rm-busqueda input {
            width: 100%;
            height: 36px;
            padding: 0 34px 0 34px;
            border: 1px solid var(--es-line-strong);
            border-radius: 999px;
            background: var(--es-field);
            color: var(--es-ink);
            font: 500 13px var(--es-font);
            outline: none;
        }

            .rm-busqueda input:focus {
                border-color: var(--es-tinto);
                box-shadow: 0 0 0 3px rgba(141,62,70,.16);
            }

        .rm-busqueda button {
            position: absolute;
            right: 6px;
            top: 50%;
            transform: translateY(-50%);
            width: 26px;
            height: 26px;
            border: 0;
            border-radius: 50%;
            background: transparent;
            color: var(--es-muted);
            cursor: pointer;
            display: none;
        }

        .rm-busqueda.has-text button {
            display: grid;
            place-items: center;
        }

    #rmConteo {
        font-size: 12px;
        color: var(--es-muted);
    }

    .rm-tools .sp {
        flex: 1;
    }

    .rm-estado-resumen {
        display: inline-flex;
        gap: 6px;
        flex-wrap: wrap;
        font-size: 11.5px;
    }

    /* ---------- Tarjeta de transferencia ---------- */
    .order-card {
        margin-bottom: 12px;
        border-radius: 12px;
        background: var(--es-surface);
        border: 1px solid var(--es-line);
        overflow: hidden;
        transition: box-shadow .15s;
        animation: rm-in .35s ease-out both;
    }

        .order-card:hover {
            box-shadow: 0 8px 22px rgba(35,26,28,.08);
        }

    @@keyframes rm-in {
        from {
            opacity: 0;
            transform: translateY(6px);
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .order-card {
            animation: none;
        }
    }

    .order-card.is-hidden {
        display: none;
    }

    .order-band {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr) auto;
        gap: 14px;
        align-items: center;
        padding: 12px 14px;
        cursor: pointer;
        user-select: none;
        border-bottom: 1px solid transparent;
    }

    .order-card:not(.is-collapsed) .order-band {
        border-bottom-color: var(--es-line);
        background: linear-gradient(180deg, var(--es-head), var(--es-surface));
    }

    .order-band:focus-visible {
        outline: 2px solid var(--es-tinto);
        outline-offset: -2px;
    }

    .rm-chevron {
        width: 30px;
        height: 30px;
        border-radius: 8px;
        display: grid;
        place-items: center;
        background: var(--es-tinto-soft);
        color: var(--es-tinto);
        transition: transform .18s;
    }

    .order-card:not(.is-collapsed) .rm-chevron {
        transform: rotate(90deg);
        background: var(--es-tinto);
        color: #fff;
    }

    .rm-folio {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        min-width: 0;
    }

        .rm-folio strong {
            font-size: 15px;
            font-weight: 700;
        }

        .rm-folio .meta {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            font-size: 12px;
            color: var(--es-muted);
        }

            .rm-folio .meta i {
                color: var(--es-tinto);
                margin-right: 3px;
            }

    .rm-estatus {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 2px 9px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 600;
        background: var(--es-neutral-bg);
        color: var(--es-muted);
    }

        .rm-estatus.ok {
            background: var(--es-ok-bg);
            color: var(--es-ok);
        }

        .rm-estatus.warn {
            background: var(--es-warn-bg);
            color: var(--es-warn);
        }

        .rm-estatus.bad {
            background: var(--es-bad-bg);
            color: var(--es-bad);
        }

    .rm-totales {
        display: flex;
        gap: 8px;
    }

    .pill {
        min-width: 92px;
        padding: 6px 12px;
        border-radius: 8px;
        background: var(--es-head);
        border: 1px solid var(--es-line);
        text-align: right;
    }

        .pill span {
            display: block;
            font-size: 10.5px;
            font-weight: 600;
            color: var(--es-muted);
        }

        .pill b {
            font-size: 16px;
            font-weight: 700;
            font-variant-numeric: tabular-nums;
        }

    .rm-chips {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
        padding: 0 14px 12px 58px;
    }

    .order-card:not(.is-collapsed) .rm-chips {
        padding-top: 10px;
    }

    .rm-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 3px 10px;
        border-radius: 999px;
        background: var(--es-surface);
        border: 1px solid var(--es-line);
        font-size: 11.5px;
        cursor: pointer;
    }

        .rm-chip:hover {
            border-color: var(--es-tinto);
            color: var(--es-tinto);
        }

        .rm-chip i {
            color: var(--es-gold);
        }

        .rm-chip b {
            font-weight: 700;
        }

    .order-body {
        padding: 4px 14px 14px;
    }

    .order-card.is-collapsed .order-body {
        display: none;
    }

    .tarima-block {
        margin-top: 12px;
        padding: 12px;
        border-radius: 10px;
        background: var(--es-head);
        border: 1px solid var(--es-line);
        scroll-margin-top: 80px;
    }

        .tarima-block.is-flash {
            animation: rm-flash 1.4s ease-out;
        }

    @@keyframes rm-flash {
        from {
            box-shadow: 0 0 0 3px var(--es-gold);
        }
    }

    .tarima-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 8px;
    }

        .tarima-title .nom {
            display: flex;
            align-items: center;
            gap: 8px;
            font-weight: 700;
        }

            .tarima-title .nom i {
                color: var(--es-gold);
                font-size: 16px;
            }

    .tag {
        display: inline-flex;
        padding: 2px 9px;
        border-radius: 999px;
        background: var(--es-surface);
        border: 1px solid var(--es-line);
        font-size: 11.5px;
        font-weight: 600;
        color: var(--es-tinto);
    }

    .rm-share {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 220px;
        font-size: 11.5px;
        color: var(--es-muted);
    }

        .rm-share .rm-track {
            flex: 1;
            height: 6px;
        }

    .tablewrap {
        border: 1px solid var(--es-line);
        border-radius: 8px;
        overflow: hidden;
        background: var(--es-surface);
    }

    table.t {
        width: 100%;
        table-layout: fixed;
        border-collapse: separate;
        border-spacing: 0;
        font-size: 12.5px;
        color: var(--es-ink);
    }

        table.t thead th {
            padding: 8px 10px;
            background: var(--es-surface);
            border-bottom: 1px solid var(--es-line);
            color: var(--es-muted);
            font-size: 11.5px;
            font-weight: 600;
            text-align: left;
            white-space: nowrap;
        }

            table.t thead th.text-end {
                text-align: right;
            }

        table.t tbody td {
            padding: 6px 10px;
            border-bottom: 1px solid var(--es-row-line);
            background: var(--es-surface);
            vertical-align: middle;
            overflow-wrap: anywhere;
        }

            table.t tbody td.text-end {
                white-space: nowrap;
                overflow-wrap: normal;
            }

        table.t tbody tr:hover td {
            background: var(--es-hover);
        }

        table.t tbody tr.rm-total td {
            background: var(--es-head);
            font-weight: 700;
            border-bottom: 0;
        }

        table.t tbody tr.rm-match td {
            background: #fff4c2 !important;
        }

    body[data-theme="dark"] table.t tbody tr.rm-match td {
        background: #4a3f18 !important;
    }

    table.t td:first-child {
        font-weight: 600;
    }

    .detail-toggle {
        margin-top: 8px;
        border-radius: 8px;
        border: 1px solid var(--es-line);
        background: var(--es-surface);
        overflow: hidden;
    }

        .detail-toggle summary {
            list-style: none;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            padding: 8px 12px;
            cursor: pointer;
            font-size: 12.5px;
            font-weight: 600;
            color: var(--es-muted);
        }

            .detail-toggle summary::-webkit-details-marker {
                display: none;
            }

            .detail-toggle summary:hover {
                color: var(--es-ink);
            }

        .detail-toggle .summary-left {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .detail-toggle .summary-icon {
            transition: transform .15s;
            color: var(--es-tinto);
        }

        .detail-toggle[open] .summary-icon {
            transform: rotate(90deg);
        }

        .detail-toggle[open] summary {
            border-bottom: 1px solid var(--es-line);
        }

        .detail-toggle .detail-body {
            padding: 8px;
        }

        .detail-toggle .tablewrap {
            max-height: 320px;
            overflow-y: auto;
        }

        .detail-toggle table.t thead th {
            position: sticky;
            top: 0;
            z-index: 1;
            background: var(--es-head);
        }

    .rm-pie-pedido {
        display: flex;
        justify-content: flex-end;
        gap: 16px;
        margin-top: 10px;
        font-size: 12px;
        color: var(--es-muted);
    }

        .rm-pie-pedido b {
            color: var(--es-ink);
        }

    .empty {
        padding: 48px 20px;
        border-radius: 12px;
        border: 1px dashed var(--es-line-strong);
        background: var(--es-surface);
        text-align: center;
        color: var(--es-muted);
    }

        .empty i {
            display: block;
            font-size: 34px;
            margin-bottom: 8px;
            color: var(--es-line-strong);
        }

        .empty b {
            display: block;
            font-size: 15px;
            color: var(--es-ink);
            margin-bottom: 4px;
        }

    #rmSinCoincidencias {
        display: none;
    }

    .statusbar {
        display: flex;
        gap: 18px;
        flex-wrap: wrap;
        padding-top: 4px;
        font-size: 11.5px;
        color: var(--es-muted);
    }

    /* ---------- Overlays ---------- */
    #excelOverlay {
        position: fixed;
        inset: 0;
        z-index: 2100;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 18px;
        background: rgba(22,24,28,.45);
    }

        #excelOverlay.show {
            display: flex;
        }

    .excel-modal {
        width: min(400px, 92vw);
        padding: 22px 18px;
        border-radius: 12px;
        background: var(--es-surface);
        color: var(--es-ink);
        box-shadow: 0 18px 50px rgba(0,0,0,.28);
        text-align: center;
    }

    .excel-title {
        margin-top: 12px;
        font-size: 15px;
        font-weight: 700;
    }

    .excel-sub {
        margin-top: 2px;
        font-size: 12.5px;
        color: var(--es-muted);
    }

    .spinner {
        width: 40px;
        height: 40px;
        margin: 0 auto;
        border: 4px solid var(--es-tinto-line);
        border-top-color: var(--es-ok);
        border-radius: 50%;
        animation: rm-spin .8s linear infinite;
    }

    @@keyframes rm-spin {
        to {
            transform: rotate(360deg);
        }
    }

    .rm-toast {
        position: fixed;
        top: 16px;
        right: 16px;
        z-index: 2100;
        width: min(440px, calc(100vw - 32px));
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 12px 14px;
        border-radius: 10px;
        background: var(--es-surface);
        border: 1px solid var(--es-line);
        border-left: 4px solid var(--es-warn);
        box-shadow: 0 12px 30px rgba(0,0,0,.18);
        font-size: 13px;
        opacity: 0;
        transform: translateY(-10px);
        pointer-events: none;
        transition: opacity .18s, transform .18s;
    }

        .rm-toast.show {
            opacity: 1;
            transform: translateY(0);
            pointer-events: auto;
        }

        .rm-toast .print-status-icon {
            color: var(--es-warn);
            font-size: 17px;
        }

    @@media (max-width: 1300px) {
        .rm-filtros__grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .rm-tablero {
            grid-template-columns: 1fr 1fr;
        }

        .rm-hero {
            grid-column: 1 / -1;
        }
    }

    @@media (max-width: 760px) {
        .rm-filtros__grid, .rm-tablero, .rm-hero__grid {
            grid-template-columns: 1fr 1fr;
        }

        .order-band {
            grid-template-columns: auto minmax(0, 1fr);
        }

        .rm-totales {
            grid-column: 1 / -1;
        }

        .rm-chips {
            padding-left: 14px;
        }
    }

    /* =========================== IMPRESIÓN =========================== */
    @@page {
        size: Letter portrait;
        margin: 10mm 8mm;
    }

