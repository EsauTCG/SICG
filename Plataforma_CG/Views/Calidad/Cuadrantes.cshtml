                                        <g style="-webkit-mask-image: url('/images/canalcuadrantes.png'); -webkit-mask-size: contain; -webkit-mask-position: center; -webkit-mask-repeat: no-repeat; mask-image: url('/images/canalcuadrantes.png'); mask-size: contain; mask-position: center; mask-repeat: no-repeat;">
                                            <!-- Izquierda: 2, 4, 6 -->
