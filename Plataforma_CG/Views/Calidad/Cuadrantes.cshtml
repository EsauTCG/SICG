                        </div>
                        <button class="btn btn-ghost btn-sm no-print" id="printBtn">Imprimir</button>
                    </div>
                </div>
                <div class="diagram-wrap" id="diagramView">
                    <p class="instruction" style="font-weight:600">Monitoreo visual PCC1B · Selección múltiple de cuadrantes</p>
                    <div class="carcass-stage" id="carcassStage">
                        <div class="carcass-layout">

                            <!-- VISTA EXTERNA (2, 4, 6 a la izq | 1, 3, 5 a la der) -->
                            <article class="carcass-view">
                                <div class="carcass-view-title"><span>Vista externa</span><small>Cuadrantes 1 al 6</small></div>
                                <div class="carcass-container">
