<div class="app-shell">
    <header class="topbar">
        <div class="brand">
            <h1 style="font-weight: 900; letter-spacing: 1px; font-size: 20px;">Calidad · Inspección de Canal</h1>
            <small style="color: rgba(255,255,255,0.8); display: block; margin-top: 2px;">Monitoreo PCC1B</small>
        </div>
    </header>

    <main class="main">
        <section class="overview-grid">
            <div class="card lookup-card">
                <span class="label">Número de canal</span>
                <div class="lookup-row">
                    <input class="input" id="globalSearch" value="CNL-025481" placeholder="Escanee o escriba el número de canal" autocomplete="off" />
                    <button class="btn btn-primary" id="searchBtn">Buscar</button>
                </div>
            </div>
            <div class="card metric-card">
                <div class="metric-title">Monitoreadas 100%</div>
                <div class="metric-value" id="metricProcessed">0</div>
                <div class="metric-foot">Ambos lados I / D registrados</div>
            </div>
            <div class="card metric-card warning">
                <div class="metric-title">Con hallazgos</div>
                <div class="metric-value" id="metricObserved">0</div>
                <div class="metric-foot">A, MF, L u otros</div>
            </div>
            <div class="card metric-card danger">
                <div class="metric-title">No conformes</div>
                <div class="metric-value" id="metricRetained">0</div>
                <div class="metric-foot"><button class="btn btn-sm btn-danger" style="background:#fff" id="openRetained">Ver no conformes</button></div>
            </div>
            <div class="card metric-card success">
                <div class="metric-title">Conformes</div>
                <div class="metric-value" id="metricReleased">0</div>
                <div class="metric-foot">Reinspección SC</div>
            </div>
        </section>

        <div class="stepper no-print" id="stepper" aria-label="Pasos del monitoreo">
            <button type="button" class="step-btn active" data-step="1">
                <span class="step-num">1</span>
                <span><span class="step-title">Seleccionar canal</span><span class="step-sub">Elija la canal de la cola de trabajo</span></span>
            </button>
            <button type="button" class="step-btn" data-step="2">
                <span class="step-num">2</span>
                <span><span class="step-title">Cuadrantes y hallazgos</span><span class="step-sub">Marque zonas y registre el hallazgo</span></span>
            </button>
            <button type="button" class="step-btn locked" data-step="3">
                <span class="step-num">3</span>
                <span><span class="step-title">Verificar y guardar</span><span class="step-sub">Revise la tabla y cierre la canal</span></span>
            </button>
        </div>

        <section class="step-panel active" id="step1">
            <aside class="card queue-card" id="queuePanel">
                <div class="panel-header">
                    <div><h2 class="panel-title">Consecutivo de canales</h2><p class="panel-subtitle">Seleccione una canal para inspeccionar</p></div>
                    <span class="kbd">F2</span>
                </div>
                <div class="queue-tools">
                    <input class="input" id="queueSearch" placeholder="Buscar canal o proveedor..." />
                    <div class="filter-menu">
                        <button class="btn btn-soft" id="filterBtn" title="Filtrar">Config.</button>
                        <div class="filter-popover" id="filterPopover">
                            <div class="label" style="margin:3px 5px 5px">Estado</div>
                            <label class="filter-option">Todos <input type="radio" name="statusFilter" value="todos" checked></label>
                            <label class="filter-option">Pendientes <input type="radio" name="statusFilter" value="Pendiente"></label>
                            <label class="filter-option">En inspección <input type="radio" name="statusFilter" value="En inspección"></label>
                            <label class="filter-option">No conformes <input type="radio" name="statusFilter" value="No conforme"></label>
                            <label class="filter-option">Conformes <input type="radio" name="statusFilter" value="Conforme"></label>
                        </div>
                    </div>
                </div>
                <div class="queue-list" id="queueList"></div>
                <div class="queue-footer">
                    <span id="queueCount">0 registros</span>
                    <div class="pagination" id="pagination"></div>
                </div>
            </aside>
            <div class="step-actions no-print">
                <span class="step-hint">Seleccione una canal de la cola o búsquela arriba para continuar.</span>
                <button type="button" class="btn btn-primary" id="step1Next">Continuar →</button>
            </div>
        </section>

        <section class="step-panel" id="step2" hidden>
