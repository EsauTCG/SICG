                        <div>
                            <span class="label">Reinspección</span>
                            <div class="choice-row two" id="reinspectionRow">
                                <button type="button" class="choice-btn active success-choice" data-reinspection="SC"><b>SC</b><span>Sí cumple</span></button>
                                <button type="button" class="choice-btn danger-choice" data-reinspection="NC"><b>NC</b><span>No cumple</span></button>
                            </div>
                        </div>
                    </div>

                    <div class="action-grid">
                        <button class="btn btn-ghost" id="cancelBtn">Cancelar</button>
                        <button class="btn btn-soft" id="clearBtn">Limpiar</button>
                        <button class="btn btn-success btn-full" id="savecua" style="font-size: 13.5px;"> Guardar cuadrante(s) actual(es)</button>
                        <button class="btn btn-primary btn-full" id="saveBtn" style="font-size: 14.5px;"> Liberar lado / Guardar monitoreo</button>
                    </div>
                </div>
            </aside>
        </section>

        <section class="step-panel" id="step3" hidden>
            <section class="bottom-grid">
            <div class="card table-card">
                <div class="panel-header">
                    <div><h2 class="panel-title">Monitoreos PCC1B de esta canal <span id="tableChannel"></span></h2><p class="panel-subtitle">Un renglón por número de canal y lado monitoreado</p></div>
                    <div class="table-actions no-print">
                        <button class="btn btn-ghost btn-sm" id="exportBtn">Exportar CSV</button>
                        <button class="btn btn-success btn-sm" id="releaseBtn">Marcar conforme</button>
                    </div>
                </div>
                <div class="table-wrap">
                    <table>
                        <thead><tr><th>Lado</th><th>Hallazgos de contaminantes</th><th>Cuadrante(s)</th><th>Acciones correctivas</th><th>Reinspección</th><th>Verificación</th><th>Observaciones</th><th>Inspector</th><th>Fecha / hora</th><th class="no-print">Acciones</th></tr></thead>
                        <tbody id="affectationsBody"></tbody>
                    </table>
                </div>
            </div>

            <aside class="card activity-card">
                <div class="panel-header"><div><h2 class="panel-title">Bitácora operativa</h2><p class="panel-subtitle">Últimos movimientos del sistema</p></div><div class="table-actions no-print"><button class="btn btn-ghost btn-sm" id="resetDemoBtn">Reiniciar demo</button><button class="btn btn-ghost btn-sm" id="clearLogBtn">Limpiar</button></div></div>
                <div class="activity-list" id="activityList"></div>
            </aside>
            </section>

            <div class="step-actions no-print">
                <button type="button" class="btn btn-ghost" id="step3Prev">← Capturar otro registro</button>
                <button type="button" class="btn btn-soft" id="step3NewChannel">Cambiar de canal</button>
            </div>
        </section>
    </main>
</div>

<nav class="mobile-nav no-print" aria-label="Pasos del monitoreo">
    <button type="button" data-step="1" class="active"><span>☷</span>Canales</button>
    <button type="button" data-step="2"><span>◫</span>Captura</button>
    <button type="button" data-step="3"><span>✓</span>Verificar</button>
</nav>

<div class="modal-backdrop" id="retainedModal">
    <div class="custom-modal">
        <div class="modal-header"><div><h3 style="margin:0; font-weight: 700;">Canales no conformes</h3><p style="margin:4px 0 0;color:var(--muted)">Acción correctiva ausente o reinspección NC</p></div><button class="close-btn" data-close-modal>×</button></div>
        <div class="modal-body"><div class="retained-grid" id="retainedGrid"></div></div>
        <div class="modal-footer"><button class="btn btn-soft" data-close-modal>Cerrar</button></div>
    </div>
</div>

<div class="toast-stack" id="toastStack"></div>

@section Scripts {
    <script>
        (() => {
            const STORAGE_KEY = 'qa-industrial-pcc1b-v4';
            const quadrantNames = {1:'Cuadrante 1',2:'Cuadrante 2',3:'Cuadrante 3',4:'Cuadrante 4',5:'Cuadrante 5',6:'Cuadrante 6'};
            const findingLabels = {
                A:'Ingesta / alimento (A)', MF:'Materia fecal (MF)', L:'Leche (L)', Pelo:'Pelo',
                Hematomas:'Hematomas', Adherencias:'Adherencias', 'Víscera roja':'Víscera roja',
                'Víscera verde':'Víscera verde', Piel:'Piel', Espinas:'Espinas', Otro:'Otro'
            };

            // Inyeccion de datos desde el controlador
            const canalesBackend = @Html.Raw(Json.Serialize(Model));

            const seedData = {
                channels: canalesBackend || [],
                activities: [
                    { type: 'info', text: 'Datos cargados desde el servidor.', time: nowLabel() }
                ]
            };

            function cloneSeed(){ return typeof structuredClone === 'function' ? structuredClone(seedData) : JSON.parse(JSON.stringify(seedData)); }

            function loadData(){
                // Se prioriza la carga desde el backend
                // Se omite localStorage en el inicio para usar la fuente real
                return normalizeData(cloneSeed());
            }

            let data = loadData();
            let state = {
                selectedChannelId: data.channels.length > 0 ? data.channels[0].id : null,
                selectedQuadrants: [],
                findings: [],
                side: 'I',
                noFindings: false,
                correctiveAction: '√',
                reinspection: 'SC',
                editId: null,
                filter: 'todos',
                page: 1,
                pageSize: 8,
                queueQuery: ''
            };

            const $ = (sel, root=document) => root.querySelector(sel);
            const $$ = (sel, root=document) => [...root.querySelectorAll(sel)];

            function stepLocked(i){
                if(i===3) return !currentChannel() || !currentChannel().records.length;
                return false;
            }

            function stepDone(i){
                const c = currentChannel();
                if(!c) return false;
                return i===1 ? true : i===2 ? !!c.records.length : c.status === 'Conforme';
            }

            function setStep(n){
                if(stepLocked(n)){
                    toast('Complete los pasos anteriores para habilitar este paso.', 'warning');
                    return;
                }
                [1,2,3].forEach(i=>{
                    const panel = $('#step'+i); if(!panel) return;
                    panel.classList.toggle('active', i===n);
                    panel.hidden = i!==n;
                    const btn = $(`.step-btn[data-step="${i}"]`); if(!btn) return;
                    btn.classList.toggle('active', i===n);
                    btn.classList.toggle('locked', stepLocked(i));
                    btn.classList.toggle('done', i!==n && stepDone(i));
                });
                $$('.mobile-nav [data-step]').forEach(b=>b.classList.toggle('active', +b.dataset.step===n));
                window.scrollTo({top:0,behavior:'smooth'});
            }

            function renderSideProgress(){
                const c = currentChannel();
                if(!c) return;
                const sides = new Set(c.records.map(r=>r.side));
                const chip = (s,label)=>`<div class="side-chip ${sides.has(s)?'done':''}"><span>Lado ${s} · ${label}</span><span class="side-mark">${sides.has(s)?'✓':s}</span></div>`;
                $('#sideProgress').innerHTML = chip('I','Izquierdo') + chip('D','Derecho');
            }

            function normalizeData(raw){
                raw.channels.forEach(c => {
                    if(!Array.isArray(c.records)) c.records = [];
                    c.records = c.records.map(r => ({
                        id:r.id || uid(), side:r.side === 'D' ? 'D' : 'I', findings:Array.isArray(r.findings) ? r.findings : [],
                        quadrants:Array.isArray(r.quadrants) ? r.quadrants.map(Number).filter(q=>q>=1&&q<=6) : [],
                        correctiveAction:r.correctiveAction || (r.findings?.length ? '√' : 'N/A'), reinspection:r.reinspection || 'SC',
                        verificationChannel:r.verificationChannel || c.id, verificationComplies:r.verificationComplies !== false,
                        observation:r.observation || '', inspector:r.inspector || 'calidad', datetime:r.datetime || nowLabel()
                    }));
                    c.status = deriveStatus(c.records);
                });
                raw.activities = Array.isArray(raw.activities) ? raw.activities : [];
                return raw;
            }

            function uid(){ return crypto.randomUUID ? crypto.randomUUID() : `${Date.now()}-${Math.random().toString(16).slice(2)}`; }

            function persist(){
                // Mantenemos el guardado temporal local si es necesario
                localStorage.setItem(STORAGE_KEY, JSON.stringify(data));
            }

            function currentChannel(){ return data.channels.find(c => c.id === state.selectedChannelId) || data.channels[0]; }

            function nowLabel(){ return new Intl.DateTimeFormat('es-MX',{dateStyle:'short',timeStyle:'short'}).format(new Date()); }

            function deriveStatus(records){
                if(!records?.length) return 'Pendiente';
                if(records.some(r => r.correctiveAction === 'X' || r.reinspection === 'NC' || !r.verificationComplies)) return 'No conforme';
                const sides = new Set(records.map(r=>r.side));
                return sides.has('I') && sides.has('D') ? 'Conforme' : 'En inspección';
            }

            function toast(message, type='success'){
                const el = document.createElement('div');
                el.className = `toast ${type}`;
                el.innerHTML = `<div style="font-weight:bold">${type==='success'?'✓':type==='danger'?'X':'i'}</div><div>${message}</div>`;
                $('#toastStack').appendChild(el);
                setTimeout(() => el.remove(), 3400);
            }

            function log(text, type='info'){
                data.activities.unshift({type, text, time:nowLabel()});
                data.activities = data.activities.slice(0,30);
                persist(); renderActivity();
            }

            function statusClass(status){
                return status === 'En inspección' ? 'inspeccion' : status === 'No conforme' ? 'retenida' : status === 'Conforme' ? 'liberada' : 'pendiente';
            }

            function renderAll(){ renderMetrics(); renderQueue(); renderCurrent(); renderRecords(); renderQuadrants(); renderSummary(); renderActivity(); }

            function renderMetrics(){
                const monitored = data.channels.filter(c => new Set(c.records.map(r=>r.side)).size === 2).length;
                const observed = data.channels.filter(c => c.records.some(r=>r.findings.length)).length;
                const nonconforming = data.channels.filter(c => c.status === 'No conforme').length;
                const conforming = data.channels.filter(c => c.status === 'Conforme').length;
                $('#metricProcessed').textContent = monitored;
                $('#metricObserved').textContent = observed;
                $('#metricRetained').textContent = nonconforming;
                $('#metricReleased').textContent = conforming;
            }

            function filteredChannels(){
                const q = state.queueQuery.toLowerCase().trim();
                return data.channels.filter(c => {
                    const statusOk = state.filter === 'todos' || c.status === state.filter;
                    const queryOk = !q || c.id.toLowerCase().includes(q) || c.provider.toLowerCase().includes(q) || (c.lot && c.lot.toLowerCase().includes(q));
                    return statusOk && queryOk;
                });
            }

            function renderQueue(){
                const filtered = filteredChannels();
                const pages = Math.max(1, Math.ceil(filtered.length / state.pageSize));
                if(state.page > pages) state.page = pages;
                const start = (state.page - 1) * state.pageSize;
                const pageItems = filtered.slice(start, start + state.pageSize);
                $('#queueList').innerHTML = pageItems.length ? pageItems.map(c => `
                  <div class="queue-item ${c.id===state.selectedChannelId?'active':''}" data-channel="${c.id}">
                    <div><div class="queue-id">${c.id}</div><div class="queue-provider">${c.provider} · ${new Set(c.records.map(r=>r.side)).size}/2 lados</div></div>
                    <span class="status ${statusClass(c.status)}"><span class="status-dot"></span>${c.status}</span>
                  </div>`).join('') : `<div class="empty">No hay canales con el filtro actual.</div>`;
                $('#queueCount').textContent = filtered.length ? `Mostrando ${start+1} a ${Math.min(start+state.pageSize,filtered.length)} de ${filtered.length}` : '0 registros';
                $('#pagination').innerHTML = Array.from({length:Math.min(pages,6)},(_,i)=>i+1).map(p => `<button class="page-btn ${p===state.page?'active':''}" data-page="${p}">${p}</button>`).join('');
                $$('.queue-item').forEach(el => el.addEventListener('click',()=>selectChannel(el.dataset.channel)));
                $$('.page-btn').forEach(el => el.addEventListener('click',()=>{state.page=+el.dataset.page;renderQueue();}));
            }

            function selectChannel(id){
                state.selectedChannelId = id;
                resetForm(false);
                const c = currentChannel();
                if(c) {
                    $('#globalSearch').value = c.id;
                    persist(); renderAll(); setStep(2);
                    toast(`Canal ${c.id} cargada para monitoreo.`, 'success');
                }
            }

            function renderCurrent(){
                const c = currentChannel();
                if(!c) return;
                $('#selectedChannelCode').textContent = `${c.id} · ${c.provider}`;
                $('#selectedQuadrantNumber').textContent = state.selectedQuadrants.length ? state.selectedQuadrants.join(',') : '—';
                $('#selectedQuadrantName').textContent = state.selectedQuadrants.length ? `Cuadrante(s): ${state.selectedQuadrants.join(', ')}` : 'Sin cuadrante seleccionado';
                $('#tableChannel').textContent = `(${c.id})`;
                $('#currentStatusLabel').textContent = c.status;
                if ($('#shiftName')) $('#shiftName').textContent = c.shift;
                $('#verificationChannel').value = $('#verificationChannel').value || c.id;
                $('#releaseBtn').disabled = c.status === 'Conforme';
                $('#releaseBtn').style.opacity = c.status === 'Conforme' ? .5 : 1;
                renderSideProgress();
            }

            function renderRecords(){
                const c = currentChannel();
                if(!c) return;
                const rows = c.records;
                $('#affectationsBody').innerHTML = rows.length ? rows.map(r => {
                    // Evaluar si este registro necesita corrección
                    const isBad = r.correctiveAction === 'X' || r.reinspection === 'NC' || !r.verificationComplies;

                    return `
                  <tr class="${isBad ? 'row-needs-correction' : ''}">
                    <td data-label="Lado"><b style="font-size:15px; color: var(--primary-dark)">${r.side}</b> · ${r.side==='I'?'Izquierdo':'Derecho'}</td>
                    <td data-label="Hallazgos"><div class="tag-list">${r.findings.length ? r.findings.map(f=>`<span class="finding-tag">${escapeHtml(f)}</span>`).join('') : '<span class="finding-tag clean">Sin hallazgos</span>'}</div></td>
                    <td data-label="Cuadrante(s)">${r.quadrants.length ? `<div class="quadrant-list">${r.quadrants.map(q=>`<span class="quadrant-pill">${q}</span>`).join('')}</div>` : '—'}</td>
                    <td data-label="Acciones correctivas"><span class="result-chip ${r.correctiveAction==='X'?'bad':'ok'}">${r.correctiveAction}</span></td>
                    <td data-label="Reinspección"><span class="result-chip ${r.reinspection==='NC'?'bad':'ok'}">${r.reinspection}</span></td>
                    <td data-label="Verificación"><b style="color:var(--muted)">C:</b> ${escapeHtml(r.verificationChannel)} ${r.verificationComplies?'<span class="result-chip ok">√</span>':'<span class="result-chip bad">X</span>'}</td>
                    <td data-label="Observaciones" style="max-width:260px">${escapeHtml(r.observation || '—')}</td>
                    <td data-label="Inspector">${escapeHtml(r.inspector)}</td>
                    <td data-label="Fecha / hora">${r.datetime}</td>
                    <td data-label="Acciones" class="no-print">
                        <div class="row-actions">
                            ${isBad
                                ? `<button class="btn-correct edit-row" data-id="${r.id}">Corregir</button>`
                                : `<button class="icon-btn edit-row" data-id="${r.id}" title="Editar">✎</button>`}
                            <button class="icon-btn delete-row" data-id="${r.id}" title="Eliminar">🗑</button>
                        </div>
                    </td>
                  </tr>`
                }).join('') : `<tr><td colspan="10"><div class="empty">Falta registrar el monitoreo de los lados I y D.</div></td></tr>`;
                $$('.edit-row').forEach(b=>b.addEventListener('click',()=>loadRecordForEdit(b.dataset.id)));
                $$('.delete-row').forEach(b=>b.addEventListener('click',()=>deleteRecord(b.dataset.id)));
            }

            function renderQuadrants(){
                const c = currentChannel();
                if(!c) return;
                $$('.quadrant-zone').forEach(zone => {
                    const q = +zone.dataset.quadrant;
                    zone.classList.remove('selected','has-leve','has-moderado','has-severo');
                    if(state.selectedQuadrants.includes(q)) zone.classList.add('selected');

                    // Filtrar estrictamente por los registros de este lado (I o D)
                    const records = c.records.filter(r=>r.quadrants.includes(q) && r.side === state.side);

                    if(records.length){
                        const bad = records.some(r=>r.correctiveAction==='X'||r.reinspection==='NC'||!r.verificationComplies);
                        // El cuadrante es verde solo si el arreglo de hallazgos está vacío
                        const allClean = records.every(r=>r.findings.length === 0);

                        zone.classList.add(allClean ? 'has-leve' : (bad ? 'has-severo' : 'has-moderado'));
                        if(state.selectedQuadrants.includes(q)) zone.classList.add('selected');
                    }
                });
            }

            function renderSummary(){
                const c = currentChannel();
                if(!c) return;
                $('#quadrantSummary').innerHTML = `
                  <div style="display:grid;grid-template-columns:repeat(2,1fr);gap:12px">
                    ${[1,2,3,4,5,6].map(q=>{
                      const list = c.records.filter(r=>r.quadrants.includes(q));
                      return `<div class="retained-card"><h4>Cuadrante ${q}</h4>${list.length ? list.map(r=>`<div style="padding:8px 0;border-top:1px dashed var(--line)"><b>Lado ${r.side}</b> · ${r.findings.map(f=>escapeHtml(f)).join(', ')}<div class="retained-meta">Acción: ${r.correctiveAction} · Reinspección: ${r.reinspection}<br>${escapeHtml(r.observation||'')}</div></div>`).join('') : '<div class="retained-meta">Sin hallazgos registrados en este cuadrante.</div>'}</div>`;
                    }).join('')}
                  </div>`;
            }

            function renderActivity(){
                $('#activityList').innerHTML = data.activities.length ? data.activities.map(a=>`
                  <div class="activity-item"><div class="activity-icon">${a.type==='success'?'✓':a.type==='danger'?'X':a.type==='warning'?'!':'i'}</div><div><div class="activity-text">${escapeHtml(a.text)}</div><div class="activity-time">${a.time}</div></div></div>`).join('') : `<div class="empty">Sin movimientos registrados.</div>`;
            }

           function setNoFindings(value){
                state.noFindings = value;
                $('#noFindingsBtn').classList.toggle('active', value);
                if(value){
                    state.findings = [];
                   
                    state.correctiveAction = 'N/A';
                    state.reinspection = 'SC';
                    $$('.damage-btn').forEach(b=>b.classList.remove('active'));
                } else if(state.correctiveAction === 'N/A') {
                    state.correctiveAction = '√';
                }
                syncFormButtons(); renderCurrent(); renderQuadrants();
            }

           function syncFormButtons(){
                $$('#sideRow .choice-btn').forEach(b=>b.classList.toggle('active',b.dataset.side===state.side));
                $$('.damage-btn').forEach(b=>b.classList.toggle('active',state.findings.includes(b.dataset.finding)));
                $$('#correctiveRow .choice-btn').forEach(b=>{
                    b.disabled = state.noFindings;
                    b.classList.toggle('active',b.dataset.corrective===state.correctiveAction);
                });
                $$('#reinspectionRow .choice-btn').forEach(b=>b.classList.toggle('active',b.dataset.reinspection===state.reinspection));
                $('#noFindingsBtn').classList.toggle('active',state.noFindings);

                const saveBtn = $('#saveBtn');
                const savecuaBtn = $('#savecua'); // Ubicamos el botón verde
                const c = currentChannel();

                if(state.editId){
                    // MODO CORRECCIÓN: Ocultamos el botón verde
                    if(savecuaBtn) savecuaBtn.style.display = 'none';

                    saveBtn.textContent = 'Actualizar corrección';
                    saveBtn.disabled = false;
                    saveBtn.style.opacity = '1';
                    saveBtn.style.cursor = 'pointer';
                    // Hacemos que el botón azul ocupe todo el ancho para llamar la atención
                    saveBtn.style.gridColumn = '1 / -1';
                } else {
                    // MODO NORMAL: Mostramos el botón verde
                    if(savecuaBtn) savecuaBtn.style.display = '';
                    saveBtn.style.gridColumn = '';

                    saveBtn.textContent = 'Liberar lado ' + state.side;

                    // LÓGICA DE BLOQUEO: Contar cuadrantes únicos guardados en este lado
                    const reviewedQuadrants = new Set(c ? c.records.filter(r => r.side === state.side).flatMap(r => r.quadrants) : []);
                    const allReviewed = reviewedQuadrants.size === 6;

                    saveBtn.disabled = !allReviewed;
                    saveBtn.style.opacity = allReviewed ? '1' : '0.4';
                    saveBtn.style.cursor = allReviewed ? 'pointer' : 'not-allowed';

                    if(!allReviewed){
                        saveBtn.title = `Faltan revisar ${6 - reviewedQuadrants.size} cuadrantes para liberar este lado`;
                    } else {
                        saveBtn.title = 'Liberar lado y continuar';
                    }
                }

                $('#formPanel').classList.toggle('form-editing',!!state.editId);
            }

           function saveRecord(){
                const c = currentChannel();
                if(!c) return;

                // A) Si estamos editando un renglón, usamos la lógica de guardado normal
                if (state.editId) {
                    const observation = $('#observation').value.trim();
                    const verificationChannel = $('#verificationChannel').value.trim();
                    const verificationComplies = $('#verificationComplies').checked;

                    if(!state.noFindings && !state.findings.length) return toast('Seleccione al menos un hallazgo o marque “Sin hallazgos”.','warning');
                    if(!state.noFindings && !state.selectedQuadrants.length) return toast('Seleccione uno o varios cuadrantes.','warning');
                    if(state.findings.includes('Otro') && !observation) return toast('Describa el hallazgo "Otro".','warning');

                    const target = c.records.find(r => r.id === state.editId);
                    if(target){
                        Object.assign(target, {
                            findings: state.noFindings ? [] : [...state.findings],
                            quadrants: state.noFindings ? [] : [...state.selectedQuadrants].sort(),
                            correctiveAction: state.noFindings ? 'N/A' : state.correctiveAction,
                            reinspection: state.reinspection,
                            verificationChannel: verificationChannel || c.id,
                            verificationComplies,
                            observation: observation || (state.noFindings ? 'Sin hallazgos visibles.' : ''),
                            inspector: 'calidad',
                            datetime: nowLabel()
                        });
                        c.status = deriveStatus(c.records);
                        persist();
                        log(`Monitoreo actualizado en ${c.id}, lado ${state.side}.`, c.status==='No conforme'?'danger':'warning');

                        // AJUSTE: Limpiamos, actualizamos y lo regresamos directo a la tabla (Paso 3)
                        resetForm(false);
                        renderAll();
                        setStep(3);
                        toast('Corrección aplicada y guardada.', 'success');
                    }
                    return;
                }

                // B) Si NO estamos editando, este botón funge como "Liberar Lado"
                const sidesDone = new Set(c.records.map(r => r.side));
                resetForm(false); // Limpia el formulario

                if (sidesDone.has('I') && sidesDone.has('D')) {
                    renderAll();
                    setStep(3);
                    toast('Ambos lados de la canal han sido registrados. Verifique la tabla.', 'success');
                } else {
                    // Cambiar automáticamente al lado que falta
                    state.side = sidesDone.has('I') ? 'D' : 'I';
                    syncFormButtons();
                    renderAll();
                    toast(`Lado liberado. Se ha cambiado automáticamente al lado ${state.side}.`, 'success');
                }
            }
           function saveQuadrant(){
                const c = currentChannel();
                if(!c) return;

                const observation = $('#observation').value.trim();
                const verificationChannel = $('#verificationChannel').value.trim();
                const verificationComplies = $('#verificationComplies').checked;

                if(!state.noFindings && !state.findings.length) return toast('Seleccione al menos un hallazgo o marque “Sin hallazgos”.','warning');
                if(!state.selectedQuadrants.length) return toast('Seleccione uno o varios cuadrantes en el diagrama.','warning');
                if(state.findings.includes('Otro') && !observation) return toast('Describa el hallazgo "Otro".','warning');

                const record = {
                    id: uid(),
                    side: state.side,
                    findings: state.noFindings ? [] : [...state.findings],
                    quadrants: [...state.selectedQuadrants].sort(),
                    correctiveAction: state.noFindings ? 'N/A' : state.correctiveAction,
                    reinspection: state.reinspection,
                    verificationChannel: verificationChannel || c.id,
                    verificationComplies,
                    observation: observation || (state.noFindings ? 'Cuadrante revisado sin hallazgos.' : ''),
                    inspector: 'calidad',
                    datetime: nowLabel()
                };

                c.records.push(record);
                c.status = deriveStatus(c.records);
                persist();

                const msg = record.findings.length ? `Hallazgos guardados en cuadrante(s) ${record.quadrants.join(', ')}.` : `Cuadrante(s) ${record.quadrants.join(', ')} limpios.`;
                log(msg, record.findings.length ? 'warning' : 'success');

                const savedSide = state.side;
                resetForm(false);
                state.side = savedSide;
                syncFormButtons();
                renderAll();
                toast(msg, 'success');
            }

            function resetForm(showToast=true){
                state.selectedQuadrants=[]; state.findings=[]; state.side='I'; state.noFindings=false;
                state.correctiveAction='√'; state.reinspection='SC'; state.editId=null;
                $('#observation').value='';
                if(currentChannel()) $('#verificationChannel').value=currentChannel().id;
                $('#verificationComplies').checked=true;
                syncFormButtons(); renderCurrent(); renderQuadrants();
                if(showToast) toast('Formulario restablecido.','success');
            }

           function loadRecordForEdit(id){
                const r = currentChannel().records.find(x=>x.id===id);
                if(!r) return;

                state.editId=r.id; state.side=r.side; state.findings=[...r.findings]; state.selectedQuadrants=[...r.quadrants];
                state.noFindings=!r.findings.length;

                // LÓGICA DE AUTOCORRECCIÓN
                const wasBad = r.correctiveAction === 'X' || r.reinspection === 'NC' || !r.verificationComplies;
                state.correctiveAction = wasBad ? '√' : r.correctiveAction;
                state.reinspection = wasBad ? 'SC' : r.reinspection;
                $('#verificationComplies').checked = true;

                // Agregar etiqueta de corregido a la observación si estaba mal
                let obs = r.observation;
                if(wasBad && !obs.includes('[CORREGIDO]')) obs += ' [CORREGIDO]';

                $('#observation').value = obs;
                $('#verificationChannel').value = r.verificationChannel;

                syncFormButtons(); renderCurrent(); renderQuadrants();
                setStep(2);
                $('#formPanel').scrollIntoView({behavior:'smooth',block:'start'});

                if(wasBad){
                    toast(`Corrigiendo hallazgos del lado ${r.side}. Verifique y actualice.`, 'warning');
                } else {
                    toast(`Editando monitoreo del lado ${r.side}.`, 'info');
                }
            }

            function deleteRecord(id){
                if(!confirm('¿Eliminar este monitoreo PCC1B del historial?')) return;
                const c=currentChannel();
                c.records=c.records.filter(r=>r.id!==id); c.status=deriveStatus(c.records);
                persist(); log(`Monitoreo eliminado de ${c.id}.`,'warning'); resetForm(false); renderAll(); toast('Monitoreo eliminado.','warning');
            }

            function markConforming(){
                const c=currentChannel();
                if(new Set(c.records.map(r=>r.side)).size < 2) return toast('Debe registrar los lados I y D antes de cerrar la canal.','warning');
                if(c.records.some(r=>r.correctiveAction==='X'||r.reinspection==='NC'||!r.verificationComplies)) return toast('La canal conserva X, NC o verificación sin cumplimiento. Corrija el renglón correspondiente antes de cerrarla.','danger');
                c.status='Conforme'; persist(); log(`Canal ${c.id} cerrada como conforme.`, 'success'); renderAll(); toast(`Canal ${c.id} marcada conforme.`,'success');
            }

            function renderNonconforming(){
                const items=data.channels.filter(c=>c.status==='No conforme');
                $('#retainedGrid').innerHTML=items.length ? items.map(c=>`
                  <div class="retained-card"><div style="display:flex;justify-content:space-between;gap:8px"><h4>${c.id}</h4><span class="status retenida"><span class="status-dot"></span>No conforme</span></div><div class="retained-meta"><b>Proveedor:</b> ${escapeHtml(c.provider)}<br><b>Lote:</b> ${escapeHtml(c.lot)}<br><b>Lados registrados:</b> ${[...new Set(c.records.map(r=>r.side))].join(', ')||'—'}<br><b>Hallazgos:</b> ${c.records.flatMap(r=>r.findings).join(', ')||'Sin hallazgos'}</div><div style="display:flex;gap:7px;margin-top:10px"><button class="btn btn-soft btn-sm inspect-retained" data-id="${c.id}">Abrir</button></div></div>`).join('') : `<div class="empty" style="grid-column:1/-1">No existen canales no conformes.</div>`;
                $$('.inspect-retained').forEach(b=>b.addEventListener('click',()=>{closeModal('retainedModal');selectChannel(b.dataset.id);}));
            }

            function exportCsv(){
                const c=currentChannel();
                if(!c) return;
                const rows=[['Canal','Lado','Hallazgos de contaminantes','Cuadrantes','Acciones correctivas','Reinspección','Verificación C:','Verificación cumple','Observaciones','Inspector','Fecha/Hora'],
                  ...c.records.map(r=>[c.id,r.side,r.findings.length?r.findings.join(' | '):'Sin hallazgos',r.quadrants.join(' | ')||'',r.correctiveAction,r.reinspection,r.verificationChannel,r.verificationComplies?'√':'X',r.observation,r.inspector,r.datetime])];
                const csv='\ufeff'+rows.map(r=>r.map(v=>`"${String(v??'').replaceAll('"','""')}"`).join(',')).join('\n');
                const blob=new Blob([csv],{type:'text/csv;charset=utf-8'}); const url=URL.createObjectURL(blob); const a=document.createElement('a'); a.href=url; a.download=`${c.id}_PCC1B.csv`; a.click(); URL.revokeObjectURL(url);
                log(`Reporte PCC1B exportado para ${c.id}.`,'info'); toast('Archivo CSV generado.','success');
            }

            function openModal(id){ $('#'+id).classList.add('open'); }
            function closeModal(id){ $('#'+id).classList.remove('open'); }
            function escapeHtml(str=''){ return String(str).replace(/[&<>'"]/g,ch=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[ch])); }

            $$('.quadrant-zone').forEach(z=>z.addEventListener('click',()=>{
                if(state.noFindings) setNoFindings(false);
                const q=+z.dataset.quadrant;
                state.selectedQuadrants = state.selectedQuadrants.includes(q) ? state.selectedQuadrants.filter(x=>x!==q) : [...state.selectedQuadrants,q].sort();
                renderCurrent(); renderQuadrants();
            }));

            $$('.quadrant-zone').forEach(z=>z.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();z.click();}}));
            $$('#sideRow .choice-btn').forEach(b=>b.addEventListener('click',()=>{state.side=b.dataset.side;syncFormButtons();}));
            $$('.damage-btn').forEach(b=>b.addEventListener('click',()=>{
                if(state.noFindings) setNoFindings(false);
                const f=b.dataset.finding;
                state.findings = state.findings.includes(f) ? state.findings.filter(x=>x!==f) : [...state.findings,f];
                syncFormButtons();
            }));

            $('#noFindingsBtn').addEventListener('click',()=>setNoFindings(!state.noFindings));
            $$('#correctiveRow .choice-btn').forEach(b=>b.addEventListener('click',()=>{state.correctiveAction=b.dataset.corrective;syncFormButtons();}));
            $$('#reinspectionRow .choice-btn').forEach(b=>b.addEventListener('click',()=>{state.reinspection=b.dataset.reinspection;syncFormButtons();}));
            $('#saveBtn').addEventListener('click',saveRecord);
            $('#savecua')?.addEventListener('click',saveQuadrant);
            $('#clearBtn').addEventListener('click',()=>resetForm(true));
            $('#cancelBtn').addEventListener('click',()=>{resetForm(false);toast('Captura cancelada.','warning');});
            $('#releaseBtn').addEventListener('click',markConforming);
            $('#exportBtn').addEventListener('click',exportCsv);
            $('#printBtn').addEventListener('click',()=>window.print());
            $('#openRetained').addEventListener('click',()=>{renderNonconforming();openModal('retainedModal');});
            $('#filterBtn').addEventListener('click',()=>$('#filterPopover').classList.toggle('open'));
            $$('input[name="statusFilter"]').forEach(r=>r.addEventListener('change',()=>{state.filter=r.value;state.page=1;renderQueue();}));

            $('#queueSearch').addEventListener('input',e=>{state.queueQuery=e.target.value;state.page=1;renderQueue();});
            $('#globalSearch').addEventListener('keydown',e=>{if(e.key==='Enter') $('#searchBtn').click();});
            $('#searchBtn').addEventListener('click',()=>{
                const v=$('#globalSearch').value.trim().toUpperCase();
                const c=data.channels.find(c=>c.id===v);
                if(c) selectChannel(c.id); else toast(`No se encontró la canal ${v}.`,'danger');
            });

            $$('.step-btn').forEach(b=>b.addEventListener('click',()=>setStep(+b.dataset.step)));
            $('#step1Next')?.addEventListener('click',()=>setStep(2));
            $('#step3Prev')?.addEventListener('click',()=>setStep(2));
            $('#step3NewChannel')?.addEventListener('click',()=>setStep(1));

            // Logica del boton de reinicio ajustada para recargar la pagina
            $('#resetDemoBtn')?.addEventListener('click',()=>{
                if(!confirm('¿Limpiar historial local y recargar datos del servidor?')) return;
                localStorage.removeItem(STORAGE_KEY);
                location.reload();
            });

            $('#clearLogBtn').addEventListener('click',()=>{if(confirm('¿Limpiar la bitácora visible?')){data.activities=[];persist();renderActivity();}});
            $$('[data-close-modal]').forEach(b=>b.addEventListener('click',()=>closeModal(b.closest('.modal-backdrop').id)));
            $$('.modal-backdrop').forEach(m=>m.addEventListener('click',e=>{if(e.target===m) closeModal(m.id);}));
            $$('.view-switch button').forEach(b=>b.addEventListener('click',()=>{
                $$('.view-switch button').forEach(x=>x.classList.toggle('active',x===b));
                $('#diagramView').style.display=b.dataset.view==='diagram'?'block':'none';
                $('#summaryView').style.display=b.dataset.view==='summary'?'block':'none';
                if(b.dataset.view==='summary') renderSummary();
            }));

            document.addEventListener('keydown',e=>{
                if(e.key==='F2'){e.preventDefault();$('#globalSearch').focus();$('#globalSearch').select();}
                if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='s'){e.preventDefault();saveRecord();}
                if(e.key==='Escape') $$('.modal-backdrop.open').forEach(m=>closeModal(m.id));
            });

            document.addEventListener('click',e=>{if(!e.target.closest('.filter-menu')) $('#filterPopover').classList.remove('open');});

            const liveClockEl = $('#liveClock');
            if (liveClockEl) {
                setInterval(() => { liveClockEl.textContent = new Intl.DateTimeFormat('es-MX',{hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:true}).format(new Date()); }, 1000);
            }
            const mobileNavButtons=$$('.mobile-nav [data-step]');
            mobileNavButtons.forEach(button=>button.addEventListener('click',()=>setStep(+button.dataset.step)));

            if('IntersectionObserver' in window){
                const navObserver=new IntersectionObserver(entries=>{
                    const visible=entries.filter(e=>e.isIntersecting).sort((a,b)=>b.intersectionRatio-a.intersectionRatio)[0];
                    if(!visible) return;
                    mobileNavButtons.forEach(b=>b.classList.toggle('active',b.dataset.step===visible.target.id.replace('step','')));
                },{rootMargin:'-20% 0px -55% 0px',threshold:[.1,.35,.6]});
                ['step1','step2','step3'].forEach(id=>{const el=$('#'+id);if(el)navObserver.observe(el);});
            }

            if(currentChannel()) $('#verificationChannel').value=currentChannel().id;
            syncFormButtons(); renderAll(); setStep(1);
        })();
    </script>
}