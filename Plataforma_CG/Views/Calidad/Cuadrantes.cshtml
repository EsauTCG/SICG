                                            <!-- Derecha: 1, 3, 5 -->
                                            <rect class="quadrant-zone" data-quadrant="1" x="180" y="0" width="180" height="360" />
                                            <rect class="quadrant-zone" data-quadrant="3" x="180" y="360" width="180" height="290" />
                                            <rect class="quadrant-zone" data-quadrant="5" x="180" y="650" width="180" height="350" />
                                        </g>

                                        <!-- Lineas divisorias y etiquetas -->
                                        <line class="quadrant-divider" x1="180" y1="0" x2="180" y2="1000" />
                                        <line class="quadrant-divider" x1="0" y1="360" x2="360" y2="360" />
                                        <line class="quadrant-divider" x1="0" y1="650" x2="360" y2="650" />

                                        <g class="zone-chip"><circle cx="100" cy="180" r="24" /><text x="100" y="188">2</text></g>
