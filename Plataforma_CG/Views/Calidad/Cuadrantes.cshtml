                                        <g class="zone-chip"><circle cx="100" cy="180" r="24" /><text x="100" y="188">1</text></g>
                                        <g class="zone-chip"><circle cx="260" cy="180" r="24" /><text x="260" y="188">2</text></g>
                                        <g class="zone-chip"><circle cx="100" cy="505" r="24" /><text x="100" y="513">3</text></g>
                                        <g class="zone-chip"><circle cx="260" cy="505" r="24" /><text x="260" y="513">4</text></g>
                                        <g class="zone-chip"><circle cx="100" cy="790" r="24" /><text x="100" y="798">5</text></g>
                                        <g class="zone-chip"><circle cx="260" cy="790" r="24" /><text x="260" y="798">6</text></g>
