                    <div><h2 class="panel-title">Registro PCC1B</h2><p class="panel-subtitle">Canal, lado, hallazgos, acciones, reinspección y verificación</p></div>
                    <span class="status inspeccion"><span class="status-dot"></span><span id="currentStatusLabel">En inspección</span></span>
                </div>
