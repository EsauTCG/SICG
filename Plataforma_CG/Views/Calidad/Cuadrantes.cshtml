@model List<Plataforma_CG.Models.CanalViewModel>

@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Cuadrantes";
}
<style>
    :root {
        /* PALETA DE COLORES SIGO: Inyectando "tonos rojitos" a los fondos */
        --bg: #fdf5f5; /* Fondo general con toque calido rojizo */
        --surface: #fffafa; /* Fondo de tarjetas y modales blanco-rojizo */
        --surface-2: #fce8e8; /* Fondos secundarios mas rojitos */
        --text: #212529;
        --muted: #856464; /* Textos atenuados en tono vino */
        --line: #f5dcdc; /* Lineas rojizas suaves */
        /* Tonos fuertes corporativos SIGO */
        --primary: #8B0000;
        --primary-dark: #660000;
        --primary-soft: #fde8e8;
        --success: #198754;
        --success-soft: #d1e7dd;
        --warning: #ffc107;
        --warning-soft: #fff3cd;
        --danger: #dc3545;
        --danger-soft: #f8d7da;
        --shadow: 0 4px 14px rgba(139, 0, 0, 0.08);
        --radius: 10px;
    }

    * {
        box-sizing: border-box;
    }

    html {
        scroll-behavior: smooth;
    }

    button, input, textarea, select {
        font: inherit;
    }

    button {
        cursor: pointer;
    }

    .app-shell {
        min-height: 100vh;
        background: var(--bg);
        color: var(--text);
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        font-size: 13px;
    }

    /* Encabezado SIGO */
    .topbar {
        height: 60px;
        background: var(--primary);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 24px;
        position: sticky;
        top: 0;
        z-index: 40;
        box-shadow: 0 4px 15px rgba(0,0,0,.15);
        border-bottom: 3px solid var(--primary-dark);
    }

    .brand {
        display: flex;
        align-items: center;
        gap: 12px;
    }

        .brand h1 {
            margin: 0;
            font-size: 22px;
            font-weight: 900;
            letter-spacing: 1px;
        }

    .brand-details {
        border-left: 1px solid rgba(255,255,255,0.3);
        padding-left: 12px;
        margin-left: 4px;
    }

        .brand-details h2 {
            margin: 0;
            font-size: 14px;
            font-weight: 600;
        }

        .brand-details small {
            display: block;
            color: rgba(255,255,255,0.8);
            margin-top: 2px;
        }

    .top-actions {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .online-badge, .shift-badge {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 10px;
        border-radius: 999px;
        background: rgba(255,255,255,.1);
        color: #fff;
        border: 1px solid rgba(255,255,255,.15);
    }

    .pulse {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #36d399;
        box-shadow: 0 0 0 0 rgba(54,211,153,.7);
        animation: pulse 1.8s infinite;
    }

    @@keyframes pulse {
        70% {
            box-shadow: 0 0 0 8px rgba(54,211,153,0);
        }

        100% {
            box-shadow: 0 0 0 0 rgba(54,211,153,0);
        }
    }

    .user-menu {
        display: flex;
        align-items: center;
        gap: 9px;
        padding-left: 6px;
    }

    .avatar {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        display: grid;
        place-items: center;
        background: rgba(255,255,255,0.2);
        font-weight: 700;
        color: #fff;
    }

    .main {
        padding: 18px 22px 30px;
    }

    /* ====== FLUJO GUIADO POR PASOS ====== */
    .stepper {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
        margin-bottom: 16px;
    }

    .step-btn {
        flex: 1 1 180px;
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 12px 14px;
        border: 1px solid var(--line);
        border-radius: 12px;
        background: var(--surface);
        color: var(--text);
        text-align: left;
        transition: .18s ease;
        min-width: 0;
        cursor: pointer;
    }

        .step-btn:hover:not(.active) {
            border-color: var(--primary);
            background: var(--surface-2);
        }

        .step-btn .step-num {
            width: 30px;
            height: 30px;
            flex-shrink: 0;
            border-radius: 50%;
            display: grid;
            place-items: center;
            background: var(--surface-2);
            color: var(--primary-dark);
            font-weight: 800;
            font-size: 14px;
            transition: .18s ease;
        }

        .step-btn .step-title {
            display: block;
            font-weight: 800;
            font-size: 12.5px;
            line-height: 1.2;
        }

        .step-btn .step-sub {
            display: block;
            font-size: 10.5px;
            color: var(--muted);
            font-weight: 600;
            margin-top: 3px;
        }

        .step-btn.active {
            background: var(--primary);
            border-color: var(--primary);
            color: #fff;
            box-shadow: 0 6px 16px rgba(139,0,0,.3);
            transform: translateY(-1px);
        }

            .step-btn.active .step-num {
                background: #fff;
                color: var(--primary);
            }

            .step-btn.active .step-sub {
                color: rgba(255,255,255,.88);
            }

        .step-btn.done {
            border-color: var(--success);
        }

            .step-btn.done .step-num {
                background: var(--success);
                color: #fff;
            }

            .step-btn.done .step-title::after {
                content: " ✓";
                color: var(--success);
                font-weight: 800;
            }

        .step-btn.locked {
            opacity: .55;
            cursor: not-allowed;
        }

            .step-btn.locked:hover {
                border-color: var(--line);
                background: var(--surface);
            }

    .step-panel {
        display: none;
    }

        .step-panel.active {
            display: block;
            animation: stepIn .22s ease;
        }

        .step-panel[hidden] {
            display: none !important;
        }

    @@keyframes stepIn {
        from {
            opacity: 0;
            transform: translateY(6px);
        }

        to {
            opacity: 1;
            transform: none;
        }
    }

    #step2.active {
        display: grid;
        grid-template-columns: minmax(520px, 1fr) 360px;
        gap: 14px;
        align-items: stretch;
    }

    #step1 .queue-card {
        max-width: 840px;
        margin: 0 auto;
        min-height: 560px;
    }

    #step3 .bottom-grid {
        margin-top: 0;
    }

    .step-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
        margin-top: 14px;
        flex-wrap: wrap;
    }

        .step-actions .step-hint {
            color: var(--muted);
            font-size: 11.5px;
            font-weight: 600;
        }

    .side-progress {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 8px;
        margin-bottom: 14px;
    }

    .side-chip {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding: 9px 11px;
        border: 1px solid var(--line);
        border-radius: 9px;
        background: var(--surface);
        font-size: 12px;
        font-weight: 700;
    }

        .side-chip .side-mark {
            width: 20px;
            height: 20px;
            border-radius: 50%;
            display: grid;
            place-items: center;
            font-size: 11px;
            font-weight: 800;
            background: var(--surface-2);
            color: var(--muted);
            flex-shrink: 0;
        }

        .side-chip.done {
            border-color: var(--success);
            background: rgba(25,135,84,.06);
        }

            .side-chip.done .side-mark {
                background: var(--success);
                color: #fff;
            }

    .overview-grid {
        display: grid;
        grid-template-columns: 1.45fr .8fr .8fr .8fr .8fr;
        gap: 12px;
        margin-bottom: 14px;
    }

    .card {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--radius);
        box-shadow: var(--shadow);
    }

    .lookup-card {
        padding: 14px;
    }

    .lookup-row {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 9px;
    }

    .label {
        display: block;
        font-size: 11px;
        font-weight: 700;
        color: var(--muted);
        margin-bottom: 7px;
        text-transform: uppercase;
        letter-spacing: .45px;
    }

    .input, .select, textarea {
        width: 100%;
        border: 1px solid #e2d1d1;
        border-radius: 8px;
        background: #fff;
        color: var(--text);
        outline: none;
        padding: 10px 11px;
        transition: .18s ease;
    }

        .input:focus, .select:focus, textarea:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(139,0,0,.15);
        }

    textarea {
        min-height: 76px;
        resize: vertical;
    }

    .btn {
        border: 0;
        border-radius: 8px;
        padding: 10px 14px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        transition: .18s ease;
        white-space: nowrap;
    }

        .btn:hover {
            transform: translateY(-1px);
        }

    .btn-primary {
        background: var(--primary);
        color: #fff;
        box-shadow: 0 4px 10px rgba(139,0,0,.25);
    }

        .btn-primary:hover {
            background: var(--primary-dark);
        }

    .btn-soft {
        background: var(--surface-2);
        color: var(--text);
        border: 1px solid var(--line);
    }

        .btn-soft:hover {
            background: #f5e6e6;
        }

    .btn-ghost {
        background: transparent;
        color: var(--text);
        border: 1px solid transparent;
    }

        .btn-ghost:hover {
            background: var(--surface-2);
            border-color: var(--line);
        }

    .btn-danger {
        background: var(--danger-soft);
        color: var(--danger);
        border: 1px solid #f5c2c7;
    }

    .btn-success {
        background: var(--success);
        color: #fff;
    }

    .btn-sm {
        padding: 7px 9px;
        font-size: 12px;
        border-radius: 6px;
    }

    .metric-card {
        padding: 14px;
        position: relative;
        overflow: hidden;
    }

        .metric-card::after {
            content: "";
            position: absolute;
            width: 70px;
            height: 70px;
            border-radius: 50%;
            right: -20px;
            top: -20px;
            background: var(--surface-2);
        }

    .metric-title {
        color: var(--muted);
        font-weight: 700;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: .4px;
    }

    .metric-value {
        font-size: 25px;
        font-weight: 800;
        margin-top: 7px;
        line-height: 1;
    }

    .metric-foot {
        color: var(--muted);
        margin-top: 7px;
        font-size: 11px;
    }

    .metric-card.danger::after {
        background: var(--danger-soft);
    }

    .metric-card.warning::after {
        background: var(--warning-soft);
    }

    .metric-card.success::after {
        background: var(--success-soft);
    }

    .panel-header {
        padding: 14px 15px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid var(--line);
    }

    .panel-title {
        margin: 0;
        font-size: 14px;
        font-weight: 700;
    }

    .panel-subtitle {
        margin: 4px 0 0;
        color: var(--muted);
        font-size: 11px;
    }

    .queue-card {
        min-height: 650px;
        display: flex;
        flex-direction: column;
    }

    .queue-tools {
        padding: 12px;
        border-bottom: 1px solid var(--line);
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 8px;
    }

    .filter-menu {
        position: relative;
    }

    .filter-popover {
        display: none;
        position: absolute;
        right: 0;
        top: 42px;
        width: 210px;
        padding: 9px;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: 10px;
        box-shadow: var(--shadow);
        z-index: 15;
    }

        .filter-popover.open {
            display: block;
        }

    .filter-option {
        padding: 8px 9px;
        border-radius: 6px;
        display: flex;
        justify-content: space-between;
    }

        .filter-option:hover {
            background: var(--surface-2);
        }

    .queue-list {
        padding: 8px;
        overflow: auto;
        flex: 1;
        max-height: 550px;
    }

    .queue-item {
        padding: 11px 10px;
        border-radius: 8px;
        border: 1px solid transparent;
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 8px;
        margin-bottom: 6px;
        cursor: pointer;
        transition: .16s ease;
    }

        .queue-item:hover {
            background: var(--surface-2);
        }

        .queue-item.active {
            background: var(--primary-soft);
            border-color: #f5c2c7;
            box-shadow: inset 4px 0 0 var(--primary);
        }

    .queue-id {
        font-weight: 700;
        letter-spacing: .2px;
    }

    .queue-provider {
        color: var(--muted);
        font-size: 11px;
        margin-top: 4px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        max-width: 180px;
    }

    .status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 10px;
        font-weight: 700;
        border-radius: 999px;
        padding: 5px 8px;
        height: fit-content;
    }

    .status-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
    }

    .status.pendiente {
        color: #052c65;
        background: #cfe2ff;
    }

        .status.pendiente .status-dot {
            background: #0d6efd;
        }

    .status.inspeccion {
        color: #0a3622;
        background: #d1e7dd;
    }

        .status.inspeccion .status-dot {
            background: #198754;
        }

    .status.retenida {
        color: #842029;
        background: #f8d7da;
    }

        .status.retenida .status-dot {
            background: #dc3545;
        }

    .status.liberada {
        color: #664d03;
        background: #fff3cd;
    }

        .status.liberada .status-dot {
            background: #ffc107;
        }

    .queue-footer {
        padding: 10px 12px;
        border-top: 1px solid var(--line);
        display: flex;
        align-items: center;
        justify-content: space-between;
        color: var(--muted);
        font-size: 11px;
    }

    .pagination {
        display: flex;
        gap: 5px;
    }

    .page-btn {
        width: 26px;
        height: 26px;
        border: 1px solid var(--line);
        border-radius: 6px;
        background: #fff;
        color: var(--muted);
        font-weight: bold;
    }

        .page-btn.active {
            background: var(--primary);
            color: #fff;
            border-color: var(--primary);
        }

    .inspection-card {
        min-height: 650px;
    }

    .inspection-toolbar {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .view-switch {
        display: flex;
        background: var(--surface-2);
        border-radius: 8px;
        padding: 3px;
    }

        .view-switch button {
            border: 0;
            background: transparent;
            padding: 6px 10px;
            border-radius: 6px;
            color: var(--muted);
            font-weight: 600;
        }

            .view-switch button.active {
                background: #fff;
                color: var(--primary);
                box-shadow: 0 2px 5px rgba(0,0,0,.08);
            }

    .diagram-wrap {
        padding: 15px 16px 13px;
    }

    .instruction {
        text-align: center;
        color: var(--muted);
        margin: 0 0 10px;
    }

    /* ====== ZONAS DE CUADRANTES SIGO ====== */
    .carcass-stage {
        position: relative;
        min-height: 480px;
        border: 1px solid var(--line);
        border-radius: 10px;
        background: radial-gradient(circle at 50% 50%, #fff 0, var(--surface-2) 100%);
        overflow: hidden;
    }

    .carcass-layout {
        display: grid;
        grid-template-columns: repeat(2,minmax(0,1fr));
        gap: 14px;
        min-height: 530px;
    }

    .carcass-view {
        min-width: 0;
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: stretch;
        border: 1px solid var(--line);
        border-radius: 10px;
        background: #fff;
        overflow: hidden;
    }

    .carcass-view-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding: 10px 12px;
        border-bottom: 1px solid var(--line);
        background: var(--surface);
    }

        .carcass-view-title span {
            font-weight: 850;
            color: var(--text);
        }

        .carcass-view-title small {
            color: var(--muted);
            font-weight: 600;
        }

    .carcass-container {
        position: relative;
        width: 100%;
        height: 445px;
        display: flex;
        justify-content: center;
    }

    .carcass-real-img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: contain;
        pointer-events: none;
        filter: drop-shadow(0px 8px 12px rgba(139,0,0,0.15));
        padding: 8px;
    }

    .carcass-real-svg {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 10;
        padding: 8px;
    }

    /* Hover y selected con FUERTE AZUL para resaltar la carne */
    .quadrant-zone {
        fill: transparent;
        stroke: rgba(255,255,255,.9);
        stroke-width: 4;
        stroke-dasharray: 12 8;
        cursor: pointer;
        transition: .18s ease;
        outline: none;
    }

        .quadrant-zone:hover, .quadrant-zone:focus-visible {
            fill: rgba(13, 110, 253, 0.4);
            stroke: #0d6efd;
            stroke-width: 6;
            stroke-dasharray: none;
        }

        .quadrant-zone.selected {
            fill: rgba(13, 110, 253, 0.65);
            stroke: #0a58ca;
            stroke-width: 7;
            stroke-dasharray: none;
        }

        /* Indicadores de severidad en el diagrama */
        .quadrant-zone.has-leve {
            fill: rgba(25,135,84,.65);
            stroke: var(--success);
        }

        .quadrant-zone.has-moderado {
            fill: rgba(255,193,7,.4);
            stroke: var(--warning);
        }

        .quadrant-zone.has-severo {
            fill: rgba(220,53,69,.65);
            stroke: var(--danger);
        }

            .quadrant-zone.has-leve.selected, .quadrant-zone.has-moderado.selected, .quadrant-zone.has-severo.selected {
                stroke: var(--primary-dark);
                stroke-width: 8;
            }

    .quadrant-divider {
        stroke: #fff;
        stroke-width: 5;
        stroke-dasharray: 15 10;
        opacity: .95;
        pointer-events: none;
        filter: drop-shadow(0 1px 2px rgba(0,0,0,.3));
    }

    .zone-chip {
        pointer-events: none;
    }

        .zone-chip circle {
            fill: rgba(33,37,41,.9);
            stroke: #fff;
            stroke-width: 3;
            filter: drop-shadow(0 4px 6px rgba(0,0,0,.3));
        }

        .zone-chip text {
            fill: #fff;
            font-size: 24px;
            font-weight: 800;
            text-anchor: middle;
            font-family: Inter,system-ui,sans-serif;
        }

    .carcass-zone-labels {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 7px;
        padding: 10px;
        background: var(--surface);
        border-top: 1px solid var(--line);
    }

        .carcass-zone-labels span {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            min-height: 38px;
            text-align: center;
            border: 1px solid var(--line);
            border-radius: 6px;
            background: #fff;
            color: var(--text);
            font-size: 11px;
            font-weight: 600;
        }

        .carcass-zone-labels b {
            width: 23px;
            height: 23px;
            border-radius: 6px;
            display: grid;
            place-items: center;
            background: var(--primary-soft);
            color: var(--primary-dark);
        }

    .legend {
        display: flex;
        justify-content: center;
        gap: 22px;
        padding-top: 12px;
        color: var(--muted);
        font-size: 11px;
    }

        .legend span {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-weight: 600;
        }

        .legend i {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            display: inline-block;
        }

    /* ====== FORMULARIO ====== */
    .form-card {
        min-height: 650px;
    }

    .form-body {
        padding: 13px 14px 15px;
    }

    .selection-box {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 10px;
        background: var(--surface-2);
        border: 1px solid var(--line);
        border-radius: 8px;
        margin-bottom: 14px;
    }

    .selection-number {
        min-width: 36px;
        height: 36px;
        padding: 0 9px;
        border-radius: 6px;
        display: grid;
        place-items: center;
        background: var(--text);
        color: #fff;
        font-size: 16px;
        font-weight: 700;
        white-space: nowrap;
    }

    .selection-name {
        font-weight: 700;
    }

    .selection-code {
        color: var(--muted);
        font-size: 11px;
        margin-top: 2px;
    }

    .damage-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
        margin-bottom: 13px;
    }

    .damage-btn {
        min-height: 54px;
        border: 1px solid var(--line);
        border-radius: 8px;
        background: #fff;
        padding: 7px 5px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
