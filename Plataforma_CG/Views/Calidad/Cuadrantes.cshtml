                                        <g class="zone-chip"><circle cx="100" cy="505" r="24" /><text x="100" y="513">4</text></g>
                                        <g class="zone-chip"><circle cx="260" cy="505" r="24" /><text x="260" y="513">3</text></g>
                                        <g class="zone-chip"><circle cx="100" cy="790" r="24" /><text x="100" y="798">6</text></g>
                                        <g class="zone-chip"><circle cx="260" cy="790" r="24" /><text x="260" y="798">5</text></g>
                                    </svg>
                                </div>
                                <div class="carcass-zone-labels"><span><b>1</b> Cuadrante 1</span><span><b>2</b> Cuadrante 2</span><span><b>3</b> Cuadrante 3</span><span><b>4</b> Cuadrante 4</span><span><b>5</b> Cuadrante 5</span><span><b>6</b> Cuadrante 6</span></div>
                            </article>

                            <!-- VISTA INTERNA (1, 3, 5 a la izq | 2, 4, 6 a la der) -->
                            <article class="carcass-view">
                                <div class="carcass-view-title"><span>Vista interna</span><small>Cuadrantes 1 al 6</small></div>
                                <div class="carcass-container">
                                    <!-- IMAGEN DE CARNE ORIGINAL -->
                                    <img src="/images/canalcuadrantes2.png" class="carcass-real-img" />

                                    <!-- CAPA INTERACTIVA: Enmascarada con CSS Mask usando la misma imagen -->
                                    <svg class="carcass-real-svg" viewBox="0 0 360 1000" preserveAspectRatio="xMidYMid meet">
                                        <g style="-webkit-mask-image: url('/images/canalcuadrantes2.png'); -webkit-mask-size: contain; -webkit-mask-position: center; -webkit-mask-repeat: no-repeat; mask-image: url('/images/canalcuadrantes2.png'); mask-size: contain; mask-position: center; mask-repeat: no-repeat;">
                                            <!-- Izquierda: 1, 3, 5 -->
                                            <rect class="quadrant-zone" data-quadrant="1" x="0" y="0" width="180" height="360" />
                                            <rect class="quadrant-zone" data-quadrant="3" x="0" y="360" width="180" height="290" />
                                            <rect class="quadrant-zone" data-quadrant="5" x="0" y="650" width="180" height="350" />
                                            <!-- Derecha: 2, 4, 6 -->
                                            <rect class="quadrant-zone" data-quadrant="2" x="180" y="0" width="180" height="360" />
                                            <rect class="quadrant-zone" data-quadrant="4" x="180" y="360" width="180" height="290" />
                                            <rect class="quadrant-zone" data-quadrant="6" x="180" y="650" width="180" height="350" />
                                        </g>

                                        <!-- Lineas divisorias y etiquetas -->
