@model IEnumerable<Plataforma_CG.Models.ArticuloSap>

@{
    ViewData["Title"] = "Catalogo de Articulos SAP";
    Layout = "~/Views/Shared/_Layout2.cshtml";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    /* =====================================================================
       CATÁLOGO DE ARTÍCULOS SAP · SIGO — hoja de estilos única
       Mismo sistema visual que Entregas SAP, Costeo, Integraciones y OV.
       Sustituye las 3 capas anteriores y catalogo-articulos-sap-grid.css.
       ===================================================================== */
    :root {
        --es-tinto: #8d3e46;
        --es-tinto-deep: #5c2229;
        --es-tinto-soft: #f7eced;
        --es-tinto-line: #e8d3d6;
        --es-paper: #f6f4f4;
        --es-surface: #ffffff;
        --es-field: #ffffff;
        --es-head: #faf7f7;
        --es-hover: #fcf9f9;
        --es-row-line: #f0eaeb;
        --es-ink: #231a1c;
        --es-muted: #76686b;
        --es-line: #e6dfe0;
        --es-line-strong: #cfc4c6;
        --es-ok: #2f7a55;
        --es-bad: #b42d2d;
        --es-bad-bg: #fbe9e8;
        --es-font: "Poppins", "Segoe UI", system-ui, -apple-system, Arial, sans-serif;
    }

    body[data-theme="dark"] {
        --es-tinto: #c56b74;
        --es-tinto-deep: #7a2d36;
        --es-tinto-soft: #3a2427;
        --es-tinto-line: #5a3439;
        --es-paper: #16181c;
        --es-surface: #202328;
        --es-field: #181a1e;
        --es-head: #262a30;
        --es-hover: #2a2e34;
        --es-row-line: #30343b;
        --es-ink: #edf0f3;
        --es-muted: #a9b0b9;
        --es-line: #363b43;
        --es-line-strong: #4a5059;
        --es-ok: #6cc596;
        --es-bad: #f08a83;
        --es-bad-bg: #3d2223;
    }

    .cat { font-family: var(--es-font); color: var(--es-ink); font-size: 13px; line-height: 1.4; background: var(--es-paper); padding: 16px 18px 10px; min-width: 0; }
    .cat * { box-sizing: border-box; }
    .cat .bi { font-family: "bootstrap-icons" !important; }
    .es-num { font-variant-numeric: tabular-nums; }

    /* ---------- Encabezado ---------- */
    .cat-header { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 14px; }
    .cat-header__title { display: flex; align-items: center; gap: 12px; }
    .cat-header__icon { width: 40px; height: 40px; border-radius: 10px; display: grid; place-items: center; background: var(--es-tinto); color: #fff; font-size: 19px; }
    .cat-header h1 { margin: 0; font-size: 20px; font-weight: 700; letter-spacing: -.01em; line-height: 1.15; color: var(--es-ink); }
    .cat-header p { margin: 2px 0 0; font-size: 12px; color: var(--es-muted); }

    /* ---------- Botones ---------- */
    .es-btn { display: inline-flex; align-items: center; justify-content: center; gap: 6px; height: 36px; padding: 0 14px; border: 1px solid var(--es-line-strong); border-radius: 7px; background: var(--es-field); color: var(--es-ink); font: 600 12.5px/1 var(--es-font); white-space: nowrap; cursor: pointer; transition: background .12s, border-color .12s, color .12s; }
    .es-btn:hover { background: var(--es-tinto-soft); border-color: var(--es-tinto-line); color: var(--es-ink); }
    .es-btn:focus-visible { outline: 2px solid var(--es-tinto); outline-offset: 2px; }
    .es-btn:disabled { opacity: .5; cursor: not-allowed; }
    .es-btn--primary { background: var(--es-tinto); border-color: var(--es-tinto); color: #fff; }
    .es-btn--primary:hover { background: var(--es-tinto-deep); border-color: var(--es-tinto-deep); color: #fff; }

    /* ---------- Tarjeta y barra ---------- */
    .cat-card { background: var(--es-surface); border: 1px solid var(--es-line); border-radius: 10px; overflow: hidden; }
    .cat-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; padding: 12px 14px; border-bottom: 1px solid var(--es-line); }
    .cat-toolbar__left, .cat-toolbar__right { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .cat-search { position: relative; width: 420px; max-width: 100%; }
    .cat-search i { position: absolute; left: 11px; top: 50%; transform: translateY(-50%); color: var(--es-muted); font-size: 13px; pointer-events: none; }
    .cat #searchInput { display: block; width: 100%; height: 36px; padding: 0 10px 0 32px; border: 1px solid var(--es-line-strong); border-radius: 7px; background: var(--es-field); color: var(--es-ink); font: 500 13px/1 var(--es-font); box-shadow: none; }
    .cat #searchInput:focus { outline: none; border-color: var(--es-tinto); box-shadow: 0 0 0 3px rgba(141,62,70,.16); }
    .cat #searchInput::placeholder { color: var(--es-muted); opacity: .85; }
    .cat-count { font-size: 12px; color: var(--es-muted); }
    .cat-count strong { color: var(--es-ink); font-weight: 600; }
    #loader { display: inline-flex; align-items: center; gap: 7px; font-size: 12px; color: var(--es-muted); }
    .cat-spin { width: 13px; height: 13px; border: 2px solid var(--es-tinto-line); border-top-color: var(--es-tinto); border-radius: 50%; animation: cat-spin .8s linear infinite; }
    @@keyframes cat-spin { to { transform: rotate(360deg); } }
    @@media (prefers-reduced-motion: reduce) { .cat-spin { animation-duration: 2s; } }

    /* ---------- Tabla ---------- */
    .cat .table-wrap { overflow: auto; max-height: calc(100dvh - 300px); min-height: 260px; }
    .cat #tablaPrecios { width: 100%; min-width: 1000px; margin: 0; border-collapse: separate; border-spacing: 0; table-layout: fixed; font-size: 12.5px; color: var(--es-ink); --bs-table-bg: transparent; --bs-table-color: var(--es-ink); }
    .cat #tablaPrecios thead th { position: sticky; top: 0; z-index: 2; padding: 9px 10px; background: var(--es-head); border-bottom: 1px solid var(--es-line); color: var(--es-muted); font-size: 11.5px; font-weight: 600; text-align: left; white-space: nowrap; }
    .cat #tablaPrecios tbody td { padding: 8px 10px; border-bottom: 1px solid var(--es-row-line); background: var(--es-surface); color: var(--es-ink); vertical-align: middle; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; box-shadow: none; }
    .cat #tablaPrecios tbody tr:hover td { background: var(--es-hover); }
    .cat #tablaPrecios .t-num { text-align: right; font-variant-numeric: tabular-nums; }
    .cat #tablaPrecios td.t-sku { font-weight: 600; font-variant-numeric: tabular-nums; }
    .cat #tablaPrecios td.t-muted { color: var(--es-muted); }
    .cat .t-msg td { padding: 34px 10px !important; text-align: center; color: var(--es-muted); white-space: normal !important; }
    .cat .t-msg.is-error td { color: var(--es-bad); background: var(--es-bad-bg); }
    .cat .rotacion-input { width: 80px; height: 28px; margin-left: auto; text-align: right; }

    /* ---------- Paginación ---------- */
    .cat .pager { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; padding: 10px 14px; border-top: 1px solid var(--es-line); }
    .cat #statusPageInfo { font-size: 12px; color: var(--es-muted); font-variant-numeric: tabular-nums; }
    .pagination-numeric { display: flex; align-items: center; gap: 4px; flex-wrap: wrap; }
    .page-num-btn { min-width: 32px; height: 32px; padding: 0 8px; border: 1px solid var(--es-line-strong); border-radius: 7px; background: var(--es-field); color: var(--es-ink); font: 500 12.5px/1 var(--es-font); font-variant-numeric: tabular-nums; cursor: pointer; }
    .page-num-btn:hover:not(:disabled):not(.active) { background: var(--es-tinto-soft); border-color: var(--es-tinto-line); }
    .page-num-btn.active { background: var(--es-tinto); border-color: var(--es-tinto); color: #fff; font-weight: 600; cursor: default; }
    .page-num-btn:disabled { opacity: .4; cursor: default; }
    .page-num-btn:focus-visible { outline: 2px solid var(--es-tinto); outline-offset: 2px; }
    .page-ellipsis { min-width: 24px; text-align: center; color: var(--es-muted); }

    .cat-statusbar { display: flex; gap: 18px; flex-wrap: wrap; padding: 8px 2px 0; font-size: 11.5px; color: var(--es-muted); }

    @@media (max-width: 640px) {
        .cat { padding: 10px; }
        .cat-search { width: 100%; }
        .cat .pager { justify-content: center; }
    }
</style>

<div class="cat catalogo-articulos-sap-app">

    <header class="cat-header">
        <div class="cat-header__title">
            <span class="cat-header__icon"><i class="bi bi-box-seam"></i></span>
            <div>
                <h1>Catálogo de artículos SAP</h1>
                <p>Artículos sincronizados desde SAP Business One con su master, tipo, rotación y kilos promedio</p>
            </div>
        </div>
        <div class="cat-toolbar__right">
            <span id="loader" style="display:none;" role="status" aria-live="polite">
                <span class="cat-spin"></span><span id="loaderText">Cargando…</span>
            </span>
            <button id="btnDescargarExcel" class="es-btn" type="button" title="Descarga los artículos que coinciden con la búsqueda actual">
                <i class="bi bi-file-earmark-excel"></i> Descargar Excel
            </button>
            <button id="btnSincronizar" class="es-btn es-btn--primary" type="button" title="Trae los cambios de artículos desde SAP">
                <i class="bi bi-cloud-arrow-down"></i> Sincronizar con SAP
            </button>
        </div>
    </header>

    <section class="cat-card">
        <div class="cat-toolbar">
            <div class="cat-toolbar__left">
                <div class="cat-search">
                    <i class="bi bi-search"></i>
                    <label for="searchInput" class="visually-hidden">Buscar artículo</label>
                    <input type="search" id="searchInput" placeholder="Código, producto, master o tipo SKU" autocomplete="off" />
                </div>
                <span class="cat-count" id="catCount">&nbsp;</span>
            </div>
        </div>

        <div class="table-wrap">
            <table id="tablaPrecios" class="table mb-0">
                <colgroup>
                    <col style="width:11%">
                    <col style="width:31%">
                    <col style="width:14%">
                    <col style="width:12%">
                    <col style="width:9%">
                    <col style="width:10%">
                    <col style="width:13%">
                </colgroup>
                <thead>
                    <tr>
                        <th>SKU</th>
                        <th>Producto</th>
                        <th>Master</th>
                        <th>Tipo SKU</th>
                        <th class="t-num">Rotación</th>
                        <th class="t-num">Kg promedio</th>
                        <th>Última modificación</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <div class="pager">
            <div id="statusPageInfo">Registro listo</div>
            <div id="numericPager" class="pagination-numeric" aria-label="Paginación"></div>
        </div>
    </section>

    <footer class="cat-statusbar">
        <span>Usuario: @(User?.Identity?.Name ?? "")</span>
        <span>Carnes G SA de CV</span>
        <span>Módulo: Catálogo SAP</span>
    </footer>
</div>

@section Scripts {
    <script>
        let currentPage = 1;
        let pageSize = 50;
        let currentSearch = "";
        let totalItems = 0;
        let totalPages = 0;
        let cargaSeq = 0; // solo se pinta la respuesta de la búsqueda más reciente

        function debounce(fn, ms = 300) {
            let t; return (...a) => { clearTimeout(t); t = setTimeout(() => fn(...a), ms); };
        }

        // Los textos se insertan escapados (un nombre con < o comillas ya no rompe la tabla).
        function esc(v) {
            return String(v ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
        }
        const txt = v => (v === null || v === undefined || v === '') ? '—' : esc(v);

        function mostrarLoader(on, texto) {
            const loader = document.getElementById("loader");
            if (texto) document.getElementById("loaderText").textContent = texto;
            loader.style.display = on ? "inline-flex" : "none";
        }

        function filaMensaje(texto, error = false) {
            return `<tr class="t-msg${error ? ' is-error' : ''}"><td colspan="7">${esc(texto)}</td></tr>`;
        }

        async function cargarArticulos(page = 1, search = "") {
            const seq = ++cargaSeq;
            const tbody = document.querySelector("#tablaPrecios tbody");
            tbody.innerHTML = filaMensaje("Cargando artículos…");
            mostrarLoader(true, "Cargando…");

            try {
                const res = await fetch(`/Comercial/GetArticulosJsonPaged?page=${page}&pageSize=${pageSize}&search=${encodeURIComponent(search)}`);
                if (!res.ok) throw new Error("No se pudieron cargar los artículos.");
                const data = await res.json();
                if (seq !== cargaSeq) return; // llegó una búsqueda más nueva

                const rows = Array.isArray(data.articulos) ? data.articulos : [];
                totalItems = Number(data.total || 0);
                totalPages = Math.max(1, Math.ceil((data.total || 0) / (data.pageSize || pageSize)));
                currentPage = Number(data.page || page);
                pageSize = Number(data.pageSize || pageSize);

                document.getElementById("catCount").innerHTML = search
                    ? `<strong>${totalItems.toLocaleString('es-MX')}</strong> artículo(s) coinciden con “${esc(search)}”`
                    : `<strong>${totalItems.toLocaleString('es-MX')}</strong> artículo(s) en el catálogo`;

                if (rows.length === 0) {
                    tbody.innerHTML = filaMensaje(search
                        ? "Ningún artículo coincide con la búsqueda. Prueba con otra parte del código o del nombre."
                        : "No hay artículos para mostrar. Usa Sincronizar con SAP para traerlos.");
                    document.getElementById("statusPageInfo").textContent = "Sin resultados";
                    renderNumericPager();
                    return;
                }

                tbody.innerHTML = rows.map(art => {
                    const kilosVal = (typeof art.u_KilosCaja === "number") ? art.u_KilosCaja : null;
                    const kilosTxt = kilosVal !== null
                        ? kilosVal.toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
                        : "—";
                    const fecha = art.fechaModificacion ? new Date(art.fechaModificacion).toLocaleString('es-MX') : "—";
                    return `
                        <tr data-codigo="${esc(art.productoCodigo)}">
                            <td class="t-sku" title="${esc(art.productoCodigo)}">${txt(art.productoCodigo)}</td>
                            <td title="${esc(art.productoNombre)}">${txt(art.productoNombre)}</td>
                            <td title="${esc(art.u_MASTER)}">${txt(art.u_MASTER)}</td>
                            <td title="${esc(art.u_TipoporSKU)}">${txt(art.u_TipoporSKU)}</td>
                            <td class="t-num">
                                <span class="rotacion-text">${esc(art.rotacion ?? 0)}</span>
                                <input class="rotacion-input form-control form-control-sm" type="number" style="display:none;" value="${esc(art.rotacion ?? 0)}">
                            </td>
                            <td class="t-num">${kilosTxt}</td>
                            <td class="t-muted es-num">${esc(fecha)}</td>
                        </tr>`;
                }).join('');

                document.getElementById("statusPageInfo").textContent =
                    `Página ${currentPage.toLocaleString('es-MX')} de ${totalPages.toLocaleString('es-MX')} · ${totalItems.toLocaleString('es-MX')} registro(s)`;

                renderNumericPager();
                agregarEventosFila();
                document.querySelector(".table-wrap").scrollTop = 0;
            } catch (err) {
                if (seq !== cargaSeq) return;
                tbody.innerHTML = filaMensaje(`${err.message} Recarga la página o inténtalo en un momento.`, true);
                document.getElementById("statusPageInfo").textContent = "Error al cargar";
            } finally {
                if (seq === cargaSeq) mostrarLoader(false);
            }
        }

        /* Edición de rotación: se conserva sin cambios. Hoy está inactiva porque
           ninguna fila tiene los botones .btn-editar / .btn-guardar / .btn-cancelar. */
        function agregarEventosFila() {
            document.querySelectorAll('.btn-editar')?.forEach(btn => {
                btn.onclick = function () {
                    const tr = this.closest('tr');
                    tr.querySelector('.rotacion-text').style.display = 'none';
                    tr.querySelector('.rotacion-input').style.display = 'inline-block';
                    tr.querySelector('.btn-editar').style.display = 'none';
                    tr.querySelector('.btn-guardar').style.display = 'inline-block';
                    tr.querySelector('.btn-cancelar').style.display = 'inline-block';
                }
            });

            document.querySelectorAll('.btn-cancelar')?.forEach(btn => {
                btn.onclick = function () {
                    const tr = this.closest('tr');
                    const span = tr.querySelector('.rotacion-text');
                    const input = tr.querySelector('.rotacion-input');
                    input.value = span.textContent;
                    span.style.display = 'inline';
                    input.style.display = 'none';
                    tr.querySelector('.btn-editar').style.display = 'inline-block';
                    tr.querySelector('.btn-guardar').style.display = 'none';
                    tr.querySelector('.btn-cancelar').style.display = 'none';
                }
            });

            document.querySelectorAll('.btn-guardar')?.forEach(btn => {
                btn.onclick = async function () {
                    const tr = this.closest('tr');
                    const codigo = tr.dataset.codigo;
                    const nuevaRotacion = tr.querySelector('.rotacion-input').value;
                    try {
                        const res = await fetch(`/Comercial/ActualizarRotacion?codigo=${encodeURIComponent(codigo)}&rotacion=${encodeURIComponent(nuevaRotacion)}`, { method: 'POST' });
                        if (!res.ok) throw new Error("No se pudo actualizar la rotación");
                        tr.querySelector('.rotacion-text').textContent = nuevaRotacion;
                        tr.querySelector('.rotacion-text').style.display = 'inline';
                        tr.querySelector('.rotacion-input').style.display = 'none';
                        tr.querySelector('.btn-editar').style.display = 'inline-block';
                        tr.querySelector('.btn-guardar').style.display = 'none';
                        tr.querySelector('.btn-cancelar').style.display = 'none';
                    } catch (err) {
                        alert("Error al guardar rotación: " + err.message);
                    }
                }
            });
        }

        // Excel: lo genera el servidor con la búsqueda actual (todas las páginas).
        document.getElementById("btnDescargarExcel").addEventListener("click", function () {
            const search = document.getElementById("searchInput").value || "";
            window.location.href = `/Comercial/DescargarArticulosExcel?search=${encodeURIComponent(search)}`;
        });

        document.getElementById("btnSincronizar").addEventListener("click", async function () {
            const btn = this;
            const original = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="cat-spin" style="border-color:rgba(255,255,255,.35);border-top-color:#fff;"></span> Sincronizando…';
            mostrarLoader(true, "Sincronizando con SAP…");

            try {
                const res = await fetch('/Comercial/SincronizarItems');
                if (!res.ok) throw new Error('No se pudo sincronizar con SAP.');
                const data = await res.text();
                alert(data);
                await cargarArticulos(currentPage, currentSearch);
            } catch (err) {
                alert(err.message);
            } finally {
                mostrarLoader(false);
                btn.disabled = false;
                btn.innerHTML = original;
            }
        });

        function renderNumericPager() {
            const host = document.getElementById("numericPager");
            if (!host) return;
            host.innerHTML = "";

            const total = Math.max(1, Number(totalPages || 1));
            const actual = Math.max(1, Math.min(Number(currentPage || 1), total));

            function addButton(label, page, options = {}) {
                const btn = document.createElement("button");
                btn.type = "button";
                btn.className = "page-num-btn";
                btn.textContent = label;
                if (options.aria) btn.setAttribute("aria-label", options.aria);
                if (options.active) { btn.classList.add("active"); btn.setAttribute("aria-current", "page"); }
                if (options.disabled) btn.disabled = true;
                if (!options.disabled && !options.active) {
                    btn.addEventListener("click", () => {
                        currentPage = page;
                        cargarArticulos(currentPage, currentSearch);
                    });
                }
                host.appendChild(btn);
            }

            function addEllipsis() {
                const span = document.createElement("span");
                span.className = "page-ellipsis";
                span.textContent = "…";
                host.appendChild(span);
            }

            addButton("‹", actual - 1, { disabled: actual <= 1, aria: "Página anterior" });

            let pages = [];
            if (total <= 9) {
                pages = Array.from({ length: total }, (_, i) => i + 1);
            } else {
                const start = Math.max(2, actual - 3);
                const end = Math.min(total - 1, actual + 3);
                pages.push(1);
                if (start > 2) pages.push("...");
                for (let p = start; p <= end; p++) pages.push(p);
                if (end < total - 1) pages.push("...");
                pages.push(total);
            }

            pages.forEach(p => {
                if (p === "...") { addEllipsis(); return; }
                addButton(String(p), p, { active: p === actual });
            });

            addButton("›", actual + 1, { disabled: actual >= total, aria: "Página siguiente" });
        }

        const buscar = debounce(() => {
            currentSearch = document.getElementById("searchInput").value || "";
            currentPage = 1;
            cargarArticulos(currentPage, currentSearch);
        }, 350);

        document.getElementById("searchInput").addEventListener("input", buscar);

        document.addEventListener("DOMContentLoaded", () => cargarArticulos(currentPage, currentSearch));
    </script>
}
