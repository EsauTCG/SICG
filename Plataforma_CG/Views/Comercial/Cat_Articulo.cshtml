@model IEnumerable<Plataforma_CG.Models.ArticuloSap>

@{
    ViewData["Title"] = "Catalogo de Articulos SAP";
    Layout = "~/Views/Shared/_Layout2.cshtml";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">


<link rel="stylesheet" href="~/css/catalogo-articulos-sap-grid.css" asp-append-version="true" />

<style>
    /* ===============================================================
       CATÁLOGO SAP — ESTILO REFERENCIA + ACENTO TINTO DISCRETO
       =============================================================== */

    :root {
        --cat-bg: #eef2f4;
        --cat-panel: #f5f7f8;
        --cat-head: #d9e2e7;
        --cat-head-2: #cfd9df;
        --cat-line: #bcc8cf;
        --cat-line-soft: #d3dce1;
        --cat-row-alt: #f7f9fa;
        --cat-row-hover: #f3e9eb;

        --cat-text: #34434d;
        --cat-muted: #71808a;

        --cat-tinto: #7a2029;
        --cat-tinto-dark: #5b171e;
        --cat-tinto-soft: #efe1e3;

        --cat-green: #25824d;
        --cat-green-dark: #1e6c40;
    }

    .catalogo-articulos-sap-app,
    .catalogo-articulos-sap-app * {
        box-sizing: border-box !important;
        font-family: 'Poppins', sans-serif !important;
    }

    .catalogo-articulos-sap-app {
        width: 100% !important;
        max-width: none !important;
        min-width: 0 !important;

        margin: 0 !important;
        padding: 0 !important;

        background: var(--cat-bg) !important;
        border: 0 !important;
        border-radius: 0 !important;
        box-shadow: none !important;

        color: var(--cat-text) !important;
        overflow: hidden !important;
    }

    /* La referencia no usa barra tipo ventana */
    .catalogo-articulos-sap-app .titlebar {
        display: none !important;
    }

    /* ===============================================================
       FRANJA DE FILTROS / ACCIONES
       =============================================================== */

    .catalogo-articulos-sap-app .toolbar {
        width: 100% !important;

        display: grid !important;
        grid-template-columns:
            minmax(300px, 1fr)
            auto
            auto !important;

        align-items: end !important;
        column-gap: 10px !important;
        row-gap: 6px !important;

        padding: 10px 12px 11px !important;
        margin: 0 !important;

        background:
            linear-gradient(
                180deg,
                #f2f5f7 0%,
                #e7ecef 100%
            ) !important;

        border-top: 1px solid #d6dee3 !important;
        border-bottom: 1px solid var(--cat-line) !important;
    }

    .catalogo-articulos-sap-app .toolbar .group {
        width: 100% !important;
        min-width: 0 !important;
        margin: 0 !important;
    }

    .catalogo-articulos-sap-app .toolbar .group::before {
        content: "Buscar";

        display: block;
        margin: 0 0 4px 1px;

        color: #4c5c66;
        font-size: 10px;
        font-weight: 700;
        line-height: 1;
    }

    .catalogo-articulos-sap-app #searchInput {
        width: 100% !important;
        height: 30px !important;
        min-height: 30px !important;

        padding: 0 9px !important;

        background: #fff !important;
        color: #46555f !important;

        border: 1px solid #b7c3ca !important;
        border-radius: 1px !important;

        outline: none !important;
        box-shadow: inset 0 1px 2px rgba(0,0,0,.025) !important;

        font-size: 10.8px !important;
        font-weight: 400 !important;
        line-height: 30px !important;
    }

    .catalogo-articulos-sap-app #searchInput::placeholder {
        color: #8c9aa3 !important;
    }

    .catalogo-articulos-sap-app #searchInput:focus {
        border-color: #9d7076 !important;
        box-shadow: 0 0 0 1px rgba(122,32,41,.08) !important;
    }

    /* ===============================================================
       BOTONES — RECTANGULARES COMO REFERENCIA
       =============================================================== */

    .catalogo-articulos-sap-app .tool-btn {
        height: 30px !important;
        min-height: 30px !important;

        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;

        gap: 5px !important;

        padding: 0 10px !important;

        border-radius: 2px !important;
        border: 1px solid transparent !important;

        box-shadow:
            inset 0 1px 0 rgba(255,255,255,.14) !important;

        color: #fff !important;

        font-size: 10.2px !important;
        font-weight: 700 !important;
        line-height: 1 !important;

        white-space: nowrap !important;
        cursor: pointer !important;
    }

    .catalogo-articulos-sap-app .tool-btn i {
        font-size: 11px !important;
        line-height: 1 !important;
    }

    .catalogo-articulos-sap-app .tool-btn-success {
        background: var(--cat-green) !important;
        border-color: var(--cat-green-dark) !important;
    }

    .catalogo-articulos-sap-app .tool-btn-success:hover {
        background: var(--cat-green-dark) !important;
    }

    .catalogo-articulos-sap-app .tool-btn-primary {
        background: var(--cat-tinto) !important;
        border-color: var(--cat-tinto-dark) !important;
    }

    .catalogo-articulos-sap-app .tool-btn-primary:hover {
        background: var(--cat-tinto-dark) !important;
    }

    .catalogo-articulos-sap-app #loader {
        grid-column: 1 / -1 !important;

        color: #65747d !important;

        font-size: 9.5px !important;
        line-height: 1 !important;
    }

    /* ===============================================================
       CONTENIDO
       =============================================================== */

    .catalogo-articulos-sap-app .content,
    .catalogo-articulos-sap-app .workspace,
    .catalogo-articulos-sap-app .section {
        width: 100% !important;
        max-width: none !important;
        min-width: 0 !important;

        margin: 0 !important;
        padding: 0 !important;

        display: block !important;

        background: var(--cat-bg) !important;
    }

    /* Barra "Buscar aquí" como en la referencia */
    .catalogo-articulos-sap-app .table-search-strip {
        width: 100% !important;

        display: flex !important;
        align-items: center !important;
        justify-content: flex-end !important;

        min-height: 36px !important;

        padding: 5px 12px !important;

        background:
            linear-gradient(
                180deg,
                #edf2f4 0%,
                #e4eaed 100%
            ) !important;

        border-bottom: 1px solid var(--cat-line) !important;
    }

    .catalogo-articulos-sap-app .table-search-strip .table-search-display {
        width: min(520px, 48vw) !important;
        height: 26px !important;

        display: flex !important;
        align-items: center !important;

        padding: 0 8px !important;

        background: rgba(255,255,255,.50) !important;
        border: 1px solid #c2cdd3 !important;

        color: #81909a !important;

        font-size: 10px !important;
    }

    /* ===============================================================
       TABLA
       =============================================================== */

    .catalogo-articulos-sap-app .table-wrap {
        width: 100% !important;
        max-width: none !important;

        margin: 0 !important;
        padding: 0 !important;

        background: #fff !important;

        overflow-x: auto !important;
        overflow-y: auto !important;

        border: 0 !important;

        max-height: calc(100vh - 285px) !important;
    }

    .catalogo-articulos-sap-app #tablaPrecios {
        width: 100% !important;
        min-width: 1050px !important;
        max-width: none !important;

        margin: 0 !important;

        table-layout: fixed !important;
        border-collapse: collapse !important;
        border-spacing: 0 !important;

        background: #fff !important;

        color: var(--cat-text) !important;

        font-size: 10.2px !important;
        line-height: 1.05 !important;
    }

    .catalogo-articulos-sap-app #tablaPrecios thead {
        position: sticky !important;
        top: 0 !important;
        z-index: 10 !important;
    }

    .catalogo-articulos-sap-app #tablaPrecios thead th {
        height: 31px !important;
        min-height: 31px !important;

        padding: 4px 6px !important;

        background:
            linear-gradient(
                180deg,
                var(--cat-head) 0%,
                var(--cat-head-2) 100%
            ) !important;

        color: #4c5c65 !important;

        border:
            1px solid var(--cat-line) !important;

        vertical-align: middle !important;

        font-size: 9.2px !important;
        font-weight: 700 !important;
        letter-spacing: .015em !important;
        line-height: 1.05 !important;
        text-transform: uppercase !important;

        white-space: nowrap !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
    }

    /* pequeño indicador visual tipo ordenamiento */
    .catalogo-articulos-sap-app #tablaPrecios thead th::after {
        content: "↕";
        margin-left: 3px;
        color: #87959d;
        font-size: 8px;
        font-weight: 400;
    }

    .catalogo-articulos-sap-app #tablaPrecios tbody td {
        height: 27px !important;
        min-height: 27px !important;

        padding: 3px 6px !important;

        background: #fff !important;
        color: #384851 !important;

        border:
            1px solid var(--cat-line-soft) !important;

        vertical-align: middle !important;

        font-size: 10px !important;
        font-weight: 400 !important;
        line-height: 1.05 !important;

        white-space: nowrap !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
    }

    .catalogo-articulos-sap-app #tablaPrecios tbody tr:nth-child(even) td {
        background: var(--cat-row-alt) !important;
    }

    .catalogo-articulos-sap-app #tablaPrecios tbody tr:hover td {
        background: var(--cat-row-hover) !important;
    }

    /* Distribución de columnas */
    .catalogo-articulos-sap-app #tablaPrecios th:nth-child(1),
    .catalogo-articulos-sap-app #tablaPrecios td:nth-child(1) {
        width: 10% !important;
        text-align: left !important;
    }

    .catalogo-articulos-sap-app #tablaPrecios th:nth-child(2),
    .catalogo-articulos-sap-app #tablaPrecios td:nth-child(2) {
        width: 30% !important;
        text-align: left !important;
    }

    .catalogo-articulos-sap-app #tablaPrecios th:nth-child(3),
    .catalogo-articulos-sap-app #tablaPrecios td:nth-child(3) {
        width: 13% !important;
        text-align: left !important;
    }

    .catalogo-articulos-sap-app #tablaPrecios th:nth-child(4),
    .catalogo-articulos-sap-app #tablaPrecios td:nth-child(4) {
        width: 12% !important;
        text-align: left !important;
    }

    .catalogo-articulos-sap-app #tablaPrecios th:nth-child(5),
    .catalogo-articulos-sap-app #tablaPrecios td:nth-child(5),
    .catalogo-articulos-sap-app #tablaPrecios th:nth-child(6),
    .catalogo-articulos-sap-app #tablaPrecios td:nth-child(6) {
        width: 10% !important;
        text-align: right !important;
    }

    .catalogo-articulos-sap-app #tablaPrecios th:nth-child(7),
    .catalogo-articulos-sap-app #tablaPrecios td:nth-child(7) {
        width: 15% !important;
        text-align: center !important;
    }

    .catalogo-articulos-sap-app .rotacion-input {
        width: 68px !important;
        height: 22px !important;

        margin-left: auto !important;

        padding: 1px 4px !important;

        border: 1px solid #b8c4cb !important;
        border-radius: 1px !important;

        background: #fff !important;
        color: #384851 !important;

        font-size: 10px !important;
        text-align: right !important;

        box-shadow: none !important;
    }

    /* ===============================================================
       PAGINACIÓN NUMÉRICA
       =============================================================== */

    .catalogo-articulos-sap-app .pager {
        width: 100% !important;

        display: flex !important;
        align-items: center !important;
        justify-content: flex-end !important;

        gap: 0 !important;

        min-height: 42px !important;

        margin: 0 !important;
        padding: 6px 12px !important;

        background:
            linear-gradient(
                180deg,
                #edf2f4 0%,
                #e4eaed 100%
            ) !important;

        border-top: 1px solid #c2cdd3 !important;
    }

    .catalogo-articulos-sap-app .pagination-numeric {
        display: flex !important;
        align-items: center !important;
        gap: 0 !important;
    }

    .catalogo-articulos-sap-app .page-num-btn {
        min-width: 30px !important;
        height: 29px !important;

        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;

        margin-left: -1px !important;
        padding: 0 7px !important;

        background: #f7f9fa !important;
        color: #52636d !important;

        border: 1px solid #bdc8ce !important;
        border-radius: 0 !important;

        font-size: 9.9px !important;
        font-weight: 600 !important;
        line-height: 1 !important;

        cursor: pointer !important;
        box-shadow: none !important;
    }

    .catalogo-articulos-sap-app .page-num-btn:hover:not(:disabled) {
        background: var(--cat-tinto-soft) !important;
        color: var(--cat-tinto-dark) !important;
    }

    .catalogo-articulos-sap-app .page-num-btn.active {
        position: relative !important;
        z-index: 2 !important;

        background: var(--cat-tinto) !important;
        border-color: var(--cat-tinto) !important;
        color: #fff !important;
    }

    .catalogo-articulos-sap-app .page-num-btn:disabled {
        opacity: .45 !important;
        cursor: default !important;
    }

    .catalogo-articulos-sap-app .page-ellipsis {
        min-width: 30px !important;
        height: 29px !important;

        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;

        margin-left: -1px !important;

        border: 1px solid #bdc8ce !important;
        background: #f3f6f7 !important;
        color: #7b8991 !important;

        font-size: 9.2px !important;
    }

    /* ===============================================================
       STATUS BAR
       =============================================================== */

    .catalogo-articulos-sap-app .statusbar {
        min-height: 25px !important;

        display: flex !important;
        align-items: center !important;
        justify-content: space-between !important;
        gap: 12px !important;

        padding: 4px 10px !important;

        background: #e1e8ec !important;
        color: #687983 !important;

        border-top: 1px solid #bec9cf !important;

        font-size: 9px !important;
        font-weight: 400 !important;
    }

    /* ===============================================================
       RESPONSIVE
       =============================================================== */

    @@media (max-width: 900px) {
        .catalogo-articulos-sap-app .toolbar {
            grid-template-columns: 1fr auto auto !important;
        }

        .catalogo-articulos-sap-app #tablaPrecios {
            min-width: 1000px !important;
        }

        .catalogo-articulos-sap-app .table-search-strip .table-search-display {
            width: min(440px, 70vw) !important;
        }
    }

    @@media (max-width: 640px) {
        .catalogo-articulos-sap-app .toolbar {
            grid-template-columns: 1fr 1fr !important;
        }

        .catalogo-articulos-sap-app .toolbar .group {
            grid-column: 1 / -1 !important;
        }

        .catalogo-articulos-sap-app .tool-btn {
            width: 100% !important;
        }

        .catalogo-articulos-sap-app .pager {
            justify-content: center !important;
            overflow-x: auto !important;
        }

        .catalogo-articulos-sap-app .statusbar {
            justify-content: flex-start !important;
            flex-wrap: wrap !important;
        }
    }
</style>


<style id="catalogo-poppins-tinto-final">
    .catalogo-articulos-sap-app,
    .catalogo-articulos-sap-app * {
        font-family: 'Poppins', sans-serif !important;
    }

    .catalogo-articulos-sap-app #tablaPrecios thead th {
        font-weight: 600 !important;
        letter-spacing: .015em !important;
        color: #584b4e !important;
    }

    .catalogo-articulos-sap-app #tablaPrecios tbody td {
        font-weight: 400 !important;
        color: #463d3f !important;
    }

    .catalogo-articulos-sap-app .toolbar .group::before {
        color: #5d4f52 !important;
        font-weight: 600 !important;
    }

    .catalogo-articulos-sap-app #searchInput {
        font-weight: 400 !important;
        color: #4b4143 !important;
    }

    .catalogo-articulos-sap-app .tool-btn {
        font-weight: 600 !important;
    }

    .catalogo-articulos-sap-app .page-num-btn {
        font-weight: 500 !important;
    }

    .catalogo-articulos-sap-app .page-num-btn.active {
        background: #7a2029 !important;
        border-color: #7a2029 !important;
        color: #fff !important;
    }

    .catalogo-articulos-sap-app .tool-btn-primary {
        background: #7a2029 !important;
        border-color: #641a22 !important;
    }

    .catalogo-articulos-sap-app .tool-btn-primary:hover {
        background: #641a22 !important;
    }

    .catalogo-articulos-sap-app #tablaPrecios tbody tr:hover td {
        background: #f5eaec !important;
    }
</style>


<style id="catalogo-articulos-texto-marcado-final">
    /* ===============================================================
       CATÁLOGO DE ARTÍCULOS SAP
       TEXTO MÁS NÍTIDO Y MARCADO + BOOTSTRAP ICONS CORRECTOS
       =============================================================== */

    .catalogo-articulos-sap-app {
        -webkit-font-smoothing: antialiased !important;
        -moz-osx-font-smoothing: grayscale !important;
        text-rendering: geometricPrecision !important;
    }

    .catalogo-articulos-sap-app,
    .catalogo-articulos-sap-app button,
    .catalogo-articulos-sap-app input,
    .catalogo-articulos-sap-app select,
    .catalogo-articulos-sap-app textarea,
    .catalogo-articulos-sap-app table {
        font-family: "Poppins", sans-serif !important;
    }

    /* ===============================================================
       FIX BOOTSTRAP ICONS
       =============================================================== */

    .catalogo-articulos-sap-app .bi,
    .catalogo-articulos-sap-app .bi::before,
    .catalogo-articulos-sap-app [class^="bi-"],
    .catalogo-articulos-sap-app [class*=" bi-"] {
        font-family: "bootstrap-icons" !important;
        font-style: normal !important;
        font-weight: normal !important;
        font-variant: normal !important;
        text-transform: none !important;
        line-height: 1 !important;
        -webkit-font-smoothing: antialiased !important;
        -moz-osx-font-smoothing: grayscale !important;
    }

    /* ===============================================================
       TABLA PRINCIPAL — MÁS MARCADA COMO LA REFERENCIA
       =============================================================== */

    .catalogo-articulos-sap-app #tablaPrecios thead th {
        color: #3f4549 !important;

        font-size: 9.4px !important;
        font-weight: 700 !important;
        line-height: 1.08 !important;
        letter-spacing: .01em !important;

        border-color: #aebbc3 !important;

        text-shadow: 0 0 .01px currentColor !important;
    }

    .catalogo-articulos-sap-app #tablaPrecios tbody td {
        color: #30373b !important;

        font-size: 10.2px !important;
        font-weight: 500 !important;
        line-height: 1.12 !important;

        border-color: #c5d0d6 !important;

        text-shadow: 0 0 .01px currentColor !important;
    }

    /* SKU */
    .catalogo-articulos-sap-app #tablaPrecios tbody td:nth-child(1) {
        color: #293135 !important;
        font-weight: 600 !important;
    }

    /* Producto */
    .catalogo-articulos-sap-app #tablaPrecios tbody td:nth-child(2) {
        color: #252d31 !important;
        font-weight: 500 !important;
    }

    /* Master y Tipo SKU */
    .catalogo-articulos-sap-app #tablaPrecios tbody td:nth-child(3),
    .catalogo-articulos-sap-app #tablaPrecios tbody td:nth-child(4) {
        color: #333b3f !important;
        font-weight: 500 !important;
    }

    /* Rotación y Kg Promedio */
    .catalogo-articulos-sap-app #tablaPrecios tbody td:nth-child(5),
    .catalogo-articulos-sap-app #tablaPrecios tbody td:nth-child(6) {
        color: #292f33 !important;
        font-weight: 600 !important;
    }

    /* Fecha */
    .catalogo-articulos-sap-app #tablaPrecios tbody td:nth-child(7) {
        color: #3b4347 !important;
        font-weight: 500 !important;
    }

    .catalogo-articulos-sap-app #tablaPrecios tbody tr:nth-child(even) td {
        background: #f2f5f6 !important;
    }

    .catalogo-articulos-sap-app #tablaPrecios tbody tr:hover td {
        background: #f3e7e9 !important;
        color: #272d31 !important;
    }

    /* ===============================================================
       BUSCADOR
       =============================================================== */

    .catalogo-articulos-sap-app #searchInput {
        color: #353b3f !important;
        font-size: 10.8px !important;
        font-weight: 500 !important;
    }

    .catalogo-articulos-sap-app #searchInput::placeholder {
        color: #7d898f !important;
        font-weight: 400 !important;
        opacity: 1 !important;
    }

    .catalogo-articulos-sap-app .toolbar .group::before {
        color: #454d51 !important;
        font-size: 9.8px !important;
        font-weight: 700 !important;
    }

    /* ===============================================================
       BOTONES
       =============================================================== */

    .catalogo-articulos-sap-app .tool-btn {
        font-family: "Poppins", sans-serif !important;
        font-size: 9.8px !important;
        font-weight: 700 !important;
    }

    /* ===============================================================
       ROTACIÓN
       =============================================================== */

    .catalogo-articulos-sap-app .rotacion-text {
        color: #292f33 !important;
        font-weight: 600 !important;
    }

    .catalogo-articulos-sap-app .rotacion-input {
        color: #30373b !important;
        font-size: 10px !important;
        font-weight: 600 !important;
    }

    /* ===============================================================
       PAGINACIÓN
       =============================================================== */

    .catalogo-articulos-sap-app .page-num-btn {
        color: #424b50 !important;
        font-size: 9.8px !important;
        font-weight: 600 !important;
    }

    .catalogo-articulos-sap-app .page-num-btn.active {
        background: #7a2029 !important;
        border-color: #7a2029 !important;
        color: #fff !important;
        font-weight: 700 !important;
    }

    /* ===============================================================
       STATUS BAR
       =============================================================== */

    .catalogo-articulos-sap-app .statusbar {
        color: #59666d !important;
        font-size: 9px !important;
        font-weight: 500 !important;
    }

    /* Barra espejo "Buscar aquí" */
    .catalogo-articulos-sap-app .table-search-display {
        color: #68767e !important;
        font-size: 9.8px !important;
        font-weight: 500 !important;
    }
</style>

<div class="window catalogo-articulos-sap-app">

    <!-- Filtros / acciones -->
    <div class="toolbar">

        <div class="group">
            <label for="searchInput" class="visually-hidden">Buscar</label>

            <input type="text"
                   id="searchInput"
                   class="form-control"
                   placeholder="Escriba código, producto, master o tipo SKU..." />
        </div>


        <button id="btnDescargarExcel"
                class="tool-btn tool-btn-success"
                type="button">
            <i class="bi bi-file-earmark-excel-fill"></i>
            Excel
        </button>


        <button id="btnSincronizar"
                class="tool-btn tool-btn-primary"
                type="button">
            <i class="bi bi-cloud-arrow-down-fill"></i>
            Sincronizar
        </button>


        <span id="loader"
              style="display:none;">
            ⏳ Sincronizando…
        </span>

    </div>


    <div class="content">

        <div class="workspace">

            <div class="section">

                <!-- Franja visual como la búsqueda de la referencia -->
                <div class="table-search-strip">
                    <div class="table-search-display">
                        Buscar aquí
                    </div>
                </div>


                <div class="table-wrap">

                    <table id="tablaPrecios"
                           class="table mb-0">

                        <colgroup>
                            <col style="width:10%">
                            <col style="width:30%">
                            <col style="width:13%">
                            <col style="width:12%">
                            <col style="width:10%">
                            <col style="width:10%">
                            <col style="width:15%">
                        </colgroup>

                        <thead>
                            <tr>
                                <th>SKU</th>
                                <th>Producto</th>
                                <th>Master</th>
                                <th>Tipo SKU</th>
                                <th>Rotación</th>
                                <th>Kg Promedio</th>
                                <th>Última Modificación</th>
                            </tr>
                        </thead>

                        <tbody></tbody>

                    </table>

                </div>


                <div class="pager">
                    <div id="numericPager"
                         class="pagination-numeric">
                    </div>
                </div>

            </div>

        </div>

    </div>


    <div class="statusbar">
        <div id="statusPageInfo">Registro listo</div>
        <div>Usuario: @User.Identity.Name</div>
        <div>Empresa: Carnes G SA de CV</div>
        <div>Módulo: Catálogo SAP</div>
    </div>

</div>

@section Scripts {
  

    <script>
        let currentPage = 1;
        let pageSize = 50;
        let currentSearch = "";
        let totalItems = 0;
        let totalPages = 0;

        function debounce(fn, ms=300){
        let t; return (...a)=>{ clearTimeout(t); t=setTimeout(()=>fn(...a), ms); };
        }

        async function cargarArticulos(page = 1, search = "") {
        const tbody = document.querySelector("#tablaPrecios tbody");
        tbody.innerHTML = `<tr><td colspan="7" class="text-center">⏳ Cargando...</td></tr>`;
        document.getElementById("loader").style.display = "inline";

        

        try {
        const res = await fetch(`/Comercial/GetArticulosJsonPaged?page=${page}&pageSize=${pageSize}&search=${encodeURIComponent(search)}`);
        if (!res.ok) throw new Error("Error al cargar artículos");

        const data = await res.json();
        tbody.innerHTML = "";

        const rows = Array.isArray(data.articulos) ? data.articulos : [];
        totalItems = Number(data.total || 0);
        totalPages = Math.max(1, Math.ceil((data.total || 0) / (data.pageSize || pageSize)));

        if (rows.length === 0) {
        tbody.innerHTML = `<tr><td colspan="7" class="text-center text-warning py-4">No hay artículos para mostrar.</td></tr>`;
        document.getElementById("statusPageInfo").textContent = "Sin resultados";
        renderNumericPager();
        return;
        }

        rows.forEach((art) => {
        const kilosVal = (typeof art.u_KilosCaja === "number") ? art.u_KilosCaja : null;
        const kilosTxt = (kilosVal !== null)
        ? kilosVal.toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
        : "—";

        const tr = document.createElement("tr");
        tr.dataset.codigo = art.productoCodigo;
        tr.innerHTML = `
        <td>${art.productoCodigo ?? "—"}</td>
        <td>${(art.productoNombre ?? "—")}</td>
        <td>${art.u_MASTER ?? "—"}</td>
        <td>${art.u_TipoporSKU ?? "—"}</td>
        <td>
        <span class="rotacion-text">${art.rotacion ?? 0}</span>
        <input class="rotacion-input form-control form-control-sm" type="number"
        style="display:none; width:90px;" value="${art.rotacion ?? 0}">
        </td>
        <td>${kilosTxt}</td>
        <td>${art.fechaModificacion ? new Date(art.fechaModificacion).toLocaleString('es-MX') : "—"}</td>
        `;
        tbody.appendChild(tr);
        });

        currentPage = Number(data.page || page);
        pageSize = Number(data.pageSize || pageSize);
        document.getElementById("statusPageInfo").textContent =
        `Página ${currentPage} de ${totalPages} · Registros: ${totalItems.toLocaleString('es-MX')}`;

        renderNumericPager();
        agregarEventosFila();
        } catch (err) {
        tbody.innerHTML = `<tr><td colspan="7" class="text-center text-danger py-4">Error: ${err.message}</td></tr>`;
        document.getElementById("statusPageInfo").textContent = "Error";
        } finally {
        document.getElementById("loader").style.display = "none";
        }
        }

        function agregarEventosFila() {
        document.querySelectorAll('.btn-editar')?.forEach(btn => {
        btn.onclick = function () {
        const tr = this.closest('tr');
        tr.querySelector('.rotacion-text').style.display = 'none';
        tr.querySelector('.rotacion-input').style.display = 'inline-block';
        tr.querySelector('.btn-editar').style.display = 'none';
        tr.querySelector('.btn-guardar').style.display = 'inline-block';
        tr.querySelector('.btn-cancelar').style.display = 'inline-block';
        }
        });

        document.querySelectorAll('.btn-cancelar')?.forEach(btn => {
        btn.onclick = function () {
        const tr = this.closest('tr');
        const span = tr.querySelector('.rotacion-text');
        const input = tr.querySelector('.rotacion-input');
        input.value = span.textContent;
        span.style.display = 'inline';
        input.style.display = 'none';
        tr.querySelector('.btn-editar').style.display = 'inline-block';
        tr.querySelector('.btn-guardar').style.display = 'none';
        tr.querySelector('.btn-cancelar').style.display = 'none';
        }
        });

        document.querySelectorAll('.btn-guardar')?.forEach(btn => {
        btn.onclick = async function () {
        const tr = this.closest('tr');
        const codigo = tr.dataset.codigo;
        const nuevaRotacion = tr.querySelector('.rotacion-input').value;

        try {
        const res = await fetch(`/Comercial/ActualizarRotacion?codigo=${encodeURIComponent(codigo)}&rotacion=${encodeURIComponent(nuevaRotacion)}`, { method: 'POST' });
        if (!res.ok) throw new Error("No se pudo actualizar la rotación");

        tr.querySelector('.rotacion-text').textContent = nuevaRotacion;
        tr.querySelector('.rotacion-text').style.display = 'inline';
        tr.querySelector('.rotacion-input').style.display = 'none';
        tr.querySelector('.btn-editar').style.display = 'inline-block';
        tr.querySelector('.btn-guardar').style.display = 'none';
        tr.querySelector('.btn-cancelar').style.display = 'none';
        } catch (err) {
        alert("Error al guardar rotación: " + err.message);
        }
        }
        });
        }

        function descargarTablaExcel() {
        const tabla = document.getElementById("tablaPrecios");
        const filas = tabla.querySelectorAll("tbody tr");

        if (!filas.length || (filas.length === 1 && filas[0].innerText.includes("No hay artículos"))) {
        alert("No hay datos para exportar.");
        return;
        }

        const data = [];

        data.push([
        "Sku",
        "Producto",
        "Master",
        "Tipo SKU",
        "Rotación",
        "Kg Promedio",
        "Última Modificación"
        ]);

        filas.forEach(fila => {
        const celdas = fila.querySelectorAll("td");
        if (celdas.length >= 7) {
        data.push([
        celdas[0].innerText.trim(),
        celdas[1].innerText.trim(),
        celdas[2].innerText.trim(),
        celdas[3].innerText.trim(),
        celdas[4].querySelector(".rotacion-text")
        ? celdas[4].querySelector(".rotacion-text").innerText.trim()
        : celdas[4].innerText.trim(),
        celdas[5].innerText.trim(),
        celdas[6].innerText.trim()
        ]);
        }
        });

        const ws = XLSX.utils.aoa_to_sheet(data);
        const wb = XLSX.utils.book_new();
        XLSX.utils.book_append_sheet(wb, ws, "ArticulosSAP");

        const fecha = new Date();
        const yyyy = fecha.getFullYear();
        const mm = String(fecha.getMonth() + 1).padStart(2, '0');
        const dd = String(fecha.getDate()).padStart(2, '0');

        XLSX.writeFile(wb, `Catalogo_Articulos_SAP_${yyyy}-${mm}-${dd}.xlsx`);
        }

        document.getElementById("btnDescargarExcel").addEventListener("click", function () {
        const search = document.getElementById("searchInput").value || "";
        const url = `/Comercial/DescargarArticulosExcel?search=${encodeURIComponent(search)}`;
        window.location.href = url;
        });

        document.getElementById("btnSincronizar").addEventListener("click", async function () {
        const loader = document.getElementById("loader");
        loader.style.display = "inline";
        this.disabled = true;

        try {
        const res = await fetch('/Comercial/SincronizarItems');
        if (!res.ok) throw new Error('Error al sincronizar');

        const data = await res.text();
        alert(data);
        await cargarArticulos(currentPage, currentSearch);
        } catch (err) {
        alert(err.message);
        } finally {
        loader.style.display = "none";
        this.disabled = false;
        }
        });


        function renderNumericPager() {
            const host = document.getElementById("numericPager");
            if (!host) return;

            host.innerHTML = "";

            const total = Math.max(1, Number(totalPages || 1));
            const actual = Math.max(1, Math.min(Number(currentPage || 1), total));

            function addButton(label, page, options = {}) {
                const btn = document.createElement("button");
                btn.type = "button";
                btn.className = "page-num-btn";

                if (options.active) {
                    btn.classList.add("active");
                }

                btn.textContent = label;

                if (options.disabled) {
                    btn.disabled = true;
                }

                if (!options.disabled && !options.active) {
                    btn.addEventListener("click", () => {
                        currentPage = page;
                        cargarArticulos(currentPage, currentSearch);
                    });
                }

                host.appendChild(btn);
            }

            function addEllipsis() {
                const span = document.createElement("span");
                span.className = "page-ellipsis";
                span.textContent = "…";
                host.appendChild(span);
            }

            addButton("‹", actual - 1, {
                disabled: actual <= 1
            });

            let pages = [];

            if (total <= 9) {
                pages = Array.from(
                    { length: total },
                    (_, i) => i + 1
                );
            }
            else {
                const start = Math.max(
                    2,
                    actual - 3
                );

                const end = Math.min(
                    total - 1,
                    actual + 3
                );

                pages.push(1);

                if (start > 2) {
                    pages.push("...");
                }

                for (let p = start; p <= end; p++) {
                    pages.push(p);
                }

                if (end < total - 1) {
                    pages.push("...");
                }

                pages.push(total);
            }

            pages.forEach(p => {
                if (p === "...") {
                    addEllipsis();
                    return;
                }

                addButton(
                    String(p),
                    p,
                    {
                        active: p === actual
                    }
                );
            });

            addButton("›", actual + 1, {
                disabled: actual >= total
            });
        }

        const buscar = debounce(() => {
        currentSearch = document.getElementById("searchInput").value || "";
        currentPage = 1;
        cargarArticulos(currentPage, currentSearch);
        }, 350);

        document.getElementById("searchInput").addEventListener("input", function () {
            const mirror = document.querySelector(".table-search-display");
            if (mirror) {
                mirror.textContent = this.value.trim() || "Buscar aquí";
            }

            buscar();
        });

        

        document.addEventListener("DOMContentLoaded", () => cargarArticulos(currentPage, currentSearch));
    </script>
}