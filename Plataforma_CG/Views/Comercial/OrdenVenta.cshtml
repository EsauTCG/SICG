@using Plataforma_CG.ViewModels;
@model Plataforma_CG.ViewModels.PedidoViewModel;

@{
    var productos = Model?.Productos ?? new List<PedidoProductoViewModel>();
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Nuevo Orden de Venta";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap');

    /* =====================================================================
       NUEVA ORDEN DE VENTA · SIGO — hoja de estilos única
       Mismo sistema visual que Entregas SAP, Costeo e Integraciones SAP.
       Sustituye las ~15 capas anteriores. Incluye modo oscuro del layout.
       ===================================================================== */
    :root {
        --es-tinto: #8d3e46;
        --es-tinto-deep: #5c2229;
        --es-tinto-soft: #f7eced;
        --es-tinto-line: #e8d3d6;
        --es-paper: #f6f4f4;
        --es-surface: #ffffff;
        --es-field: #ffffff;
        --es-field-ro: #f6f3f3;
        --es-head: #faf7f7;
        --es-hover: #fcf9f9;
        --es-row-line: #f0eaeb;
        --es-ink: #231a1c;
        --es-muted: #76686b;
        --es-line: #e6dfe0;
        --es-line-strong: #cfc4c6;
        --es-ok: #2f7a55;
        --es-ok-bg: #e7f3ec;
        --es-warn: #9a6410;
        --es-warn-bg: #fbf1de;
        --es-bad: #b42d2d;
        --es-bad-bg: #fbe9e8;
        --es-info: #2f5d86;
        --es-info-bg: #e9f0f7;
        --es-font: "Poppins", "Segoe UI", system-ui, -apple-system, Arial, sans-serif;
    }

    body[data-theme="dark"] {
        --es-tinto: #c56b74;
        --es-tinto-deep: #7a2d36;
        --es-tinto-soft: #3a2427;
        --es-tinto-line: #5a3439;
        --es-paper: #16181c;
        --es-surface: #202328;
        --es-field: #181a1e;
        --es-field-ro: #262a30;
        --es-head: #262a30;
        --es-hover: #2a2e34;
        --es-row-line: #30343b;
        --es-ink: #edf0f3;
        --es-muted: #a9b0b9;
        --es-line: #363b43;
        --es-line-strong: #4a5059;
        --es-ok: #6cc596;
        --es-ok-bg: #1d3328;
        --es-warn: #e0b061;
        --es-warn-bg: #3a2f1b;
        --es-bad: #f08a83;
        --es-bad-bg: #3d2223;
        --es-info: #8bb8e0;
        --es-info-bg: #1e2b38;
    }

    /* Ajuste mínimo de layout: el módulo usa el ancho real que deja el sidebar. */
    .layout-main-content { min-width: 0 !important; }
    .layout-main-content .container, .layout-main-content .container-fluid { max-width: 100% !important; }

    .ovx, .ovx-modal, .ui-autocomplete { font-family: var(--es-font) !important; }
    .ovx { color: var(--es-ink); font-size: 13px; line-height: 1.4; background: var(--es-paper); padding: 16px 18px 0; min-width: 0; }
    .ovx *, .ovx-modal * { box-sizing: border-box; }
    .ovx .bi, .ovx-modal .bi { font-family: "bootstrap-icons" !important; }
    .es-muted { color: var(--es-muted) !important; }
    .es-num { font-variant-numeric: tabular-nums; }

    /* ---------- Encabezado ---------- */
    .ov-header { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 14px; }
    .ov-header__title { display: flex; align-items: center; gap: 12px; }
    .ov-header__icon { width: 40px; height: 40px; border-radius: 10px; display: grid; place-items: center; background: var(--es-tinto); color: #fff; font-size: 19px; }
    .ov-header h1 { margin: 0; font-size: 20px; font-weight: 700; letter-spacing: -.01em; line-height: 1.15; color: var(--es-ink); }
    .ov-header p { margin: 2px 0 0; font-size: 12px; color: var(--es-muted); }
    .ov-header__actions { display: flex; gap: 8px; flex-wrap: wrap; }

    /* ---------- Botones ---------- */
    .ovx .btn, .ovx-modal .btn, .es-btn {
        display: inline-flex; align-items: center; justify-content: center; gap: 6px;
        height: 36px; padding: 0 14px; border: 1px solid var(--es-line-strong); border-radius: 7px;
        background: var(--es-field); color: var(--es-ink); font: 600 12.5px/1 var(--es-font);
        white-space: nowrap; cursor: pointer; text-decoration: none; box-shadow: none;
        transition: background .12s, border-color .12s, color .12s;
    }
    .ovx .btn:hover, .ovx-modal .btn:hover, .es-btn:hover { background: var(--es-tinto-soft); border-color: var(--es-tinto-line); color: var(--es-ink); }
    .ovx .btn:focus-visible, .ovx-modal .btn:focus-visible, .es-btn:focus-visible { outline: 2px solid var(--es-tinto); outline-offset: 2px; box-shadow: none; }
    .ovx .btn:disabled, .ovx-modal .btn:disabled, .es-btn:disabled { opacity: .5; cursor: not-allowed; }
    .ovx .btn-reflejo, .ovx .btn-success, .ovx .btn-danger, .ovx-modal .btn-reflejo, .ovx-modal .btn-danger, .ovx-modal .btn-primary, .es-btn--primary {
        background: var(--es-tinto); border-color: var(--es-tinto); color: #fff;
    }
    .ovx .btn-reflejo:hover, .ovx .btn-success:hover, .ovx .btn-danger:hover, .ovx-modal .btn-reflejo:hover, .ovx-modal .btn-danger:hover, .ovx-modal .btn-primary:hover, .es-btn--primary:hover {
        background: var(--es-tinto-deep); border-color: var(--es-tinto-deep); color: #fff;
    }
    .ovx .btn-outline-danger { color: var(--es-bad); border-color: var(--es-line-strong); }
    .ovx .btn-outline-danger:hover { background: var(--es-bad-bg); border-color: var(--es-bad); color: var(--es-bad); }
    .ovx .btn-sm, .ovx-modal .btn-sm { height: 28px; padding: 0 9px; font-size: 11.5px; border-radius: 6px; }
    .ovx .btn-inventario { height: 28px; padding: 0 9px; font-size: 11.5px; background: var(--es-info-bg); border-color: transparent; color: var(--es-info); }
    .ovx .btn-inventario:hover { background: var(--es-info-bg); border-color: var(--es-info); color: var(--es-info); }
    .ov-delete-link { display: inline-grid; place-items: center; width: 30px; height: 28px; border-radius: 6px; color: var(--es-muted) !important; text-decoration: none; }
    .ov-delete-link:hover { background: var(--es-bad-bg); color: var(--es-bad) !important; }

    /* ---------- Campos ---------- */
    .ovx .form-label, .ovx-modal .form-label { display: block; margin: 0 0 5px; font-size: 12px; font-weight: 600; color: var(--es-muted); text-transform: none; letter-spacing: 0; }
    .ovx .form-control, .ovx .form-select, .ovx-modal .form-control, .ovx-modal .form-select {
        height: 36px; min-height: 36px; padding: 0 10px; border: 1px solid var(--es-line-strong); border-radius: 7px;
        background-color: var(--es-field); color: var(--es-ink); font: 500 13px/1.2 var(--es-font); box-shadow: none;
    }
    .ovx .form-select, .ovx-modal .form-select { padding-right: 30px; }
    body[data-theme="dark"] .ovx .form-control, body[data-theme="dark"] .ovx .form-select, body[data-theme="dark"] .ovx-modal .form-control, body[data-theme="dark"] .ovx-modal .form-select { color-scheme: dark; }
    .ovx textarea.form-control, .ovx-modal textarea.form-control { height: auto; padding: 9px 10px; line-height: 1.45; resize: vertical; }
    .ovx .form-control:focus, .ovx .form-select:focus, .ovx-modal .form-control:focus, .ovx-modal .form-select:focus { border-color: var(--es-tinto); box-shadow: 0 0 0 3px rgba(141,62,70,.16); outline: none; background-color: var(--es-field); color: var(--es-ink); }
    .ovx .form-control[readonly] { background: var(--es-field-ro); color: var(--es-ink); }
    .ovx .form-control::placeholder, .ovx-modal .form-control::placeholder { color: var(--es-muted); opacity: .8; }
    .ovx input[type="file"].form-control { padding: 6px 8px; }
    .ovx .help, .ovx .form-text { margin-top: 4px; font-size: 11.5px; color: var(--es-muted); line-height: 1.3; }
    .ovx .is-invalid { border-color: var(--es-bad) !important; background-color: var(--es-bad-bg) !important; }

    /* ---------- Tarjetas ---------- */
    .ov-grid { display: grid; grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: 12px; margin-bottom: 12px; align-items: start; }
    .ov-card { background: var(--es-surface); border: 1px solid var(--es-line); border-radius: 10px; min-width: 0; }
    .ov-card__head { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; padding: 11px 14px; border-bottom: 1px solid var(--es-line); }
    .ov-card__title { display: flex; align-items: center; gap: 10px; margin: 0; font-size: 14px; font-weight: 600; color: var(--es-ink); }
    .ov-step { width: 24px; height: 24px; border-radius: 50%; display: inline-grid; place-items: center; background: var(--es-tinto-soft); color: var(--es-tinto); font-size: 12px; font-weight: 700; flex: none; transition: background .2s, color .2s; }
    .ov-step.is-done { background: var(--es-ok); color: #fff; }
    .ov-card__body { padding: 14px; }
    .ov-fields { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 12px; }
    .ov-col-6 { grid-column: span 6; }
    .ov-col-3 { grid-column: span 3; }
    .ov-col-2 { grid-column: span 2; }

    /* Cliente */
    #clienteInput { height: 44px !important; font-size: 15px !important; font-weight: 600 !important; text-transform: uppercase; border-top-right-radius: 0 !important; border-bottom-right-radius: 0 !important; }
    #btnBuscarCliente { height: 44px; border-top-left-radius: 0; border-bottom-left-radius: 0; margin-left: -1px; }
    .ov-hint { display: flex; align-items: center; gap: 6px; margin-top: 6px; font-size: 11.5px; color: var(--es-muted); }
    .ov-muestra { display: flex; align-items: center; gap: 8px; margin-top: 10px; padding: 8px 10px; border: 1px dashed var(--es-line-strong); border-radius: 7px; cursor: pointer; }
    .ov-muestra:has(input:checked) { border-style: solid; border-color: var(--es-warn); background: var(--es-warn-bg); }
    .ovx #chkEsMuestra { width: 17px; height: 17px; margin: 0; accent-color: var(--es-tinto); cursor: pointer; float: none; }
    .ovx #chkEsMuestra + label { margin: 0; font-size: 12.5px; font-weight: 600; color: var(--es-ink); cursor: pointer; }

    /* Crédito */
    .ov-credit { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--es-line); }
    .ov-metric { padding: 8px 10px; border: 1px solid var(--es-line); border-radius: 8px; background: var(--es-head); }
    .ov-metric .form-label { display: flex; align-items: center; gap: 5px; margin-bottom: 2px; font-size: 11.5px; }
    .ovx .ov-metric .form-control { height: auto; min-height: 0; padding: 0; border: 0; background: transparent; font-size: 16px; font-weight: 700; font-variant-numeric: tabular-nums; box-shadow: none; }
    .ov-metric.is-alert { border-color: var(--es-bad); background: var(--es-bad-bg); }
    .ovx .ov-metric.is-alert .form-control, .ov-metric.is-alert .form-label { color: var(--es-bad); }
    .ov-metric__note { display: none; margin-top: 2px; font-size: 11px; color: var(--es-bad); }
    .ov-metric.is-alert .ov-metric__note { display: block; }

    /* Logística */
    .ov-logistica-capacidad { display: none; margin-top: 6px; padding: 7px 9px; border: 1px solid var(--es-line-strong); border-radius: 7px; background: var(--es-head); color: var(--es-ink); font-size: 11.5px; line-height: 1.3; font-weight: 500; }
    .ov-logistica-capacidad.is-visible { display: block; }
    .ov-logistica-capacidad.is-warning { border-color: var(--es-warn); background: var(--es-warn-bg); color: var(--es-warn); }
    .ov-logistica-capacidad.is-danger { border-color: var(--es-bad); background: var(--es-bad-bg); color: var(--es-bad); }
    .ov-alert-inline { margin-top: 6px; padding: 7px 9px; border-radius: 7px; background: var(--es-bad-bg); color: var(--es-bad); font-size: 11.5px; }

    /* ---------- Productos ---------- */
    .ov-products-tools { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; padding: 10px 14px; border-bottom: 1px solid var(--es-line); }
    .ov-products-tools__group { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .ov-excel { display: flex; align-items: center; gap: 6px; }
    .ovx .ov-excel input[type="file"] { width: 230px; height: 36px; font-size: 12px; }
    .ov-divider { width: 1px; height: 22px; background: var(--es-line); }

    .ov-table-wrap { overflow: auto; max-height: 58vh; }
    .ovx .ov-table { width: 100%; min-width: 1120px; margin: 0; border-collapse: separate; border-spacing: 0; font-size: 12.5px; color: var(--es-ink); --bs-table-bg: transparent; --bs-table-color: var(--es-ink); --bs-table-striped-bg: transparent; --bs-table-hover-bg: transparent; }
    .ovx .ov-table thead th { position: sticky; top: 0; z-index: 2; padding: 9px 8px; background: var(--es-head); border-bottom: 1px solid var(--es-line); color: var(--es-muted); font-size: 11.5px; font-weight: 600; text-align: left; white-space: nowrap; text-transform: none; }
    .ovx .ov-table tbody td { padding: 6px 8px; border-bottom: 1px solid var(--es-row-line); background: var(--es-surface); color: var(--es-ink); vertical-align: middle; white-space: nowrap; box-shadow: none; }
    .ovx .ov-table tbody tr:hover td { background: var(--es-hover); }
    .ovx .ov-table .form-control { height: 32px; min-height: 32px; padding: 0 8px; font-size: 12.5px; }
    .ovx .ov-table .peso, .ovx .ov-table .precio, .ovx .ov-table .cajas, .ovx .ov-table .subtotal, .ovx .ov-table .presupuesto, .ovx .ov-table .variacionPresupuesto { text-align: right; font-variant-numeric: tabular-nums; }
    .ovx .ov-table .subtotal { font-weight: 600; }
    .ovx .ov-table td:first-child { width: 44px; color: var(--es-muted); font-variant-numeric: tabular-nums; text-align: center; }
    .ovx .ov-table th:nth-child(2) { min-width: 300px; }
    .ovx .ov-table td:nth-child(2) { min-width: 300px; max-width: 420px; overflow: hidden; text-overflow: ellipsis; }
    .ovx .ov-table th:nth-child(3), .ovx .ov-table th:nth-child(4) { width: 120px; }
    .ovx .ov-table th:nth-child(5), .ovx .ov-table th:nth-child(6) { width: 110px; }
    .ovx .ov-table th:nth-child(7) { width: 90px; }
    .ovx .ov-table th:nth-child(8) { width: 130px; }
    .ovx .ov-table th:nth-child(9), .ovx .ov-table th:nth-child(10) { width: 70px; text-align: center; }
    .ov-sku { display: inline-block; margin-right: 6px; padding: 2px 6px; border-radius: 4px; background: var(--es-tinto-soft); color: var(--es-tinto); font-size: 11.5px; font-weight: 600; font-variant-numeric: tabular-nums; }
    .ovx .ov-table tbody tr.table-danger td { background: var(--es-bad-bg) !important; }
    .ovx .ov-table tbody tr.table-danger td:first-child { box-shadow: inset 3px 0 0 var(--es-bad); }
    .ovx .ov-table tbody tr.sku-invalido td { background: var(--es-warn-bg) !important; }
    .ov-products-foot { padding: 8px 14px; border-top: 1px solid var(--es-line); font-size: 11.5px; color: var(--es-muted); }

    /* ---------- Pie fijo: totales + guardado ---------- */
    .ov-savebar { position: sticky; bottom: 0; z-index: 50; display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap; margin: 12px -18px 0; padding: 12px 18px; background: var(--es-surface); border-top: 1px solid var(--es-line); box-shadow: 0 -6px 18px rgba(35,26,28,.08); }
    .ov-totals { display: flex; align-items: baseline; gap: 22px; flex-wrap: wrap; }
    .ov-total span { display: block; font-size: 11.5px; color: var(--es-muted); }
    .ov-total strong { font-size: 20px; font-weight: 700; font-variant-numeric: tabular-nums; color: var(--es-ink); }
    .ov-total--money strong { color: var(--es-ok); }
    .ov-savebar__actions { display: flex; gap: 8px; flex-wrap: wrap; }

    /* ---------- Cargando ---------- */
    #loadingSpinner { display: none; position: fixed; inset: 0; z-index: 2000; background: rgba(246,244,244,.82); align-items: center; justify-content: center; flex-direction: column; gap: 10px; }
    body[data-theme="dark"] #loadingSpinner { background: rgba(22,24,28,.85); }
    #loadingSpinner.is-active { display: flex; }
    #loadingSpinner p { margin: 0; font-family: var(--es-font); font-weight: 600; color: var(--es-ink); }
    .ov-spinner { width: 38px; height: 38px; border: 3px solid var(--es-tinto-line); border-top-color: var(--es-tinto); border-radius: 50%; animation: ov-spin .8s linear infinite; }
    @@keyframes ov-spin { to { transform: rotate(360deg); } }
    @@media (prefers-reduced-motion: reduce) { .ov-spinner { animation-duration: 2s; } }

    /* ---------- Modales ---------- */
    .ovx-modal { border: 0; border-radius: 12px; overflow: hidden; background: var(--es-surface); color: var(--es-ink); box-shadow: 0 18px 50px rgba(35,26,28,.25); }
    .ovx-modal .modal-header { padding: 13px 18px; background: var(--es-tinto-deep); color: #fff; border-bottom: 0; }
    .ovx-modal .modal-title { display: flex; align-items: center; gap: 8px; font-size: 15px; font-weight: 600; color: #fff; }
    .ovx-modal .btn-close { filter: invert(1) grayscale(1) brightness(2); opacity: .9; }
    .ovx-modal .modal-body { background: var(--es-surface); color: var(--es-ink); font-size: 13px; }
    .ovx-modal .modal-footer { background: var(--es-head); border-top: 1px solid var(--es-line); }
    .ovx-modal .table { --bs-table-bg: transparent; --bs-table-color: var(--es-ink); color: var(--es-ink); font-size: 12.5px; margin: 0; }
    .ovx-modal .table thead th { position: sticky; top: 0; z-index: 2; background: var(--es-head); color: var(--es-muted); font-size: 11.5px; font-weight: 600; border-bottom: 1px solid var(--es-line); white-space: nowrap; }
    .ovx-modal .table td { border-color: var(--es-row-line); vertical-align: middle; }
    .ovx-modal .table-hover tbody tr:hover td { background: var(--es-hover); }

    /* Buscar cliente */
    .cl-search { display: grid; grid-template-columns: minmax(0, 1fr) 150px auto auto; gap: 8px; padding: 12px 14px; border-bottom: 1px solid var(--es-line); }
    .cliente-lookup-table-wrap { max-height: 60vh; overflow: auto; }
    #clienteTable { table-layout: fixed; }
    #clienteTable td { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    #clienteTable .cl-col-codigo { width: 130px; }
    #clienteTable .cl-col-vendedor { width: 240px; }
    #clienteTable .cl-col-accion { width: 130px; }

    /* Compromiso de pago (cobranza) */
    #compromisoPagoModal .modal-dialog { width: min(1500px, 97vw); max-width: min(1500px, 97vw); }
    #compromisoPagoModal .modal-body { background: var(--es-paper); }
    #compromisoPagoModal .cob-alerta { display: grid; grid-template-columns: 1fr auto; gap: 12px; align-items: center; padding: 10px 12px; margin-bottom: 10px; border: 1px solid var(--es-bad); border-radius: 8px; background: var(--es-bad-bg); color: var(--es-bad); font-size: 12.5px; }
    #compromisoPagoModal .cob-alerta strong { font-size: 18px; font-variant-numeric: tabular-nums; }
    #compromisoPagoModal .cob-resumen-compromisos { display: none; margin-bottom: 10px; padding: 9px 12px; border: 1px solid var(--es-warn); border-left-width: 4px; border-radius: 8px; background: var(--es-warn-bg); color: var(--es-warn); font-size: 12.5px; line-height: 1.4; }
    #compromisoPagoModal .cob-facturas-wrap { max-height: 50vh; overflow: auto; border: 1px solid var(--es-line); border-radius: 8px; background: var(--es-surface); }
    #compromisoPagoModal .cob-facturas { width: 100%; min-width: 1650px; border-collapse: separate; border-spacing: 0; font-size: 12px; }
    #compromisoPagoModal .cob-facturas th { position: sticky; top: 0; z-index: 2; padding: 8px; background: var(--es-head); border-bottom: 1px solid var(--es-line); color: var(--es-muted); font-weight: 600; white-space: nowrap; }
    #compromisoPagoModal .cob-facturas td { padding: 7px 8px; border-bottom: 1px solid var(--es-row-line); color: var(--es-ink); vertical-align: top; white-space: nowrap; }
    #compromisoPagoModal .cob-facturas .num { text-align: right; font-variant-numeric: tabular-nums; }
    #compromisoPagoModal .cob-col-fecha { width: 160px; }
    #compromisoPagoModal .cob-col-motivo { width: 460px; white-space: normal !important; }
    #compromisoPagoModal .cob-col-evidencia { width: 270px; }
    #compromisoPagoModal .cob-pago-tools { display: grid; grid-template-columns: 140px 1fr; gap: 6px; margin-bottom: 6px; }
    #compromisoPagoModal .cob-monto-wrap { display: grid; grid-template-columns: 16px 1fr; align-items: center; gap: 4px; }
    #compromisoPagoModal .cob-tipo-pago, #compromisoPagoModal .cob-monto-pago, #compromisoPagoModal .cob-fecha-compromiso, #compromisoPagoModal .cob-evidencia-compromiso { height: 32px; min-height: 32px; font-size: 12px; }
    #compromisoPagoModal .cob-motivo-compromiso { min-height: 62px; font-size: 12px; }
    #compromisoPagoModal .cob-ayuda-pago { display: block; margin-top: 4px; font-size: 11px; color: var(--es-muted); white-space: normal; }
    #compromisoPagoModal .cob-row-error td { background: var(--es-bad-bg); }
    #compromisoPagoModal .cob-row-ok td { background: var(--es-ok-bg); }
    #compromisoPagoModal .cob-row-existente td { background: var(--es-warn-bg); }
    #compromisoPagoModal .cob-compromiso-existente { white-space: normal; padding: 8px; border: 1px solid var(--es-warn); border-left-width: 4px; border-radius: 6px; background: var(--es-surface); font-size: 11.5px; line-height: 1.4; }
    #compromisoPagoModal .cob-existente-titulo { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 4px; font-weight: 600; color: var(--es-warn); }
    #compromisoPagoModal .cob-existente-revision { margin-top: 6px; padding-top: 6px; border-top: 1px dashed var(--es-warn); color: var(--es-bad); font-weight: 600; }
    #compromisoPagoModal .cob-badge-existente { display: inline-flex; padding: 2px 7px; border-radius: 999px; background: var(--es-warn); color: #fff; font-size: 10.5px; font-weight: 600; }
    #compromisoPagoModal .cob-no-nueva-evidencia { display: block; white-space: normal; padding: 7px; border: 1px dashed var(--es-warn); border-radius: 6px; color: var(--es-warn); font-size: 11.5px; }
    #compromisoPagoModal .cob-error { display: none; margin-top: 8px; padding: 8px 10px; border: 1px solid var(--es-bad); border-radius: 8px; background: var(--es-bad-bg); color: var(--es-bad); font-size: 12.5px; font-weight: 600; }

    /* ---------- Autocompletar (jQuery UI) ---------- */
    .ui-autocomplete { max-height: 320px; overflow-y: auto; overflow-x: hidden; z-index: 3000 !important; padding: 4px !important; border: 1px solid var(--es-line-strong) !important; border-radius: 8px; background: var(--es-surface) !important; box-shadow: 0 10px 28px rgba(0,0,0,.15); }
    .ui-menu .ui-menu-item-wrapper { padding: 7px 10px !important; border: 0 !important; border-radius: 6px; font-size: 12.5px; color: var(--es-ink); }
    .ui-menu .ui-menu-item-wrapper.ui-state-active { background: var(--es-tinto-soft) !important; color: var(--es-ink) !important; margin: 0 !important; }

    /* ---------- Avisos ---------- */
    #appToasts .toast { font-family: var(--es-font); border-radius: 10px; box-shadow: 0 10px 28px rgba(0,0,0,.2); }
    #appToasts .toast-body { white-space: pre-line; font-size: 12.5px; }

    /* ---------- Responsive ---------- */
    @@media (max-width: 1300px) {
        .ov-grid { grid-template-columns: 1fr; }
    }
    @@media (max-width: 900px) {
        .ov-credit { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .ov-col-2, .ov-col-3 { grid-column: span 3; }
        .cl-search { grid-template-columns: 1fr 1fr; }
    }
    @@media (max-width: 640px) {
        .ovx { padding: 10px 10px 0; }
        .ov-col-2, .ov-col-3 { grid-column: span 6; }
        .ov-savebar { margin: 12px -10px 0; padding: 10px; }
        .ov-savebar__actions, .ov-savebar__actions .btn { width: 100%; }
        .ovx .ov-excel input[type="file"] { width: 100%; }
    }
</style>

<div class="ovx" id="ovApp">

    <!-- Encabezado -->
    <header class="ov-header">
        <div class="ov-header__title">
            <span class="ov-header__icon"><i class="bi bi-bag-check"></i></span>
            <div>
                <h1>Nueva orden de venta</h1>
                <p>Cliente, entrega y productos. Las validaciones de presupuesto, crédito y transporte se aplican al guardar.</p>
            </div>
        </div>
        <div class="ov-header__actions" role="toolbar" aria-label="Acciones principales">
            <button type="submit" form="formOV" name="accion" value="salir" class="btn btn-reflejo" title="Guardar y salir">
                <i class="bi bi-check2-circle"></i> Guardar y salir
            </button>
            <button type="submit" form="formOV" name="accion" value="nuevo" class="btn btn-reflejo" title="Guardar y capturar otra orden">
                <i class="bi bi-plus-circle"></i> Guardar y nueva
            </button>
            <a href="@Url.Content("~/Home/inicio")" class="btn" title="Salir sin guardar">
                <i class="bi bi-x-lg"></i> Cancelar
            </a>
        </div>
    </header>

    <form id="formOV" asp-action="GuardarPedido" method="post" enctype="multipart/form-data">
        <div class="ov-grid">

            <!-- 1. Cliente -->
            <section class="ov-card">
                <div class="ov-card__head">
                    <h2 class="ov-card__title"><span class="ov-step" id="ovStepCliente">1</span> Cliente</h2>
                    <button type="button" class="btn btn-sm" data-bs-toggle="modal" data-bs-target="#modalPropiedades">
                        <i class="bi bi-journal-text"></i> Documentación del cliente
                    </button>
                </div>
                <div class="ov-card__body">
                    <div class="ov-fields">
                        <div class="ov-col-6">
                            <label class="form-label" for="clienteInput">Cliente</label>
                            <div class="input-group">
                                <input id="clienteInput" class="form-control" placeholder="Escribe nombre o código del cliente" autocomplete="off" />
                                <button type="button" class="btn" id="btnBuscarCliente">
                                    <i class="bi bi-search"></i> Buscar
                                </button>
                            </div>
                            <input type="hidden" id="clienteHidden" name="Cliente" />
                            <input type="hidden" id="EsCanalCedis" name="EsCanalCedis" value="false" />
                            <input type="hidden" id="ClienteAplicaPresupuesto" name="ClienteAplicaPresupuesto" value="1" />
                            <input type="hidden" id="productoCodigo" name="ProductoCodigo" />
                            <div class="ov-hint"><i class="bi bi-info-circle"></i> Escribe al menos 2 letras y elige de la lista, o usa Buscar para ver el catálogo.</div>
                        </div>

                        <div class="ov-col-2">
                            <label class="form-label" for="Vendedor">Vendedor</label>
                            <input asp-for="Vendedor" id="Vendedor" class="form-control" readonly />
                            <input type="hidden" id="VendedorId" name="VendedorId" />
                        </div>

                        <div class="ov-col-2">
                            <label class="form-label" for="rutaSelect">Dirección de entrega</label>
                            <select id="rutaSelect" name="Ruta" class="form-select">
                                <option value="">Selecciona dirección</option>
                            </select>
                        </div>

                        <div class="ov-col-2">
                            <label class="form-label" for="Presentacion">Presentación</label>
                            <select asp-for="Presentacion" id="Presentacion" class="form-select">
                                <option value="">Selecciona presentación</option>
                                <option value="COMBO">COMBO</option>
                                <option value="FRESCO">FRESCO</option>
                                <option value="CONGELADO">CONGELADO</option>
                                <option value="CAJA GENERICA">CAJA GENERICA</option>
                                <option value="FRESCO-COMBO">FRESCO-COMBO</option>
                                <option value="NINGUNO">NINGUNO</option>
                            </select>
                        </div>

                        <div class="ov-col-6">
                            <div class="ov-muestra">
                                <input type="checkbox" class="form-check-input" id="chkEsMuestra" name="esMuestra" value="true">
                                <label class="form-check-label" for="chkEsMuestra">Orden de muestra (no requiere presupuesto, disponible ni compromiso de pago)</label>
                            </div>
                        </div>

                        <!-- Modo presupuesto oculto: se conserva para la lógica existente -->
                        <div class="d-none">
                            <input type="radio" class="btn-check" name="presModo" id="modoVend">
                            <label class="btn" for="modoVend">Vend.</label>
                            <input type="radio" class="btn-check" name="presModo" id="modoCli">
                            <label class="btn" for="modoCli">Cli.</label>
                        </div>
                    </div>

                    <!-- Crédito del cliente -->
                    <div class="ov-credit">
                        <div class="ov-metric" id="metricSaldo">
                            <label class="form-label" for="saldoInput"><i class="bi bi-wallet2"></i> Saldo</label>
                            <input id="saldoInput" asp-for="Saldo" class="form-control" readonly />
                        </div>
                        <div class="ov-metric" id="metricVencido">
                            <label class="form-label" for="saldoVencidoInput"><i class="bi bi-exclamation-triangle"></i> Saldo vencido</label>
                            <input id="saldoVencidoInput" asp-for="SaldoVencido" class="form-control" readonly />
                            <div class="ov-metric__note">Al guardar se pedirá compromiso de pago.</div>
                        </div>
                        <div class="ov-metric" id="metricOtros">
                            <label class="form-label" for="otrosPedidosInput"><i class="bi bi-box-arrow-up-right"></i> Otros pedidos</label>
                            <input id="otrosPedidosInput" asp-for="OtrosPedidos" class="form-control" readonly />
                        </div>
                        <div class="ov-metric" id="metricCredito">
                            <label class="form-label" for="creditoInput"><i class="bi bi-shield-check"></i> Crédito disponible</label>
                            <input id="creditoInput" asp-for="Credito" class="form-control" readonly />
                        </div>
                    </div>
                </div>
            </section>

            <!-- 2. Entrega -->
            <section class="ov-card">
                <div class="ov-card__head">
                    <h2 class="ov-card__title"><span class="ov-step" id="ovStepEntrega">2</span> Entrega</h2>
                </div>
                <div class="ov-card__body">
                    <div class="ov-fields">
                        <div class="ov-col-3">
                            <label class="form-label">Consecutivo</label>
                            <input asp-for="Consecutivo" class="form-control" readonly />
                        </div>

                        <div class="ov-col-3">
                            <label class="form-label" for="Serie">Serie</label>
                            <select asp-for="Serie" asp-items="Model.Series" id="Serie" class="form-select">
                                <option value="">Selecciona serie</option>
                            </select>
                            @if (Model.Series == null || !Model.Series.Any())
                            {
                                <div class="ov-alert-inline">No tienes series asignadas. Pide a Sistemas que te liguen una serie en Configuración de usuarios.</div>
                            }
                        </div>

                        <div class="ov-col-6">
                            <label class="form-label" for="FechaEntrega">Fecha para embarcar</label>
                            <input asp-for="FechaEntrega" id="FechaEntrega" type="date" class="form-control" />
                            <div class="help">No se permiten fechas pasadas. Al cambiar de mes se vuelve a cargar el presupuesto.</div>
                        </div>

                        <!-- Tipo de entrega / logística: solo para serie MATRIZ y órdenes que no son muestra -->
                        <div class="ov-col-6" id="bloqueTipoEntregaLogistica" style="display:none;">
                            <label class="form-label" for="TipoEntregaLogistica"><i class="bi bi-truck-flatbed"></i> Tipo de entrega</label>
                            <select id="TipoEntregaLogistica" name="TipoEntregaLogistica" class="form-select">
                                <option value="TRANSPORTE" selected>Entrega con transporte / pedido foráneo</option>
                                <option value="CLIENTE_RECOGE">Cliente recoge el pedido</option>
                                <option value="RECOGE_SITIO">Pedido local / recoge en sitio</option>
                            </select>
                            <div class="help" id="tipoEntregaLogisticaHelp">Si el pedido es local o lo recoge el cliente, no se pide folio de transporte.</div>
                        </div>

                        <div class="ov-col-6" id="bloqueFolioLogistica" style="display:none;">
                            <label class="form-label" for="LogisticaFolioId"><i class="bi bi-truck"></i> Folio de transporte / logística</label>
                            <select id="LogisticaFolioId" name="LogisticaFolioId" class="form-select">
                                <option value="">Selecciona primero fecha y cliente…</option>
                            </select>
                            <div class="help" id="logisticaFolioHelp">Para pedidos con transporte, selecciona el folio disponible para esta fecha.</div>
                            <div id="logisticaCapacidadResumen" class="ov-logistica-capacidad" aria-live="polite"></div>
                        </div>

                        <div class="ov-col-6">
                            <label class="form-label" for="Observacion">Observación</label>
                            <textarea asp-for="Observacion" id="Observacion" class="form-control" rows="3"
                                      placeholder="Notas de entrega, horario, referencia, contacto…"></textarea>
                        </div>
                    </div>
                </div>
            </section>
        </div>

        <!-- 3. Productos -->
        <section class="ov-card">
            <div class="ov-card__head">
                <h2 class="ov-card__title"><span class="ov-step" id="ovStepProductos">3</span> Productos</h2>
                <span class="es-muted" style="font-size:12px;">Producto, kilos o cajas (se calculan entre sí) y precio</span>
            </div>

            <div class="ov-products-tools">
                <div class="ov-products-tools__group">
                    <button type="button" class="btn btn-reflejo" onclick="agregarProducto(); return false;">
                        <i class="bi bi-plus-circle"></i> Agregar producto
                    </button>
                    <button type="button" class="btn" data-bs-toggle="modal" data-bs-target="#modalCargaMasiva">
                        <i class="bi bi-list-ul"></i> Pegar lista de SKU
                    </button>
                    <span class="ov-divider"></span>
                    <div class="ov-excel" title="Formato: SKU | Kg | Cajas | Precio, con encabezado en la primera fila">
                        <input type="file" id="archivoExcelMasivo" accept=".xlsx,.xls" class="form-control" aria-label="Archivo Excel (SKU | Kg | Cajas | Precio)" />
                        <button type="button" id="btnProcesarExcelMasivo" class="btn">
                            <i class="bi bi-file-earmark-excel"></i> Importar Excel
                        </button>
                    </div>
                </div>
                <button type="button" class="btn btn-outline-danger" onclick="eliminarTodosProductos(); return false;">
                    <i class="bi bi-trash3"></i> Limpiar productos
                </button>
            </div>

            <div class="ov-table-wrap">
                <table class="table ov-table align-middle">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Producto / SKU</th>
                            <th id="thPresupuesto" class="text-end">Presupuesto</th>
                            <th id="thDisponible" class="text-end">Disponible</th>
                            <th class="text-end">Kilos</th>
                            <th class="text-end">Precio</th>
                            <th class="text-end">Cajas</th>
                            <th class="text-end">Importe</th>
                            <th>Inventario</th>
                            <th>Quitar</th>
                        </tr>
                    </thead>
                    <tbody id="productosBody">
                        @for (int i = 0; i < productos.Count; i++)
                        {
                            <tr data-origen="manual">
                                <td>@(i + 1)</td>
                                <td>
                                    <input name="Productos[@i].ProductoNombre" class="form-control productoInput" value="@productos[i].ProductoNombre" placeholder="Buscar producto por SKU o nombre…" />
                                    <input type="hidden" name="Productos[@i].ProductoCodigo" class="productoCodigo" value="@productos[i].ProductoCodigo" />
                                </td>
                                <td><input asp-for="Productos[@i].Presupuesto" type="text" class="form-control presupuesto" readonly /></td>
                                <td><input asp-for="Productos[@i].VariacionPresupuesto" type="text" class="form-control variacionPresupuesto" readonly /></td>
                                <td><input asp-for="Productos[@i].Peso" type="number" step="0.01" class="form-control peso" /></td>
                                <td><input asp-for="Productos[@i].Precio" class="form-control precio" /></td>
                                <td><input asp-for="Productos[@i].Cajas" type="number" min="0" step="0.01" class="form-control cajas" /></td>
                                <td><input class="form-control subtotal" type="text" value="@productos[i].Importe" readonly /></td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-sm btn-inventario" data-codigo="@productos[i].ProductoCodigo" data-nombre="@productos[i].ProductoNombre">
                                        <i class="bi bi-boxes"></i> Ver
                                    </button>
                                </td>
                                <td class="text-center">
                                    <a href="#" class="ov-delete-link" onclick="eliminarProducto(this); return false;" aria-label="Quitar producto"><i class="bi bi-trash"></i></a>
                                </td>
                            </tr>
                        }

                        @if (!productos.Any())
                        {
                            <tr data-origen="manual">
                                <td>1</td>
                                <td>
                                    <input name="Productos[0].ProductoNombre" class="form-control productoInput" placeholder="Buscar producto por SKU o nombre…" />
                                    <input type="hidden" name="Productos[0].ProductoCodigo" class="productoCodigo" />
                                </td>
                                <td><input name="Productos[0].Presupuesto" class="form-control presupuesto" type="text" value="0" readonly /></td>
                                <td><input name="Productos[0].VariacionPresupuesto" class="form-control variacionPresupuesto" type="text" value="0" readonly /></td>
                                <td><input name="Productos[0].Peso" class="form-control peso" type="number" step="0.01" value="0" /></td>
                                <td><input name="Productos[0].Precio" class="form-control precio" type="number" step="0.01" value="0" /></td>
                                <td><input name="Productos[0].Cajas" type="number" min="0" step="1" class="form-control cajas" value="0" /></td>
                                <td><input class="form-control subtotal" type="text" value="0.00" readonly /></td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-sm btn-inventario" data-codigo="" data-nombre=""><i class="bi bi-boxes"></i> Ver</button>
                                </td>
                                <td class="text-center">
                                    <a href="#" class="ov-delete-link" onclick="eliminarProducto(this); return false;" aria-label="Quitar producto"><i class="bi bi-trash"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="ov-products-foot">
                Las filas en rojo exceden el disponible del presupuesto. Las líneas con 0 kilos y 0 cajas no se guardan.
            </div>
        </section>

        <!-- 4. Totales + guardado (fijo abajo) -->
        <div class="ov-savebar">
            <div class="ov-totals">
                <span class="ov-step" id="ovStepGuardar">4</span>
                <div class="ov-total"><span>Líneas con cantidad</span><strong id="totalLineas">0</strong></div>
                <div class="ov-total"><span>Total peso</span><strong><span id="totalPeso">0.00</span> kg</strong></div>
                <div class="ov-total ov-total--money"><span>Total importe</span><strong id="totalImporte">$0.00</strong></div>
            </div>
            <div class="ov-savebar__actions">
                <button type="submit" name="accion" value="salir" class="btn btn-reflejo">
                    <i class="bi bi-check2-circle"></i> Guardar y salir
                </button>
                <button type="submit" name="accion" value="nuevo" class="btn btn-reflejo">
                    <i class="bi bi-plus-circle"></i> Guardar y nueva
                </button>
                <button type="button" class="btn" onclick="window.location='@Url.Content("~/Home/inicio")'">
                    <i class="bi bi-x-lg"></i> Cancelar
                </button>
            </div>
        </div>

        <!-- Cargando -->
        <div id="loadingSpinner" role="status" aria-live="polite">
            <div class="ov-spinner"></div>
            <p>Cargando…</p>
        </div>
    </form>
</div>

<!-- DOCUMENTACIÓN DEL CLIENTE -->
<div class="modal fade" id="modalPropiedades" tabindex="-1" aria-labelledby="modalPropiedadesLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content ovx-modal">
            <div class="modal-header">
                <h5 class="modal-title" id="modalPropiedadesLabel"><i class="bi bi-journal-text"></i> Documentación del cliente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="modalPropiedadesBody">
                <p class="es-muted">Selecciona un cliente para ver su documentación.</p>
            </div>
        </div>
    </div>
</div>

<!-- PEGAR LISTA DE SKU -->
<div class="modal fade" id="modalCargaMasiva" tabindex="-1" aria-labelledby="modalCargaMasivaLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content ovx-modal">
            <div class="modal-header">
                <h5 class="modal-title" id="modalCargaMasivaLabel"><i class="bi bi-list-ul"></i> Pegar lista de SKU</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <label class="form-label" for="articulosMasivos">Un SKU por línea</label>
                <textarea id="articulosMasivos" class="form-control" rows="8" placeholder="SKU1&#10;SKU2&#10;SKU3"></textarea>
                <div class="help es-muted" style="margin-top:6px;font-size:12px;">Se omiten los SKU repetidos o sin presupuesto (cuando aplica). Después captura kilos o cajas.</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" data-bs-dismiss="modal">Cancelar</button>
                <button id="btnAgregarArticulos" type="button" class="btn btn-reflejo">
                    <span id="btnText">Agregar artículos</span>
                    <span id="btnSpinner" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- INVENTARIO -->
<div class="modal fade" id="inventarioModal" tabindex="-1" aria-labelledby="inventarioModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:720px;">
        <div class="modal-content ovx-modal">
            <div class="modal-header">
                <h5 class="modal-title" id="inventarioModalLabel"><i class="bi bi-boxes"></i> Inventario del producto</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="mb-1"><span class="es-muted">Código:</span> <strong id="modalProductoCodigo"></strong></p>
                <p class="mb-3"><span class="es-muted">Producto:</span> <strong id="modalProductoNombre"></strong></p>
                <div id="modalInventarioContenido">Cargando inventario…</div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- BUSCAR CLIENTE -->
<div class="modal fade" id="clienteLookupModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl" style="max-width:min(1100px,96vw);">
        <div class="modal-content ovx-modal">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-people"></i> Buscar cliente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-0">
                <div class="cl-search">
                    <input id="clq" class="form-control" placeholder="Nombre, código o RFC" />
                    <select id="clTam" class="form-select" aria-label="Resultados por página">
                        <option value="15" selected>15 por página</option>
                        <option value="25">25 por página</option>
                        <option value="50">50 por página</option>
                        <option value="100">100 por página</option>
                    </select>
                    <button class="btn" id="clLimpiar" type="button"><i class="bi bi-eraser"></i> Limpiar</button>
                    <button class="btn btn-primary" id="clBuscar" type="button"><i class="bi bi-search"></i> Buscar</button>
                </div>
                <div class="cliente-lookup-table-wrap">
                    <table class="table table-hover table-sm align-middle mb-0 cliente-lookup-table" id="clienteTable">
                        <colgroup>
                            <col class="cl-col-codigo" />
                            <col class="cl-col-nombre" />
                            <col class="cl-col-vendedor" />
