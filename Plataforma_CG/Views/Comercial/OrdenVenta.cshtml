<!-- Avisos -->
<div aria-live="polite" aria-atomic="true" class="position-fixed top-0 end-0 p-3" style="z-index:1080">
    <div id="appToasts"></div>
</div>


@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css">
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    @{
        var success = TempData["Success"] as string;
        var error = TempData["Error"] as string;
    }

    <script>
        /* ===========================
           AVISOS (toasts)
           El texto se inserta como texto, no como HTML.
        =========================== */
        function showToast(message, variant = 'success', delayMs = 5000) {
            const container = document.getElementById('appToasts');
            if (!container || !window.bootstrap) { console.warn(message); return; }
            const el = document.createElement('div');
            el.className = `toast text-bg-${variant} border-0`;
            el.setAttribute('role', variant === 'danger' ? 'alert' : 'status');
            el.setAttribute('aria-live', 'assertive');
            el.setAttribute('aria-atomic', 'true');
            el.dataset.bsDelay = delayMs;
            el.innerHTML = `<div class="d-flex"><div class="toast-body"></div>
                <button type="button" class="btn-close ${variant === 'warning' ? '' : 'btn-close-white'} me-2 m-auto" data-bs-dismiss="toast" aria-label="Cerrar"></button></div>`;
            el.querySelector('.toast-body').textContent = message || '';
            container.appendChild(el);
            el.addEventListener('hidden.bs.toast', () => el.remove());
            new bootstrap.Toast(el).show();
        }

        document.addEventListener('DOMContentLoaded', function () {
            const ok = @Json.Serialize(success);
            const err = @Json.Serialize(error);
            if (ok) showToast(ok, 'success', 6000);
            if (err) showToast(err, 'danger', 8000);
        });
    </script>

    <script>
        /* ===========================
           CARGA Y BLOQUEO DE UI
        =========================== */
        let isLoading = false;
        let isUiLocked = false;
        let loadToken = 0;

        function setLoading(state, message = "Cargando…", options) {
            const lockForm = !!(options && options.lockForm);
            isLoading = !!state;
            isUiLocked = !!state && lockForm;

            const $spinner = $("#loadingSpinner");
            $spinner.find("p").text(message);
            $spinner.toggleClass("is-active", !!state);

            // Solo se deshabilita el formulario si se pide explícitamente con { lockForm: true }.
            $("#formOV").find(":input").prop("disabled", !!state && lockForm);
        }

        async function runWithLoading(message, fn, options) {
            const myToken = ++loadToken;
            const showOverlay = options?.showOverlay ?? true;
            const lockForm = options?.lockForm ?? false;

            if (showOverlay) setLoading(true, message, { lockForm });
            try {
                const result = await fn(myToken);
                if (myToken === loadToken && showOverlay) setLoading(false);
                return result;
            } catch (err) {
                if (myToken === loadToken && showOverlay) setLoading(false);
                throw err;
            }
        }

        $(document).on("click", "a, button", function (e) {
            if (isUiLocked) { e.preventDefault(); e.stopPropagation(); return false; }
        });
        $(document).on("input change", ":input", function (e) {
            if (isUiLocked) { e.preventDefault(); e.stopPropagation(); return false; }
        });
    </script>

    <script>
        /* =====================================================================
           ORDEN DE VENTA · LÓGICA PRINCIPAL
           Reglas de negocio sin cambios: presupuesto solo en serie MATRIZ,
           muestras libres, vendedor restringido, crédito, logística, cobranza.
        ===================================================================== */

        function normCode(v) { return (v ?? "").toString().trim().toUpperCase(); }
        function fmt(n) { return Number(n ?? 0).toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
        function fmtDisponible(n) {
            return Math.round(Number(n ?? 0)).toLocaleString('es-MX', { minimumFractionDigits: 0, maximumFractionDigits: 0 });
        }
        const isNumber = v => v !== null && v !== undefined && v !== "" && !isNaN(Number(v));

        // Escapa texto para insertarlo en HTML o atributos (nombres con comillas ya no rompen la fila).
        function escH(v) {
            return String(v ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
        }

        /* ---------- Restricción del usuario por vendedor ---------- */
        let OV_ES_VENDEDOR_USUARIO = false;
        let OV_VENDEDOR_IDS_USUARIO = [];
        let OV_VENDEDOR_CONTEXT_READY = false;

        function ovNormalizarVendedorId(v) {
            const n = Number.parseInt(String(v ?? "").trim(), 10);
            return Number.isFinite(n) && n > 0 ? n : null;
        }

        function ovClientePermitidoPorVendedor(item) {
            if (!OV_ES_VENDEDOR_USUARIO || !OV_VENDEDOR_IDS_USUARIO.length) return true;
            const id = ovNormalizarVendedorId(item?.vendedorId ?? item?.VendedorId ?? item?.salesPersonId);
            return id != null && OV_VENDEDOR_IDS_USUARIO.includes(id);
        }

        async function ovCargarContextoVendedorUsuario() {
            try {
                const data = await $.getJSON("/Comercial/UsuarioVendedorActual");
                const idsRaw = Array.isArray(data?.vendedorIds) ? data.vendedorIds : [];
                OV_VENDEDOR_IDS_USUARIO = idsRaw.map(ovNormalizarVendedorId).filter(x => x != null);
                OV_ES_VENDEDOR_USUARIO = data?.esVendedor === true && OV_VENDEDOR_IDS_USUARIO.length > 0;
            } catch (err) {
                // El controller sigue aplicando la seguridad real.
                console.warn("No fue posible cargar el contexto de vendedor del usuario.", err);
                OV_ES_VENDEDOR_USUARIO = false;
                OV_VENDEDOR_IDS_USUARIO = [];
            } finally {
                OV_VENDEDOR_CONTEXT_READY = true;
            }
        }
        $(function () { ovCargarContextoVendedorUsuario(); });

        const API = {
            modoGet: '@Url.Action("ObtenerModoPresupuesto", "Comercial")',
            modoSet: '@Url.Action("GuardarModoPresupuesto", "Comercial")'
        };
        function antiForgeryToken() { return document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''; }
        function apiGetModoPresupuesto() { return $.getJSON(API.modoGet); }
        function apiSetModoPresupuesto(modo) {
            return $.ajax({ url: API.modoSet, method: "POST", data: { modo: modo, __RequestVerificationToken: antiForgeryToken() } });
        }

        /* ---------- Reglas de presupuesto ---------- */
        const SERIES_MATRIZ = ["PLANTA1", "TIF"];

        function pickBool(v) {
            if (typeof v === "boolean") return v;
            if (v == null) return false;
            const s = v.toString().trim().toLowerCase();
            return (s === "true" || s === "1" || s === "si" || s === "sí" || s === "yes" || s === "y");
        }
        function pickBoolDefaultTrue(v) {
            if (v === undefined || v === null || v === "") return true;
            return pickBool(v);
        }
        function esOrdenMuestra() { return $("#chkEsMuestra").is(":checked"); }
        function isCanalCedis() { return pickBool($("#EsCanalCedis").val()); }
        function esSerieMatriz() {
            const val = ($("#Serie").val() || "").toString().trim().toUpperCase();
            const txt = ($("#Serie option:selected").text() || "").toString().trim().toUpperCase();
            return SERIES_MATRIZ.includes(val) || SERIES_MATRIZ.includes(txt);
        }

        // Presupuesto/disponible SOLO aplica en serie MATRIZ, cliente que lo requiere y orden que no es muestra.
        function aplicaPresupuesto() {
            if (esOrdenMuestra()) return false;
            if (!pickBoolDefaultTrue($("#ClienteAplicaPresupuesto").val())) return false;
            return esSerieMatriz();
        }

        function clienteRequierePresupuesto() {
            if (esOrdenMuestra()) return false;
            return pickBoolDefaultTrue($("#ClienteAplicaPresupuesto").val());
        }

        function limpiarPresupuestoFila($row) {
            $row.removeClass("table-danger");
            $row.find(".presupuesto").val("0.00");
            $row.find(".variacionPresupuesto").val("0.00").data("base", 0);
        }

        function toggleColumnasPresupuesto() {
            const mostrar = aplicaPresupuesto();
            const selectorCols = `.ov-table thead th:nth-child(3), .ov-table thead th:nth-child(4),
                #productosBody tr td:nth-child(3), #productosBody tr td:nth-child(4)`;
            if (mostrar) $(selectorCols).show();
            else {
                $(selectorCols).hide();
                $("#productosBody tr").each(function () { limpiarPresupuestoFila($(this)); });
            }
            actualizarTotales();
        }

        function syncNoAplicaState() {
            if (!aplicaPresupuesto()) $("#productosBody tr").each(function () { limpiarPresupuestoFila($(this)); });
            toggleColumnasPresupuesto();
        }

        $(document).on("change", "#chkEsMuestra", async function () {
            clearDisponiblesCache();
            setHeadersPresupuesto();

            if (esOrdenMuestra()) {
                syncNoAplicaState();
                showToast("Orden de muestra activada: no requiere presupuesto, disponible ni compromiso de pago.", "success", 5000);
                return;
            }
            if (!aplicaPresupuesto()) { syncNoAplicaState(); return; }

            const cardCode = $("#clienteHidden").val();
            const fecha = $("#FechaEntrega").val();
            if (!cardCode || !fecha) { toggleColumnasPresupuesto(); return; }

            if ($("#modoCli").is(":checked")) $("#modoCli").trigger("change");
            else $("#modoVend").trigger("change");
        });

        /* ---------- Dueño del presupuesto (siempre el vendedor) ---------- */
        function presupuestoMode() { return ($("#modoCli").length && $("#modoCli").is(":checked")) ? "cli" : "vend"; }

        function getOwnerForPresupuesto() {
            let vendId = ($("#VendedorId").val() || "").toString().trim();
            // Un usuario restringido nunca usa un VendedorId ajeno, aunque se manipule el campo oculto.
            if (OV_ES_VENDEDOR_USUARIO && OV_VENDEDOR_IDS_USUARIO.length) {
                const actual = ovNormalizarVendedorId(vendId);
                if (actual == null || !OV_VENDEDOR_IDS_USUARIO.includes(actual)) {
                    vendId = OV_VENDEDOR_IDS_USUARIO.length === 1 ? String(OV_VENDEDOR_IDS_USUARIO[0]) : "";
                }
            }
            return { mode: "vend", id: vendId, label: isCanalCedis() ? "CEDIS / vendedor" : "vendedor" };
        }

        function setHeadersPresupuesto() {
            if (!$("#thPresupuesto").length || !$("#thDisponible").length) return;
            if (!aplicaPresupuesto()) { toggleColumnasPresupuesto(); return; }
            const owner = getOwnerForPresupuesto();
            $("#thPresupuesto").text(`Presupuesto (${owner.label})`);
            $("#thDisponible").text(`Disponible (${owner.label})`);
            toggleColumnasPresupuesto();
        }

        async function tryGetJSON(endpoints) {
            for (const ep of endpoints) {
                try { return await $.getJSON(ep.url, ep.data); }
                catch (err) {
                    const st = err?.status;
                    if (st && st !== 404) console.warn("tryGetJSON falló:", ep.url, st);
                }
            }
            return null;
        }

        async function obtenerPresupuestoProducto(owner, cardCodeFallback, productoCodigo, mes, anio) {
            const serie = ($("#Serie").val() || "").toString().trim();
            const vendedorId = (owner?.id || $("#VendedorId").val() || "").toString().trim();
            if (!vendedorId) return null;
            return await tryGetJSON([{
                url: "/Comercial/ObtenerPresupuestoProductoVendedor",
                data: { vendedorId, cardCode: cardCodeFallback, productoCodigo, mes, anio, serie }
            }]);
        }

        async function obtenerDisponiblesLista(owner, cardCodeFallback, fechaEntrega) {
            const serie = ($("#Serie").val() || "").toString().trim();
            const vendedorId = (owner?.id || $("#VendedorId").val() || "").toString().trim();
            if (!vendedorId || !fechaEntrega) return [];
            const res = await tryGetJSON([{
                url: "/Comercial/ObtenerProductosConPresupuestoDisponibleVendedor",
                data: { vendedorId, cardCode: cardCodeFallback, fechaEntrega, serie }
            }]);
            return res || [];
        }

        /* ---------- Crédito ---------- */
        function pintarTotales(data) {
            const pick = (o, k) => (o && o[k] != null && isNumber(o[k])) ? Number(o[k]) : 0;
            const saldo = pick(data, 'saldo') || pick(data, 'Saldo') || pick(data, 'balance');
            const saldoVencido = pick(data, 'saldoVencido') || pick(data, 'SaldoVencido') || pick(data, 'overdue');
            const otrosPedidos = pick(data, 'sumpedidos') || pick(data, 'SumPedidos') || pick(data, 'otrosPedidos');
            const credito = pick(data, 'credito') || pick(data, 'Credito') || pick(data, 'credit');

            $('#saldoInput').val(fmt(saldo));
            $('#saldoVencidoInput').val(fmt(saldoVencido));
            $('#otrosPedidosInput').val(fmt(otrosPedidos));
            $('#creditoInput').val(fmt(credito));

            // Señal visual: el saldo vencido dispara el compromiso de pago al guardar.
            $('#metricVencido').toggleClass('is-alert', saldoVencido > 0.01 && !esOrdenMuestra());
        }

        function existeSKU(codigo) {
            const objetivo = normCode(codigo);
            let found = false;
            $("#productosBody .productoCodigo").each(function () {
                if (normCode($(this).val()) === objetivo) { found = true; return false; }
            });
            return found;
        }
        function existeSKUEnOtraFila(codigo, $rowActual) {
            const objetivo = normCode(codigo);
            let found = false;
            $("#productosBody tr").each(function () {
                if (this === $rowActual[0]) return;
                const code = normCode($(this).find(".productoCodigo").val());
                if (code && code === objetivo) { found = true; return false; }
            });
            return found;
        }

        // Para guardar, Cajas y Peso deben ser ambos mayores a cero.
        function contarProductosValidos() {
            let n = 0;
            $("#productosBody tr").each(function () {
                const codigo = ($(this).find(".productoCodigo").val() || "").trim();
                const peso = parseFloat($(this).find(".peso").val()) || 0;
                const cajas = parseFloat($(this).find(".cajas").val()) || 0;
                if (codigo && peso > 0 && cajas > 0) n++;
            });
            return n;
        }

        /* ---------- Cache de disponibles (incluye vendedor y serie) ---------- */
        const dispCache = {};
        function dispKey(owner, cardCode, fecha, serie) {
            const vendedorId = (owner?.id || "").toString().trim().toUpperCase();
            return `${vendedorId}|${(cardCode || "").toUpperCase()}|${fecha || ""}|${(serie || "").toUpperCase()}`;
        }
        async function getDisponiblesMap(owner, cardCodeFallback, fechaEntrega) {
            const serie = ($("#Serie").val() || "").toString().trim().toUpperCase();
            const cardCode = (cardCodeFallback || "").toString().trim().toUpperCase();
            const key = dispKey(owner, cardCode, fechaEntrega, serie);
            if (dispCache[key]) return dispCache[key];

            const lista = await obtenerDisponiblesLista(owner, cardCode, fechaEntrega).catch(() => []);
            const map = {};
            (lista || []).forEach(p => {
                const code = (p.productoCodigo || p.itemCode || p.codigo || p.ProductoCodigo || p.ItemCode || "").toString().trim().toUpperCase();
                if (code) map[code] = p;
            });
            dispCache[key] = map;
            return map;
        }
        function clearDisponiblesCache() { for (const k in dispCache) delete dispCache[k]; }

        async function setDisponibleEnFila($row, fechaEntrega) {
            if (!aplicaPresupuesto()) { limpiarPresupuestoFila($row); return; }
            const prodCode = ($row.find(".productoCodigo").val() || "").toUpperCase();
            const $varInput = $row.find(".variacionPresupuesto");
            if (!prodCode) { $varInput.val("0.00").data("base", 0); return; }

            const owner = getOwnerForPresupuesto();
            const map = await getDisponiblesMap(owner, $("#clienteHidden").val(), fechaEntrega);
            const val = parseFloat(map[prodCode]?.presupuestoDisponible ?? 0);
            $varInput.val(fmtDisponible(val)).data("base", val);
            recalcularDisponibleFila($row);
        }

        function presupuestoAsignadoDe(pres) {
            if (!pres) return 0;
            if (pres.enPresupuesto === false || pres.tienePresupuesto === false) return 0;
            const v = (pres.presupuestoAsignado != null) ? parseFloat(pres.presupuestoAsignado) : 0;
            return isFinite(v) ? v : 0;
        }

        function resetProductoRow($row) {
            $row.find(".productoInput").val("");
            $row.find(".productoCodigo").val("");
            limpiarPresupuestoFila($row);
            $row.find(".peso").val("0.00");
            $row.find(".precio").val("0.00");
            $row.find(".cajas").val("0");
            $row.find(".subtotal").val("0.00");
            $row.data("kilosCaja", 1);
            $row.find(".btn-inventario").attr("data-codigo", "").attr("data-nombre", "");
            actualizarTotales();
        }

        /* ---------- Recalcula presupuesto y disponible de todas las filas ---------- */
        async function recalcularPresupuestoTodasLasFilas(myToken, cardCode, fecha) {
            const owner = getOwnerForPresupuesto();
            const [anioStr, mesStr] = fecha.split("-");
            const anio = parseInt(anioStr, 10);
            const mes = parseInt(mesStr, 10);

            const llamadas = [];
            $("#productosBody tr").each(function () {
                const $row = $(this);
                const productoCodigo = normCode($row.find(".productoCodigo").val());
                if (!productoCodigo) return;
                llamadas.push(
                    obtenerPresupuestoProducto(owner, cardCode, productoCodigo, mes, anio)
                        .then(pres => { if (myToken === loadToken) $row.find(".presupuesto").val(fmt(presupuestoAsignadoDe(pres))); })
                        .catch(() => { if (myToken === loadToken) $row.find(".presupuesto").val("0.00"); })
                );
            });
            await Promise.all(llamadas);
            if (myToken !== loadToken) return;

            const map = await getDisponiblesMap(owner, cardCode, fecha);
            if (myToken !== loadToken) return;

            $("#productosBody tr").each(function () {
                const $row = $(this);
                const code = normCode($row.find(".productoCodigo").val());
                if (!code) return;
                const val = parseFloat(map[code]?.presupuestoDisponible ?? 0);
                $row.find(".variacionPresupuesto").val(fmtDisponible(val)).data("base", val);
                // Disponible visual = base del servidor − kg de esta nueva OV.
                recalcularDisponibleFila($row);
            });
        }

        $(document).ready(function () {
            (async () => {
                if ($("#modoVend").length && $("#modoCli").length) {
                    try {
                        const r = await apiGetModoPresupuesto();
                        const m = (r?.modo || "VENDEDOR").toString().toUpperCase();
                        if (m === "CLIENTE") $("#modoCli").prop("checked", true);
                        else $("#modoVend").prop("checked", true);
                    } catch (_) { $("#modoVend").prop("checked", true); }
                }
                setHeadersPresupuesto();
                if (!aplicaPresupuesto()) { syncNoAplicaState(); return; }

                const cardCode = $("#clienteHidden").val();
                const fecha = $("#FechaEntrega").val();
                if (cardCode && fecha) {
                    if ($("#modoCli").is(":checked")) $("#modoCli").trigger("change");
                    else $("#modoVend").trigger("change");
                }
            })();

            setHeadersPresupuesto();

            $("#modoVend, #modoCli").on("change", async function () {
                const modoGuardar = ($("#modoCli").is(":checked")) ? "CLIENTE" : "VENDEDOR";
                apiSetModoPresupuesto(modoGuardar).catch(() => {
                    showToast("No se pudo guardar el modo (se aplicará solo en esta sesión).", "warning", 6000);
                });
                setHeadersPresupuesto();
                if (!aplicaPresupuesto()) { syncNoAplicaState(); return; }

                const cardCode = $("#clienteHidden").val();
                const fecha = $("#FechaEntrega").val();
                if (!cardCode || !fecha) return;

                await runWithLoading("Actualizando presupuesto y disponible…", async (myToken) => {
                    clearDisponiblesCache();
                    await recalcularPresupuestoTodasLasFilas(myToken, cardCode, fecha);
                });
            });
        });

        /* ---------- Fecha de entrega ---------- */
        const hoy = new Date();
        const fechaMinima = `${hoy.getFullYear()}-${String(hoy.getMonth() + 1).padStart(2, '0')}-${String(hoy.getDate()).padStart(2, '0')}`;
        $("#FechaEntrega").attr("min", fechaMinima);

        function ensureFechaEntrega() {
            const $f = $("#FechaEntrega");
            let v = $f.val();
            if (!v) { v = fechaMinima; $f.val(v); }
            return v;
        }

        /* ---------- Serie ---------- */
        $("#Serie").on("change", async function () {
            setHeadersPresupuesto();
            clearDisponiblesCache();
            if (!aplicaPresupuesto()) { syncNoAplicaState(); return; }

            const cardCode = $("#clienteHidden").val();
            const fecha = $("#FechaEntrega").val();
            if (!cardCode || !fecha) return;

            await runWithLoading("Actualizando por cambio de serie…", async (myToken) => {
                await recalcularPresupuestoTodasLasFilas(myToken, cardCode, fecha);
            });
        });

        async function cargarComplementoClienteSAP(cardCode) {
            if (!cardCode) return;
            try {
                const data = await $.getJSON('/Comercial/ObtenerComplementoCliente', { cardCode });
                if (!data) return;
                pintarTotales({ saldo: data.saldo ?? 0, saldoVencido: data.saldoVencido ?? 0, sumpedidos: data.sumpedidos ?? 0, credito: data.credito ?? 0 });
            } catch (e) {
                console.warn("Error cargando complemento SAP:", e);
            }
        }

        function recalcularDisponibleFila($row) {
            if (!aplicaPresupuesto()) { $row.removeClass("table-danger"); return; }
            const pres = parseFloat(($row.find(".presupuesto").val() || "0").replace(/,/g, "")) || 0;
            if (pres <= 0) { $row.removeClass("table-danger"); return; }

            const kg = parseFloat($row.find(".peso").val()) || 0;
            const $disp = $row.find(".variacionPresupuesto");
            const rawBase = $disp.data("base");
            if (rawBase === undefined || rawBase === null || rawBase === "") return;

            let base = parseFloat(rawBase);
            if (!isFinite(base)) base = 0;
            const nuevo = base - kg;
            $disp.val(fmtDisponible(nuevo));
            $row.toggleClass("table-danger", nuevo < 0);
        }

        /* ---------- Selección de cliente (común a autocompletar y catálogo) ---------- */
        function rellenarRutas(rutaData) {
            const $ruta = $("#rutaSelect");
            $ruta.empty().append('<option value="">Selecciona dirección</option>');
            (rutaData || []).forEach(r => $ruta.append(`<option value="${escH(r.value)}">${escH(r.text)}</option>`));
        }

        async function aplicarClienteSeleccionado(cli) {
            const cardCode = cli.cardCode;
            const cardName = (cli.cardName || "").toUpperCase();

            if (!ovClientePermitidoPorVendedor(cli)) {
                $("#clienteInput").val("");
                $("#clienteHidden").val("");
                $("#Vendedor").val("");
                $("#VendedorId").val("");
                showToast("Ese cliente no pertenece al vendedor asignado a tu usuario.", "danger", 7000);
                return;
            }

            $("#EsCanalCedis").val(pickBool(cli.esCanalCedis) ? "true" : "false");
            $("#ClienteAplicaPresupuesto").val(pickBoolDefaultTrue(cli.aplicaPresupuesto) ? "1" : "0");

            $("#clienteInput").val(`${cardName} (${cardCode})`);
            $("#clienteHidden").val(cardCode).trigger("change");
            clearDisponiblesCache();
            $("#Vendedor").val(cli.vendedorNombre || "No asignado");
            $("#VendedorId").val(cli.vendedorId || "");
            if (window.cargarFoliosLogisticaDisponibles) window.cargarFoliosLogisticaDisponibles();

            ensureFechaEntrega();
            setHeadersPresupuesto();
            if (!aplicaPresupuesto()) syncNoAplicaState();

            pintarTotales({ saldo: 0, saldoVencido: 0, sumpedidos: 0, credito: 0 });
            setTimeout(() => cargarComplementoClienteSAP(cardCode), 0);
            $("#modalPropiedadesBody").html('<p class="es-muted">Abriendo esta ventana se consulta la documentación del cliente.</p>');

            await runWithLoading(`Cargando datos del cliente ${cardName || cardCode}…`, async (myToken) => {
                let rutaData = [];
                try {
                    const r = await $.getJSON('/Comercial/ObtenerDireccionesCliente', { cardCode });
                    rutaData = Array.isArray(r) ? r : (r?.items || r?.Data || []);
                } catch (_) { rutaData = []; }
                if (myToken !== loadToken) return;
                rellenarRutas(rutaData);
                setHeadersPresupuesto();
                await cargarProductos(myToken);
            });
        }

        /* ---------- Autocompletar cliente ---------- */
        $(function () {
            $("#clienteInput").autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: '/Comercial/BuscarClientesMixto',
                        data: { term: (request.term || "").toUpperCase() },
                        success: function (data) {
                            let items = Array.isArray(data) ? data : (data.items || []);
                            if (OV_ES_VENDEDOR_USUARIO) items = items.filter(ovClientePermitidoPorVendedor);
                            response(items);
                        },
                        error: function () { response([]); }
                    });
                },
                minLength: 2,
                select: function (event, ui) {
                    event.preventDefault();
                    const it = ui.item;
                    aplicarClienteSeleccionado({
                        cardCode: it.cardCode || it.value,
                        cardName: it.cardName || (it.label?.split(' (')[0] || ''),
                        vendedorNombre: it.vendedorNombre,
                        vendedorId: it.vendedorId,
                        esCanalCedis: it.esCanalCedis ?? it.EsCanalCedis ?? it.canalCedis ?? it.CanalCedis ?? it.isCanalCedis ?? it.IsCanalCedis,
                        aplicaPresupuesto: it.aplicaPresupuesto ?? it.AplicaPresupuesto ?? it.clienteAplicaPresupuesto ?? it.ClienteAplicaPresupuesto,
                        VendedorId: it.VendedorId,
                        salesPersonId: it.salesPersonId
                    });
                    return false;
                }
            });

            $("#clienteInput").on("input", function () {
                const s = this.selectionStart, e = this.selectionEnd;
                this.value = this.value.toUpperCase();
                this.setSelectionRange(s, e);
            });
        });

        function buildSkuNombre(codigoUpper, texto) {
            const sku = (codigoUpper || "").toString().trim().toUpperCase();
            const s = (texto || "").toString().trim().toUpperCase();
            if (!sku) return { nombre: "", texto: "" };
            if (!s) return { nombre: "", texto: sku };
            const pref = `${sku} (`;
            if (s.startsWith(pref) && s.endsWith(")")) {
                const nombre = s.substring(pref.length, s.length - 1).trim();
                return { nombre, texto: nombre ? `${sku} - ${nombre}` : sku };
            }
            const nombre2 = s.replace(new RegExp(`\\s*\\(\\s*${sku.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}\\s*\\)\\s*$`, "i"), "").trim();
            const nombre = (nombre2 === sku) ? "" : nombre2;
            return { nombre, texto: nombre ? `${sku} - ${nombre}` : sku };
        }

        function aplicarPrecioYKilosCaja($row, cardCode, codigoUpper, despues) {
            $.getJSON('/Comercial/ObtenerPrecioArticuloCliente', { cardCode, itemCode: codigoUpper }, function (data) {
                const precio = parseFloat(data?.precio || 0);
                const kilosCaja = parseFloat(data?.kilosCaja || 0);
                $row.find(".precio").val(precio.toFixed(2));
                $row.data("kilosCaja", kilosCaja > 0 ? kilosCaja : 1);
                // Captura manual: el vendedor indica kilos o cajas.
                $row.find(".peso").val("0.00");
                $row.find(".cajas").val("0");
                $row.find(".subtotal").val("0.00");
                actualizarTotales();
                if (despues) despues();
            }).fail(function () {
                $row.find(".precio").val("0.00");
                $row.data("kilosCaja", 1);
                $row.find(".peso").val("0.00");
                $row.find(".cajas").val("0");
                $row.find(".subtotal").val("0.00");
                actualizarTotales();
                if (despues) despues();
            });
        }

        /* ---------- Autocompletar producto (bloquea SKU sin presupuesto cuando aplica) ---------- */
        function initProductoAutocomplete(element) {
            $(element).autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: '/Comercial/BuscarProductosAutocomplete',
                        data: { term: request.term },
                        success: function (data) {
                            response($.map(data, item => ({ label: (item.label || "").toUpperCase(), value: item.value })));
                        },
                        error: function () { response([]); }
                    });
                },
                minLength: 2,
                select: function (event, ui) {
                    event.preventDefault();
                    const $row = $(element).closest("tr");
                    const codigoOriginal = ui.item.value || "";
                    const codigoUpper = normCode(ui.item.value);
                    const label = (ui.item.label || "").toString().toUpperCase();

                    if (existeSKUEnOtraFila(codigoOriginal, $row)) {
                        alert(`El SKU ${codigoUpper} ya está agregado en otra fila.`);
                        $(element).val("");
                        $row.find(".productoCodigo").val("");
                        return false;
                    }

                    const parsed = buildSkuNombre(codigoUpper, label);
                    const nombreLimpio = parsed.nombre || label;

                    $(element).val(nombreLimpio);
                    $row.find(".productoCodigo").val(codigoUpper);
                    limpiarMarcaSkuInvalido($row);
                    $row.find('.btn-inventario').attr('data-codigo', codigoOriginal).attr('data-nombre', nombreLimpio);

                    const cardCode = $("#clienteHidden").val();
                    const fechaEntrega = $("#FechaEntrega").val();
                    if (!cardCode || !fechaEntrega) {
                        showToast("Selecciona cliente y fecha de entrega antes de agregar productos.", "warning", 6500);
                        resetProductoRow($row);
                        setTimeout(() => $(element).trigger("focus"), 150);
                        return false;
                    }

                    (async () => {
                        if (!aplicaPresupuesto()) {
                            limpiarPresupuestoFila($row);
                            aplicarPrecioYKilosCaja($row, cardCode, codigoUpper);
                            return;
                        }

                        const [anioStr, mesStr] = fechaEntrega.split("-");
                        const owner = getOwnerForPresupuesto();
                        let presObj = null;
                        try { presObj = await obtenerPresupuestoProducto(owner, cardCode, codigoUpper, parseInt(mesStr, 10), parseInt(anioStr, 10)); }
                        catch (_) { presObj = null; }
                        const presVal = presupuestoAsignadoDe(presObj);

                        if (presVal <= 0 && clienteRequierePresupuesto()) {
                            showToast(`No puedes agregar el SKU ${codigoUpper}: no tiene presupuesto asignado (${owner.label}).`, "warning", 7000);
                            resetProductoRow($row);
                            setTimeout(() => $(element).trigger("focus"), 150);
                            return;
                        }

                        if (presVal <= 0) limpiarPresupuestoFila($row);
                        else {
                            $row.find(".presupuesto").val(presVal.toFixed(2));
                            $row.find(".variacionPresupuesto").val("0.00").data("base", 0);
                        }
                        aplicarPrecioYKilosCaja($row, cardCode, codigoUpper, () => setDisponibleEnFila($row, fechaEntrega));
                    })();
                    return false;
                }
            });

            $(element).on('input', function () {
                const s = this.selectionStart, e = this.selectionEnd;
                this.value = this.value.toUpperCase();
                this.setSelectionRange(s, e);
            });
        }

        /* ---------- Validación de SKU escrito a mano ---------- */
        function limpiarMarcaSkuInvalido($row) {
            $row.removeClass("sku-invalido");
            $row.find(".productoInput").removeClass("is-invalid").removeAttr("title");
        }
        function marcarSkuInvalido($row, msg) {
            $row.addClass("sku-invalido");
            $row.find(".productoInput").addClass("is-invalid").attr("title", msg || "SKU inválido. Selecciona un producto de la lista.");
        }
        function limpiarDatosProductoManual($row) {
            $row.find(".productoCodigo").val("");
            limpiarPresupuestoFila($row);
            $row.find(".precio").val("0");
            $row.find(".peso").val("0");
            $row.find(".cajas").val("0");
            $row.find(".subtotal").val("0.00");
            $row.find(".btn-inventario").attr("data-codigo", "").attr("data-nombre", "");
            actualizarTotales();
        }

        function validarSKUsCapturados(mostrarMensaje = true) {
            const malas = [];
            $("#productosBody tr").each(function (i) {
                const $row = $(this);
                const texto = ($row.find(".productoInput").val() || "").trim();
                const codigo = ($row.find(".productoCodigo").val() || "").trim();
                const peso = parseFloat($row.find(".peso").val()) || 0;
                const cajas = parseFloat($row.find(".cajas").val()) || 0;
                const precio = parseFloat($row.find(".precio").val()) || 0;
                limpiarMarcaSkuInvalido($row);
                const tieneCaptura = texto || codigo || peso > 0 || cajas > 0 || precio > 0;
                if (tieneCaptura && !codigo) {
                    malas.push(i + 1);
                    marcarSkuInvalido($row, "SKU no válido. Selecciona un producto existente desde la lista.");
                }
            });

            if (malas.length) {
                if (mostrarMensaje) showToast(`Hay productos sin SKU válido en las filas: ${malas.join(", ")}.\nSelecciónalos desde la lista de búsqueda.`, "warning", 8000);
                $("#productosBody tr.sku-invalido .productoInput").first().trigger("focus");
                return false;
            }
            return true;
        }

        $(document).on("input", ".productoInput", function () {
            const $row = $(this).closest("tr");
            // Si el usuario escribe a mano, el SKU anterior ya no es confiable.
            $row.find(".productoCodigo").val("");
            limpiarDatosProductoManual($row);
            marcarSkuInvalido($row, "Debes seleccionar el producto desde la lista.");
        });

        $(document).on("blur", ".productoInput", function () {
            const input = this;
            setTimeout(() => {
                const $row = $(input).closest("tr");
                const texto = ($(input).val() || "").trim();
                const codigo = ($row.find(".productoCodigo").val() || "").trim();
                if (texto && !codigo) {
                    marcarSkuInvalido($row, "SKU no encontrado. Selecciona un producto válido desde la lista.");
                    showToast("SKU no encontrado. Selecciona un producto válido desde la lista.", "warning", 6000);
                }
            }, 200);
        });

        /* ---------- Kilos ↔ cajas ↔ importe: UN solo manejador para todas las filas ----------
           Antes cada forma de crear filas tenía su propio manejador (y la primera fila no tenía
           ninguno), así que kilos y cajas no siempre se sincronizaban. */
        function recalcSubtotalFila($row) {
            const peso = parseFloat($row.find('.peso').val()) || 0;
            const precio = parseFloat($row.find('.precio').val()) || 0;
            $row.find('.subtotal').val((peso * precio).toFixed(2));
        }

        $(document).on('input', '#productosBody .peso', function () {
            const $row = $(this).closest('tr');
            const kx = parseFloat($row.data('kilosCaja')) || 1;
            const peso = parseFloat($(this).val()) || 0;
            $row.find('.cajas').val((kx ? (peso / kx) : 0).toFixed(0));
            recalcSubtotalFila($row);
            scheduleActualizarTotales();
            recalcularDisponibleFila($row);
        });
        $(document).on('input', '#productosBody .cajas', function () {
            const $row = $(this).closest('tr');
            const kx = parseFloat($row.data('kilosCaja')) || 1;
            const cajas = parseFloat($(this).val()) || 0;
            $row.find('.peso').val((cajas * kx).toFixed(2));
            recalcSubtotalFila($row);
            scheduleActualizarTotales();
            recalcularDisponibleFila($row);
        });
        $(document).on('input', '#productosBody .precio', function () {
            recalcSubtotalFila($(this).closest('tr'));
            scheduleActualizarTotales();
        });

        /* ---------- Construcción de filas (una sola plantilla) ---------- */
        function htmlFilaManual(idx) {
            return `
                <td>${idx + 1}</td>
                <td>
                    <input name="Productos[${idx}].ProductoNombre" class="form-control productoInput" placeholder="Buscar producto por SKU o nombre…" />
                    <input type="hidden" name="Productos[${idx}].ProductoCodigo" class="productoCodigo" />
                </td>
                <td><input name="Productos[${idx}].Presupuesto" class="form-control presupuesto" type="text" value="0" readonly /></td>
                <td><input name="Productos[${idx}].VariacionPresupuesto" class="form-control variacionPresupuesto" type="text" value="0" readonly /></td>
                <td><input name="Productos[${idx}].Peso" class="form-control peso" type="number" step="0.01" value="0" /></td>
                <td><input name="Productos[${idx}].Precio" class="form-control precio" type="number" step="0.01" value="0" /></td>
                <td><input name="Productos[${idx}].Cajas" class="form-control cajas" type="number" min="0" step="1" value="0" /></td>
                <td><input class="form-control subtotal" type="text" value="0.00" readonly /></td>
                <td class="text-center"><button type="button" class="btn btn-sm btn-inventario" data-codigo="" data-nombre=""><i class="bi bi-boxes"></i> Ver</button></td>
                <td class="text-center"><a href="#" class="ov-delete-link" onclick="eliminarProducto(this); return false;" aria-label="Quitar producto"><i class="bi bi-trash"></i></a></td>`;
        }

        function htmlFilaServidor(idx, sku, nombreLimpio, precio, presupuesto) {
            return `
                <td>${idx + 1}</td>
                <td title="${escH(sku + ' - ' + nombreLimpio)}">
                    <input type="hidden" name="Productos[${idx}].ProductoCodigo" class="productoCodigo" value="${escH(sku)}" />
                    <input type="hidden" name="Productos[${idx}].ProductoNombre" value="${escH(nombreLimpio)}" />
                    <span class="ov-sku">${escH(sku)}</span>${escH(nombreLimpio)}
                </td>
                <td><input name="Productos[${idx}].Presupuesto" class="form-control presupuesto" type="text" value="${Number(presupuesto || 0).toFixed(2)}" readonly /></td>
                <td><input name="Productos[${idx}].VariacionPresupuesto" class="form-control variacionPresupuesto" type="text" value="0.00" readonly /></td>
                <td><input name="Productos[${idx}].Peso" class="form-control peso" type="number" step="0.01" value="0.00" /></td>
                <td><input name="Productos[${idx}].Precio" class="form-control precio" type="number" step="0.01" value="${Number(precio || 0).toFixed(2)}" /></td>
                <td><input name="Productos[${idx}].Cajas" class="form-control cajas" type="number" min="0" step="1" value="0" /></td>
                <td><input class="form-control subtotal" type="text" value="0.00" readonly /></td>
                <td class="text-center"><button type="button" class="btn btn-sm btn-inventario" data-codigo="${escH(sku)}" data-nombre="${escH(nombreLimpio)}"><i class="bi bi-boxes"></i> Ver</button></td>
                <td class="text-center"><a href="#" class="ov-delete-link" onclick="eliminarProducto(this); return false;" aria-label="Quitar producto"><i class="bi bi-trash"></i></a></td>`;
        }

        function nombreSinSku(nombreRaw, sku) {
            return (nombreRaw || "").toString().toUpperCase()
                .replace(new RegExp(`\\s*\\(${sku.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}\\)\\s*$`, "i"), "").trim();
        }

        function agregarProducto() {
            const tbody = document.getElementById('productosBody');
            const index = tbody.rows.length;
            const row = tbody.insertRow();
            row.setAttribute("data-origen", "manual");
            row.innerHTML = htmlFilaManual(index);
            initProductoAutocomplete(row.querySelector('.productoInput'));
            actualizarIndices();
            actualizarTotales();
            toggleColumnasPresupuesto();
            setTimeout(() => row.querySelector('.productoInput')?.focus(), 50);
        }

        function eliminarProducto(link) {
            link.closest('tr').remove();
            if (document.getElementById('productosBody').rows.length === 0 && !window.modoCargaMasiva) agregarProducto();
            actualizarIndices();
            actualizarTotales();
            toggleColumnasPresupuesto();
        }

        function eliminarTodosProductos() {
            const capturadas = contarProductosValidos();
            if (capturadas > 0 && !confirm(`Se quitarán todos los productos (${capturadas} con cantidad capturada). ¿Continuar?`)) return;
            $("#productosBody").empty();
            articuloIndex = 0;
            agregarProducto();
            actualizarTotales();
            toggleColumnasPresupuesto();
            $("#archivoExcelMasivo").val("");
            $("#articulosMasivos").val("");
            _excelRowsMasivos = [];
        }

        /* ---------- Totales ---------- */
        function actualizarTotales() {
            const tbody = document.getElementById('productosBody');
            if (!tbody) return;
            let totalPeso = 0, totalImporte = 0, lineas = 0;

            for (let i = 0; i < tbody.rows.length; i++) {
                const row = tbody.rows[i];
                const peso = parseFloat(row.querySelector('.peso')?.value) || 0;
                const precio = parseFloat(row.querySelector('.precio')?.value) || 0;
                const cajas = parseFloat(row.querySelector('.cajas')?.value) || 0;
                const subtotal = peso * precio;
                const subtotalInput = row.querySelector('.subtotal');
                if (subtotalInput) subtotalInput.value = fmt(subtotal);
                totalPeso += peso;
                totalImporte += subtotal;
                if ((row.querySelector('.productoCodigo')?.value || '').trim() && peso > 0 && cajas > 0) lineas++;
                if (row.cells && row.cells[0]) row.cells[0].textContent = i + 1;
            }

            const elPeso = document.getElementById('totalPeso');
            const elImp = document.getElementById('totalImporte');
            const elLin = document.getElementById('totalLineas');
            if (elPeso) elPeso.textContent = fmt(totalPeso);
            if (elImp) elImp.textContent = '$' + fmt(totalImporte);
            if (elLin) elLin.textContent = lineas.toLocaleString('es-MX');

            if (typeof window.actualizarEstadoCargaLogistica === "function") window.actualizarEstadoCargaLogistica();
        }

        let ovTotalesRaf = null;
        function scheduleActualizarTotales() {
            if (ovTotalesRaf) return;
            ovTotalesRaf = requestAnimationFrame(function () { ovTotalesRaf = null; actualizarTotales(); });
        }

        document.addEventListener('DOMContentLoaded', () => {
            $('.productoInput').each(function () { initProductoAutocomplete(this); });
            actualizarTotales();
            lastFechaEntrega = $('#FechaEntrega').val() || null;
            setHeadersPresupuesto();
            toggleColumnasPresupuesto();
        });

        /* ---------- Pegar lista de SKU ---------- */
        let articuloIndex = $('#productosBody tr').length;

        // Solo limpia restos de modal cuando NO hay ningún modal abierto
        // (antes se ejecutaba tras cada consulta y rompía el modal de cobranza abierto).
        function fixScroll() {
            if (document.querySelector('.modal.show')) return;
            $('body').removeClass('modal-open').css({ overflow: '', 'padding-right': '' });
            $('.modal-backdrop').remove();
        }
        $('#modalCargaMasiva').on('hidden.bs.modal', fixScroll);
        $(document).on('ajaxStop', fixScroll);

        $('#btnAgregarArticulos').off('click').on('click', function () {
            const $modalEl = $('#modalCargaMasiva');
            const modal = bootstrap.Modal.getInstance($modalEl[0]);
            const btnText = $('#btnText');
            const btnSpinner = $('#btnSpinner');

            $modalEl.one('hidden.bs.modal', async () => {
                btnText.addClass('d-none');
                btnSpinner.removeClass('d-none');
                try {
                    await runWithLoading("Agregando artículos por SKU…", async (myToken) => {
                        await cargarArticulosMasivosProtected(myToken);
                    }, { lockForm: false, showOverlay: true });
                } finally {
                    btnSpinner.addClass('d-none');
                    btnText.removeClass('d-none');
                    setTimeout(fixScroll, 50);
                }
            });
            if (modal) modal.hide();
        });

        async function cargarArticulosMasivosProtected(myToken) {
            const cardCode = $("#clienteHidden").val();
            if (!cardCode) { alert("Selecciona un cliente primero."); return; }

            window.modoCargaMasiva = true;
            try {
                limpiarFilasVacias();
                const codigos = [...new Set(
                    $("#articulosMasivos").val().trim().toUpperCase().split(/\r?\n/).map(c => c.trim()).filter(c => c !== "")
                )];
                if (codigos.length === 0) { alert("No hay SKU para agregar."); return; }

                const productosSap = (await Promise.all(codigos.map(code =>
                    $.getJSON('/Comercial/ObtenerPrecioArticuloCliente', { cardCode, itemCode: code }).catch(_ => null)
                ))).filter(p => p && p.itemCode);

                const omitidos = [];
                for (const p of productosSap) {
                    if (myToken !== loadToken) return;
                    if (existeSKU(p.itemCode)) { omitidos.push(normCode(p.itemCode)); continue; }
                    await agregarFilaArticuloConPresupuesto(p, cardCode);
                }

                limpiarFilasVacias();
                actualizarTotales();
                if (omitidos.length > 0) showToast(`Estos SKU ya estaban agregados y se omitieron:\n${omitidos.join(', ')}`, 'warning', 7000);
                $("#articulosMasivos").val("");
            } finally {
                window.modoCargaMasiva = false;
            }
        }

        // Omite SKU sin presupuesto (cuando aplica) y regresa la fila o null.
        async function agregarFilaArticuloConPresupuesto(producto, cardCode) {
            const codigoUpper = normCode(producto.itemCode);
            if (!codigoUpper || existeSKU(codigoUpper)) return null;

            const fechaEntrega = $("#FechaEntrega").val();
            if (!fechaEntrega) { showToast("Selecciona fecha de entrega antes de cargar productos.", "warning", 6500); return null; }

            let presVal = 0;
            const owner = getOwnerForPresupuesto();

            if (clienteRequierePresupuesto()) {
                const [anioStr, mesStr] = fechaEntrega.split("-");
                let presObj = null;
                try { presObj = await obtenerPresupuestoProducto(owner, cardCode, codigoUpper, parseInt(mesStr, 10), parseInt(anioStr, 10)); }
                catch (_) { presObj = null; }
                presVal = presupuestoAsignadoDe(presObj);
                if (presVal <= 0) {
                    showToast(`SKU ${codigoUpper} omitido: no tiene presupuesto asignado (${owner.label}).`, "warning", 7000);
                    return null;
                }
            }

            const nombreLimpio = nombreSinSku(producto.itemName, codigoUpper);
            const $row = $('<tr data-origen="servidor"></tr>');
            $row.html(htmlFilaServidor(articuloIndex, codigoUpper, nombreLimpio, producto.precio || 0, presVal));
            $row.data('kilosCaja', producto.kilosCaja || 1);
            $('#productosBody').append($row);

            if (!aplicaPresupuesto()) limpiarPresupuestoFila($row);
            else {
                try {
                    const map = await getDisponiblesMap(owner, cardCode, fechaEntrega);
                    const disp = parseFloat(map[codigoUpper]?.presupuestoDisponible ?? 0);
                    $row.find('.variacionPresupuesto').val(fmtDisponible(disp)).data("base", disp);
                    recalcularDisponibleFila($row);
                } catch {
                    $row.find('.variacionPresupuesto').val("0.00").data("base", 0);
                }
            }

            articuloIndex++;
            actualizarIndices();
            actualizarTotales();
            toggleColumnasPresupuesto();
            return $row;
        }

        /* ---------- Importar desde Excel (SKU | Kg | Cajas | Precio) ---------- */
        let _excelRowsMasivos = [];

        $('#archivoExcelMasivo').on('change', function (e) {
            const file = e.target.files[0];
            _excelRowsMasivos = [];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function (ev) {
                const workbook = XLSX.read(new Uint8Array(ev.target.result), { type: 'array' });
                const sheet = workbook.Sheets[workbook.SheetNames[0]];
                const rows = XLSX.utils.sheet_to_json(sheet, { header: 1 });
                if (!rows || rows.length < 2) { alert('El archivo no tiene datos (o falta el encabezado).'); return; }

                for (let i = 1; i < rows.length; i++) {
                    const r = rows[i];
                    if (!r || r.length === 0) continue;
                    const sku = (r[0] || '').toString().trim().toUpperCase();
                    if (!sku) continue;
                    _excelRowsMasivos.push({ sku, kg: Number(r[1] || 0), cajas: Number(r[2] || 0), precio: Number(r[3] || 0) });
                }
                if (_excelRowsMasivos.length === 0) showToast('No se encontraron filas válidas en el Excel.', 'warning', 6000);
                else showToast(`Se leyeron ${_excelRowsMasivos.length} renglones. Presiona Importar Excel para agregarlos.`, 'success', 6000);
            };
            reader.readAsArrayBuffer(file);
        });

        $('#btnProcesarExcelMasivo').on('click', async function () {
            if (!_excelRowsMasivos.length) { alert('Primero selecciona un archivo Excel válido.'); return; }
            const cardCode = $("#clienteHidden").val();
            if (!cardCode) { alert("Selecciona un cliente primero."); return; }
            await runWithLoading("Cargando artículos desde Excel…", async (myToken) => {
                await cargarArticulosDesdeExcelProtected(myToken, cardCode, _excelRowsMasivos);
            }, { lockForm: false, showOverlay: true });
        });

        async function cargarArticulosDesdeExcelProtected(myToken, cardCode, rowsExcel) {
            window.modoCargaMasiva = true;
            try {
                limpiarFilasVacias();
                const unicos = [];
                const vistos = new Set();
                for (const r of rowsExcel) {
                    if (!r.sku || vistos.has(r.sku)) continue;
                    vistos.add(r.sku);
                    unicos.push(r);
                }
                if (!unicos.length) { alert('No hay SKU válidos para cargar.'); return; }

                const resultados = await Promise.all(unicos.map(r =>
                    $.getJSON('/Comercial/ObtenerPrecioArticuloCliente', { cardCode, itemCode: r.sku })
                        .then(p => ({ ok: true, sku: r.sku, fila: r, sap: p }))
                        .catch(() => ({ ok: false, sku: r.sku, fila: r, sap: null }))
                ));

                const omitidos = [], noEncontrados = [], sinPresupuesto = [];
                for (const res of resultados) {
                    if (myToken !== loadToken) return;
                    const { sku, fila, sap } = res;
                    if (existeSKU(sku)) { omitidos.push(sku); continue; }
                    if (!res.ok || !sap || !sap.itemCode) { noEncontrados.push(sku); continue; }

                    const $row = await agregarFilaArticuloConPresupuesto(sap, cardCode);
                    if (!$row) { (clienteRequierePresupuesto() ? sinPresupuesto : omitidos).push(sku); continue; }

                    if (isFinite(fila.precio) && fila.precio > 0) $row.find('.precio').val(fila.precio.toFixed(2));
                    const kilosCaja = parseFloat($row.data('kilosCaja')) || parseFloat(sap.kilosCaja || 0) || 1;
                    let kg = isFinite(fila.kg) ? fila.kg : 0;
                    let cajas = isFinite(fila.cajas) ? fila.cajas : 0;
                    if (kg > 0 && cajas <= 0) cajas = Math.round(kg / kilosCaja);
                    else if (cajas > 0 && kg <= 0) kg = cajas * kilosCaja;

                    // Se respetan kilos y cajas del archivo (antes las cajas se recalculaban y se perdían).
                    $row.find('.peso').val(kg.toFixed(2));
                    $row.find('.cajas').val(cajas.toString());
                    recalcSubtotalFila($row);
                    recalcularDisponibleFila($row);
                }

                limpiarFilasVacias();
                actualizarTotales();

                let msg = 'Carga desde Excel terminada.\n\n';
                if (omitidos.length) msg += `Ya estaban en la tabla: ${omitidos.join(', ')}\n`;
                if (noEncontrados.length) msg += `No encontrados en SAP: ${noEncontrados.join(', ')}\n`;
                if (sinPresupuesto.length) msg += `Sin presupuesto (omitidos): ${sinPresupuesto.join(', ')}\n`;
                alert(msg);
            } finally {
                window.modoCargaMasiva = false;
            }
        }

        /* ---------- Productos sugeridos por cliente y fecha ----------
           Conserva las filas en las que el usuario ya capturó cantidad
           (antes se borraban al cambiar la fecha dentro del mismo mes). */
        async function cargarProductos(myTokenFromCaller = null) {
            const cardCode = ($("#clienteHidden").val() || "").trim();
            const fecha = ensureFechaEntrega();
            const $tbody = $("#productosBody");
            if (!cardCode || !fecha) return;

            const localToken = myTokenFromCaller ?? ++loadToken;
            if (myTokenFromCaller == null) setLoading(true, `Cargando productos y presupuesto del cliente ${cardCode}…`);

            try {
                $tbody.find("tr[data-origen='servidor']").each(function () {
                    const peso = parseFloat($(this).find(".peso").val()) || 0;
                    const cajas = parseFloat($(this).find(".cajas").val()) || 0;
                    if (peso <= 0 && cajas <= 0) $(this).remove();
                });
                $tbody.find("tr").each(function () {
                    const $row = $(this);
                    const codigo = ($row.find(".productoCodigo").val() || "").trim();
                    const peso = parseFloat($row.find(".peso").val() || "0") || 0;
                    const precio = parseFloat($row.find(".precio").val() || "0") || 0;
                    if (!codigo && peso === 0 && precio === 0) $row.remove();
                });
                if (localToken !== loadToken) return;

                const toArray = raw => !raw ? [] : (Array.isArray(raw) ? raw : (raw.items || raw.Data || raw.data || raw.Items || raw.Datos || []));
                const owner = getOwnerForPresupuesto();

                const construirProductosDesdeCodigos = async (codigos) => {
                    const MAX_AUTO = 150;
                    const top = codigos.slice(0, MAX_AUTO);
                    if (!top.length) return [];
                    const arr = await Promise.all(top.map(code =>
                        $.getJSON("/Comercial/ObtenerPrecioArticuloCliente", { cardCode, itemCode: code })
                            .then(p => ({ productoCodigo: normCode(p?.itemCode || code), productoNombre: (p?.itemName || "").toString(), kilosCaja: parseFloat(p?.kilosCaja || 1) || 1, precio: parseFloat(p?.precio || 0) || 0 }))
                            .catch(() => ({ productoCodigo: normCode(code), productoNombre: "", kilosCaja: 1, precio: 0 }))
                    ));
                    if (codigos.length > MAX_AUTO) showToast(`Se encontraron ${codigos.length} SKU. Se cargaron automáticamente los primeros ${MAX_AUTO}.`, "warning", 7000);
                    return arr;
                };

                const cargarDesdeDisponible = async () => {
                    let listaDisp = [];
                    try { listaDisp = await obtenerDisponiblesLista(owner, cardCode, fecha); } catch (_) { listaDisp = []; }
                    const codigos = [...new Set((listaDisp || [])
                        .map(p => normCode(p.productoCodigo || p.itemCode || p.codigo || p.ProductoCodigo || p.ItemCode || ""))
                        .filter(Boolean))];
                    return await construirProductosDesdeCodigos(codigos);
                };

                const cargarDesdeCliente = async () => {
                    const raw = await tryGetJSON([
                        { url: "/Comercial/ObtenerProductosPorClienteFecha", data: { cardCode, fechaEntrega: fecha } },
                        { url: "/Comercial/ObtenerProductosPorCliente", data: { cardCode } }
                    ]);
                    if (localToken !== loadToken) return [];
                    return toArray(raw);
                };

                let lista = [];
                if (owner.mode === "vend" && owner.id && aplicaPresupuesto()) {
                    lista = await cargarDesdeDisponible();
                    if (!lista || !lista.length) lista = await cargarDesdeCliente();
                } else {
                    lista = await cargarDesdeCliente();
                    if ((!lista || !lista.length) && aplicaPresupuesto()) lista = await cargarDesdeDisponible();
                }
                if (localToken !== loadToken) return;

                (lista || []).forEach((prod) => {
                    const sku = normCode(prod.productoCodigo || prod.itemCode || prod.codigo || "");
                    if (!sku || existeSKU(sku)) return;
                    const nombreLimpio = nombreSinSku(prod.productoNombre || prod.itemName, sku);
                    const idx = $tbody.find("tr").length;
                    const $fila = $('<tr data-origen="servidor"></tr>').html(htmlFilaServidor(idx, sku, nombreLimpio, parseFloat(prod.precio || 0) || 0, 0));
                    $tbody.append($fila);
                    $fila.data("kilosCaja", parseFloat(prod.kilosCaja || 1) || 1);
                });

                if ($tbody.find("tr").length === 0) {
                    agregarProducto();
                    articuloIndex = $tbody.find("tr").length;
                    return;
                }

                actualizarIndices();
                actualizarTotales();
                if (localToken !== loadToken) return;

                if (!aplicaPresupuesto()) {
                    $("#productosBody tr").each(function () { limpiarPresupuestoFila($(this)); });
                    toggleColumnasPresupuesto();
                    articuloIndex = $("#productosBody tr").length;
                    return;
                }

                await recalcularPresupuestoTodasLasFilas(localToken, cardCode, fecha);
                if (localToken !== loadToken) return;

                actualizarTotales();
                toggleColumnasPresupuesto();
                articuloIndex = $("#productosBody tr").length;
            } catch (err) {
                console.error("cargarProductos() error:", err);
                showToast("Error al cargar productos. Revisa la conexión e inténtalo de nuevo.", "danger", 8000);
                if ($("#productosBody tr").length === 0) agregarProducto();
            } finally {
                if (myTokenFromCaller == null && localToken === loadToken) setLoading(false);
            }
        }

        /* ---------- Cambio de fecha de entrega (un solo manejador) ----------
           - Fecha pasada: se corrige a hoy.
           - Cambio de mes: se reinician los productos (el presupuesto es mensual).
           - Mismo mes: se recargan los productos sugeridos de esa fecha exacta,
             conservando lo ya capturado, y se recalcula presupuesto/disponible. */
        let lastFechaEntrega = null;
        function sameMonthYear(a, b) { return !!a && !!b && a.substring(0, 7) === b.substring(0, 7); }

        $("#FechaEntrega").on("change", async function () {
            if ($(this).val() && $(this).val() < fechaMinima) {
                alert("No se pueden seleccionar fechas pasadas.");
                $(this).val(fechaMinima);
            }
            const nueva = $(this).val();
            const cardCode = $("#clienteHidden").val();
            clearDisponiblesCache();
            if (!nueva || !cardCode) { lastFechaEntrega = nueva; return; }

            const cambioMes = lastFechaEntrega && !sameMonthYear(lastFechaEntrega, nueva);
            await runWithLoading(cambioMes ? "Cambio de mes: recargando productos y presupuesto…" : "Actualizando productos de la nueva fecha…", async (myToken) => {
                if (cambioMes) {
                    $("#productosBody").empty();
                    articuloIndex = 0;
                    agregarProducto();
                }
                await cargarProductos(myToken);
                if (!aplicaPresupuesto()) syncNoAplicaState();
            });
            lastFechaEntrega = nueva;
        });

        /* ---------- Documentación del cliente: se consulta al abrir ---------- */
        function cargarPropiedadesModal(cardCode) {
            const body = document.getElementById("modalPropiedadesBody");
            body.innerHTML = '<p class="es-muted">Cargando información…</p>';
            fetch(`/Comercial/ObtenerPropiedadesCliente?cardCode=${encodeURIComponent(cardCode)}`)
                .then(res => res.json())
                .then(data => {
                    if (!data || data.length === 0) { body.innerHTML = '<p class="es-muted">El cliente no tiene documentación registrada.</p>'; return; }
                    body.innerHTML = '<table class="table table-sm"><tbody>' + data.map(p =>
                        `<tr><td class="fw-semibold" style="width:40%">${escH(p.nombre)}</td><td>${p.valor ? escH(p.valor) : '<span class="es-muted">No asignado</span>'}</td></tr>`
                    ).join('') + '</tbody></table>';
                })
                .catch(_ => body.innerHTML = '<p class="text-danger">No se pudo cargar la documentación. Inténtalo de nuevo.</p>');
        }
        document.getElementById('modalPropiedades').addEventListener('show.bs.modal', () => {
            const cardCode = $("#clienteHidden").val();
            if (!cardCode) { $("#modalPropiedadesBody").html('<p class="es-muted">Selecciona un cliente para ver su documentación.</p>'); return; }
            cargarPropiedadesModal(cardCode);
        });

        /* ---------- Inventario ---------- */
        function abrirInventarioModal(codigoProducto, nombreProducto) {
            document.getElementById("modalProductoCodigo").textContent = codigoProducto || "-";
            document.getElementById("modalProductoNombre").textContent = nombreProducto || "-";
            const contenedor = document.getElementById("modalInventarioContenido");
            contenedor.innerHTML = '<p class="es-muted">Cargando inventario…</p>';
            bootstrap.Modal.getOrCreateInstance(document.getElementById("inventarioModal")).show();

            if (!codigoProducto) { contenedor.innerHTML = '<p class="es-muted">Selecciona primero un producto en la fila.</p>'; return; }

            fetch(`/Comercial/ObtenerInventario?productoCodigo=${encodeURIComponent(codigoProducto)}`)
                .then(r => { if (!r.ok) throw new Error("No se encontró inventario para este producto."); return r.json(); })
                .then(data => {
                    if (!data || data.length === 0) { contenedor.innerHTML = '<p class="text-center es-muted">No hay inventario disponible.</p>'; return; }
                    contenedor.innerHTML = `
                        <table class="table table-sm">
                            <thead><tr><th class="text-end">Cajas</th><th class="text-end">Kg</th><th>Almacén</th><th>Sucursal</th></tr></thead>
                            <tbody>${data.map(item => `
                                <tr>
                                    <td class="text-end es-num">${Number(item.cajas ?? 0).toLocaleString("es-MX")}</td>
                                    <td class="text-end es-num">${Number(item.kg ?? 0).toLocaleString("es-MX")}</td>
                                    <td>${escH(item.almacen ?? "")}</td>
                                    <td>${escH(item.sucursal ?? "")}</td>
                                </tr>`).join('')}
                            </tbody>
                        </table>`;
                })
                .catch(err => contenedor.innerHTML = `<p class="text-danger">${escH(err.message)}</p>`);
        }
        $(document).on('click', '.btn-inventario', function (e) {
            e.preventDefault();
            abrirInventarioModal($(this).attr('data-codigo') || "", ($(this).attr('data-nombre') || "").toUpperCase());
        });

        function actualizarIndices() {
            $("#productosBody tr").each(function (i, tr) {
                $(tr).find("td:first").text(i + 1);
                $(tr).find("input").each(function () {
                    const name = $(this).attr("name");
                    if (name) $(this).attr("name", name.replace(/Productos\[\d+\]/, `Productos[${i}]`));
                });
            });
        }

        /* ---------- Catálogo de clientes (modal) ---------- */
        let clState = { page: 1, pageSize: 15, total: 0, items: [] };

        $("#btnBuscarCliente").on("click", function () {
            const actual = ($("#clienteInput").val() || "").replace(/\s*\([^)]*\)\s*$/, '');
            $("#clq").val(actual.trim().toUpperCase());
            clState.page = 1;
            cargarClientesModal();
            bootstrap.Modal.getOrCreateInstance(document.getElementById("clienteLookupModal")).show();
            setTimeout(() => $("#clq").trigger("focus"), 150);
        });
        $("#clBuscar").on("click", () => { clState.page = 1; cargarClientesModal(); });
        $("#clLimpiar").on("click", () => { $("#clq").val(""); clState.page = 1; cargarClientesModal(); });
        $("#clTam").on("change", function () { clState.pageSize = parseInt(this.value, 10) || 15; clState.page = 1; cargarClientesModal(); });
        $("#clq").on("keydown", function (e) { if (e.key === "Enter") { e.preventDefault(); clState.page = 1; cargarClientesModal(); } });
        $("#clq").on("input", function () {
            const s = this.selectionStart, e = this.selectionEnd;
            this.value = (this.value || "").toUpperCase();
            this.setSelectionRange(s, e);
        });

        function renderPaginacion(total, page, pageSize) {
            total = Number(total || 0); page = Number(page || 1); pageSize = Number(pageSize || 15);
            const totalPages = Math.max(1, Math.ceil(total / pageSize));
            $("#clPaginacion").html(`
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-sm" id="clPrev" ${page <= 1 ? "disabled" : ""} aria-label="Página anterior"><i class="bi bi-chevron-left"></i></button>
                    <span>Página <b>${page}</b> de <b>${totalPages}</b> · <span class="es-muted">${total.toLocaleString('es-MX')} resultado(s)</span></span>
                    <button type="button" class="btn btn-sm" id="clNext" ${page >= totalPages ? "disabled" : ""} aria-label="Página siguiente"><i class="bi bi-chevron-right"></i></button>
                </div>`);
            $("#clPrev").on("click", () => { if (clState.page > 1) { clState.page--; cargarClientesModal(); } });
            $("#clNext").on("click", () => {
                const tp = Math.max(1, Math.ceil(clState.total / clState.pageSize));
                if (clState.page < tp) { clState.page++; cargarClientesModal(); }
            });
        }

        async function cargarClientesModal() {
            const termUpper = ($("#clq").val() || "").toUpperCase();
            const page = clState.page, pageSize = clState.pageSize;
            const $rows = $("#clienteRows");
            $rows.html(`<tr><td colspan="4" class="text-center p-4 es-muted">Buscando…</td></tr>`);

            try {
                const r = await $.getJSON("/Comercial/BuscarClientesMixto", { term: termUpper, page, pageSize });
                let items = Array.isArray(r?.items) ? r.items : (Array.isArray(r) ? r : []);
                if (OV_ES_VENDEDOR_USUARIO) items = items.filter(ovClientePermitidoPorVendedor);
                const total = OV_ES_VENDEDOR_USUARIO ? items.length : Number(r?.total ?? items.length);
                clState.total = total;
                clState.items = items;

                if (!items.length) {
                    $rows.html(`<tr><td colspan="4" class="text-center es-muted p-4">Sin resultados. Prueba con otra parte del nombre o el código.</td></tr>`);
                    renderPaginacion(total, page, pageSize);
                    return;
                }

                $rows.html(items.map((it, i) => {
                    const cardCode = it.cardCode || it.codigo || it.value || it.Cliente || "";
                    const cardName = it.cardName || it.nombre || it.label || it.Nombre || "";
                    const vendedorNombre = it.vendedorNombre || it.VendedorNombre || it.Vendedor || "—";
                    return `
                        <tr>
                            <td class="fw-semibold">${escH(cardCode)}</td>
                            <td title="${escH(cardName)}">${escH((cardName || "").toUpperCase())}</td>
                            <td title="${escH(vendedorNombre)}">${escH(vendedorNombre)}</td>
                            <td class="text-center"><button type="button" class="btn btn-sm btn-primary clSel" data-i="${i}">Seleccionar</button></td>
                        </tr>`;
                }).join(''));

                $(".clSel").on("click", async function () {
                    const it = clState.items[Number($(this).data("i"))] || {};
                    const payload = {
                        cardCode: it.cardCode || it.codigo || it.value || it.Cliente || "",
                        cardName: (it.cardName || it.nombre || it.label || it.Nombre || "").toString(),
                        vendedorNombre: (it.vendedorNombre || it.VendedorNombre || it.Vendedor || "").toString(),
                        vendedorId: (it.vendedorId || it.VendedorId || it.salesPersonId || "").toString(),
                        esCanalCedis: pickBool(it.esCanalCedis ?? it.EsCanalCedis ?? it.canalCedis ?? it.CanalCedis ?? it.isCanalCedis ?? it.IsCanalCedis),
                        aplicaPresupuesto: pickBoolDefaultTrue(it.aplicaPresupuesto ?? it.AplicaPresupuesto ?? it.clienteAplicaPresupuesto ?? it.ClienteAplicaPresupuesto)
                    };
                    bootstrap.Modal.getInstance(document.getElementById("clienteLookupModal"))?.hide();
                    await onClienteSeleccionadoDesdeModal(payload);
                });

                renderPaginacion(total, page, pageSize);
            } catch (e) {
                console.error(e);
                $rows.html(`<tr><td colspan="4" class="text-danger text-center p-4">Error al buscar clientes. Inténtalo de nuevo.</td></tr>`);
                renderPaginacion(0, 1, clState.pageSize);
            }
        }

        async function onClienteSeleccionadoDesdeModal(cli) {
            await aplicarClienteSeleccionado(cli);
        }

        /* ---------- Validaciones de guardado ---------- */
        function valNum(sel) {
            const n = Number(($(sel).val() ?? '').toString().replace(/[^\d.-]/g, ''));
            return isFinite(n) ? n : 0;
        }

        function filasSinPresupuesto() {
            if (!aplicaPresupuesto()) return [];
            const malas = [];
            $("#productosBody tr").each(function (i) {
                const $row = $(this);
                const codigo = normCode($row.find(".productoCodigo").val());
                const peso = parseFloat($row.find(".peso").val()) || 0;
                const cajas = parseFloat($row.find(".cajas").val()) || 0;
                const pres = parseFloat(($row.find(".presupuesto").val() || "0").replace(/,/g, "")) || 0;
                if (codigo && (peso > 0 || cajas > 0) && pres <= 0) { malas.push(i + 1); $row.addClass("table-danger"); }
                else $row.removeClass("table-danger");
            });
            return malas;
        }

        function filasConDisponibleNoPositivo() {
            if (!aplicaPresupuesto()) return [];
            const malas = [];
            $("#productosBody tr").each(function (i) {
                const $row = $(this);
                const codigo = normCode($row.find(".productoCodigo").val());
                const peso = parseFloat($row.find(".peso").val()) || 0;
                const cajas = parseFloat($row.find(".cajas").val()) || 0;
                if (!codigo || (peso <= 0 && cajas <= 0)) return;
                const pres = parseFloat(($row.find(".presupuesto").val() || "0").replace(/,/g, "")) || 0;
                const disp = parseFloat(($row.find(".variacionPresupuesto").val() || "0").replace(/,/g, "")) || 0;
                if (pres <= 0) return;
                if (disp < 0) { malas.push(i + 1); $row.addClass("table-danger"); }
                else $row.removeClass("table-danger");
            });
            return malas;
        }

        function limpiarFilasVacias() {
            $("#productosBody tr").each(function () {
                const $row = $(this);
                const code = ($row.find(".productoCodigo").val() || "").trim();
                const peso = parseFloat($row.find(".peso").val()) || 0;
                const cajas = parseFloat($row.find(".cajas").val()) || 0;
                const precio = parseFloat($row.find(".precio").val()) || 0;
                if (!code && peso === 0 && cajas === 0 && precio === 0) $row.remove();
            });
            actualizarIndices();
            actualizarTotales();
        }

        // Fila con solo cajas o solo kilos: se bloquea para que no llegue inconsistente.
        function filasConCantidadIncompleta() {
            const malas = [];
            $("#productosBody tr").each(function (i) {
                const $row = $(this);
                if (!($row.find(".productoCodigo").val() || "").trim()) return;
                const peso = parseFloat($row.find(".peso").val()) || 0;
                const cajas = parseFloat($row.find(".cajas").val()) || 0;
                $row.find(".peso, .cajas").removeClass("is-invalid");
                if (peso < 0 || cajas < 0 || ((peso > 0) !== (cajas > 0))) {
                    malas.push(i + 1);
                    $row.find(".peso, .cajas").addClass("is-invalid");
                }
            });
            return malas;
        }

        function quitarProductosSinCantidadAntesDeGuardar() {
            $("#productosBody tr").each(function () {
                const peso = parseFloat($(this).find(".peso").val()) || 0;
                const cajas = parseFloat($(this).find(".cajas").val()) || 0;
                if (peso <= 0 && cajas <= 0) $(this).remove();
            });
            actualizarIndices();
            actualizarTotales();
        }

        function filasConPrecioCero() {
            const malas = [];
            $("#productosBody tr").each(function (i) {
                const $row = $(this);
                const codigo = ($row.find(".productoCodigo").val() || "").trim();
                const peso = parseFloat($row.find(".peso").val()) || 0;
                const cajas = parseFloat($row.find(".cajas").val()) || 0;
                const $precio = $row.find(".precio");
                const precio = parseFloat($precio.val());
                $precio.removeClass("is-invalid");
                if (codigo && peso > 0 && cajas > 0 && (!isFinite(precio) || precio <= 0)) {
                    malas.push(i + 1);
                    $precio.addClass("is-invalid");
                }
            });
            return malas;
        }

        // Validación completa al enviar. Antes se registraba en TODOS los formularios de la página
        // (incluidos los del layout); ahora solo en el de la orden.
        $("#formOV").on("submit", function (e) {
            const bloquear = (msg) => { e.preventDefault(); if (msg) alert(msg); return false; };

            if (OV_ES_VENDEDOR_USUARIO && OV_VENDEDOR_IDS_USUARIO.length) {
                const vendActual = ovNormalizarVendedorId($("#VendedorId").val());
                if (vendActual == null || !OV_VENDEDOR_IDS_USUARIO.includes(vendActual)) {
                    e.preventDefault();
                    showToast("El cliente seleccionado no pertenece al vendedor asignado a tu usuario.", "danger", 7500);
                    return false;
                }
            }
            if (isLoading) return bloquear("Espera a que termine la carga antes de guardar.");
            if (!validarSKUsCapturados(true)) { e.preventDefault(); return false; }

            let mensaje = "";
            if (!$("#clienteHidden").val()) mensaje += "- Selecciona un cliente.\n";
            if (!$("#FechaEntrega").val()) mensaje += "- Captura la fecha de entrega.\n";
            if (!$("#Serie").val()) mensaje += "- Selecciona una serie.\n";
            if (!$("#Presentacion").val()) mensaje += "- Selecciona una presentación.\n";
            if (!$("#Vendedor").val()) mensaje += "- El cliente no tiene vendedor asignado.\n";
            if (contarProductosValidos() === 0) mensaje += "- Agrega al menos un producto con kilos y cajas.\n";
            if (mensaje) return bloquear("Corrige lo siguiente antes de guardar:\n\n" + mensaje);

            const esMuestra = !!document.getElementById('chkEsMuestra')?.checked;
            if (!esMuestra) {
                const totales = [valNum('#saldoInput'), valNum('#saldoVencidoInput'), valNum('#otrosPedidosInput'), valNum('#creditoInput')];
                if (totales.every(x => x === 0)) {
                    return bloquear("No se pudo obtener la información de crédito de SAP (todos los totales están en 0). Vuelve a seleccionar el cliente o verifica la conexión.");
                }
                const sinPres = filasSinPresupuesto();
                if (sinPres.length) return bloquear(`No puedes guardar: hay productos sin presupuesto asignado en las filas ${sinPres.join(', ')}.`);
                const sinDisp = filasConDisponibleNoPositivo();
                if (sinDisp.length) return bloquear(`No puedes guardar: el disponible quedó por debajo de 0 en las filas ${sinDisp.join(', ')}.\n\nAjusta kilos/cajas o quita el producto.`);
            }

            const precioCero = filasConPrecioCero();
            if (precioCero.length) return bloquear(`Hay precio en 0 o vacío en las filas ${precioCero.join(', ')}.`);
        });

        /* =====================================================================
           COBRANZA · COMPROMISO DE PAGO POR FACTURA
        ===================================================================== */
        let pendingSubmitAction = null;
        let pendingSubmitButton = null;
        let bypassConfirmSubmit = false;
        let compromisoPagoConfirmado = false;

        function cobMoney(v) { return new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(Number(v || 0)); }
        function cobFecha(v) {
            if (!v) return '-';
            const d = new Date(v);
            return Number.isNaN(d.getTime()) ? '-' : d.toLocaleDateString('es-MX');
        }
        const cobEsc = escH;
        function cobMontoNumero(v) { const n = Number(v); return Number.isFinite(n) ? Math.max(0, n) : 0; }

        function cobTextoMotivoPago(factura, tipo, monto, pendiente) {
            const montoNum = cobMontoNumero(monto);
            const pendienteNum = cobMontoNumero(pendiente);
            if (tipo === 'TOTAL') return `Pago TOTAL por ${cobMoney(pendienteNum)} correspondiente a la factura ${factura}.`;
            if (montoNum <= 0) return `Pago PARCIAL de la factura ${factura}. Captura el monto comprometido.`;
            return `Pago PARCIAL por ${cobMoney(montoNum)} correspondiente a la factura ${factura}. Saldo restante estimado: ${cobMoney(Math.max(0, pendienteNum - montoNum))}.`;
        }

        function cobActualizarMotivoFila($fila, limpiarMontoParcial = false) {
            if (!$fila || !$fila.length) return;
            const factura = ($fila.data('factura') || '').toString();
            const pendiente = cobMontoNumero($fila.data('pendiente'));
            const $monto = $fila.find('.cob-monto-pago');
            const tipo = ($fila.find('.cob-tipo-pago').val() || 'TOTAL').toString().toUpperCase();
            if (tipo === 'TOTAL') { $monto.val(pendiente.toFixed(2)); $monto.prop('readonly', true); }
            else { $monto.prop('readonly', false); if (limpiarMontoParcial) $monto.val(''); }
            $fila.find('.cob-motivo-compromiso').val(cobTextoMotivoPago(factura, tipo, cobMontoNumero($monto.val()), pendiente));
        }

        function mostrarErrorCompromiso(msg) { $('#cobCompromisoError').text(msg || '').toggle(!!msg); }

        async function abrirCompromisoPagoModal() {
            const cardCode = ($('#clienteHidden').val() || '').trim();
            if (!cardCode) { alert('Selecciona un cliente primero.'); return; }

            compromisoPagoConfirmado = false;
            mostrarErrorCompromiso('');
            const hoyC = new Date();
            const hoyIso = `${hoyC.getFullYear()}-${String(hoyC.getMonth() + 1).padStart(2, '0')}-${String(hoyC.getDate()).padStart(2, '0')}`;

            $('#cobResumenCompromisos').hide().html('');
            $('#btnAceptarCompromisoPago').html('<i class="bi bi-check2-circle"></i> Guardar compromisos y continuar');
            $('#cobFacturasVencidasBody').html('<tr><td colspan="10" class="text-center">Consultando facturas vencidas y compromisos…</td></tr>');
            $('#cobSaldoVencidoTotal').text(cobMoney(valNum('#saldoVencidoInput')));
            bootstrap.Modal.getOrCreateInstance(document.getElementById('compromisoPagoModal')).show();

            try {
                const data = await $.getJSON('/Comercial/ObtenerFacturasVencidasCliente', { cardCode });
                if (!data || data.ok === false) throw new Error(data?.mensaje || 'No se recibió información de cobranza.');

                const facturas = Array.isArray(data.facturas) ? data.facturas : [];
                $('#cobSaldoVencidoTotal').text(cobMoney(data.saldoVencido || 0));

                if (!facturas.length) {
                    $('#cobFacturasVencidasBody').html('<tr><td colspan="10" class="text-center">SAP no devolvió facturas vencidas abiertas. Vuelve a seleccionar el cliente antes de guardar.</td></tr>');
                    return;
                }

                const conCompromiso = facturas.filter(f => !!f.tieneCompromiso).length;
                const sinCompromiso = facturas.length - conCompromiso;

                if (conCompromiso > 0) {
                    let resumen = `<b><i class="bi bi-exclamation-triangle-fill"></i> Este cliente ya tiene ${conCompromiso} factura(s) con compromiso activo.</b><br>`;
                    resumen += sinCompromiso > 0 ? `${sinCompromiso} factura(s) todavía requieren un compromiso nuevo. ` : `Todas las facturas vencidas ya tienen compromiso. `;
                    resumen += `La nueva orden se guardará <b>EN REVISIÓN</b> y no se duplicarán los compromisos existentes.`;
                    $('#cobResumenCompromisos').html(resumen).show();
                } else {
                    $('#cobResumenCompromisos').html(`<b>${sinCompromiso} factura(s) vencida(s) sin compromiso previo.</b> Captura el compromiso de cada una para continuar.`).show();
                }

                if (conCompromiso > 0 && sinCompromiso === 0) $('#btnAceptarCompromisoPago').html('<i class="bi bi-shield-check"></i> Continuar a revisión');
                else if (conCompromiso > 0) $('#btnAceptarCompromisoPago').html('<i class="bi bi-check2-circle"></i> Guardar nuevos compromisos y continuar a revisión');

                $('#cobFacturasVencidasBody').html(facturas.map((f, i) => {
                    const factura = cobEsc(f.docNum);
                    const pendiente = cobMontoNumero(f.pendiente);

                    if (f.tieneCompromiso) {
                        const fechaCompromiso = cobFecha(f.fechaCompromiso);
                        return `
                            <tr class="cob-compromiso-row cob-row-existente" data-index="${i}" data-requiere-captura="0" data-factura="${factura}" data-pendiente="${pendiente}">
                                <td><b>${factura}</b><br><small class="es-muted">Compromiso existente</small></td>
                                <td>${cobFecha(f.fechaFactura)}</td>
                                <td>${cobFecha(f.fechaVencimiento)}</td>
                                <td class="num">${cobMoney(f.importe)}</td>
                                <td class="num">${cobMoney(f.pagado)}</td>
                                <td class="num"><b>${cobMoney(pendiente)}</b></td>
                                <td class="num">${Number(f.diasVencidos || 0)}</td>
                                <td class="cob-col-fecha"><span class="cob-badge-existente">Ya capturado</span><br><b>${fechaCompromiso}</b></td>
                                <td class="cob-col-motivo">
                                    <div class="cob-compromiso-existente">
                                        <div class="cob-existente-titulo"><span class="cob-badge-existente">${cobEsc(f.estatusCompromiso || 'PENDIENTE')}</span><span>${cobEsc(f.tipoCompromiso || 'COMPROMISO')}</span></div>
                                        <div><b>OV origen:</b> ${cobEsc(f.ovCompromiso || '-')}</div>
                                        <div><b>Fecha compromiso:</b> ${fechaCompromiso}</div>
                                        <div><b>Pendiente actual SAP:</b> ${cobMoney(pendiente)}</div>
                                        <div><b>Compromiso:</b> ${cobEsc(f.motivoCompromiso || '-')}</div>
                                        <div class="cob-existente-revision">Esta factura ya tiene compromiso. No se captura otro y la nueva OV pasa a revisión.</div>
                                    </div>
                                </td>
                                <td class="cob-col-evidencia"><span class="cob-no-nueva-evidencia"><i class="bi bi-lock-fill"></i> No requiere nueva evidencia: se conserva la del compromiso original.</span></td>
                            </tr>`;
                    }

                    return `
                        <tr class="cob-compromiso-row" data-index="${i}" data-requiere-captura="1" data-factura="${factura}" data-pendiente="${pendiente}">
                            <td>
                                <b>${factura}</b>
                                <input type="hidden" name="CompromisosPago[${i}].Factura" value="${factura}" form="formOV" />
                                <input type="hidden" name="CompromisosPago[${i}].SapDocEntry" value="${Number(f.docEntry || 0)}" form="formOV" />
                            </td>
                            <td>${cobFecha(f.fechaFactura)}</td>
                            <td>${cobFecha(f.fechaVencimiento)}</td>
                            <td class="num">${cobMoney(f.importe)}</td>
                            <td class="num">${cobMoney(f.pagado)}</td>
                            <td class="num"><b>${cobMoney(pendiente)}</b></td>
                            <td class="num">${Number(f.diasVencidos || 0)}</td>
                            <td class="cob-col-fecha">
                                <input type="date" class="form-control cob-fecha-compromiso" name="CompromisosPago[${i}].FechaCompromisoPago" form="formOV" min="${hoyIso}" aria-label="Fecha compromiso de la factura ${factura}" />
                            </td>
                            <td class="cob-col-motivo">
                                <div class="cob-pago-tools">
                                    <select class="form-select cob-tipo-pago" aria-label="Tipo de pago de la factura ${factura}">
                                        <option value="TOTAL" selected>Pago total</option>
                                        <option value="PARCIAL">Pago parcial</option>
                                    </select>
                                    <div class="cob-monto-wrap">
                                        <span>$</span>
                                        <input type="number" class="form-control cob-monto-pago" min="0.01" max="${pendiente.toFixed(2)}" step="0.01" value="${pendiente.toFixed(2)}" readonly aria-label="Monto comprometido" />
                                    </div>
                                </div>
                                <textarea class="form-control cob-motivo-compromiso" name="CompromisosPago[${i}].Motivo" form="formOV" maxlength="1000" rows="3" placeholder="Compromiso de esta factura…">${cobEsc(cobTextoMotivoPago(f.docNum, 'TOTAL', pendiente, pendiente))}</textarea>
                                <small class="cob-ayuda-pago">Elige "Pago parcial" si no liquidará el total y captura cuánto pagará. El comentario se actualiza solo y puedes editarlo.</small>
                            </td>
                            <td class="cob-col-evidencia">
                                <input type="file" class="form-control cob-evidencia-compromiso" name="CompromisosPago[${i}].Evidencia" form="formOV"
                                       accept="image/jpeg,image/png,image/webp,application/pdf,.jpg,.jpeg,.png,.webp,.pdf" aria-label="Evidencia de la factura ${factura}" />
                            </td>
                        </tr>`;
                }).join(''));
            } catch (err) {
                console.error('Error obteniendo facturas vencidas/compromisos:', err);
                $('#cobFacturasVencidasBody').html('<tr><td colspan="10" class="text-center text-danger">No se pudieron consultar las facturas vencidas y los compromisos. No continúes hasta que la consulta responda.</td></tr>');
                mostrarErrorCompromiso(err?.message || 'Error consultando cobranza.');
            }
        }

        function abrirConfirmacionGuardar() {
            const lineas = contarProductosValidos();
            const cliente = ($("#clienteInput").val() || "").trim();
            $("#confirmarGuardarResumen").html(
                `<p class="mb-2">¿Guardar esta orden?</p>
                 <table class="table table-sm mb-0"><tbody>
                    <tr><td class="es-muted">Cliente</td><td><b>${escH(cliente || '-')}</b></td></tr>
                    <tr><td class="es-muted">Fecha para embarcar</td><td><b>${escH($("#FechaEntrega").val() || '-')}</b></td></tr>
                    <tr><td class="es-muted">Líneas con cantidad</td><td><b>${lineas}</b></td></tr>
                    <tr><td class="es-muted">Total peso</td><td><b>${escH($("#totalPeso").text())} kg</b></td></tr>
                    <tr><td class="es-muted">Total importe</td><td><b>${escH($("#totalImporte").text())}</b></td></tr>
                    ${esOrdenMuestra() ? '<tr><td class="es-muted">Tipo</td><td><b>Orden de muestra</b></td></tr>' : ''}
                 </tbody></table>`);
            bootstrap.Modal.getOrCreateInstance(document.getElementById('confirmarGuardarModal')).show();
        }

        $(document).on("click", "button[type='submit'][form='formOV'], #formOV button[type='submit']", function (e) {
            if (isLoading) return;

            const detener = (msg) => { e.preventDefault(); e.stopPropagation(); if (msg) alert(msg); return false; };

            if (!validarSKUsCapturados(true)) return detener();

            const incompletas = filasConCantidadIncompleta();
            if (incompletas.length) {
                return detener("No puedes guardar la orden.\n\nEstas filas tienen cajas o kilos incompletos o inválidos: " + incompletas.join(", ") +
                    ".\n\nCaptura cajas y kilos mayores a cero, o deja ambos en 0 para omitir el producto.");
            }
            if (contarProductosValidos() === 0) return detener("No puedes guardar la orden.\n\nCaptura al menos un producto con cajas y kilos mayores a cero.");

            if (typeof window.validarLimiteCargaLogistica === "function" && !window.validarLimiteCargaLogistica(true)) {
                e.preventDefault(); e.stopImmediatePropagation(); return false;
            }
            if (bypassConfirmSubmit) { e.preventDefault(); e.stopPropagation(); return; }

            e.preventDefault();
            e.stopPropagation();
            pendingSubmitAction = $(this).val();
            pendingSubmitButton = this;

            const esMuestra = !!document.getElementById('chkEsMuestra')?.checked;
            if (!esMuestra && valNum('#saldoVencidoInput') > 0.01 && !compromisoPagoConfirmado) {
                abrirCompromisoPagoModal();
                return;
            }
            abrirConfirmacionGuardar();
        });

        $(document).on('change', '#cobFacturasVencidasBody .cob-tipo-pago', function () {
            const $fila = $(this).closest('.cob-compromiso-row');
            const esParcial = ($(this).val() || '').toString().toUpperCase() === 'PARCIAL';
            cobActualizarMotivoFila($fila, esParcial);
            if (esParcial) $fila.find('.cob-monto-pago').trigger('focus');
        });
        $(document).on('input', '#cobFacturasVencidasBody .cob-monto-pago', function () {
            const $fila = $(this).closest('.cob-compromiso-row');
            if (($fila.find('.cob-tipo-pago').val() || '').toString().toUpperCase() === 'PARCIAL') cobActualizarMotivoFila($fila, false);
        });

        $('#btnAceptarCompromisoPago').on('click', function () {
            mostrarErrorCompromiso('');
            const $todasLasFilas = $('#cobFacturasVencidasBody .cob-compromiso-row');
            if (!$todasLasFilas.length) { mostrarErrorCompromiso('No hay facturas vencidas cargadas para revisar.'); return; }

            // Solo se validan las facturas sin compromiso previo; las demás son informativas.
            const $filas = $todasLasFilas.filter('[data-requiere-captura="1"]');
            const modalEl = document.getElementById('compromisoPagoModal');

            if (!$filas.length) {
                compromisoPagoConfirmado = true;
                modalEl.addEventListener('hidden.bs.modal', abrirConfirmacionGuardar, { once: true });
                bootstrap.Modal.getInstance(modalEl)?.hide();
                return;
            }

            const hoyV = new Date();
            hoyV.setHours(0, 0, 0, 0);
            let error = '';
            let $campoError = null;
            $filas.removeClass('cob-row-error cob-row-ok');

            $filas.each(function () {
                if (error) return false;
                const $fila = $(this);
                const factura = ($fila.data('factura') || '').toString();
                const $fecha = $fila.find('.cob-fecha-compromiso');
                const $montoPago = $fila.find('.cob-monto-pago');
                const $motivo = $fila.find('.cob-motivo-compromiso');
                const $evidencia = $fila.find('.cob-evidencia-compromiso');
                const fecha = ($fecha.val() || '').trim();
                const tipoPago = ($fila.find('.cob-tipo-pago').val() || 'TOTAL').toString().toUpperCase();
                const pendienteFactura = cobMontoNumero($fila.data('pendiente'));
                const montoPago = cobMontoNumero($montoPago.val());
                const motivo = ($motivo.val() || '').trim();
                const archivo = $evidencia[0]?.files?.[0] || null;
                const fallar = (msg, $c) => { error = msg; $campoError = $c; $fila.addClass('cob-row-error'); return false; };

                if (!fecha) return fallar(`Captura la fecha compromiso de la factura ${factura}.`, $fecha);
                const fechaCompromiso = new Date(fecha + 'T00:00:00');
                if (Number.isNaN(fechaCompromiso.getTime()) || fechaCompromiso < hoyV) return fallar(`La fecha compromiso de la factura ${factura} debe ser hoy o posterior.`, $fecha);
                if (tipoPago === 'PARCIAL') {
                    if (montoPago <= 0) return fallar(`Captura cuánto pagará de la factura ${factura}.`, $montoPago);
                    if (montoPago > pendienteFactura + 0.01) return fallar(`El monto de la factura ${factura} no puede ser mayor al pendiente ${cobMoney(pendienteFactura)}.`, $montoPago);
                } else {
                    $montoPago.val(pendienteFactura.toFixed(2));
                }
                if (motivo.length < 5) return fallar(`Captura un comentario de al menos 5 caracteres para la factura ${factura}.`, $motivo);
                if (archivo) {
                    if (!/\.(jpg|jpeg|png|webp|pdf)$/.test((archivo.name || '').toLowerCase())) return fallar(`La evidencia de la factura ${factura} debe ser JPG, PNG, WEBP o PDF.`, $evidencia);
                    if (archivo.size > 8 * 1024 * 1024) return fallar(`La evidencia de la factura ${factura} no puede superar 8 MB.`, $evidencia);
                }
                $fila.addClass('cob-row-ok');
            });

            if (error) {
                mostrarErrorCompromiso(error);
                if ($campoError?.length) {
                    $campoError.trigger('focus');
                    $campoError[0]?.scrollIntoView({ behavior: 'smooth', block: 'center', inline: 'nearest' });
                }
                return;
            }

            compromisoPagoConfirmado = true;
            modalEl.addEventListener('hidden.bs.modal', abrirConfirmacionGuardar, { once: true });
            bootstrap.Modal.getInstance(modalEl)?.hide();
        });

        $('#clienteHidden').on('change', function () {
            compromisoPagoConfirmado = false;
            $('#cobFacturasVencidasBody').empty();
            $('#cobResumenCompromisos').hide().empty();
            $('#btnAceptarCompromisoPago').html('<i class="bi bi-check2-circle"></i> Guardar compromisos y continuar');
            mostrarErrorCompromiso('');
        });

        $("#btnConfirmarGuardar").on("click", function () {
            if (!pendingSubmitAction) return;
            const form = document.getElementById("formOV");

            let hidden = form.querySelector("input[name='accion'].__confirm_submit");
            if (!hidden) {
                hidden = document.createElement("input");
                hidden.type = "hidden";
                hidden.name = "accion";
                hidden.className = "__confirm_submit";
                form.appendChild(hidden);
            }
            hidden.value = pendingSubmitAction;

            bootstrap.Modal.getInstance(document.getElementById("confirmarGuardarModal"))?.hide();
            quitarProductosSinCantidadAntesDeGuardar();

            if (contarProductosValidos() === 0) {
                bypassConfirmSubmit = false;
                alert("No puedes guardar la orden.\n\nCaptura al menos un producto con cajas y kilos mayores a cero.");
                return;
            }

            bypassConfirmSubmit = true;
            actualizarIndices();
            actualizarTotales();
            try {
                if (form.requestSubmit) form.requestSubmit();
                else form.submit();
            } finally {
                setTimeout(() => { bypassConfirmSubmit = false; }, 300);
            }
        });

        document.getElementById("confirmarGuardarModal").addEventListener("hidden.bs.modal", function () {
            pendingSubmitAction = null;
            pendingSubmitButton = null;
            if (!isLoading) bypassConfirmSubmit = false;
        });

        // Enter no envía la orden por accidente, pero sí permite saltos de línea en Observación.
        $("#formOV").on("keydown", function (e) {
            if (e.key === "Enter" && e.target.tagName !== "TEXTAREA") {
                e.preventDefault();
                e.stopPropagation();
                return false;
            }
        });

        // Manual de ayuda (sin cambios)
        window.manualConfig = {
            title: "Manual de Orden de Venta",
            sections: [
                { id: "Vista General de la Interfaz", title: "Vista General de la Interfaz", icon: "fa-home", steps: [{ title: "Inicio", text: "Vista General del Sistema", image: "/images/OV/Main.gif" }] },
                {
                    id: "Primeros Pasos", title: "Primeros pasos", icon: "fa-file-lines", steps: [
                        { title: "Seleccion de Sede", text: "Este es el primer paso para crear una nueva orden de venta ya que se seleccionara la Sede", image: "/images/OV/1.gif" },
                        { title: "Seleccion de Cliente", text: "Tutorial de como capturar un cliente en el sistema SIGO", video: "/images/OV/Captura_Cliente.mp4" }
                    ]
                },
                { id: "Proceso de Captura", title: "Proceso de Captura de Productos", icon: "fa-file-lines", steps: [{ title: "Productos de Orden de Venta", text: "Tutorial de como capturar un producto correctamente", video: "/images/OV/Productos.mp4" }] },
                {
                    id: "Subir la Orden de Venta", title: "Subir la Orden de Venta", icon: "fa-file-lines", steps: [
                        { title: "Guardar la Orden de Venta", text: "El ultimo paso para Guardar nuestra orden de venta (ambas opciones son validas)", image: "/images/OV/Save.gif" },
                        { title: "Guardar la Orden de Venta", text: "El ultimo paso para Guardar nuestra orden de venta (ambas opciones son validas)", image: "/images/OV/Guardar_2.gif" }
                    ]
                },
                { id: "Reportes", title: "Reporteadores", icon: "fa-file-lines", steps: [{ title: "Donde ver el pedido", text: "Donde dirigirse para ver los reportes", image: "/images/OV/Reportes.gif" }] }
            ]
        };
    </script>

    <script>
        /* ============================================================
           AVANCE DEL FLUJO: los números 1-4 se ponen en verde al completarse.
        ============================================================ */
        (function () {
            let raf = null;
            const hasValue = sel => !!String(document.querySelector(sel)?.value || "").trim();
            function setDone(id, ok) { document.getElementById(id)?.classList.toggle("is-done", !!ok); }

            function refresh() {
                const cliente = hasValue("#clienteHidden");
                setDone("ovStepCliente", cliente);
                setDone("ovStepEntrega", hasValue("#Serie") && hasValue("#FechaEntrega") && hasValue("#rutaSelect"));
                const productos = typeof contarProductosValidos === "function" && contarProductosValidos() > 0;
                setDone("ovStepProductos", productos);
                setDone("ovStepGuardar", productos && cliente && hasValue("#FechaEntrega") && hasValue("#Presentacion"));
            }
            function schedule() { if (raf) return; raf = requestAnimationFrame(() => { raf = null; refresh(); }); }

            document.addEventListener("input", schedule, true);
            document.addEventListener("change", schedule, true);
            document.addEventListener("DOMContentLoaded", refresh);
        })();
    </script>

    <script>
        /* ============================================================
           TIPO DE ENTREGA + FOLIO DE TRANSPORTE / LOGÍSTICA (sin cambios de regla)
           1) MATRIZ y no muestra: se pide el tipo de entrega.
           2) TRANSPORTE: exige folio y valida capacidad.
           3) CLIENTE_RECOGE / RECOGE_SITIO: no exige folio.
           4) El controller debe repetir la misma regla al guardar.
        ============================================================ */
        (function () {
            if (window.__ovLogisticaFolioInit) return;
            window.__ovLogisticaFolioInit = true;

            const $tipoEntrega = $("#TipoEntregaLogistica");
            const $bloqueTipoEntrega = $("#bloqueTipoEntregaLogistica");
            const $tipoHelp = $("#tipoEntregaLogisticaHelp");
            const $folio = $("#LogisticaFolioId");
            const $help = $("#logisticaFolioHelp");
            const $bloque = $("#bloqueFolioLogistica");
            const $capacidad = $("#logisticaCapacidadResumen");

            // Mantener el mismo valor en GuardarPedido del ComercialController.
            const TOLERANCIA_CARGA_KG = 0;

            if (!$folio.length || !$tipoEntrega.length) return;

            let folioRequestToken = 0;
            const fmtKg = v => Number(v || 0).toLocaleString("es-MX", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            const obtenerTipoEntregaLogistica = () => ($tipoEntrega.val() || "TRANSPORTE").toString().trim().toUpperCase();
            const esEntregaConTransporte = () => obtenerTipoEntregaLogistica() === "TRANSPORTE";
            const aplicaControlLogistica = () => (typeof esSerieMatriz === "function" && esSerieMatriz()) && !(typeof esOrdenMuestra === "function" && esOrdenMuestra());
            const requiereFolioLogistica = () => aplicaControlLogistica() && esEntregaConTransporte();
            window.requiereFolioLogistica = requiereFolioLogistica;

            function limpiarFolioLogistica() {
                folioRequestToken++;
                $folio.val("");
                $folio.prop("disabled", false);
                $capacidad.removeClass("is-visible is-warning is-danger").text("");
            }

            function obtenerTotalPesoCapturadoKg() {
                let total = 0;
                $("#productosBody tr").each(function () {
                    const peso = parseFloat($(this).find(".peso").val()) || 0;
                    if (peso > 0) total += peso;
                });
                return total;
            }

            function obtenerCargaFolioSeleccionadoKg() {
                const option = $folio[0]?.selectedOptions?.[0];
                return (!option || !option.value) ? 0 : Number(option.dataset.cargaKg || 0);
            }

            window.actualizarEstadoCargaLogistica = function () {
                if (!$capacidad.length) return;
                const ocultar = () => $capacidad.removeClass("is-visible is-warning is-danger").text("");
                if (!requiereFolioLogistica()) return ocultar();

                const folioId = ($folio.val() || "").toString().trim();
                const cargaKg = obtenerCargaFolioSeleccionadoKg();
                if (!folioId || cargaKg <= 0) return ocultar();

                const totalKg = obtenerTotalPesoCapturadoKg();
                const maximoKg = cargaKg + TOLERANCIA_CARGA_KG;
                const restanteKg = maximoKg - totalKg;

                $capacidad.addClass("is-visible").removeClass("is-warning is-danger");
                if (totalKg > maximoKg + 0.001) $capacidad.addClass("is-danger");
                else if (restanteKg <= TOLERANCIA_CARGA_KG) $capacidad.addClass("is-warning");

                $capacidad.text(
                    `Carga reservada: ${fmtKg(cargaKg)} kg · Tolerancia: +${fmtKg(TOLERANCIA_CARGA_KG)} kg · ` +
                    `Máximo: ${fmtKg(maximoKg)} kg · Esta OV: ${fmtKg(totalKg)} kg · ` +
                    (restanteKg >= 0 ? `Quedan ${fmtKg(restanteKg)} kg` : `EXCESO: ${fmtKg(Math.abs(restanteKg))} kg`)
                );
            };

            window.validarLimiteCargaLogistica = function (mostrarMensaje = true) {
                if (!requiereFolioLogistica()) return true;
                const folioId = ($folio.val() || "").toString().trim();
                if (!folioId) return true;
                const cargaKg = obtenerCargaFolioSeleccionadoKg();
                if (cargaKg <= 0) return true;

                const totalKg = obtenerTotalPesoCapturadoKg();
                const maximoKg = cargaKg + TOLERANCIA_CARGA_KG;
                window.actualizarEstadoCargaLogistica();
                if (totalKg <= maximoKg + 0.001) return true;

                if (mostrarMensaje) {
                    alert(
                        "No puedes guardar la orden porque excede la capacidad del transporte.\n\n" +
                        `Carga reservada: ${fmtKg(cargaKg)} kg\nTolerancia: +${fmtKg(TOLERANCIA_CARGA_KG)} kg\n` +
                        `Máximo permitido: ${fmtKg(maximoKg)} kg\nPeso de la OV: ${fmtKg(totalKg)} kg\nExceso: ${fmtKg(totalKg - maximoKg)} kg\n\n` +
                        "Reduce los kilos o selecciona un folio con mayor capacidad."
                    );
                }
                return false;
            };

            function actualizarVisibilidadFolioLogistica() {
                const aplica = aplicaControlLogistica();
                $bloqueTipoEntrega.toggle(aplica);

                if (!aplica) {
                    $tipoEntrega.val("TRANSPORTE");
                    $bloque.hide();
                    limpiarFolioLogistica();
                    return false;
                }

                const requerido = requiereFolioLogistica();
                $bloque.toggle(requerido);

                if (!requerido) {
                    limpiarFolioLogistica();
                    $tipoHelp.text(obtenerTipoEntregaLogistica() === "CLIENTE_RECOGE"
                        ? "El cliente recogerá el pedido. No se requiere folio de transporte."
                        : "Pedido local / recoge en sitio. No se requiere folio de transporte.");
                    $help.text("No aplica folio de transporte para este tipo de entrega.");
                } else {
                    $tipoHelp.text("Pedido foráneo con transporte: liga un folio de logística antes de guardar.");
                    $help.text("Selecciona fecha y cliente para consultar las reservas del vendedor.");
                }
                return requerido;
            }

            function folioOptionText(x) {
                const disponible = Number(x.kgDisponible ?? x.cargaKg ?? 0);
                const cargado = Number(x.kgCargados ?? 0);
                const maximo = Number(x.capacidadMaximaKg ?? 0);
                const transporte = (x.tipoTransporte || "TRANSPORTE").toString();
                return `${x.folio} | ${transporte} | Cargado: ${fmtKg(cargado)} kg | Disponible: ${fmtKg(disponible)} kg | Máx: ${fmtKg(maximo)} kg`;
            }

            window.cargarFoliosLogisticaDisponibles = async function () {
                const requerido = actualizarVisibilidadFolioLogistica();
                if (!requerido) return;

                const myToken = ++folioRequestToken;
                const fecha = ($("#FechaEntrega").val() || "").trim();
                const vendedorId = ($("#VendedorId").val() || "").toString().trim();
                const valorAnterior = ($folio.val() || "").toString().trim();

                $folio.empty();
                if (!fecha || !vendedorId) {
                    $folio.append('<option value="">Selecciona primero fecha y cliente…</option>');
                    $help.text("Selecciona fecha y cliente para consultar las reservas del vendedor.");
                    return;
                }

                $folio.prop("disabled", true).append('<option value="">Buscando folios disponibles…</option>');
                $help.text("Consultando reservas de transporte…");

                try {
                    const url = `/Comercial/FoliosLogisticaDisponibles?fechaEmbarque=${encodeURIComponent(fecha)}&vendedorId=${encodeURIComponent(vendedorId)}`;
                    const response = await fetch(url, { method: "GET", headers: { "Accept": "application/json" } });
                    if (!response.ok) throw new Error(`HTTP ${response.status}`);
                    const data = await response.json();
                    if (myToken !== folioRequestToken) return;

                    const lista = Array.isArray(data) ? data : [];
                    $folio.empty();

                    if (!lista.length) {
                        $folio.append('<option value="">No hay folios disponibles para esta fecha</option>');
                        $help.text("Primero genera la solicitud de transporte en Planeación de Logística.");
                        return;
                    }

                    $folio.append('<option value="">Selecciona un folio…</option>');
                    lista.forEach(x => {
                        const option = document.createElement("option");
                        option.value = x.id;
                        option.textContent = folioOptionText(x);
                        option.dataset.folio = x.folio || "";
                        option.dataset.cargaKg = x.cargaKg || 0;
                        $folio.append(option);
                    });

                    if (valorAnterior && $folio.find(`option[value="${CSS.escape(valorAnterior)}"]`).length) $folio.val(valorAnterior);
                    $help.text(`${lista.length} folio(s) disponible(s) para ${fecha}.`);
                    window.actualizarEstadoCargaLogistica();
                } catch (error) {
                    console.error("Error consultando folios de logística:", error);
                    if (myToken !== folioRequestToken) return;
                    $folio.empty().append('<option value="">Error consultando folios</option>');
                    $help.text("No se pudieron consultar los folios de logística. Cambia la fecha o vuelve a seleccionar el cliente para reintentar.");
                } finally {
                    if (myToken === folioRequestToken) $folio.prop("disabled", false);
                }
            };

            $(document).on("change.ovLogisticaFolio", "#FechaEntrega, #Serie, #chkEsMuestra, #TipoEntregaLogistica", function () {
                window.cargarFoliosLogisticaDisponibles();
            });
            $(document).on("change.ovLogisticaFolioVendedor", "#VendedorId", function () { window.cargarFoliosLogisticaDisponibles(); });
            $(document).on("change.ovLogisticaCapacidad", "#LogisticaFolioId", function () { window.actualizarEstadoCargaLogistica(); });

            // Segunda barrera visual. El controller debe validar nuevamente.
            $(document).on("submit.ovLogisticaFolio", "#formOV", function (e) {
                if (!requiereFolioLogistica()) return true;
                const folioId = ($folio.val() || "").toString().trim();
                if (!folioId) {
                    e.preventDefault();
                    e.stopImmediatePropagation();
                    alert("Para una entrega con transporte selecciona el folio de transporte reservado para esta fecha.");
                    try { $folio.trigger("focus"); } catch (_) { }
                    return false;
                }
                if (!window.validarLimiteCargaLogistica(true)) {
                    e.preventDefault();
                    e.stopImmediatePropagation();
                    return false;
                }
                return true;
            });

            $(function () {
                actualizarVisibilidadFolioLogistica();
                if (requiereFolioLogistica()) window.cargarFoliosLogisticaDisponibles();
                window.actualizarEstadoCargaLogistica();
            });
        })();
    </script>

    <script>
        /* ============================================================
           BLOQUEO ANTI-DOBLE ENVÍO
           Se registra al final: solo actúa si ninguna validación anterior
           detuvo el envío. Evita órdenes duplicadas por doble clic o
           por presionar Guardar mientras el servidor responde.
           No deshabilita campos (los campos deshabilitados no se envían).
        ============================================================ */
        $(document).on("submit.ovAntiDoble", "#formOV", function (e) {
            if (e.isDefaultPrevented()) return;
            if (window.__ovGuardando) { e.preventDefault(); return false; }
            window.__ovGuardando = true;
            document.querySelectorAll("button[type='submit'][form='formOV'], #formOV button[type='submit'], #btnConfirmarGuardar")
                .forEach(b => { b.disabled = true; });
            setLoading(true, "Guardando la orden… no cierres ni recargues la página.");
        });
        // Si el navegador regresa a la página desde caché (botón Atrás), se libera el bloqueo.
        window.addEventListener("pageshow", function (ev) {
            if (!ev.persisted) return;
            window.__ovGuardando = false;
            setLoading(false);
            document.querySelectorAll("button[type='submit']").forEach(b => { b.disabled = false; });
        });
    </script>
}
