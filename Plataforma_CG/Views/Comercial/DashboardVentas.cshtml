@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Dashboard de ventas";
}

@* Vista autocontenida: ya no usa dashboard-ventas.css (ni sus 3 hojas de ajuste) ni dashboard-ventas.js.
   Los mismos 6 endpoints, la misma lógica de filtros y la selección cruzada viven aquí. *@

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    /* =====================================================================
           DASHBOARD DE VENTAS · SIGO — hoja de estilos única
           ===================================================================== */
    #dashboardVentasApp {
        --es-tinto: #8d3e46;
        --es-tinto-deep: #5c2229;
        --es-tinto-soft: #f7eced;
        --es-tinto-line: #e8d3d6;
        --es-tinto-bar: #e4c6ca;
        --es-paper: #f6f4f4;
        --es-surface: #ffffff;
        --es-field: #ffffff;
        --es-head: #faf7f7;
        --es-hover: #fcf9f9;
        --es-row-line: #f0eaeb;
        --es-ink: #231a1c;
        --es-muted: #76686b;
        --es-line: #e6dfe0;
        --es-line-strong: #cfc4c6;
        --es-grid: #eee8e9;
        --es-ok: #2f7a55;
        --es-ok-bg: #e7f3ec;
        --es-warn: #b07614;
        --es-warn-bg: #fbf1de;
        --es-bad: #b42d2d;
        --es-bad-bg: #fbe9e8;
        --es-info: #2f5d86;
        --es-teal: #2b7a72;
        --es-gold: #c08a2e;
        --es-line-dark: #3b3236;
        --es-font: "Poppins", "Segoe UI", system-ui, -apple-system, Arial, sans-serif;
        font-family: var(--es-font);
        color: var(--es-ink);
        font-size: 13px;
        line-height: 1.4;
        background: var(--es-paper);
        padding: 14px 16px 12px;
        min-width: 0;
        max-width: 100%;
        overflow-x: hidden;
    }

    body[data-theme="dark"] #dashboardVentasApp {
        --es-tinto: #c56b74;
        --es-tinto-deep: #7a2d36;
        --es-tinto-soft: #3a2427;
        --es-tinto-line: #5a3439;
        --es-tinto-bar: #5a3439;
        --es-paper: #16181c;
        --es-surface: #202328;
        --es-field: #181a1e;
        --es-head: #262a30;
        --es-hover: #2a2e34;
        --es-row-line: #30343b;
        --es-ink: #edf0f3;
        --es-muted: #a9b0b9;
        --es-line: #363b43;
        --es-line-strong: #4a5059;
        --es-grid: #2e3238;
        --es-ok: #6cc596;
        --es-ok-bg: #1d3328;
        --es-warn: #e0b061;
        --es-warn-bg: #3a2f1b;
        --es-bad: #f08a83;
        --es-bad-bg: #3d2223;
        --es-info: #8bb8e0;
        --es-teal: #6cc5ba;
        --es-gold: #e0b061;
        --es-line-dark: #d9d2d4;
    }

    #dashboardVentasApp *, #dashboardVentasApp *::before, #dashboardVentasApp *::after {
        box-sizing: border-box;
    }

    #dashboardVentasApp .bi, .dvx-ms-menu .bi {
        font-family: "bootstrap-icons" !important;
    }

    .dvx-app-shell {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .dvx-positive {
        color: var(--es-ok) !important;
    }

    .dvx-negative {
        color: var(--es-bad) !important;
    }

    .dvx-warning {
        color: var(--es-warn) !important;
    }

    /* ---------- Encabezado ---------- */
    .dvx-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        flex-wrap: wrap;
    }

    .dvx-brand {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .dvx-brand-icon {
        width: 40px;
        height: 40px;
        flex: none;
        border-radius: 10px;
        background: var(--es-tinto);
        display: flex;
        align-items: flex-end;
        justify-content: center;
        gap: 3px;
        padding: 9px;
    }

        .dvx-brand-icon span {
            width: 5px;
            border-radius: 2px;
            background: #fff;
        }

            .dvx-brand-icon span:nth-child(1) {
                height: 9px;
                opacity: .7;
            }

            .dvx-brand-icon span:nth-child(2) {
                height: 15px;
                opacity: .85;
            }

            .dvx-brand-icon span:nth-child(3) {
                height: 21px;
            }

    .dvx-brand h1 {
        margin: 0;
        font-size: 20px;
        font-weight: 700;
        letter-spacing: -.01em;
        line-height: 1.15;
        color: var(--es-ink);
    }

    .dvx-brand p {
        margin: 2px 0 0;
        font-size: 12px;
        color: var(--es-muted);
    }

    .dvx-last-update {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 12px;
        border-radius: 999px;
        background: var(--es-surface);
        border: 1px solid var(--es-line);
        font-size: 12px;
        color: var(--es-muted);
    }

        .dvx-last-update strong {
            color: var(--es-ink);
        }

        .dvx-last-update .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: var(--es-ok);
        }

    #dashboardVentasApp.dvx-loading .dvx-last-update .dot {
        background: var(--es-warn);
        animation: dvx-pulse 1s ease-in-out infinite;
    }

    @@keyframes dvx-pulse {
        50% {
            opacity: .3;
        }
    }

    /* ---------- Filtros generales ---------- */
    .dvx-filters-row {
        display: grid;
        grid-template-columns: minmax(340px, 1.1fr) minmax(360px, 1.3fr) auto;
        gap: 10px;
        align-items: stretch;
    }

    .dvx-filter-card {
        padding: 10px 14px;
        border-radius: 10px;
        background: var(--es-surface);
        border: 1px solid var(--es-line);
        min-width: 0;
    }

    .dvx-filter-title {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 6px;
        font-size: 11.5px;
        font-weight: 600;
        color: var(--es-muted);
    }

        .dvx-filter-title i {
            color: var(--es-tinto);
        }

    .dvx-date-grid {
        display: grid;
        grid-template-columns: .8fr 1.3fr .8fr;
        gap: 10px;
    }

        .dvx-date-grid label {
            margin: 0;
        }

            .dvx-date-grid label span {
                display: block;
                margin-bottom: 4px;
                font-size: 11px;
                font-weight: 600;
                color: var(--es-muted);
            }

        .dvx-date-grid select {
            width: 100%;
            height: 36px;
            padding: 0 10px;
            border: 1px solid var(--es-line-strong);
            border-radius: 7px;
            background-color: var(--es-field);
            color: var(--es-ink);
            font: 600 13px var(--es-font);
            outline: none;
        }

            .dvx-date-grid select:focus {
                border-color: var(--es-tinto);
                box-shadow: 0 0 0 3px rgba(141,62,70,.16);
            }

    body[data-theme="dark"] .dvx-date-grid select {
        color-scheme: dark;
    }

    .dvx-segmented-control {
        display: flex;
        gap: 4px;
        padding: 4px;
        border-radius: 9px;
        background: var(--es-paper);
        border: 1px solid var(--es-line);
    }

    .dvx-segment {
        flex: 1 1 0;
        min-height: 38px;
        padding: 4px 10px;
        border: 0;
        border-radius: 7px;
        background: transparent;
        color: var(--es-muted);
        font: 600 12.5px/1.2 var(--es-font);
        cursor: pointer;
        transition: background .15s, color .15s;
    }

        .dvx-segment small {
            display: block;
            font-weight: 500;
            font-size: 10.5px;
            opacity: .85;
        }

        .dvx-segment:hover {
            color: var(--es-ink);
            background: var(--es-surface);
        }

        .dvx-segment.dvx-active {
            background: var(--es-tinto);
            color: #fff;
            box-shadow: 0 2px 6px rgba(141,62,70,.25);
        }

    .dvx-reset-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 0 18px;
        border: 1px solid var(--es-line-strong);
        border-radius: 10px;
        background: var(--es-surface);
        color: var(--es-ink);
        font: 600 12.5px var(--es-font);
        cursor: pointer;
    }

        .dvx-reset-btn:hover {
            background: var(--es-tinto-soft);
            border-color: var(--es-tinto-line);
        }

        .dvx-reset-btn i {
            color: var(--es-tinto);
        }

    /* ---------- Selección cruzada y errores ---------- */
    .dvx-cross-filter-bar {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        padding: 8px 12px;
        border-radius: 10px;
        background: var(--es-tinto-soft);
        border: 1px solid var(--es-tinto-line);
        font-size: 12px;
    }

        .dvx-cross-filter-bar[hidden] {
            display: none;
        }

    .dvx-cross-filter-title {
        font-weight: 700;
        color: var(--es-tinto);
    }

    #activeFilterChips {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
        min-width: 0;
    }

    .dvx-filter-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        min-height: 26px;
        padding: 3px 10px;
        border: 1px solid var(--es-tinto-line);
        border-radius: 999px;
        background: var(--es-surface);
        color: var(--es-tinto);
        font: 600 11.5px var(--es-font);
        cursor: pointer;
    }

        .dvx-filter-chip:hover {
            background: var(--es-tinto);
            color: #fff;
        }

    .dvx-filter-chip-x {
        font-size: 14px;
        line-height: 1;
    }

    .dvx-cross-help {
        color: var(--es-muted);
        font-size: 11px;
    }

    .dvx-cross-clear {
        margin-left: auto;
        border: 0;
        background: transparent;
        color: var(--es-tinto);
        font: 600 12px var(--es-font);
        text-decoration: underline;
        cursor: pointer;
    }

    .dvx-dashboard-error {
        padding: 10px 14px;
        border-radius: 10px;
        background: var(--es-bad-bg);
        color: var(--es-bad);
        border: 1px solid var(--es-bad);
        font-size: 12.5px;
    }

        .dvx-dashboard-error[hidden] {
            display: none;
        }

    /* ---------- Indicadores ---------- */
    .dvx-kpi-grid {
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 10px;
    }

    .dvx-kpi {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 1px;
        padding: 10px 14px 10px 52px;
        border-radius: 10px;
        background: var(--es-surface);
        border: 1px solid var(--es-line);
        border-top: 3px solid var(--k);
        min-width: 0;
    }

        .dvx-kpi .kpi-ico {
            position: absolute;
            left: 12px;
            top: 12px;
            width: 30px;
            height: 30px;
            border-radius: 8px;
            display: grid;
            place-items: center;
            font-size: 15px;
            color: var(--k);
            background: color-mix(in srgb, var(--k) 13%, transparent);
        }

        .dvx-kpi:nth-child(1) {
            --k: var(--es-muted);
        }

        .dvx-kpi:nth-child(2) {
            --k: var(--es-ok);
        }

        .dvx-kpi:nth-child(3) {
            --k: var(--es-tinto);
        }

        .dvx-kpi:nth-child(4) {
            --k: var(--es-info);
        }

        .dvx-kpi:nth-child(5) {
            --k: var(--es-gold);
        }

        .dvx-kpi:nth-child(6) {
            --k: var(--es-teal);
        }

    .dvx-kpi-label {
        font-size: 11.5px;
        font-weight: 600;
        color: var(--es-muted);
        line-height: 1.25;
    }

        .dvx-kpi-label small, .dvx-kpi-label br {
            font-weight: 500;
            font-size: 10.5px;
        }

    .dvx-kpi strong {
        font-size: clamp(18px, 1.55vw, 24px);
        font-weight: 700;
        letter-spacing: -.01em;
        line-height: 1.2;
        color: var(--es-ink);
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }

        .dvx-kpi strong small {
            font-size: .55em;
            font-weight: 600;
            color: var(--es-muted);
        }

    .dvx-kpi-unit, .dvx-kpi-help, .dvx-kpi-delta {
        font-size: 11px;
        font-weight: 500;
        color: var(--es-muted);
    }

    .dvx-kpi-delta {
        font-weight: 700;
    }

    .dvx-kpi-bar {
        height: 5px;
        margin-top: 5px;
        border-radius: 999px;
        background: var(--es-paper);
        overflow: hidden;
    }

        .dvx-kpi-bar span {
            display: block;
            height: 100%;
            border-radius: 999px;
            background: var(--k);
            transition: width .5s ease;
        }

    /* ---------- Paneles ---------- */
    .dvx-dashboard-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 12px;
    }

    .dvx-panel {
        display: flex;
        flex-direction: column;
        min-width: 0;
        border-radius: 12px;
        background: var(--es-surface);
        border: 1px solid var(--es-line);
        overflow: hidden;
    }

    .dvx-panel-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
        padding: 12px 14px 10px;
        border-bottom: 1px solid var(--es-line);
    }

        .dvx-panel-head h2 {
            display: flex;
            align-items: center;
            gap: 8px;
            margin: 0;
            padding-top: 3px;
            font-size: 14px;
            font-weight: 700;
            color: var(--es-ink);
        }

            .dvx-panel-head h2 .num {
                flex: none;
                width: 24px;
                height: 24px;
                border-radius: 7px;
                display: grid;
                place-items: center;
                background: var(--es-tinto);
                color: #fff;
                font-size: 12px;
            }

    .dvx-mini-filter-group {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .dvx-mini-filter {
        display: flex;
        flex-direction: column;
        gap: 3px;
        width: 190px;
        min-width: 0;
    }

        .dvx-mini-filter > span {
            font-size: 10.5px;
            font-weight: 600;
            color: var(--es-muted);
        }

    .dvx-panel-body {
        position: relative;
        flex: 1;
        padding: 10px 14px 12px;
    }

    .dvx-panel-note, .dvx-footnote {
        margin: 0 0 8px;
        font-size: 11.5px;
        line-height: 1.4;
        color: var(--es-muted);
    }

    .dvx-footnote {
        margin: 8px 0 0;
        font-size: 11px;
    }

    .dvx-legend {
        display: flex;
        gap: 6px 16px;
        flex-wrap: wrap;
        margin-bottom: 8px;
        font-size: 11.5px;
        color: var(--es-muted);
    }

        .dvx-legend span {
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

    .lg-box {
        width: 12px;
        height: 10px;
        border-radius: 3px;
        display: inline-block;
    }

    .lg-line {
        width: 18px;
        height: 3px;
        border-radius: 2px;
        display: inline-block;
        position: relative;
    }

        .lg-line.dot::after {
            content: "";
            position: absolute;
            left: 5px;
            top: -3px;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: inherit;
        }

    .lg-dash {
        width: 18px;
        border-top: 2px dashed;
        display: inline-block;
    }

    .dvx-price-average {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 8px;
        padding: 5px 12px;
        border-radius: 999px;
        background: var(--es-tinto-soft);
        border: 1px solid var(--es-tinto-line);
        color: var(--es-tinto);
        font-size: 12.5px;
        font-weight: 700;
    }

    .dvx-chart-area {
        position: relative;
        width: 100%;
        min-height: 250px;
    }

        .dvx-chart-area svg {
            display: block;
            width: 100%;
            height: auto;
            overflow: visible;
            font-family: var(--es-font);
        }

    .dvx-empty {
        min-height: 250px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 6px;
        color: var(--es-muted);
        font-size: 12px;
        text-align: center;
        padding: 20px;
    }

        .dvx-empty i {
            font-size: 26px;
            color: var(--es-line-strong);
        }

    #dashboardVentasApp.dvx-loading .dvx-chart-area {
        opacity: .45;
        transition: opacity .2s;
    }

    #dashboardVentasApp.dvx-loading .dvx-kpi strong {
        opacity: .5;
    }

    /* SVG de las gráficas */
    .ch-grid {
        stroke: var(--es-grid);
        stroke-width: 1;
    }

    .ch-axis {
        stroke: var(--es-line-strong);
        stroke-width: 1;
    }

    .ch-tick {
        fill: var(--es-muted);
        font-size: 10px;
        font-variant-numeric: tabular-nums;
    }

    .ch-title {
        fill: var(--es-muted);
        font-size: 10px;
        font-weight: 600;
    }

    .ch-label {
        fill: var(--es-ink);
        font-size: 10.5px;
        font-weight: 600;
    }

    .ch-value {
        fill: var(--es-ink);
        font-size: 10px;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
    }

        .ch-value.muted {
            fill: var(--es-muted);
            font-weight: 600;
        }

    .ch-pct-ok {
        fill: var(--es-ok);
    }

    .ch-pct-warn {
        fill: var(--es-warn);
    }

    .ch-pct-bad {
        fill: var(--es-bad);
    }

    .ch-hit {
        cursor: pointer;
    }

        .ch-hit:hover .ch-bar, .ch-hit:focus .ch-bar {
            filter: brightness(.92);
        }

        .ch-hit.is-dim {
            opacity: .35;
        }

        .ch-hit.is-sel .ch-bar {
            stroke: var(--es-tinto);
            stroke-width: 2;
        }

        .ch-hit:focus {
            outline: none;
        }

        .ch-hit:focus-visible .ch-bar {
            stroke: var(--es-ink);
            stroke-width: 2;
        }

    /* Gráfica 2: barras horizontales */
    .vd-table {
        display: grid;
        grid-template-columns: minmax(120px, 190px) minmax(0, 1fr) 82px 82px;
        align-items: center;
        column-gap: 12px;
        row-gap: 2px;
        font-size: 12px;
    }

    .vd-head {
        padding-bottom: 6px;
        font-size: 10.5px;
        font-weight: 600;
        color: var(--es-muted);
        text-align: right;
        border-bottom: 1px solid var(--es-line);
    }

        .vd-head:nth-child(1), .vd-head:nth-child(2) {
            text-align: left;
        }

    .vd-row {
        display: contents;
    }

        .vd-row > * {
            padding: 6px 0;
            border-bottom: 1px solid var(--es-row-line);
            cursor: pointer;
        }

        .vd-row:hover > * {
            background: var(--es-hover);
        }

        .vd-row.is-sel > * {
            background: var(--es-tinto-soft);
        }

        .vd-row.is-dim > * {
            opacity: .4;
        }

    .vd-name {
        font-weight: 600;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        padding-left: 6px !important;
    }

    .vd-track {
        position: relative;
        height: 30px;
    }

    .vd-ref {
        position: absolute;
        left: 0;
        top: 7px;
        height: 16px;
        border-radius: 4px;
        background: var(--es-tinto-bar);
    }

    .vd-sales {
        position: absolute;
        left: 0;
        top: 10px;
        height: 10px;
        border-radius: 3px;
        background: var(--es-tinto);
        transition: width .5s ease;
    }

    .vd-pct {
        position: absolute;
        top: 50%;
        transform: translate(6px, -50%);
        padding: 1px 7px;
        border-radius: 999px;
        font-size: 10.5px;
        font-weight: 700;
        white-space: nowrap;
        background: var(--es-surface);
        border: 1px solid currentColor;
    }

    .vd-num {
        text-align: right;
        font-variant-numeric: tabular-nums;
        padding-right: 6px !important;
    }

        .vd-num.sales {
            font-weight: 700;
        }

    /* ---------- Selector múltiple con búsqueda (lo crea el script) ---------- */
    .dvx-multi-host {
        width: 100%;
        min-width: 0;
    }

    .dvx-ms {
        position: relative;
        width: 100%;
        font-size: 12px;
    }

    .dvx-ms-toggle {
        width: 100%;
        height: 32px;
        padding: 0 9px 0 10px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        border: 1px solid var(--es-line-strong);
        border-radius: 7px;
        background: var(--es-field);
        color: var(--es-ink);
