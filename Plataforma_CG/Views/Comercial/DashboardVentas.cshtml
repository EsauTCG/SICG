<script>
    window.dashboardVentasConfig = {
        catalogosUrl: '@Url.Content("~/Comercial/DashboardVentasCatalogos")',
        resumenUrl: '@Url.Content("~/Comercial/DashboardVentasResumen")',
        masterUrl: '@Url.Content("~/Comercial/DashboardVentasMaster")',
        vendedorUrl: '@Url.Content("~/Comercial/DashboardVentasVendedor")',
        preciosUrl: '@Url.Content("~/Comercial/DashboardVentasPrecios")',
        tendenciaUrl: '@Url.Content("~/Comercial/DashboardVentasTendencia")'
    };
</script>

<script>
    (() => {
        "use strict";

        const root = document.getElementById("dashboardVentasApp");
        const cfg = window.dashboardVentasConfig || {};
        if (!root) return;

        const today = new Date();
        const months = ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"];

        const state = {
            year: today.getFullYear(), month: today.getMonth() + 1, day: today.getDate(), compareMode: "budget",
            masterVendor: [], vendorMaster: [], vendorSku: [], priceMaster: [], priceSku: [], trendMaster: [], trendSku: []
        };
        let catalogs = { anios: [], masters: [], skus: [], vendedores: [], ultimaFechaVenta: null };
        let refreshToken = 0, refreshTimer = null, initialized = false;

        const $ = id => document.getElementById(id);
        const nf = new Intl.NumberFormat("es-MX", { maximumFractionDigits: 0 });
        const nf1 = new Intl.NumberFormat("es-MX", { minimumFractionDigits: 0, maximumFractionDigits: 1 });
        const nf2 = new Intl.NumberFormat("es-MX", { minimumFractionDigits: 0, maximumFractionDigits: 2 });
        const money = new Intl.NumberFormat("es-MX", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        const esc = v => String(v ?? "").replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;").replaceAll('"', "&quot;").replaceAll("'", "&#39;");
        const norm = v => String(v ?? "").trim().toUpperCase();
        const csv = v => (Array.isArray(v) ? v : []).join(",");
        const corto = (s, n) => { s = String(s ?? ""); return s.length > n ? s.slice(0, n - 1) + "…" : s; };
        const pctClass = p => p >= 100 ? "ok" : p >= 80 ? "warn" : "bad";
        const fila = (l, v) => `<div class='row'><span>${l}</span><b>${v}</b></div>`;
        const tipAttr = html => `data-tip="${esc(html)}"`;

        if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", init, { once: true }); else init();

        async function init() {
            if (initialized) return;
            initialized = true;
            try {
                setLoading(true);
                catalogs = await getJson(cfg.catalogosUrl);
                const ultima = parseDateOnly(catalogs.ultimaFechaVenta);
                const years = aniosDisponibles();
                // Abre en la última fecha con surtido validado para no mostrar ceros de un mes sin movimientos.
                if (ultima) { state.year = ultima.year; state.month = ultima.month; state.day = ultima.day; }
                else if (!years.includes(state.year)) state.year = years[0] || today.getFullYear();
                buildCatalogs();
                bindEvents();
                renderActiveFilters();
                await refreshAll();
            } catch (err) { showError(err); }
            finally { setLoading(false); }
        }

        const aniosDisponibles = () => Array.from(new Set((catalogs.anios || []).map(Number).filter(Boolean))).sort((a, b) => b - a);

        /* ========================= Filtros de fecha ========================= */
        function rebuildDateSelects() {
            const years = aniosDisponibles();
            if (!years.includes(state.year)) years.unshift(state.year);
            // NUEVO: selector de año (antes el mes solo podía consultarse para el año de la última venta)
            fillSelect($("yearSelect"), years.sort((a, b) => b - a).map(y => ({ value: y, label: y })), state.year);
            fillSelect($("monthSelect"), months.map((m, i) => ({ value: i + 1, label: m })), state.month);
            rebuildDays();
        }
        function rebuildDays() {
            const max = new Date(state.year, state.month, 0).getDate();
            state.day = Math.min(Math.max(state.day, 1), max);
            fillSelect($("daySelect"), Array.from({ length: max }, (_, i) => ({ value: i + 1, label: i + 1 })), state.day);
        }
        function fillSelect(el, options, selected) {
            if (!el) return;
            el.innerHTML = options.map(o => `<option value="${esc(o.value)}" ${String(o.value) === String(selected) ? "selected" : ""}>${esc(o.label)}</option>`).join("");
        }

        /* ========================= Catálogos y filtros múltiples ========================= */
        function buildCatalogs() {
            rebuildDateSelects();
            const vendorOptions = (catalogs.vendedores || []).map(x => ({ value: String(x.id ?? ""), label: x.nombre || `VENDEDOR ${x.id}` })).filter(x => x.value);
            const masterOptions = (catalogs.masters || []).map(x => ({ value: String(x), label: String(x) })).filter(x => x.value);

            // Los tres filtros de máster comparten la misma selección.
            state.vendorMaster = normalizeMultiSelection(state.vendorMaster, masterOptions);
            state.priceMaster = [...state.vendorMaster];
            state.trendMaster = [...state.vendorMaster];
            // Se conservan claves de CEDIS seleccionadas desde la gráfica aunque no estén en el catálogo de vendedores
            const cedisSel = state.masterVendor.filter(v => String(v).startsWith("CEDIS|"));
            state.masterVendor = [...normalizeMultiSelection(state.masterVendor, vendorOptions), ...cedisSel];

            renderMultiSelect("masterVendorFilter", vendorOptions, state.masterVendor, values => {
                state.masterVendor = [...values, ...state.masterVendor.filter(v => String(v).startsWith("CEDIS|"))];
                renderActiveFilters();
                scheduleRefreshAll();
            });

            const onMasterChange = (sourceId, values) => {
                state.vendorMaster = [...values]; state.priceMaster = [...values]; state.trendMaster = [...values];
                syncMultiSelectGroup(["vendorMasterFilter", "priceMasterFilter", "trendMasterFilter"], values, sourceId);
                rebuildAllSkuFilters();
                renderActiveFilters();
                scheduleRefreshAll();
            };
            renderMultiSelect("vendorMasterFilter", masterOptions, state.vendorMaster, v => onMasterChange("vendorMasterFilter", v));
            renderMultiSelect("priceMasterFilter", masterOptions, state.priceMaster, v => onMasterChange("priceMasterFilter", v));
            renderMultiSelect("trendMasterFilter", masterOptions, state.trendMaster, v => onMasterChange("trendMasterFilter", v));
            rebuildAllSkuFilters();
        }

        function rebuildAllSkuFilters() {
            const masters = state.vendorMaster || [];
            const onSkuChange = (sourceId, values) => {
                state.vendorSku = [...values]; state.priceSku = [...values]; state.trendSku = [...values];
                syncMultiSelectGroup(["vendorSkuFilter", "priceSkuFilter", "trendSkuFilter"], values, sourceId);
                renderActiveFilters();
                scheduleRefreshAll();
            };
            state.vendorSku = rebuildSkuMultiSelect("vendorSkuFilter", masters, state.vendorSku || [], v => onSkuChange("vendorSkuFilter", v));
            state.priceSku = [...state.vendorSku]; state.trendSku = [...state.vendorSku];
            rebuildSkuMultiSelect("priceSkuFilter", masters, state.priceSku, v => onSkuChange("priceSkuFilter", v));
            rebuildSkuMultiSelect("trendSkuFilter", masters, state.trendSku, v => onSkuChange("trendSkuFilter", v));
        }

        function rebuildSkuMultiSelect(id, selectedMasters, selectedSkus, onChange) {
            const masterSet = new Set((selectedMasters || []).map(norm).filter(Boolean));
            const skuMap = new Map();
            (catalogs.skus || []).filter(x => masterSet.size === 0 || masterSet.has(norm(x.master))).forEach(x => {
                const sku = String(x.sku ?? "").trim(); if (!sku) return;
                const nombre = String(x.nombre ?? "").trim();
                if (!skuMap.has(sku)) skuMap.set(sku, nombre ? `${sku} - ${nombre}` : sku);
            });
            const options = Array.from(skuMap.entries()).map(([value, label]) => ({ value, label })).sort((a, b) => a.value.localeCompare(b.value, "es", { numeric: true }));
            const normalized = normalizeMultiSelection(selectedSkus, options);
            renderMultiSelect(id, options, normalized, onChange);
            return normalized;
        }

        function normalizeMultiSelection(selected, options) {
            const allowed = new Set((options || []).map(x => String(x.value)));
            return Array.from(new Set((Array.isArray(selected) ? selected : []).map(String).filter(x => allowed.has(x))));
        }

        function etiquetaSeleccion(labels) {
            return !labels.length ? "Todos" : labels.length <= 2 ? labels.join(", ") : `${labels.length} seleccionados`;
        }

        function renderMultiSelect(id, options, selected, onChange, placeholder = "Todos") {
            const host = $(id); if (!host) return;
            const safe = (options || []).map(x => ({ value: String(x.value ?? ""), label: String(x.label ?? x.value ?? "") })).filter(x => x.value !== "");
            let selectedValues = normalizeMultiSelection(selected, safe);
            const selSet = new Set(selectedValues);
            host.innerHTML = `
                <div class="dvx-ms">
                    <button type="button" class="dvx-ms-toggle" aria-haspopup="true" aria-expanded="false"><span class="dvx-ms-label"></span><span class="dvx-ms-arrow"><i class="bi bi-chevron-down"></i></span></button>
                    <div class="dvx-ms-menu" hidden>
                        <div class="dvx-ms-search-wrap"><input type="text" class="dvx-ms-search" placeholder="Buscar…" autocomplete="off" aria-label="Buscar" /></div>
                        <label class="dvx-ms-all"><input type="checkbox" class="dvx-ms-check-all" /><span>Seleccionar todo</span></label>
                        <div class="dvx-ms-options">
                            ${safe.length ? safe.map(o => `<label class="dvx-ms-option" data-search="${esc(norm(`${o.value} ${o.label}`))}"><input type="checkbox" class="dvx-ms-check" value="${esc(o.value)}" data-label="${esc(o.label)}" ${selSet.has(o.value) ? "checked" : ""} /><span class="dvx-ms-option-text">${esc(o.label)}</span></label>`).join("") : `<div class="dvx-ms-empty">Sin opciones disponibles</div>`}
                        </div>
                    </div>
                </div>`;
            const toggle = host.querySelector(".dvx-ms-toggle"), menu = host.querySelector(".dvx-ms-menu"), search = host.querySelector(".dvx-ms-search"), allCheck = host.querySelector(".dvx-ms-check-all");
            const getChecks = () => Array.from(host.querySelectorAll(".dvx-ms-check"));
            const refreshVisual = () => {
                selectedValues = getChecks().filter(x => x.checked).map(x => x.value);
                const labels = safe.filter(x => selectedValues.includes(x.value)).map(x => x.label);
                const label = host.querySelector(".dvx-ms-label");
                label.textContent = labels.length ? etiquetaSeleccion(labels) : placeholder;
                label.title = labels.join(", ");
                toggle.classList.toggle("has-value", labels.length > 0);
                const checks = getChecks();
                if (allCheck) { allCheck.checked = checks.length > 0 && checks.every(x => x.checked); allCheck.indeterminate = checks.some(x => x.checked) && !allCheck.checked; }
            };
            const emitChange = () => { refreshVisual(); Promise.resolve(onChange([...selectedValues])).catch(showError); };
            toggle.addEventListener("click", e => {
                e.preventDefault(); e.stopPropagation();
                const willOpen = menu.hidden;
                closeAllMultiSelectMenus(host);
                menu.hidden = !willOpen;
                toggle.setAttribute("aria-expanded", String(willOpen));
                if (willOpen) { positionMultiMenu(toggle, menu); setTimeout(() => search?.focus(), 0); }
            });
            search.addEventListener("input", () => { const q = norm(search.value); host.querySelectorAll(".dvx-ms-option").forEach(r => r.style.display = !q || (r.dataset.search || "").includes(q) ? "" : "none"); });
            search.addEventListener("click", e => e.stopPropagation());
            search.addEventListener("keydown", e => { e.stopPropagation(); if (e.key === "Escape") { menu.hidden = true; toggle.setAttribute("aria-expanded", "false"); toggle.focus(); } });
            // CORRECCIÓN: "Seleccionar todo" marca solo las opciones visibles cuando hay búsqueda
            allCheck.addEventListener("change", () => { getChecks().forEach(c => { if (c.closest(".dvx-ms-option").style.display !== "none") c.checked = allCheck.checked; }); emitChange(); });
            getChecks().forEach(c => c.addEventListener("change", emitChange));
            menu.addEventListener("click", e => e.stopPropagation());
            menu.addEventListener("wheel", e => e.stopPropagation(), { passive: true });
            refreshVisual();
        }

        function setMultiSelectSelection(id, values) {
            const host = $(id); if (!host) return;
            const sel = new Set((values || []).map(String));
            const checks = Array.from(host.querySelectorAll(".dvx-ms-check"));
            checks.forEach(c => c.checked = sel.has(c.value));
            const labels = checks.filter(c => c.checked).map(c => c.dataset.label || c.value);
            const label = host.querySelector(".dvx-ms-label"), toggle = host.querySelector(".dvx-ms-toggle"), all = host.querySelector(".dvx-ms-check-all");
            if (label) { label.textContent = etiquetaSeleccion(labels); label.title = labels.join(", "); }
            toggle?.classList.toggle("has-value", labels.length > 0);
            if (all) { all.checked = checks.length > 0 && checks.every(c => c.checked); all.indeterminate = checks.some(c => c.checked) && !all.checked; }
        }
        const syncMultiSelectGroup = (ids, values, exceptId = "") => ids.forEach(id => { if (id !== exceptId) setMultiSelectSelection(id, values); });
        function closeAllMultiSelectMenus(exceptHost = null) {
            root.querySelectorAll(".dvx-multi-host").forEach(host => {
                if (host === exceptHost) return;
                const m = host.querySelector(".dvx-ms-menu"); if (m) m.hidden = true;
                host.querySelector(".dvx-ms-toggle")?.setAttribute("aria-expanded", "false");
            });
        }
        function positionMultiMenu(toggle, menu) {
            const r = toggle.getBoundingClientRect(), width = Math.min(300, innerWidth - 16), h = Math.min(340, innerHeight - 16);
            menu.style.width = `${width}px`;
            menu.style.left = `${Math.max(8, Math.min(r.right - width, innerWidth - width - 8))}px`;
            let top = r.bottom + 5;
            if (top + h > innerHeight - 8) top = Math.max(8, r.top - h - 5);
            menu.style.top = `${top}px`;
        }
        const repositionOpenMenus = () => root.querySelectorAll(".dvx-multi-host").forEach(h => { const m = h.querySelector(".dvx-ms-menu"), t = h.querySelector(".dvx-ms-toggle"); if (m && t && !m.hidden) positionMultiMenu(t, m); });

        /* ========================= Eventos ========================= */
        function bindEvents() {
            $("yearSelect").addEventListener("change", e => { state.year = +e.target.value; rebuildDays(); refreshAll(); });
            $("monthSelect").addEventListener("change", e => { state.month = +e.target.value; rebuildDays(); refreshAll(); });
            $("daySelect").addEventListener("change", e => { state.day = +e.target.value; refreshAll(); });

            root.querySelectorAll(".dvx-segment").forEach(btn => btn.addEventListener("click", () => {
                if (state.compareMode === (btn.dataset.mode || "budget")) return;
                state.compareMode = btn.dataset.mode || "budget";
                marcarModo();
                // CORRECCIÓN: antes se pedían 3 consultas sueltas sin control de orden; ahora una sola actualización controlada
                refreshAll();
            }));

            $("resetFilters").addEventListener("click", () => { resetAllFilters(); refreshAll(); });
            $("clearCrossFilters")?.addEventListener("click", () => { clearDimensionFilters(); refreshAll(); });
            $("activeFilterChips")?.addEventListener("click", e => {
                const b = e.target.closest("[data-remove-filter]"); if (!b) return;
                const { type, value } = b.dataset;
                if (type === "vendor") { state.masterVendor = state.masterVendor.filter(x => x !== value); setMultiSelectSelection("masterVendorFilter", state.masterVendor); }
                if (type === "master") {
                    state.vendorMaster = state.vendorMaster.filter(x => x !== value); state.priceMaster = [...state.vendorMaster]; state.trendMaster = [...state.vendorMaster];
                    syncMultiSelectGroup(["vendorMasterFilter", "priceMasterFilter", "trendMasterFilter"], state.vendorMaster);
                    rebuildAllSkuFilters();
                }
                if (type === "sku") {
                    state.vendorSku = state.vendorSku.filter(x => x !== value); state.priceSku = [...state.vendorSku]; state.trendSku = [...state.vendorSku];
                    syncMultiSelectGroup(["vendorSkuFilter", "priceSkuFilter", "trendSkuFilter"], state.vendorSku);
                }
                renderActiveFilters();
                refreshAll();
            });

            document.addEventListener("click", e => { if (!(e.target instanceof Element && e.target.closest(".dvx-multi-host"))) closeAllMultiSelectMenus(); });
            document.addEventListener("keydown", e => { if (e.key === "Escape") closeAllMultiSelectMenus(); });
            addEventListener("resize", repositionOpenMenus);
            addEventListener("scroll", repositionOpenMenus, true);

            // Tooltips por delegación: funcionan con todo lo que se vuelve a dibujar
            root.addEventListener("mouseover", e => { const el = e.target.closest?.("[data-tip]"); if (el) mostrarTip(el, e); });
            root.addEventListener("mousemove", e => { if (e.target.closest?.("[data-tip]")) moveTooltip(e); });
            root.addEventListener("mouseout", e => { const el = e.target.closest?.("[data-tip]"); if (el && !el.contains(e.relatedTarget)) ocultarTip(); });
            root.addEventListener("focusin", e => { const el = e.target.closest?.("[data-tip]"); if (el) { const r = el.getBoundingClientRect(); mostrarTip(el, { clientX: r.left + r.width / 2, clientY: r.top }); } });
            root.addEventListener("focusout", ocultarTip);
            // Clic y teclado en elementos de las gráficas
            root.addEventListener("click", e => {
                const hit = e.target.closest?.("[data-cross-master],[data-cross-vendor],[data-cross-date]");
                if (!hit || !root.querySelector(".dvx-dashboard-grid").contains(hit)) return;
                activarCruce(hit, e);
            });
            root.addEventListener("keydown", e => {
                if (e.key !== "Enter" && e.key !== " ") return;
                const hit = e.target.closest?.("[data-cross-master],[data-cross-vendor],[data-cross-date]");
                if (hit) { e.preventDefault(); activarCruce(hit, e); }
            });
        }
        function activarCruce(hit, e) {
            ocultarTip();
            if (hit.dataset.crossMaster) selectCrossValue("master", hit.dataset.crossMaster, e);
            else if (hit.dataset.crossVendor) selectCrossValue("vendor", hit.dataset.crossVendor, e);
            else if (hit.dataset.crossDate) selectCrossDate(hit.dataset.crossDate);
        }
        function marcarModo() {
            root.querySelectorAll(".dvx-segment").forEach(b => { const on = b.dataset.mode === state.compareMode; b.classList.toggle("dvx-active", on); b.setAttribute("aria-pressed", String(on)); });
        }

        function resetAllFilters() {
            const years = aniosDisponibles(), ultima = parseDateOnly(catalogs.ultimaFechaVenta);
            if (ultima) { state.year = ultima.year; state.month = ultima.month; state.day = ultima.day; }
            else { state.year = years.includes(today.getFullYear()) ? today.getFullYear() : (years[0] || today.getFullYear()); state.month = today.getMonth() + 1; state.day = today.getDate(); }
            state.compareMode = "budget";
            Object.assign(state, { masterVendor: [], vendorMaster: [], vendorSku: [], priceMaster: [], priceSku: [], trendMaster: [], trendSku: [] });
            buildCatalogs();
            renderActiveFilters();
            marcarModo();
        }
        function clearDimensionFilters() {
            Object.assign(state, { masterVendor: [], vendorMaster: [], vendorSku: [], priceMaster: [], priceSku: [], trendMaster: [], trendSku: [] });
            setMultiSelectSelection("masterVendorFilter", []);
            syncMultiSelectGroup(["vendorMasterFilter", "priceMasterFilter", "trendMasterFilter"], []);
            rebuildAllSkuFilters();
            renderActiveFilters();
        }

        /* ========================= Consultas ========================= */
        function scheduleRefreshAll(delay = 140) { clearTimeout(refreshTimer); refreshTimer = setTimeout(refreshAll, delay); }
        async function refreshAll() {
            const token = ++refreshToken;
            hideError();
            setLoading(true);
            try {
                const p = baseParams();
                const [summary, masters, vendors, prices, trend] = await Promise.all([
                    getJson(url(cfg.resumenUrl, p)), getJson(url(cfg.masterUrl, p)), getJson(url(cfg.vendedorUrl, p)), getJson(url(cfg.preciosUrl, p)), getJson(url(cfg.tendenciaUrl, p))
                ]);
                if (token !== refreshToken) return;
                renderKPIs(summary); renderMasterChart(masters); renderVendorChart(vendors); renderPriceChart(prices); renderTrendChart(trend); renderActiveFilters();
            } catch (err) { if (token === refreshToken) showError(err); }
            finally { if (token === refreshToken) setLoading(false); }
        }
        const baseParams = () => ({
            anio: state.year, mes: state.month, dia: state.day,
            compararContra: state.compareMode === "reach" ? "alcance" : "presupuesto",
            master: csv(state.vendorMaster), sku: csv(state.vendorSku), vendedorId: csv(state.masterVendor)
        });

        /* ========================= Selección cruzada ========================= */
        function selectCrossValue(type, value, event) {
            value = String(value ?? "").trim(); if (!value) return;
            const additive = !!(event?.ctrlKey || event?.metaKey);
            const current = type === "vendor" ? state.masterVendor : type === "master" ? state.vendorMaster : state.vendorSku;
            let next;
            if (additive) { const s = new Set(current); s.has(value) ? s.delete(value) : s.add(value); next = Array.from(s); }
            else next = current.length === 1 && current[0] === value ? [] : [value];
            if (type === "vendor") { state.masterVendor = next; setMultiSelectSelection("masterVendorFilter", next); }
            if (type === "master") {
                state.vendorMaster = next; state.priceMaster = [...next]; state.trendMaster = [...next];
                syncMultiSelectGroup(["vendorMasterFilter", "priceMasterFilter", "trendMasterFilter"], next);
                rebuildAllSkuFilters();
            }
            if (type === "sku") {
                state.vendorSku = next; state.priceSku = [...next]; state.trendSku = [...next];
                syncMultiSelectGroup(["vendorSkuFilter", "priceSkuFilter", "trendSkuFilter"], next);
            }
            renderActiveFilters();
            scheduleRefreshAll(0);
        }
        function selectCrossDate(value) {
            const p = parseDateOnly(value); if (!p) return;
            state.year = p.year; state.month = p.month; state.day = p.day;
            rebuildDateSelects();
            scheduleRefreshAll(0);
        }
        // CORRECCIÓN: al hacer clic en un vendedor se mandaba "VENDEDOR|5" como vendedorId, que no coincide con
        // los valores del filtro ("5"): el filtro no se marcaba y el servidor recibía un id que no es número.
        // Ahora se usa el mismo id del catálogo; las sucursales CEDIS conservan su clave "CEDIS|NOMBRE".
        function vendorFilterKey(item) {
            const id = Number(item?.vendedorId || 0);
            if (id > 0) return String(id);
            const label = norm(item?.vendedor);
            return label.startsWith("CEDIS") ? `CEDIS|${label}` : "";
        }
        function vendorLabelFromKey(key) {
            const found = (catalogs.vendedores || []).find(x => String(x.id) === String(key));
            if (found) return found.nombre;
            return String(key).toUpperCase().startsWith("CEDIS|") ? String(key).substring(6) : `Vendedor ${key}`;
        }
        function renderActiveFilters() {
            const bar = $("activeFiltersBar"), host = $("activeFilterChips"); if (!bar || !host) return;
            const chips = [
                ...state.masterVendor.map(v => ({ type: "vendor", value: v, label: vendorLabelFromKey(v), icon: "bi-person" })),
                ...state.vendorMaster.map(v => ({ type: "master", value: v, label: v, icon: "bi-tag" })),
                ...state.vendorSku.map(v => ({ type: "sku", value: v, label: v, icon: "bi-upc" }))
            ];
            bar.hidden = !chips.length;
            host.innerHTML = chips.map(x => `<button type="button" class="dvx-filter-chip" data-remove-filter="1" data-type="${esc(x.type)}" data-value="${esc(x.value)}" title="Quitar este filtro"><i class="bi ${x.icon}"></i><span>${esc(x.label)}</span><span class="dvx-filter-chip-x">×</span></button>`).join("");
        }

        /* ========================= Indicadores ========================= */
        function renderKPIs(d) {
            const dia = +d.diaLaboral || 0, total = +d.diasLaborablesMes || 0;
            $("kpiWorkday").innerHTML = `${nf.format(dia)} <small>de ${nf.format(total)}</small>`;
            $("kpiWorkdayBar").style.width = `${total ? Math.min(100, dia / total * 100) : 0}%`;
            $("kpiSales").textContent = nf.format(d.ventaReal || 0);
            $("kpiBudget").textContent = nf.format(d.presupuestoMensual || 0);
            $("kpiReach").textContent = nf.format(d.alcance || 0);
            const cump = +d.cumplimientoPct || 0;
            $("kpiCompliance").textContent = `${nf1.format(cump)}%`;
            $("kpiCompliance").className = cump >= 100 ? "dvx-positive" : cump >= 80 ? "dvx-warning" : "dvx-negative";
            const bar = $("kpiComplianceBar");
            bar.style.width = `${Math.min(100, Math.max(0, cump))}%`;
            bar.style.background = `var(--es-${cump >= 100 ? "ok" : cump >= 80 ? "warn" : "bad"})`;
            $("kpiComplianceLabel").innerHTML = `% Cumplimiento <small>vs ${state.compareMode === "reach" ? "alcance" : "presupuesto"}</small>`;
            const gapKg = +(d.brechaAlcanceKg || 0), gapPct = +(d.brechaAlcancePct || 0);
            $("kpiGap").textContent = `${gapPct > 0 ? "+" : ""}${nf1.format(gapPct)}%`;
            $("kpiGapKg").textContent = `${gapKg > 0 ? "+" : ""}${nf.format(gapKg)} kg ${gapKg >= 0 ? "arriba" : "abajo"} de lo esperado`;
            $("kpiGap").className = gapKg >= 0 ? "dvx-positive" : "dvx-negative";
            $("kpiGapKg").className = `dvx-kpi-delta ${gapKg >= 0 ? "dvx-positive" : "dvx-negative"}`;
            $("lastUpdate").textContent = d.ultimaFechaVenta ? formatDate(d.ultimaFechaVenta) : "Sin ventas en el periodo";
        }

        /* ========================= Utilidades de gráfica ========================= */
        const niceMax = (v, pasos = [1, 2, 2.5, 5, 10]) => { if (v <= 0) return 1; const e = Math.pow(10, Math.floor(Math.log10(v))); for (const p of pasos) if (p * e >= v) return p * e; return 10 * e; };
        const etiquetaEje = (x, y, texto, completo) => `<text class="ch-label" x="${x}" y="${y}" text-anchor="end" transform="rotate(-35 ${x} ${y})"><title>${esc(completo)}</title>${esc(texto)}</text>`;
        function empty(el, msg) { if (el) el.innerHTML = `<div class="dvx-empty"><i class="bi bi-bar-chart"></i>${esc(msg)}</div>`; }

        /* ========================= 1. Ventas por máster ========================= */
        // CORRECCIÓN: antes la línea de avance y sus puntos usaban escalas distintas (no pasaba por los puntos)
        // y toda participación arriba de 41% se veía igual de alta. Ahora todo se dibuja en un solo SVG con ejes.
        function renderMasterChart(items) {
            const cont = $("masterChart");
            if (!items || !items.length) return empty(cont, "Sin información para los filtros seleccionados.");
            const list = items.slice(0, 14), n = list.length;
            const W = 700, H = 290, P = { l: 42, r: 48, t: 26, b: 82 }, cw = W - P.l - P.r, ch = H - P.t - P.b, slot = cw / n, bw = Math.min(40, slot * .6);
            const shares = list.map(x => +x.participacionPct || 0), pcts = list.map(x => +x.avancePct || 0);
            const shareMax = niceMax(Math.max(...shares) * 1.15), pctMax = Math.max(120, Math.ceil(Math.max(...pcts) * 1.1 / 20) * 20);
            const yL = v => P.t + ch - (v / shareMax) * ch, yR = v => P.t + ch - (v / pctMax) * ch, cx = i => P.l + slot * (i + .5);
            const sel = new Set(state.vendorMaster.map(norm));
            let g = "";
            for (let k = 0; k <= 4; k++) {
                const y = P.t + ch - ch * k / 4;
                g += `<line class="ch-grid" x1="${P.l}" x2="${W - P.r}" y1="${y}" y2="${y}"/><text class="ch-tick" x="${P.l - 6}" y="${y + 3.5}" text-anchor="end">${nf.format(shareMax * k / 4)}%</text><text class="ch-tick" x="${W - P.r + 6}" y="${y + 3.5}">${nf.format(pctMax * k / 4)}%</text>`;
            }
            g += `<text class="ch-title" x="${P.l - 6}" y="${P.t - 12}" text-anchor="end">Particip.</text><text class="ch-title" x="${W - P.r + 6}" y="${P.t - 12}">Avance</text>`;
            g += `<line x1="${P.l}" x2="${W - P.r}" y1="${yR(100)}" y2="${yR(100)}" stroke="var(--es-ok)" stroke-width="1.3" stroke-dasharray="5 4"/><text x="${W - P.r - 4}" y="${yR(100) - 4}" text-anchor="end" fill="var(--es-ok)" font-size="9.5" font-weight="700">100%</text>`;
            list.forEach((x, i) => {
                const key = String(x.master || "SIN_MASTER"), s = shares[i], p = pcts[i], on = sel.has(norm(key));
                const y = yL(s), h = P.t + ch - y;
                const tip = `<strong>${esc(key)}</strong>${fila("Participación", nf2.format(s) + "%")}${fila("Venta real", nf.format(x.ventaReal) + " kg")}${fila("Referencia", nf.format(x.referencia) + " kg")}${fila("Avance", nf2.format(p) + "%")}<div class='hint'>Clic para filtrar el tablero · Ctrl+clic para sumar</div>`;
                g += `<g class="ch-hit ${on ? "is-sel" : ""}" data-cross-master="${esc(key)}" ${tipAttr(tip)} tabindex="0" role="button" aria-label="${esc(key)}: avance ${nf.format(p)}%">
                    <rect x="${cx(i) - slot / 2}" y="${P.t}" width="${slot}" height="${ch}" fill="transparent"/>
                    <rect class="ch-bar" x="${cx(i) - bw / 2}" y="${y}" width="${bw}" height="${Math.max(1, h)}" rx="3" fill="${on ? "var(--es-tinto)" : "var(--es-tinto-bar)"}"/>
                    ${h > 16 ? `<text class="ch-value ${on ? "" : "muted"}" x="${cx(i)}" y="${P.t + ch - 6}" text-anchor="middle" ${on ? 'fill="#fff"' : ""}>${nf.format(s)}%</text>` : ""}
                    ${etiquetaEje(cx(i) + 4, P.t + ch + 14, corto(key, 16), key)}
                </g>`;
            });
            const pts = pcts.map((p, i) => `${cx(i)},${yR(p)}`).join(" ");
            g += `<polyline points="${pts}" fill="none" stroke="var(--es-line-dark)" stroke-width="2" stroke-linejoin="round" pointer-events="none"/>`;
            pcts.forEach((p, i) => {
                const c = pctClass(p);
                g += `<circle cx="${cx(i)}" cy="${yR(p)}" r="4.5" fill="var(--es-${c})" stroke="var(--es-surface)" stroke-width="2" pointer-events="none"/><text class="ch-value ch-pct-${c}" x="${cx(i)}" y="${yR(p) - 9}" text-anchor="middle" pointer-events="none">${nf.format(p)}%</text>`;
            });
            cont.innerHTML = `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Ventas por máster">${g}</svg>`;
        }

        /* ========================= 2. Ventas por vendedor ========================= */
        function renderVendorChart(items) {
            const cont = $("vendorChart");
            if (!items || !items.length) return empty(cont, "Sin información para los filtros seleccionados.");
            const list = items.slice(0, 12);
            const max = Math.max(1, ...list.map(x => Math.max(+x.referencia || 0, +x.ventaReal || 0))) * 1.05;
            const sel = new Set(state.masterVendor), haySel = sel.size > 0;
            const skuLabel = state.vendorSku.length ? state.vendorSku.join(", ") : "Todos";
            cont.innerHTML = `<div class="vd-table" role="list">
                <div class="vd-head">Vendedor / sucursal</div><div class="vd-head">Referencia vs venta real</div><div class="vd-head">Referencia</div><div class="vd-head">Venta real</div>
                ${list.map(x => {
                const ref = +x.referencia || 0, sales = +x.ventaReal || 0, p = +x.cumplimientoPct || 0, key = vendorFilterKey(x), on = key && sel.has(key);
                const wRef = ref / max * 100, wSales = Math.min(100, sales / max * 100), c = pctClass(p);
                const tip = `<strong>${esc(x.vendedor)}</strong>${fila("SKU", esc(skuLabel))}${fila("Referencia", nf.format(ref) + " kg")}${fila("Venta real", nf.format(sales) + " kg")}${fila("Cumplimiento", nf2.format(p) + "%")}${key ? "<div class='hint'>Clic para filtrar el tablero · Ctrl+clic para sumar</div>" : ""}`;
                return `<div class="vd-row ${on ? "is-sel" : haySel && key ? "" : ""}" role="listitem" ${key ? `data-cross-vendor="${esc(key)}" tabindex="0"` : ""} ${tipAttr(tip)}>
                        <div class="vd-name" title="${esc(x.vendedor)}">${esc(x.vendedor)}</div>
                        <div class="vd-track"><span class="vd-ref" style="width:${Math.max(1, wRef)}%"></span><span class="vd-sales" style="width:${Math.max(0.5, wSales)}%"></span><span class="vd-pct dvx-${c === "ok" ? "positive" : c === "warn" ? "warning" : "negative"}" style="left:${Math.min(84, Math.max(wRef, wSales))}%">${nf.format(p)}%</span></div>
                        <div class="vd-num" data-copy="${Math.round(ref)}">${nf.format(ref)}</div>
                        <div class="vd-num sales" data-copy="${Math.round(sales)}">${nf.format(sales)}</div>
                    </div>`;
            }).join("")}
            </div>`;
        }

        /* ========================= 3. Precios ========================= */
        // CORRECCIÓN: la línea de promedio se ubicaba con medidas fijas en píxeles y no coincidía con las barras.
        function renderPriceChart(data) {
            const cont = $("priceChart");
            const items = Array.isArray(data?.items) ? data.items : [], avg = +(data?.precioPromedioPonderado || 0);
            $("weightedAverage").innerHTML = avg > 0 ? `<i class="bi bi-currency-dollar"></i> Precio promedio ponderado: $${money.format(avg)} /kg` : "Precio promedio ponderado (-)";
            const fn = $("priceFootnote");
            if (fn) { fn.textContent = "Precio ponderado por el volumen vendido. Verde: igual o arriba del promedio; rojo: abajo."; if (data?.nota) fn.title = data.nota; }
            if (!items.length) return empty(cont, "Sin información de precios para los filtros seleccionados.");
            const list = items.slice(0, 12), vals = list.map(x => +x.precioPonderado || 0);
            if (!vals.some(v => v > 0)) return empty(cont, "Sin precios válidos para los filtros seleccionados.");
            let minY = Math.max(0, Math.floor(Math.min(...vals.filter(v => v > 0), avg || Infinity) / 10) * 10 - 10);
            let maxY = Math.ceil(Math.max(...vals, avg) / 10) * 10 + 10;
            if (maxY <= minY) maxY = minY + 20;
            const W = 700, H = 290, P = { l: 56, r: 16, t: 26, b: 82 }, cw = W - P.l - P.r, ch = H - P.t - P.b, n = list.length, slot = cw / n, bw = Math.min(42, slot * .6);
            const y = v => P.t + ch - ((v - minY) / (maxY - minY)) * ch, cx = i => P.l + slot * (i + .5);
            const sel = new Set(state.masterVendor);
            let g = "";
            for (let k = 0; k <= 4; k++) { const v = minY + (maxY - minY) * k / 4, yy = y(v); g += `<line class="ch-grid" x1="${P.l}" x2="${W - P.r}" y1="${yy}" y2="${yy}"/><text class="ch-tick" x="${P.l - 6}" y="${yy + 3.5}" text-anchor="end">$${nf.format(v)}</text>`; }
            g += `<text class="ch-title" x="${P.l - 6}" y="${P.t - 12}" text-anchor="end">$/kg</text>`;
            list.forEach((x, i) => {
                const v = vals[i], key = vendorFilterKey(x), on = key && sel.has(key), bueno = v >= avg, yy = y(Math.max(v, minY));
                const dif = avg > 0 ? (v - avg) / avg * 100 : 0;
                const tip = `<strong>${esc(x.vendedor)}</strong>${fila("Precio ponderado", "$" + money.format(v) + " /kg")}${fila("Promedio general", "$" + money.format(avg) + " /kg")}${fila("Diferencia", (dif > 0 ? "+" : "") + nf1.format(dif) + "%")}${fila("Volumen", nf.format(x.kilos || 0) + " kg")}${key ? "<div class='hint'>Clic para filtrar el tablero</div>" : ""}`;
                g += `<g class="ch-hit ${on ? "is-sel" : ""}" ${key ? `data-cross-vendor="${esc(key)}" tabindex="0" role="button"` : ""} ${tipAttr(tip)} aria-label="${esc(x.vendedor)}: $${money.format(v)} por kg">
                    <rect x="${cx(i) - slot / 2}" y="${P.t}" width="${slot}" height="${ch}" fill="transparent"/>
                    <rect class="ch-bar" x="${cx(i) - bw / 2}" y="${yy}" width="${bw}" height="${Math.max(2, P.t + ch - yy)}" rx="3" fill="var(--es-${bueno ? "ok" : "bad"})" fill-opacity="${on ? 1 : .78}"/>
                    <text class="ch-value" x="${cx(i)}" y="${yy - 5}" text-anchor="middle" font-size="${slot < 50 ? 8.5 : 10}">$${money.format(v)}</text>
                    ${etiquetaEje(cx(i) + 4, P.t + ch + 14, corto(x.vendedor, 18), x.vendedor)}
                </g>`;
            });
            if (avg > 0) { const ya = y(avg); g += `<line x1="${P.l}" x2="${W - P.r}" y1="${ya}" y2="${ya}" stroke="var(--es-tinto)" stroke-width="1.6" stroke-dasharray="6 4" pointer-events="none"/><rect x="${W - P.r - 104}" y="${ya - 17}" width="104" height="15" rx="7" fill="var(--es-tinto)"/><text x="${W - P.r - 52}" y="${ya - 6.5}" text-anchor="middle" fill="#fff" font-size="9.5" font-weight="700">Prom. $${money.format(avg)}</text>`; }
            cont.innerHTML = `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Precio ponderado por vendedor">${g}</svg>`;
        }

        /* ========================= 4. Tendencia acumulada ========================= */
        function renderTrendChart(data) {
            const cont = $("trendChart");
            const items = Array.isArray(data?.items) ? data.items : [];
            if (!items.length) return empty(cont, "Sin información de tendencia para los filtros seleccionados.");
            const W = 900, H = 320, P = { l: 58, r: 66, t: 28, b: 44 }, cw = W - P.l - P.r, ch = H - P.t - P.b, n = Math.max(1, items.length);
            const reach = items.map(x => +x.alcanceAcumulado || 0);
            const actual = items.map(x => x.ventaAcumulada == null ? null : +x.ventaAcumulada);
            const gap = items.map(x => x.brecha == null ? null : +x.brecha);
            const leftMax = niceMax(Math.max(+(data.presupuestoMensual || 0), ...reach, ...actual.filter(v => v != null), 1) * 1.06);
            const rightLimit = niceMax(Math.max(1000, ...gap.filter(v => v != null).map(Math.abs)) * 1.15);
            const x = i => n === 1 ? P.l + cw / 2 : P.l + i * (cw / (n - 1));
            const yL = v => P.t + ch - (v / leftMax) * ch, yR = v => P.t + ch / 2 - (v / rightLimit) * (ch / 2);
            const colW = n === 1 ? cw : cw / (n - 1), barW = Math.max(5, Math.min(22, colW * .55));
            let g = "";
            for (let k = 0; k <= 5; k++) { const v = leftMax * k / 5, yy = yL(v); g += `<line class="ch-grid" x1="${P.l}" x2="${W - P.r}" y1="${yy}" y2="${yy}"/><text class="ch-tick" x="${P.l - 8}" y="${yy + 3.5}" text-anchor="end">${nf.format(v)}</text>`; }
            [-1, -.5, 0, .5, 1].forEach(f => { const v = rightLimit * f, yy = yR(v); g += `<text class="ch-tick" x="${W - P.r + 8}" y="${yy + 3.5}" fill="${v > 0 ? "var(--es-ok)" : v < 0 ? "var(--es-bad)" : ""}">${v > 0 ? "+" : ""}${nf.format(v)}</text>`; });
            g += `<line x1="${P.l}" x2="${W - P.r}" y1="${yR(0)}" y2="${yR(0)}" stroke="var(--es-muted)" stroke-width="1" stroke-dasharray="2 3" opacity=".6"/>`;
            g += `<text class="ch-title" x="${P.l - 8}" y="${P.t - 12}" text-anchor="end">kg</text><text class="ch-title" x="${W - P.r + 8}" y="${P.t - 12}">Brecha (kg)</text>`;
            g += `<line class="ch-axis" x1="${P.l}" x2="${W - P.r}" y1="${P.t + ch}" y2="${P.t + ch}"/>`;
            const idxReal = actual.map((v, i) => v != null ? i : -1).filter(i => i >= 0), marca = idxReal.length ? idxReal[idxReal.length - 1] : -1;
            if (marca >= 0) g += `<line x1="${x(marca)}" x2="${x(marca)}" y1="${P.t}" y2="${P.t + ch}" stroke="var(--es-info)" stroke-width="1.5" stroke-dasharray="4 4" opacity=".7"/><text x="${x(marca)}" y="${P.t - 6}" text-anchor="middle" fill="var(--es-info)" font-size="9.5" font-weight="700">Corte</text>`;
            actual.forEach((v, i) => { if (v == null) return; const yy = yL(v); g += `<rect x="${x(i) - barW / 2}" y="${yy}" width="${barW}" height="${P.t + ch - yy}" rx="2" fill="var(--es-tinto)" fill-opacity="${i === marca ? 1 : .8}" pointer-events="none"/>`; });
            g += `<polyline points="${reach.map((v, i) => `${x(i)},${yL(v)}`).join(" ")}" fill="none" stroke="var(--es-gold)" stroke-width="2.6" stroke-linejoin="round" stroke-linecap="round" pointer-events="none"/>`;
            reach.forEach((v, i) => g += `<circle cx="${x(i)}" cy="${yL(v)}" r="3" fill="var(--es-gold)" pointer-events="none"/>`);
            const gp = gap.map((v, i) => v == null ? null : `${x(i)},${yR(v)}`).filter(Boolean).join(" ");
            if (gp) g += `<polyline points="${gp}" fill="none" stroke="var(--es-muted)" stroke-width="1.8" stroke-linejoin="round" pointer-events="none"/>`;
            gap.forEach((v, i) => { if (v != null) g += `<circle cx="${x(i)}" cy="${yR(v)}" r="2.8" fill="var(--es-surface)" stroke="${v < 0 ? "var(--es-bad)" : "var(--es-ok)"}" stroke-width="1.8" pointer-events="none"/>`; });
            const paso = n > 26 ? 2 : 1;
            items.forEach((r, i) => {
                if (i % paso === 0 || i === marca) g += `<text class="ch-tick" x="${x(i)}" y="${P.t + ch + 15}" text-anchor="middle" ${i === marca ? 'font-weight="700" fill="var(--es-info)"' : ""}>${esc(r.diaLaboral)}</text>`;
                // Zona invisible por día: tooltip con las tres cifras y clic para cambiar la fecha de corte
                const tip = `<strong>Día laboral ${esc(r.diaLaboral)} · ${esc(formatDate(r.fecha))}</strong>${actual[i] != null ? fila("Venta real acumulada", nf.format(actual[i]) + " kg") : fila("Venta real", "sin dato")}${fila("Alcance esperado", nf.format(reach[i]) + " kg")}${gap[i] != null ? fila("Brecha", (gap[i] > 0 ? "+" : "") + nf.format(gap[i]) + " kg") : ""}<div class='hint'>Clic para usar este día como fecha de corte</div>`;
                g += `<rect class="ch-hit" x="${x(i) - colW / 2}" y="${P.t}" width="${colW}" height="${ch + 20}" fill="var(--es-ink)" fill-opacity="0" data-cross-date="${esc(r.fecha)}" ${tipAttr(tip)} tabindex="-1" onmouseenter="this.setAttribute('fill-opacity','.05')" onmouseleave="this.setAttribute('fill-opacity','0')"/>`;
            });
            g += `<text class="ch-title" x="${P.l + cw / 2}" y="${H - 4}" text-anchor="middle">Días laborales del mes</text>`;
            cont.innerHTML = `<svg viewBox="0 0 ${W} ${H}" role="img" aria-label="Tendencia acumulada de venta real contra alcance">${g}</svg>`;
        }

        /* ========================= Tooltip ========================= */
        function mostrarTip(el, e) { const tip = $("tooltip"); if (!tip) return; tip.innerHTML = el.dataset.tip || el.getAttribute("data-tip") || ""; tip.classList.add("dvx-show"); moveTooltip(e); }
        function ocultarTip() { $("tooltip")?.classList.remove("dvx-show"); }
        function moveTooltip(e) {
            const tip = $("tooltip"); if (!tip) return;
            const pad = 14, r = tip.getBoundingClientRect();
            let left = e.clientX + pad, top = e.clientY + pad;
            if (left + r.width > innerWidth - 8) left = e.clientX - r.width - pad;
            if (top + r.height > innerHeight - 8) top = e.clientY - r.height - pad;
            tip.style.left = `${Math.max(8, left)}px`; tip.style.top = `${Math.max(8, top)}px`;
        }

        /* ========================= Red y formato ========================= */
        async function getJson(endpoint) {
            if (!endpoint) throw new Error("No se configuró uno de los endpoints del dashboard.");
            const resp = await fetch(endpoint, { headers: { "X-Requested-With": "XMLHttpRequest" }, credentials: "same-origin" });
            const text = await resp.text();
            let body = null;
            try { body = text ? JSON.parse(text) : null; } catch { body = null; }
            if (!resp.ok) throw new Error(body?.error || body?.detalle || body?.message || (text && text.length < 300 ? text : "") || `HTTP ${resp.status}`);
            return body;
        }
        function url(base, params) {
            const u = new URL(base, location.origin);
            Object.entries(params || {}).forEach(([k, v]) => { if (v !== undefined && v !== null && String(v) !== "") u.searchParams.set(k, v); });
            return u.toString();
        }
        function parseDateOnly(value) {
            const m = String(value || "").match(/^(\d{4})-(\d{2})-(\d{2})/); if (!m) return null;
            const year = +m[1], month = +m[2], day = +m[3];
            return year && month >= 1 && month <= 12 && day >= 1 && day <= 31 ? { year, month, day } : null;
        }
        function formatDate(value) {
            const p = parseDateOnly(value);
            if (p) return `${String(p.day).padStart(2, "0")}/${String(p.month).padStart(2, "0")}/${p.year}`;
            const d = new Date(value);
            return Number.isNaN(d.getTime()) ? String(value || "") : new Intl.DateTimeFormat("es-MX", { day: "2-digit", month: "2-digit", year: "numeric" }).format(d);
        }
        function setLoading(v) { root.classList.toggle("dvx-loading", !!v); root.setAttribute("aria-busy", String(!!v)); }
        function showError(err) { const el = $("dashboardError"); if (!el) return; el.hidden = false; el.textContent = `No se pudo cargar el dashboard: ${err?.message || err || "error desconocido"}`; }
        function hideError() { const el = $("dashboardError"); if (el) { el.hidden = true; el.textContent = ""; } }
    })();
</script>
