@using System.Linq
@model Plataforma_CG.Models.OrdenesOVFiltro

@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Órdenes de venta";
    var ests = Model?.EstatusSeleccionados ?? new List<int>();
    string TextoEstatus(IEnumerable<int> selec)
    {
        if (selec == null || !selec.Any()) return "Todos";
        var nombres = new List<string>();
        if (selec.Contains(0)) nombres.Add("Cancelados");
        if (selec.Contains(1) || selec.Contains(3)) nombres.Add("Pendiente");
        if (selec.Contains(2)) nombres.Add("Autorización");
        if (selec.Contains(4)) nombres.Add("Validado");
        if (selec.Contains(5)) nombres.Add("Enviado a SAP");
        if (selec.Contains(6)) nombres.Add("Logística");
        var d = nombres.Distinct().ToList();
        return d.Count <= 2 ? string.Join(", ", d) : $"{d.Count} seleccionados";
    }
    var hayResultados = Model?.Resultados != null && Model.Resultados.Any();
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    /* =====================================================================
           ÓRDENES DE VENTA · SIGO — hoja de estilos única
           Mismo sistema visual que el resto de módulos. Sustituye
           ordenes-ov-grid.css, ordenes-ov-erp-legible.css y los bloques internos.
           ===================================================================== */
    :root {
        --es-tinto: #8d3e46;
        --es-tinto-deep: #5c2229;
        --es-tinto-soft: #f7eced;
        --es-tinto-line: #e8d3d6;
        --es-paper: #f6f4f4;
        --es-surface: #ffffff;
        --es-field: #ffffff;
        --es-head: #faf7f7;
        --es-hover: #fcf9f9;
        --es-row-line: #f0eaeb;
        --es-ink: #231a1c;
        --es-muted: #76686b;
        --es-line: #e6dfe0;
        --es-line-strong: #cfc4c6;
        --es-ok: #2f7a55;
        --es-ok-bg: #e7f3ec;
        --es-warn: #9a6410;
        --es-warn-bg: #fbf1de;
        --es-bad: #b42d2d;
        --es-bad-bg: #fbe9e8;
        --es-info: #2f5d86;
        --es-info-bg: #e9f0f7;
        --es-teal: #2b7a72;
        --es-teal-bg: #e4f2f0;
        --es-violet: #6b4a9a;
        --es-violet-bg: #f0eaf7;
        --es-neutral-bg: #efecec;
        --es-font: "Poppins", "Segoe UI", system-ui, -apple-system, Arial, sans-serif;
    }

    body[data-theme="dark"] {
        --es-tinto: #c56b74;
        --es-tinto-deep: #7a2d36;
        --es-tinto-soft: #3a2427;
        --es-tinto-line: #5a3439;
        --es-paper: #16181c;
        --es-surface: #202328;
        --es-field: #181a1e;
        --es-head: #262a30;
        --es-hover: #2a2e34;
        --es-row-line: #30343b;
        --es-ink: #edf0f3;
        --es-muted: #a9b0b9;
        --es-line: #363b43;
        --es-line-strong: #4a5059;
        --es-ok: #6cc596;
        --es-ok-bg: #1d3328;
        --es-warn: #e0b061;
        --es-warn-bg: #3a2f1b;
        --es-bad: #f08a83;
        --es-bad-bg: #3d2223;
        --es-info: #8bb8e0;
        --es-info-bg: #1e2b38;
        --es-teal: #6cc5ba;
        --es-teal-bg: #1b302d;
        --es-violet: #b9a2e0;
        --es-violet-bg: #2a2336;
        --es-neutral-bg: #2c3036;
    }

    .ovx, .ovx-modal, .ov-ctx, .ov-toasts {
        font-family: var(--es-font) !important;
        color: var(--es-ink);
        font-size: 13px;
        line-height: 1.4;
    }

        .ovx *, .ovx-modal *, .ov-ctx *, .ov-confirm * {
            box-sizing: border-box;
        }

        .ovx .bi, .ovx-modal .bi, .ov-ctx .bi, .ov-toasts .bi, .ov-confirm .bi {
            font-family: "bootstrap-icons" !important;
        }

    .num, .text-end {
        text-align: right !important;
        font-variant-numeric: tabular-nums;
    }

    .ovx {
        display: flex;
        flex-direction: column;
        gap: 10px;
        height: calc(100dvh - 92px);
        min-height: 560px;
        padding: 14px 16px 8px;
        background: var(--es-paper);
        overflow: hidden;
        min-width: 0;
    }

    /* ---------- Encabezado ---------- */
    .ov-header {
        flex: none;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        flex-wrap: wrap;
    }

    .ov-header__title {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .ov-header__icon {
        width: 40px;
        height: 40px;
        flex: none;
        border-radius: 10px;
        display: grid;
        place-items: center;
        background: var(--es-tinto);
        color: #fff;
        font-size: 19px;
    }

    .ov-header h1 {
        margin: 0;
        font-size: 20px;
        font-weight: 700;
        letter-spacing: -.01em;
        line-height: 1.15;
        color: var(--es-ink);
    }

    .ov-header p {
        margin: 2px 0 0;
        font-size: 12px;
        color: var(--es-muted);
    }

    #ovRefresco {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 11.5px;
        color: var(--es-muted);
    }

        #ovRefresco .dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--es-ok);
        }

        #ovRefresco.is-off .dot {
            background: var(--es-line-strong);
        }

    /* ---------- Botones ---------- */
    .pm-btn, .ov-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        height: 36px;
        padding: 0 14px;
        border: 1px solid var(--es-line-strong);
        border-radius: 7px;
        background: var(--es-field);
        color: var(--es-ink);
        font: 600 12.5px/1 var(--es-font);
        white-space: nowrap;
        cursor: pointer;
        text-decoration: none;
        transition: background .12s, border-color .12s, color .12s;
    }

        .pm-btn:hover, .ov-btn:hover {
            background: var(--es-tinto-soft);
            border-color: var(--es-tinto-line);
            color: var(--es-ink);
        }

    .pm-btn-primary, .ov-btn-primary {
        background: var(--es-tinto);
        border-color: var(--es-tinto);
        color: #fff;
    }

        .pm-btn-primary:hover, .ov-btn-primary:hover {
            background: var(--es-tinto-deep);
            border-color: var(--es-tinto-deep);
            color: #fff;
        }

    .ov-btn-danger {
        color: var(--es-bad);
    }

        .ov-btn-danger:hover {
            background: var(--es-bad-bg);
            border-color: var(--es-bad);
            color: var(--es-bad);
        }

    .ov-btn-sm {
        height: 30px;
        padding: 0 10px;
        font-size: 12px;
        border-radius: 6px;
    }

    .pm-btn:disabled, .ov-btn:disabled {
        opacity: .55;
        cursor: not-allowed;
    }

    .pm-btn:focus-visible, .ov-btn:focus-visible {
        outline: 2px solid var(--es-tinto);
        outline-offset: 2px;
    }

    /* ---------- Filtros ---------- */
    .ov-card {
        background: var(--es-surface);
        border: 1px solid var(--es-line);
        border-radius: 10px;
        min-width: 0;
    }

    .ov-filters {
        flex: none;
        padding: 10px 14px;
        position: relative;
        z-index: 5;
    }

    .filters {
        display: grid;
        grid-template-columns: 150px 150px minmax(170px, 1fr) minmax(220px, 1.6fr) auto;
        gap: 10px;
        align-items: end;
    }

    .filter-group label {
        display: block;
        margin: 0 0 5px;
        font-size: 12px;
        font-weight: 600;
        color: var(--es-muted);
    }

    .filter-group input[type="date"], .filter-group input[type="text"], .btn-select-like, .ovx-modal .form-control, .ovx-modal .form-select {
        width: 100%;
        height: 36px;
        padding: 0 10px;
        border: 1px solid var(--es-line-strong);
        border-radius: 7px;
        background-color: var(--es-field);
        color: var(--es-ink);
        font: 500 13px/1.2 var(--es-font);
        box-shadow: none;
        outline: none;
    }

        .filter-group input:focus, .btn-select-like:focus-visible, .ovx-modal .form-control:focus, .ovx-modal .form-select:focus {
            border-color: var(--es-tinto);
            box-shadow: 0 0 0 3px rgba(141,62,70,.16);
            background-color: var(--es-field);
            color: var(--es-ink);
        }

    body[data-theme="dark"] .filter-group input, body[data-theme="dark"] .ovx-modal .form-control, body[data-theme="dark"] .ovx-modal .form-select {
        color-scheme: dark;
    }

    .btn-select-like {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 6px;
        text-align: left;
        cursor: pointer;
    }

        .btn-select-like::after {
            content: "\F282";
            font-family: "bootstrap-icons";
            font-size: 11px;
            color: var(--es-muted);
        }

        .btn-select-like.has-value {
            border-color: var(--es-tinto);
            background: var(--es-tinto-soft);
            font-weight: 600;
        }

    .multi-label {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .multi-picker-menu {
        width: 260px;
        padding: 8px !important;
        border: 1px solid var(--es-line-strong) !important;
        border-radius: 10px !important;
        background: var(--es-surface) !important;
        box-shadow: 0 12px 30px rgba(0,0,0,.16) !important;
    }

    .multi-picker-search {
        height: 32px !important;
        margin-bottom: 6px;
        border: 1px solid var(--es-line-strong) !important;
        border-radius: 7px !important;
        background: var(--es-field) !important;
        color: var(--es-ink) !important;
        font: 500 12.5px var(--es-font) !important;
        box-shadow: none !important;
    }

    .multi-picker-option {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 7px 8px;
        margin: 0;
        border-radius: 6px;
        font-size: 12.5px;
        color: var(--es-ink);
        cursor: pointer;
        user-select: none;
    }

        .multi-picker-option:hover {
            background: var(--es-tinto-soft);
        }

        .multi-picker-option input {
            width: 16px;
            height: 16px;
            margin: 0;
            accent-color: var(--es-tinto);
            cursor: pointer;
        }

    .multi-picker-tools {
        display: flex;
        justify-content: space-between;
        margin-top: 6px;
        padding-top: 6px;
        border-top: 1px solid var(--es-line);
    }

        .multi-picker-tools button {
            border: 0;
            background: none;
            padding: 2px 4px;
            color: var(--es-tinto);
            font: 600 11.5px var(--es-font);
            cursor: pointer;
        }

    .pm-actions {
        display: flex;
        gap: 8px;
    }

    .ov-export {
        position: relative;
    }

    /* ---------- Resumen ---------- */
    .ov-resumen {
        flex: none;
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        font-size: 12px;
        color: var(--es-muted);
    }

        .ov-resumen b {
            color: var(--es-ink);
            font-variant-numeric: tabular-nums;
        }

    .ov-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        height: 28px;
        padding: 0 10px;
        border-radius: 999px;
        background: var(--es-surface);
        border: 1px solid var(--es-line);
        cursor: pointer;
        font: 500 12px var(--es-font);
        color: var(--es-ink);
    }

        .ov-chip:hover {
            border-color: var(--es-tinto-line);
        }

        .ov-chip.is-on {
            background: var(--es-tinto);
            border-color: var(--es-tinto);
            color: #fff;
        }

        .ov-chip .n {
            font-weight: 700;
        }

    .ov-resumen .sep {
        width: 1px;
        height: 18px;
        background: var(--es-line);
        margin: 0 4px;
    }

    /* ---------- Listado ---------- */
    .table-card {
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
        min-height: 0;
        background: var(--es-surface);
        border: 1px solid var(--es-line);
        border-radius: 10px;
        overflow: hidden;
    }

    .table-wrap {
        flex: 1 1 auto;
        min-height: 0;
        overflow: auto;
    }

    .orders-grid {
        width: 100%;
        min-width: 0;
        table-layout: fixed;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
        font-size: 12.5px;
        color: var(--es-ink);
        --bs-table-bg: transparent;
        --bs-table-color: var(--es-ink);
        --bs-table-hover-bg: transparent;
        --bs-table-border-color: transparent;
    }

        .orders-grid > :not(caption) > * > * {
            border-width: 0;
            box-shadow: none;
        }

        .orders-grid thead th {
            position: sticky;
            top: 0;
            z-index: 2;
            padding: 9px 10px;
            background: var(--es-head);
            border-bottom: 1px solid var(--es-line);
            color: var(--es-muted);
            font-size: 11.5px;
            font-weight: 600;
            white-space: nowrap;
            text-align: left;
            user-select: none;
        }

            .orders-grid thead th.num {
                text-align: right;
            }

            .orders-grid thead th[data-sort-col] {
                cursor: pointer;
            }

                .orders-grid thead th[data-sort-col]:hover {
                    color: var(--es-ink);
                }

            .orders-grid thead th .sort-ind {
                display: inline-block;
                width: 10px;
                margin-left: 3px;
                color: var(--es-tinto);
                font-size: 10px;
            }

            .orders-grid thead th.asc .sort-ind::after {
                content: "▲";
            }

            .orders-grid thead th.desc .sort-ind::after {
                content: "▼";
            }

        .orders-grid tbody td {
            padding: 7px 10px;
            border-bottom: 1px solid var(--es-row-line);
            background: var(--es-surface);
            white-space: nowrap;
            vertical-align: middle;
        }

        .orders-grid tbody tr:hover > td {
            background: var(--es-hover);
        }

        .orders-grid tbody tr.is-cancelada > td {
            color: var(--es-muted);
        }

            .orders-grid tbody tr.is-cancelada > td:nth-child(6), .orders-grid tbody tr.is-cancelada > td:nth-child(7) {
                text-decoration: line-through;
            }

        .orders-grid tbody tr.is-recien > td {
            animation: ov-flash 1.6s ease-out;
        }

    @@keyframes ov-flash {
        from {
            background: var(--es-warn-bg);
        }
    }

    .orders-grid td.td-nombre {
        max-width: 280px;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .orders-grid td.ov-doc-sap, .orders-grid td.ov-doc-meat {
        max-width: 180px;
        overflow: hidden;
        text-overflow: ellipsis;
        color: var(--es-muted);
    }

        .orders-grid td.ov-doc-sap.has-doc, .orders-grid td.ov-doc-meat.has-doc {
            color: var(--es-ink);
            font-weight: 600;
        }

    .ver-ov {
        font-weight: 700;
        color: var(--es-tinto);
        text-decoration: none;
    }

        .ver-ov:hover {
            text-decoration: underline;
        }

    .ov-pdf-col {
        width: 56px;
        text-align: center !important;
    }

    .ov-pdf-action {
        display: inline-grid;
        place-items: center;
        width: 30px;
        height: 30px;
        border-radius: 6px;
        color: var(--es-bad);
        font-size: 16px;
        text-decoration: none;
    }

        .ov-pdf-action:hover {
            background: var(--es-bad-bg);
            color: var(--es-bad);
        }

    .t-msg td {
        padding: 40px 12px !important;
        text-align: center;
        color: var(--es-muted);
        white-space: normal !important;
    }

    .ov-aviso-series {
        flex: none;
        display: flex;
        gap: 8px;
        padding: 9px 12px;
        border-radius: 8px;
        background: var(--es-warn-bg);
        color: var(--es-warn);
        font-size: 12.5px;
    }


    /* ---------- Listado sin desplazamiento horizontal ----------
           Las columnas se reparten el ancho disponible (colgroup) y los textos largos
           bajan a una segunda línea en lugar de ensanchar la tabla. Solo en pantallas
           muy angostas (menos de 1000 px de contenido) vuelve a aparecer el desplazamiento. */
    .orders-grid thead th {
        white-space: normal !important;
        line-height: 1.2;
        vertical-align: bottom;
        padding: 8px 7px !important;
    }

    .orders-grid tbody td {
        white-space: normal !important;
        overflow-wrap: anywhere;
        padding: 6px 7px !important;
        font-size: 12px;
        line-height: 1.3;
    }

        .orders-grid tbody td.num, .orders-grid tbody td.td-fecha-embarcar, .orders-grid tbody td:first-child {
            white-space: nowrap !important;
            overflow-wrap: normal;
        }

    .orders-grid .clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .orders-grid td.td-nombre, .orders-grid td.ov-doc-sap, .orders-grid td.ov-doc-meat {
        max-width: none !important;
        text-overflow: clip !important;
    }

    .orders-grid td.ov-doc-sap, .orders-grid td.ov-doc-meat {
        font-size: 11.5px;
    }

    .orders-grid .badge-est {
        white-space: normal;
        line-height: 1.25;
        padding: 3px 8px;
        font-size: 11px;
    }

        .orders-grid .badge-est::before {
            flex: none;
        }

    .orders-grid td.ov-pdf-col {
        padding: 4px !important;
    }

    @@media (max-width: 1280px) {
        .table-wrap {
            overflow-x: auto;
        }

        .orders-grid {
            min-width: 1000px;
        }
    }

    .badge-est {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 3px 10px;
        border-radius: 999px;
        font-size: 11.5px;
        font-weight: 600;
        white-space: nowrap;
        background: var(--es-neutral-bg);
        color: var(--es-muted);
    }

        .badge-est::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: currentColor;
        }

        .badge-est.est-0 {
            background: var(--es-bad-bg);
            color: var(--es-bad);
        }

        .badge-est.est-1 {
            background: var(--es-warn-bg);
            color: var(--es-warn);
        }

        .badge-est.est-2 {
            background: var(--es-violet-bg);
            color: var(--es-violet);
        }

        .badge-est.est-4 {
            background: var(--es-teal-bg);
            color: var(--es-teal);
        }

        .badge-est.est-5 {
            background: var(--es-ok-bg);
            color: var(--es-ok);
        }

        .badge-est.est-6 {
            background: var(--es-info-bg);
            color: var(--es-info);
        }

    .statusbar {
        flex: none;
        display: flex;
        gap: 18px;
        flex-wrap: wrap;
        font-size: 11.5px;
        color: var(--es-muted);
    }

    /* ---------- Modal de la orden ---------- */
    #ovModal .modal-dialog {
        max-width: min(1280px, 96vw);
    }

    .ovx-modal.modal-content {
        border: 0;
        border-radius: 12px;
        overflow: hidden;
        background: var(--es-surface);
        box-shadow: 0 18px 50px rgba(35,26,28,.25);
    }

    .ovx-modal .modal-header {
        padding: 13px 18px;
        background: var(--es-tinto-deep);
        color: #fff;
        border-bottom: 0;
        gap: 10px;
    }

    .ovx-modal .modal-title {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 16px;
        font-weight: 600;
        color: #fff;
    }

        .ovx-modal .modal-title .badge-est {
            background: rgba(255,255,255,.18);
            color: #fff;
        }

    .ovx-modal .btn-close {
        filter: invert(1) grayscale(1) brightness(2);
        opacity: .9;
    }

    .ovx-modal .modal-body {
        background: var(--es-paper);
        padding: 14px 16px;
    }

    .ovx-modal .modal-footer {
        background: var(--es-head);
        border-top: 1px solid var(--es-line);
        gap: 8px;
    }

    .header-row {
        display: grid;
        grid-template-columns: minmax(240px, 2fr) minmax(170px, 1.2fr) 190px minmax(150px, 1fr) minmax(200px, 1.1fr);
        gap: 10px;
        margin-bottom: 12px;
    }

    .ov-dato {
        padding: 9px 12px;
        border-radius: 8px;
        background: var(--es-surface);
        border: 1px solid var(--es-line);
        min-width: 0;
    }

        .ov-dato > strong {
            display: block;
            margin-bottom: 3px;
            font-size: 11px;
            font-weight: 600;
            color: var(--es-muted);
            letter-spacing: .02em;
        }

        .ov-dato > span, .ov-dato .valor {
            display: block;
            font-weight: 600;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

    #ovm-serie {
        height: 32px;
        font-weight: 600;
    }

    .editable-inline {
        cursor: pointer;
        display: inline-flex !important;
        align-items: center;
        gap: 6px;
        border-radius: 6px;
    }

        .editable-inline:hover {
            color: var(--es-tinto);
        }

        .editable-inline::after {
            content: "\F4CB";
            font-family: "bootstrap-icons";
            font-size: 12px;
            color: var(--es-muted);
            font-weight: 400;
        }

    #ovm-entrega-actions:not(.d-none) {
        display: flex;
        align-items: center;
        gap: 4px;
    }

    #ovm-entrega-input {
        width: 140px;
        height: 32px;
    }

    .ov-col-obs {
        grid-column: 1 / -1;
    }

    .observacion-vista {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    #ovm-observacion {
        flex: 1 1 auto;
        min-width: 0;
        font-weight: 500;
        white-space: pre-wrap;
        overflow: visible;
    }

        #ovm-observacion.vacia {
            color: var(--es-muted);
            font-style: italic;
        }

    #ovm-observacion-input {
        height: auto;
        padding: 8px 10px;
        resize: vertical;
        line-height: 1.45;
    }

    .observacion-botones {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 6px;
        margin-top: 6px;
        font-size: 11.5px;
        color: var(--es-muted);
    }

        .observacion-botones div {
            display: flex;
            gap: 6px;
        }

    .modal-box {
        margin-bottom: 12px;
        border-radius: 10px;
        background: var(--es-surface);
        border: 1px solid var(--es-line);
        overflow: hidden;
    }

    .modal-box-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding: 9px 14px;
        border-bottom: 1px solid var(--es-line);
        font-size: 13px;
        font-weight: 600;
    }

        .modal-box-title i {
            color: var(--es-tinto);
        }

    .modal-box .table-wrap {
        max-height: 280px;
        overflow: auto;
    }

    .ovx-modal .table {
        width: 100%;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
        font-size: 12.5px;
        color: var(--es-ink);
        --bs-table-bg: transparent;
        --bs-table-color: var(--es-ink);
        --bs-table-border-color: transparent;
    }

        .ovx-modal .table > :not(caption) > * > * {
            border-width: 0;
            box-shadow: none;
        }

        .ovx-modal .table thead th {
            position: sticky;
            top: 0;
            z-index: 1;
            padding: 8px 10px;
            background: var(--es-head);
            border-bottom: 1px solid var(--es-line);
            color: var(--es-muted);
            font-size: 11.5px;
            font-weight: 600;
            white-space: nowrap;
        }

        .ovx-modal .table tbody td {
            padding: 6px 10px;
            border-bottom: 1px solid var(--es-row-line);
            background: var(--es-surface);
            white-space: nowrap;
            vertical-align: middle;
        }

        .ovx-modal .table tbody tr:hover td {
            background: var(--es-hover);
        }

        .ovx-modal .table tfoot th {
            position: sticky;
            bottom: 0;
            padding: 9px 10px;
            background: var(--es-head);
            border-top: 1px solid var(--es-line);
            font-weight: 700;
            font-variant-numeric: tabular-nums;
        }

    .ovm-detalle-table td:nth-child(2) {
        font-weight: 600;
    }

    .ovm-detalle-table td:nth-child(3) {
        white-space: normal !important;
        min-width: 280px;
    }

    .sp-docmeat {
        height: 32px !important;
        max-width: 220px;
    }

        .sp-docmeat.doc-meat-empty {
            border-color: var(--es-warn) !important;
            background: var(--es-warn-bg) !important;
        }

        .sp-docmeat.is-changed {
            border-color: var(--es-tinto) !important;
        }

    #ovm-auto {
        font-weight: 600;
        color: var(--es-violet);
    }

    /* Confirmación de cancelación */
    .ov-confirm {
        position: fixed;
        inset: 0;
        z-index: 2000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 18px;
        background: rgba(22,24,28,.45);
        font-family: var(--es-font);
    }

        .ov-confirm.d-none {
            display: none !important;
        }

    .ov-confirm-card {
        width: min(460px, 100%);
        border-radius: 12px;
        background: var(--es-surface);
        color: var(--es-ink);
        box-shadow: 0 18px 55px rgba(0,0,0,.3);
        overflow: hidden;
    }

    .ov-confirm-head {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 16px;
        border-bottom: 1px solid var(--es-line);
    }

    .ov-confirm-icon {
        width: 36px;
        height: 36px;
        flex: none;
        border-radius: 50%;
        display: grid;
        place-items: center;
        background: var(--es-bad-bg);
        color: var(--es-bad);
        font-size: 17px;
    }

    .ov-confirm-head h5 {
        margin: 0;
        font-size: 15px;
        font-weight: 700;
    }

    .ov-confirm-body {
        padding: 16px;
        font-size: 13px;
        line-height: 1.5;
        color: var(--es-muted);
    }

        .ov-confirm-body strong {
            color: var(--es-ink);
        }

    .ov-confirm-actions {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        padding: 12px 16px;
        border-top: 1px solid var(--es-line);
        background: var(--es-head);
    }

    /* Avisos */
    .ov-toasts {
        position: fixed;
        top: 16px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 2100;
        display: flex;
        flex-direction: column;
        gap: 8px;
        width: min(620px, 92vw);
        pointer-events: none;
    }

    .ov-toast {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 11px 14px;
        border-radius: 10px;
        background: var(--es-surface);
        border: 1px solid var(--es-line);
        border-left: 4px solid var(--c, var(--es-info));
        box-shadow: 0 12px 30px rgba(0,0,0,.18);
        font-size: 13px;
        pointer-events: auto;
        animation: ov-in .16s ease-out;
    }

        .ov-toast i {
            color: var(--c);
            font-size: 16px;
            margin-top: 1px;
        }

        .ov-toast span {
            flex: 1;
        }

        .ov-toast button {
            border: 0;
            background: none;
            color: var(--es-muted);
            font-size: 16px;
            line-height: 1;
            cursor: pointer;
        }

        .ov-toast.success {
            --c: var(--es-ok);
        }

        .ov-toast.danger {
            --c: var(--es-bad);
        }

        .ov-toast.warning {
            --c: var(--es-warn);
        }

        .ov-toast.info {
            --c: var(--es-info);
        }

    @@keyframes ov-in {
        from {
            opacity: 0;
            transform: translateY(-6px);
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .ov-toast, .orders-grid tbody tr.is-recien > td {
            animation: none;
        }
    }

    /* Menú de clic derecho */
    .ov-ctx {
        position: fixed;
        z-index: 2050;
        min-width: 230px;
        padding: 4px;
        border-radius: 10px;
        background: var(--es-surface);
        border: 1px solid var(--es-line-strong);
        box-shadow: 0 14px 34px rgba(0,0,0,.2);
        display: none;
    }

        .ov-ctx.show {
            display: block;
        }

        .ov-ctx button {
            width: 100%;
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 8px 10px;
            border: 0;
            border-radius: 6px;
            background: transparent;
            color: var(--es-ink);
            font: 500 12.5px/1.2 var(--es-font);
            text-align: left;
            cursor: pointer;
        }

            .ov-ctx button:hover, .ov-ctx button:focus-visible {
                background: var(--es-tinto-soft);
                outline: none;
            }

            .ov-ctx button i {
                color: var(--es-tinto);
                width: 16px;
            }

            .ov-ctx button small {
                margin-left: auto;
                color: var(--es-muted);
                font-size: 11px;
            }

    td.ctx-cell {
        box-shadow: inset 0 0 0 2px var(--es-tinto) !important;
    }

    @@media (max-width: 1200px) {
        .filters {
            grid-template-columns: 1fr 1fr 1fr;
        }

        .pm-actions {
            grid-column: 1 / -1;
            justify-content: flex-end;
        }

        .header-row {
            grid-template-columns: 1fr 1fr 1fr;
        }
    }

    @@media (max-width: 760px) {
        .ovx {
            height: auto;
            overflow: visible;
        }

        .table-card {
            min-height: 520px;
        }

        .filters, .header-row {
            grid-template-columns: 1fr 1fr;
        }
    }
</style>

<div class="ovx window ordenes-ov-app">
    <header class="ov-header">
        <div class="ov-header__title">
            <span class="ov-header__icon"><i class="bi bi-receipt-cutoff"></i></span>
            <div>
                <h1>Órdenes de venta</h1>
                <p>Consulta, seguimiento y ajustes de las órdenes capturadas: estatus, documentos SAP y Meat, fecha de embarque y PDF.</p>
            </div>
        </div>
        <span id="ovRefresco" title="El listado se actualiza solo mientras la pestaña está visible"><span class="dot"></span><span id="ovRefrescoTxt">Actualización automática</span></span>
    </header>

    <section class="ov-card ov-filters">
        <form id="frmPedidos" method="get">
            <div class="filters">
                <div class="filter-group">
                    <label for="f-desde">Desde</label>
                    <input type="date" id="f-desde" name="Desde" value="@(Model?.Desde?.ToString("yyyy-MM-dd") ?? "")" />
                </div>
                <div class="filter-group">
                    <label for="f-hasta">Hasta</label>
                    <input type="date" id="f-hasta" name="Hasta" value="@(Model?.Hasta?.ToString("yyyy-MM-dd") ?? "")" />
                </div>
                <div class="filter-group">
                    <label for="dd-estatus-btn">Estatus</label>
                    <div class="dropdown w-100" id="dd-estatus">
                        <button class="btn-select-like w-100 @(ests.Any() ? "has-value" : "")" id="dd-estatus-btn" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                            <span class="multi-label">@TextoEstatus(ests)</span>
                        </button>
                        <div class="dropdown-menu multi-picker-menu" onclick="event.stopPropagation();">
                            <input type="text" class="form-control multi-picker-search" placeholder="Buscar estatus…" autocomplete="off" aria-label="Buscar estatus" />
                            <div class="multi-picker-list">
                                <label class="multi-picker-option"><input class="multi-check-estatus" type="checkbox" value="0" data-text="Cancelados" @(ests.Contains(0) ? "checked" : null) /><span class="badge-est est-0">Cancelados</span></label>
                                <label class="multi-picker-option"><input class="multi-check-estatus" type="checkbox" value="1" data-values="1,3" data-text="Pendiente" @((ests.Contains(1) || ests.Contains(3)) ? "checked" : null) /><span class="badge-est est-1">Pendiente</span></label>
                                <label class="multi-picker-option"><input class="multi-check-estatus" type="checkbox" value="2" data-text="Autorización" @(ests.Contains(2) ? "checked" : null) /><span class="badge-est est-2">Autorización</span></label>
                                <label class="multi-picker-option"><input class="multi-check-estatus" type="checkbox" value="4" data-text="Validado" @(ests.Contains(4) ? "checked" : null) /><span class="badge-est est-4">Validado</span></label>
                                <label class="multi-picker-option"><input class="multi-check-estatus" type="checkbox" value="5" data-text="Enviado a SAP" @(ests.Contains(5) ? "checked" : null) /><span class="badge-est est-5">Enviado a SAP</span></label>
                                <label class="multi-picker-option"><input class="multi-check-estatus" type="checkbox" value="6" data-text="Logística" @(ests.Contains(6) ? "checked" : null) /><span class="badge-est est-6">Logística</span></label>
                            </div>
                            <div class="multi-picker-tools"><button type="button" id="est-todos">Todos</button><button type="button" id="est-ninguno">Ninguno</button></div>
                        </div>
                        <div id="dd-estatus-hidden">
                            @foreach (var e in ests)
                            {
                                <input type="hidden" name="EstatusSeleccionados" value="@e" />
                            }
                        </div>
                    </div>
                </div>
                <div class="filter-group">
                    <label for="f-buscar">Buscar</label>
                    <input type="text" id="f-buscar" name="Buscar" value="@(Model?.Buscar ?? "")" placeholder="Consecutivo, cliente o nombre" />
                </div>
                <div class="pm-actions">
                    <button class="pm-btn pm-btn-primary" type="submit"><i class="bi bi-search"></i><span>Aplicar</span></button>
                    <div class="dropdown ov-export">
                        <button class="pm-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-download"></i><span>Exportar</span><i class="bi bi-chevron-down" style="font-size:10px"></i></button>
                        <div class="dropdown-menu dropdown-menu-end multi-picker-menu" style="width:200px">
                            <button class="multi-picker-option w-100 border-0 bg-transparent" type="submit" form="frmPedidos" name="Export" value="xlsx"><i class="bi bi-file-earmark-excel" style="color:var(--es-ok)"></i> Excel (.xlsx)</button>
                            <button class="multi-picker-option w-100 border-0 bg-transparent" type="submit" form="frmPedidos" name="Export" value="csv"><i class="bi bi-filetype-csv" style="color:var(--es-info)"></i> CSV</button>
                        </div>
                    </div>
                </div>
            </div>
        </form>
    </section>

    <div class="ov-resumen" id="ovResumen" aria-live="polite"></div>

    @if (ViewBag.MensajeSeries != null)
    {
        <div class="ov-aviso-series"><i class="bi bi-info-circle"></i><span>@ViewBag.MensajeSeries</span></div>
    }

    @Html.AntiForgeryToken()

    <section class="table-card">
        <div class="table-wrap" id="ov-list-container">
            <table class="table orders-grid">
                <colgroup>
                    <col style="width:8%">
                    <col style="width:5%">
                    <col style="width:6%">
                    <col style="width:17%">
                    <col style="width:9%">
                    <col style="width:7%">
                    <col style="width:8%">
                    <col style="width:10%">
                    <col style="width:7%">
                    <col style="width:7%">
                    <col style="width:6.5%">
                    <col style="width:6.5%">
                    <col style="width:3%">
                </colgroup>
                <thead>
                    <tr>
                        <th data-sort-col="cons" data-sort-type="text">Consecutivo<span class="sort-ind"></span></th>
                        <th data-sort-col="serie" data-sort-type="text">Serie<span class="sort-ind"></span></th>
                        <th data-sort-col="cliente" data-sort-type="text">Cliente<span class="sort-ind"></span></th>
                        <th data-sort-col="nombre" data-sort-type="text">Nombre del cliente<span class="sort-ind"></span></th>
                        <th data-sort-col="vendedor" data-sort-type="text">Vendedor<span class="sort-ind"></span></th>
                        <th class="num" data-sort-col="kg" data-sort-type="num">Kg<span class="sort-ind"></span></th>
                        <th class="num" data-sort-col="importe" data-sort-type="num">Importe<span class="sort-ind"></span></th>
                        <th data-sort-col="estatus" data-sort-type="text">Estatus<span class="sort-ind"></span></th>
                        <th data-sort-col="docsap" data-sort-type="text">Doc. SAP<span class="sort-ind"></span></th>
                        <th data-sort-col="docmeat" data-sort-type="text">Doc. Meat<span class="sort-ind"></span></th>
                        <th data-sort-col="fent" data-sort-type="date">Embarque<span class="sort-ind"></span></th>
                        <th data-sort-col="usuario" data-sort-type="text">Solicita<span class="sort-ind"></span></th>
                        <th class="ov-pdf-col no-copy">PDF</th>
                    </tr>
                </thead>
                <tbody id="ov-tbody">
                    @if (hayResultados)
                    {
                        var idx = 0;
                        foreach (var r in Model.Resultados)
                        {
                            var estVal = r?.Estatus ?? -1;
                            var estGrupo = (estVal == 3) ? 1 : estVal;
                            var estClass = estVal == 0 ? "est-0" : (estVal == 1 || estVal == 3) ? "est-1" : estVal == 2 ? "est-2" : estVal == 4 ? "est-4" : estVal == 5 ? "est-5" : estVal == 6 ? "est-6" : "";
                            var texto = estVal == 0 ? "Cancelado" : (estVal == 1 || estVal == 3) ? "Pendiente" : estVal == 2 ? "Autorización" : estVal == 4 ? "Validado" : estVal == 5 ? "Enviado a SAP" : estVal == 6 ? "Logística" : "Otro";
                            if (estVal == 2 && !string.IsNullOrWhiteSpace(r?.AutorizacionPendiente)) { texto += $" ({r.AutorizacionPendiente})"; }
                            <tr data-index="@idx" data-id="@(r?.Id)" data-estatus="@estGrupo"
                                data-kg="@((r?.KgTotales ?? 0m).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                data-importe="@((r?.Importe ?? 0m).ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                class="@(estVal == 0 ? "is-cancelada" : "")">
                                <td><a href="#" class="ver-ov" data-id="@(r?.Id)" data-cons="@(r?.Consecutivo ?? "")">@(r?.Consecutivo ?? "")</a></td>
                                <td class="td-serie">@(r?.Serie ?? "")</td>
                                <td>@(r?.Cliente ?? "")</td>
                                <td class="td-nombre" title="@(r?.ClienteNombre ?? "")"><span class="clamp-2">@(r?.ClienteNombre ?? "")</span></td>
                                <td title="@(r?.Vendedor ?? "")"><span class="clamp-2">@(r?.Vendedor ?? "")</span></td>
                                <td class="num" data-copy="@((r?.KgTotales ?? 0m).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))">@((r?.KgTotales ?? 0m).ToString("N2"))</td>
                                <td class="num" data-copy="@((r?.Importe ?? 0m).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))">@((r?.Importe ?? 0m).ToString("C"))</td>
                                <td class="td-estatus"><span class="badge-est @estClass">@texto</span></td>
                                <td class="ov-doc-sap" title="Consultando subpedidos…">…</td>
                                <td class="ov-doc-meat" title="Consultando subpedidos…">…</td>
                                <td class="td-fecha-embarcar">@(r?.FechaEntrega?.ToString("yyyy-MM-dd") ?? "")</td>
                                <td title="@(r?.UsuarioRegistro ?? "")"><span class="clamp-2">@(r?.UsuarioRegistro ?? "")</span></td>
                                <td class="ov-pdf-col no-copy">
                                    <a asp-controller="Comercial" asp-action="OrdenVentaPdf" asp-route-id="@(r?.Id)" asp-route-descargar="false"
                                       target="_blank" rel="noopener noreferrer" class="ov-pdf-action"
                                       title="Vista previa PDF de la orden @(r?.Consecutivo ?? "")" aria-label="Vista previa PDF de la orden @(r?.Consecutivo ?? "")">
                                        <i class="bi bi-file-earmark-pdf-fill" aria-hidden="true"></i>
                                    </a>
                                </td>
                            </tr>
                            idx++;
                        }
                    }
                    else
                    {
                        <tr class="t-msg"><td colspan="13">Sin órdenes con estos filtros.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <footer class="statusbar">
        <span>Usuario: @(User?.Identity?.Name ?? "")</span>
        <span>Carnes G SA de CV</span>
        <span>Módulo: Pedidos</span>
    </footer>
</div>

<!-- ======================= Modal de la orden ======================= -->
<div class="modal fade" id="ovModal" tabindex="-1" aria-hidden="true" aria-labelledby="ovmTitulo">
    <div class="modal-dialog modal-dialog-scrollable modal-ov-wide">
        <div class="modal-content ovx-modal">
            <div class="modal-header">
                <h5 class="modal-title" id="ovmTitulo"><i class="bi bi-receipt"></i> Orden de venta <span id="ovm-consecutivo"></span> <span id="ovm-estatus" class="badge-est"></span></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">
                <div class="header-row">
                    <div class="ov-dato">
                        <strong>Cliente</strong>
                        <span title=""><span id="ovm-cliente"></span> · <span id="ovm-cliente-nombre"></span></span>
                    </div>
                    <div class="ov-dato">
                        <strong>Vendedor</strong>
                        <span id="ovm-vendedor"></span>
                    </div>
                    <div class="ov-dato">
                        <strong>Serie</strong>
                        <select id="ovm-serie" class="form-select" aria-label="Serie de la orden"></select>
                    </div>
                    <div class="ov-dato">
                        <strong>Fecha de registro</strong>
                        <span id="ovm-fecha-reg"></span>
                    </div>
                    <div class="ov-dato">
                        <strong>Fecha de embarque</strong>
                        <span id="ovm-fecha-ent" class="editable-inline" title="Clic para cambiar la fecha" role="button" tabindex="0"></span>
                        <span id="ovm-entrega-actions" class="d-none">
                            <input type="date" class="form-control" id="ovm-entrega-input" aria-label="Nueva fecha de embarque" />
                            <button class="ov-btn ov-btn-sm ov-btn-primary" id="ovm-entrega-guardar" type="button">Guardar</button>
                            <button class="ov-btn ov-btn-sm" id="ovm-entrega-cancelar" type="button">Cancelar</button>
                        </span>
                    </div>
                    <div class="ov-dato ov-col-obs">
                        <strong>Observación</strong>
                        <div id="ovm-observacion-vista" class="observacion-vista">
                            <span id="ovm-observacion" class="vacia">Sin observaciones.</span>
                            <button type="button" class="ov-btn ov-btn-sm" id="ovm-observacion-editar"><i class="bi bi-pencil-square"></i> Editar</button>
                        </div>
                        <div id="ovm-observacion-actions" class="d-none">
                            <textarea id="ovm-observacion-input" class="form-control" maxlength="500" rows="3" placeholder="Escribe la observación…" aria-label="Observación"></textarea>
                            <div class="observacion-botones">
                                <span><span id="ovm-obs-cuenta">0</span>/500 · Ctrl+Enter guarda, Esc cancela</span>
                                <div>
                                    <button type="button" class="ov-btn ov-btn-sm" id="ovm-observacion-cancelar">Cancelar</button>
                                    <button type="button" class="ov-btn ov-btn-sm ov-btn-primary" id="ovm-observacion-guardar">Guardar</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-box">
                    <div class="modal-box-title"><span><i class="bi bi-list-ul"></i> Artículos</span><small style="font-weight:500;color:var(--es-muted)">Clic derecho para copiar a Excel</small></div>
                    <div class="table-wrap">
                        <table class="table ovm-detalle-table" id="ovm-detalle">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Artículo</th>
                                    <th>Descripción</th>
                                    <th class="num">Cajas</th>
                                    <th class="num">Peso (kg)</th>
                                    <th class="num">Precio</th>
                                    <th class="num">Importe</th>
                                </tr>
                            </thead>
                            <tbody id="ovm-tbody"><tr class="t-msg"><td colspan="7">Cargando…</td></tr></tbody>
                            <tfoot>
                                <tr>
                                    <th colspan="3" class="num">Totales</th>
                                    <th class="num" id="ovm-total-cajas">0</th>
                                    <th class="num" id="ovm-total-peso">0.00</th>
                                    <th></th>
                                    <th class="num" id="ovm-total-imp">$0.00</th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>

                <div class="modal-box" style="margin-bottom:0">
                    <div class="modal-box-title"><span><i class="bi bi-diagram-3"></i> Subpedidos (<span id="ovm-sub-count">0</span>)</span></div>
                    <div class="table-wrap" style="max-height:220px">
                        <table class="table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>Subfolio</th>
                                    <th>Documento SAP</th>
                                    <th>Documento Meat</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody id="ovm-sub-tbody"><tr class="t-msg"><td colspan="5">Sin subpedidos.</td></tr></tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <small class="text-muted me-auto">Autorización pendiente: <span id="ovm-auto">—</span></small>
                <button type="button" class="ov-btn" id="btn-pdf-ov"><i class="bi bi-file-earmark-pdf"></i> Ver PDF</button>
                <button type="button" class="ov-btn ov-btn-danger" id="btn-cancelar-ov"><i class="bi bi-x-octagon"></i> Cancelar pedido</button>
                <button type="button" class="ov-btn" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- Confirmación de cancelación -->
<div id="cancelConfirmOverlay" class="ov-confirm d-none" role="dialog" aria-modal="true" aria-labelledby="cancelConfirmTitle" aria-hidden="true">
    <div class="ov-confirm-card">
        <div class="ov-confirm-head">
            <div class="ov-confirm-icon"><i class="bi bi-exclamation-triangle-fill"></i></div>
            <h5 id="cancelConfirmTitle">Confirmar cancelación</h5>
        </div>
        <div class="ov-confirm-body"><div id="cancelConfirmMessage">¿Estás seguro de cancelar este pedido?</div></div>
        <div class="ov-confirm-actions">
            <button type="button" class="ov-btn" id="btnCancelConfirmNo">No, conservar</button>
            <button type="button" class="ov-btn ov-btn-primary" id="btnCancelConfirmSi" style="background:var(--es-bad);border-color:var(--es-bad)">Sí, cancelar</button>
        </div>
    </div>
</div>

<div id="ovToasts" class="ov-toasts" aria-live="polite"></div>

<div id="ovCtxMenu" class="ov-ctx" role="menu" aria-label="Copiar">
    <button type="button" role="menuitem" data-copiar="tabla"><i class="bi bi-table"></i> <span class="lbl">Copiar tabla completa</span> <small id="ovCtxFilas"></small></button>
    <button type="button" role="menuitem" data-copiar="fila"><i class="bi bi-distribute-vertical"></i> Copiar este renglón</button>
    <button type="button" role="menuitem" data-copiar="celda"><i class="bi bi-input-cursor-text"></i> Copiar esta celda</button>
</div>

@section Scripts {
    <script>
        (() => {
            // ================= Utilidades =================
            const $id = id => document.getElementById(id);
            const esc = v => String(v ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
            const getAntiForgeryToken = () => document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const fmtNum = (n, d = 2) => n == null ? '' : Number(n).toLocaleString('es-MX', { minimumFractionDigits: d, maximumFractionDigits: d });
            const fmtMoney = n => n == null ? '' : Number(n).toLocaleString('es-MX', { style: 'currency', currency: 'MXN' });
            function fmtDateTime(s) { if (!s) return ''; const dt = new Date(s); return isNaN(dt) ? s : dt.toLocaleString('es-MX', { dateStyle: 'medium', timeStyle: 'short' }); }
            // CORRECCIÓN: las fechas sin hora (yyyy-mm-dd) ya no se convierten con zona horaria.
            // Antes "2026-11-17" se mostraba como 16/11/2026 en el modal, y al editar y guardar sin
            // tocar nada la fecha de embarque se recorría un día hacia atrás.
            const isoFecha = s => { const m = String(s || '').match(/^(\d{4})-(\d{2})-(\d{2})/); return m ? `${m[1]}-${m[2]}-${m[3]}` : ''; };
            function fmtDate(s) {
                const iso = isoFecha(s);
                if (iso) { const [y, m, d] = iso.split('-'); return `${d}/${m}/${y}`; }
                if (!s) return '';
                const dt = new Date(s);
                return isNaN(dt) ? String(s) : dt.toLocaleDateString('es-MX');
            }
            async function leerJson(resp) { const raw = await resp.text(); try { return JSON.parse(raw); } catch { return {}; } }

            // Avisos (antes se insertaban arriba de la página y quedaban fuera de vista)
            function showMsg(type, text, ms) {
                const cont = $id('ovToasts');
                if (!type) { cont.innerHTML = ''; return; }
                const icon = { success: 'bi-check-circle-fill', danger: 'bi-x-circle-fill', warning: 'bi-exclamation-triangle-fill', info: 'bi-info-circle-fill' }[type] || 'bi-info-circle-fill';
                const el = document.createElement('div');
                el.className = `ov-toast ${type}`;
                el.setAttribute('role', type === 'danger' ? 'alert' : 'status');
                el.innerHTML = `<i class="bi ${icon}"></i><span>${esc(text)}</span><button type="button" aria-label="Cerrar">×</button>`;
                el.querySelector('button').onclick = () => el.remove();
                cont.appendChild(el);
                const dur = ms ?? (type === 'danger' ? 9000 : type === 'warning' ? 6500 : 3500);
                if (dur > 0) setTimeout(() => el.remove(), dur);
            }

            const TEXTO_EST = { 0: 'Cancelado', 1: 'Pendiente', 3: 'Pendiente', 2: 'Autorización', 4: 'Validado', 5: 'Enviado a SAP', 6: 'Logística' };
            const CLASE_EST = { 0: 'est-0', 1: 'est-1', 3: 'est-1', 2: 'est-2', 4: 'est-4', 5: 'est-5', 6: 'est-6' };
            function estatusTexto(h) {
                let base = TEXTO_EST[h.estatus] || 'Otro';
                if (h.estatus === 2 && h.autorizacionPendiente) base += ` (${h.autorizacionPendiente})`;
                return base;
            }
            const filaDeOrden = id => document.querySelector(`#ov-tbody tr[data-id="${CSS.escape(String(id))}"]`);

            // ================= Confirmación de cancelación =================
            function confirmarCancelacionFlotante(consecutivo) {
                return new Promise(resolve => {
                    const overlay = $id('cancelConfirmOverlay'), btnNo = $id('btnCancelConfirmNo'), btnSi = $id('btnCancelConfirmSi');
                    $id('cancelConfirmMessage').innerHTML =
                        `¿Seguro que quieres cancelar el pedido <strong>${esc((consecutivo || '').trim())}</strong>?<br><br>` +
                        `Si la solicitud de surtido ya tiene cajas asignadas, el sistema no permitirá la cancelación y no se afectará SAP ni MEAT.`;
                    overlay.classList.remove('d-none');
                    overlay.setAttribute('aria-hidden', 'false');
                    const cerrar = r => {
                        overlay.classList.add('d-none');
                        overlay.setAttribute('aria-hidden', 'true');
                        btnNo.removeEventListener('click', onNo); btnSi.removeEventListener('click', onSi);
                        document.removeEventListener('keydown', onKey, true);
                        resolve(r);
                    };
                    const onNo = () => cerrar(false), onSi = () => cerrar(true);
                    const onKey = e => { if (e.key === 'Escape') { e.preventDefault(); e.stopPropagation(); cerrar(false); } };
                    btnNo.addEventListener('click', onNo); btnSi.addEventListener('click', onSi);
                    document.addEventListener('keydown', onKey, true);
                    setTimeout(() => btnNo.focus(), 0);
                });
            }

            // ================= PDF =================
            let ordenIdActual = null, estatusActual = null;
            function abrirPdfOrdenVenta(id) {
                const n = Number(id || 0);
                if (!Number.isInteger(n) || n <= 0) { showMsg('warning', 'No se encontró el identificador de la orden.'); return; }
                const v = window.open(`/Comercial/OrdenVentaPdf?id=${encodeURIComponent(n)}&descargar=false`, '_blank', 'noopener,noreferrer');
                if (!v) showMsg('warning', 'El navegador bloqueó la ventana del PDF. Permite ventanas emergentes para este sitio.');
            }
            // CORRECCIÓN: el botón de PDF del modal se programaba pero no existía en la pantalla; ahora sí.
            $id('btn-pdf-ov').addEventListener('click', () => abrirPdfOrdenVenta(ordenIdActual));

            // ================= Documentos SAP / Meat del listado =================
            // Misma API que el modal de subpedidos; una OV puede tener varios: se muestran todos.
            // Se recuerdan 2 minutos para que la actualización automática no repita cientos de consultas.
            const DOCS_TTL = 120000;
            const ovDocumentosCache = new Map();
            function consultarDocumentosOV(consecutivo, forzar = false) {
                if (!consecutivo) return Promise.resolve({ sap: '', meat: '' });
                const c = ovDocumentosCache.get(consecutivo);
                if (!forzar && c && Date.now() - c.t < DOCS_TTL) return c.p;
                const p = fetch(`/Comercial/SubpedidosPorOV2?consecutivoOV=${encodeURIComponent(consecutivo)}`, { cache: 'no-store' })
                    .then(async resp => {
                        if (!resp.ok) throw new Error('HTTP ' + resp.status);
                        const datos = await resp.json();
                        if (!Array.isArray(datos)) throw new Error('Respuesta inesperada');
                        const unicos = fn => [...new Set(datos.map(fn).map(v => String(v ?? '').trim()).filter(Boolean))].join(', ');
                        return { sap: unicos(sp => sp.documentoSAP), meat: unicos(sp => sp.u_DocMeat) };
                    })
                    .catch(err => { ovDocumentosCache.delete(consecutivo); throw err; });
                ovDocumentosCache.set(consecutivo, { p, t: Date.now() });
                return p;
            }
            async function pintarDocumentosOV(tr, forzar = false) {
                const consecutivo = tr.querySelector('a.ver-ov')?.dataset.cons;
                const sapCell = tr.querySelector('.ov-doc-sap'), meatCell = tr.querySelector('.ov-doc-meat');
                if (!consecutivo || !sapCell || !meatCell) return;
                try {
                    const docs = await consultarDocumentosOV(consecutivo, forzar);
                    if (!tr.isConnected) return;
                    sapCell.textContent = docs.sap || '—'; meatCell.textContent = docs.meat || '—';
                    sapCell.classList.toggle('has-doc', !!docs.sap); meatCell.classList.toggle('has-doc', !!docs.meat);
                    sapCell.title = docs.sap || 'Sin documento SAP'; meatCell.title = docs.meat || 'Sin documento Meat';
                } catch (e) {
                    console.error('Error al consultar documentos de ' + consecutivo, e);
                    sapCell.textContent = meatCell.textContent = 'No disponible';
                    sapCell.title = meatCell.title = 'No se pudieron consultar los subpedidos';
                }
            }
            async function cargarDocumentosListadoOV() {
                const filas = [...document.querySelectorAll('#ov-tbody tr[data-index]')];
                let i = 0;
                await Promise.all(Array.from({ length: Math.min(5, filas.length) }, async () => { while (i < filas.length) await pintarDocumentosOV(filas[i++]); }));
            }

            // ================= Resumen y filtro rápido por estatus =================
            let filtroLocal = null; // estatus mostrado con los chips (solo en pantalla)
            function actualizarResumen() {
                const filas = [...document.querySelectorAll('#ov-tbody tr[data-index]')];
                const cont = $id('ovResumen');
                if (!filas.length) { cont.innerHTML = ''; return; }
                const porEst = {};
                let kg = 0, imp = 0, vivas = 0;
                filas.forEach(tr => {
                    const e = tr.dataset.estatus;
                    porEst[e] = (porEst[e] || 0) + 1;
                    if (e !== '0' && tr.style.display !== 'none') { kg += Number(tr.dataset.kg || 0); imp += Number(tr.dataset.importe || 0); vivas++; }
                });
                const orden = ['1', '2', '4', '5', '6', '0'];
                const chips = orden.filter(e => porEst[e]).map(e => `<button type="button" class="ov-chip ${filtroLocal === e ? 'is-on' : ''}" data-est="${e}" aria-pressed="${filtroLocal === e}"><span class="badge-est ${CLASE_EST[e]}" style="padding:0;background:none">${TEXTO_EST[e]}</span><span class="n">${porEst[e]}</span></button>`).join('');
                cont.innerHTML = `<span><b>${filas.length}</b> órdenes</span><span class="sep"></span>${chips}<span class="sep"></span><span>Sin canceladas${filtroLocal ? ' (filtro en pantalla)' : ''}: <b>${vivas}</b> · <b>${fmtNum(kg)}</b> kg · <b>${fmtMoney(imp)}</b></span>`;
            }
            $id('ovResumen').addEventListener('click', e => {
                const chip = e.target.closest('.ov-chip');
                if (!chip) return;
                filtroLocal = filtroLocal === chip.dataset.est ? null : chip.dataset.est;
                aplicarFiltroLocal();
            });
            function aplicarFiltroLocal() {
                document.querySelectorAll('#ov-tbody tr[data-index]').forEach(tr => tr.style.display = (!filtroLocal || tr.dataset.estatus === filtroLocal) ? '' : 'none');
                actualizarResumen();
            }

            // ================= Ordenar por encabezado =================
            const sortState = { index: null, dir: null };
            const tabla = document.querySelector('.orders-grid');
            const ths = [...tabla.querySelectorAll('thead th')];
            function valorCelda(tr, index, type) {
                const td = tr.children[index];
                const v = (td?.dataset.copy ?? td?.innerText ?? '').trim();
                if (type === 'num') { const n = parseFloat(v.replace(/[^\d.-]/g, '')); return isNaN(n) ? 0 : n; }
                if (type === 'date') return isoFecha(v) || '0000';
                return v.toUpperCase();
            }
            function aplicarOrden() {
                const tbody = $id('ov-tbody');
                const rows = [...tbody.querySelectorAll('tr[data-index]')];
                if (!rows.length) return;
                if (sortState.index == null) rows.sort((a, b) => Number(a.dataset.index) - Number(b.dataset.index));
                else {
                    const type = ths[sortState.index].dataset.sortType || 'text';
                    rows.sort((a, b) => { const va = valorCelda(a, sortState.index, type), vb = valorCelda(b, sortState.index, type); return va < vb ? -1 : va > vb ? 1 : 0; });
                    if (sortState.dir === 'desc') rows.reverse();
                }
                rows.forEach(r => tbody.appendChild(r));
                ths.forEach((th, i) => { th.classList.toggle('asc', i === sortState.index && sortState.dir === 'asc'); th.classList.toggle('desc', i === sortState.index && sortState.dir === 'desc'); th.setAttribute('aria-sort', i === sortState.index ? (sortState.dir === 'asc' ? 'ascending' : 'descending') : 'none'); });
            }
            ths.forEach((th, index) => {
                if (!th.dataset.sortCol) return;
                th.addEventListener('click', () => {
                    if (sortState.index === index) { sortState.dir = sortState.dir === 'asc' ? 'desc' : sortState.dir === 'desc' ? null : 'asc'; if (!sortState.dir) sortState.index = null; }
                    else { sortState.index = index; sortState.dir = 'asc'; }
                    aplicarOrden();
                });
            });

            // ================= Actualización automática =================
            // CORRECCIÓN: antes buscaba un contenedor que no existía en la pantalla, así que nunca
            // actualizaba. Ahora refresca el listado cada 30 s si la pestaña está visible, no hay
            // ningún modal abierto y no estás escribiendo; conserva el orden y el filtro en pantalla,
            // y resalta las órdenes nuevas.
            const REFRESH_MS = 30000;
            const userIsEditing = () => document.querySelector('input:focus, textarea:focus, select:focus, [contenteditable="true"]:focus');
            const hayModal = () => document.querySelector('.modal.show') || !$id('cancelConfirmOverlay').classList.contains('d-none') || document.querySelector('.dropdown-menu.show');
            let refrescando = false;
            async function softRefreshListado() {
                if (refrescando || document.hidden || hayModal() || userIsEditing()) return;
                refrescando = true;
                try {
                    const resp = await fetch(location.href, { cache: 'no-store', headers: { 'Accept': 'text/html' } });
                    if (!resp.ok) return;
                    const doc = new DOMParser().parseFromString(await resp.text(), 'text/html');
                    const nuevo = doc.getElementById('ov-tbody');
                    if (!nuevo || hayModal()) return;
                    const antes = new Set([...document.querySelectorAll('#ov-tbody tr[data-id]')].map(tr => tr.dataset.id));
                    const docsPrevios = new Map([...document.querySelectorAll('#ov-tbody tr[data-id]')].map(tr => [tr.dataset.id, [tr.querySelector('.ov-doc-sap')?.outerHTML, tr.querySelector('.ov-doc-meat')?.outerHTML]]));
                    $id('ov-tbody').innerHTML = nuevo.innerHTML;
                    document.querySelectorAll('#ov-tbody tr[data-id]').forEach(tr => {
                        const prev = docsPrevios.get(tr.dataset.id);
                        if (prev) { // se conservan los documentos ya pintados mientras se vuelven a consultar
                            if (prev[0]) tr.querySelector('.ov-doc-sap').outerHTML = prev[0];
                            if (prev[1]) tr.querySelector('.ov-doc-meat').outerHTML = prev[1];
                        } else if (antes.size) tr.classList.add('is-recien');
                    });
                    aplicarOrden();
                    aplicarFiltroLocal();
                    cargarDocumentosListadoOV();
                    $id('ovRefrescoTxt').textContent = 'Actualizado ' + new Date().toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' });
                } catch (e) { console.error('Error al actualizar el listado:', e); }
                finally { refrescando = false; }
            }
            setInterval(softRefreshListado, REFRESH_MS);
            document.addEventListener('visibilitychange', () => {
                $id('ovRefresco').classList.toggle('is-off', document.hidden);
                if (!document.hidden) softRefreshListado();
            });

            // ================= Modal: subpedidos =================
            async function cargarSubpedidosOV(consecutivoOV) {
                const tbody = $id('ovm-sub-tbody'), lblCount = $id('ovm-sub-count');
                tbody.innerHTML = '<tr class="t-msg"><td colspan="5">Cargando subpedidos…</td></tr>';
                lblCount.textContent = '0';
                if (!consecutivoOV) { tbody.innerHTML = '<tr class="t-msg"><td colspan="5">Sin consecutivo de OV.</td></tr>'; return; }
                try {
                    const resp = await fetch(`/Comercial/SubpedidosPorOV2?consecutivoOV=${encodeURIComponent(consecutivoOV)}`, { cache: 'no-store' });
                    if (!resp.ok) throw new Error('HTTP ' + resp.status);
                    const lista = await resp.json();
                    if (!Array.isArray(lista) || !lista.length) { tbody.innerHTML = '<tr class="t-msg"><td colspan="5">Esta OV no tiene subpedidos.</td></tr>'; return; }
                    lblCount.textContent = String(lista.length);
                    tbody.innerHTML = lista.map((sp, i) => {
                        const meat = String(sp.u_DocMeat ?? '').trim();
                        return `<tr data-subid="${esc(sp.id)}">
                                    <td>${i + 1}</td>
                                    <td style="font-weight:600">${esc(sp.subFolio || '')}</td>
                                    <td>${esc(sp.documentoSAP || '—')}</td>
                                    <td><input type="text" class="form-control sp-docmeat ${meat ? 'doc-meat-ok' : 'doc-meat-empty'}" value="${esc(meat)}" data-original="${esc(meat)}" aria-label="Documento Meat del subpedido ${esc(sp.subFolio || '')}" /></td>
                                    <td class="text-center"><button type="button" class="ov-btn ov-btn-sm btn-sp-docmeat-guardar" disabled>Guardar</button></td>
                                </tr>`;
                    }).join('');
                } catch (e) {
                    console.error(e);
                    tbody.innerHTML = '<tr class="t-msg"><td colspan="5" style="color:var(--es-bad)">Error al cargar los subpedidos.</td></tr>';
                }
            }
            // El botón Guardar solo se activa si cambiaste el documento
            $id('ovm-sub-tbody').addEventListener('input', e => {
                const inp = e.target.closest('.sp-docmeat');
                if (!inp) return;
                const cambio = inp.value.trim() !== (inp.dataset.original || '');
                inp.classList.toggle('is-changed', cambio);
                const btn = inp.closest('tr').querySelector('.btn-sp-docmeat-guardar');
                btn.disabled = !cambio;
                btn.classList.toggle('ov-btn-primary', cambio);
            });

            // ================= Modal: catálogo de series =================
            let catalogoSeries = [];
            async function cargarCatalogoSeries() {
                if (catalogoSeries.length) return;
                const resp = await fetch('/Comercial/SeriesCatalogo', { cache: 'no-store' });
                if (resp.ok) catalogoSeries = await resp.json();
            }

            const escapeRegExp = s => (s ?? '').replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
            function soloNombreProducto(nombre, codigo) {
                const d = (nombre ?? '').trim(), c = (codigo ?? '').trim();
                if (!d) return '';
                if (c) {
                    const m = d.match(new RegExp('^' + escapeRegExp(c) + '\\s*\\((.*)\\)\\s*$', 'i'));
                    if (m && m[1]) return m[1].trim();
                    return d.replace(new RegExp('^' + escapeRegExp(c) + '\\s*[-–—:]?\\s*', 'i'), '').trim();
                }
                const m2 = d.match(/^\((.*)\)$/);
                return (m2 && m2[1]) ? m2[1].trim() : d;
            }

            // ================= Modal: abrir orden =================
            const modal = () => bootstrap.Modal.getOrCreateInstance($id('ovModal'));
            let cargandoId = null;
            async function cargarDetalle(id, consecutivo) {
                cargandoId = id;
                const tbody = $id('ovm-tbody');
                tbody.innerHTML = '<tr class="t-msg"><td colspan="7">Cargando…</td></tr>';
                $id('ovm-consecutivo').textContent = consecutivo || '';
                salirEdicionEntrega(); salirEdicionObservacion();
                try {
                    const resp = await fetch(`/Comercial/OrdenDetalleApi?id=${encodeURIComponent(id)}`, { cache: 'no-store' });
                    if (!resp.ok) throw new Error('HTTP ' + resp.status);
                    const payload = await resp.json();
                    if (cargandoId !== id) return;
                    const h = payload.header || {};
                    await cargarCatalogoSeries();

                    // Serie
                    const selSerie = $id('ovm-serie');
                    selSerie.innerHTML = catalogoSeries.map(s => `<option value="${esc(s.id)}">${esc(s.nombre)}</option>`).join('');
                    const encontrada = h.serie ? catalogoSeries.find(s => String(s.nombre).trim().toUpperCase() === String(h.serie).trim().toUpperCase()) : null;
                    if (encontrada) selSerie.value = String(encontrada.id);
                    else {
                        // CORRECCIÓN: si la serie de la orden no está en el catálogo, antes se mostraba la
                        // primera serie de la lista como si fuera la de la orden. Ahora se muestra la real.
                        selSerie.insertAdjacentHTML('afterbegin', `<option value="" disabled>${esc(h.serie || 'Sin serie')} (no está en el catálogo)</option>`);
                        selSerie.value = '';
                    }
                    selSerie.setAttribute('data-prev', selSerie.value);

                    // Observación
                    const obsEl = $id('ovm-observacion');
                    const obs = String(h.observacion ?? '').trim();
                    obsEl.dataset.valor = obs;
                    obsEl.textContent = obs || 'Sin observaciones.';
                    obsEl.classList.toggle('vacia', !obs);

                    ordenIdActual = h.id || id;
                    estatusActual = h.estatus;
                    $id('ovm-consecutivo').textContent = consecutivo || h.consecutivo || '';
                    $id('ovm-cliente').textContent = h.cliente || '';
                    $id('ovm-cliente-nombre').textContent = h.clienteNombre || '';
                    $id('ovm-cliente').parentElement.title = `${h.cliente || ''} · ${h.clienteNombre || ''}`;
                    $id('ovm-vendedor').textContent = h.vendedor || '';
                    $id('ovm-fecha-reg').textContent = fmtDateTime(h.fechaRegistro);
                    const fEnt = $id('ovm-fecha-ent');
                    fEnt.dataset.iso = isoFecha(h.fechaEntrega);
                    fEnt.textContent = fmtDate(h.fechaEntrega) || 'Sin fecha';
                    const est = $id('ovm-estatus');
                    est.textContent = estatusTexto(h);
                    est.className = 'badge-est ' + (CLASE_EST[h.estatus] || '');
                    $id('ovm-auto').textContent = h.autorizacionPendiente || '—';

                    // Artículos
                    const lineas = payload.lineas || [];
                    let tPeso = 0, tCajas = 0, tImp = 0;
                    const nLimpio = v => Number(String(v ?? 0).replace(/[^\d.-]/g, '')) || 0;
                    tbody.innerHTML = lineas.length ? lineas.map((l, i) => {
                        const peso = nLimpio(l.peso), cajas = nLimpio(l.cajas), precio = nLimpio(l.precio), imp = peso * precio;
                        tPeso += peso; tCajas += cajas; tImp += imp;
                        return `<tr>
                                    <td>${i + 1}</td>
                                    <td>${esc(l.productoCodigo ?? '')}</td>
                                    <td>${esc(soloNombreProducto(l.productoNombre, l.productoCodigo))}</td>
                                    <td class="num" data-copy="${cajas}">${fmtNum(cajas, 0)}</td>
                                    <td class="num" data-copy="${peso}">${fmtNum(peso)}</td>
                                    <td class="num" data-copy="${precio}">${fmtMoney(precio)}</td>
                                    <td class="num" data-copy="${Math.round(imp * 100) / 100}">${fmtMoney(imp)}</td>
                                </tr>`;
                    }).join('') : '<tr class="t-msg"><td colspan="7">Sin artículos.</td></tr>';
                    $id('ovm-total-cajas').textContent = fmtNum(tCajas, 0);
                    $id('ovm-total-peso').textContent = fmtNum(tPeso);
                    $id('ovm-total-imp').textContent = fmtMoney(tImp);

                    toggleCancelarBtn(estatusActual);
                    $id('btn-pdf-ov').disabled = !ordenIdActual;
                    modal().show(); // CORRECCIÓN: se reutiliza el mismo modal (antes se creaba uno nuevo cada vez)
                    await cargarSubpedidosOV(h.consecutivo || consecutivo);
                } catch (e) {
                    console.error(e);
                    tbody.innerHTML = '<tr class="t-msg"><td colspan="7" style="color:var(--es-bad)">Error al cargar el detalle de la orden.</td></tr>';
                    modal().show();
                }
            }
            document.addEventListener('click', ev => {
                const a = ev.target.closest('a.ver-ov');
                if (!a) return;
                ev.preventDefault();
                if (a.dataset.id) cargarDetalle(a.dataset.id, a.dataset.cons);
            });

            // ================= Fecha de embarque =================
            const entregaLabel = $id('ovm-fecha-ent'), entregaActions = $id('ovm-entrega-actions'), inputEntrega = $id('ovm-entrega-input');
            const btnGuardarEnt = $id('ovm-entrega-guardar'), btnCancelEnt = $id('ovm-entrega-cancelar');
            function enterEditEntrega() {
                inputEntrega.value = entregaLabel.dataset.iso || new Date().toISOString().slice(0, 10);
                entregaLabel.classList.add('d-none');
                entregaActions.classList.remove('d-none');
                setTimeout(() => inputEntrega.focus(), 0);
            }
            function salirEdicionEntrega() { entregaActions.classList.add('d-none'); entregaLabel.classList.remove('d-none'); }
            entregaLabel.addEventListener('click', enterEditEntrega);
            entregaLabel.addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); enterEditEntrega(); } });
            btnCancelEnt.addEventListener('click', salirEdicionEntrega);
            inputEntrega.addEventListener('keydown', e => { if (e.key === 'Escape') { e.stopPropagation(); salirEdicionEntrega(); } if (e.key === 'Enter') btnGuardarEnt.click(); });
            btnGuardarEnt.addEventListener('click', async () => {
                if (!ordenIdActual) return;
                if (!inputEntrega.value) { showMsg('warning', 'Selecciona una fecha.'); return; }
                if (inputEntrega.value === entregaLabel.dataset.iso) { salirEdicionEntrega(); return; }
                try {
                    btnGuardarEnt.disabled = true;
                    const resp = await fetch(`/Comercial/ActualizarFechaEntrega?id=${encodeURIComponent(ordenIdActual)}&nuevaFechaEntrega=${encodeURIComponent(inputEntrega.value)}`, {
                        method: 'POST', headers: { 'Accept': 'application/json', 'RequestVerificationToken': getAntiForgeryToken() }
                    });
                    const json = await leerJson(resp);
                    if (!resp.ok || json.ok === false) { showMsg('danger', json.msg || `No se pudo guardar la fecha (${resp.status}).`); return; }
                    const iso = isoFecha(json.fechaEntrega) || inputEntrega.value;
                    entregaLabel.dataset.iso = iso;
                    entregaLabel.textContent = fmtDate(iso);
                    const td = filaDeOrden(ordenIdActual)?.querySelector('.td-fecha-embarcar');
                    if (td) td.textContent = iso;
                    showMsg('success', 'Fecha de embarque actualizada.');
                    salirEdicionEntrega();
                } catch (e) { console.error(e); showMsg('danger', 'Error de red al guardar la fecha.'); }
                finally { btnGuardarEnt.disabled = false; }
            });

            // ================= Observación =================
            const obsVista = $id('ovm-observacion-vista'), obsLabel = $id('ovm-observacion'), obsActions = $id('ovm-observacion-actions'), obsInput = $id('ovm-observacion-input');
            const btnGuardarObs = $id('ovm-observacion-guardar');
            const contarObs = () => $id('ovm-obs-cuenta').textContent = obsInput.value.length;
            function entrarEdicionObservacion() {
                obsInput.value = obsLabel.dataset.valor || '';
                contarObs();
                obsVista.classList.add('d-none');
                obsActions.classList.remove('d-none');
                setTimeout(() => { obsInput.focus(); obsInput.setSelectionRange(obsInput.value.length, obsInput.value.length); }, 0);
            }
            function salirEdicionObservacion() { obsActions.classList.add('d-none'); obsVista.classList.remove('d-none'); }
            $id('ovm-observacion-editar').addEventListener('click', entrarEdicionObservacion);
            $id('ovm-observacion-cancelar').addEventListener('click', salirEdicionObservacion);
            obsInput.addEventListener('input', contarObs);
            obsInput.addEventListener('keydown', ev => {
                if (ev.key === 'Escape') { ev.stopPropagation(); salirEdicionObservacion(); }
                if (ev.ctrlKey && ev.key === 'Enter') { ev.preventDefault(); btnGuardarObs.click(); }
            });
            btnGuardarObs.addEventListener('click', async () => {
                if (!ordenIdActual) { showMsg('warning', 'No se encontró la orden.'); return; }
                const nueva = obsInput.value.trim(), anterior = obsLabel.dataset.valor || '';
                if (nueva.length > 500) { showMsg('warning', 'La observación no puede superar 500 caracteres.'); return; }
                if (nueva === anterior) { salirEdicionObservacion(); return; }
                if (!nueva && !confirm('¿Eliminar la observación de esta orden?')) return;
                const txt = btnGuardarObs.textContent;
                try {
                    btnGuardarObs.disabled = true; btnGuardarObs.textContent = 'Guardando…';
                    const body = new URLSearchParams({ ordenVentaId: String(ordenIdActual), observacion: nueva });
                    const resp = await fetch('/Comercial/ActualizarObservacionOV', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8', 'Accept': 'application/json', 'RequestVerificationToken': getAntiForgeryToken() },
                        body: body.toString()
                    });
                    const json = await leerJson(resp);
                    if (!resp.ok || json.ok === false) { showMsg('danger', json.msg || `No fue posible actualizar la observación (${resp.status}).`); return; }
                    const guardada = String(json.observacion ?? nueva).trim();
                    obsLabel.dataset.valor = guardada;
                    obsLabel.textContent = guardada || 'Sin observaciones.';
                    obsLabel.classList.toggle('vacia', !guardada);
                    salirEdicionObservacion();
                    showMsg('success', 'Observación actualizada.');
                } catch (e) { console.error(e); showMsg('danger', 'Error de red al actualizar la observación.'); }
                finally { btnGuardarObs.disabled = false; btnGuardarObs.textContent = txt; }
            });

            // ================= Documento Meat de un subpedido =================
            document.addEventListener('click', async ev => {
                const btn = ev.target.closest('.btn-sp-docmeat-guardar');
                if (!btn) return;
                const tr = btn.closest('tr');
                const subId = parseInt(tr?.dataset.subid || '0', 10);
                const input = tr?.querySelector('.sp-docmeat');
                const nuevo = (input?.value || '').trim();
                if (!subId) { showMsg('danger', 'Subpedido inválido.'); return; }
                if (!confirm(`¿Actualizar el documento Meat de este subpedido a "${nuevo || '(vacío)'}"?`)) return;
                const old = btn.textContent;
                btn.disabled = true; btn.textContent = 'Guardando…';
                try {
                    const resp = await fetch('/Comercial/SubpedidoActualizarDocMeat', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'RequestVerificationToken': getAntiForgeryToken() },
                        body: JSON.stringify({ subpedidoId: subId, u_DocMeat: nuevo })
                    });
                    const json = await leerJson(resp);
                    if (!resp.ok || json.ok === false) { showMsg('danger', json.msg || `No se pudo guardar (${resp.status}).`); btn.disabled = false; return; }
                    const valor = json.u_DocMeat !== undefined ? String(json.u_DocMeat ?? '') : nuevo;
                    input.value = valor; input.dataset.original = valor;
                    input.classList.remove('is-changed');
                    input.classList.toggle('doc-meat-empty', !valor); input.classList.toggle('doc-meat-ok', !!valor);
                    btn.classList.remove('ov-btn-primary');
                    const cons = $id('ovm-consecutivo').textContent.trim();
                    const fila = filaDeOrden(ordenIdActual);
                    if (fila) await pintarDocumentosOV(fila, true); else ovDocumentosCache.delete(cons);
                    showMsg('success', 'Documento Meat actualizado.');
                } catch (e) { console.error(e); showMsg('danger', 'Error de red al guardar el documento Meat.'); btn.disabled = false; }
                finally { btn.textContent = old; }
            });

            // ================= Serie de la orden =================
            $id('ovm-serie').addEventListener('change', async function() {
                if (!ordenIdActual) return;
                const select = this, nueva = select.value, anterior = select.getAttribute('data-prev') ?? '';
                if (!confirm(`¿Cambiar la serie de esta orden a ${select.options[select.selectedIndex]?.text || ''}?`)) { select.value = anterior; return; }
                try {
                    const resp = await fetch('/Comercial/ActualizarSerieOV', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': getAntiForgeryToken() },
                        body: new URLSearchParams({ ordenVentaId: String(ordenIdActual), serieId: String(nueva) }).toString()
                    });
                    const json = await leerJson(resp);
                    if (!resp.ok || json.ok === false) { showMsg('danger', json.msg || 'Error al actualizar la serie.'); select.value = anterior; return; }
                    select.setAttribute('data-prev', nueva);
                    select.querySelector('option[value=""][disabled]')?.remove();
                    const td = filaDeOrden(ordenIdActual)?.querySelector('.td-serie');
                    if (td) td.textContent = json.serieNombre || select.options[select.selectedIndex]?.text || td.textContent;
                    showMsg('success', 'Serie actualizada.');
                } catch (e) { console.error(e); showMsg('danger', 'Error de red al actualizar la serie.'); select.value = anterior; }
            });

            // ================= Cancelar pedido =================
            const btnCancelarOV = $id('btn-cancelar-ov');
            function toggleCancelarBtn(estatus) {
                const cancelado = Number(estatus) === 0;
                btnCancelarOV.classList.toggle('d-none', cancelado);
                btnCancelarOV.disabled = cancelado;
            }
            btnCancelarOV.addEventListener('click', async () => {
                if (!ordenIdActual) { showMsg('warning', 'No se encontró la orden.'); return; }
                if (Number(estatusActual) === 0) { showMsg('warning', 'Este pedido ya está cancelado.'); return; }
                const cons = $id('ovm-consecutivo').textContent || '';
                if (!(await confirmarCancelacionFlotante(cons))) { showMsg('info', 'No se canceló el pedido.'); return; }
                const html = btnCancelarOV.innerHTML;
                try {
                    btnCancelarOV.disabled = true; btnCancelarOV.textContent = 'Cancelando…';
                    const resp = await fetch(`/Comercial/CancelarOV?id=${encodeURIComponent(ordenIdActual)}`, {
                        method: 'POST', headers: { 'Accept': 'application/json', 'RequestVerificationToken': getAntiForgeryToken() }
                    });
                    const json = await leerJson(resp);
                    if (resp.status === 404) { showMsg('danger', `No se pudo cancelar el pedido: ${json.msg || 'orden no encontrada.'}`); return; }
                    if (resp.status === 400) { showMsg('danger', `No se pudo cancelar el pedido: ${json.msg || 'solicitud inválida o sesión vencida.'}`); return; }
                    if (resp.status === 409) { showMsg('warning', `No se canceló el pedido: ${json.msg || 'tiene cajas asignadas o existe otra restricción.'}`); return; }
                    if (!resp.ok || json.ok === false) { showMsg('danger', `No se pudo cancelar el pedido: ${json.msg || `error HTTP ${resp.status}.`}`); return; }

                    estatusActual = 0;
                    const est = $id('ovm-estatus');
                    est.textContent = json.estatus || 'Cancelado';
                    est.className = 'badge-est est-0';
                    const tr = filaDeOrden(ordenIdActual);
                    if (tr) {
                        tr.querySelector('.td-estatus').innerHTML = '<span class="badge-est est-0">Cancelado</span>';
                        tr.dataset.estatus = '0';
                        tr.classList.add('is-cancelada');
                        aplicarFiltroLocal();
                    }
                    let msg = 'Pedido cancelado en SIGO.';
                    const sc = Number(json.docsSapCancelados || 0), sn = Number(json.docsSapNoCancelados || 0), mc = Number(json.docsMeatCancelados || 0), mn = Number(json.docsMeatNoCancelados || 0);
                    if (sc || sn) msg += ` SAP: ${sc} cancelado(s), ${sn} sin cancelar.`;
                    if (mc || mn) msg += ` MEAT: ${mc} cancelado(s), ${mn} sin cancelar.`;
                    if (json.msg) msg += ` ${json.msg}`;
                    showMsg((sn || mn) ? 'warning' : 'success', msg, (sn || mn) ? 0 : 7000);
                } catch (err) {
                    console.error(err);
                    showMsg('danger', 'No se pudo cancelar el pedido: error de red. Revisa el estatus antes de reintentar.');
                } finally {
                    btnCancelarOV.innerHTML = html;
                    toggleCancelarBtn(estatusActual);
                }
            });

            // ================= Filtro de estatus =================
            const ddRoot = $id('dd-estatus'), ddBtn = $id('dd-estatus-btn');
            const checks = [...ddRoot.querySelectorAll('.multi-check-estatus')];
            function refrescarEstatus() {
                const hidden = $id('dd-estatus-hidden');
                hidden.innerHTML = '';
                const textos = [];
                checks.forEach(ch => {
                    if (!ch.checked) return;
                    textos.push(ch.dataset.text || ch.value);
                    // CORRECCIÓN: "Pendiente" agrupa los estatus 1 y 3; antes solo se mandaba el 1 al
                    // volver a filtrar, y las órdenes en estatus 3 desaparecían aunque se viera marcado.
                    (ch.dataset.values || ch.value).split(',').forEach(v => {
                        const inp = document.createElement('input');
                        inp.type = 'hidden'; inp.name = 'EstatusSeleccionados'; inp.value = v.trim();
                        hidden.appendChild(inp);
                    });
                });
                ddRoot.querySelector('.multi-label').textContent = !textos.length ? 'Todos' : textos.length <= 2 ? textos.join(', ') : `${textos.length} seleccionados`;
                ddBtn.classList.toggle('has-value', textos.length > 0);
            }
            checks.forEach(ch => ch.addEventListener('change', refrescarEstatus));
            $id('est-todos').addEventListener('click', () => { checks.forEach(c => c.checked = true); refrescarEstatus(); });
            $id('est-ninguno').addEventListener('click', () => { checks.forEach(c => c.checked = false); refrescarEstatus(); });
            const normTxt = s => (s ?? '').toString().normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
            const buscador = ddRoot.querySelector('.multi-picker-search');
            buscador.addEventListener('input', () => {
                const words = normTxt(buscador.value).split(/\s+/).filter(Boolean);
                ddRoot.querySelectorAll('.multi-picker-option').forEach(opt => { const t = normTxt(opt.innerText); opt.style.display = words.every(w => t.includes(w)) ? 'flex' : 'none'; });
            });
            ddRoot.addEventListener('shown.bs.dropdown', () => setTimeout(() => { buscador.focus(); buscador.select(); }, 0));
            $id('frmPedidos').addEventListener('submit', refrescarEstatus);

            // ================= Copiar con clic derecho =================
            (function() {
                const menu = $id('ovCtxMenu');
                let ctx = null;
                const limpio = t => (t || '').replace(/\s+/g, ' ').trim();
                const columnasCopiables = t => [...t.tHead.rows[0].cells].map((th, i) => th.classList.contains('no-copy') ? -1 : i).filter(i => i >= 0);
                function textoCelda(td) {
                    if (!td) return '';
                    if (td.dataset.copy !== undefined) return td.dataset.copy;
                    const inp = td.querySelector('input');
                    if (inp) return inp.value.trim();
                    const t = limpio(td.innerText);
                    if (t === '—' || t === '…') return '';
                    if (td.classList.contains('num')) { const n = t.replace(/[$,\s]|kg/gi, ''); if (n && !isNaN(Number(n))) return n; }
                    return t;
                }
                const filasDatos = t => [...t.tBodies[0].rows].filter(r => !r.classList.contains('t-msg') && r.style.display !== 'none');
                const encabezados = t => { const cols = columnasCopiables(t); return cols.map(i => limpio(t.tHead.rows[0].cells[i].innerText)); };
                const filaTexto = (t, tr) => columnasCopiables(t).map(i => textoCelda(tr.cells[i]));
                const aTsv = f => f.map(r => r.map(v => /[\t\n"]/.test(v) ? `"${v.replace(/"/g, '""')}"` : v).join('\t')).join('\r\n');
                const aHtml = (f, enc) => `<table>${f.map((r, i) => `<tr>${r.map(v => (enc && i === 0) ? `<th>${esc(v)}</th>` : `<td>${esc(v)}</td>`).join('')}</tr>`).join('')}</table>`;
                async function copiar(filas, enc, msg) {
                    const tsv = aTsv(filas);
                    try {
                        if (window.ClipboardItem && navigator.clipboard?.write) await navigator.clipboard.write([new ClipboardItem({ 'text/plain': new Blob([tsv], { type: 'text/plain' }), 'text/html': new Blob([aHtml(filas, enc)], { type: 'text/html' }) })]);
                        else if (navigator.clipboard?.writeText) await navigator.clipboard.writeText(tsv);
                        else throw 0;
                        showMsg('success', msg, 2500);
                    } catch {
                        const ta = document.createElement('textarea');
                        ta.value = tsv; ta.style.cssText = 'position:fixed;left:-9999px;top:0';
                        (document.querySelector('.modal.show') || document.body).appendChild(ta);
                        ta.select();
                        const ok = document.execCommand('copy'); ta.remove();
                        showMsg(ok ? 'success' : 'warning', ok ? msg : 'No se pudo copiar; usa Exportar.', 3000);
                    }
                }
                function cerrar() { menu.classList.remove('show'); document.querySelectorAll('.ctx-cell').forEach(x => x.classList.remove('ctx-cell')); ctx = null; }
                function abrir(e, t, etiqueta) {
                    const n = filasDatos(t).length;
                    if (!n) return;
                    e.preventDefault();
                    cerrar();
                    const td = e.target.closest('td');
                    const tr = td?.closest('tr');
                    const valida = tr && tr.parentElement === t.tBodies[0] && !tr.classList.contains('t-msg') && !td.classList.contains('no-copy');
                    ctx = { t, fila: valida ? tr : null, celda: valida ? td : null };
                    if (ctx.celda) ctx.celda.classList.add('ctx-cell');
                    menu.querySelector('[data-copiar="fila"]').hidden = !ctx.fila;
                    menu.querySelector('[data-copiar="celda"]').hidden = !ctx.celda;
                    menu.querySelector('.lbl').textContent = etiqueta;
                    $id('ovCtxFilas').textContent = `${n} renglón${n === 1 ? '' : 'es'}`;
                    menu.classList.add('show');
                    const r = menu.getBoundingClientRect();
                    menu.style.left = Math.min(e.clientX, innerWidth - r.width - 8) + 'px';
                    menu.style.top = Math.min(e.clientY, innerHeight - r.height - 8) + 'px';
                    menu.querySelector('button:not([hidden])')?.focus();
                }
                tabla.addEventListener('contextmenu', e => abrir(e, tabla, 'Copiar listado (renglones visibles)'));
                $id('ovm-detalle').addEventListener('contextmenu', e => abrir(e, $id('ovm-detalle'), 'Copiar artículos'));
                menu.addEventListener('click', async e => {
                    const b = e.target.closest('button[data-copiar]');
                    if (!b || !ctx) return;
                    const { t, fila, celda } = ctx, accion = b.dataset.copiar;
                    cerrar();
                    if (accion === 'tabla') { const f = filasDatos(t).map(tr => filaTexto(t, tr)); await copiar([encabezados(t), ...f], true, `Copiado (${f.length} renglones). Pégalo en Excel con Ctrl+V.`); }
                    else if (accion === 'fila' && fila) await copiar([encabezados(t), filaTexto(t, fila)], true, 'Renglón copiado con encabezados.');
                    else if (accion === 'celda' && celda) await copiar([[textoCelda(celda)]], false, 'Celda copiada.');
                });
                document.addEventListener('click', e => { if (menu.classList.contains('show') && !menu.contains(e.target)) cerrar(); });
                document.addEventListener('keydown', e => {
                    if (!menu.classList.contains('show')) return;
                    if (e.key === 'Escape') { e.preventDefault(); e.stopPropagation(); cerrar(); return; }
                    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
                        e.preventDefault();
                        const bs = [...menu.querySelectorAll('button:not([hidden])')];
                        const i = bs.indexOf(document.activeElement);
                        bs[(i + (e.key === 'ArrowDown' ? 1 : -1) + bs.length) % bs.length]?.focus();
                    }
                }, true);
                ['scroll', 'resize', 'blur'].forEach(ev => window.addEventListener(ev, () => { if (menu.classList.contains('show')) cerrar(); }, true));
            })();

            // ================= Manual =================
            window.manualConfig = {
                title: "Manual de Pedidos por Vendedor",
                sections: [
                    { id: "Manual de pedidos por vendedor", title: "Manual de pedidos por vendedor", icon: "fa-home", steps: [{ title: "Reportes", text: "Tutorial de uso", video: "/images/Reportes/Reportes_OV.mp4" }] },
                    { id: "Seguimiento de Autorizaciones", title: "Seguimiento de Autorizaciones", icon: "fa-file-lines", steps: [{ title: "Chat Interno", text: "Como contactar con las distintas areas", video: "/images/Reportes/Chat.mp4" }] }
                ]
            };

            // ================= Inicio =================
            refrescarEstatus();
            actualizarResumen();
            cargarDocumentosListadoOV();
        })();
    </script>
}
