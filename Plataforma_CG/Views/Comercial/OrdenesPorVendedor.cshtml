@using System.Linq
@model Plataforma_CG.Models.OrdenesOVFiltro

@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
}

<link rel="stylesheet" href="~/css/ordenes-ov-grid.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/ordenes-ov-erp-legible.css" asp-append-version="true" />

<div class="window ordenes-ov-app">
    <div class="titlebar">
        <div class="ov-main-title">
            <i class="bi bi-receipt-cutoff"></i>
            Órdenes de Venta :: SIGO
        </div>
        <div class="actions">
            <div class="win-btn"></div>
            <div class="win-btn"></div>
            <div class="win-btn"></div>
        </div>
    </div>
    @* 
    <div class="menubar">
        <div class="menu-item">Archivo</div>
        <div class="menu-item">Edición</div>
        <div class="menu-item">Consultas</div>
        <div class="menu-item">Procesos</div>
        <div class="menu-item">Herramientas</div>
        <div class="menu-item">Ayuda</div>
    </div> *@

    <div class="toolbar">
        @*  <button class="tool-btn" type="submit" form="frmPedidos">Buscar</button> *@
        @*   <button class="tool-btn" type="submit" form="frmPedidos" name="Export" value="csv">Exportar CSV</button> *@
        @*   <button class="tool-btn" type="button" onclick="location.reload()">Actualizar</button>  *@
    </div>

    <div class="content">

        
        <div class="workspace">
            <div class="section">
                <div class="section-title"><i class="bi bi-funnel"></i> Filtros de búsqueda</div>

                <form id="frmPedidos" method="get">
                    <div class="filters">
                        <div class="filter-group">
                            <label>Desde</label>
                            <input type="date" name="Desde" value="@(Model?.Desde?.ToString("yyyy-MM-dd") ?? "")" />
                        </div>

                        <div class="filter-group">
                            <label>Hasta</label>
                            <input type="date" name="Hasta" value="@(Model?.Hasta?.ToString("yyyy-MM-dd") ?? "")" />
                        </div>

                       

                        <div class="filter-group">
                            <label>Estatus</label>
                            @{
                                var ests = Model?.EstatusSeleccionados ?? new List<int>();
                                string TextoEstatus(IEnumerable<int> selec)
                                {
                                    if (selec == null || !selec.Any()) return "(Todos)";
                                    var nombres = new List<string>();
                                    if (selec.Contains(0)) nombres.Add("Cancelados");
                                    if (selec.Contains(1) || selec.Contains(3)) nombres.Add("Pendiente");
                                    if (selec.Contains(2)) nombres.Add("Autorización");
                                    if (selec.Contains(4)) nombres.Add("Validado");
                                    if (selec.Contains(5)) nombres.Add("Enviado a SAP");
                                    if (selec.Contains(6)) nombres.Add("Logistica");
                                    return string.Join(", ", nombres.Distinct());
                                }
                            }

                            <div class="dropdown w-100" id="dd-estatus">
                                <button class="btn-select-like w-100"
                                        type="button"
                                        data-bs-toggle="dropdown"
                                        data-bs-auto-close="outside"
                                        aria-expanded="false">
                                    <span class="multi-label">@TextoEstatus(ests)</span>
                                </button>

                                <div class="dropdown-menu multi-picker-menu" onclick="event.stopPropagation();">
                                    <input type="text"
                                           class="form-control multi-picker-search"
                                           placeholder="Buscar estatus..."
                                           autocomplete="off" />

                                    <div class="multi-picker-list">
                                        <label class="multi-picker-option">
                                            <input class="multi-check-estatus"
                                                   type="checkbox"
                                                   value="0"
                                                   id="est_0"
                                                   data-text="Cancelados"
                                            @(ests.Contains(0) ? "checked" : null) />
                                            <span>Cancelados</span>
                                        </label>

                                        <label class="multi-picker-option">
                                            <input class="multi-check-estatus"
                                                   type="checkbox"
                                                   value="1"
                                                   id="est_1"
                                                   data-text="Pendiente"
                                            @((ests.Contains(1) || ests.Contains(3)) ? "checked" : null) />
                                            <span>Pendiente</span>
                                        </label>

                                        <label class="multi-picker-option">
                                            <input class="form-check-input multi-check-estatus"
                                                   type="checkbox"
                                                   value="2"
                                                   id="est_2"
                                                   data-text="Autorización"
                                            @(ests.Contains(2) ? "checked" : null) />
                                            <span>Autorización</span>
                                        </label>

                                        <label class="multi-picker-option">
                                            <input class="multi-check-estatus"
                                                   type="checkbox"
                                                   value="4"
                                                   id="est_4"
                                                   data-text="Validado"
                                            @(ests.Contains(4) ? "checked" : null) />
                                            <span>Validado</span>
                                        </label>

                                        <label class="multi-picker-option">
                                            <input class="multi-check-estatus"
                                                   type="checkbox"
                                                   value="5"
                                                   id="est_5"
                                                   data-text="Enviado a SAP"
                                            @(ests.Contains(5) ? "checked" : null) />
                                            <span>Enviado a SAP</span>
                                        </label>

                                        <label class="multi-picker-option">
                                            <input class="multi-check-estatus"
                                                   type="checkbox"
                                                   value="6"
                                                   id="est_6"
                                                   data-text="Logistica"
                                            @(ests.Contains(6) ? "checked" : null) />
                                            <span>Logistica</span>
                                        </label>
                                    </div>
                                </div>

                                <div id="dd-estatus-hidden">
                                    @foreach (var e in ests)
                                    {
                                        <input type="hidden" name="EstatusSeleccionados" value="@e" />
                                    }
                                </div>
                            </div>
                        </div>

                        <div class="filter-group">
                            <label>Buscar</label>
                            <input type="text" name="Buscar" value="@(Model?.Buscar ?? "")" placeholder="Consecutivo / Cliente / Nombre" />
                        </div>

                        <div class="pm-actions">
                            <button class="pm-btn pm-btn-primary" type="submit">
                                <i class="bi bi-search"></i>
                                <span>Aplicar</span>
                            </button>

                            <button class="pm-btn pm-btn-excel"
                                    type="submit"
                                    form="frmPedidos"
                                    name="Export"
                                    value="xlsx">
                                <i class="bi bi-file-earmark-excel"></i>
                                <span>Exportar a Excel</span>
                            </button>

                            <button class="pm-btn pm-btn-excel"
                                    type="submit"
                                    form="frmPedidos"
                                    name="Export"
                                    value="csv">
                                <i class="bi bi-filetype-csv"></i>
                                <span>Exportar CSV</span>
                            </button>
                        </div>
                    </div>
                </form>
            </div>

            <div class="section">
                @* <div class="section-title">Listado de pedidos</div> *@

                @Html.AntiForgeryToken()

                <div class="table-wrap">
                    <table class="table table-sm table-hover align-middle orders-grid">
                        <thead>
                            <tr>
                                <th data-sort-col="cons" data-sort-type="text">Consecutivo</th>
                                <th data-sort-col="serie" data-sort-type="text">Serie</th>
                                <th data-sort-col="cliente" data-sort-type="text">ClienteId</th>
                                <th data-sort-col="nombre" data-sort-type="text">Nombre Cliente</th>
                                <th data-sort-col="vendedor" data-sort-type="text">Vendedor</th>
                                <th class="num" data-sort-col="kg" data-sort-type="num">Kilogramos</th>
                                <th class="num" data-sort-col="importe" data-sort-type="num">Importe</th>
                                <th data-sort-col="estatus" data-sort-type="text">Estatus</th>
                                <th data-sort-col="fent" data-sort-type="date">Fecha Embarcar</th>
                                <th data-sort-col="usuario" data-sort-type="text">Solicita</th>
                                <th class="ov-pdf-col">PDF</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model?.Resultados != null && Model.Resultados.Any())
                            {
                                var idx = 0;
                                foreach (var r in Model.Resultados)
                                {
                                    <tr data-index="@idx">
                                        <td>
                                            <a href="#"
                                               class="ver-ov"
                                               data-id="@(r?.Id)"
                                               data-cons="@(r?.Consecutivo ?? "")">
                                                @(r?.Consecutivo ?? "")
                                            </a>
                                        </td>
                                        <td class="td-serie">@(r?.Serie ?? "")</td>
                                        <td>@(r?.Cliente ?? "")</td>
                                        <td>@(r?.ClienteNombre ?? "")</td>
                                        <td>@(r?.Vendedor ?? "")</td>
                                        <td class="num">@string.Format("{0:N2} kg", r?.KgTotales ?? 0m)</td>
                                        <td class="num">@((r?.Importe ?? 0m).ToString("C"))</td>
                                        <td>
                                            @{
                                                var estVal = r?.Estatus ?? -1;
                                                var estClass = estVal == 0 ? "est-0"
                                                : (estVal == 1 || estVal == 3) ? "est-1"
                                                : estVal == 2 ? "est-2"
                                                : estVal == 4 ? "est-4"
                                                : estVal == 5 ? "est-5"
                                                : estVal == 6 ? "est-6" : "";

                                                var texto =
                                                estVal == 0 ? "Cancelado" :
                                                (estVal == 1 || estVal == 3) ? "Pendiente" :
                                                estVal == 2 ? "Autorización" :
                                                estVal == 4 ? "Validado" :
                                                estVal == 5 ? "Enviado a SAP" :
                                                estVal == 6 ? "Logistica" : "Otro";

                                                if (estVal == 2 && !string.IsNullOrWhiteSpace(r?.AutorizacionPendiente))
                                                {
                                                    texto += $" ({r.AutorizacionPendiente})";
                                                }
                                            }
                                            <span class="badge-est @estClass">@texto</span>
                                        </td>
                                        <td>@(r?.FechaEntrega?.ToString("yyyy-MM-dd") ?? "")</td>
                                        <td>@(r?.UsuarioRegistro ?? "")</td>
                                        <td class="ov-pdf-col">
                                            <a asp-controller="Comercial"
                                               asp-action="OrdenVentaPdf"
                                               asp-route-id="@(r?.Id)"
                                               asp-route-descargar="false"
                                               target="_blank"
                                               rel="noopener noreferrer"
                                               class="ov-pdf-action"
                                               title="Vista previa PDF e imprimir la orden @(r?.Consecutivo ?? "")"
                                               aria-label="Vista previa PDF e imprimir la orden @(r?.Consecutivo ?? "")">
                                                <i class="bi bi-file-earmark-pdf-fill" aria-hidden="true"></i>
                                            </a>
                                        </td>
                                    </tr>
                                    idx++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="11" class="text-center text-muted">Sin resultados.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            @if (ViewBag.MensajeSeries != null)
            {
                <div class="section">
                    <div class="section-title"><i class="bi bi-info-circle"></i> Mensaje del sistema</div>
                    <div style="padding:10px; color:#7c5900;">
                        @ViewBag.MensajeSeries
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="statusbar">
        <div>Registro listo</div>
        <div>Usuario: @User.Identity.Name</div>
        <div>Empresa: Carnes G SA de CV</div>
        <div>Módulo: Pedidos</div>
    </div>
</div>

<!-- Modal de detalle -->
<div class="modal fade" id="ovModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-ov-wide">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    Orden de Venta : <span id="ovm-consecutivo"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">
                <div class="header-row">
                    <div class="ov-col-4">
                        <strong>Cliente</strong>
                        <span><span id="ovm-cliente"></span> - <span id="ovm-cliente-nombre"></span></span>
                    </div>

                    <div class="ov-col-3">
                        <strong>Vendedor</strong>
                        <span id="ovm-vendedor"></span>
                    </div>

                    <div class="ov-col-2">
                        <strong>Serie</strong>
                        <select id="ovm-serie" class="form-select d-inline-block"></select>
                    </div>

                    <div class="ov-col-3">
                        <strong>Fecha Reg</strong>
                        <span id="ovm-fecha-reg"></span>
                    </div>

                    <div class="ov-col-3">
                        <strong>Embarcar</strong>
                        <span id="ovm-fecha-ent" class="editable-inline" title="Click para editar la fecha"></span>
                        <span id="ovm-entrega-actions" class="d-none">
                            <input type="date" class="form-control form-control-sm inline-date" id="ovm-entrega-input" />
                            <button class="small-btn" id="ovm-entrega-guardar" title="Guardar">Guardar</button>
                            <button class="small-btn" id="ovm-entrega-cancelar" title="Cancelar">Cancelar</button>
                        </span>
                    </div>

                    <div class="ov-col-2">
                        <strong>Estatus</strong>
                        <span id="ovm-estatus"></span>
                    </div>

                    <div class="ov-col-obs">
                        <strong>Observación</strong>

                        <div id="ovm-observacion-vista" class="observacion-vista">
                            <span id="ovm-observacion">Sin observaciones.</span>

                            <button type="button"
                                    class="small-btn"
                                    id="ovm-observacion-editar"
                                    title="Editar observación">
                                <i class="bi bi-pencil-square"></i>
                                Editar
                            </button>
                        </div>

                        <div id="ovm-observacion-actions" class="d-none">
                            <textarea id="ovm-observacion-input"
                                      class="form-control"
                                      maxlength="500"
                                      rows="3"
                                      placeholder="Escribe la observación correcta..."></textarea>

                            <div class="observacion-botones">
                                <button type="button"
                                        class="small-btn"
                                        id="ovm-observacion-guardar">
                                    Guardar
                                </button>

                                <button type="button"
                                        class="small-btn"
                                        id="ovm-observacion-cancelar">
                                    Cancelar
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-box">
                    @*  <div class="modal-box-title">Detalle de artículos</div> *@
                    <div class="modal-box-body">
                        <div class="table-wrap" style="max-height:220px;">
                            <table class="table table-sm align-middle ovm-detalle-table">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Artículo</th>
                                        <th>Descripción</th>
                                        <th class="num">Cajas</th>
                                        <th class="num">Peso</th>
                                        <th class="num">Precio</th>
                                        <th class="num">Importe</th>
                                    </tr>
                                </thead>
                                <tbody id="ovm-tbody">
                                    <tr>
                                        <td colspan="7" class="text-center text-muted">Cargando...</td>
                                    </tr>
                                    <tfoot>
                                        <tr>
                                            <th colspan="3" class="num">Totales:</th>
                                            <th class="num" id="ovm-total-cajas">0</th>   <!-- col 4: dorado -->
                                            <th class="num" id="ovm-total-peso">0.00</th>  <!-- col 5: dorado -->
                                            <th></th>
                                            <th class="num" id="ovm-total-imp">$0.00</th>
                                        </tr>
                                    </tfoot>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="modal-box">
                        <div class="modal-box-title">
                            Subpedidos (<span id="ovm-sub-count">0</span>)
                        </div>
                        <div class="modal-box-body">
                            <div class="table-wrap" style="max-height:190px;">
                                <table class="table table-sm align-middle">
                                    <thead>
                                        <tr>
                                            <th>#</th>
                                            <th>SubFolio</th>
                                            <th>Documento SAP</th>
                                            <th>Documento Meat</th>
                                            <th class="text-center">Acciones</th>
                                        </tr>
                                    </thead>
                                    <tbody id="ovm-sub-tbody">
                                        <tr>
                                            <td colspan="5" class="text-center text-muted">Sin subpedidos.</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer">
                    <small class="text-muted me-auto">Autorización: <span id="ovm-auto"></span></small>

                    <button type="button" class="btn btn-danger" id="btn-cancelar-ov">Cancelar pedido</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
                    // ========= utilidades =========
                    function getAntiForgeryToken(){
                        const el = document.querySelector('input[name="__RequestVerificationToken"]');
                        return el ? el.value : '';
                    }
                    function estatusTexto(h) {
                        let base =
                            h.estatus === 0 ? "Cancelado" :
                            (h.estatus === 1 || h.estatus === 3) ? "Pendiente" :
                            h.estatus === 2 ? "Autorización" :
                            h.estatus === 4 ? "Validado" :
                            h.estatus === 5 ? "Enviado a SAP" :
                            h.estatus === 6 ? "Logistica" : "Otro";
                        if (h.estatus === 2 && h.autorizacionPendiente) base += ` (${h.autorizacionPendiente})`;
                        return base;
                    }
                    function fmtNum(n, d=2){ if(n==null) return ""; return Number(n).toLocaleString(undefined,{minimumFractionDigits:d,maximumFractionDigits:d}); }
                    function fmtMoney(n){ if(n==null) return ""; return Number(n).toLocaleString(undefined,{style:'currency',currency:'MXN'}); }
                    function fmtDateTime(s){ if(!s) return ""; const dt=new Date(s); return isNaN(dt)? s : dt.toLocaleString(); }
                    function fmtDate(s){ if(!s) return ""; const dt=(s instanceof Date)?s:new Date(s); return isNaN(dt)? s : dt.toLocaleDateString(); }
                    function showMsg(type, text) {
                        const id = 'sap-alert'; let box = document.getElementById(id);
                        if (!box) { box = document.createElement('div'); box.id = id; document.body.prepend(box); }
                        box.innerHTML = `
                            <div class="alert alert-${type} alert-dismissible fade show m-3 shadow-sm" role="alert" style="position:sticky; top:0; z-index:2000;">
                                ${text || ''}
                                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                            </div>`;
                    }



                    // =====================================================
                    // VISTA PREVIA PDF / IMPRESIÓN DE ORDEN DE VENTA
                    // =====================================================
                    function construirUrlPdfOrdenVenta(id) {
                        const ordenId = Number(id || 0);
                        if (!Number.isInteger(ordenId) || ordenId <= 0) return '';

                        return `/Comercial/OrdenVentaPdf?id=${encodeURIComponent(ordenId)}&descargar=false`;
                    }

                    function abrirPdfOrdenVenta(id) {
                        const url = construirUrlPdfOrdenVenta(id);

                        if (!url) {
                            showMsg('warning', 'No se encontró el identificador de la orden de venta.');
                            return;
                        }

                        const ventana = window.open(url, '_blank', 'noopener,noreferrer');

                        if (!ventana) {
                            showMsg(
                                'warning',
                                'El navegador bloqueó la vista previa. Permite ventanas emergentes para abrir e imprimir el PDF.'
                            );
                        }
                    }

                    const btnPdfOrden = document.getElementById('btn-pdf-ov');
                    if (btnPdfOrden) {
                        btnPdfOrden.addEventListener('click', function () {
                            abrirPdfOrdenVenta(ordenIdActual);
                        });
                    }

                    const REFRESH_MS = 10000;

                    function userIsEditing() {
                        return document.querySelector('input:focus, textarea:focus, select:focus, [contenteditable="true"]:focus');
                    }

                    async function softRefreshListado() {
                        try {
                            const contActual = document.getElementById('ov-list-container');
                            if (!contActual) return;

                            const resp = await fetch(location.href, { cache: 'no-store' });
                            if (!resp.ok) return;

                            const html = await resp.text();
                            const parser = new DOMParser();
                            const doc = parser.parseFromString(html, 'text/html');

                            const contNuevo = doc.getElementById('ov-list-container');
                            if (!contNuevo) return;

                            contActual.innerHTML = contNuevo.innerHTML;
                        } catch (e) {
                            console.error('Error en softRefreshListado:', e);
                        }
                    }

                    let reloadTimer = setInterval(async () => {
                        const modalEl = document.getElementById('ovModal');
                        const isOpen = modalEl && modalEl.classList.contains('show');
                        if (isOpen || userIsEditing()) return;
                        await softRefreshListado();
                    }, REFRESH_MS);

                    const ovModalEl = document.getElementById('ovModal');
                    if (ovModalEl) {
                        ovModalEl.addEventListener('show.bs.modal', () => clearInterval(reloadTimer));
                        ovModalEl.addEventListener('hidden.bs.modal', () => {
                            reloadTimer = setInterval(async () => {
                                if (userIsEditing()) return;
                                await softRefreshListado();
                            }, REFRESH_MS);
                        });
                    }

       

                    let catalogoSeries = [];

                     async function cargarCatalogoSeries() {
                         if (catalogoSeries.length) return;

                         const resp = await fetch('/Comercial/SeriesCatalogo', { cache: 'no-store' });
                         if (!resp.ok) return;

                         catalogoSeries = await resp.json();
                     }

                      let ordenIdActual = null;
                    let estatusActual = null;

                    async function cargarSubpedidosOV(consecutivoOV) {
                        const tbody = document.getElementById('ovm-sub-tbody');
                        const lblCount = document.getElementById('ovm-sub-count');

                        if (!tbody || !lblCount) return;

                        tbody.innerHTML = `
                            <tr>
                                <td colspan="5" class="text-center text-muted">
                                    Cargando subpedidos...
                                </td>
                            </tr>`;

                        if (!consecutivoOV) {
                            tbody.innerHTML = `
                                <tr><td colspan="5" class="text-center text-muted">
                                    Sin consecutivo de OV.
                                </td></tr>`;
                            lblCount.textContent = "0";
                            return;
                        }

                        try {
                            const resp = await fetch(`/Comercial/SubpedidosPorOV2?consecutivoOV=${encodeURIComponent(consecutivoOV)}`, {
                                cache: 'no-store'
                            });
                            if (!resp.ok) throw new Error('HTTP ' + resp.status);
                            const lista = await resp.json();

                            if (!Array.isArray(lista) || lista.length === 0) {
                                tbody.innerHTML = `
                                    <tr><td colspan="5" class="text-center text-muted">
                                        Esta OV no tiene subpedidos.
                                    </td></tr>`;
                                lblCount.textContent = "0";
                                return;
                            }

                            lblCount.textContent = lista.length.toString();
                            tbody.innerHTML = "";

                            lista.forEach((sp, idx) => {
                                const tr = document.createElement('tr');
                                tr.dataset.subid = sp.id;
                                tr.innerHTML = `
                                    <td>${idx + 1}</td>
                                    <td>${sp.subFolio || ''}</td>
                                    <td>${sp.documentoSAP || ''}</td>
                                   <td>
                                       <input type="text"
                                              class="form-control form-control-sm sp-docmeat ${(sp.u_DocMeat || '').toString().trim() ? 'doc-meat-ok' : 'doc-meat-empty'}"
                                              value="${sp.u_DocMeat || ''}" />
                                   </td>
                                    <td class="text-center">
                                        <button type="button"
                                                class="btn btn-primary btn-sm btn-sp-docmeat-guardar">
                                            Guardar
                                        </button>
                                    </td>
                                `;
                                tbody.appendChild(tr);
                            });

                        } catch (e) {
                            console.error(e);
                            tbody.innerHTML = `
                                <tr><td colspan="5" class="text-center text-danger">
