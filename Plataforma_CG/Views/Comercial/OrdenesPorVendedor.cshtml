                    // ============ MULTI DROPDOWN (Vendedor / Estatus) ============

                   function initMultiDropdown(rootId, checkClass, hiddenContainerId, hiddenName) {
                const root = document.getElementById(rootId);
                if (!root) return null;

                const labelSpan = root.querySelector('.multi-label');
                const checks = root.querySelectorAll('.' + checkClass);
                const hidden = document.getElementById(hiddenContainerId);

                function refresh() {
                    if (!hidden) return;

                    hidden.innerHTML = "";

                    const texts = [];
                    checks.forEach(ch => {
                        if (ch.checked) {
                            texts.push(ch.getAttribute('data-text') || ch.value);

                            const inp = document.createElement('input');
                            inp.type = 'hidden';
                            inp.name = hiddenName;
                            inp.value = ch.value;
                            hidden.appendChild(inp);
                        }
                    });

                    if (labelSpan) {
                        if (texts.length === 0) {
                            labelSpan.textContent = '(Todos)';
                        } else if (texts.length <= 3) {
                            labelSpan.textContent = texts.join(', ');
                        } else {
                            labelSpan.textContent = texts.length + ' seleccionados';
                        }
                    }
                }

                checks.forEach(ch => {
                    ch.addEventListener('change', refresh);
                });

                refresh();

                return { refresh };
            }

                    // ========= ORDENAMIENTO POR ENCABEZADO =========

                    function initHeaderSorting() {
                        const table = document.querySelector('.table-wrap table');
                        if (!table) return;

                        const thead = table.querySelector('thead');
                        const tbody = table.querySelector('tbody');
                        if (!thead || !tbody) return;

                        const ths = thead.querySelectorAll('th[data-sort-col]');
                        if (!ths.length) return;

                        const state = { index: null, dir: null }; // asc | desc | null

                        function clearIcons() {
                            ths.forEach(th => {
                                th.textContent = th.textContent.replace(/\s*[▲▼]$/, '');
                            });
                        }

                        function getCellValue(tr, index) {
                            const td = tr.children[index];
                            if (!td) return '';
                            return td.innerText.trim();
                        }

                        function parseValue(val, type) {
                            if (type === 'num') {
                                const n = parseFloat(val.replace(/[^\d.-]/g, ''));
                                return isNaN(n) ? 0 : n;
                            }
                            if (type === 'date') {
                                const d = new Date(val);
                                return isNaN(d.getTime()) ? 0 : d.getTime();
                            }
                            return val.toUpperCase();
                        }

                        function sortBody(index, dir) {
                            const rows = Array.from(tbody.querySelectorAll('tr'));
                            if (!rows.length) return;

                            if (index == null || dir == null) {
                                // restaurar orden original usando data-index
                                rows.sort((a, b) => {
                                    const ia = parseInt(a.dataset.index || '0', 10);
                                    const ib = parseInt(b.dataset.index || '0', 10);
                                    return ia - ib;
                                });
                            } else {
                                const type = ths[index].dataset.sortType || 'text';
                                rows.sort((a, b) => {
                                    const va = parseValue(getCellValue(a, index), type);
                                    const vb = parseValue(getCellValue(b, index), type);
                                    if (va < vb) return -1;
                                    if (va > vb) return 1;
                                    return 0;
                                });
                                if (dir === 'desc') rows.reverse();
                            }

                            rows.forEach(r => tbody.appendChild(r));
                        }

                        ths.forEach((th, index) => {
                            th.style.cursor = 'pointer';

                            th.addEventListener('click', () => {
                                if (state.index === index) {
                                    state.dir = state.dir === 'asc' ? 'desc' :
                                               state.dir === 'desc' ? null : 'asc';
                                } else {
                                    state.index = index;
                                    state.dir = 'asc';
                                }

                                clearIcons();

                                if (!state.dir) {
                                    state.index = null;
                                } else {
                                    th.textContent = th.textContent.replace(/\s*[▲▼]$/, '') +
                                        (state.dir === 'asc' ? ' ▲' : ' ▼');
                                }

                                sortBody(state.index, state.dir);
                            });
                        });
                    }

               document.addEventListener('DOMContentLoaded', function () {
                const ddEstatus = initMultiDropdown(
                'dd-estatus',
                'multi-check-estatus',
                'dd-estatus-hidden',
                'EstatusSeleccionados'
            );

            initMultiDropdownSearch('dd-estatus');

            initHeaderSorting();

            const frm = document.getElementById('frmPedidos');
            if (frm) {
                frm.addEventListener('submit', function () {
                    ddEstatus?.refresh();
                });
            }

            });

                               document.getElementById('ovm-serie').addEventListener('change', async function () {
                        if (!ordenIdActual) return;

                        const select = this;
                        const nuevaSerieId = select.value;
                        const serieAnterior = select.getAttribute('data-prev') ?? '';

                        // 🔐 Confirmación
                        const ok = confirm('¿Estás seguro de que deseas actualizar la serie de esta orden?');
                        if (!ok) {
                            // 🔄 Revertir selección
                            select.value = serieAnterior;
                            return;
                        }

                        const token = getAntiForgeryToken();

                        try {
                            const resp = await fetch('/Comercial/ActualizarSerieOV', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/x-www-form-urlencoded',
                                    'RequestVerificationToken': token
                                },
                                body: `ordenVentaId=${ordenIdActual}&serieId=${nuevaSerieId}`
                            });

                            const json = await resp.json();

                            if (!resp.ok || json.ok === false) {
                                showMsg('danger', json.msg || 'Error al actualizar serie');
                                select.value = serieAnterior; // rollback
                                return;
                            }

                            // ✅ Guardar nueva como previa
                            select.setAttribute('data-prev', nuevaSerieId);

                            // (opcional) actualizar texto visible
                            const lblSerie = document.getElementById('ovm-serie-text');
                            if (lblSerie && json.serieNombre) {
                                lblSerie.textContent = json.serieNombre;
                            }

                            // (opcional) actualizar listado
                            const link = document.querySelector(`a.ver-ov[data-id="${ordenIdActual}"]`);
                            if (link) {
                                const tr = link.closest('tr');
                                const tdSerie = tr ? tr.querySelector('.td-serie') : null;
                                if (tdSerie && json.serieNombre) {
                                    tdSerie.textContent = json.serieNombre;
                                }
                            }

                            showMsg('success', 'Serie actualizada correctamente.');
                            setTimeout(() => showMsg(), 2000);

                        } catch (e) {
                            console.error(e);
                            showMsg('danger', 'Error de red al actualizar serie.');
                            select.value = serieAnterior; // rollback
                        }
                    });

        </script>
    }
