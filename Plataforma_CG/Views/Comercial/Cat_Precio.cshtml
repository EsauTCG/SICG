        function impCrearFila(codigo = '', nombre = '', precio = '', sku = '') {
            const tbody = document.getElementById('tablaCapturaBody');
            const idx = tbody.rows.length + 1;
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td style="text-align:center;color:#999;">${idx}</td>
                <td><input type="text" class="imp-cap-input cap-codigo" value="${impEscapeHtml(codigo)}" placeholder="NE000118"></td>
                <td><input type="text" class="imp-cap-input cap-nombre" value="${impEscapeHtml(nombre)}" placeholder="Arrachera Concha"></td>
                <td><input type="text" class="imp-cap-input cap-precio" value="${impEscapeHtml(precio)}" placeholder="221"></td>
                <td><input type="text" class="imp-cap-input cap-sku" value="${impEscapeHtml(sku)}" placeholder="N033"></td>
                <td><button class="imp-btn imp-btn-secondary imp-btn-eliminar" style="padding:0 8px;height:24px;font-size:11px;">✕</button></td>
            `;
            tr.querySelector('.imp-btn-eliminar').addEventListener('click', () => {
                tr.remove();
                impRenumerarFilas();
            });
            tbody.appendChild(tr);
        }

        function impRenumerarFilas() {
            document.querySelectorAll('#tablaCapturaBody tr').forEach((tr, i) => {
                tr.cells[0].textContent = i + 1;
            });
        }

        function impInicializarTablaCaptura() {
            document.getElementById('tablaCapturaBody').innerHTML = '';
            for (let i = 0; i < 5; i++) impCrearFila();
        }

        document.getElementById('impBtnAgregarFila')?.addEventListener('click', () => impCrearFila());

        document.getElementById('impBtnLimpiarTabla')?.addEventListener('click', () => {
            if (confirm('¿Limpiar toda la tabla?')) impInicializarTablaCaptura();
        });

        document.getElementById('tablaCaptura')?.addEventListener('paste', function (e) {
            e.preventDefault();
            const texto = (e.clipboardData || window.clipboardData).getData('text');
            if (!texto) return;
            const filas = texto.trim().split(/\r?\n/);
            const tbody = document.getElementById('tablaCapturaBody');
            tbody.innerHTML = '';
            filas.forEach(fila => {
                const cols = fila.split('\t');
                const codigo = (cols[0] || '').trim();
                const nombre = (cols[1] || '').trim();
                const precio = (cols[2] || '').trim();
                const sku = (cols[3] || '').trim();
                if (codigo || nombre || precio) impCrearFila(codigo, nombre, precio, sku);
            });
            impRenumerarFilas();
        });

        document.getElementById('impBtnProcesarCaptura')?.addEventListener('click', () => {
            const competidor = document.getElementById('impNombreCompetidor')?.value?.trim();
            if (!competidor) { alert('Captura el nombre del competidor.'); return; }
            const fecha = document.getElementById('impFechaCompetencia')?.value?.trim();
            if (!fecha) {
                const inp = document.getElementById('impFechaCompetencia');
                inp.style.border = '2px solid #c00000';
                inp.focus();
                alert('La fecha de corte es obligatoria.');
                return;
            }
            document.getElementById('impFechaCompetencia').style.border = '1px solid #b48787';
            const filas = document.querySelectorAll('#tablaCapturaBody tr');
            const productos = [];
            filas.forEach(tr => {
                const codigo = tr.querySelector('.cap-codigo')?.value?.trim() || '';
                const nombre = tr.querySelector('.cap-nombre')?.value?.trim() || '';
                const precioRaw = tr.querySelector('.cap-precio')?.value?.trim() || '';
                const sku = tr.querySelector('.cap-sku')?.value?.trim() || '';
                const precio = parseFloat(precioRaw.replace(/[^0-9.]/g, '')) || 0;
                if (!nombre && !codigo) return;
                if (precio <= 0) return;
                let nuestroNombre = '';
                let nuestroPrecio = null;
                if (sku) {
                    const s = impSkusData.find(x => x.sku?.toUpperCase() === sku.toUpperCase());
                    if (s) {
                        nuestroNombre = s.nombre || '';
                        nuestroPrecio = Number(s.precioPublico ?? s.precio ?? 0);
                    }
                }
                productos.push({ codigoCompetencia: codigo, nombre, precio, sku, nuestroNombre, nuestroPrecio, searchTerm: sku ? sku : nombre });
            });

            if (!productos.length) { alert('Agrega al menos un producto con nombre y precio.'); return; }
            impData = { competidor, fecha, productos };
            document.getElementById('impStep1').style.display = 'none';
            document.getElementById('impStep2').style.display = 'block';
            impRenderMapTable();
        });

        function actualizarContadorSkus() {
        const txt = document.getElementById('anaSku');
        const lbl = document.getElementById('anaSkuCount');

        const skus = normalizarSkusMasivo(txt?.value || '');

        if (lbl) {
        lbl.textContent = `${skus.length.toLocaleString('es-MX')} SKU capturados`;
        }

        return skus;
        }

      


        function impUpdateSummary() {
        if (!impData || !Array.isArray(impData.productos)) return;

        const mapped = impData.productos.filter(p => p.sku).length;
        const total = impData.productos.length;
        document.getElementById('impMapSummary').textContent = `${mapped} de ${total} productos mapeados`;
        document.getElementById('impBtnGuardar').disabled = mapped === 0;

        const alert = document.getElementById('impMapAlert');
        if (mapped === 0) {
        alert.textContent = 'Para cada producto de la competencia, selecciona el SKU propio correspondiente en el desplegable.';
        alert.style.display = 'block';
        } else {
        alert.style.display = 'none';
        }
