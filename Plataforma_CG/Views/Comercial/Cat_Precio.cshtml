            const ok = confirm(
                `Se guardarán ${registros.length} SKU(s).\n\n` +
                `Lista destino: ${listaTexto}\n\n` +
                `Si eliges Precio Público, también se recalculan las listas con factor.\n` +
                `Si eliges una lista especial sin factor, sólo se afectan clientes con esa lista asignada.\n\n` +
                `Fecha corte: ${fechaCorte}\n` +
                `Fecha uso: ${fechaUso}\n` +
                (alertas ? `\n⚠ ${alertas} precio(s) se alejan más de 30% del precio de venta real (marcados en amarillo).\n` : '') +
