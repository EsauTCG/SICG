@section Scripts {
   @*  <script src="https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js"></script> *@
    <script>
        /* ═══════════════════════════════════════════════════════════
        TABLA DE PRECIOS — original sin cambios
        ═══════════════════════════════════════════════════════════ */
        let currentPage = 1;
        let pageSize = 50;
        let currentSearch = "";
        let totalPages = 1;
        let totalItems = 0;
        let modalAnalisisSemanal = null;
        let modalImportarComp = null;
        let modalHistoricoPrecios = null;
        let histPage = 1;
        let histPageSize = 50;
        let histTotalPages = 1;

        function debounce(fn, ms = 350) {
        let t;
        return (...a) => { clearTimeout(t); t = setTimeout(() => fn(...a), ms); };
        }

        function fmtMoney(n) {
        const x = Number(n);
        return Number.isFinite(x)
        ? x.toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 })
        : "0.00";
        }

        function fmtNumAnalisis(v) {
        const n = Number(v ?? 0);
        return n.toLocaleString('es-MX', { minimumFractionDigits: 0, maximumFractionDigits: 2 });
        }

        function fmtMoneyAnalisis(v) {
        const n = Number(v ?? 0);
        return n.toLocaleString('es-MX', { style: 'currency', currency: 'MXN' });
        }

        function fmtPctAnalisis(v) {
        return `${Number(v ?? 0).toFixed(0)}%`;
        }

        function claseRecomendacion(reco) {
        const r = (reco || '').toUpperCase();
        if (r === 'BAJAR') return 'reco-bajar';
        if (r === 'SUBIR') return 'reco-subir';
        return 'reco-mantener';
        }


        function renderNumericPager() {
            const host = document.getElementById("numericPager");
            if (!host) return;

            host.innerHTML = "";

            const total = Math.max(1, Number(totalPages || 1));
            const actual = Math.max(1, Math.min(Number(currentPage || 1), total));

            function addButton(label, page, options = {}) {
                const btn = document.createElement("button");

                btn.type = "button";
                btn.className = "page-num-btn";
                btn.textContent = label;

                if (options.active) {
                    btn.classList.add("active");
                }

                if (options.disabled) {
                    btn.disabled = true;
                }

                if (!options.disabled && !options.active) {
                    btn.addEventListener("click", () => {
                        currentPage = page;
                        cargarPrecios(currentPage, currentSearch);
                    });
                }

                host.appendChild(btn);
            }

            function addEllipsis() {
                const span = document.createElement("span");
                span.className = "page-ellipsis";
                span.textContent = "…";
                host.appendChild(span);
            }

            addButton(
                "‹",
                actual - 1,
                { disabled: actual <= 1 }
            );

            let pages = [];

            if (total <= 9) {
                pages = Array.from(
                    { length: total },
                    (_, i) => i + 1
                );
            }
            else {
                let start = Math.max(2, actual - 3);
                let end = Math.min(total - 1, actual + 3);

                pages.push(1);

                if (start > 2) {
                    pages.push("...");
                }

                for (let p = start; p <= end; p++) {
                    pages.push(p);
                }

                if (end < total - 1) {
                    pages.push("...");
                }

                pages.push(total);
            }

            pages.forEach(p => {
                if (p === "...") {
                    addEllipsis();
                }
                else {
                    addButton(
                        String(p),
                        p,
                        { active: p === actual }
                    );
                }
            });

            addButton(
                "›",
                actual + 1,
                { disabled: actual >= total }
            );
        }


        async function cargarPrecios(page = 1, search = "") {
        const tbody = document.querySelector("#tablaPrecios tbody");
        tbody.innerHTML = `<tr><td colspan="9" class="text-center py-4">⏳ Cargando...</td></tr>`;
        document.getElementById("loader").style.display = "inline";


        try {
        const res = await fetch(`/Comercial/GetCatalogoPrecioJsonPaged?page=${page}&pageSize=${pageSize}&search=${encodeURIComponent(search)}`);
        if (!res.ok) throw new Error("Error al cargar catálogo de precios");

        const data = await res.json();
        tbody.innerHTML = "";

        const rows = Array.isArray(data.precios) ? data.precios : [];
        totalItems = Number(data.total || 0);
        totalPages = Math.max(1, Math.ceil((data.total || 0) / (data.pageSize || pageSize)));

        if (!rows.length) {
        tbody.innerHTML = `<tr><td colspan="9" class="text-center text-warning py-4">No hay registros para mostrar.</td></tr>`;
        document.getElementById("statusPageInfo").textContent = "Sin resultados";
        renderNumericPager();
        return;
        }

        rows.forEach(p => {
        const sku = p.productoCodigo ?? p.ProductoCodigo ?? p.itemCode ?? "";
        const cliente = p.cliente ?? p.Cliente ?? "";
        const tr = document.createElement("tr");
        tr.innerHTML = `
        <td>${sku || "—"}</td>
        <td>${p.productoNombre ?? p.ProductoNombre ?? "—"}</td>
        <td>${cliente || "—"}</td>
        <td>${p.clienteNombre ?? p.ClienteNombre ?? "—"}</td>
        <td>${p.priceListNum ?? p.PriceListNum ?? "—"}</td>
        <td>${p.priceListName ?? p.PriceListName ?? "—"}</td>
        <td class="text-end">${fmtMoney(p.precio ?? p.Precio)}</td>
        <td>${(p.fechaModificacion ?? p.FechaModificacion) ? new Date(p.fechaModificacion ?? p.FechaModificacion).toLocaleString('es-MX') : "—"}</td>
        <td class="text-center">
            <button type="button"
                    class="btn-audit-row"
                    data-hist-sku="${impEscapeHtml(sku)}"
                    data-hist-cliente="${impEscapeHtml(cliente)}"
                    title="Ver historial de este precio">
                <i class="bi bi-clock-history"></i>
            </button>
        </td>
        `;
        tbody.appendChild(tr);
        });

        currentPage = Number(data.page || page);
        pageSize = Number(data.pageSize || pageSize);
        document.getElementById("statusPageInfo").textContent =
        `Página ${currentPage} de ${totalPages} · Registros: ${totalItems.toLocaleString('es-MX')}`;
        renderNumericPager();
        } catch (err) {
        tbody.innerHTML = `<tr><td colspan="9" class="text-center text-danger py-4">Error: ${err.message}</td></tr>`;
        document.getElementById("statusPageInfo").textContent = "Error";
        } finally {
        document.getElementById("loader").style.display = "none";

        }
        }


        /* ═══════════════════════════════════════════════════════════
           HISTÓRICO / AUDITORÍA RESUMIDA DE PRECIOS
        ═══════════════════════════════════════════════════════════ */
        function histPick(obj, ...keys) {
            for (const key of keys) {
                if (obj && obj[key] !== undefined && obj[key] !== null) return obj[key];
            }
            return null;
        }

        function histFmtDateTime(value) {
            if (!value) return '—';
            const d = new Date(value);
            return Number.isNaN(d.getTime()) ? String(value) : d.toLocaleString('es-MX');
        }

        function histFmtDate(value) {
            if (!value) return '—';
            const d = new Date(value);
            return Number.isNaN(d.getTime())
                ? String(value).slice(0, 10)
                : d.toLocaleDateString('es-MX');
        }

        function histFmtMoney(value) {
            if (value === null || value === undefined || value === '') return '—';
            return fmtMoney(value);
        }

        function histAccionInfo(value) {
            const accion = String(value || '').toUpperCase().trim();
            if (accion === 'INSERT') return { texto: 'INSERT', clase: 'audit-action-insert' };
            if (accion === 'UPDATE') return { texto: 'UPDATE', clase: 'audit-action-update' };
            if (accion === 'SIN_CAMBIO') return { texto: 'SIN CAMBIO', clase: 'audit-action-sin-cambio' };
            return { texto: accion || '—', clase: '' };
        }

        function histDiffClass(value) {
            const n = Number(value || 0);
            if (n > 0) return 'audit-diff-up';
            if (n < 0) return 'audit-diff-down';
            return 'audit-diff-zero';
        }

        function histSetText(id, value) {
            const el = document.getElementById(id);
            if (el) el.textContent = Number(value || 0).toLocaleString('es-MX');
        }

        function histFechaHaceDiasISO(dias) {
            const d = new Date();
            d.setDate(d.getDate() - dias);
            const y = d.getFullYear();
            const m = String(d.getMonth() + 1).padStart(2, '0');
            const day = String(d.getDate()).padStart(2, '0');
            return `${y}-${m}-${day}`;
        }

        function histBuildQuery(page = 1) {
            const qs = new URLSearchParams();
            qs.set('page', page);
            qs.set('pageSize', histPageSize);

            const fields = {
                search: document.getElementById('histSearch')?.value || '',
                sku: document.getElementById('histSku')?.value || '',
                cliente: document.getElementById('histCliente')?.value || '',
                accion: document.getElementById('histAccion')?.value || '',
                usuario: document.getElementById('histUsuario')?.value || '',
                priceListNum: document.getElementById('histLista')?.value || '',
                fechaDesde: document.getElementById('histFechaDesde')?.value || '',
                fechaHasta: document.getElementById('histFechaHasta')?.value || ''
            };

            Object.entries(fields).forEach(([key, value]) => {
                const clean = String(value ?? '').trim();
                if (clean) qs.set(key, clean);
            });

            return qs;
        }

        function descargarHistoricoPreciosExcel() {
            const btn = document.getElementById('btnHistExcel');
            const textoOriginal = btn?.innerHTML || '';

            const qs = histBuildQuery(1);
            // El Excel debe traer TODOS los resultados filtrados, no solo la página visible.
            qs.delete('page');
            qs.delete('pageSize');

            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<span class="spinner-border spinner-border-sm" aria-hidden="true"></span> Generando Excel...';
            }

            // Content-Disposition=attachment evita abandonar la pantalla.
            window.location.href = `/Comercial/ExportarHistoricoCatalogoPreciosExcel?${qs.toString()}`;

            // La navegación de descarga no expone un evento confiable de finalización.
            setTimeout(() => {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = textoOriginal;
                }
            }, 2500);
        }


        function histLimpiarFiltros() {
            [
                'histSearch',
                'histSku',
                'histCliente',
                'histUsuario',
                'histLista'
            ].forEach(id => {
                const el = document.getElementById(id);
                if (el) el.value = '';
            });

            const desde = document.getElementById('histFechaDesde');
            const hasta = document.getElementById('histFechaHasta');
            const accion = document.getElementById('histAccion');

            if (desde) desde.value = histFechaHaceDiasISO(30);
            if (hasta) hasta.value = hoyLocalISO();
            if (accion) accion.value = 'CAMBIOS';
        }

        function histCerrarDetalleClientes() {
            document.querySelectorAll('.hist-clientes-detail-row').forEach(row => row.remove());
        }

        function histDecimalParam(value) {
            if (value === null || value === undefined || value === '') return '';
            const n = Number(value);
            return Number.isFinite(n) ? String(n) : '';
        }

        async function histToggleClientes(button) {
            const parentRow = button.closest('tr');
            if (!parentRow) return;

            const currentDetail = parentRow.nextElementSibling;
            if (currentDetail?.classList.contains('hist-clientes-detail-row')) {
                currentDetail.remove();
                return;
            }

            histCerrarDetalleClientes();

            const detailRow = document.createElement('tr');
            detailRow.className = 'hist-clientes-detail-row';
            detailRow.innerHTML = `
                <td colspan="15">
                    <div class="audit-client-panel">
                        <div class="audit-client-panel-head">
                            <span>Clientes afectados</span>
                            <span>⏳ Consultando lista...</span>
                        </div>
                    </div>
                </td>`;
            parentRow.insertAdjacentElement('afterend', detailRow);

            const qs = new URLSearchParams();
            qs.set('loteId', button.dataset.lote || '');
            qs.set('sku', button.dataset.sku || '');
            qs.set('priceListNum', button.dataset.lista || '0');
            qs.set('accion', button.dataset.accion || '');

            const anterior = button.dataset.anterior;
            const nuevo = button.dataset.nuevo;
            if (anterior !== undefined && anterior !== '') qs.set('precioAnterior', anterior);
            if (nuevo !== undefined && nuevo !== '') qs.set('precioNuevo', nuevo);

            try {
                const res = await fetch(`/Comercial/ObtenerClientesAfectadosHistoricoPrecios?${qs.toString()}`, {
                    cache: 'no-store'
                });

                const raw = await res.text();
                if (!res.ok) throw new Error(raw || 'No se pudo consultar la lista de clientes.');

                const data = JSON.parse(raw);
                const clientes = Array.isArray(data.clientes) ? data.clientes : [];
                const panel = detailRow.querySelector('.audit-client-panel');

                if (!clientes.length) {
                    panel.innerHTML = `
                        <div class="audit-client-panel-head">
                            <span>Clientes afectados</span>
                            <span>0 clientes</span>
                        </div>
                        <div class="text-muted">No se encontraron clientes para este cambio.</div>`;
                    return;
                }

                panel.innerHTML = `
                    <div class="audit-client-panel-head">
                        <span>
                            SKU ${impEscapeHtml(button.dataset.sku || '')} ·
                            ${clientes.length.toLocaleString('es-MX')} clientes afectados
                        </span>
                        <button type="button" class="tool-btn tool-btn-secondary btn-cerrar-clientes">
                            Cerrar lista
                        </button>
                    </div>
                    <div class="audit-client-grid">
                        ${clientes.map(c => {
                            const codigo = histPick(c, 'cliente', 'Cliente') || '—';
                            const nombre = histPick(c, 'clienteNombre', 'ClienteNombre') || 'Sin nombre';
                            return `
                                <div class="audit-client-item">
                                    <span class="audit-client-code">${impEscapeHtml(codigo)}</span>
                                    <span>${impEscapeHtml(nombre)}</span>
                                </div>`;
                        }).join('')}
                    </div>`;
            } catch (e) {
                console.error(e);
                const panel = detailRow.querySelector('.audit-client-panel');
                panel.innerHTML = `
                    <div class="audit-client-panel-head">
                        <span>Clientes afectados</span>
                        <button type="button" class="tool-btn tool-btn-secondary btn-cerrar-clientes">Cerrar</button>
                    </div>
                    <div class="text-danger">${impEscapeHtml(e.message)}</div>`;
            }
        }

        async function cargarHistoricoPrecios(page = 1) {
            const body = document.getElementById('histBody');
            const loader = document.getElementById('histLoader');
            const prev = document.getElementById('histPrev');
            const next = document.getElementById('histNext');

            if (!body) return;

            histCerrarDetalleClientes();
            body.innerHTML = `<tr><td colspan="15" class="text-center py-4">⏳ Consultando cambios resumidos...</td></tr>`;
            if (loader) loader.style.display = 'inline';
            if (prev) prev.disabled = true;
            if (next) next.disabled = true;

            try {
                const res = await fetch(`/Comercial/ObtenerHistoricoCatalogoPrecios?${histBuildQuery(page).toString()}`, {
                    cache: 'no-store'
                });

                const raw = await res.text();
                if (!res.ok) throw new Error(raw || 'No se pudo consultar el histórico resumido.');

                const data = JSON.parse(raw);
                const registros = Array.isArray(data.registros) ? data.registros : [];
                const resumen = data.resumen || {};
                const total = Number(data.total || histPick(resumen, 'total', 'Total') || 0);
                const pageSizeResp = Number(data.pageSize || histPageSize);

                histPage = Number(data.page || page);
                histTotalPages = Math.max(1, Math.ceil(total / pageSizeResp));

                histSetText('histKpiTotal', total);
                histSetText('histKpiClientes', histPick(resumen, 'impactosClientes', 'ImpactosClientes'));
                histSetText('histKpiInsert', histPick(resumen, 'insertados', 'Insertados'));
                histSetText('histKpiUpdate', histPick(resumen, 'actualizados', 'Actualizados'));
                histSetText('histKpiSubidas', histPick(resumen, 'subidas', 'Subidas'));
