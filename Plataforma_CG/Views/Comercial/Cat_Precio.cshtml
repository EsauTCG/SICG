        // CORRECCIÓN: pegar un solo valor en una celda ya no borra toda la tabla.
        // Solo se reemplaza la tabla cuando se pegan varias filas o columnas desde Excel.
        document.getElementById('tablaCaptura')?.addEventListener('paste', function (e) {
            const texto = (e.clipboardData || window.clipboardData).getData('text');
