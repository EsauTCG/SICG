                const modo = document.getElementById('anaAlcanceClientes')?.value || 'ACTIVOS';

                if (modo === 'CLIENTES') {
                    await cargarClientesPrecio();
                }
            });

            document.getElementById('anaClientes')?.addEventListener('change', function () {
                actualizarContadorClientesPrecio();
            });

            document.getElementById('btnMarcarTodosClientes')?.addEventListener('click', function () {
                const sel = document.getElementById('anaClientes');

                if (!sel || sel.disabled) return;

                const opciones = Array.from(sel.options).filter(o => !o.disabled);
                const haySinMarcar = opciones.some(o => !o.selected);

                opciones.forEach(o => {
                    o.selected = haySinMarcar;
                });

                actualizarContadorClientesPrecio();

                this.innerHTML = haySinMarcar
                    ? '<i class="bi bi-people"></i> Desmarcar clientes'
                    : '<i class="bi bi-people"></i> Marcar clientes';
            });

            document.getElementById('btnMarcarTodosGuardar')?.addEventListener('click', function () {
                const checks = document.querySelectorAll('.ana-chk-guardar');
                const algunoSinMarcar = Array.from(checks).some(x => !x.checked);

                checks.forEach(chk => {
                    chk.checked = algunoSinMarcar;
                });

                this.innerHTML = algunoSinMarcar
                    ? '<i class="bi bi-check2-square"></i> Desmarcar todos'
                    : '<i class="bi bi-check2-square"></i> Marcar todos';
            });

            document.getElementById('btnGuardarPrecioPublico')?.addEventListener('click', function (e) {
                e.preventDefault();
                guardarPrecioPublicoDesdeAnalisis();
            });


        /* Histórico / Auditoría */
        document.getElementById('btnHistoricoPrecios')?.addEventListener('click', function () {
            abrirHistoricoPrecios('', '', true);
        });

        document.getElementById('btnHistBuscar')?.addEventListener('click', function () {
            cargarHistoricoPrecios(1);
        });

        document.getElementById('btnHistLimpiar')?.addEventListener('click', function () {
            histLimpiarFiltros();
            cargarHistoricoPrecios(1);
        });

        document.getElementById('btnHistExcel')?.addEventListener('click', function () {
            descargarHistoricoPreciosExcel();
        });

        document.getElementById('histPrev')?.addEventListener('click', function () {
            if (histPage > 1) cargarHistoricoPrecios(histPage - 1);
        });

        document.getElementById('histNext')?.addEventListener('click', function () {
            if (histPage < histTotalPages) cargarHistoricoPrecios(histPage + 1);
        });

        document.querySelectorAll(
            '#histSearch,#histSku,#histCliente,#histUsuario,#histLista,#histFechaDesde,#histFechaHasta'
        ).forEach(el => {
            el.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    cargarHistoricoPrecios(1);
                }
            });
        });

        document.addEventListener('click', function (e) {
            const btn = e.target.closest('.btn-audit-row');
            if (!btn) return;

            e.preventDefault();
            histLimpiarFiltros();
            abrirHistoricoPrecios(
                btn.dataset.histSku || '',
                '',
                false
            );
        });

        document.addEventListener('click', function (e) {
            const btnClientes = e.target.closest('.btn-hist-clientes');
            if (btnClientes) {
                e.preventDefault();
                histToggleClientes(btnClientes);
                return;
            }

            const btnCerrar = e.target.closest('.btn-cerrar-clientes');
            if (btnCerrar) {
                e.preventDefault();
                btnCerrar.closest('.hist-clientes-detail-row')?.remove();
            }
        });

        /* Análisis semanal */
            document.getElementById('btnGestionAnalisis')?.addEventListener('click', async function () {
                modalAnalisisSemanal.show();

                await cargarMastersAnalisis();
                await cargarListasPrecioGuardar();

                await cargarCanalesPrecio();
                await cargarClientesPrecio();
                actualizarModoDestinoPrecio();

                const hoy = hoyLocalISO();

        if (!document.getElementById('anaFechaCorte').value) {
        document.getElementById('anaFechaCorte').value = hoy;
        }

                if (!document.getElementById('anaFechaUso').value) {
                    document.getElementById('anaFechaUso').value = hoy;
                }

        actualizarContadorSkus();
        });

        document.getElementById('btnCalcularAnalisis')?.addEventListener('click', function (e) {
        e.preventDefault();
        cargarAnalisisSemanal();
        });

        document.getElementById('anaSku')?.addEventListener('input', actualizarContadorSkus);
        document.getElementById('anaSku')?.addEventListener('change', actualizarContadorSkus);

        document.getElementById('anaSku')?.addEventListener('keydown', function (e) {
        if (e.ctrlKey && e.key === 'Enter') {
        e.preventDefault();
        cargarAnalisisSemanal();
        }
        });

  

            document.getElementById('btnGestionImportar')?.addEventListener('click', async () => {
                impReset();
                await impCargarSkus();               
                impInicializarTablaCaptura();
                modalImportarComp.show();
            });

        /* Tabla de precios */
        document.getElementById("btnSincronizar").addEventListener("click", async function () {
        document.getElementById("loader").style.display = "inline";
        this.disabled = true;
        try {
        const res = await fetch('/Comercial/SincronizarPrecioCliente');
        if (!res.ok) throw new Error('Error al sincronizar');
        alert(await res.text());
        await cargarPrecios(currentPage, currentSearch);
        } catch (err) {
        alert(err.message);
        } finally {
        document.getElementById("loader").style.display = "none";
        this.disabled = false;
        }
        });

        const doSearch = debounce(() => {
        currentSearch = document.getElementById("searchInput").value || "";
        currentPage = 1;
        cargarPrecios(currentPage, currentSearch);
        }, 350);

        document.getElementById("searchInput").addEventListener("input", function () {
            const mirror = document.querySelector(".catalogo-precios-cliente-app .table-search-display");

            if (mirror) {
                mirror.textContent =
                    this.value.trim() ||
                    "Buscar aquí";
            }

            doSearch();
        });



        document.getElementById("btnDescargarExcel").addEventListener("click", function () {
        const search = document.getElementById("searchInput").value || "";
        window.location.href = `/Comercial/DescargarCatalogoPreciosExcel?search=${encodeURIComponent(search)}`;
        });
        });
    </script>
}