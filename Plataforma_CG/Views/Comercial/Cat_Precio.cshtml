        function normalizarSkusMasivo(valor) {
        return [...new Set(
        (valor || '')
        .split(/[\s,;|]+/g)
        .map(x => x.trim().toUpperCase())
        .filter(x => x.length > 0)
        )];
        }

        async function cargarMastersAnalisis() {
            const sel = document.getElementById('anaMaster');
            if (!sel) return;

            // Si ya está cargado correctamente, no volver a pedirlo
            if (sel.dataset.cargado === '1') return;

            sel.innerHTML = `
                <option value="">Todos</option>
                <option value="" disabled>⏳ Cargando...</option>
            `;

            try {
                const res = await fetch('/Comercial/ObtenerMasters');

                if (!res.ok) {
                    throw new Error('No se pudieron cargar los masters.');
                }

                const lista = await res.json();

                // Aquí limpiamos el "Cargando..."
                sel.innerHTML = '<option value="">Todos</option>';

                if (!Array.isArray(lista) || lista.length === 0) {
                    const opt = document.createElement('option');
                    opt.value = '';
                    opt.textContent = '(SIN MASTERS)';
                    opt.disabled = true;
                    sel.appendChild(opt);
                    return;
                }

                lista.forEach(m => {
                    const opt = document.createElement('option');
                    opt.value = m || '';
                    opt.textContent = m || '(SIN MASTER)';
                    sel.appendChild(opt);
                });

                sel.dataset.cargado = '1';

            } catch (e) {
                console.warn('No se pudieron cargar masters:', e);

                sel.innerHTML = `
                    <option value="">Todos</option>
                    <option value="" disabled>Error al cargar masters</option>
                `;
            }
        }

