                alert(
                    `Precios guardados correctamente.\n\n` +
                    `Lote: ${data.loteId}\n` +
                    `Insertados: ${data.insertados}\n` +
                    `Actualizados: ${data.actualizados}\n` +
                    `Sin cambio: ${data.sinCambio}`
                );
                await cargarPrecios(1, currentSearch);
            } catch (e) {
                alert('Error al guardar precios: ' + e.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = original;
            }
        }

        // Sin uso en la pantalla actual (los campos comp* no existen); se conserva.
