@section Scripts {
    <script>
        /* ═══════════════════════════════════════════════════════════
           CATÁLOGO DE PRECIOS — misma lógica y endpoints que la versión anterior.
           Los cambios están marcados con "CORRECCIÓN".
        ═══════════════════════════════════════════════════════════ */
        let currentPage = 1;
        let pageSize = 50;
        let currentSearch = "";
        let totalPages = 1;
        let totalItems = 0;
        let modalAnalisisSemanal = null;
        let modalImportarComp = null;
        let modalHistoricoPrecios = null;
        let histPage = 1;
        let histPageSize = 50;
        let histTotalPages = 1;
        let preciosSeq = 0; // CORRECCIÓN: solo se pinta la búsqueda más reciente

        function debounce(fn, ms = 350) {
            let t;
            return (...a) => { clearTimeout(t); t = setTimeout(() => fn(...a), ms); };
        }

        function fmtMoney(n) {
            const x = Number(n);
            return Number.isFinite(x) ? x.toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : "0.00";
        }
        function fmtNumAnalisis(v) { return Number(v ?? 0).toLocaleString('es-MX', { minimumFractionDigits: 0, maximumFractionDigits: 2 }); }
        function fmtMoneyAnalisis(v) { return Number(v ?? 0).toLocaleString('es-MX', { style: 'currency', currency: 'MXN' }); }
        function fmtPctAnalisis(v) { return `${Number(v ?? 0).toFixed(0)}%`; }

        function claseRecomendacion(reco) {
            const r = (reco || '').toUpperCase();
            if (r === 'BAJAR') return 'reco-bajar';
            if (r === 'SUBIR') return 'reco-subir';
            return 'reco-mantener';
        }

        function impEscapeHtml(str) {
            return String(str ?? '')
                .replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;')
                .replaceAll('"', '&quot;').replaceAll("'", '&#039;');
        }
        const esc = impEscapeHtml;
        const txt = v => (v === null || v === undefined || v === '') ? '—' : esc(v);
        const filaMensaje = (cols, texto, error = false) => `<tr class="t-msg${error ? ' is-error' : ''}"><td colspan="${cols}">${esc(texto)}</td></tr>`;

        function mostrarLoader(on, texto) {
            if (texto) document.getElementById("loaderText").textContent = texto;
            document.getElementById("loader").style.display = on ? "inline-flex" : "none";
        }

        /* ---------- Paginación ---------- */
        function renderNumericPager() {
            const host = document.getElementById("numericPager");
            if (!host) return;
            host.innerHTML = "";
            const total = Math.max(1, Number(totalPages || 1));
            const actual = Math.max(1, Math.min(Number(currentPage || 1), total));

            function addButton(label, page, options = {}) {
                const btn = document.createElement("button");
                btn.type = "button";
                btn.className = "page-num-btn";
                btn.textContent = label;
                if (options.aria) btn.setAttribute("aria-label", options.aria);
                if (options.active) { btn.classList.add("active"); btn.setAttribute("aria-current", "page"); }
                if (options.disabled) btn.disabled = true;
                if (!options.disabled && !options.active) {
                    btn.addEventListener("click", () => { currentPage = page; cargarPrecios(currentPage, currentSearch); });
                }
                host.appendChild(btn);
            }
            function addEllipsis() {
                const span = document.createElement("span");
                span.className = "page-ellipsis";
                span.textContent = "…";
                host.appendChild(span);
            }

            addButton("‹", actual - 1, { disabled: actual <= 1, aria: "Página anterior" });
            let pages = [];
            if (total <= 9) pages = Array.from({ length: total }, (_, i) => i + 1);
            else {
                const start = Math.max(2, actual - 3);
                const end = Math.min(total - 1, actual + 3);
                pages.push(1);
                if (start > 2) pages.push("...");
                for (let p = start; p <= end; p++) pages.push(p);
                if (end < total - 1) pages.push("...");
                pages.push(total);
            }
            pages.forEach(p => p === "..." ? addEllipsis() : addButton(String(p), p, { active: p === actual }));
            addButton("›", actual + 1, { disabled: actual >= total, aria: "Página siguiente" });
        }

        /* ---------- Tabla principal ---------- */
        async function cargarPrecios(page = 1, search = "") {
            const seq = ++preciosSeq;
            const tbody = document.querySelector("#tablaPrecios tbody");
            tbody.innerHTML = filaMensaje(9, "Cargando precios…");
            mostrarLoader(true, "Cargando…");

            try {
                const res = await fetch(`/Comercial/GetCatalogoPrecioJsonPaged?page=${page}&pageSize=${pageSize}&search=${encodeURIComponent(search)}`);
                if (!res.ok) throw new Error("No se pudo cargar el catálogo de precios.");
                const data = await res.json();
                if (seq !== preciosSeq) return;

                const rows = Array.isArray(data.precios) ? data.precios : [];
                totalItems = Number(data.total || 0);
                totalPages = Math.max(1, Math.ceil((data.total || 0) / (data.pageSize || pageSize)));
                currentPage = Number(data.page || page);
                pageSize = Number(data.pageSize || pageSize);

                document.getElementById("cpcCount").innerHTML = search
                    ? `<strong>${totalItems.toLocaleString('es-MX')}</strong> precio(s) coinciden con “${esc(search)}”`
                    : `<strong>${totalItems.toLocaleString('es-MX')}</strong> precio(s) cliente-SKU`;

                if (!rows.length) {
                    tbody.innerHTML = filaMensaje(9, search
                        ? "Ningún precio coincide con la búsqueda. Prueba con el SKU o parte del nombre del cliente."
                        : "No hay precios para mostrar. Usa Sincronizar con SAP para traerlos.");
                    document.getElementById("statusPageInfo").textContent = "Sin resultados";
                    renderNumericPager();
                    return;
                }

                // CORRECCIÓN: valores escapados (antes un nombre con < o comillas rompía la fila).
                tbody.innerHTML = rows.map(p => {
                    const sku = p.productoCodigo ?? p.ProductoCodigo ?? p.itemCode ?? "";
                    const cliente = p.cliente ?? p.Cliente ?? "";
                    const prod = p.productoNombre ?? p.ProductoNombre;
                    const cliNom = p.clienteNombre ?? p.ClienteNombre;
                    const lista = p.priceListName ?? p.PriceListName;
                    const fechaRaw = p.fechaModificacion ?? p.FechaModificacion;
                    return `
                        <tr>
                            <td class="t-sku" title="${esc(sku)}">${txt(sku)}</td>
                            <td title="${esc(prod)}">${txt(prod)}</td>
                            <td title="${esc(cliente)}">${txt(cliente)}</td>
                            <td title="${esc(cliNom)}">${txt(cliNom)}</td>
                            <td class="num">${txt(p.priceListNum ?? p.PriceListNum)}</td>
                            <td title="${esc(lista)}">${txt(lista)}</td>
                            <td class="num t-precio">${fmtMoney(p.precio ?? p.Precio)}</td>
                            <td class="es-muted">${fechaRaw ? esc(new Date(fechaRaw).toLocaleString('es-MX')) : "—"}</td>
                            <td class="text-center">
                                <button type="button" class="btn-audit-row" data-hist-sku="${esc(sku)}" data-hist-cliente="${esc(cliente)}"
                                        title="Ver historial de cambios del SKU ${esc(sku)}" aria-label="Historial del SKU ${esc(sku)}">
                                    <i class="bi bi-clock-history"></i>
                                </button>
                            </td>
                        </tr>`;
                }).join('');

                document.getElementById("statusPageInfo").textContent =
                    `Página ${currentPage.toLocaleString('es-MX')} de ${totalPages.toLocaleString('es-MX')} · ${totalItems.toLocaleString('es-MX')} registro(s)`;
                renderNumericPager();
                document.querySelector(".cpc .table-wrap").scrollTop = 0;
            } catch (err) {
                if (seq !== preciosSeq) return;
                tbody.innerHTML = filaMensaje(9, `${err.message} Recarga la página o inténtalo en un momento.`, true);
                document.getElementById("statusPageInfo").textContent = "Error al cargar";
            } finally {
                if (seq === preciosSeq) mostrarLoader(false);
            }
        }

        /* ═══════════════════════════════════════════════════════════
           HISTORIAL / AUDITORÍA
        ═══════════════════════════════════════════════════════════ */
        function histPick(obj, ...keys) {
            for (const key of keys) if (obj && obj[key] !== undefined && obj[key] !== null) return obj[key];
            return null;
        }
        function histFmtDateTime(value) {
            if (!value) return '—';
            const d = new Date(value);
            return Number.isNaN(d.getTime()) ? String(value) : d.toLocaleString('es-MX');
        }
        // CORRECCIÓN: una fecha "aaaa-mm-dd" se leía como UTC y en México se mostraba un día antes.
        function histFmtDate(value) {
            if (!value) return '—';
            const m = String(value).match(/^(\d{4})-(\d{2})-(\d{2})/);
            if (m) return `${m[3]}/${m[2]}/${m[1]}`;
            const d = new Date(value);
            return Number.isNaN(d.getTime()) ? String(value).slice(0, 10) : d.toLocaleDateString('es-MX');
        }
        function histFmtMoney(value) { return (value === null || value === undefined || value === '') ? '—' : fmtMoney(value); }
        function histAccionInfo(value) {
            const accion = String(value || '').toUpperCase().trim();
            if (accion === 'INSERT') return { texto: 'Alta', clase: 'audit-action-insert' };
            if (accion === 'UPDATE') return { texto: 'Actualización', clase: 'audit-action-update' };
            if (accion === 'SIN_CAMBIO') return { texto: 'Sin cambio', clase: 'audit-action-sin-cambio' };
            return { texto: accion || '—', clase: '' };
        }
        function histDiffClass(value) {
            const n = Number(value || 0);
            return n > 0 ? 'audit-diff-up' : n < 0 ? 'audit-diff-down' : 'audit-diff-zero';
        }
        function histSetText(id, value) {
            const el = document.getElementById(id);
            if (el) el.textContent = Number(value || 0).toLocaleString('es-MX');
        }
        function hoyLocalISO() {
            const d = new Date();
            return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
        }
        function histFechaHaceDiasISO(dias) {
            const d = new Date();
            d.setDate(d.getDate() - dias);
            return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
        }

        function histBuildQuery(page = 1) {
            const qs = new URLSearchParams();
            qs.set('page', page);
            qs.set('pageSize', histPageSize);
            const fields = {
                search: document.getElementById('histSearch')?.value || '',
                sku: document.getElementById('histSku')?.value || '',
                cliente: document.getElementById('histCliente')?.value || '',
                accion: document.getElementById('histAccion')?.value || '',
                usuario: document.getElementById('histUsuario')?.value || '',
                priceListNum: document.getElementById('histLista')?.value || '',
                fechaDesde: document.getElementById('histFechaDesde')?.value || '',
                fechaHasta: document.getElementById('histFechaHasta')?.value || ''
            };
            Object.entries(fields).forEach(([key, value]) => {
                const clean = String(value ?? '').trim();
                if (clean) qs.set(key, clean);
            });
            return qs;
        }

        function descargarHistoricoPreciosExcel() {
            const btn = document.getElementById('btnHistExcel');
            const textoOriginal = btn?.innerHTML || '';
            const qs = histBuildQuery(1);
            // El Excel trae TODOS los resultados filtrados, no solo la página visible.
            qs.delete('page');
            qs.delete('pageSize');
            if (btn) { btn.disabled = true; btn.innerHTML = '<span class="cpc-spin"></span> Generando Excel…'; }
            window.location.href = `/Comercial/ExportarHistoricoCatalogoPreciosExcel?${qs.toString()}`;
            setTimeout(() => { if (btn) { btn.disabled = false; btn.innerHTML = textoOriginal; } }, 2500);
        }

        function histLimpiarFiltros() {
            ['histSearch', 'histSku', 'histCliente', 'histUsuario', 'histLista'].forEach(id => {
                const el = document.getElementById(id);
                if (el) el.value = '';
            });
            const desde = document.getElementById('histFechaDesde');
            const hasta = document.getElementById('histFechaHasta');
            const accion = document.getElementById('histAccion');
            if (desde) desde.value = histFechaHaceDiasISO(30);
            if (hasta) hasta.value = hoyLocalISO();
            if (accion) accion.value = 'CAMBIOS';
        }

        function histCerrarDetalleClientes() { document.querySelectorAll('.hist-clientes-detail-row').forEach(row => row.remove()); }
        function histDecimalParam(value) {
            if (value === null || value === undefined || value === '') return '';
            const n = Number(value);
            return Number.isFinite(n) ? String(n) : '';
        }

        async function histToggleClientes(button) {
            const parentRow = button.closest('tr');
            if (!parentRow) return;
            const currentDetail = parentRow.nextElementSibling;
            if (currentDetail?.classList.contains('hist-clientes-detail-row')) { currentDetail.remove(); return; }

            histCerrarDetalleClientes();
            const detailRow = document.createElement('tr');
            detailRow.className = 'hist-clientes-detail-row';
            detailRow.innerHTML = `
                <td colspan="15">
                    <div class="audit-client-panel">
                        <div class="audit-client-panel-head"><span>Clientes afectados</span><span><span class="cpc-spin"></span> Consultando…</span></div>
                    </div>
                </td>`;
            parentRow.insertAdjacentElement('afterend', detailRow);

            const qs = new URLSearchParams();
            qs.set('loteId', button.dataset.lote || '');
            qs.set('sku', button.dataset.sku || '');
            qs.set('priceListNum', button.dataset.lista || '0');
            qs.set('accion', button.dataset.accion || '');
            const anterior = button.dataset.anterior;
            const nuevo = button.dataset.nuevo;
            if (anterior !== undefined && anterior !== '') qs.set('precioAnterior', anterior);
            if (nuevo !== undefined && nuevo !== '') qs.set('precioNuevo', nuevo);

            const panel = detailRow.querySelector('.audit-client-panel');
            try {
                const res = await fetch(`/Comercial/ObtenerClientesAfectadosHistoricoPrecios?${qs.toString()}`, { cache: 'no-store' });
                const raw = await res.text();
                if (!res.ok) throw new Error(raw || 'No se pudo consultar la lista de clientes.');
                const data = JSON.parse(raw);
                const clientes = Array.isArray(data.clientes) ? data.clientes : [];

                if (!clientes.length) {
                    panel.innerHTML = `
                        <div class="audit-client-panel-head"><span>Clientes afectados</span><span>0 clientes</span></div>
                        <div class="es-muted">No se encontraron clientes para este cambio.</div>`;
                    return;
                }
                panel.innerHTML = `
                    <div class="audit-client-panel-head">
                        <span>SKU ${esc(button.dataset.sku || '')} · ${clientes.length.toLocaleString('es-MX')} cliente(s) afectado(s)</span>
                        <button type="button" class="tool-btn tool-btn-secondary btn-cerrar-clientes">Cerrar lista</button>
                    </div>
                    <div class="audit-client-grid">
                        ${clientes.map(c => `
                            <div class="audit-client-item">
                                <span class="audit-client-code">${esc(histPick(c, 'cliente', 'Cliente') || '—')}</span>
                                <span>${esc(histPick(c, 'clienteNombre', 'ClienteNombre') || 'Sin nombre')}</span>
                            </div>`).join('')}
                    </div>`;
            } catch (e) {
                console.error(e);
                panel.innerHTML = `
                    <div class="audit-client-panel-head"><span>Clientes afectados</span><button type="button" class="tool-btn tool-btn-secondary btn-cerrar-clientes">Cerrar</button></div>
                    <div style="color:var(--es-bad)">${esc(e.message)}</div>`;
            }
        }

        async function cargarHistoricoPrecios(page = 1) {
            const body = document.getElementById('histBody');
            const loader = document.getElementById('histLoader');
            const prev = document.getElementById('histPrev');
            const next = document.getElementById('histNext');
            if (!body) return;

            histCerrarDetalleClientes();
            body.innerHTML = filaMensaje(15, 'Consultando cambios…');
            if (loader) loader.style.display = 'inline-flex';
            if (prev) prev.disabled = true;
            if (next) next.disabled = true;

            try {
                const res = await fetch(`/Comercial/ObtenerHistoricoCatalogoPrecios?${histBuildQuery(page).toString()}`, { cache: 'no-store' });
                const raw = await res.text();
                if (!res.ok) throw new Error(raw || 'No se pudo consultar el historial.');

                const data = JSON.parse(raw);
                const registros = Array.isArray(data.registros) ? data.registros : [];
                const resumen = data.resumen || {};
                const total = Number(data.total || histPick(resumen, 'total', 'Total') || 0);
                const pageSizeResp = Number(data.pageSize || histPageSize);

                histPage = Number(data.page || page);
                histTotalPages = Math.max(1, Math.ceil(total / pageSizeResp));

                histSetText('histKpiTotal', total);
                histSetText('histKpiClientes', histPick(resumen, 'impactosClientes', 'ImpactosClientes'));
                histSetText('histKpiInsert', histPick(resumen, 'insertados', 'Insertados'));
                histSetText('histKpiUpdate', histPick(resumen, 'actualizados', 'Actualizados'));
                histSetText('histKpiSubidas', histPick(resumen, 'subidas', 'Subidas'));
                histSetText('histKpiBajadas', histPick(resumen, 'bajadas', 'Bajadas'));

                const pageInfo = document.getElementById('histPageInfo');
                if (pageInfo) pageInfo.textContent = `Página ${histPage} de ${histTotalPages} · ${total.toLocaleString('es-MX')} cambio(s) de SKU`;

                if (!registros.length) {
                    body.innerHTML = filaMensaje(15, 'No hay cambios con estos filtros. Amplía el rango de fechas o elige "Todos" en tipo de movimiento.');
                    return;
                }

                body.innerHTML = registros.map(r => {
                    const accionInfo = histAccionInfo(histPick(r, 'accion', 'Accion'));
                    const diferencia = Number(histPick(r, 'diferencia', 'Diferencia') || 0);
                    const variacion = histPick(r, 'variacionPct', 'VariacionPct');
                    const lote = String(histPick(r, 'loteId', 'LoteId') || '');
                    const sku = String(histPick(r, 'productoCodigo', 'ProductoCodigo') || '');
                    const lista = histPick(r, 'priceListNum', 'PriceListNum');
                    const precioAnterior = histPick(r, 'precioAnterior', 'PrecioAnterior');
                    const precioNuevo = histPick(r, 'precioNuevo', 'PrecioNuevo');
                    const clientes = Number(histPick(r, 'clientesAfectados', 'ClientesAfectados') || 0);
                    const fechaG = histFmtDateTime(histPick(r, 'fechaGuardado', 'FechaGuardado'));
                    const prodNom = histPick(r, 'productoNombre', 'ProductoNombre') || '';
                    const listaNom = histPick(r, 'priceListName', 'PriceListName') || '';

                    return `
                        <tr>
                            <td title="${esc(fechaG)}">${esc(fechaG)}</td>
                            <td><span class="audit-action ${accionInfo.clase}">${esc(accionInfo.texto)}</span></td>
                            <td style="font-weight:600">${esc(sku || '—')}</td>
                            <td title="${esc(prodNom)}">${esc(prodNom || '—')}</td>
                            <td>${esc(histPick(r, 'master', 'Master') || '—')}</td>
                            <td title="${esc(listaNom)}">${esc(lista ?? '—')} - ${esc(listaNom || '—')}</td>
                            <td class="num">${histFmtMoney(precioAnterior)}</td>
                            <td class="num" style="font-weight:600">${histFmtMoney(precioNuevo)}</td>
                            <td class="num ${histDiffClass(diferencia)}">${histFmtMoney(diferencia)}</td>
                            <td class="num ${histDiffClass(diferencia)}">${variacion === null || variacion === undefined ? '—' : `${Number(variacion).toFixed(2)}%`}</td>
                            <td>${esc(histFmtDate(histPick(r, 'fechaCorte', 'FechaCorte')))}</td>
                            <td>${esc(histFmtDate(histPick(r, 'fechaUso', 'FechaUso')))}</td>
                            <td>${esc(histPick(r, 'usuario', 'Usuario') || '—')}</td>
                            <td>
                                <button type="button" class="audit-client-count-btn btn-hist-clientes"
                                        data-lote="${esc(lote)}" data-sku="${esc(sku)}" data-lista="${esc(lista ?? '')}"
                                        data-accion="${esc(histPick(r, 'accion', 'Accion') || '')}"
                                        data-anterior="${esc(histDecimalParam(precioAnterior))}" data-nuevo="${esc(histDecimalParam(precioNuevo))}">
                                    <i class="bi bi-people"></i> ${clientes.toLocaleString('es-MX')} cliente(s)
                                </button>
                            </td>
                            <td title="${esc(lote)}" style="font-family:var(--es-mono);font-size:11.5px;">${esc(lote || '—')}</td>
                        </tr>`;
                }).join('');
            } catch (e) {
                console.error(e);
                body.innerHTML = filaMensaje(15, e.message, true);
                const pageInfo = document.getElementById('histPageInfo');
                if (pageInfo) pageInfo.textContent = 'Error al consultar';
            } finally {
                if (loader) loader.style.display = 'none';
                if (prev) prev.disabled = histPage <= 1;
                if (next) next.disabled = histPage >= histTotalPages;
            }
        }

        async function abrirHistoricoPrecios(sku = '', cliente = '', limpiar = false) {
            if (limpiar) histLimpiarFiltros();
            const skuInput = document.getElementById('histSku');
            const clienteInput = document.getElementById('histCliente');
            if (skuInput) skuInput.value = sku || '';
            if (clienteInput) clienteInput.value = cliente || '';
            modalHistoricoPrecios?.show();
            await cargarHistoricoPrecios(1);
        }

        /* ═══════════════════════════════════════════════════════════
           ANÁLISIS SEMANAL
        ═══════════════════════════════════════════════════════════ */
        async function cargarAnalisisSemanal() {
            const tbody = document.getElementById('analisisSemanalBody');
            const colCount = document.querySelectorAll('#tablaAnalisisSemanal thead th').length || 1;
            const btn = document.getElementById('btnCalcularAnalisis');
            const original = btn?.innerHTML;

            tbody.innerHTML = filaMensaje(colCount, 'Calculando…');
            if (btn) { btn.disabled = true; btn.innerHTML = '<span class="cpc-spin cpc-spin--light"></span> Calculando…'; }

            const payload = {
                fechaCorte: document.getElementById('anaFechaCorte')?.value || '',
                skus: actualizarContadorSkus(),
                master: document.getElementById('anaMaster')?.value || ''
            };

            try {
                const res = await fetch('/Comercial/ObtenerAnalisisSemanal', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const text = await res.text();
                if (!res.ok) { tbody.innerHTML = filaMensaje(colCount, text || 'No se pudo calcular el análisis.', true); return; }

                let rows = [];
                try { rows = JSON.parse(text); }
                catch {
                    tbody.innerHTML = filaMensaje(colCount, 'El servidor regresó una respuesta inválida.', true);
                    console.error('Respuesta no JSON:', text);
                    return;
                }

                if (!Array.isArray(rows) || !rows.length) {
                    tbody.innerHTML = filaMensaje(colCount, 'Sin resultados para estos filtros.');
                    return;
                }

                // CORRECCIÓN: textos escapados (un comentario con "</textarea>" rompía la fila).
                tbody.innerHTML = rows.map(r => {
                    const precioSugerido = sugerirPrecioNuevoAnalisis(r);
                    return `<tr data-sku="${esc(r.sku ?? '')}" data-master="${esc(r.master ?? '')}" data-prod="${esc(r.skuProd ?? '')}"
                                data-clasificacion="${esc(r.clasificacion ?? '')}" data-actual="${Number(r.ppVentaReal ?? 0)}">
                        <td>${esc(r.clasificacion ?? '')}</td>
                        <td>${esc(r.master ?? '')}</td>
                        <td>${esc(r.sku ?? '')}</td>
                        <td>${esc(r.skuProd ?? '')}</td>
                        <td class="num">${fmtNumAnalisis(r.invInicialRefer)}</td>
                        <td class="num">${fmtNumAnalisis(r.inventarioActual)}</td>
                        <td class="num">${fmtNumAnalisis(r.inventarioAnterior)}</td>
                        <td class="num">${fmtNumAnalisis(r.inventarioIdeal)}</td>
                        <td class="num">${fmtNumAnalisis(r.pedidos)}</td>
                        <td class="num">${fmtNumAnalisis(r.kgVenta)}</td>
                        <td class="num">${fmtNumAnalisis(r.diasInventario)}</td>
                        <td class="num">${fmtNumAnalisis(r.semana1)}</td>
                        <td class="num">${fmtNumAnalisis(r.semana2)}</td>
                        <td class="num">${fmtNumAnalisis(r.semana3)}</td>
                        <td class="num">${fmtMoneyAnalisis(r.ppVentaReal)}</td>
                        <td class="num">${fmtMoneyAnalisis(r.prom)}</td>
                        <td style="white-space:normal;">${esc(r.competidores ?? '')}</td>
                        <td class="num">${fmtPctAnalisis((r.difPct ?? 0) * 100)}</td>
                        <td class="${claseRecomendacion(r.recomendacion)}">${esc(r.recomendacion ?? '')}</td>
                        <td><textarea class="ana-comentario-input" rows="1" aria-label="Comentario del SKU ${esc(r.sku ?? '')}">${esc(r.comentarios ?? '')}</textarea></td>
                        <td class="ana-check-cell"><input type="checkbox" class="ana-chk-guardar" checked aria-label="Guardar SKU ${esc(r.sku ?? '')}" /></td>
                        <td class="num"><input type="text" inputmode="decimal" class="ana-precio-input ana-precio-nuevo" value="${precioSugerido.toFixed(2)}" aria-label="Precio nuevo del SKU ${esc(r.sku ?? '')}" /></td>
                    </tr>`;
                }).join('');

                actualizarEncabezadosAnalisis(document.getElementById('anaFechaCorte').value);
            } catch (e) {
                tbody.innerHTML = filaMensaje(colCount, e.message, true);
                console.error(e);
            } finally {
                if (btn) { btn.disabled = false; btn.innerHTML = original; }
            }
        }

        function getISOWeek(date) {
            const d = new Date(Date.UTC(date.getFullYear(), date.getMonth(), date.getDate()));
            const dayNum = d.getUTCDay() || 7;
            d.setUTCDate(d.getUTCDate() + 4 - dayNum);
            const yearStart = new Date(Date.UTC(d.getUTCFullYear(), 0, 1));
            return Math.ceil((((d - yearStart) / 86400000) + 1) / 7);
        }
        function formatFechaMX(date) {
            return `${String(date.getDate()).padStart(2, '0')}/${String(date.getMonth() + 1).padStart(2, '0')}/${date.getFullYear()}`;
        }
        function actualizarEncabezadosAnalisis(fechaCorte) {
            if (!fechaCorte) return;
            const fc = new Date(`${fechaCorte}T00:00:00`);
            if (isNaN(fc)) return;
            const ant = new Date(fc); ant.setDate(ant.getDate() - 7);
            const s1 = new Date(fc); s1.setDate(s1.getDate() - 21);
            const s2 = new Date(fc); s2.setDate(s2.getDate() - 14);
            const s3 = new Date(fc); s3.setDate(s3.getDate() - 7);
            document.getElementById('thInvActual').textContent = `Inventario ${formatFechaMX(fc)}`;
            document.getElementById('thInvAnterior').textContent = `Inventario ${formatFechaMX(ant)}`;
            document.getElementById('thSemana1').textContent = `Semana ${getISOWeek(s1)}`;
            document.getElementById('thSemana2').textContent = `Semana ${getISOWeek(s2)}`;
            document.getElementById('thSemana3').textContent = `Semana ${getISOWeek(s3)}`;
        }

        // Interpreta "$1,234.50", "142,50" (coma decimal) y "MXN 142.5".
        function parsePrecioExcel(v) {
            let s = String(v ?? '').trim();
            if (!s) return null;
            s = s.replace(/\$/g, '').replace(/MXN/gi, '').replace(/\s+/g, '');
            if (s.includes(',') && !s.includes('.')) s = s.replace(',', '.');
            else s = s.replace(/,/g, '');
            s = s.replace(/[^0-9.-]/g, '');
            const n = Number(s);
            return Number.isFinite(n) ? n : null;
        }

        // CORRECCIÓN: antes "142,50" se guardaba como 14250 (se quitaba la coma).
        // Ahora se usa la misma lectura que al pegar desde Excel.
        function parseMoneyValue(v) {
            const n = parsePrecioExcel(v);
            return n === null ? 0 : n;
        }

        // Marca en amarillo los precios que se alejan más de 30% del precio de venta real.
        function marcarVariacionPrecio(input) {
            const tr = input.closest('tr');
            const actual = Number(tr?.dataset.actual || 0);
            const nuevo = parsePrecioExcel(input.value);
            const alerta = actual > 0 && nuevo !== null && nuevo > 0 && Math.abs(nuevo - actual) / actual > 0.30;
            input.classList.toggle('is-warn', alerta);
            input.title = alerta ? `Se aleja más de 30% del precio de venta real (${fmtMoneyAnalisis(actual)})` : '';
        }

        function aplicarPegadoPreciosDesdeExcel(inputInicial, textoPegado) {
            const filas = String(textoPegado || '').split(/\r?\n/).filter(x => x.trim() !== '');
            if (!filas.length) return;
            const inputs = Array.from(document.querySelectorAll('#analisisSemanalBody .ana-precio-nuevo'));
            const startIndex = inputs.indexOf(inputInicial);
            if (startIndex < 0) return;

            filas.forEach((fila, i) => {
                const inputDestino = inputs[startIndex + i];
                if (!inputDestino) return;
                const precio = parsePrecioExcel(fila.split('\t')[0]);
                if (precio === null) return;
                inputDestino.value = precio.toFixed(2);
                const chk = inputDestino.closest('tr')?.querySelector('.ana-chk-guardar');
                if (chk) chk.checked = true;
                inputDestino.dispatchEvent(new Event('input', { bubbles: true }));
                inputDestino.dispatchEvent(new Event('change', { bubbles: true }));
            });
        }

        document.getElementById('analisisSemanalBody')?.addEventListener('paste', function (e) {
            const input = e.target.closest('.ana-precio-nuevo');
            if (!input) return;
            const texto = (e.clipboardData || window.clipboardData)?.getData('text') || '';
            if (!texto) return;
            if (!(texto.includes('\n') || texto.includes('\t'))) return; // un solo precio: pegado normal
            e.preventDefault();
            aplicarPegadoPreciosDesdeExcel(input, texto);
        });

        document.getElementById('analisisSemanalBody')?.addEventListener('input', function (e) {
            if (e.target.classList?.contains('ana-precio-nuevo')) marcarVariacionPrecio(e.target);
        });
        // Al salir del campo se muestra el precio tal como se va a guardar.
        document.getElementById('analisisSemanalBody')?.addEventListener('focusout', function (e) {
            if (!e.target.classList?.contains('ana-precio-nuevo')) return;
            const n = parsePrecioExcel(e.target.value);
            if (n !== null) e.target.value = n.toFixed(2);
            marcarVariacionPrecio(e.target);
        });

        function sugerirPrecioNuevoAnalisis(r) {
            const actual = Number(r.ppVentaReal ?? 0);
            const promedioComp = Number(r.prom ?? 0);
            const reco = String(r.recomendacion ?? '').toUpperCase();
            if (reco === 'BAJAR' && promedioComp > 0 && actual > 0) return Math.min(actual, promedioComp);
            if (reco === 'SUBIR' && promedioComp > 0 && actual > 0) return Math.max(actual, promedioComp);
            if (actual > 0) return actual;
            if (promedioComp > 0) return promedioComp;
            return 0;
        }

        function obtenerRegistrosGuardarPrecioPublico() {
            const registros = [];
            document.querySelectorAll('#analisisSemanalBody tr').forEach(tr => {
                const chk = tr.querySelector('.ana-chk-guardar');
                const inputPrecio = tr.querySelector('.ana-precio-nuevo');
                if (!chk || !chk.checked) return;
                const sku = tr.dataset.sku || '';
                const precio = parseMoneyValue(inputPrecio?.value);
                if (!sku || precio <= 0) return;
                registros.push({
                    productoCodigo: sku,
                    precio: precio,
                    master: tr.dataset.master || '',
                    productoNombre: tr.dataset.prod || '',
                    clasificacion: tr.dataset.clasificacion || '',
                    comentarios: tr.querySelector('.ana-comentario-input')?.value || ''
                });
            });
            return registros;
        }

