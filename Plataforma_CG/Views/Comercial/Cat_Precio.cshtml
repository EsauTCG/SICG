@model IEnumerable<Plataforma_CG.Models.CatalogoPrecioSap>

@{
    ViewData["Title"] = "Catálogo de Precios por Cliente";
    Layout = "~/Views/Shared/_Layout2.cshtml";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    /* =====================================================================
       CATÁLOGO DE PRECIOS POR CLIENTE · SIGO — hoja de estilos única
       Mismo sistema visual que el resto de módulos. Sustituye las 4 capas
       anteriores. Conserva los nombres de clase que usa el JavaScript.
       ===================================================================== */
    :root {
        --es-tinto: #8d3e46;
        --es-tinto-deep: #5c2229;
        --es-tinto-soft: #f7eced;
        --es-tinto-line: #e8d3d6;
        --es-paper: #f6f4f4;
        --es-surface: #ffffff;
        --es-field: #ffffff;
        --es-head: #faf7f7;
        --es-hover: #fcf9f9;
        --es-row-line: #f0eaeb;
        --es-ink: #231a1c;
        --es-muted: #76686b;
        --es-line: #e6dfe0;
        --es-line-strong: #cfc4c6;
        --es-ok: #2f7a55;
        --es-ok-bg: #e7f3ec;
        --es-warn: #9a6410;
        --es-warn-bg: #fbf1de;
        --es-bad: #b42d2d;
        --es-bad-bg: #fbe9e8;
        --es-info: #2f5d86;
        --es-info-bg: #e9f0f7;
        --es-neutral-bg: #efecec;
        --es-font: "Poppins", "Segoe UI", system-ui, -apple-system, Arial, sans-serif;
        --es-mono: ui-monospace, "Cascadia Mono", Consolas, monospace;
    }

    body[data-theme="dark"] {
        --es-tinto: #c56b74;
        --es-tinto-deep: #7a2d36;
        --es-tinto-soft: #3a2427;
        --es-tinto-line: #5a3439;
        --es-paper: #16181c;
        --es-surface: #202328;
        --es-field: #181a1e;
        --es-head: #262a30;
        --es-hover: #2a2e34;
        --es-row-line: #30343b;
        --es-ink: #edf0f3;
        --es-muted: #a9b0b9;
        --es-line: #363b43;
        --es-line-strong: #4a5059;
        --es-ok: #6cc596;
        --es-ok-bg: #1d3328;
        --es-warn: #e0b061;
        --es-warn-bg: #3a2f1b;
        --es-bad: #f08a83;
        --es-bad-bg: #3d2223;
        --es-info: #8bb8e0;
        --es-info-bg: #1e2b38;
        --es-neutral-bg: #2c3036;
    }

    .cpc, .cpc-modal { font-family: var(--es-font) !important; color: var(--es-ink); font-size: 13px; line-height: 1.4; }
    .cpc *, .cpc-modal * { box-sizing: border-box; }
    .cpc .bi, .cpc-modal .bi { font-family: "bootstrap-icons" !important; }
    .cpc { background: var(--es-paper); padding: 16px 18px 10px; min-width: 0; }
    .num { text-align: right !important; font-variant-numeric: tabular-nums; }
    .es-muted { color: var(--es-muted); }

    /* ---------- Encabezado ---------- */
    .cpc-header { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 14px; }
    .cpc-header__title { display: flex; align-items: center; gap: 12px; }
    .cpc-header__icon { width: 40px; height: 40px; border-radius: 10px; display: grid; place-items: center; background: var(--es-tinto); color: #fff; font-size: 19px; }
    .cpc-header h1 { margin: 0; font-size: 20px; font-weight: 700; letter-spacing: -.01em; line-height: 1.15; color: var(--es-ink); }
    .cpc-header p { margin: 2px 0 0; font-size: 12px; color: var(--es-muted); }
    .cpc-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }

    /* ---------- Botones (conservan las clases que usa el JS) ---------- */
    .tool-btn, .imp-btn {
        display: inline-flex; align-items: center; justify-content: center; gap: 6px;
        height: 36px; padding: 0 14px; border: 1px solid var(--es-line-strong); border-radius: 7px;
        background: var(--es-field); color: var(--es-ink); font: 600 12.5px/1 var(--es-font);
        white-space: nowrap; cursor: pointer; text-decoration: none; box-shadow: none;
        transition: background .12s, border-color .12s, color .12s;
    }
    .tool-btn:hover, .imp-btn:hover { background: var(--es-tinto-soft); border-color: var(--es-tinto-line); color: var(--es-ink); }
    .tool-btn:focus-visible, .imp-btn:focus-visible { outline: 2px solid var(--es-tinto); outline-offset: 2px; }
    .tool-btn:disabled, .imp-btn:disabled { opacity: .5; cursor: not-allowed; }
    .tool-btn-primary, .imp-btn-primary { background: var(--es-tinto); border-color: var(--es-tinto); color: #fff; }
    .tool-btn-primary:hover, .imp-btn-primary:hover { background: var(--es-tinto-deep); border-color: var(--es-tinto-deep); color: #fff; }
    .tool-btn-success, .imp-btn-success { background: var(--es-ok); border-color: var(--es-ok); color: #fff; }
    .tool-btn-success:hover, .imp-btn-success:hover { filter: brightness(.92); background: var(--es-ok); border-color: var(--es-ok); color: #fff; }
    .tool-btn-secondary, .tool-btn-purple, .imp-btn-secondary { background: var(--es-field); color: var(--es-ink); }
    .tool-btn.dropdown-toggle::after { margin-left: 4px; }

    /* ---------- Tarjeta principal ---------- */
    .cpc-card { background: var(--es-surface); border: 1px solid var(--es-line); border-radius: 10px; overflow: hidden; }
    .cpc-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; padding: 12px 14px; border-bottom: 1px solid var(--es-line); }
    .cpc-search { position: relative; width: 440px; max-width: 100%; }
    .cpc-search i { position: absolute; left: 11px; top: 50%; transform: translateY(-50%); color: var(--es-muted); font-size: 13px; pointer-events: none; }
    .cpc #searchInput { display: block; width: 100%; height: 36px; padding: 0 10px 0 32px; border: 1px solid var(--es-line-strong); border-radius: 7px; background: var(--es-field); color: var(--es-ink); font: 500 13px/1 var(--es-font); box-shadow: none; }
    .cpc #searchInput:focus { outline: none; border-color: var(--es-tinto); box-shadow: 0 0 0 3px rgba(141,62,70,.16); }
    .cpc-count { font-size: 12px; color: var(--es-muted); }
    .cpc-count strong { color: var(--es-ink); font-weight: 600; }
    #loader { display: inline-flex; align-items: center; gap: 7px; font-size: 12px; color: var(--es-muted); }
    .cpc-spin { display: inline-block; width: 13px; height: 13px; border: 2px solid var(--es-tinto-line); border-top-color: var(--es-tinto); border-radius: 50%; animation: cpc-spin .8s linear infinite; vertical-align: middle; }
    .cpc-spin--light { border-color: rgba(255,255,255,.35); border-top-color: #fff; }
    @@keyframes cpc-spin { to { transform: rotate(360deg); } }
    @@media (prefers-reduced-motion: reduce) { .cpc-spin { animation-duration: 2s; } }

    /* ---------- Tablas comunes ---------- */
    .table-wrap, .analisis-grid-wrap, .audit-table-wrap, .imp-scroll { overflow: auto; background: var(--es-surface); }
    .cpc .table-wrap { max-height: calc(100dvh - 300px); min-height: 260px; }
    .cpc-table, .cpc-modal .table, #tablaHistoricoPrecios, .imp-table {
        width: 100%; margin: 0; border-collapse: separate; border-spacing: 0; font-size: 12.5px; color: var(--es-ink);
        --bs-table-bg: transparent; --bs-table-color: var(--es-ink); --bs-table-hover-bg: transparent; --bs-table-border-color: transparent;
    }
    .cpc-table thead th, .cpc-modal .table thead th, #tablaHistoricoPrecios thead th, .imp-table thead th {
        position: sticky; top: 0; z-index: 2; padding: 9px 10px; background: var(--es-head);
        border: 0; border-bottom: 1px solid var(--es-line); color: var(--es-muted);
        font-size: 11.5px; font-weight: 600; text-align: left; white-space: nowrap; text-transform: none;
    }
    .cpc-table tbody td, .cpc-modal .table tbody td, #tablaHistoricoPrecios tbody td, .imp-table tbody td {
        padding: 7px 10px; border: 0; border-bottom: 1px solid var(--es-row-line); background: var(--es-surface);
        color: var(--es-ink); vertical-align: middle; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; box-shadow: none;
    }
    .cpc-table tbody tr:hover td, .cpc-modal .table tbody tr:hover td, #tablaHistoricoPrecios tbody tr:hover td, .imp-table tbody tr:hover td { background: var(--es-hover); }
    .t-msg td { padding: 34px 10px !important; text-align: center; color: var(--es-muted) !important; white-space: normal !important; }
    .t-msg.is-error td { color: var(--es-bad) !important; background: var(--es-bad-bg) !important; }

    #tablaPrecios { table-layout: fixed; min-width: 1150px; }
    #tablaPrecios td.t-sku { font-weight: 600; font-variant-numeric: tabular-nums; }
    #tablaPrecios td.t-precio { font-weight: 600; }
    .btn-audit-row { width: 30px; height: 28px; padding: 0; display: inline-grid; place-items: center; border: 1px solid var(--es-line-strong); border-radius: 6px; background: var(--es-field); color: var(--es-ink); cursor: pointer; }
    .btn-audit-row:hover { background: var(--es-tinto-soft); border-color: var(--es-tinto-line); }
    .btn-audit-row:focus-visible { outline: 2px solid var(--es-tinto); outline-offset: 2px; }

    /* ---------- Paginación ---------- */
    .cpc .pager { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; padding: 10px 14px; border-top: 1px solid var(--es-line); }
    #statusPageInfo { font-size: 12px; color: var(--es-muted); font-variant-numeric: tabular-nums; }
    .pagination-numeric { display: flex; align-items: center; gap: 4px; flex-wrap: wrap; }
    .page-num-btn { min-width: 32px; height: 32px; padding: 0 8px; border: 1px solid var(--es-line-strong); border-radius: 7px; background: var(--es-field); color: var(--es-ink); font: 500 12.5px/1 var(--es-font); font-variant-numeric: tabular-nums; cursor: pointer; }
    .page-num-btn:hover:not(:disabled):not(.active) { background: var(--es-tinto-soft); border-color: var(--es-tinto-line); }
    .page-num-btn.active { background: var(--es-tinto); border-color: var(--es-tinto); color: #fff; font-weight: 600; cursor: default; }
    .page-num-btn:disabled { opacity: .4; cursor: default; }
    .page-ellipsis { min-width: 24px; text-align: center; color: var(--es-muted); }
    .cpc-statusbar { display: flex; gap: 18px; flex-wrap: wrap; padding: 8px 2px 0; font-size: 11.5px; color: var(--es-muted); }

    /* ---------- Menú Gestión ---------- */
    .gestion-menu { min-width: 250px; padding: 4px; border: 1px solid var(--es-line-strong); border-radius: 8px; background: var(--es-surface); box-shadow: 0 10px 28px rgba(0,0,0,.15); }
    .gestion-menu .dropdown-item { display: flex; align-items: center; gap: 8px; padding: 8px 10px; border-radius: 6px; font: 500 12.5px/1.2 var(--es-font); color: var(--es-ink); }
    .gestion-menu .dropdown-item small { display: block; font-size: 11px; color: var(--es-muted); }
    .gestion-menu .dropdown-item:hover, .gestion-menu .dropdown-item:focus { background: var(--es-tinto-soft); color: var(--es-ink); }

    /* ---------- Modales ---------- */
    .cpc-modal.modal-content { border: 0; border-radius: 12px; overflow: hidden; background: var(--es-surface); box-shadow: 0 18px 50px rgba(35,26,28,.25); }
    .cpc-modal .modal-header { padding: 13px 18px; background: var(--es-tinto-deep); color: #fff; border-bottom: 0; }
    .cpc-modal .modal-title { display: flex; align-items: center; gap: 8px; font-size: 15px; font-weight: 600; color: #fff; }
    .cpc-modal .btn-close { filter: invert(1) grayscale(1) brightness(2); opacity: .9; }
    .cpc-modal .modal-body { background: var(--es-paper); color: var(--es-ink); padding: 14px 16px; }
    .cpc-modal .modal-footer { background: var(--es-head); border-top: 1px solid var(--es-line); }
    .modal-xl-cg { max-width: min(1600px, 97vw); }
    .audit-modal-dialog { max-width: min(1600px, 97vw) !important; }

    .cpc-modal .form-label, .cpc-modal label { display: block; margin: 0 0 5px; font-size: 12px; font-weight: 600; color: var(--es-muted); }
    .cpc-modal .form-control, .cpc-modal .form-select {
        height: 36px; min-height: 36px; padding: 0 10px; border: 1px solid var(--es-line-strong); border-radius: 7px;
        background-color: var(--es-field); color: var(--es-ink); font: 500 13px/1.2 var(--es-font); box-shadow: none;
    }
    .cpc-modal textarea.form-control { height: auto; padding: 8px 10px; resize: vertical; }
    .cpc-modal .form-control:focus, .cpc-modal .form-select:focus { border-color: var(--es-tinto); box-shadow: 0 0 0 3px rgba(141,62,70,.16); outline: none; background-color: var(--es-field); color: var(--es-ink); }
    body[data-theme="dark"] .cpc-modal .form-control, body[data-theme="dark"] .cpc-modal .form-select { color-scheme: dark; }

    /* Secciones dentro de modales */
    .cpc-modal .section, .imp-step { background: var(--es-surface); border: 1px solid var(--es-line); border-radius: 10px; margin-bottom: 12px; overflow: hidden; }
    .cpc-modal .section-title, .imp-step-title { display: flex; align-items: center; justify-content: space-between; gap: 8px; flex-wrap: wrap; padding: 10px 14px; border-bottom: 1px solid var(--es-line); font-size: 13px; font-weight: 600; color: var(--es-ink); background: var(--es-surface); }
    .imp-step-title { justify-content: flex-start; }
    .imp-step-num { width: 24px; height: 24px; border-radius: 50%; display: inline-grid; place-items: center; background: var(--es-tinto); color: #fff; font-size: 12px; font-weight: 700; flex: none; }
    .cpc-modal .section-body, .imp-step-body { padding: 14px; }
    .status-chip, #histPageInfo { display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px; border-radius: 999px; background: var(--es-neutral-bg); color: var(--es-muted); font-size: 11.5px; font-weight: 500; }

    /* Análisis semanal */
    .ana-filters { display: grid; grid-template-columns: 170px minmax(260px, 2fr) minmax(160px, 1fr) auto; gap: 12px; align-items: end; }
    #anaSkuCount { display: block; margin-top: 4px; font-size: 11.5px; color: var(--es-muted); }
    .analisis-grid-wrap { max-height: 56vh; }
    #tablaAnalisisSemanal { table-layout: fixed; min-width: 2300px; }
    #tablaAnalisisSemanal th:nth-child(1), #tablaAnalisisSemanal td:nth-child(1) { width: 120px; }
    #tablaAnalisisSemanal th:nth-child(2), #tablaAnalisisSemanal td:nth-child(2) { width: 120px; }
    #tablaAnalisisSemanal th:nth-child(3), #tablaAnalisisSemanal td:nth-child(3) { width: 100px; font-weight: 600; }
    #tablaAnalisisSemanal th:nth-child(4), #tablaAnalisisSemanal td:nth-child(4) { width: 280px; white-space: normal; }
    #tablaAnalisisSemanal th:nth-child(17), #tablaAnalisisSemanal td:nth-child(17) { width: 320px; white-space: normal; }
    #tablaAnalisisSemanal th:nth-child(19), #tablaAnalisisSemanal td:nth-child(19) { width: 130px; }
    #tablaAnalisisSemanal th:nth-child(20), #tablaAnalisisSemanal td:nth-child(20) { width: 230px; }
    #tablaAnalisisSemanal th:nth-child(21), #tablaAnalisisSemanal td:nth-child(21) { width: 80px; text-align: center; }
    #tablaAnalisisSemanal th:nth-child(22), #tablaAnalisisSemanal td:nth-child(22) { width: 150px; }
    .reco-bajar, .reco-subir, .reco-mantener { font-weight: 600; }
    .reco-bajar { color: var(--es-bad) !important; background: var(--es-bad-bg) !important; }
    .reco-subir { color: var(--es-ok) !important; background: var(--es-ok-bg) !important; }
    .reco-mantener { color: var(--es-warn) !important; background: var(--es-warn-bg) !important; }
    .ana-check-cell input { width: 17px; height: 17px; accent-color: var(--es-tinto); cursor: pointer; }
    .ana-precio-input, .ana-comentario-input, .imp-cap-input, .imp-sku-search, .imp-table select {
        width: 100%; height: 30px; padding: 0 8px; border: 1px solid var(--es-line-strong); border-radius: 6px;
        background: var(--es-field); color: var(--es-ink); font: 500 12.5px/1.2 var(--es-font);
    }
    .ana-precio-input { text-align: right; font-variant-numeric: tabular-nums; font-weight: 600; }
    .ana-precio-input.is-warn { border-color: var(--es-warn); background: var(--es-warn-bg); }
    .ana-comentario-input { height: 30px; min-height: 30px; padding: 5px 8px; resize: vertical; }
    .ana-precio-input:focus, .ana-comentario-input:focus, .imp-cap-input:focus, .imp-sku-search:focus, .imp-table select:focus { outline: none; border-color: var(--es-tinto); box-shadow: 0 0 0 3px rgba(141,62,70,.16); }
    .ana-guardar { display: flex; align-items: end; gap: 12px; flex-wrap: wrap; }
    .ana-guardar__acciones { display: flex; gap: 8px; margin-left: auto; }
    .ana-ayuda { margin: 10px 0 0; font-size: 11.5px; color: var(--es-muted); }

    /* Importar competencia */
    .imp-alert { padding: 9px 12px; margin-bottom: 10px; border: 1px solid; border-radius: 8px; font-size: 12.5px; }
    .imp-alert-info { background: var(--es-info-bg); border-color: transparent; color: var(--es-info); }
    .imp-alert-success { background: var(--es-ok-bg); border-color: transparent; color: var(--es-ok); }
    .imp-alert-error { background: var(--es-bad-bg); border-color: transparent; color: var(--es-bad); }
    .imp-head-fields { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 12px; }
    .imp-head-fields > div { width: 220px; }
    .imp-tools { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-bottom: 8px; }
    .imp-tools span { font-size: 12px; color: var(--es-muted); }
    .imp-scroll { max-height: 360px; border: 1px solid var(--es-line); border-radius: 8px; }
    .imp-table { table-layout: auto; }
    .imp-table td { overflow: visible; }
    .imp-filter-bar { display: flex; gap: 6px; flex-wrap: wrap; }
    .imp-chip { height: 30px; padding: 0 12px; border: 1px solid var(--es-line-strong); border-radius: 999px; background: var(--es-field); color: var(--es-ink); font: 500 12px/1 var(--es-font); cursor: pointer; }
    .imp-chip:hover { background: var(--es-tinto-soft); }
    .imp-chip.active { background: var(--es-tinto); border-color: var(--es-tinto); color: #fff; }
    .imp-sku-cell { display: flex; gap: 4px; align-items: center; }
    .imp-sku-search { width: 100px !important; flex: 0 0 100px !important; font-weight: 600; text-transform: uppercase; }
    .imp-table select[data-idx] { flex: 1 !important; min-width: 0 !important; width: auto !important; }
    .imp-row-mapped td:first-child { box-shadow: inset 3px 0 0 var(--es-ok); }
    .imp-row-unmapped td:first-child { box-shadow: inset 3px 0 0 var(--es-bad); }
    .imp-dif-pos { color: var(--es-bad); font-weight: 600; }
    .imp-dif-neg { color: var(--es-ok); font-weight: 600; }
    .imp-dif-neu { color: var(--es-muted); }
    .imp-summary-row { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; margin-top: 12px; }
    #impMapSummary { font-size: 12px; color: var(--es-muted); }
    .imp-btn-eliminar { width: 30px; height: 28px !important; padding: 0 !important; }

    /* Auditoría */
    .audit-filters { display: grid; grid-template-columns: repeat(7, minmax(120px, 1fr)); gap: 10px; align-items: end; }
    .audit-actions { display: flex; align-items: end; gap: 8px; flex-wrap: wrap; margin-top: 10px; }
    .audit-actions > div:first-child { flex: 1 1 260px; }
    #histLoader { display: inline-flex; align-items: center; gap: 7px; font-size: 12px; color: var(--es-muted); }
    .audit-kpis { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 8px; margin: 12px 0; }
    .audit-kpi { padding: 10px 12px; border: 1px solid var(--es-line); border-radius: 8px; background: var(--es-surface); border-top: 3px solid var(--k, var(--es-line-strong)); }
    .audit-kpi-title { font-size: 11.5px; color: var(--es-muted); font-weight: 500; }
    .audit-kpi-value { font-size: 20px; font-weight: 700; font-variant-numeric: tabular-nums; }
    .audit-table-wrap { max-height: 54vh; border: 1px solid var(--es-line); border-radius: 8px; }
    #tablaHistoricoPrecios { table-layout: fixed; min-width: 2050px; }
    .audit-action { display: inline-flex; align-items: center; height: 22px; padding: 0 9px; border-radius: 999px; font-size: 11px; font-weight: 600; background: var(--es-neutral-bg); color: var(--es-muted); }
    .audit-action-insert { background: var(--es-ok-bg); color: var(--es-ok); }
    .audit-action-update { background: var(--es-info-bg); color: var(--es-info); }
    .audit-action-sin-cambio { background: var(--es-warn-bg); color: var(--es-warn); }
    .audit-diff-up { color: var(--es-ok) !important; font-weight: 600; }
    .audit-diff-down { color: var(--es-bad) !important; font-weight: 600; }
    .audit-diff-zero { color: var(--es-muted) !important; }
    .audit-client-count-btn { height: 28px; padding: 0 10px; border: 1px solid var(--es-line-strong); border-radius: 6px; background: var(--es-field); color: var(--es-ink); font: 600 11.5px/1 var(--es-font); cursor: pointer; white-space: nowrap; }
    .audit-client-count-btn:hover { background: var(--es-tinto-soft); border-color: var(--es-tinto-line); }
    .hist-clientes-detail-row td { padding: 0 !important; background: var(--es-paper) !important; white-space: normal !important; overflow: visible !important; }
    .audit-client-panel { padding: 12px 14px; border-top: 2px solid var(--es-tinto); }
