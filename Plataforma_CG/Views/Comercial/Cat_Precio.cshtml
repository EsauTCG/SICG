        /* ═══════════════════════════════════════════════════════════
           CAPTURAR PRECIOS DE COMPETENCIA
        ═══════════════════════════════════════════════════════════ */
        let impData = null;
        let impSkusData = [];
        let impImgBase64 = null;
        let impFiltro = 'all';

        function impNormalizarBusqueda(t) {
            return String(t ?? '')
                .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
                .toUpperCase()
                .replace(/\$/g, ' ')
                .replace(/\b\d{4,}\b/g, ' ')
                .replace(/\b\d{1,4}\.\d{1,3}\b/g, ' ')
                .replace(/\b(FREASA|DENES|TC|ORIGINAL|NORTEÑA|NORTENA)\b/g, ' ')
                .replace(/[^A-Z0-9Ñ]+/g, ' ')
                .replace(/\s+/g, ' ')
                .trim();
        }
        function impTokensBusqueda(t) {
            const stop = new Set(['DE', 'DEL', 'LA', 'EL', 'LOS', 'LAS', 'CON', 'SIN', 'Y', 'EN', 'PARA', 'KG']);
            return impNormalizarBusqueda(t).split(' ').map(x => x.trim()).filter(x => x.length >= 3 && !stop.has(x));
        }
        function impPrepararSkuSearchData() {
            impSkusData = (impSkusData || []).map(s => {
                const sku = String(s.sku ?? '').trim().toUpperCase();
                const nombre = String(s.nombre ?? '').trim();
                const master = String(s.master ?? '').trim();
                const tipo = String(s.tipo ?? '').trim();
                return { ...s, sku, nombre, master, tipo,
                    _searchText: impNormalizarBusqueda(`${sku} ${nombre} ${master} ${tipo}`),
                    _tokens: impTokensBusqueda(`${nombre} ${master} ${tipo}`) };
            });
        }
        function impScoreSku(term, s) {
            const q = impNormalizarBusqueda(term);
            if (!q) return 0;
            const qTokens = impTokensBusqueda(q);
            let score = 0;
            const sku = String(s.sku ?? '').toUpperCase();
            const nombre = String(s.nombre ?? '').toUpperCase();
            const searchText = s._searchText || impNormalizarBusqueda(`${sku} ${nombre}`);
            if (sku === q) score += 500;
            if (sku.startsWith(q)) score += 250;
            if (searchText.includes(q)) score += 80;
            qTokens.forEach(t => {
                if (sku.includes(t)) score += 80;
                if (nombre.includes(t)) score += 35;
                if (searchText.includes(t)) score += 20;
            });
            return score;
        }
        function impFiltrarSkus(term, selectedValue = '', limit = 30) {
            const q = impNormalizarBusqueda(term);
            let resultados = [];
            if (q.length >= 2) {
                resultados = impSkusData
                    .map(s => ({ ...s, _score: impScoreSku(q, s) }))
                    .filter(s => s._score > 0)
                    .sort((a, b) => b._score - a._score || String(a.sku).localeCompare(String(b.sku)))
                    .slice(0, limit);
            }
            if (selectedValue) {
                const actual = impSkusData.find(x => String(x.sku) === String(selectedValue));
                if (actual && !resultados.some(x => String(x.sku) === String(selectedValue))) resultados.unshift(actual);
            }
            return resultados;
        }
        function impBuildSelOpts(term = '', selectedValue = '') {
            const filtrados = impFiltrarSkus(term, selectedValue, 30);
            let html = '<option value="">— Sin ligar —</option>';
            html += filtrados.map(s => {
                const selected = String(s.sku) === String(selectedValue) ? 'selected' : '';
                return `<option value="${esc(s.sku)}" data-nombre="${esc(s.nombre)}" data-precio="${Number(s.precioPublico ?? s.precio ?? 0)}" ${selected}>${esc(s.sku)} · ${esc(s.nombre)}</option>`;
            }).join('');
            return html;
        }
        function impAplicarSkuAProducto(idx, skuValue) {
            const sku = String(skuValue ?? '').trim();
            if (!impData?.productos?.[idx]) return;
            if (!sku) {
                impData.productos[idx].sku = '';
                impData.productos[idx].nuestroNombre = '';
                impData.productos[idx].nuestroPrecio = null;
                return;
            }
            const s = impSkusData.find(x => String(x.sku).toUpperCase() === sku.toUpperCase());
            if (!s) return;
            impData.productos[idx].sku = s.sku;
            impData.productos[idx].nuestroNombre = s.nombre || '';
            impData.productos[idx].nuestroPrecio = Number(s.precioPublico ?? s.precio ?? 0);
            impData.productos[idx].searchTerm = s.sku;
        }

        function impRenderMapTable() {
            if (!impData || !Array.isArray(impData.productos)) return;
            const tbody = document.getElementById('impMapBody');
            const prods = impData.productos.filter(p => impFiltro === 'mapped' ? p.sku : impFiltro === 'unmapped' ? !p.sku : true);
            tbody.innerHTML = '';

            prods.forEach(p => {
                const realIdx = impData.productos.indexOf(p);
                const tr = document.createElement('tr');
                tr.className = p.sku ? 'imp-row-mapped' : 'imp-row-unmapped';
                const dif = p.nuestroPrecio !== null ? p.nuestroPrecio - p.precio : null;
                const difHtml = dif !== null
                    ? `<span class="${dif > 5 ? 'imp-dif-pos' : dif < -5 ? 'imp-dif-neg' : 'imp-dif-neu'}">${dif >= 0 ? '+' : ''}$${dif.toFixed(2)}</span>`
                    : '—';
                const searchValue = p.searchTerm || '';

                tr.innerHTML = `
                    <td>${esc(p.codigoCompetencia || '—')}</td>
                    <td>${esc(p.nombre || '')}</td>
                    <td class="num">$${Number(p.precio || 0).toFixed(2)}</td>
                    <td>
                        <div class="imp-sku-cell">
                            <input type="text" class="imp-sku-search" data-idx="${realIdx}" placeholder="Buscar SKU" value="${esc(searchValue)}" aria-label="Buscar SKU propio">
                            <select data-idx="${realIdx}" aria-label="SKU propio">${impBuildSelOpts(searchValue, p.sku)}</select>
                        </div>
                    </td>
                    <td class="num">${p.nuestroPrecio !== null ? '$' + Number(p.nuestroPrecio).toFixed(2) : '—'}</td>
                    <td class="num">${difHtml}</td>`;

                const inputSearch = tr.querySelector('.imp-sku-search');
                const selectSku = tr.querySelector('select');

                inputSearch.addEventListener('input', function () {
                    const idx = Number(this.dataset.idx);
                    impData.productos[idx].searchTerm = this.value || '';
                    selectSku.innerHTML = impBuildSelOpts(this.value || '', impData.productos[idx].sku || '');
                });
                inputSearch.addEventListener('keydown', function (e) {
                    if (e.key !== 'Enter') return;
                    e.preventDefault();
                    const sugeridos = impFiltrarSkus(this.value || '', '', 1);
                    if (!sugeridos.length) return;
                    impAplicarSkuAProducto(Number(this.dataset.idx), sugeridos[0].sku);
                    impRenderMapTable();
                    impUpdateSummary();
                });
                selectSku.addEventListener('change', function () {
                    impAplicarSkuAProducto(Number(this.dataset.idx), this.value);
                    impRenderMapTable();
                    impUpdateSummary();
                });
                tbody.appendChild(tr);
            });
            impUpdateSummary();
        }

        function normalizarSkusMasivo(valor) {
            return [...new Set((valor || '').split(/[\s,;|]+/g).map(x => x.trim().toUpperCase()).filter(x => x.length > 0))];
        }

        async function cargarMastersAnalisis() {
            const sel = document.getElementById('anaMaster');
            if (!sel || sel.dataset.cargado === '1') return;
            sel.innerHTML = '<option value="">Todos</option><option value="" disabled>Cargando…</option>';
            try {
                const res = await fetch('/Comercial/ObtenerMasters');
                if (!res.ok) throw new Error('No se pudieron cargar los masters.');
                const lista = await res.json();
                sel.innerHTML = '<option value="">Todos</option>';
                if (!Array.isArray(lista) || lista.length === 0) {
                    const opt = document.createElement('option');
                    opt.value = ''; opt.textContent = '(sin masters)'; opt.disabled = true;
                    sel.appendChild(opt);
                    return;
                }
                lista.forEach(m => {
                    const opt = document.createElement('option');
                    opt.value = m || '';
                    opt.textContent = m || '(SIN MASTER)';
                    sel.appendChild(opt);
                });
                sel.dataset.cargado = '1';
            } catch (e) {
                console.warn('No se pudieron cargar masters:', e);
                sel.innerHTML = '<option value="">Todos</option><option value="" disabled>Error al cargar masters</option>';
            }
        }

        /* ---------- Tabla de captura ---------- */
        function impCrearFila(codigo = '', nombre = '', precio = '', sku = '') {
            const tbody = document.getElementById('tablaCapturaBody');
            const idx = tbody.rows.length + 1;
            const tr = document.createElement('tr');
