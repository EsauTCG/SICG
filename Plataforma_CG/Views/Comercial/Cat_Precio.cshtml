<!-- ══════════════════════════════════════════
     MODAL: IMPORTAR COMPETENCIA CON OCR
══════════════════════════════════════════ -->
<div class="modal fade" id="modalImportarCompetencia" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-xl-cg">
        <div class="modal-content" style="border-radius:0;">
            <div class="modal-header" style="background:linear-gradient(180deg,#b30000 0%,#8b0000 55%,#5c0000 100%);padding:8px 14px;">
                <h5 class="modal-title" style="color:#fff;font-size:14px;font-weight:bold;">
                    <i class="bi bi-camera me-2"></i>Importar Precios de Competencia con OCR
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body imp-modal-body">

                <!-- PASO 1: Subir imagen -->
                <div class="imp-step" id="impStep1">
                    <div class="imp-step-title">
                        <span class="imp-step-num">1</span>
                        Capturar lista de precios
                    </div>
                    <div class="imp-step-body">
                        <div class="imp-alert imp-alert-info">
                            <strong>¿Cómo funciona?</strong> Captura o pega directamente desde Excel los productos de la competencia. Columnas: Código, Nombre, Precio, SKU propio. Si pegas desde Excel con <strong>Ctrl+V</strong> en la tabla, se llena automáticamente.
                        </div>

                        <div style="display:flex;gap:12px;flex-wrap:wrap;align-items:flex-start;margin-bottom:10px;">
                            <div style="display:flex;flex-direction:column;gap:6px;">
                                <label style="font-size:11px;color:#5c1a1a;font-weight:bold;">Nombre del competidor</label>
                                <input type="text" id="impNombreCompetidor" class="form-control"
                                       placeholder="Ej: DENES, Cherokee..."
                                       style="width:200px;height:28px;font-size:12px;border-radius:0;border:1px solid #b48787;">
                            </div>
                            <div style="display:flex;flex-direction:column;gap:6px;">
                                <label style="font-size:11px;color:#5c1a1a;font-weight:bold;">Fecha corte</label>
                                <input type="date" id="impFechaCompetencia" class="form-control"
                                       style="width:200px;height:28px;font-size:12px;border-radius:0;border:1px solid #b48787;">
                            </div>
                        </div>

                        <div style="display:flex;gap:8px;margin-bottom:8px;flex-wrap:wrap;align-items:center;">
                            <button class="imp-btn imp-btn-secondary" id="impBtnAgregarFila">+ Agregar fila</button>
                            <button class="imp-btn imp-btn-secondary" id="impBtnLimpiarTabla">🗑 Limpiar</button>
                            <span style="font-size:11px;color:#6a3a3a;">💡 Puedes pegar desde Excel con Ctrl+V directo en la tabla</span>
                        </div>

                        <div style="overflow:auto;max-height:340px;border:1px solid #d8bcbc;">
                            <table class="imp-table" id="tablaCaptura">
                                <thead>
                                    <tr>
                                        <th style="width:5%;">#</th>
                                        <th style="width:15%;">Código comp.</th>
                                        <th style="width:35%;">Nombre</th>
                                        <th style="width:15%;">Precio</th>
                                        <th style="width:20%;">SKU propio</th>
                                        <th style="width:10%;"></th>
                                    </tr>
                                </thead>
                                <tbody id="tablaCapturaBody">
                                </tbody>
                            </table>
                        </div>

                        <div style="margin-top:12px;">
                            <button class="imp-btn imp-btn-primary" id="impBtnProcesarCaptura">
                                Continuar →
                            </button>
                        </div>
                    </div>
                </div>

                <!-- PASO 2: Mapear -->
                <div class="imp-step" id="impStep2" style="display:none;">
                    <div class="imp-step-title">
                        <span class="imp-step-num">2</span>
                        Mapear productos de la competencia a SKUs propios
                    </div>
                    <div class="imp-step-body">
                        <div id="impMapAlert" class="imp-alert imp-alert-info" style="display:none;"></div>

                        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:8px;margin-bottom:8px;">
                            <div class="imp-filter-bar" id="impFilterBar">
                                <button class="imp-chip active" data-filter="all">Todos</button>
                                <button class="imp-chip" data-filter="mapped">Mapeados</button>
                                <button class="imp-chip" data-filter="unmapped">Sin mapear</button>

                                <button type="button" class="imp-chip" id="impBtnAutoSugerir">
                                    ⚡ Auto sugerir
                                </button>

                                <button type="button" class="imp-chip" id="impBtnPegarSkus">
                                    📋 Pegar SKUs
                                </button>
                            </div>
                            <span id="impMapSummary" style="font-size:11px;color:#5c1a1a;"></span>
                        </div>

                        <div style="overflow:auto;max-height:380px;border:1px solid #d8bcbc;">
                            <table class="imp-table">
                                <thead>
                                    <tr>
                                        <th style="width:12%;">SKU comp.</th>
                                        <th style="width:25%;">Producto competencia</th>
                                        <th style="width:10%;">Precio comp.</th>
                                        <th style="width:35%;">Mapear a SKU propio</th>
                                        <th style="width:9%;">Precio público</th>
                                        <th style="width:9%;">Diferencia</th>
                                    </tr>
                                </thead>
                                <tbody id="impMapBody"></tbody>
                            </table>
                        </div>

                        <div class="imp-summary-row">
                            <div style="display:flex;gap:8px;">
                                <button class="imp-btn imp-btn-secondary" id="impBtnVolver">← Volver</button>
                                <button class="imp-btn imp-btn-success" id="impBtnGuardar" disabled>
                                    <i class="bi bi-save"></i> Guardar en sistema
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- PASO 3: Confirmación -->
                <div class="imp-step" id="impStep3" style="display:none;">
                    <div class="imp-step-title">
                        <span class="imp-step-num">3</span>
                        Guardado exitoso
