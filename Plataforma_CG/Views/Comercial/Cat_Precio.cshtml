                <td><input type="text" class="imp-cap-input cap-nombre" value="${esc(nombre)}" placeholder="Arrachera concha" aria-label="Nombre"></td>
                <td><input type="text" inputmode="decimal" class="imp-cap-input cap-precio" value="${esc(precio)}" placeholder="221.00" aria-label="Precio" style="text-align:right"></td>
                <td><input type="text" class="imp-cap-input cap-sku" value="${esc(sku)}" placeholder="N033" aria-label="SKU propio"></td>
                <td><button type="button" class="imp-btn imp-btn-secondary imp-btn-eliminar" aria-label="Quitar fila"><i class="bi bi-x-lg"></i></button></td>`;
            tr.querySelector('.imp-btn-eliminar').addEventListener('click', () => { tr.remove(); impRenumerarFilas(); });
