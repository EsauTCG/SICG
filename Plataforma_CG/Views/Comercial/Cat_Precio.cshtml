        document.getElementById('impBtnProcesarCaptura')?.addEventListener('click', () => {
            const competidor = document.getElementById('impNombreCompetidor')?.value?.trim();
            if (!competidor) { alert('Captura el nombre del competidor.'); return; }
            const inpFecha = document.getElementById('impFechaCompetencia');
            const fecha = inpFecha?.value?.trim();
            if (!fecha) {
                inpFecha.style.borderColor = 'var(--es-bad)';
                inpFecha.focus();
                alert('La fecha de corte es obligatoria.');
                return;
            }
            inpFecha.style.borderColor = '';

            const productos = [];
            document.querySelectorAll('#tablaCapturaBody tr').forEach(tr => {
                const codigo = tr.querySelector('.cap-codigo')?.value?.trim() || '';
                const nombre = tr.querySelector('.cap-nombre')?.value?.trim() || '';
                const precioRaw = tr.querySelector('.cap-precio')?.value?.trim() || '';
                const sku = tr.querySelector('.cap-sku')?.value?.trim() || '';
                // CORRECCIÓN: "142,50" se leía como 14250. Se usa la misma lectura que en el análisis.
                const precio = parsePrecioExcel(precioRaw) || 0;
                if (!nombre && !codigo) return;
                if (precio <= 0) return;
                let nuestroNombre = '';
                let nuestroPrecio = null;
                if (sku) {
                    const s = impSkusData.find(x => x.sku?.toUpperCase() === sku.toUpperCase());
                    if (s) { nuestroNombre = s.nombre || ''; nuestroPrecio = Number(s.precioPublico ?? s.precio ?? 0); }
                }
                productos.push({ codigoCompetencia: codigo, nombre, precio, sku, nuestroNombre, nuestroPrecio, searchTerm: sku ? sku : nombre });
            });

            if (!productos.length) { alert('Agrega al menos un producto con nombre y precio.'); return; }
            impData = { competidor, fecha, productos };
            document.getElementById('impStep1').style.display = 'none';
            document.getElementById('impStep2').style.display = 'block';
            impRenderMapTable();
        });

        function actualizarContadorSkus() {
            const skus = normalizarSkusMasivo(document.getElementById('anaSku')?.value || '');
            const lbl = document.getElementById('anaSkuCount');
            if (lbl) lbl.textContent = skus.length ? `${skus.length.toLocaleString('es-MX')} SKU capturados` : 'Sin SKU: se analizan todos';
            return skus;
        }

        function impUpdateSummary() {
            if (!impData || !Array.isArray(impData.productos)) return;
            const mapped = impData.productos.filter(p => p.sku).length;
            const total = impData.productos.length;
            document.getElementById('impMapSummary').textContent = `${mapped} de ${total} productos ligados`;
            document.getElementById('impBtnGuardar').disabled = mapped === 0;
            const al = document.getElementById('impMapAlert');
            if (mapped === 0) {
                al.textContent = 'Para cada producto de la competencia, busca y elige el SKU propio equivalente.';
                al.style.display = 'block';
            } else al.style.display = 'none';
        }

        document.getElementById('impFilterBar').addEventListener('click', e => {
            const chip = e.target.closest('.imp-chip[data-filter]');
            if (!chip) return;
            document.querySelectorAll('.imp-chip[data-filter]').forEach(c => c.classList.remove('active'));
            chip.classList.add('active');
            impFiltro = chip.dataset.filter;
            impRenderMapTable();
        });

        document.getElementById('impBtnAutoSugerir')?.addEventListener('click', function (e) {
            e.preventDefault(); e.stopPropagation();
            if (!impData || !Array.isArray(impData.productos)) return;
            let asignados = 0;
            impData.productos.forEach((p, idx) => {
                if (p.sku) return;
                const termino = impNormalizarBusqueda(p.nombre);
                const sugeridos = impFiltrarSkus(termino, '', 1);
                if (!sugeridos.length) return;
                // Umbral conservador para evitar malas relaciones
                if (impScoreSku(termino, sugeridos[0]) >= 45) { impAplicarSkuAProducto(idx, sugeridos[0].sku); asignados++; }
                else p.searchTerm = termino;
            });
            impRenderMapTable();
            impUpdateSummary();
            alert(`Sugerencia terminada. SKU ligados automáticamente: ${asignados}. Revísalos antes de guardar.`);
        });

        document.getElementById('impBtnPegarSkus')?.addEventListener('click', function (e) {
            e.preventDefault(); e.stopPropagation();
            if (!impData || !Array.isArray(impData.productos)) return;
            const texto = prompt('Pega un SKU por renglón, en el mismo orden de la tabla.\n\nEjemplo:\nN003\nV054\nV055');
            if (!texto) return;
            const skusPegados = texto.split(/\r?\n/g).map(x => x.trim()).filter(x => x.length > 0).map(linea => {
                const partes = linea.split(/\t|,|;/g).map(x => x.trim()).filter(Boolean);
                return partes.length ? partes[partes.length - 1].toUpperCase() : linea.toUpperCase();
            });
            let asignados = 0;
            const visibles = impData.productos.filter(p => impFiltro === 'mapped' ? p.sku : impFiltro === 'unmapped' ? !p.sku : true);
            skusPegados.forEach((sku, i) => {
                const p = visibles[i];
                if (!p) return;
                if (impSkusData.some(s => String(s.sku).toUpperCase() === sku)) {
                    impAplicarSkuAProducto(impData.productos.indexOf(p), sku);
                    asignados++;
                }
            });
            impRenderMapTable();
            impUpdateSummary();
            alert(`SKU pegados y ligados: ${asignados}`);
        });

        document.getElementById('impBtnVolver').addEventListener('click', () => {
            document.getElementById('impStep2').style.display = 'none';
            document.getElementById('impStep1').style.display = 'block';
        });

        document.getElementById('impBtnGuardar').addEventListener('click', async () => {
            const btn = document.getElementById('impBtnGuardar');
            const mapeados = impData?.productos?.filter(p => p.sku) || [];
            if (!mapeados.length) { alert('No hay productos ligados para guardar.'); return; }

            const orig = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="cpc-spin cpc-spin--light"></span> Guardando…';

            const competidorInput = (document.getElementById('impNombreCompetidor')?.value || '').trim();
            const competidorData = (impData?.competidor || '').trim();
            const competidorNombre = competidorInput || (competidorData.toUpperCase() !== 'COMPETENCIA' ? competidorData : '');
            if (!competidorNombre) {
                alert('Captura el nombre real del competidor. Ejemplo: Redbuchef, Praderas, C-Fira, Denes.');
                btn.disabled = false; btn.innerHTML = orig; return;
            }
            const fechaCorteFinal = (impData?.fechaCorte || impData?.fecha || document.getElementById('impFechaCompetencia')?.value || '').trim();
            if (!fechaCorteFinal) {
                alert('Captura la fecha de corte antes de guardar.');
                btn.disabled = false; btn.innerHTML = orig; return;
            }

            const payload = {
                competidor: competidorNombre,
                fecha: fechaCorteFinal,
                fechaCorte: fechaCorteFinal,
                registros: mapeados.map(p => ({
                    skuPropio: p.sku,
                    codigoCompetencia: p.codigoCompetencia || '',
                    nombreCompetencia: p.nombre || '',
                    precioCompetencia: Number(p.precio || 0),
                    nuestroPrecio: p.nuestroPrecio !== null && p.nuestroPrecio !== undefined ? Number(p.nuestroPrecio) : null
                }))
            };

            try {
                const res = await fetch('/Comercial/GuardarCompetenciaLote', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload)
                });
                const text = await res.text();
                let data = null;
                try { data = JSON.parse(text); } catch { throw new Error(text || 'Respuesta inválida del servidor.'); }
                if (!res.ok || data.ok === false) throw new Error(data.mensaje || data.error || 'Error al guardar.');

                document.getElementById('impStep2').style.display = 'none';
                document.getElementById('impStep3').style.display = 'block';
                document.getElementById('impSavedMsg').textContent =
                    `${mapeados.length} registro(s) de "${competidorNombre}" guardados para la fecha de corte ${fechaCorteFinal}.`;

                document.getElementById('impSavedBody').innerHTML = mapeados.map(p => {
                    const precioComp = Number(p.precio || 0);
                    const precioNuestro = p.nuestroPrecio !== null && p.nuestroPrecio !== undefined ? Number(p.nuestroPrecio) : null;
                    const dif = precioNuestro !== null ? precioNuestro - precioComp : null;
                    const difCls = dif === null ? 'imp-dif-neu' : dif > 5 ? 'imp-dif-pos' : dif < -5 ? 'imp-dif-neg' : 'imp-dif-neu';
                    const difHtml = dif === null ? '—' : `${dif >= 0 ? '+' : ''}$${dif.toFixed(2)}`;
                    return `<tr>
                        <td><strong>${esc(p.sku)}</strong></td>
                        <td>${esc(p.nuestroNombre || '')}</td>
                        <td>${esc(p.codigoCompetencia || '—')}</td>
                        <td>${esc(p.nombre || '')}</td>
                        <td class="num">$${precioComp.toFixed(2)}</td>
                        <td class="num">${precioNuestro !== null ? '$' + precioNuestro.toFixed(2) : '—'}</td>
                        <td class="num"><span class="${difCls}">${difHtml}</span></td>
                    </tr>`;
                }).join('');
            } catch (e) {
                alert('Error al guardar: ' + e.message);
            } finally {
                btn.disabled = false;
                btn.innerHTML = orig;
            }
        });

        document.getElementById('impBtnNuevo').addEventListener('click', impReset);

        function impReset() {
            impData = null;
            impImgBase64 = null;
            impFiltro = 'all';
            document.getElementById('impNombreCompetidor').value = '';
            document.getElementById('impFechaCompetencia').value = '';
            document.querySelectorAll('.imp-chip[data-filter]').forEach((c, i) => c.classList.toggle('active', i === 0));
            document.getElementById('impStep1').style.display = 'block';
            document.getElementById('impStep2').style.display = 'none';
            document.getElementById('impStep3').style.display = 'none';
            document.getElementById('impMapBody').innerHTML = '';
            document.getElementById('impSavedBody').innerHTML = '';
            document.getElementById('impMapSummary').textContent = '';
            document.getElementById('impMapAlert').style.display = 'none';
            impInicializarTablaCaptura();
        }

        function impFechaHoyISO() { return hoyLocalISO(); }

        async function impCargarSkus() {
            if (impSkusData.length) return;
            try {
                const res = await fetch('/Comercial/ObtenerSkusParaMapeo');
                if (!res.ok) return;
                const json = await res.json();
                impSkusData = Array.isArray(json) ? json : (json.data || []);
                impPrepararSkuSearchData();
            } catch (e) {
                console.warn('No se pudieron cargar SKUs para mapeo:', e);
            }
        }

        /* ---------- Funciones de destino por canal/cliente ----------
           Se conservan sin cambios. Hoy no tienen controles en pantalla
           (anaCanal, anaClientes, anaAlcanceClientes), así que no hacen nada. */
        let anaCanalesCargados = false;
        let anaClientesData = [];

        async function cargarCanalesPrecio() {
            const sel = document.getElementById('anaCanal');
            if (!sel || anaCanalesCargados) return;
            sel.innerHTML = '<option value="">Todos los canales</option>';
            try {
                const res = await fetch('/Comercial/ObtenerCanalesPrecio');
                if (!res.ok) throw new Error('No se pudieron cargar los canales.');
                (await res.json()).forEach(canal => {
                    const opt = document.createElement('option');
                    opt.value = canal; opt.textContent = canal;
                    sel.appendChild(opt);
                });
                anaCanalesCargados = true;
            } catch (e) { console.warn('Error cargando canales:', e); }
        }

        async function cargarClientesPrecio() {
            const canal = document.getElementById('anaCanal')?.value || '';
            const sel = document.getElementById('anaClientes');
            if (!sel) return;
            sel.innerHTML = '<option disabled>Cargando clientes…</option>';
            try {
                const res = await fetch(`/Comercial/ObtenerClientesPrecio?canal=${encodeURIComponent(canal)}`);
                if (!res.ok) throw new Error('No se pudieron cargar los clientes.');
                const listaClientes = await res.json();
                anaClientesData = Array.isArray(listaClientes) ? listaClientes : [];
                sel.innerHTML = '';
                anaClientesData.forEach(c => {
                    const opt = document.createElement('option');
                    opt.value = c.cliente;
                    opt.textContent = `${c.cliente} - ${c.nombreCliente} (${c.canal || 'SIN CANAL'})`;
                    sel.appendChild(opt);
                });
                actualizarContadorClientesPrecio();
            } catch (e) {
                sel.innerHTML = '';
                console.warn('Error cargando clientes:', e);
                alert('No se pudieron cargar los clientes: ' + e.message);
            }
        }

        function actualizarModoDestinoPrecio() {
            const modo = document.getElementById('anaAlcanceClientes')?.value || 'ACTIVOS';
            const canal = document.getElementById('anaCanal');
            const clientes = document.getElementById('anaClientes');
            const btnClientes = document.getElementById('btnMarcarTodosClientes');
            if (!canal || !clientes || !btnClientes) return;
            if (modo === 'ACTIVOS') {
                canal.disabled = true; clientes.disabled = true; btnClientes.disabled = true;
                canal.value = '';
                Array.from(clientes.options).forEach(o => o.selected = false);
            }
            if (modo === 'ACTIVOS_CANAL') {
                canal.disabled = false; clientes.disabled = true; btnClientes.disabled = true;
                Array.from(clientes.options).forEach(o => o.selected = false);
            }
            if (modo === 'CLIENTES') {
                canal.disabled = false; clientes.disabled = false; btnClientes.disabled = false;
                cargarClientesPrecio();
            }
            actualizarContadorClientesPrecio();
        }

        function actualizarContadorClientesPrecio() {
            const sel = document.getElementById('anaClientes');
            const lbl = document.getElementById('anaClientesCount');
            if (!sel || !lbl) return;
            const seleccionados = Array.from(sel.selectedOptions || []).length;
            const total = Array.from(sel.options || []).filter(o => !o.disabled).length;
            lbl.textContent = `${seleccionados.toLocaleString('es-MX')} de ${total.toLocaleString('es-MX')} clientes seleccionados`;
        }

        function obtenerClientesSeleccionadosPrecio() {
            const sel = document.getElementById('anaClientes');
            return sel ? Array.from(sel.selectedOptions || []).map(o => o.value).filter(x => x) : [];
        }

        async function cargarListasPrecioGuardar() {
            const sel = document.getElementById('anaPriceListNum');
            if (!sel || sel.dataset.cargado === '1') return;
            sel.innerHTML = '<option value="1">Cargando listas…</option>';
            try {
                const res = await fetch('/Comercial/ObtenerListasPrecioParaGuardar');
                if (!res.ok) throw new Error('No se pudieron cargar las listas de precios.');
                const json = await res.json();
                const listas = Array.isArray(json.data) ? json.data : [];
                sel.innerHTML = '';
                listas.forEach(l => {
                    const opt = document.createElement('option');
                    opt.value = l.priceListNum;
                    opt.textContent = Number(l.priceListNum) === 1
                        ? `${l.priceListNum} - ${l.priceListName}`
                        : `${l.priceListNum} - ${l.priceListName} / Especial`;
                    sel.appendChild(opt);
                });
                if (!listas.some(x => Number(x.priceListNum) === 1)) {
                    const opt = document.createElement('option');
                    opt.value = '1'; opt.textContent = '1 - Precio Publico';
                    sel.prepend(opt);
                }
                sel.value = '1';
                sel.dataset.cargado = '1';
            } catch (e) {
                console.warn(e);
                sel.innerHTML = '<option value="1">1 - Precio Publico</option>';
                alert('No se pudieron cargar las listas de precios: ' + e.message);
            }
        }

        /* ════════════════════════════════════════
           EVENTOS
        ════════════════════════════════════════ */
        document.addEventListener("DOMContentLoaded", function () {
            cargarPrecios(currentPage, currentSearch);

            modalAnalisisSemanal = bootstrap.Modal.getOrCreateInstance(document.getElementById('modalAnalisisSemanal'));
            modalImportarComp = bootstrap.Modal.getOrCreateInstance(document.getElementById('modalImportarCompetencia'));
            modalHistoricoPrecios = bootstrap.Modal.getOrCreateInstance(document.getElementById('modalHistoricoPrecios'));

            document.getElementById('anaAlcanceClientes')?.addEventListener('change', actualizarModoDestinoPrecio);
            document.getElementById('anaCanal')?.addEventListener('change', async function () {
                if ((document.getElementById('anaAlcanceClientes')?.value || 'ACTIVOS') === 'CLIENTES') await cargarClientesPrecio();
            });
            document.getElementById('anaClientes')?.addEventListener('change', actualizarContadorClientesPrecio);
            document.getElementById('btnMarcarTodosClientes')?.addEventListener('click', function () {
                const sel = document.getElementById('anaClientes');
                if (!sel || sel.disabled) return;
                const opciones = Array.from(sel.options).filter(o => !o.disabled);
                const haySinMarcar = opciones.some(o => !o.selected);
                opciones.forEach(o => { o.selected = haySinMarcar; });
                actualizarContadorClientesPrecio();
            });

            document.getElementById('btnMarcarTodosGuardar')?.addEventListener('click', function () {
                const checks = document.querySelectorAll('.ana-chk-guardar');
                const algunoSinMarcar = Array.from(checks).some(x => !x.checked);
                checks.forEach(chk => { chk.checked = algunoSinMarcar; });
            });

            document.getElementById('btnGuardarPrecioPublico')?.addEventListener('click', function (e) {
                e.preventDefault();
                guardarPrecioPublicoDesdeAnalisis();
            });

            /* Historial */
            document.getElementById('btnHistoricoPrecios')?.addEventListener('click', () => abrirHistoricoPrecios('', '', true));
            document.getElementById('btnHistBuscar')?.addEventListener('click', () => cargarHistoricoPrecios(1));
            document.getElementById('btnHistLimpiar')?.addEventListener('click', () => { histLimpiarFiltros(); cargarHistoricoPrecios(1); });
            document.getElementById('btnHistExcel')?.addEventListener('click', descargarHistoricoPreciosExcel);
            document.getElementById('histPrev')?.addEventListener('click', () => { if (histPage > 1) cargarHistoricoPrecios(histPage - 1); });
            document.getElementById('histNext')?.addEventListener('click', () => { if (histPage < histTotalPages) cargarHistoricoPrecios(histPage + 1); });
            document.querySelectorAll('#histSearch,#histSku,#histCliente,#histUsuario,#histLista,#histFechaDesde,#histFechaHasta').forEach(el => {
                el.addEventListener('keydown', function (e) {
                    if (e.key === 'Enter') { e.preventDefault(); cargarHistoricoPrecios(1); }
                });
            });

            document.addEventListener('click', function (e) {
                const btn = e.target.closest('.btn-audit-row');
                if (!btn) return;
                e.preventDefault();
                histLimpiarFiltros();
                abrirHistoricoPrecios(btn.dataset.histSku || '', '', false);
            });

            document.addEventListener('click', function (e) {
                const btnClientes = e.target.closest('.btn-hist-clientes');
                if (btnClientes) { e.preventDefault(); histToggleClientes(btnClientes); return; }
                const btnCerrar = e.target.closest('.btn-cerrar-clientes');
                if (btnCerrar) { e.preventDefault(); btnCerrar.closest('.hist-clientes-detail-row')?.remove(); }
            });

            /* Análisis semanal */
            document.getElementById('btnGestionAnalisis')?.addEventListener('click', async function () {
                modalAnalisisSemanal.show();
                await cargarMastersAnalisis();
                await cargarListasPrecioGuardar();
                await cargarCanalesPrecio();
                await cargarClientesPrecio();
                actualizarModoDestinoPrecio();
                const hoy = hoyLocalISO();
                if (!document.getElementById('anaFechaCorte').value) document.getElementById('anaFechaCorte').value = hoy;
                if (!document.getElementById('anaFechaUso').value) document.getElementById('anaFechaUso').value = hoy;
                actualizarContadorSkus();
            });

            document.getElementById('btnCalcularAnalisis')?.addEventListener('click', function (e) { e.preventDefault(); cargarAnalisisSemanal(); });
            document.getElementById('anaSku')?.addEventListener('input', actualizarContadorSkus);
            document.getElementById('anaSku')?.addEventListener('change', actualizarContadorSkus);
            document.getElementById('anaSku')?.addEventListener('keydown', function (e) {
                if (e.ctrlKey && e.key === 'Enter') { e.preventDefault(); cargarAnalisisSemanal(); }
            });

            /* Competencia */
            document.getElementById('btnGestionImportar')?.addEventListener('click', async () => {
                impReset();
                await impCargarSkus();
                impInicializarTablaCaptura();
                modalImportarComp.show();
            });

            /* Sincronizar */
            document.getElementById("btnSincronizar").addEventListener("click", async function () {
                const btn = this;
                const original = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = '<span class="cpc-spin cpc-spin--light"></span> Sincronizando…';
                mostrarLoader(true, "Sincronizando con SAP…");
                try {
                    const res = await fetch('/Comercial/SincronizarPrecioCliente');
                    if (!res.ok) throw new Error('No se pudo sincronizar con SAP.');
                    alert(await res.text());
                    await cargarPrecios(currentPage, currentSearch);
                } catch (err) {
                    alert(err.message);
                } finally {
                    mostrarLoader(false);
                    btn.disabled = false;
                    btn.innerHTML = original;
                }
            });

            /* Búsqueda */
            const doSearch = debounce(() => {
                currentSearch = document.getElementById("searchInput").value || "";
                currentPage = 1;
                cargarPrecios(currentPage, currentSearch);
            }, 350);
            document.getElementById("searchInput").addEventListener("input", doSearch);

            /* Excel */
            document.getElementById("btnDescargarExcel").addEventListener("click", function () {
                const search = document.getElementById("searchInput").value || "";
                window.location.href = `/Comercial/DescargarCatalogoPreciosExcel?search=${encodeURIComponent(search)}`;
            });
        });
    </script>
}
