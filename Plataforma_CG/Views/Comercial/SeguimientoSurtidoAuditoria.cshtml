@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Seguimiento de Surtido";
}

<style>
    :root {
        --sa-bg: #f4f6f8;
        --sa-card: #ffffff;
        --sa-line: #dfe4e8;
        --sa-line-strong: #cbd2d8;
        --sa-text: #26313a;
        --sa-muted: #68737d;
        --sa-brand: #8f1d2c;
        --sa-brand-dark: #711522;
        --sa-soft: #f8ecee;
        --sa-good: #1d7a4a;
        --sa-warn: #a96800;
        --sa-danger: #b4232f;
        --sa-info: #2469a0;
        --sa-purple: #6d4aa2;
        --sa-shadow: 0 8px 24px rgba(32, 42, 52, .08);
    }

    .sa-page {
        min-height: 100vh;
        background: var(--sa-bg);
        color: var(--sa-text);
        font-family: Inter, "Segoe UI", Arial, sans-serif;
        padding: 10px;
    }

    .sa-shell {
        max-width: 100%;
        margin: 0 auto;
    }

    .sa-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        background: linear-gradient(135deg, #781725 0%, #9d2435 100%);
        color: #fff;
        border-radius: 10px;
        padding: 13px 16px;
        box-shadow: var(--sa-shadow);
    }

    .sa-title-wrap {
        min-width: 0;
    }

    .sa-title {
        display: flex;
        align-items: center;
        gap: 9px;
        font-size: 18px;
        font-weight: 800;
        letter-spacing: .1px;
    }

    .sa-subtitle {
        margin-top: 2px;
        color: rgba(255,255,255,.82);
        font-size: 11px;
    }

    .sa-live {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        justify-content: flex-end;
        font-size: 11px;
    }

    .sa-live-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        min-height: 30px;
        padding: 5px 9px;
        border: 1px solid rgba(255,255,255,.24);
        border-radius: 7px;
        background: rgba(255,255,255,.10);
        color: #fff;
        white-space: nowrap;
    }

    .sa-live-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #7ee2a8;
        box-shadow: 0 0 0 3px rgba(126,226,168,.18);
    }

    .sa-panel {
        margin-top: 9px;
        background: var(--sa-card);
        border: 1px solid var(--sa-line);
        border-radius: 9px;
        box-shadow: 0 3px 12px rgba(32,42,52,.04);
    }

    .sa-panel-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        min-height: 38px;
        padding: 8px 11px;
        border-bottom: 1px solid var(--sa-line);
    }

    .sa-panel-title {
        display: flex;
        align-items: center;
        gap: 7px;
        font-size: 12px;
        font-weight: 800;
        color: #343d45;
    }

    .sa-filters {
        display: grid;
        grid-template-columns:
            112px 112px minmax(150px, .9fr) minmax(160px, 1.1fr)
            minmax(145px, .9fr) minmax(125px, .8fr) minmax(125px, .8fr)
            120px 120px 110px;
        gap: 7px;
        padding: 9px 10px 6px;
        align-items: end;
    }

    .sa-field {
        min-width: 0;
    }

    .sa-field label {
        display: block;
        margin: 0 0 3px;
        color: var(--sa-muted);
        font-size: 9px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .35px;
    }

    .sa-field input,
    .sa-field select {
        width: 100%;
        height: 31px;
        border: 1px solid var(--sa-line-strong);
        border-radius: 6px;
        background: #fff;
        color: var(--sa-text);
        padding: 4px 7px;
        font-size: 11px;
        outline: 0;
    }

    .sa-field input:focus,
    .sa-field select:focus {
        border-color: var(--sa-brand);
        box-shadow: 0 0 0 3px rgba(143,29,44,.09);
    }

    .sa-filter-bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 2px 10px 9px;
        flex-wrap: wrap;
    }

    .sa-checks,
    .sa-filter-actions,
    .sa-shortcuts {
        display: flex;
        align-items: center;
        gap: 7px;
        flex-wrap: wrap;
    }

    .sa-check {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        height: 29px;
        padding: 0 8px;
        border: 1px solid var(--sa-line);
        border-radius: 6px;
        background: #fafbfc;
        color: #4f5962;
        font-size: 10px;
        font-weight: 700;
        cursor: pointer;
        user-select: none;
    }

    .sa-check input {
        margin: 0;
    }

    .sa-btn {
        height: 31px;
        border: 1px solid transparent;
        border-radius: 6px;
        padding: 0 10px;
        font-size: 10px;
        font-weight: 800;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        white-space: nowrap;
    }

    .sa-btn-primary {
        background: var(--sa-brand);
        border-color: var(--sa-brand-dark);
        color: #fff;
    }

    .sa-btn-primary:hover {
        background: var(--sa-brand-dark);
    }

    .sa-btn-light {
        background: #fff;
        border-color: var(--sa-line-strong);
        color: #4b555e;
    }

    .sa-btn-success {
        background: #237a4d;
        border-color: #1b6840;
        color: #fff;
    }

    .sa-chip {
        height: 27px;
        border: 1px solid var(--sa-line);
        border-radius: 99px;
        padding: 0 9px;
        background: #fff;
        color: #56616b;
        font-size: 9px;
        font-weight: 800;
        cursor: pointer;
    }

    .sa-chip:hover,
    .sa-chip.active {
        border-color: #c7969d;
        background: var(--sa-soft);
        color: var(--sa-brand-dark);
    }

    .sa-kpis {
        display: grid;
        grid-template-columns: repeat(10, minmax(105px, 1fr));
        gap: 7px;
        margin-top: 9px;
    }

    .sa-kpi {
        min-width: 0;
        background: #fff;
        border: 1px solid var(--sa-line);
        border-radius: 8px;
        padding: 9px 10px;
        box-shadow: 0 2px 8px rgba(32,42,52,.035);
    }

    .sa-kpi-label {
        color: var(--sa-muted);
        font-size: 8px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .35px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .sa-kpi-value {
        margin-top: 4px;
        color: #28323b;
        font-size: 18px;
        line-height: 1;
        font-weight: 850;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .sa-kpi-note {
        margin-top: 4px;
        color: #87919a;
        font-size: 8px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .sa-kpi.danger .sa-kpi-value { color: var(--sa-danger); }
    .sa-kpi.warn .sa-kpi-value { color: var(--sa-warn); }
    .sa-kpi.good .sa-kpi-value { color: var(--sa-good); }
    .sa-kpi.info .sa-kpi-value { color: var(--sa-info); }

    .sa-grid-panel {
        margin-top: 9px;
        background: #fff;
        border: 1px solid var(--sa-line);
        border-radius: 9px;
        overflow: hidden;
        box-shadow: 0 3px 12px rgba(32,42,52,.04);
    }

    .sa-grid-head {
        min-height: 39px;
        padding: 7px 10px;
        border-bottom: 1px solid var(--sa-line);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }

    .sa-grid-meta {
        color: var(--sa-muted);
        font-size: 9px;
    }

    .sa-table-wrap {
        overflow: auto;
        max-height: calc(100vh - 360px);
        min-height: 330px;
    }

    .sa-table {
        width: 100%;
        min-width: 2020px;
        border-collapse: separate;
        border-spacing: 0;
        font-size: 10px;
    }

    .sa-table thead th {
        position: sticky;
        top: 0;
        z-index: 10;
        height: 34px;
        padding: 6px 7px;
        background: #f1f3f5;
        color: #505b65;
        border-bottom: 1px solid var(--sa-line-strong);
        border-right: 1px solid #e8ebee;
        font-size: 8px;
        font-weight: 850;
        text-transform: uppercase;
        letter-spacing: .28px;
        white-space: nowrap;
        text-align: left;
    }

    .sa-table tbody td {
        height: 38px;
        padding: 5px 7px;
        border-bottom: 1px solid #edf0f2;
        border-right: 1px solid #f1f3f5;
        vertical-align: middle;
        color: #39434c;
        white-space: nowrap;
    }

    .sa-table tbody tr:nth-child(even) td {
        background: #fbfcfd;
    }

    .sa-table tbody tr:hover td {
        background: #f7f1f2;
    }

    .sa-table tbody tr.row-alert td {
        background: #fff7f7;
    }

    .sa-table tbody tr.row-risk td {
        background: #fffaf0;
    }

    .sa-table .num {
        text-align: right;
        font-variant-numeric: tabular-nums;
    }

    .sa-folio {
        color: var(--sa-brand);
        font-weight: 850;
        cursor: pointer;
        text-decoration: none;
    }

    .sa-folio:hover {
        text-decoration: underline;
    }

    .sa-client {
        max-width: 245px;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .sa-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 20px;
        padding: 2px 7px;
        border-radius: 99px;
        border: 1px solid transparent;
        font-size: 8px;
        line-height: 1.15;
        font-weight: 850;
        white-space: nowrap;
    }

    .b-good { background: #eaf7f0; color: #17633d; border-color: #bfe3ce; }
    .b-warn { background: #fff5df; color: #8a5900; border-color: #ecd49f; }
    .b-danger { background: #fdebed; color: #9d1f2b; border-color: #efbec4; }
    .b-info { background: #eaf3fa; color: #205d89; border-color: #bed7e8; }
    .b-muted { background: #f1f3f5; color: #616c75; border-color: #dce1e5; }
    .b-purple { background: #f1ebfa; color: #5e3e8f; border-color: #d8c8ec; }

    .sa-pct {
        display: inline-flex;
        align-items: baseline;
        gap: 2px;
        font-weight: 850;
        color: #303a43;
    }

    .sa-pct small {
        color: #879099;
        font-size: 8px;
    }

    .sa-alert-count {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        color: var(--sa-danger);
        font-weight: 850;
    }

    .sa-empty {
        padding: 45px 16px !important;
        text-align: center;
        color: #7a858e !important;
        font-size: 11px;
    }

    .sa-loading {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #69747d;
        font-size: 10px;
    }

    .sa-spinner {
        width: 13px;
        height: 13px;
        border: 2px solid #d8dde1;
        border-top-color: var(--sa-brand);
        border-radius: 50%;
        animation: saSpin .65s linear infinite;
    }

    @@keyframes saSpin {
        to { transform: rotate(360deg); }
    }

    /* ==================== MODAL DETALLE ==================== */
    .sa-modal {
        position: fixed;
        inset: 0;
        z-index: 6000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
        background: rgba(20, 27, 33, .52);
    }

    .sa-modal.d-none { display: none !important; }

    .sa-modal-card {
        width: min(1500px, 97vw);
        max-height: 94vh;
        display: flex;
        flex-direction: column;
        background: #fff;
        border-radius: 10px;
        border: 1px solid #cfd5da;
        box-shadow: 0 24px 70px rgba(0,0,0,.28);
        overflow: hidden;
    }

    .sa-modal-head {
        min-height: 48px;
        padding: 9px 12px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        border-bottom: 1px solid var(--sa-line);
        background: #fafbfc;
    }

    .sa-modal-title {
        font-size: 14px;
        font-weight: 850;
        color: #303a43;
    }

    .sa-modal-sub {
        margin-top: 2px;
        color: var(--sa-muted);
        font-size: 9px;
    }

    .sa-modal-close {
        width: 32px;
        height: 32px;
        border: 1px solid var(--sa-line);
        border-radius: 6px;
        background: #fff;
        color: #65707a;
        font-size: 16px;
        cursor: pointer;
    }

    .sa-modal-body {
        min-height: 0;
        overflow: auto;
        padding: 10px;
        background: #f6f7f9;
    }

    .sa-detail-summary {
        display: grid;
        grid-template-columns: repeat(8, minmax(110px,1fr));
        gap: 7px;
        margin-bottom: 9px;
    }

    .sa-detail-box {
        background: #fff;
        border: 1px solid var(--sa-line);
        border-radius: 7px;
        padding: 8px 9px;
        min-width: 0;
    }

    .sa-detail-box span {
        display: block;
        color: var(--sa-muted);
        font-size: 8px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .sa-detail-box strong {
        display: block;
        margin-top: 3px;
        color: #313b43;
        font-size: 12px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .sa-detail-section {
        margin-top: 9px;
        background: #fff;
        border: 1px solid var(--sa-line);
        border-radius: 8px;
        overflow: hidden;
    }

    .sa-detail-section-head {
        min-height: 36px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 7px 9px;
        border-bottom: 1px solid var(--sa-line);
        background: #fafbfc;
        font-size: 10px;
        font-weight: 850;
    }

    .sa-detail-table-wrap {
        overflow: auto;
        max-height: 330px;
    }

    .sa-detail-table {
        width: 100%;
        min-width: 1120px;
        border-collapse: collapse;
        font-size: 9px;
    }

    .sa-detail-table th {
        position: sticky;
        top: 0;
        z-index: 3;
        padding: 6px;
        background: #f1f3f5;
        border-bottom: 1px solid var(--sa-line-strong);
        text-align: left;
        white-space: nowrap;
        font-size: 8px;
        text-transform: uppercase;
    }

    .sa-detail-table td {
        padding: 6px;
        border-bottom: 1px solid #edf0f2;
        white-space: nowrap;
    }

    .sa-detail-table .num {
        text-align: right;
        font-variant-numeric: tabular-nums;
    }

    .sa-detail-table tr.alert-row td {
        background: #fff1f2;
    }

    .sa-footnote {
        margin-top: 8px;
        color: #78838c;
        font-size: 9px;
        line-height: 1.4;
    }

    /* scrollbar discreto */
    .sa-table-wrap::-webkit-scrollbar,
    .sa-modal-body::-webkit-scrollbar,
    .sa-detail-table-wrap::-webkit-scrollbar {
        width: 8px;
        height: 8px;
    }

    .sa-table-wrap::-webkit-scrollbar-thumb,
    .sa-modal-body::-webkit-scrollbar-thumb,
    .sa-detail-table-wrap::-webkit-scrollbar-thumb {
        background: #c6ccd1;
        border-radius: 10px;
    }

    @@media (max-width: 1350px) {
        .sa-filters {
            grid-template-columns: repeat(5, minmax(135px, 1fr));
        }

        .sa-kpis {
            grid-template-columns: repeat(5, minmax(120px, 1fr));
        }

        .sa-detail-summary {
            grid-template-columns: repeat(4, minmax(120px,1fr));
        }
    }

    @@media (max-width: 760px) {
        .sa-page { padding: 4px; }

        .sa-topbar {
            border-radius: 7px;
            align-items: flex-start;
            flex-direction: column;
        }

        .sa-live {
            width: 100%;
            justify-content: flex-start;
        }

        .sa-filters {
            grid-template-columns: repeat(2, minmax(0,1fr));
        }

        .sa-kpis {
            grid-template-columns: repeat(2, minmax(0,1fr));
        }

        .sa-filter-bottom {
            align-items: flex-start;
        }

        .sa-detail-summary {
            grid-template-columns: repeat(2, minmax(0,1fr));
        }

        .sa-table-wrap {
            max-height: none;
            min-height: 400px;
        }
    }
</style>


<div class="sa-page">
    <div class="sa-shell">

        <div class="sa-topbar">
            <div class="sa-title-wrap">
                <div class="sa-title">
                    <i class="bi bi-clipboard-data"></i>
                    Seguimiento de Surtido · Auditoría y Planeación
                </div>
                <div class="sa-subtitle">
                   
                </div>
            </div>

            <div class="sa-live">
                <label class="sa-live-pill" title="Actualiza la información automáticamente cada 30 segundos">
                    <span class="sa-live-dot"></span>
                    <input type="checkbox" id="autoRefresh" checked style="margin:0;" />
                    En vivo · 30 s
                </label>

                <div class="sa-live-pill">
                    <i class="bi bi-clock-history"></i>
                    <span id="lastUpdate">Sin actualizar</span>
                </div>
            </div>
        </div>


        <div class="sa-panel">
            <div class="sa-panel-head">
                <div class="sa-panel-title">
                    <i class="bi bi-funnel"></i>
                    Filtros de seguimiento
                </div>
                <div class="sa-grid-meta">
                    Fecha operativa: OV = FechaEntrega · TR = FechaSolicitud
                </div>
            </div>

            <div class="sa-filters">
                <div class="sa-field">
                    <label>Desde</label>
                    <input type="date" id="fDesde" />
                </div>

                <div class="sa-field">
                    <label>Hasta</label>
                    <input type="date" id="fHasta" />
                </div>

                <div class="sa-field">
                    <label>Tipo</label>
                    <select id="fTipo">
                        <option value="">OV + Transferencias</option>
                        <option value="OV">Órdenes de venta</option>
                        <option value="TR">Transferencias</option>
                    </select>
                </div>

                <div class="sa-field">
                    <label>Folio</label>
                    <input type="text" id="fFolio" placeholder="OV / TR..." />
                </div>

                <div class="sa-field">
                    <label>Cliente / Destino</label>
                    <input type="text" id="fCliente" placeholder="Código o nombre" />
                </div>

                <div class="sa-field">
                    <label>Vendedor</label>
                    <select id="fVendedor">
                        <option value="">Todos</option>
                    </select>
                </div>

                <div class="sa-field">
                    <label>Serie</label>
                    <select id="fSerie">
                        <option value="">Todas</option>
                    </select>
                </div>

                <div class="sa-field">
                    <label>Canal</label>
                    <select id="fCanal">
                        <option value="">Todos</option>
                    </select>
                </div>

                <div class="sa-field">
                    <label>Estado surtido</label>
                    <select id="fEstado">
                        <option value="">Todos</option>
                        <option value="POR_SURTIR">Por surtir</option>
                        <option value="SURTIENDO">Surtiendo</option>
                        <option value="COMPLETO">Completo</option>
                        <option value="SIN_SOLICITUD">Sin solicitud CEDIS</option>
                        <option value="ALERTAS">Con alertas</option>
                    </select>
                </div>

                <div class="sa-field">
                    <label>Validación</label>
                    <select id="fValidacion">
                        <option value="">Todas</option>
                        <option value="PENDIENTE">Pendiente</option>
                        <option value="PARCIAL">Parcial</option>
                        <option value="VALIDADO">Validado</option>
                        <option value="SIN SOLICITUD">Sin solicitud</option>
                    </select>
                </div>

                <div class="sa-field">
                    <label>Riesgo entrega</label>
                    <select id="fRiesgo">
                        <option value="">Todos</option>
                        <option value="ATRASADO">Atrasado</option>
                        <option value="RIESGO">Riesgo</option>
                        <option value="REVISAR">Revisar</option>
                        <option value="EN TIEMPO">En tiempo</option>
                        <option value="SIN SLA">Sin SLA (Transferencia)</option>
                    </select>
                </div>
            </div>

            <div class="sa-filter-bottom">
                <div class="sa-checks">
                    <label class="sa-check">
                        <input type="checkbox" id="fSoloAlertas" />
                        Sólo alertas
                    </label>

                    <label class="sa-check">
                        <input type="checkbox" id="fSoloSolicitud" />
                        Sólo con solicitud CEDIS
                    </label>
                </div>

                <div class="sa-shortcuts">
                    <button class="sa-chip active" type="button" data-shortcut="TODOS">Todos</button>
                    <button class="sa-chip" type="button" data-shortcut="SURTIENDO">Surtiendo</button>
                    <button class="sa-chip" type="button" data-shortcut="POR_SURTIR">Por surtir</button>
                    <button class="sa-chip" type="button" data-shortcut="ALERTAS">Alertas</button>
                    <button class="sa-chip" type="button" data-shortcut="RIESGO">Riesgo</button>
                    <button class="sa-chip" type="button" data-shortcut="PEND_VALIDAR">Pend. validar</button>
                </div>

                <div class="sa-filter-actions">
                    <button class="sa-btn sa-btn-light" type="button" id="btnLimpiar">
                        <i class="bi bi-eraser"></i>
                        Limpiar
                    </button>

                    <button class="sa-btn sa-btn-success" type="button" id="btnExportar">
                        <i class="bi bi-file-earmark-spreadsheet"></i>
                        Exportar CSV
                    </button>

                    <button class="sa-btn sa-btn-primary" type="button" id="btnConsultar">
                        <i class="bi bi-search"></i>
                        Consultar
                    </button>
                </div>
            </div>
        </div>


        <div class="sa-kpis">
