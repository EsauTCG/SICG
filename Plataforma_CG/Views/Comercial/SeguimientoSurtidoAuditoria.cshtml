<script>
(() => {
    'use strict';

    const DATA_URL = '/Comercial/SeguimientoSurtidoAuditoriaData';
    const DETAIL_URL = '/Comercial/SeguimientoSurtidoAuditoriaDetalle';
    const REFRESH_MS = 30000;

    let currentRows = [];
    let refreshTimer = null;
    let loading = false;

    const el = id => document.getElementById(id);

    const get = (o, name) => {
        if (!o) return null;
        if (Object.prototype.hasOwnProperty.call(o, name)) return o[name];
        const pascal = name.charAt(0).toUpperCase() + name.slice(1);
        return o[pascal];
    };

    const esc = value =>
        String(value ?? '')
            .replaceAll('&', '&amp;')
            .replaceAll('<', '&lt;')
            .replaceAll('>', '&gt;')
            .replaceAll('"', '&quot;')
            .replaceAll("'", '&#039;');

    const n = value => {
        const x = Number(value ?? 0);
        return Number.isFinite(x) ? x : 0;
    };

    const fmt = (value, dec = 0) =>
        n(value).toLocaleString('es-MX', {
            minimumFractionDigits: dec,
            maximumFractionDigits: dec
        });

    const fmtDate = value => {
        if (!value) return '—';
        const d = new Date(value);
        if (Number.isNaN(d.getTime())) return String(value);
        return d.toLocaleDateString('es-MX');
    };

    const fmtDateTime = value => {
        if (!value) return '—';
        const d = new Date(value);
        if (Number.isNaN(d.getTime())) return String(value);
        return d.toLocaleString('es-MX', {
            year: 'numeric',
            month: '2-digit',
            day: '2-digit',
            hour: '2-digit',
            minute: '2-digit'
        });
    };

    const fmtHours = value => {
        if (value === null || value === undefined || value === '') return '—';
        return `${fmt(value, 1)} h`;
    };

    function isoLocalDate(d) {
        const x = new Date(d.getFullYear(), d.getMonth(), d.getDate(), 12, 0, 0);
        const y = x.getFullYear();
        const m = String(x.getMonth() + 1).padStart(2, '0');
        const day = String(x.getDate()).padStart(2, '0');
        return `${y}-${m}-${day}`;
    }

    function setDefaultDates() {
        const today = new Date();
        const desde = new Date(today);
        const hasta = new Date(today);

        desde.setDate(desde.getDate() - 7);
        hasta.setDate(hasta.getDate() + 7);

        el('fDesde').value = isoLocalDate(desde);
        el('fHasta').value = isoLocalDate(hasta);
    }

    function badge(text, kind = 'muted') {
        const map = {
            good: 'b-good',
            warn: 'b-warn',
            danger: 'b-danger',
            info: 'b-info',
            muted: 'b-muted',
            purple: 'b-purple'
        };

        return `<span class="sa-badge ${map[kind] || map.muted}">${esc(text || '—')}</span>`;
    }

    function estadoBadge(estado) {
        const s = String(estado || '').toUpperCase();

        if (s.includes('ALERTA') || s.includes('SIN DETALLE SOLICITADO'))
            return badge(estado, 'danger');

        if (s.includes('COMPLETO'))
            return badge(estado, 'good');

        if (s.includes('SURTIENDO') || s.includes('PARCIAL'))
            return badge(estado, 'info');

        if (s.includes('POR SURTIR') || s.includes('SIN SOLICITUD'))
            return badge(estado, 'warn');

        return badge(estado, 'muted');
    }

    function validacionBadge(estado) {
        const s = String(estado || '').toUpperCase();

        if (s === 'VALIDADO') return badge(estado, 'good');
        if (s === 'PARCIAL') return badge(estado, 'warn');
        if (s === 'PENDIENTE') return badge(estado, 'danger');
        return badge(estado, 'muted');
    }

    function riesgoBadge(riesgo) {
        const s = String(riesgo || '').toUpperCase();

        if (s === 'ATRASADO') return badge(riesgo, 'danger');
        if (s === 'RIESGO') return badge(riesgo, 'warn');
        if (s === 'REVISAR') return badge(riesgo, 'purple');
        if (s === 'SIN SLA') return badge(riesgo, 'muted');
        return badge(riesgo, 'good');
    }

    function setText(id, value) {
        const node = el(id);
        if (node) node.textContent = value;
    }

    function buildParams() {
        const p = new URLSearchParams();

        const values = {
            desde: el('fDesde').value,
            hasta: el('fHasta').value,
            tipo: el('fTipo').value,
            folio: el('fFolio').value.trim(),
            cliente: el('fCliente').value.trim(),
            vendedor: el('fVendedor').value,
            serie: el('fSerie').value,
            canal: el('fCanal').value,
            estado: el('fEstado').value,
            validacion: el('fValidacion').value,
            riesgo: el('fRiesgo').value
        };

        Object.entries(values).forEach(([k, v]) => {
            if (v) p.set(k, v);
        });

        p.set('soloAlertas', el('fSoloAlertas').checked ? 'true' : 'false');
        p.set('soloConSolicitud', el('fSoloSolicitud').checked ? 'true' : 'false');

        return p;
    }

    function fillSelect(id, values, firstText) {
        const select = el(id);
        if (!select) return;

        const selected = select.value;

        const arr = Array.from(
            new Set(
                (values || [])
                    .map(x => String(x ?? '').trim())
                    .filter(Boolean)
            )
        ).sort((a,b) => a.localeCompare(b, 'es'));

        select.innerHTML =
            `<option value="">${esc(firstText)}</option>` +
            arr.map(x => `<option value="${esc(x)}">${esc(x)}</option>`).join('');

        if (selected && arr.includes(selected))
            select.value = selected;
    }

    function renderKpis(k) {
        setText('kPedidos', fmt(get(k, 'documentos')));
        setText('kPedidosNota', `OV ${fmt(get(k,'ordenesVenta'))} · TR ${fmt(get(k,'transferencias'))}`);
        setText('kKgOrdenados', fmt(get(k, 'kgOrdenados')));
        setText('kKgSurtidos', fmt(get(k, 'kgSurtidosAplicados')));
        setText('kKgPendientes', fmt(get(k, 'kgPendientes')));
        setText('kAvance', `${fmt(get(k, 'pctAvanceGlobalKg'), 1)}%`);
        setText('kSurtiendo', fmt(get(k, 'surtiendo')));
        setText('kCompletos', fmt(get(k, 'completos')));
        setText('kAlertas', fmt(get(k, 'alertas')));
        setText('kPendValidacion', fmt(get(k, 'pendientesValidacion')));

        const prom = get(k, 'promedioHorasValidacion');
        setText('kHorasValidacion',
            prom === null || prom === undefined ? '—' : `${fmt(prom,1)} h`);
    }

    function renderRows(rows) {
        const body = el('rowsBody');

        if (!Array.isArray(rows) || rows.length === 0) {
            body.innerHTML = `
                <tr>
                    <td colspan="21" class="sa-empty">
                        No hay pedidos para los filtros seleccionados.
                    </td>
                </tr>`;
            setText('rowCount', '0 documentos');
            return;
        }

        setText('rowCount', `${rows.length.toLocaleString('es-MX')} documentos`);

        body.innerHTML = rows.map(r => {
            const id = n(get(r, 'documentoId'));
            const tipo = String(get(r, 'tipoDocumento') || 'OV').toUpperCase();
            const alerta = n(get(r, 'tieneAlerta')) === 1;
            const riesgo = String(get(r, 'riesgoEntrega') || '');
            const rowClass =
                alerta ? 'row-alert' :
                (riesgo === 'ATRASADO' || riesgo === 'RIESGO') ? 'row-risk' : '';

            const extras =
                n(get(r, 'skuExtraNoEnOV')) +
                n(get(r, 'skuExtraNoEnSolicitud'));

            const alertHtml = alerta
                ? `<span class="sa-alert-count">
                       <i class="bi bi-exclamation-triangle-fill"></i>
                       ${fmt(extras || 1)}
                   </span>`
                : badge('Sin alertas', 'good');

            return `
                <tr class="${rowClass}">
                    <td>${badge(tipo, tipo === 'TR' ? 'purple' : 'info')}</td>

                    <td>
                        <a href="#" class="sa-folio js-detail"
                           data-id="${id}"
                           data-tipo="${tipo}">
                            ${esc(get(r, 'consecutivo'))}
                        </a>
                    </td>

                    <td>${esc(get(r, 'serie'))}</td>

                    <td class="sa-client" title="${esc(get(r, 'clienteNombre'))}">
                        <strong>${esc(get(r, 'cliente'))}</strong>
                        · ${esc(get(r, 'clienteNombre'))}
                    </td>

                    <td>${esc(get(r, 'vendedor'))}</td>
                    <td>${esc(get(r, 'canal'))}</td>
                    <td>${fmtDate(get(r, 'fechaEntrega'))}</td>
                    <td>${riesgoBadge(get(r, 'riesgoEntrega'))}</td>

                    <td class="num">${fmt(get(r, 'kgOrdenOV'))}</td>
                    <td class="num">${fmt(get(r, 'kgPedidoCedis'))}</td>
                    <td class="num"><strong>${fmt(get(r, 'kgSurtidoAplicadoOV'))}</strong></td>
                    <td class="num">${fmt(get(r, 'kgPendienteOV'))}</td>

                    <td class="num">
                        <span class="sa-pct">
                            ${fmt(get(r, 'pctAvanceOVKg'), 1)}<small>%</small>
                        </span>
                    </td>

                    <td class="num">
                        ${fmt(get(r, 'pctLiberadoACedisKg'), 1)}%
                    </td>

                    <td>${estadoBadge(get(r, 'estadoSurtido'))}</td>
                    <td>${validacionBadge(get(r, 'estadoValidacion'))}</td>
                    <td>${fmtDateTime(get(r, 'ultimaFechaValidacion'))}</td>

                    <td class="num">
                        ${fmtHours(get(r, 'horasHastaUltimaValidacion'))}
                    </td>

                    <td class="num">
                        ${fmtHours(get(r, 'horasPendienteValidacion'))}
                    </td>

                    <td>${alertHtml}</td>

                    <td>
                        <button type="button"
                                class="sa-btn sa-btn-light js-detail"
                                data-id="${id}"
                                data-tipo="${tipo}"
                                style="height:25px;padding:0 7px;">
                            Detalle
                        </button>
                    </td>
                </tr>`;
        }).join('');
    }

    async function loadData(silent = false) {
        if (loading) return;
        loading = true;

        const btn = el('btnConsultar');
        const oldHtml = btn.innerHTML;

        if (!silent) {
            btn.disabled = true;
            btn.innerHTML = `<span class="sa-spinner"></span> Cargando`;
        }

        try {
            const p = buildParams();
            p.set('_', Date.now().toString());

            const resp = await fetch(`${DATA_URL}?${p.toString()}`, {
                cache: 'no-store',
                headers: { 'Accept': 'application/json' }
            });

            const data = await resp.json().catch(() => ({}));

            if (!resp.ok || data.ok === false) {
                throw new Error(data.detalle || data.msg || `HTTP ${resp.status}`);
            }

            currentRows = data.rows || [];

            renderKpis(data.kpis || {});
            renderRows(currentRows);

            const cat = data.catalogos || {};
            fillSelect('fSerie', cat.series || cat.Series || [], 'Todas');
            fillSelect('fVendedor', cat.vendedores || cat.Vendedores || [], 'Todos');
            fillSelect('fCanal', cat.canales || cat.Canales || [], 'Todos');

            const upd = data.actualizado || data.Actualizado || new Date().toISOString();
            setText('lastUpdate', `Actualizado ${fmtDateTime(upd)}`);

        } catch (e) {
            console.error(e);

            if (!silent) {
                el('rowsBody').innerHTML = `
                    <tr>
                        <td colspan="21" class="sa-empty" style="color:#a2222e!important;">
                            <strong>No se pudo cargar el seguimiento.</strong><br>
                            <span style="font-weight:700;">${esc(e?.message || e)}</span><br>
                            <span style="font-size:9px;color:#7c8790;">Este detalle viene directamente del endpoint para identificar el problema SQL.</span>
                        </td>
                    </tr>`;
            }
        } finally {
            loading = false;

            if (!silent) {
                btn.disabled = false;
                btn.innerHTML = oldHtml;
            }
        }
    }

    function activateShortcut(btn) {
        document.querySelectorAll('.sa-chip').forEach(x => x.classList.remove('active'));
        btn.classList.add('active');
    }

    function applyShortcut(code, btn) {
        activateShortcut(btn);

        el('fEstado').value = '';
        el('fValidacion').value = '';
        el('fRiesgo').value = '';
        el('fSoloAlertas').checked = false;

        switch (code) {
            case 'SURTIENDO':
                el('fEstado').value = 'SURTIENDO';
                break;
            case 'POR_SURTIR':
                el('fEstado').value = 'POR_SURTIR';
                break;
            case 'ALERTAS':
                el('fEstado').value = 'ALERTAS';
                el('fSoloAlertas').checked = true;
                break;
            case 'RIESGO':
                el('fRiesgo').value = 'RIESGO';
                break;
            case 'PEND_VALIDAR':
                el('fValidacion').value = 'PENDIENTE';
                break;
        }

        loadData();
    }

    function clearFilters() {
        setDefaultDates();

        el('fTipo').value = '';
        el('fFolio').value = '';
        el('fCliente').value = '';
        el('fVendedor').value = '';
        el('fSerie').value = '';
        el('fCanal').value = '';
        el('fEstado').value = '';
        el('fValidacion').value = '';
        el('fRiesgo').value = '';
        el('fSoloAlertas').checked = false;
        el('fSoloSolicitud').checked = false;

        document.querySelectorAll('.sa-chip').forEach(x => x.classList.remove('active'));
        document.querySelector('.sa-chip[data-shortcut="TODOS"]')?.classList.add('active');

        loadData();
    }

    function csvCell(value) {
        const s = String(value ?? '');
        return `"${s.replaceAll('"', '""')}"`;
    }

    function exportCsv() {
        if (!currentRows.length) {
            alert('No hay información para exportar.');
            return;
        }

        const cols = [
            ['Tipo', 'tipoDocumento'],
            ['Folio', 'consecutivo'],
            ['Serie', 'serie'],
            ['Cliente', 'cliente'],
            ['Cliente nombre', 'clienteNombre'],
            ['Vendedor', 'vendedor'],
            ['Canal', 'canal'],
            ['Fecha operativa', 'fechaEntrega'],
            ['Riesgo', 'riesgoEntrega'],
            ['Kg OV', 'kgOrdenOV'],
            ['Kg solicitado CEDIS', 'kgPedidoCedis'],
            ['Kg surtido aplicado', 'kgSurtidoAplicadoOV'],
            ['Kg pendiente', 'kgPendienteOV'],
            ['% avance', 'pctAvanceOVKg'],
            ['% liberado CEDIS', 'pctLiberadoACedisKg'],
            ['Estado surtido', 'estadoSurtido'],
            ['Estado validación', 'estadoValidacion'],
            ['Última validación', 'ultimaFechaValidacion'],
            ['Horas validación', 'horasHastaUltimaValidacion'],
            ['Horas espera validación', 'horasPendienteValidacion'],
            ['SKU extra no OV', 'skuExtraNoEnOV'],
            ['SKU extra no solicitud', 'skuExtraNoEnSolicitud']
        ];

        const lines = [
            cols.map(x => csvCell(x[0])).join(',')
        ];

        currentRows.forEach(r => {
            lines.push(
                cols.map(x => csvCell(get(r, x[1]))).join(',')
            );
        });

        const blob = new Blob(
            ['\uFEFF' + lines.join('\r\n')],
            { type: 'text/csv;charset=utf-8;' }
        );

        const a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = `SeguimientoSurtido_${el('fDesde').value}_${el('fHasta').value}.csv`;
        document.body.appendChild(a);
        a.click();
        a.remove();

        setTimeout(() => URL.revokeObjectURL(a.href), 500);
    }

    function detailBox(label, value, title = '') {
        return `
            <div class="sa-detail-box" ${title ? `title="${esc(title)}"` : ''}>
                <span>${esc(label)}</span>
                <strong>${value}</strong>
            </div>`;
    }

    function renderDetailSummary(row) {
        const tipo = String(get(row,'tipoDocumento') || 'OV').toUpperCase();

        el('detailSummary').innerHTML =
            detailBox('Tipo', badge(tipo, tipo === 'TR' ? 'purple' : 'info')) +
            detailBox(tipo === 'TR' ? 'Destino' : 'Cliente',
                `${esc(get(row, 'cliente'))} · ${esc(get(row, 'clienteNombre'))}`) +
            detailBox(tipo === 'TR' ? 'Sucursal' : 'Vendedor',
                esc(tipo === 'TR' ? get(row,'serie') : get(row,'vendedor'))) +
            detailBox(tipo === 'TR' ? 'Fecha solicitud' : 'Entrega',
                esc(fmtDate(get(row, 'fechaEntrega')))) +
            detailBox('Estado', estadoBadge(get(row, 'estadoSurtido'))) +
            detailBox(tipo === 'TR' ? 'Kg transferencia' : 'Kg OV', fmt(get(row, 'kgOrdenOV'))) +
            detailBox('Kg surtidos', fmt(get(row, 'kgSurtidoAplicadoOV'))) +
            detailBox('Avance', `${fmt(get(row, 'pctAvanceOVKg'),1)}%`);
    }

    function renderDetailSku(rows) {
        const body = el('detailSkuBody');

        if (!rows?.length) {
            body.innerHTML = `<tr><td colspan="11" class="sa-empty">Sin detalle SKU.</td></tr>`;
            return;
        }

        body.innerHTML = rows.map(r => {
            const extraOv = n(get(r, 'esSkuExtraNoEnOV')) === 1;
            const extraSol = n(get(r, 'esSkuExtraNoEnSolicitud')) === 1;
            const extraKg = n(get(r, 'kgExtraVsOV')) > .01;
            const alert = extraOv || extraSol || extraKg;

            return `
                <tr class="${alert ? 'alert-row' : ''}">
                    <td><strong>${esc(get(r, 'sku'))}</strong></td>
                    <td>${esc(get(r, 'producto'))}</td>
                    <td class="num">${fmt(get(r, 'kgOrdenOV'))}</td>
                    <td class="num">${fmt(get(r, 'kgPedidoCedis'))}</td>
                    <td class="num"><strong>${fmt(get(r, 'kgSurtidoCedis'))}</strong></td>
                    <td class="num">${fmt(get(r, 'kgPendienteOV'))}</td>
                    <td class="num">${fmt(get(r, 'pctAvanceKg'),1)}%</td>
                    <td class="num">${fmt(get(r, 'cajasOrdenOV'))}</td>
                    <td class="num">${fmt(get(r, 'cajasSurtidasCedis'))}</td>
                    <td class="num">${fmt(get(r, 'kgExtraVsOV'))}</td>
                    <td>${estadoBadge(get(r, 'estadoSKU'))}</td>
                </tr>`;
        }).join('');
    }

    function renderProcesos(rows) {
        const body = el('detailSolBody');

        if (!rows?.length) {
            body.innerHTML =
                `<tr><td colspan="8" class="sa-empty">Sin información de proceso.</td></tr>`;
            return;
        }

        body.innerHTML = rows.map(r => `
            <tr>
                <td>${esc(get(r, 'referencia')) || '—'}</td>
                <td><strong>${esc(get(r, 'documento')) || '—'}</strong></td>
                <td>${validacionBadge(get(r, 'estadoValidacion'))}</td>
                <td>${fmtDateTime(get(r, 'fechaValidacion'))}</td>
                <td class="num">${fmtHours(get(r, 'horasDesdeRegistro'))}</td>
                <td class="num">${fmt(get(r, 'kgSurtido'))}</td>
                <td class="num">${fmt(get(r, 'cajasSurtidas'))}</td>
                <td>${esc(get(r, 'nota'))}</td>
            </tr>
        `).join('');
    }

    async function openDetail(tipo, id) {
        tipo = String(tipo || 'OV').toUpperCase();

        const row = currentRows.find(x =>
            n(get(x, 'documentoId')) === n(id) &&
            String(get(x, 'tipoDocumento') || 'OV').toUpperCase() === tipo
        );

        if (!row) return;

        el('detailModal').classList.remove('d-none');
        el('detailModal').setAttribute('aria-hidden', 'false');

        setText('dFolio', `${tipo} · ${get(row, 'consecutivo') || '—'}`);
        setText(
            'dSub',
            `${get(row,'serie') || ''} · ${get(row,'cliente') || ''} · ${get(row,'clienteNombre') || ''}`
        );

        renderDetailSummary(row);

        el('detailSkuBody').innerHTML =
            `<tr><td colspan="11" class="sa-empty"><span class="sa-loading"><span class="sa-spinner"></span>Cargando detalle...</span></td></tr>`;

        el('detailSolBody').innerHTML =
            `<tr><td colspan="8" class="sa-empty"><span class="sa-loading"><span class="sa-spinner"></span>Cargando solicitudes...</span></td></tr>`;

        try {
            const resp = await fetch(
                `${DETAIL_URL}?tipo=${encodeURIComponent(tipo)}&documentoId=${encodeURIComponent(id)}&_=${Date.now()}`,
                { cache: 'no-store', headers: { 'Accept': 'application/json' } }
            );

            const data = await resp.json().catch(() => ({}));

            if (!resp.ok || data.ok === false) {
                throw new Error(data.detalle || data.msg || `HTTP ${resp.status}`);
            }

            renderDetailSku(data.skus || data.Skus || []);
            renderProcesos(data.procesos || data.Procesos || []);

        } catch (e) {
            console.error(e);

            el('detailSkuBody').innerHTML =
                `<tr><td colspan="11" class="sa-empty" style="color:#a2222e!important;">${esc(e?.message || e)}</td></tr>`;

            el('detailSolBody').innerHTML =
                `<tr><td colspan="8" class="sa-empty" style="color:#a2222e!important;">No fue posible cargar el proceso.</td></tr>`;
        }
    }

    function closeDetail() {
        el('detailModal').classList.add('d-none');
        el('detailModal').setAttribute('aria-hidden', 'true');
    }

    function setupRefresh() {
        if (refreshTimer) clearInterval(refreshTimer);

        refreshTimer = setInterval(() => {
            if (!el('autoRefresh').checked) return;
            if (document.hidden) return;
            if (!el('detailModal').classList.contains('d-none')) return;

            loadData(true);
        }, REFRESH_MS);
    }

    el('btnConsultar').addEventListener('click', () => loadData());
    el('btnLimpiar').addEventListener('click', clearFilters);
    el('btnExportar').addEventListener('click', exportCsv);
    el('btnCloseDetail').addEventListener('click', closeDetail);

    el('detailModal').addEventListener('mousedown', e => {
        if (e.target === el('detailModal')) closeDetail();
    });

    document.addEventListener('keydown', e => {
        if (e.key === 'Escape' && !el('detailModal').classList.contains('d-none')) {
            closeDetail();
        }
    });

    document.addEventListener('click', e => {
        const detail = e.target.closest('.js-detail');
        if (detail) {
            e.preventDefault();
            openDetail(detail.dataset.tipo || 'OV', detail.dataset.id);
            return;
        }

        const chip = e.target.closest('.sa-chip');
        if (chip) {
            applyShortcut(chip.dataset.shortcut, chip);
        }
    });

    ['fFolio','fCliente'].forEach(id => {
        el(id).addEventListener('keydown', e => {
            if (e.key === 'Enter') {
                e.preventDefault();
                loadData();
            }
        });
    });

    setDefaultDates();
    setupRefresh();
    loadData();
})();
</script>
