@model IEnumerable<Plataforma_CG.Models.ClienteSap>

@{
    ViewData["Title"] = "Catálogo de Clientes";
    Layout = "~/Views/Shared/_Layout2.cshtml";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    /* =====================================================================
           CATÁLOGO DE CLIENTES · SIGO — hoja de estilos única
           Mismo sistema visual que el resto de módulos. Sustituye las 4 capas
           anteriores y catalogo-clientes-sap-grid.css.
           ===================================================================== */
    :root {
        --es-tinto: #8d3e46;
        --es-tinto-deep: #5c2229;
        --es-tinto-soft: #f7eced;
        --es-tinto-line: #e8d3d6;
        --es-paper: #f6f4f4;
        --es-surface: #ffffff;
        --es-field: #ffffff;
        --es-head: #faf7f7;
        --es-hover: #fcf9f9;
        --es-row-line: #f0eaeb;
        --es-ink: #231a1c;
        --es-muted: #76686b;
        --es-line: #e6dfe0;
        --es-line-strong: #cfc4c6;
        --es-ok: #2f7a55;
        --es-ok-bg: #e7f3ec;
        --es-bad: #b42d2d;
        --es-bad-bg: #fbe9e8;
        --es-font: "Poppins", "Segoe UI", system-ui, -apple-system, Arial, sans-serif;
    }

    body[data-theme="dark"] {
        --es-tinto: #c56b74;
        --es-tinto-deep: #7a2d36;
        --es-tinto-soft: #3a2427;
        --es-tinto-line: #5a3439;
        --es-paper: #16181c;
        --es-surface: #202328;
        --es-field: #181a1e;
        --es-head: #262a30;
        --es-hover: #2a2e34;
        --es-row-line: #30343b;
        --es-ink: #edf0f3;
        --es-muted: #a9b0b9;
        --es-line: #363b43;
        --es-line-strong: #4a5059;
        --es-ok: #6cc596;
        --es-ok-bg: #1d3328;
        --es-bad: #f08a83;
        --es-bad-bg: #3d2223;
    }

    .ccl {
        font-family: var(--es-font);
        color: var(--es-ink);
        font-size: 13px;
        line-height: 1.4;
        background: var(--es-paper);
        padding: 16px 18px 10px;
        min-width: 0;
    }

        .ccl * {
            box-sizing: border-box;
        }

        .ccl .bi {
            font-family: "bootstrap-icons" !important;
        }

    .num {
        text-align: right !important;
        font-variant-numeric: tabular-nums;
    }

    /* ---------- Encabezado ---------- */
    .ccl-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 14px;
    }

    .ccl-header__title {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .ccl-header__icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: grid;
        place-items: center;
        background: var(--es-tinto);
        color: #fff;
        font-size: 19px;
    }

    .ccl-header h1 {
        margin: 0;
        font-size: 20px;
        font-weight: 700;
        letter-spacing: -.01em;
        line-height: 1.15;
        color: var(--es-ink);
    }

    .ccl-header p {
        margin: 2px 0 0;
        font-size: 12px;
        color: var(--es-muted);
    }

    .ccl-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    /* ---------- Botones ---------- */
    .es-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        height: 36px;
        padding: 0 14px;
        border: 1px solid var(--es-line-strong);
        border-radius: 7px;
        background: var(--es-field);
        color: var(--es-ink);
        font: 600 12.5px/1 var(--es-font);
        white-space: nowrap;
        cursor: pointer;
        transition: background .12s, border-color .12s, color .12s;
    }

        .es-btn:hover {
            background: var(--es-tinto-soft);
            border-color: var(--es-tinto-line);
            color: var(--es-ink);
        }

        .es-btn:focus-visible {
            outline: 2px solid var(--es-tinto);
            outline-offset: 2px;
        }

        .es-btn:disabled {
            opacity: .5;
            cursor: not-allowed;
        }

    .es-btn--primary {
        background: var(--es-tinto);
        border-color: var(--es-tinto);
        color: #fff;
    }

        .es-btn--primary:hover, .es-btn--primary.show {
            background: var(--es-tinto-deep);
            border-color: var(--es-tinto-deep);
            color: #fff;
        }

    /* Menú de sincronización */
    .sync-menu {
        min-width: 290px;
        padding: 4px;
        border: 1px solid var(--es-line-strong);
        border-radius: 8px;
        background: var(--es-surface);
        box-shadow: 0 10px 28px rgba(0,0,0,.15);
    }

        .sync-menu .dropdown-item {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            padding: 9px 10px;
            border-radius: 6px;
            font: 500 12.5px/1.25 var(--es-font);
            color: var(--es-ink);
            white-space: normal;
        }

            .sync-menu .dropdown-item i {
                margin-top: 2px;
                color: var(--es-tinto);
            }

            .sync-menu .dropdown-item small {
                display: block;
                margin-top: 2px;
                font-size: 11px;
                color: var(--es-muted);
            }

            .sync-menu .dropdown-item:hover, .sync-menu .dropdown-item:focus {
                background: var(--es-tinto-soft);
                color: var(--es-ink);
            }

            .sync-menu .dropdown-item:disabled {
                opacity: .55;
            }

    /* ---------- Tarjeta ---------- */
    .ccl-card {
        background: var(--es-surface);
        border: 1px solid var(--es-line);
        border-radius: 10px;
        overflow: hidden;
    }

    .ccl-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
        padding: 12px 14px;
        border-bottom: 1px solid var(--es-line);
    }

    .ccl-search {
        position: relative;
        width: 420px;
        max-width: 100%;
    }

        .ccl-search i {
            position: absolute;
            left: 11px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--es-muted);
            font-size: 13px;
            pointer-events: none;
        }

    .ccl #searchInput {
        display: block;
        width: 100%;
        height: 36px;
        padding: 0 10px 0 32px;
        border: 1px solid var(--es-line-strong);
        border-radius: 7px;
        background: var(--es-field);
        color: var(--es-ink);
        font: 500 13px/1 var(--es-font);
        box-shadow: none;
    }

        .ccl #searchInput:focus {
            outline: none;
            border-color: var(--es-tinto);
            box-shadow: 0 0 0 3px rgba(141,62,70,.16);
        }

    .ccl-count {
        font-size: 12px;
        color: var(--es-muted);
    }

        .ccl-count strong {
            color: var(--es-ink);
            font-weight: 600;
        }

    #loader {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-size: 12px;
        color: var(--es-muted);
    }

    .ccl-spin {
        display: inline-block;
        width: 13px;
        height: 13px;
        border: 2px solid var(--es-tinto-line);
        border-top-color: var(--es-tinto);
        border-radius: 50%;
        animation: ccl-spin .8s linear infinite;
        vertical-align: middle;
    }

    @@keyframes ccl-spin {
        to {
            transform: rotate(360deg);
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .ccl-spin {
            animation-duration: 2s;
        }
    }

    /* ---------- Tabla ---------- */
    .ccl .table-wrap {
        overflow: auto;
        max-height: calc(100dvh - 300px);
        min-height: 260px;
    }

    .ccl #tablaClientes {
        width: 100%;
        min-width: 1100px;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
        table-layout: fixed;
        font-size: 12.5px;
        color: var(--es-ink);
        --bs-table-bg: transparent;
        --bs-table-color: var(--es-ink);
    }

        .ccl #tablaClientes thead th {
            position: sticky;
            top: 0;
            z-index: 2;
            padding: 9px 10px;
            background: var(--es-head);
            border-bottom: 1px solid var(--es-line);
            color: var(--es-muted);
            font-size: 11.5px;
            font-weight: 600;
            text-align: left;
            white-space: nowrap;
        }

        .ccl #tablaClientes tbody td {
            padding: 8px 10px;
            border-bottom: 1px solid var(--es-row-line);
            background: var(--es-surface);
            color: var(--es-ink);
            vertical-align: middle;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            box-shadow: none;
        }

        .ccl #tablaClientes tbody tr:hover td {
            background: var(--es-hover);
        }

        .ccl #tablaClientes td.t-code {
            font-weight: 600;
            font-variant-numeric: tabular-nums;
        }

        .ccl #tablaClientes td.t-muted {
            color: var(--es-muted);
        }

    .ccl .t-msg td {
        padding: 34px 10px !important;
        text-align: center;
        color: var(--es-muted) !important;
        white-space: normal !important;
    }

    .ccl .t-msg.is-error td {
        color: var(--es-bad) !important;
        background: var(--es-bad-bg) !important;
    }

    /* Interruptor "Aplica presupuesto" (sigue siendo el mismo checkbox) */
    .ccl .chk-presupuesto {
        appearance: none;
        -webkit-appearance: none;
        position: relative;
        width: 36px;
        height: 20px;
        margin: 0;
        border-radius: 999px;
        background: var(--es-line-strong);
        cursor: pointer;
        transition: background .15s;
        vertical-align: middle;
    }

        .ccl .chk-presupuesto::after {
            content: "";
            position: absolute;
            top: 2px;
            left: 2px;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            background: #fff;
            box-shadow: 0 1px 2px rgba(0,0,0,.25);
            transition: transform .15s;
        }

        .ccl .chk-presupuesto:checked {
            background: var(--es-ok);
        }

            .ccl .chk-presupuesto:checked::after {
                transform: translateX(16px);
            }

        .ccl .chk-presupuesto:disabled {
            opacity: .5;
            cursor: progress;
        }

        .ccl .chk-presupuesto:focus-visible {
            outline: 2px solid var(--es-tinto);
            outline-offset: 2px;
        }

    @@media (prefers-reduced-motion: reduce) {
        .ccl .chk-presupuesto, .ccl .chk-presupuesto::after {
            transition: none;
        }
    }

    .ccl tr.is-saved td {
        background: var(--es-ok-bg) !important;
        transition: background .6s;
    }

    /* ---------- Paginación ---------- */
    .ccl .pager {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
        padding: 10px 14px;
        border-top: 1px solid var(--es-line);
    }

    #statusPageInfo {
        font-size: 12px;
        color: var(--es-muted);
        font-variant-numeric: tabular-nums;
    }

    .pagination-numeric {
        display: flex;
        align-items: center;
        gap: 4px;
        flex-wrap: wrap;
    }

    .page-num-btn {
        min-width: 32px;
        height: 32px;
        padding: 0 8px;
        border: 1px solid var(--es-line-strong);
        border-radius: 7px;
        background: var(--es-field);
        color: var(--es-ink);
        font: 500 12.5px/1 var(--es-font);
        font-variant-numeric: tabular-nums;
        cursor: pointer;
    }

        .page-num-btn:hover:not(:disabled):not(.active) {
            background: var(--es-tinto-soft);
            border-color: var(--es-tinto-line);
        }

        .page-num-btn.active {
            background: var(--es-tinto);
            border-color: var(--es-tinto);
            color: #fff;
            font-weight: 600;
            cursor: default;
        }

        .page-num-btn:disabled {
            opacity: .4;
            cursor: default;
        }

    .page-ellipsis {
        min-width: 24px;
        text-align: center;
        color: var(--es-muted);
    }

    .ccl-statusbar {
        display: flex;
        gap: 18px;
        flex-wrap: wrap;
        padding: 8px 2px 0;
        font-size: 11.5px;
        color: var(--es-muted);
    }

    @@media (max-width: 640px) {
        .ccl {
            padding: 10px;
        }

        .ccl-search {
            width: 100%;
        }

        .ccl .pager {
            justify-content: center;
        }
    }

    /* ---------- Ficha del cliente (Fase 1 · solo lectura) ---------- */
    .btn-ficha {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        height: 28px;
        padding: 0 9px;
        border: 1px solid var(--es-tinto-line);
        border-radius: 6px;
        background: var(--es-tinto-soft);
        color: var(--es-tinto-deep);
        font: 600 11.5px/1 var(--es-font);
        white-space: nowrap;
        cursor: pointer;
    }

        .btn-ficha:hover {
            background: var(--es-tinto);
            border-color: var(--es-tinto);
            color: #fff;
        }

        .btn-ficha:focus-visible {
            outline: 2px solid var(--es-tinto);
            outline-offset: 2px;
        }

    .ficha-modal .modal-content {
        border: 1px solid var(--es-line);
        border-radius: 10px;
        background: var(--es-surface);
        color: var(--es-ink);
        font-family: var(--es-font);
        box-shadow: 0 18px 50px rgba(0, 0, 0, .22);
    }

    .ficha-modal .modal-header,
    .ficha-modal .modal-footer {
        border-color: var(--es-line);
        padding: 12px 18px;
    }

    .ficha-modal .modal-header {
        align-items: flex-start;
    }

    .ficha-modal .modal-title {
        font-size: 16px;
        font-weight: 700;
        margin: 0;
    }

    .ficha-subtitle {
        margin-top: 3px;
        font-size: 11.5px;
        color: var(--es-muted);
    }

    .ficha-modal .btn-close {
        filter: none;
    }

    body[data-theme="dark"] .ficha-modal .btn-close {
        filter: invert(1) grayscale(1);
    }

    .ficha-tabs {
        padding: 0 12px;
        border-bottom: 1px solid var(--es-line);
        background: var(--es-head);
    }

        .ficha-tabs .nav-link {
            border: 0;
            border-bottom: 2px solid transparent;
            border-radius: 0;
            padding: 11px 13px;
            background: none;
            color: var(--es-muted);
            font: 600 12.5px/1 var(--es-font);
        }

            .ficha-tabs .nav-link:hover {
                color: var(--es-tinto);
            }

            .ficha-tabs .nav-link.active {
                background: none;
                color: var(--es-tinto-deep);
                border-bottom-color: var(--es-tinto);
            }

    .ficha-content {
        padding: 16px 18px 20px;
        min-height: 260px;
    }

    .ficha-kpis {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 10px;
        margin-bottom: 14px;
    }

    .ficha-kpi {
        background: var(--es-head);
        border: 1px solid var(--es-line);
        border-radius: 8px;
        padding: 10px 12px;
    }

        .ficha-kpi small {
            display: block;
            color: var(--es-muted);
            font-size: 11px;
            margin-bottom: 3px;
        }

        .ficha-kpi b {
            font-size: 15px;
            font-weight: 700;
            font-variant-numeric: tabular-nums;
            word-break: break-word;
        }

        .ficha-kpi.is-bad b {
            color: var(--es-bad);
        }

    .ficha-card {
        border: 1px solid var(--es-line);
        border-radius: 8px;
        overflow: hidden;
        margin-top: 12px;
    }

        .ficha-card > h3 {
            margin: 0;
            padding: 9px 12px;
            background: var(--es-head);
            border-bottom: 1px solid var(--es-line);
            font: 600 12.5px/1.2 var(--es-font);
            color: var(--es-ink);
        }

    .ficha-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 12px;
    }

        .ficha-table th,
        .ficha-table td {
            padding: 7px 10px;
            border-bottom: 1px solid var(--es-row-line);
            text-align: left;
            vertical-align: middle;
            white-space: nowrap;
        }

        .ficha-table th {
            background: var(--es-surface);
            color: var(--es-muted);
            font-size: 11px;
            font-weight: 600;
        }

        .ficha-table tbody tr:last-child td {
            border-bottom: 0;
        }

        .ficha-table tbody tr:hover td {
            background: var(--es-hover);
        }

        .ficha-table td.num,
        .ficha-table th.num {
            text-align: right;
            font-variant-numeric: tabular-nums;
        }

    .ficha-badge {
        display: inline-block;
        padding: 1px 7px;
        border-radius: 999px;
        background: var(--es-tinto-soft);
        border: 1px solid var(--es-tinto-line);
        color: var(--es-tinto-deep);
        font-size: 11px;
        font-weight: 600;
    }

        .ficha-badge.warn {
            background: var(--es-bad-bg);
            border-color: var(--es-bad);
            color: var(--es-bad);
        }

    .ficha-loading,
    .ficha-empty,
    .ficha-error {
        padding: 26px 12px;
        text-align: center;
        font-size: 12.5px;
        color: var(--es-muted);
    }

    .ficha-error {
        color: var(--es-bad);
        background: var(--es-bad-bg);
        border: 1px solid var(--es-bad);
        border-radius: 8px;
        text-align: left;
        white-space: normal;
    }

    .ficha-note {
        margin: 8px 0 0;
        font-size: 11.5px;
        color: var(--es-muted);
    }

    .ficha-toolbar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        margin-bottom: 10px;
    }

        .ficha-toolbar input,
        .ficha-toolbar select {
            background: var(--es-field);
            color: var(--es-ink);
            border: 1px solid var(--es-line);
            border-radius: 7px;
            padding: 6px 9px;
            font: 12px/1.2 var(--es-font);
            max-width: 100%;
        }

        .ficha-toolbar input {
            min-width: 230px;
            flex: 1 1 230px;
        }

        .ficha-toolbar select {
            flex: 0 1 auto;
        }

        .ficha-toolbar input:focus,
        .ficha-toolbar select:focus {
            outline: none;
            border-color: var(--es-tinto);
            box-shadow: 0 0 0 2px var(--es-tinto-soft);
        }

        .ficha-toolbar__count {
            margin-left: auto;
            font-size: 11.5px;
            color: var(--es-muted);
            white-space: nowrap;
        }

        .ficha-toolbar__reset {
            border: 0;
            background: none;
            color: var(--es-tinto-deep);
            font: 600 12px/1 var(--es-font);
            cursor: pointer;
            padding: 5px 6px;
        }

            .ficha-toolbar__reset:hover {
                text-decoration: underline;
            }

    .btn-detalle-pedido {
        border: 0;
        background: none;
        padding: 0;
        color: var(--es-tinto-deep);
        font: 600 12px/1 var(--es-font);
        cursor: pointer;
    }

        .btn-detalle-pedido:hover {
            color: var(--es-tinto);
            text-decoration: underline;
        }

        .btn-detalle-pedido:focus-visible {
            outline: 2px solid var(--es-tinto);
            outline-offset: 2px;
        }

    .ficha-badge.est-0,
    .ficha-badge.est-3 {
        background: var(--es-bad-bg);
        border-color: var(--es-bad);
        color: var(--es-bad);
    }

    .ficha-badge.est-1,
    .ficha-badge.est-2 {
        background: #fff7e6;
        border-color: #e0a800;
        color: #8a6100;
    }

    .ficha-badge.est-4,
    .ficha-badge.est-5,
    .ficha-badge.est-6,
    .ficha-badge.est-7 {
        background: #eaf6ee;
        border-color: #4a8f5b;
        color: #2f6b3e;
    }

    body[data-theme="dark"] .ficha-badge.est-1,
    body[data-theme="dark"] .ficha-badge.est-2,
    body[data-theme="dark"] .ficha-badge.est-4,
    body[data-theme="dark"] .ficha-badge.est-5,
    body[data-theme="dark"] .ficha-badge.est-6,
    body[data-theme="dark"] .ficha-badge.est-7 {
        background: rgba(255, 193, 7, .14);
        border-color: currentColor;
    }

    .ficha-detalle-pedido > td {
        padding: 0 10px 10px 34px;
        background: var(--es-head);
        white-space: normal;
    }

        .ficha-detalle-pedido .ficha-card {
            margin-top: 4px;
        }

    @@media (max-width: 768px) {
        .ficha-content {
            padding: 12px;
        }

        .ficha-tabs {
            padding: 0 4px;
        }

            .ficha-tabs .nav-link {
                padding: 10px 8px;
                font-size: 12px;
            }

        .ficha-table {
            font-size: 11.5px;
        }

        .ficha-toolbar input {
            min-width: 0;
            flex-basis: 100%;
        }

        .ficha-toolbar__count {
            margin-left: 0;
        }
    }
</style>

<div class="ccl catalogo-clientes-app">

    <header class="ccl-header">
        <div class="ccl-header__title">
            <span class="ccl-header__icon"><i class="bi bi-people"></i></span>
            <div>
                <h1>Catálogo de clientes</h1>
                <p>Clientes sincronizados desde SAP con su canal, lista de precios, vendedor y si aplican presupuesto en la orden de venta</p>
            </div>
        </div>
        <div class="ccl-actions">
            <span id="loader" style="display:none;" role="status" aria-live="polite"><span class="ccl-spin"></span><span id="loaderText">Cargando…</span></span>

            <button id="btnDescargarExcel" class="es-btn" type="button" title="Descarga los clientes que coinciden con la búsqueda actual">
                <i class="bi bi-file-earmark-excel"></i> Descargar Excel
            </button>

            <div class="dropdown">
                <button class="es-btn es-btn--primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="btnMenuSync">
                    <i class="bi bi-cloud-arrow-down"></i> Sincronizar con SAP
                </button>
                <ul class="dropdown-menu dropdown-menu-end sync-menu" aria-labelledby="btnMenuSync">
                    <li>
                        <button id="btnSincronizar" class="dropdown-item" type="button">
                            <i class="bi bi-people"></i>
                            <span>Clientes<small>Datos generales, canal, lista y vendedor</small></span>
                        </button>
                    </li>
                    <li>
                        <button id="btnSyncDirecciones" class="dropdown-item" type="button">
                            <i class="bi bi-geo-alt"></i>
                            <span>Direcciones de todos los clientes<small>Direcciones de entrega que usa la orden de venta</small></span>
                        </button>
                    </li>
                    <li>
                        <button id="btnSyncTodas" class="dropdown-item" type="button">
                            <i class="bi bi-receipt"></i>
                            <span>Facturas de todos los clientes<small>Saldos y facturas vencidas para crédito y cobranza</small></span>
                        </button>
                    </li>
                </ul>
            </div>
        </div>
    </header>

    <section class="ccl-card">
        <div class="ccl-toolbar">
            <div class="ccl-search">
                <i class="bi bi-search"></i>
                <label for="searchInput" class="visually-hidden">Buscar cliente</label>
                <input type="search" id="searchInput" placeholder="Código, nombre o vendedor" autocomplete="off" />
            </div>
            <span class="ccl-count" id="cclCount">&nbsp;</span>
        </div>

        <div class="table-wrap">
            <table id="tablaClientes" class="table mb-0">
                <colgroup>
                    <col style="width:8%">
                    <col style="width:23%">
                    <col style="width:12%">
                    <col style="width:11%">
                    <col style="width:13%">
                    <col style="width:7%">
                    <col style="width:12%">
                    <col style="width:7%">
                    <col style="width:7%">
                </colgroup>
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Cliente</th>
                        <th>Clasificación</th>
                        <th>Canal</th>
                        <th>Lista de precios</th>
                        <th class="num">Id vendedor</th>
                        <th>Vendedor</th>
                        <th title="Si está activo, la orden de venta valida presupuesto y disponible (serie MATRIZ)">Presupuesto</th>
                        <th title="Datos de ventas, crédito y direcciones del cliente">Ficha</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <div class="pager">
            <div id="statusPageInfo">Registro listo</div>
            <div id="numericPager" class="pagination-numeric" aria-label="Paginación"></div>
        </div>
    </section>

    <footer class="ccl-statusbar">
        <span>Usuario: @(User?.Identity?.Name ?? "")</span>
        <span>Carnes G SA de CV</span>
        <span>Módulo: Catálogo de clientes</span>
    </footer>
</div>

<!-- Ficha del cliente · solo lectura (Fase 1 + 1.5) -->
<div class="modal fade ficha-modal" id="fichaModal" tabindex="-1" aria-labelledby="fichaModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title" id="fichaModalTitle">Ficha del cliente</h5>
                    <div class="ficha-subtitle" id="fichaSubtitle"></div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="es-btn" id="btnRecargarFicha" title="Volver a consultar los datos">
                        <i class="bi bi-arrow-clockwise"></i> Actualizar
                    </button>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
            </div>

            <div class="modal-body p-0">
                <ul class="nav nav-tabs ficha-tabs" id="fichaTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="tab-resumen" data-bs-toggle="tab" data-bs-target="#pane-resumen"
                                data-ficha-tab="resumen" type="button" role="tab" aria-controls="pane-resumen" aria-selected="true">
                            Resumen
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tab-credito" data-bs-toggle="tab" data-bs-target="#pane-credito"
                                data-ficha-tab="credito" type="button" role="tab" aria-controls="pane-credito" aria-selected="false">
                            Crédito y cobranza
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tab-productos" data-bs-toggle="tab" data-bs-target="#pane-productos"
                                data-ficha-tab="productos" type="button" role="tab" aria-controls="pane-productos" aria-selected="false">
                            Productos
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tab-pedidos" data-bs-toggle="tab" data-bs-target="#pane-pedidos"
                                data-ficha-tab="pedidos" type="button" role="tab" aria-controls="pane-pedidos" aria-selected="false">
                            Pedidos
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="tab-direcciones" data-bs-toggle="tab" data-bs-target="#pane-direcciones"
                                data-ficha-tab="direcciones" type="button" role="tab" aria-controls="pane-direcciones" aria-selected="false">
                            Direcciones
                        </button>
                    </li>
                </ul>

                <div class="tab-content ficha-content" id="fichaTabContent">
                    <div class="tab-pane fade show active" id="pane-resumen" role="tabpanel" aria-labelledby="tab-resumen">
                        <div id="ficha-resumen" class="ficha-loading">Preparando la ficha…</div>
                    </div>
                    <div class="tab-pane fade" id="pane-credito" role="tabpanel" aria-labelledby="tab-credito">
                        <div id="ficha-credito" class="ficha-loading">Carga al abrir esta pestaña.</div>
                    </div>
                    <div class="tab-pane fade" id="pane-productos" role="tabpanel" aria-labelledby="tab-productos">
                        <div id="ficha-productos" class="ficha-loading">Cargando productos…</div>
                    </div>
                    <div class="tab-pane fade" id="pane-pedidos" role="tabpanel" aria-labelledby="tab-pedidos">
                        <div id="ficha-pedidos" class="ficha-loading">Carga al abrir esta pestaña.</div>
                    </div>
                    <div class="tab-pane fade" id="pane-direcciones" role="tabpanel" aria-labelledby="tab-direcciones">
                        <div id="ficha-direcciones" class="ficha-loading">Cargando direcciones…</div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="es-btn" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentPage = 1;
        let pageSize = 50;
        let currentSearch = "";
        let totalItems = 0;
        let totalPages = 0;
        let cargaSeq = 0; // solo se pinta la búsqueda más reciente

        function debounce(fn, ms = 350) {
            let t; return (...a) => { clearTimeout(t); t = setTimeout(() => fn(...a), ms); };
        }

        // Textos escapados: un nombre con comillas o "<" ya no rompe la fila.
        function esc(v) {
            return String(v ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
        }
        const txt = v => (v === null || v === undefined || v === '') ? '—' : esc(v);
        const filaMensaje = (texto, error = false) => `<tr class="t-msg${error ? ' is-error' : ''}"><td colspan="9">${esc(texto)}</td></tr>`;

        function mostrarLoader(on, texto) {
            if (texto) document.getElementById("loaderText").textContent = texto;
            document.getElementById("loader").style.display = on ? "inline-flex" : "none";
        }

        function renderNumericPager() {
            const host = document.getElementById("numericPager");
            if (!host) return;
            host.innerHTML = "";
            const total = Math.max(1, Number(totalPages || 1));
            const actual = Math.max(1, Math.min(Number(currentPage || 1), total));

            function addButton(label, page, options = {}) {
                const btn = document.createElement("button");
                btn.type = "button";
                btn.className = "page-num-btn";
                btn.textContent = label;
                if (options.aria) btn.setAttribute("aria-label", options.aria);
                if (options.active) { btn.classList.add("active"); btn.setAttribute("aria-current", "page"); }
                if (options.disabled) btn.disabled = true;
                if (!options.disabled && !options.active) {
                    btn.addEventListener("click", () => { currentPage = page; cargarClientes(currentPage, currentSearch); });
                }
                host.appendChild(btn);
            }
            function addEllipsis() {
                const span = document.createElement("span");
                span.className = "page-ellipsis";
                span.textContent = "…";
                host.appendChild(span);
            }

            addButton("‹", actual - 1, { disabled: actual <= 1, aria: "Página anterior" });
            let pages = [];
            if (total <= 9) pages = Array.from({ length: total }, (_, i) => i + 1);
            else {
                const start = Math.max(2, actual - 3);
                const end = Math.min(total - 1, actual + 3);
                pages.push(1);
                if (start > 2) pages.push("...");
                for (let p = start; p <= end; p++) pages.push(p);
                if (end < total - 1) pages.push("...");
                pages.push(total);
            }
            pages.forEach(p => p === "..." ? addEllipsis() : addButton(String(p), p, { active: p === actual }));
            addButton("›", actual + 1, { disabled: actual >= total, aria: "Página siguiente" });
        }

        async function cargarClientes(page = 1, search = "") {
            const seq = ++cargaSeq;
            const tbody = document.querySelector("#tablaClientes tbody");
            tbody.innerHTML = filaMensaje("Cargando clientes…");
            mostrarLoader(true, "Cargando…");

            try {
                const res = await fetch(`/Comercial/GetClientesJsonPaged?page=${page}&pageSize=${pageSize}&search=${encodeURIComponent(search)}`);
                if (!res.ok) throw new Error("No se pudieron cargar los clientes.");
                const data = await res.json();
                if (seq !== cargaSeq) return;

                const rows = Array.isArray(data.clientes) ? data.clientes : [];
                totalItems = Number(data.total || 0);
                totalPages = Math.max(1, Math.ceil((data.total || 0) / (data.pageSize || pageSize)));
                currentPage = Number(data.page || page);
                pageSize = Number(data.pageSize || pageSize);

                document.getElementById("cclCount").innerHTML = search
                    ? `<strong>${totalItems.toLocaleString('es-MX')}</strong> cliente(s) coinciden con “${esc(search)}”`
                    : `<strong>${totalItems.toLocaleString('es-MX')}</strong> cliente(s) en el catálogo`;

                if (rows.length === 0) {
                    tbody.innerHTML = filaMensaje(search
                        ? "Ningún cliente coincide con la búsqueda. Prueba con otra parte del nombre, el código o el vendedor."
                        : "No hay clientes para mostrar. Usa Sincronizar con SAP › Clientes para traerlos.");
                    document.getElementById("statusPageInfo").textContent = "Sin resultados";
                    renderNumericPager();
                    return;
                }

                tbody.innerHTML = rows.map(cliente => {
                    const aplicaPresupuesto = Number(cliente.aplicaPresupuesto ?? 1);
                    return `
                                <tr data-codigo="${esc(cliente.cliente)}">
                                    <td class="t-code" title="${esc(cliente.cliente)}">${txt(cliente.cliente)}</td>
                                    <td title="${esc(cliente.nombrecliente)}">${txt(cliente.nombrecliente)}</td>
                                    <td title="${esc(cliente.u_MT_Clasificacion)}">${txt(cliente.u_MT_Clasificacion)}</td>
                                    <td title="${esc(cliente.u_CANAL)}">${txt(cliente.u_CANAL)}</td>
                                    <td title="${esc(cliente.priceListName)}">${txt(cliente.priceListName)}</td>
                                    <td class="num t-muted">${txt(cliente.vendedorId)}</td>
                                    <td title="${esc(cliente.vendedorNombre)}">${txt(cliente.vendedorNombre)}</td>
                                    <td>
                                        <input type="checkbox" class="chk-presupuesto" data-cliente="${esc(cliente.cliente ?? "")}"
                                               ${aplicaPresupuesto === 1 ? "checked" : ""}
                                               aria-label="Aplica presupuesto para ${esc(cliente.nombrecliente || cliente.cliente)}"
                                               title="${aplicaPresupuesto === 1 ? 'Aplica presupuesto' : 'No aplica presupuesto'}" />
                                    </td>
                                    <td>
                                        <button type="button" class="btn-ficha"
                                                data-codigo="${esc(cliente.cliente ?? "")}"
                                                data-nombre="${esc(cliente.nombrecliente ?? "")}"
                                                data-clasificacion="${esc(cliente.u_MT_Clasificacion ?? "")}"
                                                data-canal="${esc(cliente.u_CANAL ?? "")}"
                                                data-lista="${esc(cliente.priceListName ?? "")}"
                                                data-vendedorid="${esc(cliente.vendedorId ?? "")}"
                                                data-vendedor="${esc(cliente.vendedorNombre ?? "")}"
                                                data-presupuesto="${aplicaPresupuesto === 1 ? 1 : 0}"
                                                title="Ver ficha de ${esc(cliente.nombrecliente || cliente.cliente)}">
                                            <i class="bi bi-person-lines-fill"></i> Ver ficha
                                        </button>
                                    </td>
                                </tr>`;
                }).join('');

                document.getElementById("statusPageInfo").textContent =
                    `Página ${currentPage.toLocaleString('es-MX')} de ${totalPages.toLocaleString('es-MX')} · ${totalItems.toLocaleString('es-MX')} registro(s)`;
                renderNumericPager();
                document.querySelector(".ccl .table-wrap").scrollTop = 0;
            } catch (err) {
                if (seq !== cargaSeq) return;
                tbody.innerHTML = filaMensaje(`${err.message} Recarga la página o inténtalo en un momento.`, true);
                document.getElementById("statusPageInfo").textContent = "Error al cargar";
            } finally {
                if (seq === cargaSeq) mostrarLoader(false);
            }
        }

        document.getElementById("btnDescargarExcel").addEventListener("click", function () {
            const search = document.getElementById("searchInput").value || "";
            window.location.href = `/Comercial/DescargarClientesExcel?search=${encodeURIComponent(search)}`;
        });

        /* ---------- Aplica presupuesto (se guarda al cambiar, igual que antes) ---------- */
        document.querySelector("#tablaClientes tbody").addEventListener("change", async function (e) {
            if (!e.target.classList.contains("chk-presupuesto")) return;

            const checkbox = e.target;
            const clienteId = checkbox.dataset.cliente;
            const valor = checkbox.checked ? 1 : 0;
            const estadoAnterior = !checkbox.checked; // para revertir si falla
            const tr = checkbox.closest("tr");

            checkbox.disabled = true;
            try {
                const res = await fetch('/Comercial/ActualizarAplicaPresupuesto', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ clienteId: clienteId, aplicaPresupuesto: valor })
                });
                if (!res.ok) {
                    const t = await res.text();
                    throw new Error(t || 'Error al actualizar presupuesto.');
                }
                const data = await res.json();
                if (!data.ok) throw new Error(data.error || 'No se pudo actualizar.');

                // Confirmación visual breve en la fila (antes no había ninguna).
                checkbox.title = valor ? 'Aplica presupuesto' : 'No aplica presupuesto';
                document.getElementById("statusPageInfo").textContent =
                    `Cliente ${clienteId}: ${valor ? 'ahora aplica presupuesto' : 'ya no aplica presupuesto'}.`;
                tr?.classList.add("is-saved");
                setTimeout(() => tr?.classList.remove("is-saved"), 1200);
            } catch (err) {
                checkbox.checked = estadoAnterior;
                alert(`No se pudo cambiar el presupuesto del cliente ${clienteId}.\n\n${err.message}`);
            } finally {
                checkbox.disabled = false;
            }
        });

        /* ---------- Sincronizar clientes ---------- */
        document.getElementById("btnSincronizar").addEventListener("click", async function () {
            const btn = this;
            btn.disabled = true;
            mostrarLoader(true, "Sincronizando clientes con SAP…");
            try {
                const res = await fetch('/Comercial/SincronizarClient');
                if (!res.ok) throw new Error('No se pudo sincronizar con SAP.');
                alert(await res.text());
                await cargarClientes(currentPage, currentSearch);
            } catch (err) {
                alert(err.message);
            } finally {
                mostrarLoader(false);
                btn.disabled = false;
            }
        });

        /* ---------- Búsqueda ---------- */
        const buscar = debounce(() => {
            currentSearch = document.getElementById("searchInput").value || "";
            currentPage = 1;
            cargarClientes(currentPage, currentSearch);
        }, 350);
        document.getElementById("searchInput").addEventListener("input", buscar);

        document.addEventListener("DOMContentLoaded", () => cargarClientes(currentPage, currentSearch));

        /* ---------- Sincronizar facturas de TODOS los clientes ---------- */
        const btnSyncTodas = document.getElementById('btnSyncTodas');
        if (btnSyncTodas) {
            btnSyncTodas.addEventListener('click', async () => {
                if (!confirm('¿Sincronizar las facturas de TODOS los clientes desde SAP?\n\nPuede tardar varios minutos.')) return;
                btnSyncTodas.disabled = true;
                mostrarLoader(true, "Sincronizando facturas…");
                try {
                    const res = await fetch('/Comercial/SyncFacturasTodas', { method: 'POST' });
                    if (!res.ok) {
                        const t = await res.text();
                        throw new Error(t || 'Error al sincronizar');
                    }
                    const data = await res.json(); // { ok, total, ts }
                    if (!data.ok) throw new Error(data.error || 'Error en sincronización');
                    alert(`Facturas sincronizadas.\n\nFacturas procesadas: ${data.total}\nHora: ${new Date(data.ts).toLocaleString('es-MX')}`);
                } catch (err) {
                    alert(`No se pudieron sincronizar las facturas.\n\n${err.message}`);
                } finally {
                    btnSyncTodas.disabled = false;
                    mostrarLoader(false);
                }
            });
        }

        /* ---------- Sincronizar direcciones de TODOS los clientes ---------- */
        const btnSyncDirecciones = document.getElementById('btnSyncDirecciones');
        if (btnSyncDirecciones) {
            btnSyncDirecciones.addEventListener('click', async () => {
                if (!confirm('¿Sincronizar las direcciones de TODOS los clientes desde SAP?')) return;
                btnSyncDirecciones.disabled = true;
                mostrarLoader(true, "Sincronizando direcciones…");
                try {
                    const res = await fetch('/Comercial/SincronizarDireccionesClientes', { method: 'POST' });
                    if (!res.ok) {
                        const t = await res.text();
                        throw new Error(t || 'Error al sincronizar direcciones');
                    }
                    const data = await res.json();
                    if (!data.ok) throw new Error(data.error || 'Error en sincronización');
                    alert(`Direcciones sincronizadas.\n\nRegistros procesados: ${data.procesadas}`);
                } catch (err) {
                    alert(`No se pudieron sincronizar las direcciones.\n\n${err.message}`);
                } finally {
                    btnSyncDirecciones.disabled = false;
                    mostrarLoader(false);
                }
            });
        }


        const FICHA_MESES = 12;
        const FICHA_ESTADO = {
            0: 'Cancelado', 1: 'Pendiente', 2: 'Autorización', 3: 'Pendiente',
            4: 'Validado', 5: 'Enviado a SAP', 6: 'Logística', 7: 'Documentado'
        };
        const fichaCache = {};
        let fichaModalObj = null;
        let fichaActual = null;

        const fmtEntero = n => Number(n ?? 0).toLocaleString('es-MX', { maximumFractionDigits: 0 });
        const fmtKilos = n => Number(n ?? 0).toLocaleString('es-MX', { maximumFractionDigits: 1 });
        const fmtDinero = n => Number(n ?? 0).toLocaleString('es-MX', {
            style: 'currency', currency: 'MXN', minimumFractionDigits: 2, maximumFractionDigits: 2
        });
        const fmtFechaCorta = v => {
            if (!v) return '—';
            const d = new Date(v);
            return isNaN(d.getTime()) ? '—' : d.toLocaleDateString('es-MX', { year: 'numeric', month: 'short', day: '2-digit' });
        };

        const setFichaHtml = (id, html) => {
            const el = document.getElementById(id);
            if (el) el.innerHTML = html;
        };
        const fichaCargando = texto => `<div class="ficha-loading"><span class="ccl-spin"></span> ${esc(texto)}</div>`;
        const fichaVacio = texto => `<div class="ficha-empty">${esc(texto)}</div>`;
        const fichaError = (titulo, detalle) =>
            `<div class="ficha-error"><b>${esc(titulo)}</b>${detalle ? `<div style="margin-top:4px">${esc(detalle)}</div>` : ''}</div>`;
        const fichaKpi = (label, valor, cls = '') =>
            `<div class="ficha-kpi ${cls}"><small>${esc(label)}</small><b>${valor}</b></div>`;
        const fichaCard = (titulo, cuerpo, nota = '') =>
            `<div class="ficha-card"><h3>${esc(titulo)}</h3>${cuerpo}${nota ? `<p class="ficha-note">${esc(nota)}</p>` : ''}</div>`;

        async function fetchFichaJson(url) {
            const res = await fetch(url, { headers: { 'Accept': 'application/json' }, cache: 'no-store' });
            let data = null;
            try { data = await res.json(); } catch (_) { /* respuesta no JSON */ }
            if (!res.ok) {
                const partes = [];
                if (data && data.mensaje) partes.push(data.mensaje);
                if (data && data.error) partes.push(data.error);
                const msg = partes.length ? partes.join(' · ') : `HTTP ${res.status}`;
                throw new Error(msg);
            }
            return data;
        }

        function renderResumenLocal(a) {
            setFichaHtml('ficha-resumen', `<div class="ficha-kpis">
                ${fichaKpi('Código', `<span class="ficha-badge">${esc(a.codigo)}</span>`)}
                ${fichaKpi('Clasificación', txt(a.clasificacion))}
                ${fichaKpi('Canal', txt(a.canal))}
                ${fichaKpi('Lista de precios', txt(a.lista))}
                ${fichaKpi('Vendedor', txt(a.vendedor), a.vendedor ? '' : 'is-bad')}
                ${fichaKpi('Id vendedor', txt(a.vendedorId))}
                ${fichaKpi('Aplica presupuesto', a.aplicaPresupuesto ? 'Sí' : 'No')}
            </div>`);
        }

        function renderDirecciones(lista) {
            if (!lista.length) {
                setFichaHtml('ficha-direcciones', fichaVacio('El cliente no tiene direcciones activas registradas.'));
                return;
            }

            const filas = lista.map(d => `<tr>
                <td>${txt(d.aliasDireccion)} ${d.esPrincipal ? '<span class="ficha-badge">Principal</span>' : ''}</td>
                <td>${txt(d.calle)}</td>
                <td>${txt(d.colonia)}</td>
                <td>${txt(d.ciudad)}, ${txt(d.estado)}</td>
                <td>${txt(d.codigoPostal)}</td>
                <td>${txt(d.pais)}</td>
                <td>${txt(d.cedis)}${d.ruta ? ` · ${esc(d.ruta)}` : ''}</td>
                <td>${txt(d.sapAddressType)}</td>
            </tr>`).join('');

            setFichaHtml('ficha-direcciones', fichaCard('Direcciones activas',
                `<div style="overflow:auto;max-height:420px">
                    <table class="ficha-table">
                        <thead><tr><th>Alias</th><th>Calle</th><th>Colonia</th><th>Ciudad / Estado</th><th>CP</th><th>País</th><th>CEDIS / Ruta</th><th>Tipo SAP</th></tr></thead>
                        <tbody>${filas}</tbody>
                    </table>
                 </div>`,
                `${lista.length} direccione(s) activa(s).`));
        }

        async function cargarFichaResumen(codigo) {
            try {
                const data = await fetchFichaJson(`/ClienteDetalle/Resumen?cardCode=${encodeURIComponent(codigo)}`);
                if (!data.ok) throw new Error(data.mensaje || 'Respuesta inválida.');

                const c = data.cliente || {};
                renderResumenLocal({
                    codigo: c.cliente || codigo,
                    nombre: c.nombrecliente || codigo,
                    clasificacion: c.u_MT_Clasificacion || '',
                    canal: c.u_CANAL || '',
                    lista: c.priceListName || (c.priceListNum ? String(c.priceListNum) : ''),
                    vendedorId: c.vendedorId || '',
                    vendedor: c.vendedorNombre || '',
                    aplicaPresupuesto: Number(c.aplicaPresupuesto ?? 1) === 1 || c.aplicaPresupuesto === true
                });

                const host = document.getElementById('ficha-resumen');
                if (host) {
                    host.insertAdjacentHTML('beforeend', fichaCard('Datos del catálogo',
                        `<div class="ficha-kpis" style="margin:0">
                            ${fichaKpi('Clave SAP', txt(c.cliente))}
                            ${fichaKpi('Lista de precios (núm.)', txt(c.priceListNum))}
                            ${fichaKpi('Aplica presupuesto', c.aplicaPresupuesto ? 'Sí' : 'No')}
                            ${fichaKpi('Última modificación', fmtFechaCorta(c.fechaModificacion))}
                         </div>`));
                }

                renderDirecciones(data.direcciones || []);
                if (!fichaCache[codigo]) fichaCache[codigo] = {};
                fichaCache[codigo].resumen = true;
            } catch (err) {
                if (fichaActual && fichaActual.codigo === codigo) {
                    setFichaHtml('ficha-resumen', fichaError('No se pudo cargar el detalle del catálogo.', err.message));
                }
            }
        }

        async function cargarFichaProductos(codigo) {
            if (fichaActual && fichaActual.codigo !== codigo) return;
            try {
                const data = await fetchFichaJson(`/ClienteDetalle/Productos?cardCode=${encodeURIComponent(codigo)}&meses=${FICHA_MESES}`);
                if (!data.ok) throw new Error(data.mensaje || 'Respuesta inválida.');

                if (!fichaCache[codigo]) fichaCache[codigo] = {};
                fichaCache[codigo].productos = true;

                const productos = Array.isArray(data.productos) ? data.productos : [];
                const kpis = `<div class="ficha-kpis">
                    ${fichaKpi('Última compra', fmtFechaCorta(data.ultimaCompra))}
                    ${fichaKpi(`Kilos (${FICHA_MESES} meses)`, `${fmtKilos(data.kilosTotales)} kg`)}
                    ${fichaKpi('Promedio mensual', `${fmtKilos(data.promedioMensual)} kg`)}
                </div>`;
                if (!productos.length) {
                    setFichaHtml('ficha-productos', kpis + fichaVacio('No hay facturas registradas en los últimos meses para este cliente.'));
                    return;
                }

                const filas = productos.map(p => `<tr>
                    <td>${txt(p.sku)}</td>
                    <td>${txt(p.master)}</td>
                    <td title="${esc(p.producto)}">${txt(p.producto)}</td>
                    <td class="num">${fmtKilos(p.kilos)}</td>
                    <td>${fmtFechaCorta(p.ultimaCompra)}</td>
                </tr>`).join('');

                setFichaHtml('ficha-productos', kpis + fichaCard('Productos facturados',
                    `<div style="overflow:auto;max-height:420px">
                        <table class="ficha-table">
                            <thead><tr><th>SKU</th><th>Máster</th><th>Producto</th><th class="num">Kilos</th><th>Última compra</th></tr></thead>
                            <tbody>${filas}</tbody>
                        </table>
                     </div>`,
                    `Ventana: desde ${fmtFechaCorta(data.desde)} · ${productos.length} SKU(s).`));
            } catch (err) {
                if (fichaActual && fichaActual.codigo === codigo) {
                    setFichaHtml('ficha-productos', fichaError('No se pudo cargar la información de productos.', err.message));
                }
            }
        }

        function estadoPedidoBadge(p) {
            const e = Number(p.estado);
            const texto = p.estadoTexto || FICHA_ESTADO[e] || `Estado ${e}`;
            const cls = e === 0 || e === 3 ? 'est-0'
                : e === 1 || e === 2 ? `est-${e}`
                : e >= 4 && e <= 7 ? `est-${e}` : '';
            return `<span class="ficha-badge ${cls}">${esc(texto)}</span>`;
        }

        let fichaPedidosData = null;

        const tsPedido = v => {
            if (!v) return 0;
            const n = new Date(v).getTime();
            return isNaN(n) ? 0 : n;
        };
        const txtPedido = v => (v ?? '').toString()
            .normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();

        function pedidosOrdenados(lista, orden) {
            const copia = lista.slice();
            switch (orden) {
                case 'fecha-asc':
                    return copia.sort((a, b) => tsPedido(a.fechaRegistro) - tsPedido(b.fechaRegistro));
                case 'entrega-desc':
                    return copia.sort((a, b) => tsPedido(b.fechaEntrega) - tsPedido(a.fechaEntrega));
                case 'importe-desc':
                    return copia.sort((a, b) => Number(b.totalImporte ?? 0) - Number(a.totalImporte ?? 0));
                case 'importe-asc':
                    return copia.sort((a, b) => Number(a.totalImporte ?? 0) - Number(b.totalImporte ?? 0));
                case 'peso-desc':
                    return copia.sort((a, b) => Number(b.totalPeso ?? 0) - Number(a.totalPeso ?? 0));
                case 'fecha-desc':
                default:
                    return copia.sort((a, b) =>
                        tsPedido(b.fechaRegistro || b.fechaEntrega) - tsPedido(a.fechaRegistro || a.fechaEntrega));
            }
        }

        function opcionesEstadoPedido(pedidos) {
            const estados = new Map();
            pedidos.forEach(p => {
                const k = p.estado == null ? '' : String(p.estado);
                if (!estados.has(k)) {
                    estados.set(k, p.estadoTexto || FICHA_ESTADO[Number(k)] || (k ? `Estado ${k}` : 'Sin estado'));
                }
            });
            return Array.from(estados.entries())
                .sort((a, b) => a[0] === '' ? -1 : b[0] === '' ? 1 : Number(a[0]) - Number(b[0]))
                .map(([valor, texto]) => `<option value="${esc(valor)}">${esc(texto)}</option>`)
                .join('');
        }

        function filaPedido(p) {
            const idx = fichaPedidosData.pedidos.indexOf(p);
            const detalleId = `detalle-pedido-${idx}`;
            const productos = Array.isArray(p.productos) ? p.productos : [];
            const detalleProductos = productos.length
                ? `<div class="ficha-card"><h3>Renglones del pedido</h3>
                     <div style="overflow:auto;max-height:320px">
                         <table class="ficha-table">
                             <thead><tr><th>SKU</th><th>Producto</th><th class="num">Cajas</th><th class="num">Precio</th><th class="num">Kilos</th><th>Almacén</th></tr></thead>
                             <tbody>${productos.map(pr => `<tr>
                                 <td>${txt(pr.sku)}</td>
                                 <td title="${esc(pr.producto)}">${txt(pr.producto)}</td>
                                 <td class="num">${fmtEntero(pr.cajas)}</td>
                                 <td class="num">${fmtDinero(pr.precio)}</td>
                                 <td class="num">${fmtKilos(pr.kilos)}</td>
                                 <td>${txt(pr.almacen)}</td>
                             </tr>`).join('')}</tbody>
                         </table>
                      </div>
                   </div>`
                : fichaVacio('Este pedido no tiene renglones registrados en PedidoVenta.');

            return `<tr>
                <td><button type="button" class="btn-detalle-pedido" data-detalle="${detalleId}"
                            aria-expanded="false" aria-controls="${detalleId}"
                            title="Ver productos del pedido"><i class="bi bi-chevron-right"></i></button></td>
                <td>${txt(p.consecutivo)}</td>
                <td>${txt(p.serie)}</td>
                <td>${fmtFechaCorta(p.fechaRegistro)}</td>
                <td>${fmtFechaCorta(p.fechaEntrega)}</td>
                <td>${estadoPedidoBadge(p)}</td>
                <td>${txt(p.vendedor)}</td>
                <td>${txt(p.almacenSurtir)}</td>
                <td class="num">${fmtDinero(p.totalImporte)}</td>
                <td class="num">${fmtKilos(p.totalPeso)}</td>
            </tr>
            <tr class="ficha-detalle-pedido d-none" id="${detalleId}">
                <td colspan="10">
                    ${p.observacionGestion ? `<p class="ficha-note" style="margin-top:0"><b>Observación:</b> ${esc(p.observacionGestion)}</p>` : ''}
                    ${p.fechaEmbarque ? `<p class="ficha-note" style="margin-top:0"><b>Embarque:</b> ${fmtFechaCorta(p.fechaEmbarque)} · <b>Saldo:</b> ${fmtDinero(p.saldo)} · <b>Crédito:</b> ${fmtDinero(p.credito)}</p>` : ''}
                    ${detalleProductos}
                </td>
            </tr>`;
        }

        function aplicarFiltrosPedidos() {
            if (!fichaPedidosData) return;

            const buscar = document.getElementById('fichaPedidosBuscar');
            const estado = document.getElementById('fichaPedidosEstado');
            const orden = document.getElementById('fichaPedidosOrden');
            const body = document.getElementById('fichaPedidosBody');
            const conteo = document.getElementById('fichaPedidosConteo');
            if (!buscar || !estado || !orden || !body) return;

            const q = txtPedido(buscar.value.trim());
            const estadoSel = estado.value;
            const filtrados = fichaPedidosData.pedidos.filter(p => {
                const texto = !q || [p.consecutivo, p.serie, p.vendedor, p.almacenSurtir]
                    .some(v => txtPedido(v).includes(q));
                const est = estadoSel === '' || String(p.estado ?? '') === estadoSel;
                return texto && est;
            });

            const visibles = pedidosOrdenados(filtrados, orden.value);
            body.innerHTML = visibles.length
                ? visibles.map(filaPedido).join('')
                : `<tr><td colspan="10" class="ficha-empty">No hay pedidos que coincidan con los filtros.</td></tr>`;

            if (conteo) {
                const total = fichaPedidosData.pedidos.length;
                const base = visibles.length === total
                    ? `${fmtEntero(total)} pedido(s)`
                    : `${fmtEntero(visibles.length)} de ${fmtEntero(total)} pedido(s)`;
                const limite = fichaPedidosData.truncado
                    ? ` · máx. ${fmtEntero(fichaPedidosData.limite)}` : '';
                conteo.textContent = base + limite;
            }
        }

        function renderPedidos(data) {
            const pedidos = Array.isArray(data.pedidos) ? data.pedidos : [];
            fichaPedidosData = {
                pedidos,
                truncado: !!data.truncado,
                limite: Number(data.limite || 300)
            };

            const kpis = `<div class="ficha-kpis">
                ${fichaKpi('Pedidos', fmtEntero(data.totalPedidos ?? pedidos.length))}
                ${fichaKpi('Importe total', fmtDinero(data.importeTotal))}
                ${fichaKpi('Peso total', `${fmtKilos(data.pesoTotal)} kg`)}
                ${fichaKpi('Desde', fmtFechaCorta(data.desde))}
            </div>`;

            if (!pedidos.length) {
                fichaPedidosData = null;
                setFichaHtml('ficha-pedidos', kpis + fichaVacio('No hay pedidos registrados en los últimos meses para este cliente.'));
                return;
            }

            const toolbar = `<div class="ficha-toolbar">
                <input id="fichaPedidosBuscar" type="search" placeholder="Buscar pedido, serie o vendedor"
                       aria-label="Buscar pedidos" autocomplete="off" />
                <select id="fichaPedidosEstado" aria-label="Filtrar por estado">
                    <option value="">Todos los estados</option>${opcionesEstadoPedido(pedidos)}
                </select>
                <select id="fichaPedidosOrden" aria-label="Ordenar pedidos">
                    <option value="fecha-desc">Más recientes</option>
                    <option value="fecha-asc">Más antiguos</option>
                    <option value="entrega-desc">Entrega: más reciente</option>
                    <option value="importe-desc">Importe: mayor a menor</option>
                    <option value="importe-asc">Importe: menor a mayor</option>
                    <option value="peso-desc">Peso: mayor a menor</option>
                </select>
                <button type="button" class="ficha-toolbar__reset" id="fichaPedidosLimpiar">Limpiar</button>
                <span class="ficha-toolbar__count" id="fichaPedidosConteo"></span>
            </div>`;

            const nota = data.truncado
                ? `Se muestran los ${fmtEntero(data.limite || 300)} pedidos más recientes; puede haber más fuera de ese límite.`
                : `${fmtEntero(pedidos.length)} pedido(s) en la ventana consultada.`;

            setFichaHtml('ficha-pedidos', kpis + fichaCard('Pedidos de venta',
                toolbar + `<div style="overflow:auto;max-height:480px">
                    <table class="ficha-table">
                        <thead><tr><th></th><th>Pedido</th><th>Serie</th><th>Registro</th><th>Entrega</th><th>Estado</th><th>Vendedor</th><th>Almacén</th><th class="num">Importe</th><th class="num">Peso</th></tr></thead>
                        <tbody id="fichaPedidosBody"></tbody>
                    </table>
                 </div>`,
                nota));

            document.getElementById('fichaPedidosBuscar').addEventListener('input', aplicarFiltrosPedidos);
            document.getElementById('fichaPedidosEstado').addEventListener('change', aplicarFiltrosPedidos);
            document.getElementById('fichaPedidosOrden').addEventListener('change', aplicarFiltrosPedidos);
            document.getElementById('fichaPedidosLimpiar').addEventListener('click', function () {
                document.getElementById('fichaPedidosBuscar').value = '';
                document.getElementById('fichaPedidosEstado').value = '';
                document.getElementById('fichaPedidosOrden').value = 'fecha-desc';
                aplicarFiltrosPedidos();
                document.getElementById('fichaPedidosBuscar').focus();
            });

            aplicarFiltrosPedidos();
        }

        async function cargarFichaPedidos(codigo) {
            if (fichaActual && fichaActual.codigo !== codigo) return;
            if (fichaCache[codigo] && fichaCache[codigo].pedidos) return;

            fichaPedidosData = null;
            setFichaHtml('ficha-pedidos', fichaCargando('Consultando pedidos de venta…'));

            try {
                const data = await fetchFichaJson(`/ClienteDetalle/Pedidos?cardCode=${encodeURIComponent(codigo)}&meses=${FICHA_MESES}`);
                if (!data.ok) throw new Error(data.mensaje || 'Respuesta inválida.');

                if (fichaActual && fichaActual.codigo !== codigo) return;
                renderPedidos(data);
                if (!fichaCache[codigo]) fichaCache[codigo] = {};
                fichaCache[codigo].pedidos = true;
            } catch (err) {
                fichaPedidosData = null;
                if (fichaActual && fichaActual.codigo === codigo) {
                    setFichaHtml('ficha-pedidos', fichaError('No se pudo cargar la información de pedidos.', err.message));
                }
            }
        }

        async function cargarFichaCredito() {
            if (!fichaActual) return;
            const codigo = fichaActual.codigo;
            if (fichaCache[codigo] && fichaCache[codigo].credito) return;

            setFichaHtml('ficha-credito', fichaCargando('Consultando crédito y facturas en SAP…'));

            const urlComp = `/Comercial/ObtenerComplementoCliente?cardCode=${encodeURIComponent(codigo)}`;
            const urlFac = `/Comercial/ObtenerFacturasVencidasCliente?cardCode=${encodeURIComponent(codigo)}`;
            const [compRes, facRes] = await Promise.allSettled([
                fetchFichaJson(urlComp),
                fetchFichaJson(urlFac)
            ]);

            let comp = null;
            let fac = null;
            const errores = [];
            if (compRes.status === 'fulfilled') comp = compRes.value;
            else errores.push(`Crédito: ${compRes.reason.message}`);
            if (facRes.status === 'fulfilled') fac = facRes.value;
            else errores.push(`Facturas: ${facRes.reason.message}`);

            let html = `<div class="ficha-kpis">
                ${fichaKpi('Límite de crédito', fmtDinero(comp?.credito))}
                ${fichaKpi('Saldo actual', fmtDinero(comp?.saldo))}
                ${fichaKpi('Pedidos pendientes', fmtDinero(comp?.sumpedidos))}
                ${fichaKpi('Saldo vencido', fmtDinero(fac?.saldoVencido ?? comp?.saldoVencido), 'is-bad')}
                ${fichaKpi('Facturas vencidas', fmtEntero(fac?.cantidadFacturas))}
                ${fichaKpi('Con compromiso', fmtEntero(fac?.cantidadConCompromiso))}
            </div>`;

            if (comp && comp.success === false) {
                html += fichaCard('Aviso de SAP',
                    `<p class="ficha-note" style="margin:0">${esc(comp.mensaje || 'SAP no devolvió información de crédito.')}${comp.motivo ? ` (${esc(comp.motivo)})` : ''}</p>`);
            }
            if (errores.length) {
                html += fichaError('Algunos datos no estuvieron disponibles.', errores.join(' · '));
            }

            const facturas = fac && Array.isArray(fac.facturas) ? fac.facturas : [];
            if (!facturas.length) {
                html += fichaVacio(fac && fac.ok
                    ? 'El cliente no tiene facturas vencidas al día de hoy.'
                    : 'No se pudieron consultar las facturas vencidas.');
            } else {
                const filas = facturas.map(f => `<tr>
                    <td>${txt(f.docNum)}</td>
                    <td>${fmtFechaCorta(f.fechaFactura)}</td>
                    <td>${fmtFechaCorta(f.fechaVencimiento)}</td>
                    <td class="num">${fmtDinero(f.importe)}</td>
                    <td class="num">${fmtDinero(f.pendienteActualSap ?? f.pendiente)}</td>
                    <td class="num">${fmtEntero(f.diasVencidos)}</td>
                    <td>${f.tieneCompromiso ? `<span class="ficha-badge">${txt(f.tipoCompromiso || 'Compromiso')}</span>` : '—'}</td>
                </tr>`).join('');

                html += fichaCard('Facturas vencidas',
                    `<div style="overflow:auto;max-height:420px">
                        <table class="ficha-table">
                            <thead><tr><th>Factura</th><th>Fecha</th><th>Vencimiento</th><th class="num">Importe</th><th class="num">Pendiente</th><th class="num">Días</th><th>Compromiso</th></tr></thead>
                            <tbody>${filas}</tbody>
                        </table>
                     </div>`,
                    `${fmtEntero(fac.cantidadFacturas)} factura(s) · ${fmtEntero(fac.cantidadSinCompromiso)} sin compromiso.`);
            }

            setFichaHtml('ficha-credito', html);
            if (!fichaCache[codigo]) fichaCache[codigo] = {};
            fichaCache[codigo].credito = true;
        }

        function abrirFicha(btn) {
            const codigo = btn.dataset.codigo || '';
            if (!codigo) return;

            fichaActual = {
                codigo,
                nombre: btn.dataset.nombre || codigo,
                clasificacion: btn.dataset.clasificacion || '',
                canal: btn.dataset.canal || '',
                lista: btn.dataset.lista || '',
                vendedorId: btn.dataset.vendedorid || '',
                vendedor: btn.dataset.vendedor || '',
                aplicaPresupuesto: btn.dataset.presupuesto === '1'
            };

            document.getElementById('fichaModalTitle').textContent = fichaActual.nombre;
            document.getElementById('fichaSubtitle').textContent =
                `${codigo} · ${fichaActual.clasificacion || 'Sin clasificación'} · ${fichaActual.canal || 'Sin canal'} · ${fichaActual.vendedor || 'Sin vendedor'}`;

            /* Reabrir la ficha recarga todo: evita dejar pestañas en "Carga al abrir…"
               cuando el caché decía que ya estaban listas pero el DOM se limpió. */
            fichaCache[codigo] = {};
            fichaPedidosData = null;
            renderResumenLocal(fichaActual);
            setFichaHtml('ficha-credito', '<div class="ficha-empty">Carga al abrir la pestaña <b>Crédito y cobranza</b>.</div>');
            setFichaHtml('ficha-productos', fichaCargando('Consultando facturas de los últimos meses…'));
            setFichaHtml('ficha-pedidos', '<div class="ficha-empty">Carga al abrir la pestaña <b>Pedidos</b>.</div>');
            setFichaHtml('ficha-direcciones', fichaCargando('Consultando direcciones…'));

            if (!fichaModalObj) {
                const modalEl = document.getElementById('fichaModal');
                if (modalEl && window.bootstrap) fichaModalObj = bootstrap.Modal.getOrCreateInstance(modalEl);
            }
            if (fichaModalObj) fichaModalObj.show();

            cargarFichaResumen(codigo);
            cargarFichaProductos(codigo);
        }

        /* La tabla se vuelve a pintar en cada búsqueda: usamos delegación. */
        document.querySelector("#tablaClientes tbody").addEventListener("click", function (e) {
            const btn = e.target.closest(".btn-ficha");
            if (btn) abrirFicha(btn);
        });

        document.querySelectorAll('#fichaTabs [data-ficha-tab]').forEach(function (tab) {
            tab.addEventListener('shown.bs.tab', function () {
                if (tab.dataset.fichaTab === 'credito') cargarFichaCredito();
                if (tab.dataset.fichaTab === 'pedidos' && fichaActual) cargarFichaPedidos(fichaActual.codigo);
            });
        });

        /* Expander los renglones de cada pedido (delegación: el contenido se repinta). */
        const fichaPedidosHost = document.getElementById('ficha-pedidos');
        if (fichaPedidosHost) {
            fichaPedidosHost.addEventListener('click', function (e) {
                const btn = e.target.closest('.btn-detalle-pedido');
                if (!btn) return;

                const row = document.getElementById(btn.dataset.detalle);
                if (!row) return;

                const abierto = !row.classList.contains('d-none');
                row.classList.toggle('d-none', abierto);
                btn.setAttribute('aria-expanded', abierto ? 'false' : 'true');
                const icon = btn.querySelector('i');
                if (icon) icon.className = abierto ? 'bi bi-chevron-right' : 'bi bi-chevron-down';
            });
        }

        const btnRecargarFicha = document.getElementById('btnRecargarFicha');
        if (btnRecargarFicha) {
            btnRecargarFicha.addEventListener('click', function () {
                if (!fichaActual) return;
                const codigo = fichaActual.codigo;
                fichaCache[codigo] = {};
                cargarFichaResumen(codigo);
                cargarFichaProductos(codigo);
                cargarFichaPedidos(codigo);
                cargarFichaCredito();
            });
        }

        document.addEventListener("DOMContentLoaded", () => {
            const modalEl = document.getElementById('fichaModal');
            if (modalEl && window.bootstrap) fichaModalObj = bootstrap.Modal.getOrCreateInstance(modalEl);
        });
    </script>
}
