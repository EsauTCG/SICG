@model IEnumerable<Plataforma_CG.Models.ClienteSap>

@{
    ViewData["Title"] = "Catálogo de Clientes";
    Layout = "~/Views/Shared/_Layout2.cshtml";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    /* =====================================================================
           CATÁLOGO DE CLIENTES · SIGO — hoja de estilos única
           Mismo sistema visual que el resto de módulos. Sustituye las 4 capas
           anteriores y catalogo-clientes-sap-grid.css.
           ===================================================================== */
    :root {
        --es-tinto: #8d3e46;
        --es-tinto-deep: #5c2229;
        --es-tinto-soft: #f7eced;
        --es-tinto-line: #e8d3d6;
        --es-paper: #f6f4f4;
        --es-surface: #ffffff;
        --es-field: #ffffff;
        --es-head: #faf7f7;
        --es-hover: #fcf9f9;
        --es-row-line: #f0eaeb;
        --es-ink: #231a1c;
        --es-muted: #76686b;
        --es-line: #e6dfe0;
        --es-line-strong: #cfc4c6;
        --es-ok: #2f7a55;
        --es-ok-bg: #e7f3ec;
        --es-bad: #b42d2d;
        --es-bad-bg: #fbe9e8;
        --es-font: "Poppins", "Segoe UI", system-ui, -apple-system, Arial, sans-serif;
    }

    body[data-theme="dark"] {
        --es-tinto: #c56b74;
        --es-tinto-deep: #7a2d36;
        --es-tinto-soft: #3a2427;
        --es-tinto-line: #5a3439;
        --es-paper: #16181c;
        --es-surface: #202328;
        --es-field: #181a1e;
        --es-head: #262a30;
        --es-hover: #2a2e34;
        --es-row-line: #30343b;
        --es-ink: #edf0f3;
        --es-muted: #a9b0b9;
        --es-line: #363b43;
        --es-line-strong: #4a5059;
        --es-ok: #6cc596;
        --es-ok-bg: #1d3328;
        --es-bad: #f08a83;
        --es-bad-bg: #3d2223;
    }

    .ccl {
        font-family: var(--es-font);
        color: var(--es-ink);
        font-size: 13px;
        line-height: 1.4;
        background: var(--es-paper);
        padding: 16px 18px 10px;
        min-width: 0;
    }

        .ccl * {
            box-sizing: border-box;
        }

        .ccl .bi {
            font-family: "bootstrap-icons" !important;
        }

    .num {
        text-align: right !important;
        font-variant-numeric: tabular-nums;
    }

    /* ---------- Encabezado ---------- */
    .ccl-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 14px;
    }

    .ccl-header__title {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .ccl-header__icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: grid;
        place-items: center;
        background: var(--es-tinto);
        color: #fff;
        font-size: 19px;
    }

    .ccl-header h1 {
        margin: 0;
        font-size: 20px;
        font-weight: 700;
        letter-spacing: -.01em;
        line-height: 1.15;
        color: var(--es-ink);
    }

    .ccl-header p {
        margin: 2px 0 0;
        font-size: 12px;
        color: var(--es-muted);
    }

    .ccl-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    /* ---------- Botones ---------- */
    .es-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        height: 36px;
        padding: 0 14px;
        border: 1px solid var(--es-line-strong);
        border-radius: 7px;
        background: var(--es-field);
        color: var(--es-ink);
        font: 600 12.5px/1 var(--es-font);
        white-space: nowrap;
        cursor: pointer;
        transition: background .12s, border-color .12s, color .12s;
    }

        .es-btn:hover {
            background: var(--es-tinto-soft);
            border-color: var(--es-tinto-line);
            color: var(--es-ink);
        }

        .es-btn:focus-visible {
            outline: 2px solid var(--es-tinto);
            outline-offset: 2px;
        }

        .es-btn:disabled {
            opacity: .5;
            cursor: not-allowed;
        }

    .es-btn--primary {
        background: var(--es-tinto);
        border-color: var(--es-tinto);
        color: #fff;
    }

        .es-btn--primary:hover, .es-btn--primary.show {
            background: var(--es-tinto-deep);
            border-color: var(--es-tinto-deep);
            color: #fff;
        }

    /* Menú de sincronización */
    .sync-menu {
        min-width: 290px;
        padding: 4px;
        border: 1px solid var(--es-line-strong);
        border-radius: 8px;
        background: var(--es-surface);
        box-shadow: 0 10px 28px rgba(0,0,0,.15);
    }

        .sync-menu .dropdown-item {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            padding: 9px 10px;
            border-radius: 6px;
            font: 500 12.5px/1.25 var(--es-font);
            color: var(--es-ink);
            white-space: normal;
        }

            .sync-menu .dropdown-item i {
                margin-top: 2px;
                color: var(--es-tinto);
            }

            .sync-menu .dropdown-item small {
                display: block;
                margin-top: 2px;
                font-size: 11px;
                color: var(--es-muted);
            }

            .sync-menu .dropdown-item:hover, .sync-menu .dropdown-item:focus {
                background: var(--es-tinto-soft);
                color: var(--es-ink);
            }

            .sync-menu .dropdown-item:disabled {
                opacity: .55;
            }

    /* ---------- Tarjeta ---------- */
    .ccl-card {
        background: var(--es-surface);
        border: 1px solid var(--es-line);
        border-radius: 10px;
        overflow: hidden;
    }

    .ccl-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
        padding: 12px 14px;
        border-bottom: 1px solid var(--es-line);
    }

    .ccl-search {
        position: relative;
        width: 420px;
        max-width: 100%;
    }

        .ccl-search i {
            position: absolute;
            left: 11px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--es-muted);
            font-size: 13px;
            pointer-events: none;
        }

    .ccl #searchInput {
        display: block;
        width: 100%;
        height: 36px;
        padding: 0 10px 0 32px;
        border: 1px solid var(--es-line-strong);
        border-radius: 7px;
        background: var(--es-field);
        color: var(--es-ink);
        font: 500 13px/1 var(--es-font);
        box-shadow: none;
    }

        .ccl #searchInput:focus {
            outline: none;
            border-color: var(--es-tinto);
            box-shadow: 0 0 0 3px rgba(141,62,70,.16);
        }

    .ccl-count {
        font-size: 12px;
        color: var(--es-muted);
    }

        .ccl-count strong {
            color: var(--es-ink);
            font-weight: 600;
        }

    #loader {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-size: 12px;
        color: var(--es-muted);
    }

    .ccl-spin {
        display: inline-block;
        width: 13px;
        height: 13px;
        border: 2px solid var(--es-tinto-line);
        border-top-color: var(--es-tinto);
        border-radius: 50%;
        animation: ccl-spin .8s linear infinite;
        vertical-align: middle;
    }

    @@keyframes ccl-spin {
        to {
            transform: rotate(360deg);
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .ccl-spin {
            animation-duration: 2s;
        }
    }

    /* ---------- Tabla ---------- */
    .ccl .table-wrap {
        overflow: auto;
        max-height: calc(100dvh - 300px);
        min-height: 260px;
    }

    .ccl #tablaClientes {
        width: 100%;
        min-width: 1100px;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
        table-layout: fixed;
        font-size: 12.5px;
        color: var(--es-ink);
        --bs-table-bg: transparent;
        --bs-table-color: var(--es-ink);
    }

        .ccl #tablaClientes thead th {
            position: sticky;
            top: 0;
            z-index: 2;
            padding: 9px 10px;
            background: var(--es-head);
            border-bottom: 1px solid var(--es-line);
            color: var(--es-muted);
            font-size: 11.5px;
            font-weight: 600;
            text-align: left;
            white-space: nowrap;
        }

        .ccl #tablaClientes tbody td {
            padding: 8px 10px;
            border-bottom: 1px solid var(--es-row-line);
            background: var(--es-surface);
            color: var(--es-ink);
            vertical-align: middle;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            box-shadow: none;
        }

        .ccl #tablaClientes tbody tr:hover td {
            background: var(--es-hover);
        }

        .ccl #tablaClientes td.t-code {
            font-weight: 600;
            font-variant-numeric: tabular-nums;
        }

        .ccl #tablaClientes td.t-muted {
            color: var(--es-muted);
        }

    .ccl .t-msg td {
        padding: 34px 10px !important;
        text-align: center;
        color: var(--es-muted) !important;
        white-space: normal !important;
    }

    .ccl .t-msg.is-error td {
        color: var(--es-bad) !important;
        background: var(--es-bad-bg) !important;
    }

    /* Interruptor "Aplica presupuesto" (sigue siendo el mismo checkbox) */
    .ccl .chk-presupuesto {
        appearance: none;
        -webkit-appearance: none;
        position: relative;
        width: 36px;
        height: 20px;
        margin: 0;
        border-radius: 999px;
        background: var(--es-line-strong);
        cursor: pointer;
        transition: background .15s;
        vertical-align: middle;
    }

        .ccl .chk-presupuesto::after {
            content: "";
            position: absolute;
            top: 2px;
            left: 2px;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            background: #fff;
            box-shadow: 0 1px 2px rgba(0,0,0,.25);
            transition: transform .15s;
        }

        .ccl .chk-presupuesto:checked {
            background: var(--es-ok);
        }

            .ccl .chk-presupuesto:checked::after {
                transform: translateX(16px);
            }

        .ccl .chk-presupuesto:disabled {
            opacity: .5;
            cursor: progress;
        }

        .ccl .chk-presupuesto:focus-visible {
            outline: 2px solid var(--es-tinto);
            outline-offset: 2px;
        }

    @@media (prefers-reduced-motion: reduce) {
        .ccl .chk-presupuesto, .ccl .chk-presupuesto::after {
            transition: none;
        }
    }

    .ccl tr.is-saved td {
        background: var(--es-ok-bg) !important;
        transition: background .6s;
    }

    /* ---------- Paginación ---------- */
    .ccl .pager {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
        padding: 10px 14px;
        border-top: 1px solid var(--es-line);
    }

    #statusPageInfo {
        font-size: 12px;
        color: var(--es-muted);
        font-variant-numeric: tabular-nums;
    }

    .pagination-numeric {
        display: flex;
        align-items: center;
        gap: 4px;
        flex-wrap: wrap;
    }

    .page-num-btn {
        min-width: 32px;
        height: 32px;
        padding: 0 8px;
        border: 1px solid var(--es-line-strong);
        border-radius: 7px;
        background: var(--es-field);
        color: var(--es-ink);
        font: 500 12.5px/1 var(--es-font);
        font-variant-numeric: tabular-nums;
        cursor: pointer;
    }

        .page-num-btn:hover:not(:disabled):not(.active) {
            background: var(--es-tinto-soft);
            border-color: var(--es-tinto-line);
        }

        .page-num-btn.active {
            background: var(--es-tinto);
            border-color: var(--es-tinto);
            color: #fff;
            font-weight: 600;
            cursor: default;
        }

        .page-num-btn:disabled {
            opacity: .4;
            cursor: default;
        }

    .page-ellipsis {
        min-width: 24px;
        text-align: center;
        color: var(--es-muted);
    }

    .ccl-statusbar {
        display: flex;
        gap: 18px;
        flex-wrap: wrap;
        padding: 8px 2px 0;
        font-size: 11.5px;
        color: var(--es-muted);
    }

    @@media (max-width: 640px) {
        .ccl {
            padding: 10px;
        }

        .ccl-search {
            width: 100%;
        }

        .ccl .pager {
            justify-content: center;
        }
    }
</style>

<div class="ccl catalogo-clientes-app">

    <header class="ccl-header">
        <div class="ccl-header__title">
            <span class="ccl-header__icon"><i class="bi bi-people"></i></span>
            <div>
                <h1>Catálogo de clientes</h1>
                <p>Clientes sincronizados desde SAP con su canal, lista de precios, vendedor y si aplican presupuesto en la orden de venta</p>
            </div>
        </div>
        <div class="ccl-actions">
            <span id="loader" style="display:none;" role="status" aria-live="polite"><span class="ccl-spin"></span><span id="loaderText">Cargando…</span></span>

            <button id="btnDescargarExcel" class="es-btn" type="button" title="Descarga los clientes que coinciden con la búsqueda actual">
                <i class="bi bi-file-earmark-excel"></i> Descargar Excel
            </button>

            <div class="dropdown">
                <button class="es-btn es-btn--primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="btnMenuSync">
                    <i class="bi bi-cloud-arrow-down"></i> Sincronizar con SAP
                </button>
                <ul class="dropdown-menu dropdown-menu-end sync-menu" aria-labelledby="btnMenuSync">
                    <li>
                        <button id="btnSincronizar" class="dropdown-item" type="button">
                            <i class="bi bi-people"></i>
                            <span>Clientes<small>Datos generales, canal, lista y vendedor</small></span>
                        </button>
                    </li>
                    <li>
                        <button id="btnSyncDirecciones" class="dropdown-item" type="button">
                            <i class="bi bi-geo-alt"></i>
                            <span>Direcciones de todos los clientes<small>Direcciones de entrega que usa la orden de venta</small></span>
                        </button>
                    </li>
                    <li>
                        <button id="btnSyncTodas" class="dropdown-item" type="button">
                            <i class="bi bi-receipt"></i>
                            <span>Facturas de todos los clientes<small>Saldos y facturas vencidas para crédito y cobranza</small></span>
                        </button>
                    </li>
                </ul>
            </div>
        </div>
    </header>

    <section class="ccl-card">
        <div class="ccl-toolbar">
            <div class="ccl-search">
                <i class="bi bi-search"></i>
                <label for="searchInput" class="visually-hidden">Buscar cliente</label>
                <input type="search" id="searchInput" placeholder="Código, nombre o vendedor" autocomplete="off" />
            </div>
            <span class="ccl-count" id="cclCount">&nbsp;</span>
        </div>

        <div class="table-wrap">
            <table id="tablaClientes" class="table mb-0">
                <colgroup>
                    <col style="width:9%">
                    <col style="width:25%">
                    <col style="width:13%">
                    <col style="width:12%">
                    <col style="width:14%">
                    <col style="width:7%">
                    <col style="width:13%">
                    <col style="width:7%">
                </colgroup>
                <thead>
                    <tr>
                        <th>Código</th>
                        <th>Cliente</th>
                        <th>Clasificación</th>
                        <th>Canal</th>
                        <th>Lista de precios</th>
                        <th class="num">Id vendedor</th>
                        <th>Vendedor</th>
                        <th title="Si está activo, la orden de venta valida presupuesto y disponible (serie MATRIZ)">Presupuesto</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <div class="pager">
            <div id="statusPageInfo">Registro listo</div>
            <div id="numericPager" class="pagination-numeric" aria-label="Paginación"></div>
        </div>
    </section>

    <footer class="ccl-statusbar">
        <span>Usuario: @(User?.Identity?.Name ?? "")</span>
        <span>Carnes G SA de CV</span>
        <span>Módulo: Catálogo de clientes</span>
    </footer>
</div>

@section Scripts {
    <script>
        let currentPage = 1;
        let pageSize = 50;
        let currentSearch = "";
        let totalItems = 0;
        let totalPages = 0;
        let cargaSeq = 0; // solo se pinta la búsqueda más reciente

        function debounce(fn, ms = 350) {
            let t; return (...a) => { clearTimeout(t); t = setTimeout(() => fn(...a), ms); };
        }

        // Textos escapados: un nombre con comillas o "<" ya no rompe la fila.
        function esc(v) {
            return String(v ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
        }
        const txt = v => (v === null || v === undefined || v === '') ? '—' : esc(v);
        const filaMensaje = (texto, error = false) => `<tr class="t-msg${error ? ' is-error' : ''}"><td colspan="8">${esc(texto)}</td></tr>`;

        function mostrarLoader(on, texto) {
            if (texto) document.getElementById("loaderText").textContent = texto;
            document.getElementById("loader").style.display = on ? "inline-flex" : "none";
        }

        function renderNumericPager() {
            const host = document.getElementById("numericPager");
            if (!host) return;
            host.innerHTML = "";
            const total = Math.max(1, Number(totalPages || 1));
            const actual = Math.max(1, Math.min(Number(currentPage || 1), total));

            function addButton(label, page, options = {}) {
                const btn = document.createElement("button");
                btn.type = "button";
                btn.className = "page-num-btn";
                btn.textContent = label;
                if (options.aria) btn.setAttribute("aria-label", options.aria);
                if (options.active) { btn.classList.add("active"); btn.setAttribute("aria-current", "page"); }
                if (options.disabled) btn.disabled = true;
                if (!options.disabled && !options.active) {
                    btn.addEventListener("click", () => { currentPage = page; cargarClientes(currentPage, currentSearch); });
                }
                host.appendChild(btn);
            }
            function addEllipsis() {
                const span = document.createElement("span");
                span.className = "page-ellipsis";
                span.textContent = "…";
                host.appendChild(span);
            }

            addButton("‹", actual - 1, { disabled: actual <= 1, aria: "Página anterior" });
            let pages = [];
            if (total <= 9) pages = Array.from({ length: total }, (_, i) => i + 1);
            else {
                const start = Math.max(2, actual - 3);
                const end = Math.min(total - 1, actual + 3);
                pages.push(1);
                if (start > 2) pages.push("...");
                for (let p = start; p <= end; p++) pages.push(p);
                if (end < total - 1) pages.push("...");
                pages.push(total);
            }
            pages.forEach(p => p === "..." ? addEllipsis() : addButton(String(p), p, { active: p === actual }));
            addButton("›", actual + 1, { disabled: actual >= total, aria: "Página siguiente" });
        }

        async function cargarClientes(page = 1, search = "") {
            const seq = ++cargaSeq;
            const tbody = document.querySelector("#tablaClientes tbody");
            tbody.innerHTML = filaMensaje("Cargando clientes…");
            mostrarLoader(true, "Cargando…");

            try {
                const res = await fetch(`/Comercial/GetClientesJsonPaged?page=${page}&pageSize=${pageSize}&search=${encodeURIComponent(search)}`);
                if (!res.ok) throw new Error("No se pudieron cargar los clientes.");
                const data = await res.json();
                if (seq !== cargaSeq) return;

                const rows = Array.isArray(data.clientes) ? data.clientes : [];
                totalItems = Number(data.total || 0);
                totalPages = Math.max(1, Math.ceil((data.total || 0) / (data.pageSize || pageSize)));
                currentPage = Number(data.page || page);
                pageSize = Number(data.pageSize || pageSize);

                document.getElementById("cclCount").innerHTML = search
                    ? `<strong>${totalItems.toLocaleString('es-MX')}</strong> cliente(s) coinciden con “${esc(search)}”`
                    : `<strong>${totalItems.toLocaleString('es-MX')}</strong> cliente(s) en el catálogo`;

                if (rows.length === 0) {
                    tbody.innerHTML = filaMensaje(search
                        ? "Ningún cliente coincide con la búsqueda. Prueba con otra parte del nombre, el código o el vendedor."
                        : "No hay clientes para mostrar. Usa Sincronizar con SAP › Clientes para traerlos.");
                    document.getElementById("statusPageInfo").textContent = "Sin resultados";
                    renderNumericPager();
                    return;
                }

                tbody.innerHTML = rows.map(cliente => {
                    const aplicaPresupuesto = Number(cliente.aplicaPresupuesto ?? 1);
                    return `
                                <tr data-codigo="${esc(cliente.cliente)}">
                                    <td class="t-code" title="${esc(cliente.cliente)}">${txt(cliente.cliente)}</td>
                                    <td title="${esc(cliente.nombrecliente)}">${txt(cliente.nombrecliente)}</td>
                                    <td title="${esc(cliente.u_MT_Clasificacion)}">${txt(cliente.u_MT_Clasificacion)}</td>
                                    <td title="${esc(cliente.u_CANAL)}">${txt(cliente.u_CANAL)}</td>
                                    <td title="${esc(cliente.priceListName)}">${txt(cliente.priceListName)}</td>
                                    <td class="num t-muted">${txt(cliente.vendedorId)}</td>
                                    <td title="${esc(cliente.vendedorNombre)}">${txt(cliente.vendedorNombre)}</td>
                                    <td>
                                        <input type="checkbox" class="chk-presupuesto" data-cliente="${esc(cliente.cliente ?? "")}"
                                               ${aplicaPresupuesto === 1 ? "checked" : ""}
                                               aria-label="Aplica presupuesto para ${esc(cliente.nombrecliente || cliente.cliente)}"
                                               title="${aplicaPresupuesto === 1 ? 'Aplica presupuesto' : 'No aplica presupuesto'}" />
                                    </td>
                                </tr>`;
                }).join('');

                document.getElementById("statusPageInfo").textContent =
                    `Página ${currentPage.toLocaleString('es-MX')} de ${totalPages.toLocaleString('es-MX')} · ${totalItems.toLocaleString('es-MX')} registro(s)`;
                renderNumericPager();
                document.querySelector(".ccl .table-wrap").scrollTop = 0;
            } catch (err) {
                if (seq !== cargaSeq) return;
                tbody.innerHTML = filaMensaje(`${err.message} Recarga la página o inténtalo en un momento.`, true);
                document.getElementById("statusPageInfo").textContent = "Error al cargar";
            } finally {
                if (seq === cargaSeq) mostrarLoader(false);
            }
        }

        document.getElementById("btnDescargarExcel").addEventListener("click", function () {
            const search = document.getElementById("searchInput").value || "";
            window.location.href = `/Comercial/DescargarClientesExcel?search=${encodeURIComponent(search)}`;
        });

        /* ---------- Aplica presupuesto (se guarda al cambiar, igual que antes) ---------- */
        document.querySelector("#tablaClientes tbody").addEventListener("change", async function (e) {
            if (!e.target.classList.contains("chk-presupuesto")) return;

            const checkbox = e.target;
            const clienteId = checkbox.dataset.cliente;
            const valor = checkbox.checked ? 1 : 0;
            const estadoAnterior = !checkbox.checked; // para revertir si falla
            const tr = checkbox.closest("tr");

            checkbox.disabled = true;
            try {
                const res = await fetch('/Comercial/ActualizarAplicaPresupuesto', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ clienteId: clienteId, aplicaPresupuesto: valor })
                });
                if (!res.ok) {
                    const t = await res.text();
                    throw new Error(t || 'Error al actualizar presupuesto.');
                }
                const data = await res.json();
                if (!data.ok) throw new Error(data.error || 'No se pudo actualizar.');

                // Confirmación visual breve en la fila (antes no había ninguna).
                checkbox.title = valor ? 'Aplica presupuesto' : 'No aplica presupuesto';
                document.getElementById("statusPageInfo").textContent =
                    `Cliente ${clienteId}: ${valor ? 'ahora aplica presupuesto' : 'ya no aplica presupuesto'}.`;
                tr?.classList.add("is-saved");
                setTimeout(() => tr?.classList.remove("is-saved"), 1200);
            } catch (err) {
                checkbox.checked = estadoAnterior;
                alert(`No se pudo cambiar el presupuesto del cliente ${clienteId}.\n\n${err.message}`);
            } finally {
                checkbox.disabled = false;
            }
        });

        /* ---------- Sincronizar clientes ---------- */
        document.getElementById("btnSincronizar").addEventListener("click", async function () {
            const btn = this;
            btn.disabled = true;
            mostrarLoader(true, "Sincronizando clientes con SAP…");
            try {
                const res = await fetch('/Comercial/SincronizarClient');
                if (!res.ok) throw new Error('No se pudo sincronizar con SAP.');
                alert(await res.text());
                await cargarClientes(currentPage, currentSearch);
            } catch (err) {
                alert(err.message);
            } finally {
                mostrarLoader(false);
                btn.disabled = false;
            }
        });

        /* ---------- Búsqueda ---------- */
        const buscar = debounce(() => {
            currentSearch = document.getElementById("searchInput").value || "";
            currentPage = 1;
            cargarClientes(currentPage, currentSearch);
        }, 350);
        document.getElementById("searchInput").addEventListener("input", buscar);

        document.addEventListener("DOMContentLoaded", () => cargarClientes(currentPage, currentSearch));

        /* ---------- Sincronizar facturas de TODOS los clientes ---------- */
        const btnSyncTodas = document.getElementById('btnSyncTodas');
        if (btnSyncTodas) {
            btnSyncTodas.addEventListener('click', async () => {
                if (!confirm('¿Sincronizar las facturas de TODOS los clientes desde SAP?\n\nPuede tardar varios minutos.')) return;
                btnSyncTodas.disabled = true;
                mostrarLoader(true, "Sincronizando facturas…");
                try {
                    const res = await fetch('/Comercial/SyncFacturasTodas', { method: 'POST' });
                    if (!res.ok) {
                        const t = await res.text();
                        throw new Error(t || 'Error al sincronizar');
                    }
                    const data = await res.json(); // { ok, total, ts }
                    if (!data.ok) throw new Error(data.error || 'Error en sincronización');
                    alert(`Facturas sincronizadas.\n\nFacturas procesadas: ${data.total}\nHora: ${new Date(data.ts).toLocaleString('es-MX')}`);
                } catch (err) {
                    alert(`No se pudieron sincronizar las facturas.\n\n${err.message}`);
                } finally {
                    btnSyncTodas.disabled = false;
                    mostrarLoader(false);
                }
            });
        }

        /* ---------- Sincronizar direcciones de TODOS los clientes ---------- */
        const btnSyncDirecciones = document.getElementById('btnSyncDirecciones');
        if (btnSyncDirecciones) {
            btnSyncDirecciones.addEventListener('click', async () => {
                if (!confirm('¿Sincronizar las direcciones de TODOS los clientes desde SAP?')) return;
                btnSyncDirecciones.disabled = true;
                mostrarLoader(true, "Sincronizando direcciones…");
                try {
                    const res = await fetch('/Comercial/SincronizarDireccionesClientes', { method: 'POST' });
                    if (!res.ok) {
                        const t = await res.text();
                        throw new Error(t || 'Error al sincronizar direcciones');
                    }
                    const data = await res.json();
                    if (!data.ok) throw new Error(data.error || 'Error en sincronización');
                    alert(`Direcciones sincronizadas.\n\nRegistros procesados: ${data.procesadas}`);
                } catch (err) {
                    alert(`No se pudieron sincronizar las direcciones.\n\n${err.message}`);
                } finally {
                    btnSyncDirecciones.disabled = false;
                    mostrarLoader(false);
                }
            });
        }
    </script>
}
