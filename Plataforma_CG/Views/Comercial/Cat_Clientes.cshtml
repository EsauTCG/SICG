@model IEnumerable<Plataforma_CG.Models.ClienteSap>

@{
    ViewData["Title"] = "Catálogo de Clientes";
    Layout = "~/Views/Shared/_Layout2.cshtml";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">


<link rel="stylesheet" href="~/css/catalogo-clientes-sap-grid.css" asp-append-version="true" />

<style>
    /*
     * AJUSTE DE GRID - CATÁLOGO DE CLIENTES
     * La tabla utiliza todo el ancho disponible de la vista.
     * Los estilos están limitados a .catalogo-clientes-app
     * para no afectar otros módulos.
     */
    .catalogo-clientes-app,
    .catalogo-clientes-app .content,
    .catalogo-clientes-app .workspace,
    .catalogo-clientes-app .section,
    .catalogo-clientes-app .table-wrap {
        width: 100% !important;
        max-width: none !important;
        min-width: 0 !important;
        box-sizing: border-box !important;
    }

    .catalogo-clientes-app .content {
        display: block !important;
    }

    .catalogo-clientes-app .workspace {
        display: block !important;
        grid-template-columns: none !important;
    }

    .catalogo-clientes-app .section {
        display: flex !important;
        flex-direction: column !important;
    }

    .catalogo-clientes-app .table-wrap {
        flex: 1 1 auto !important;
        overflow-x: auto !important;
        overflow-y: auto !important;
    }

    .catalogo-clientes-app #tablaClientes {
        width: 100% !important;
        min-width: 100% !important;
        max-width: none !important;
        table-layout: fixed !important;
        margin: 0 !important;
    }

    .catalogo-clientes-app #tablaClientes th,
    .catalogo-clientes-app #tablaClientes td {
        box-sizing: border-box !important;
        vertical-align: middle !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        white-space: nowrap !important;
    }

    /*
     * Distribución proporcional de columnas.
     * Total = 100%.
     */
    .catalogo-clientes-app #tablaClientes th:nth-child(1),
    .catalogo-clientes-app #tablaClientes td:nth-child(1) {
        width: 8% !important;
    }

    .catalogo-clientes-app #tablaClientes th:nth-child(2),
    .catalogo-clientes-app #tablaClientes td:nth-child(2) {
        width: 23% !important;
    }

    .catalogo-clientes-app #tablaClientes th:nth-child(3),
    .catalogo-clientes-app #tablaClientes td:nth-child(3) {
        width: 14% !important;
    }

    .catalogo-clientes-app #tablaClientes th:nth-child(4),
    .catalogo-clientes-app #tablaClientes td:nth-child(4) {
        width: 12% !important;
    }

    .catalogo-clientes-app #tablaClientes th:nth-child(5),
    .catalogo-clientes-app #tablaClientes td:nth-child(5) {
        width: 14% !important;
    }

    .catalogo-clientes-app #tablaClientes th:nth-child(6),
    .catalogo-clientes-app #tablaClientes td:nth-child(6) {
        width: 8% !important;
    }

    .catalogo-clientes-app #tablaClientes th:nth-child(7),
    .catalogo-clientes-app #tablaClientes td:nth-child(7) {
        width: 14% !important;
    }

    .catalogo-clientes-app #tablaClientes th:nth-child(8),
    .catalogo-clientes-app #tablaClientes td:nth-child(8) {
        width: 7% !important;
        text-align: center !important;
    }

    /*
     * Toolbar:
     * el buscador ocupa todo el espacio sobrante
     * y los botones conservan su tamaño.
     */
    .catalogo-clientes-app .toolbar {
        width: 100% !important;
        display: flex !important;
        align-items: center !important;
        gap: 8px !important;
        box-sizing: border-box !important;
    }

    .catalogo-clientes-app .toolbar .group {
        flex: 1 1 auto !important;
        min-width: 220px !important;
    }

    .catalogo-clientes-app .toolbar .group input {
        width: 100% !important;
    }

    .catalogo-clientes-app .toolbar .tool-btn {
        flex: 0 0 auto !important;
        white-space: nowrap !important;
    }

    /* Pager ocupando todo el ancho de la sección */
    .catalogo-clientes-app .pager {
        width: 100% !important;
        box-sizing: border-box !important;
    }

    /*
     * En resoluciones menores se conserva la proporción
     * mediante scroll horizontal, sin aplastar columnas.
     */
    @@media (max-width: 1100px) {
        .catalogo-clientes-app #tablaClientes {
            min-width: 1100px !important;
        }

        .catalogo-clientes-app .toolbar {
            flex-wrap: wrap !important;
        }

        .catalogo-clientes-app .toolbar .group {
            flex: 1 1 100% !important;
        }
    }
</style>


<style id="catalogo-clientes-erp-tinto-final">
    .catalogo-clientes-app {
        --erp-bg: #eef2f4;
        --erp-head: #dce4e8;
        --erp-head-2: #d1dbe0;
        --erp-line: #bec9cf;
        --erp-line-soft: #d3dce1;
        --erp-text: #463d3f;
        --erp-muted: #74818a;
        --erp-row-alt: #f7f9fa;
        --erp-row-hover: #f5eaec;

        --erp-tinto: #7a2029;
        --erp-tinto-dark: #5e1820;
        --erp-tinto-soft: #f1e4e6;

        --erp-green: #25824d;
        --erp-green-dark: #1d6d40;

        width: 100% !important;
        max-width: none !important;
        min-width: 0 !important;

        margin: 0 !important;
        padding: 0 !important;

        background: var(--erp-bg) !important;
        border: 0 !important;
        border-radius: 0 !important;
        box-shadow: none !important;

        color: var(--erp-text) !important;
        font-family: "Poppins", sans-serif !important;
    }

    .catalogo-clientes-app,
    .catalogo-clientes-app * {
        box-sizing: border-box !important;
        font-family: "Poppins", sans-serif !important;
    }

    .catalogo-clientes-app .titlebar {
        display: none !important;
    }

    /* TOOLBAR */
    .catalogo-clientes-app .toolbar {
        width: 100% !important;

        display: grid !important;
        grid-template-columns:
            minmax(300px, 1fr)
            max-content
            max-content
            max-content
            max-content !important;

        align-items: end !important;
        gap: 7px !important;

        margin: 0 !important;
        padding: 9px 11px 10px !important;

        background:
            linear-gradient(
                180deg,
                #f4f7f8 0%,
                #e8edef 100%
            ) !important;

        border: 0 !important;
        border-bottom: 1px solid var(--erp-line) !important;
    }

    .catalogo-clientes-app .toolbar .group {
        width: 100% !important;
        min-width: 0 !important;
        margin: 0 !important;
    }

    .catalogo-clientes-app .toolbar .group::before {
        content: "Buscar";

        display: block !important;

        margin: 0 0 4px 1px !important;

        color: #5b5153 !important;

        font-size: 9.5px !important;
        line-height: 1 !important;
        font-weight: 600 !important;
    }

    .catalogo-clientes-app .toolbar label {
        display: none !important;
    }

    .catalogo-clientes-app #searchInput {
        width: 100% !important;
        height: 30px !important;
        min-height: 30px !important;

        padding: 0 9px !important;

        background: #fff !important;
        color: #4a4143 !important;

        border: 1px solid #b9c5cb !important;
        border-radius: 1px !important;

        box-shadow: inset 0 1px 2px rgba(0,0,0,.025) !important;
        outline: none !important;

        font-size: 10.5px !important;
        font-weight: 400 !important;
    }

    .catalogo-clientes-app #searchInput::placeholder {
        color: #919da4 !important;
    }

    .catalogo-clientes-app #searchInput:focus {
        border-color: #9e7479 !important;
        box-shadow: 0 0 0 1px rgba(122,32,41,.08) !important;
    }

    /* BOTONES */
    .catalogo-clientes-app .tool-btn {
        min-width: 0 !important;
        height: 30px !important;
        min-height: 30px !important;

        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;

        gap: 5px !important;

        padding: 0 9px !important;

        border-radius: 2px !important;
        border: 1px solid transparent !important;

        box-shadow: inset 0 1px 0 rgba(255,255,255,.12) !important;

        color: #fff !important;

        font-size: 9.5px !important;
        font-weight: 600 !important;
        line-height: 1 !important;

        white-space: nowrap !important;
    }

    .catalogo-clientes-app .tool-btn i {
        font-size: 10.5px !important;
    }

    .catalogo-clientes-app .tool-btn-success {
        background: var(--erp-green) !important;
        border-color: var(--erp-green-dark) !important;
    }

    .catalogo-clientes-app .tool-btn-success:hover {
        background: var(--erp-green-dark) !important;
    }

    .catalogo-clientes-app .tool-btn-primary,
    .catalogo-clientes-app .tool-btn-blue {
        background: var(--erp-tinto) !important;
        border-color: var(--erp-tinto-dark) !important;
    }

    .catalogo-clientes-app .tool-btn-primary:hover,
    .catalogo-clientes-app .tool-btn-blue:hover {
        background: var(--erp-tinto-dark) !important;
    }

    .catalogo-clientes-app .tool-btn-outline {
        background: #6d6265 !important;
        border-color: #5c5355 !important;
        color: #fff !important;
    }

    .catalogo-clientes-app .tool-btn-outline:hover {
        background: #5a5153 !important;
    }

    .catalogo-clientes-app #loader {
        grid-column: 1 / -1 !important;
        font-size: 9px !important;
        font-weight: 500 !important;
        color: #75686b !important;
    }

    /* CONTENIDO */
    .catalogo-clientes-app .content,
    .catalogo-clientes-app .workspace,
    .catalogo-clientes-app .section {
        width: 100% !important;
        max-width: none !important;
        min-width: 0 !important;

        margin: 0 !important;
        padding: 0 !important;

        background: var(--erp-bg) !important;
        border: 0 !important;
        box-shadow: none !important;
    }

    .catalogo-clientes-app .table-search-strip {
        width: 100% !important;

        min-height: 36px !important;

        display: flex !important;
        align-items: center !important;
        justify-content: flex-end !important;

        padding: 5px 11px !important;

        background:
            linear-gradient(
                180deg,
                #edf2f4 0%,
                #e4eaed 100%
            ) !important;

        border-bottom: 1px solid var(--erp-line) !important;
    }

    .catalogo-clientes-app .table-search-display {
        width: min(520px, 46vw) !important;
        height: 26px !important;

        display: flex !important;
        align-items: center !important;

        padding: 0 8px !important;

        background: rgba(255,255,255,.55) !important;

        border: 1px solid #c3cdd2 !important;

        color: #819099 !important;

        font-size: 9.5px !important;
        font-weight: 400 !important;
    }

    /* TABLA */
    .catalogo-clientes-app .table-wrap {
        width: 100% !important;

        min-height: 0 !important;
        height: auto !important;
        max-height: calc(100vh - 300px) !important;

        margin: 0 !important;
        padding: 0 !important;

        background: #fff !important;

        border: 0 !important;
        overflow: auto !important;
    }

    .catalogo-clientes-app #tablaClientes {
        width: 100% !important;
        min-width: 1100px !important;

        margin: 0 !important;

        table-layout: fixed !important;
        border-collapse: collapse !important;
        border-spacing: 0 !important;

        background: #fff !important;

        font-size: 9.7px !important;
        line-height: 1.05 !important;
    }

    .catalogo-clientes-app #tablaClientes thead {
        position: sticky !important;
        top: 0 !important;
        z-index: 20 !important;
    }

    .catalogo-clientes-app #tablaClientes thead tr,
    .catalogo-clientes-app #tablaClientes thead th {
        background:
            linear-gradient(
                180deg,
                var(--erp-head) 0%,
                var(--erp-head-2) 100%
            ) !important;

        color: #544a4c !important;
    }

    .catalogo-clientes-app #tablaClientes thead th {
        height: 31px !important;
        min-height: 31px !important;

        padding: 4px 6px !important;

        border: 1px solid var(--erp-line) !important;

        vertical-align: middle !important;

        font-size: 8.8px !important;
        line-height: 1.05 !important;
        font-weight: 600 !important;
        letter-spacing: .01em !important;
        text-transform: uppercase !important;

        white-space: nowrap !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;

        box-shadow: none !important;
    }

    .catalogo-clientes-app #tablaClientes thead th::after {
        content: "↕";
        margin-left: 3px;

        color: #87949c !important;

        font-size: 7.5px !important;
        font-weight: 400 !important;
    }

    .catalogo-clientes-app #tablaClientes tbody td {
        height: 27px !important;
        min-height: 27px !important;

        padding: 3px 6px !important;

        background: #fff !important;
        color: #463d3f !important;

        border: 1px solid var(--erp-line-soft) !important;

        vertical-align: middle !important;

        font-size: 9.7px !important;
        line-height: 1.05 !important;
        font-weight: 400 !important;

        white-space: nowrap !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
    }

    .catalogo-clientes-app #tablaClientes tbody tr:nth-child(even) td {
        background: var(--erp-row-alt) !important;
    }

    .catalogo-clientes-app #tablaClientes tbody tr:hover td {
        background: var(--erp-row-hover) !important;
    }

    .catalogo-clientes-app #tablaClientes th:nth-child(1),
    .catalogo-clientes-app #tablaClientes td:nth-child(1) { width: 9% !important; }

    .catalogo-clientes-app #tablaClientes th:nth-child(2),
    .catalogo-clientes-app #tablaClientes td:nth-child(2) { width: 24% !important; }

    .catalogo-clientes-app #tablaClientes th:nth-child(3),
    .catalogo-clientes-app #tablaClientes td:nth-child(3) { width: 14% !important; }

    .catalogo-clientes-app #tablaClientes th:nth-child(4),
    .catalogo-clientes-app #tablaClientes td:nth-child(4) { width: 12% !important; }

    .catalogo-clientes-app #tablaClientes th:nth-child(5),
    .catalogo-clientes-app #tablaClientes td:nth-child(5) { width: 14% !important; }

    .catalogo-clientes-app #tablaClientes th:nth-child(6),
    .catalogo-clientes-app #tablaClientes td:nth-child(6) {
        width: 8% !important;
        text-align: right !important;
    }

    .catalogo-clientes-app #tablaClientes th:nth-child(7),
    .catalogo-clientes-app #tablaClientes td:nth-child(7) { width: 13% !important; }

    .catalogo-clientes-app #tablaClientes th:nth-child(8),
    .catalogo-clientes-app #tablaClientes td:nth-child(8) {
        width: 6% !important;
        text-align: center !important;
    }

    .catalogo-clientes-app .chk-presupuesto {
        width: 14px !important;
        height: 14px !important;

        accent-color: var(--erp-tinto) !important;

        cursor: pointer !important;
    }

    /* PAGINACIÓN */
    .catalogo-clientes-app .pager {
        width: 100% !important;

        min-height: 42px !important;

        display: flex !important;
        align-items: center !important;
        justify-content: flex-end !important;

        gap: 0 !important;

        margin: 0 !important;
        padding: 6px 11px !important;

        background:
            linear-gradient(
                180deg,
                #edf2f4 0%,
                #e4eaed 100%
            ) !important;

        border: 0 !important;
        border-top: 1px solid #c2ccd2 !important;
    }

    .catalogo-clientes-app .pagination-numeric {
        display: flex !important;
        align-items: center !important;
        gap: 0 !important;
    }

    .catalogo-clientes-app .page-num-btn {
        min-width: 30px !important;
        height: 29px !important;

        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;

        margin-left: -1px !important;
        padding: 0 7px !important;

        background: #f7f9fa !important;
        color: #53636c !important;

        border: 1px solid #bdc8ce !important;
        border-radius: 0 !important;

        box-shadow: none !important;

        font-size: 9.5px !important;
        line-height: 1 !important;
        font-weight: 500 !important;

        cursor: pointer !important;
    }

    .catalogo-clientes-app .page-num-btn:hover:not(:disabled) {
        background: var(--erp-tinto-soft) !important;
        color: var(--erp-tinto-dark) !important;
    }

    .catalogo-clientes-app .page-num-btn.active {
        position: relative !important;
        z-index: 2 !important;

        background: var(--erp-tinto) !important;
        border-color: var(--erp-tinto) !important;
        color: #fff !important;
    }

    .catalogo-clientes-app .page-num-btn:disabled {
        opacity: .45 !important;
        cursor: default !important;
    }

    .catalogo-clientes-app .page-ellipsis {
        min-width: 30px !important;
        height: 29px !important;

        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;

        margin-left: -1px !important;

        background: #f3f6f7 !important;
        color: #7c8991 !important;

        border: 1px solid #bdc8ce !important;

        font-size: 9px !important;
    }

    /* STATUSBAR */
    .catalogo-clientes-app .statusbar {
        min-height: 25px !important;

        display: flex !important;
        align-items: center !important;
        justify-content: space-between !important;

        gap: 12px !important;

        padding: 4px 9px !important;

        background: #e1e8eb !important;
        color: #6d7b83 !important;

        border: 0 !important;
        border-top: 1px solid #bec9cf !important;

        font-size: 8.6px !important;
        line-height: 1 !important;
        font-weight: 400 !important;
    }

    @@media (max-width: 1150px) {
        .catalogo-clientes-app .toolbar {
            grid-template-columns:
                minmax(240px, 1fr)
                max-content
                max-content !important;
        }
    }

    @@media (max-width: 700px) {
        .catalogo-clientes-app .toolbar {
            grid-template-columns: 1fr 1fr !important;
        }

        .catalogo-clientes-app .toolbar .group {
            grid-column: 1 / -1 !important;
        }

        .catalogo-clientes-app .tool-btn {
            width: 100% !important;
        }

        .catalogo-clientes-app .table-search-display {
            width: 70vw !important;
        }

        .catalogo-clientes-app .pager {
            justify-content: center !important;
            overflow-x: auto !important;
        }

        .catalogo-clientes-app .statusbar {
            justify-content: flex-start !important;
            flex-wrap: wrap !important;
        }
    }
</style>


<style id="bootstrap-icons-font-fix">
    /* ===============================================================
       FIX BOOTSTRAP ICONS
       Poppins sólo para texto. Los .bi deben conservar bootstrap-icons.
       =============================================================== */

    .catalogo-clientes-app .bi,
    .catalogo-clientes-app .bi::before,
    .catalogo-clientes-app [class^="bi-"],
    .catalogo-clientes-app [class*=" bi-"] {
        font-family: "bootstrap-icons" !important;
        font-style: normal !important;
        font-weight: normal !important;
        font-variant: normal !important;
        text-transform: none !important;
        line-height: 1 !important;
        -webkit-font-smoothing: antialiased !important;
        -moz-osx-font-smoothing: grayscale !important;
    }

    /* El texto de los botones sí permanece en Poppins */
    .catalogo-clientes-app .tool-btn {
        font-family: "Poppins", sans-serif !important;
    }
</style>


<style id="catalogo-clientes-texto-marcado-final">
    /* ===============================================================
       TEXTO MÁS NÍTIDO Y MARCADO — COMO LA REFERENCIA
       Conserva Poppins, colores y distribución actual.
       =============================================================== */

    .catalogo-clientes-app {
        -webkit-font-smoothing: antialiased !important;
        -moz-osx-font-smoothing: grayscale !important;
        text-rendering: geometricPrecision !important;
    }

    /* Encabezados de tabla */
    .catalogo-clientes-app #tablaClientes thead th {
        color: #3f4549 !important;

        font-family: "Poppins", sans-serif !important;
        font-size: 9.4px !important;
        font-weight: 700 !important;
        line-height: 1.08 !important;
        letter-spacing: .01em !important;

        text-shadow: 0 0 .01px currentColor !important;

        border-color: #aebbc3 !important;
    }

    /* Texto general de filas */
    .catalogo-clientes-app #tablaClientes tbody td {
        color: #30373b !important;

        font-family: "Poppins", sans-serif !important;
        font-size: 10.2px !important;
        font-weight: 500 !important;
        line-height: 1.12 !important;

        text-shadow: 0 0 .01px currentColor !important;

        border-color: #c5d0d6 !important;
    }

    /* SKU / código de cliente un poco más marcado */
    .catalogo-clientes-app #tablaClientes tbody td:nth-child(1) {
        color: #2d3438 !important;
        font-weight: 600 !important;
    }

    /* Nombre del cliente */
    .catalogo-clientes-app #tablaClientes tbody td:nth-child(2) {
        color: #252d31 !important;
        font-weight: 500 !important;
    }

    /* Clasificación y canal */
    .catalogo-clientes-app #tablaClientes tbody td:nth-child(3),
    .catalogo-clientes-app #tablaClientes tbody td:nth-child(4) {
        color: #394246 !important;
        font-weight: 500 !important;
    }

    /* Vendedor */
    .catalogo-clientes-app #tablaClientes tbody td:nth-child(7) {
        color: #30383c !important;
        font-weight: 500 !important;
    }

    /* Zebra más visible pero neutra */
    .catalogo-clientes-app #tablaClientes tbody tr:nth-child(even) td {
        background: #f2f5f6 !important;
    }

    /* Hover muy ligero tinto */
    .catalogo-clientes-app #tablaClientes tbody tr:hover td {
        background: #f3e7e9 !important;
        color: #272d31 !important;
    }

    /* Buscador más legible */
    .catalogo-clientes-app #searchInput {
        color: #353b3f !important;
        font-size: 10.8px !important;
        font-weight: 500 !important;
    }

    .catalogo-clientes-app #searchInput::placeholder {
        color: #7d898f !important;
        font-weight: 400 !important;
        opacity: 1 !important;
    }

    .catalogo-clientes-app .toolbar .group::before {
        color: #454d51 !important;
        font-size: 9.8px !important;
        font-weight: 700 !important;
    }

    /* Botones más definidos */
    .catalogo-clientes-app .tool-btn {
        font-family: "Poppins", sans-serif !important;
        font-size: 9.8px !important;
        font-weight: 700 !important;
    }

    /* Mantener la fuente especial de Bootstrap Icons */
    .catalogo-clientes-app .bi,
    .catalogo-clientes-app .bi::before,
    .catalogo-clientes-app [class^="bi-"],
    .catalogo-clientes-app [class*=" bi-"] {
        font-family: "bootstrap-icons" !important;
        font-weight: normal !important;
    }

    /* Paginación más clara */
    .catalogo-clientes-app .page-num-btn {
        color: #424b50 !important;
        font-size: 9.8px !important;
        font-weight: 600 !important;
    }

    .catalogo-clientes-app .page-num-btn.active {
        color: #fff !important;
        font-weight: 700 !important;
    }

    /* Barra inferior */
    .catalogo-clientes-app .statusbar {
        color: #59666d !important;
        font-size: 9px !important;
        font-weight: 500 !important;
    }
</style>

<div class="window catalogo-clientes-app">
    <div class="titlebar">
        <div>Catálogo de Clientes</div>
        <div class="actions">
            <div class="win-btn"></div>
            <div class="win-btn"></div>
            <div class="win-btn"></div>
        </div>
    </div>

    <div class="toolbar">
        <div class="group">
            <label for="searchInput"></label>
            <input type="text" id="searchInput" class="form-control"
                   placeholder="Buscar código, nombre, vendedor…" />
        </div>

        <button id="btnDescargarExcel" class="tool-btn tool-btn-success">
            <i class="bi bi-file-earmark-excel-fill"></i> Excel
        </button>

        <button id="btnSincronizar" class="tool-btn tool-btn-primary">
            <i class="bi bi-cloud-arrow-down-fill"></i> Sincronizar
        </button>

        <button id="btnSyncDirecciones" class="tool-btn tool-btn-blue">
            <i class="bi bi-geo-alt-fill"></i> Direcciones
        </button>

        <button id="btnSyncTodas" class="tool-btn tool-btn-outline" title="Sincronizar facturas de todos los clientes">
            <i class="bi bi-receipt-cutoff"></i> Facturas
        </button>

        <span id="loader" style="display:none;">⏳ Sincronizando…</span>
    </div>

    <div class="content">
      

        <div class="workspace">
            <div class="section">
              @*   <div class="section-title">
                    Resultados
                    <span class="status-chip">Fuente: SAP</span>
                </div> *@

                <div class="table-search-strip">
                    <div class="table-search-display">Buscar aquí</div>
                </div>

                <div class="table-wrap">
                    <table id="tablaClientes" class="table table-bordered table-hover mb-0">
                        <colgroup>
                            <col style="width:8%">
                            <col style="width:23%">
                            <col style="width:14%">
                            <col style="width:12%">
                            <col style="width:14%">
                            <col style="width:8%">
                            <col style="width:14%">
                            <col style="width:7%">
                        </colgroup>
                        <thead>
                            <tr>
                                <th>Clienteid</th>
                                <th>Cliente</th>
                                <th>Clasificación</th>
                                <th>Canal</th>                                
                                <th>Lista Precio</th>
                                <th>Id Vendedor</th>
                                <th>Vendedor</th>       
                                <th>Presupuesto</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>

                <div class="pager">
                    <div id="numericPager" class="pagination-numeric"></div>
                </div>
            </div>
        </div>
    </div>

    <div class="statusbar">
        <div id="statusPageInfo">Registro listo</div>
        <div>Usuario: @User.Identity.Name</div>
        <div>Empresa: Carnes G SA de CV</div>
        <div>Módulo: Catálogo de Clientes</div>
    </div>
</div>

@section Scripts {
    <script>
        let currentPage = 1;
        let pageSize = 50;
        let currentSearch = "";
        let totalItems = 0;
        let totalPages = 0;

        // Debounce para el buscador
        function debounce(fn, ms=350){
            let t; return (...a)=>{ clearTimeout(t); t=setTimeout(()=>fn(...a), ms); };
        }


        function renderNumericPager() {
            const host = document.getElementById("numericPager");
            if (!host) return;

            host.innerHTML = "";

            const total = Math.max(1, Number(totalPages || 1));
            const actual = Math.max(1, Math.min(Number(currentPage || 1), total));

            function addButton(label, page, options = {}) {
                const btn = document.createElement("button");

                btn.type = "button";
                btn.className = "page-num-btn";
                btn.textContent = label;

                if (options.active) {
                    btn.classList.add("active");
                }

                if (options.disabled) {
                    btn.disabled = true;
                }

                if (!options.disabled && !options.active) {
                    btn.addEventListener("click", () => {
                        currentPage = page;
                        cargarClientes(currentPage, currentSearch);
                    });
                }

                host.appendChild(btn);
            }

            function addEllipsis() {
                const span = document.createElement("span");
                span.className = "page-ellipsis";
                span.textContent = "…";
                host.appendChild(span);
            }

            addButton("‹", actual - 1, {
                disabled: actual <= 1
            });

            let pages = [];

            if (total <= 9) {
                pages = Array.from(
                    { length: total },
                    (_, i) => i + 1
                );
            }
            else {
                const start = Math.max(2, actual - 3);
                const end = Math.min(total - 1, actual + 3);

                pages.push(1);

                if (start > 2) {
                    pages.push("...");
                }

                for (let p = start; p <= end; p++) {
                    pages.push(p);
                }

                if (end < total - 1) {
                    pages.push("...");
                }

                pages.push(total);
            }

            pages.forEach(p => {
                if (p === "...") {
                    addEllipsis();
                    return;
                }

                addButton(
                    String(p),
                    p,
                    {
                        active: p === actual
                    }
                );
            });

            addButton("›", actual + 1, {
                disabled: actual >= total
            });
        }


        async function cargarClientes(page = 1, search = "") {
            const tbody = document.querySelector("#tablaClientes tbody");
            tbody.innerHTML = `<tr><td colspan="8" class="text-center py-4">⏳ Cargando...</td></tr>`;
            document.getElementById("loader").style.display = "inline";

            // Deshabilita navegación mientras carga


            try {
                const res = await fetch(`/Comercial/GetClientesJsonPaged?page=${page}&pageSize=${pageSize}&search=${encodeURIComponent(search)}`);
                if (!res.ok) throw new Error("Error al cargar clientes");

                const data = await res.json();
                tbody.innerHTML = "";

                const rows = Array.isArray(data.clientes) ? data.clientes : [];
                totalItems = Number(data.total || 0);
                totalPages = Math.max(1, Math.ceil((data.total || 0) / (data.pageSize || pageSize)));

                if (rows.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="8" class="text-center text-warning py-4">No hay clientes para mostrar.</td></tr>`;
                    document.getElementById("statusPageInfo").textContent = "Sin resultados";
                    renderNumericPager();
                    return;
                }

                rows.forEach(cliente => {
                    const tr = document.createElement("tr");
                    tr.dataset.codigo = cliente.cliente;
                    const aplicaPresupuesto = Number(cliente.aplicaPresupuesto ?? 1);

                    tr.innerHTML = `
            <td>${cliente.cliente ?? "—"}</td>
            <td>${cliente.nombrecliente ?? "—"}</td>
            <td>${cliente.u_MT_Clasificacion ?? "—"}</td>
            <td>${cliente.u_CANAL ?? "—"}</td>
            <td>${cliente.priceListName ?? "—"}</td>
            <td class="num">${cliente.vendedorId ?? "—"}</td>
            <td title="${cliente.vendedorNombre ?? "—"}">${cliente.vendedorNombre ?? "—"}</td>
            <td class="text-center">
                <input type="checkbox"
                       class="chk-presupuesto"
                       data-cliente="${cliente.cliente ?? ""}"
                       ${aplicaPresupuesto === 1 ? "checked" : ""} />
            </td>
        `;
                    tbody.appendChild(tr);
                });

                // Info de página
                currentPage = Number(data.page || page);
                pageSize = Number(data.pageSize || pageSize);
                document.getElementById("statusPageInfo").textContent =
                    `Página ${currentPage} de ${totalPages} · Registros: ${totalItems.toLocaleString('es-MX')}`;
                renderNumericPager();

                // Habilita/Deshabilita botones


            } catch (err) {
                tbody.innerHTML = `<tr><td colspan="8" class="text-center text-danger py-4">Error: ${err.message}</td></tr>`;
                document.getElementById("statusPageInfo").textContent = "Error";
            } finally {
                document.getElementById("loader").style.display = "none";
            }
        }


            document.getElementById("btnDescargarExcel").addEventListener("click", function () {
            const search = document.getElementById("searchInput").value || "";
            const url = `/Comercial/DescargarClientesExcel?search=${encodeURIComponent(search)}`;
            window.location.href = url;
        });

        document.querySelector("#tablaClientes tbody").addEventListener("change", async function (e) {
            if (!e.target.classList.contains("chk-presupuesto")) return;

            const checkbox = e.target;
            const clienteId = checkbox.dataset.cliente;
            const valor = checkbox.checked ? 1 : 0;
            const estadoAnterior = !checkbox.checked; // para revertir si falla

            checkbox.disabled = true;

            try {
                const res = await fetch('/Comercial/ActualizarAplicaPresupuesto', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        clienteId: clienteId,
                        aplicaPresupuesto: valor
                    })
                });

                if (!res.ok) {
                    const txt = await res.text();
                    throw new Error(txt || 'Error al actualizar presupuesto.');
                }

                const data = await res.json();

                if (!data.ok) {
                    throw new Error(data.error || 'No se pudo actualizar.');
                }

            } catch (err) {
                checkbox.checked = estadoAnterior;
                alert(`❌ ${err.message}`);
            } finally {
                checkbox.disabled = false;
            }
        });

        // Sincronizar
        document.getElementById("btnSincronizar").addEventListener("click", async function () {
            const loader = document.getElementById("loader");
            loader.style.display = "inline";
            this.disabled = true;

            try {
                const res = await fetch('/Comercial/SincronizarClient');
                if (!res.ok) throw new Error('Error al sincronizar');

                const data = await res.text();
                alert(data);
                await cargarClientes(currentPage, currentSearch);
            } catch (err) {
                alert(err.message);
            } finally {
                loader.style.display = "none";
                this.disabled = false;
            }
        });

        // Buscador con debounce
        const buscar = debounce(() => {
            currentSearch = document.getElementById("searchInput").value || "";
            currentPage = 1;
            cargarClientes(currentPage, currentSearch);
        }, 350);
        document.getElementById("searchInput").addEventListener("input", function () {
            const mirror =
                document.querySelector(
                    ".catalogo-clientes-app .table-search-display"
                );

            if (mirror) {
                mirror.textContent =
                    this.value.trim() ||
                    "Buscar aquí";
            }

            buscar();
        });



        document.addEventListener("DOMContentLoaded", () => cargarClientes(currentPage, currentSearch));

        // Sincronizar facturas de TODOS los clientes
        const btnSyncTodas = document.getElementById('btnSyncTodas');
        if (btnSyncTodas){
          btnSyncTodas.addEventListener('click', async () => {
            if(!confirm('¿Sincronizar facturas de TODOS los clientes?')) return;

            const prev = btnSyncTodas.innerHTML;
            btnSyncTodas.disabled = true;
            btnSyncTodas.innerHTML = `<span class="spinner-border spinner-border-sm me-1"></span> Sincronizando...`;

            try{
              const res = await fetch('/Comercial/SyncFacturasTodas', { method:'POST' });
              if(!res.ok){
                const txt = await res.text();
                throw new Error(txt || 'Error al sincronizar');
              }
              const data = await res.json(); // { ok, total, ts }
              if(!data.ok) throw new Error(data.error || 'Error en sincronización');

              alert(`✅ Sincronización completada.\nFacturas procesadas: ${data.total}\nHora: ${new Date(data.ts).toLocaleString('es-MX')}`);
            }catch(err){
              alert(`❌ ${err.message}`);
            }finally{
              btnSyncTodas.disabled = false;
              btnSyncTodas.innerHTML = prev;
            }
          });
        }

              // 🔹 NUEVO: Sincronizar direcciones desde SAP
        const btnSyncDirecciones = document.getElementById('btnSyncDirecciones');

        if (btnSyncDirecciones) {
            btnSyncDirecciones.addEventListener('click', async () => {

                if (!confirm('¿Deseas sincronizar las direcciones de TODOS los clientes desde SAP?'))
                    return;

                const prevText = btnSyncDirecciones.innerHTML;
                btnSyncDirecciones.disabled = true;
                btnSyncDirecciones.innerHTML =
                    `<span class="spinner-border spinner-border-sm me-1"></span> Sincronizando...`;

                try {
                    const res = await fetch('/Comercial/SincronizarDireccionesClientes', {
                        method: 'POST'
                    });

                    if (!res.ok) {
                        const txt = await res.text();
                        throw new Error(txt || 'Error al sincronizar direcciones');
                    }

                    const data = await res.json();
                    if (!data.ok)
                        throw new Error(data.error || 'Error en sincronización');

                    alert(`✅ Direcciones sincronizadas correctamente.\nRegistros procesados: ${data.procesadas}`);

                } catch (err) {
                    alert(`❌ ${err.message}`);
                } finally {
                    btnSyncDirecciones.disabled = false;
                    btnSyncDirecciones.innerHTML = prevText;
                }
            });
        }
    </script>
}
