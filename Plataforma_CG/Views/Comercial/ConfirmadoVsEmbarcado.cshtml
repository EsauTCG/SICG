@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewBag.Title = "Confirmado Vs Embarcado";
}

<style>
    :root {
        --bg: #f0dede;
        --panel: #f8eeee;
        --line: #c79d9d;
        --line-dark: #8f4c4c;
        --text: #3b1717;
        --brand: #8B0000;
        --brand-dark: #5c0000;
        --brand-mid: #8b0000;
        --brand-light: #b30000;
        --shadow: 0 1px 0 rgba(255,255,255,.55) inset;
    }

    body {
        font-family: Tahoma, Verdana, Arial, sans-serif;
        background: transparent !important;
    }

    .window {
        width: 100%;
        border: 1px solid #7e4a4a;
        background: var(--panel);
        box-shadow: 0 0 0 1px rgba(255,255,255,.45) inset, 0 8px 18px rgba(70,12,12,.14);
        overflow: hidden;
    }

    .titlebar {
        height: 36px;
        /* display: flex; */
        display: none !important;
        align-items: center;
        justify-content: space-between;
        padding: 0 12px;
        background: linear-gradient(180deg,#c00000 0%,#8b0000 60%,#5c0000 100%);
        border-bottom: 1px solid #5c0000;
        color: #fff;
        font-size: 14px;
        font-weight: bold;
    }

    .actions {
        display: flex;
        gap: 6px;
    }

    .win-btn {
        width: 16px;
        height: 16px;
        border: 1px solid #7c4848;
        background: linear-gradient(#fff6f6,#ead0d0);
    }

    .content {
        padding: 12px 14px;
        background: var(--bg);
    }

    .section {
        border: 1px solid var(--line);
        background: #fff;
        margin-bottom: 14px;
    }

    .section-title {
        padding: 8px 10px;
        font-size: 13px;
        font-weight: bold;
        color: #fff;
        background: linear-gradient(180deg,#b30000 0%,#8b0000 55%,#5c0000 100%);
        border-bottom: 1px solid #6b1f1f;
    }

    .section-body {
        padding: 12px;
        background: #fffafa;
    }

    .filters {
        display: grid;
        grid-template-columns: 1.5fr 1fr 170px 1fr 1fr 180px auto;
        gap: 12px;
        align-items: end;
    }

    .form-label {
        display: block;
        color: #5c1a1a;
        font-size: 13px;
        margin-bottom: 5px;
        font-weight: bold;
    }

    .form-control, .form-select {
        border: 1px solid #b48787 !important;
        background: #fffdfd !important;
        color: #421414 !important;
        border-radius: 0 !important;
        box-shadow: none !important;
        font-size: 13px !important;
        height: 36px !important;
    }

        .form-control:focus, .form-select:focus {
            border-color: #8b0000 !important;
            box-shadow: 0 0 0 .18rem rgba(139,0,0,.14) !important;
        }

    /* Multiselect tipo estatus */
    .cg-multiselect {
        position: relative;
        width: 100%;
    }

    .cg-ms-button {
        width: 100%;
        height: 36px;
        border: 1px solid #b48787;
        background: #fffdfd;
        color: #421414;
        border-radius: 0;
        padding: 0 8px;
        font-size: 13px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        cursor: pointer;
        box-shadow: none;
    }

    .cg-ms-arrow {
        color: #8b0000;
        margin-left: 8px;
        font-size: 12px;
    }

    .cg-ms-panel {
        display: none;
        position: absolute;
        top: 38px;
        left: 0;
        width: 230px;
        max-width: 92vw;
        background: #fffafa;
        border: 1px solid #c79d9d;
        box-shadow: 0 4px 10px rgba(70,12,12,.25);
        z-index: 9999;
        padding: 8px;
    }

    .cg-multiselect.open .cg-ms-panel {
        display: block;
    }

    .cg-ms-search {
        width: 100%;
        height: 30px !important;
        border: 1px solid #c79d9d !important;
        background: #fff !important;
        color: #421414 !important;
        padding: 4px 8px !important;
        font-size: 12px !important;
        margin-bottom: 8px;
    }

    .cg-ms-options {
        max-height: 220px;
        overflow-y: auto;
    }

    .cg-ms-item {
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 6px 4px;
        margin: 0;
        color: #4b1f1f;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        user-select: none;
    }

    .cg-ms-item:hover {
        background: #f4dddd;
    }

    .cg-ms-item input {
        width: 15px;
        height: 15px;
        accent-color: #8b0000;
        cursor: pointer;
    }

    .cg-ms-empty {
        padding: 6px 4px;
        color: #7a4b4b;
        font-size: 12px;
    }

    .btn-main {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .45rem;
        height: 36px;
        padding: 0 14px;
        font-weight: 700;
        border-radius: 0;
        font-size: 13px;
        border: 1px solid #7a2d2d;
        color: #fff;
        background: linear-gradient(180deg,#b30000 0%,#8b0000 55%,#5c0000 100%);
        cursor: pointer;
    }

    .btn-light {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .45rem;
        height: 36px;
        padding: 0 14px;
        font-weight: 700;
        border-radius: 0;
        font-size: 13px;
        border: 1px solid #b48787;
        color: #4b1f1f;
        background: linear-gradient(#fffefe,#ecd7d7);
        cursor: pointer;
    }

    .btn-excel {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .45rem;
        height: 36px;
        padding: 0 14px;
        font-weight: 700;
        border-radius: 0;
        font-size: 13px;
        border: 1px solid #146c43;
        color: #fff;
        background: linear-gradient(180deg,#198754 0%, #146c43 100%);
        cursor: pointer;
    }

    .kpis {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        width: 100%;
    }

    .kpi-card {
        min-width: 170px;
        border: 1px solid #d8bcbc;
        background: linear-gradient(#fffefe,#f3e4e4);
        box-shadow: inset 0 1px 0 rgba(255,255,255,.7);
        padding: 10px 12px;
        text-align: center;
    }

    .kpi-title {
        font-size: 12px;
        color: #7a0000;
        font-weight: 700;
        margin-bottom: 4px;
        text-transform: uppercase;
        text-align: center;
    }

    .kpi-value {
        font-size: 18px;
        font-weight: 700;
        color: #401515;
        font-variant-numeric: tabular-nums;
        text-align: center;
    }

    .table-card {
        background: var(--panel);
        border: 1px solid var(--line);
        overflow: hidden;
    }

    .table-responsive-sticky {
        max-height: 84vh;
        overflow: auto;
        border-top: 1px solid #d9b8b8;
        background: #fffafa;
    }

    #tbl-surtidos {
        width: 100%;
        min-width: 1400px;
        table-layout: fixed;
        border-collapse: separate;
        border-spacing: 0;
        font-size: 13px !important;
        margin-bottom: 0;
        background: #fffafa;
    }

        /* ── SORTABLE HEADERS ── */
        #tbl-surtidos thead th {
            position: sticky;
            top: -1px;
            z-index: 20;
            background: linear-gradient(180deg,#b30000 0%,#8b0000 55%,#5c0000 100%) !important;
            color: #fff !important;
            border-top: 1px solid #c46a6a !important;
            border-right: 1px solid #8e3b3b !important;
            border-bottom: 1px solid #5c0000 !important;
            padding: 0 !important;
            font-weight: 700 !important;
            font-size: 13px !important;
            white-space: nowrap;
        }

    /* Wrapper inside every <th> */
    .th-inner {
        display: flex;
        align-items: center;
        justify-content: flex-start;
        gap: 4px;
        padding: 8px 6px;
        user-select: none;
        cursor: default;
    }

        .th-inner.sortable {
            cursor: pointer;
        }

            .th-inner.sortable:hover {
                background: rgba(255,255,255,0.10);
            }

    /* Sort arrow */
    .sort-arrow {
        display: inline-flex;
        flex-direction: column;
        gap: 1px;
        flex-shrink: 0;
        opacity: 0.45;
        transition: opacity 0.15s;
    }

        .sort-arrow .arr-up,
        .sort-arrow .arr-dn {
            width: 0;
            height: 0;
            border-left: 4px solid transparent;
            border-right: 4px solid transparent;
        }

        .sort-arrow .arr-up {
            border-bottom: 5px solid #fff;
        }

        .sort-arrow .arr-dn {
            border-top: 5px solid #fff;
        }

    /* Active state */
    th.sort-asc .sort-arrow,
    th.sort-desc .sort-arrow {
        opacity: 1;
    }

        th.sort-asc .sort-arrow .arr-dn {
            opacity: 0.3;
        }

        th.sort-desc .sort-arrow .arr-up {
            opacity: 0.3;
        }

    /* Text-end headers */
    #tbl-surtidos thead th.text-end .th-inner {
        justify-content: flex-end;
    }

    #tbl-surtidos thead th.text-center .th-inner {
        justify-content: center;
        cursor: default;
    }

    /* ── GOLD COLUMNS ── */
    #tbl-surtidos thead th:nth-child(9),
    #tbl-surtidos thead th:nth-child(10),
    #tbl-surtidos thead th:nth-child(11),
    #tbl-surtidos thead th:nth-child(12) {
        background: linear-gradient(180deg,#dcb000 0%,#c79c00 55%,#a88000 100%) !important;
        color: #fff !important;
        border-right: 1px solid #916f00 !important;
        border-bottom: 1px solid #7b5f00 !important;
        border-top: 1px solid #e7c84e !important;
    }

        #tbl-surtidos thead th:nth-child(9) .sort-arrow .arr-up,
        #tbl-surtidos thead th:nth-child(9) .sort-arrow .arr-dn,
        #tbl-surtidos thead th:nth-child(10) .sort-arrow .arr-up,
        #tbl-surtidos thead th:nth-child(10) .sort-arrow .arr-dn,
        #tbl-surtidos thead th:nth-child(11) .sort-arrow .arr-up,
        #tbl-surtidos thead th:nth-child(11) .sort-arrow .arr-dn,
        #tbl-surtidos thead th:nth-child(12) .sort-arrow .arr-up,
        #tbl-surtidos thead th:nth-child(12) .sort-arrow .arr-dn {
            border-bottom-color: #fff;
            border-top-color: #fff;
        }

    /* ── BODY CELLS ── */
    #tbl-surtidos tbody td {
        background: #fffafa !important;
        border-right: 1px solid #d8bcbc !important;
        border-bottom: 1px solid #d8bcbc !important;
        padding: 8px 6px !important;
        color: #111 !important;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        vertical-align: middle;
    }

    #tbl-surtidos tbody tr:nth-of-type(even) > * {
        background-color: #f9eded !important;
    }

    #tbl-surtidos tbody tr:hover > * {
        background: #f4dddd !important;
    }

    #tbl-surtidos tbody tr.is-open > * {
        background: #f4dddd !important;
    }

    /* column widths */
    #tbl-surtidos th:nth-child(1), #tbl-surtidos td:nth-child(1) { width: 38px; }
    #tbl-surtidos th:nth-child(2), #tbl-surtidos td:nth-child(2) { width: 60px; }
    #tbl-surtidos th:nth-child(3), #tbl-surtidos td:nth-child(3) { width: 85px; }
    #tbl-surtidos th:nth-child(4), #tbl-surtidos td:nth-child(4) { width: 120px; }
    #tbl-surtidos th:nth-child(5), #tbl-surtidos td:nth-child(5) { width: 260px; }
    #tbl-surtidos th:nth-child(6), #tbl-surtidos td:nth-child(6) { width: 115px; }
    #tbl-surtidos th:nth-child(7), #tbl-surtidos td:nth-child(7) { width: 100px; }
    #tbl-surtidos th:nth-child(8), #tbl-surtidos td:nth-child(8) { width: 105px; }
    #tbl-surtidos th:nth-child(9), #tbl-surtidos td:nth-child(9) { width: 100px; }
    #tbl-surtidos th:nth-child(10), #tbl-surtidos td:nth-child(10) { width: 105px; }
    #tbl-surtidos th:nth-child(11), #tbl-surtidos td:nth-child(11) { width: 90px; }
    #tbl-surtidos th:nth-child(12), #tbl-surtidos td:nth-child(12) { width: 90px; }

    /* gold body cells */
    #tbl-surtidos thead th:nth-child(9),
    #tbl-surtidos tbody td:nth-child(9),
    #tbl-surtidos thead th:nth-child(10),
    #tbl-surtidos tbody td:nth-child(10) {
        background-color: #fff4cc !important;
        color: #401515 !important;
    }

    .text-end {
        text-align: right !important;
        font-variant-numeric: tabular-nums;
    }

    .text-center {
        text-align: center !important;
    }

    .toggle-btn {
        width: 24px;
        height: 24px;
        border-radius: 0;
        padding: 0;
        border: 1px solid #b48787;
        background: linear-gradient(#fffefe,#ecd7d7);
        color: #6b1f1f;
        font-weight: 700;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    tr.detail-row td {
        background: #f7eaea !important;
        padding: .60rem .70rem !important;
        border-bottom: 1px solid #d8bcbc;
    }

    .detail-box {
        border: 1px solid #d8bcbc;
        border-left: 4px solid #8b0000;
        background: #fffafa;
        overflow: hidden;
    }

    .detail-head {
        padding: 8px 10px;
        font-size: 13px;
        font-weight: bold;
        color: #fff;
        background: linear-gradient(180deg,#b30000 0%,#8b0000 55%,#5c0000 100%);
        border-bottom: 1px solid #6b1f1f;
    }

    .detail-table-wrap {
        overflow: auto;
        background: #fffafa;
    }

    .detail-table {
        width: 100%;
        min-width: 960px;
        border-collapse: separate;
        border-spacing: 0;
        font-size: 13px;
        margin: 0;
    }

        .detail-table th {
            position: sticky;
            top: 0;
            z-index: 1;
            background: linear-gradient(180deg,#b30000 0%,#8b0000 55%,#5c0000 100%);
            color: #fff;
            border-bottom: 1px solid #5c0000;
            border-right: 1px solid #8e3b3b;
            padding: 8px 6px;
            white-space: nowrap;
            font-size: 13px;
        }

        .detail-table td {
            background: #fffafa;
            border-bottom: 1px solid #d8bcbc;
            border-right: 1px solid #d8bcbc;
            padding: 8px 6px;
            white-space: nowrap;
            color: #111;
        }

            .detail-table th:first-child,
            .detail-table td:first-child {
                border-left: 1px solid #d8bcbc;
            }

            .detail-table th:nth-child(2),
            .detail-table td:nth-child(2) {
                width: 340px !important;
                min-width: 340px !important;
                max-width: 340px !important;
            }

    .td-wrap {
        white-space: normal !important;
        word-break: break-word !important;
        line-height: 1.15;
    }

    .detail-table th:nth-child(8) {
        background: linear-gradient(180deg,#b30000 0%,#8b0000 55%,#5c0000 100%) !important;
        color: #fff !important;
        border-right: 1px solid #8e3b3b !important;
        border-bottom: 1px solid #5c0000 !important;
        border-top: 1px solid #c46a6a !important;
    }

    .detail-table tbody td:nth-child(8) {
        background: #fffafa !important;
        color: #111 !important;
        font-weight: 400 !important;
    }

    .detail-table tbody tr:nth-of-type(even) td:nth-child(8) {
        background: #f9eded !important;
    }

    .statusbar {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 8px 10px;
        font-size: 12px;
        color: #4a1a1a;
        border-top: 1px solid #b88c8c;
        background: linear-gradient(#f6e9e9,#ead5d5);
        flex-wrap: wrap;
    }

    /* GAP colors */
    .gap-ok {
        background: #198754 !important;
        color: #fff !important;
        font-weight: 700 !important;
    }

    .gap-warn {
        background: #ffc107 !important;
        color: #111 !important;
        font-weight: 700 !important;
    }

    .gap-bad {
        background: #dc3545 !important;
        color: #fff !important;
        font-weight: 700 !important;
    }

    .gap-empty {
        background: transparent !important;
        color: #401515 !important;
        font-weight: 700 !important;
    }

    #tbl-surtidos tbody td.gap-ok, .detail-table td.gap-ok, .kpi-value.gap-ok {
        background: #198754 !important;
        color: #fff !important;
        font-weight: 700 !important;
    }

    #tbl-surtidos tbody td.gap-warn, .detail-table td.gap-warn, .kpi-value.gap-warn {
        background: #ffc107 !important;
        color: #111 !important;
        font-weight: 700 !important;
    }

    #tbl-surtidos tbody td.gap-bad, .detail-table td.gap-bad, .kpi-value.gap-bad {
        background: #dc3545 !important;
        color: #fff !important;
        font-weight: 700 !important;
    }

    #tbl-surtidos tbody td.gap-empty, .detail-table td.gap-empty, .kpi-value.gap-empty {
        background: transparent !important;
        color: #401515 !important;
        font-weight: 700 !important;
    }

    @@media (max-width: 992px) {
        .filters {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media (max-width: 768px) {
        .filters {
            grid-template-columns: 1fr;
        }

        #tbl-surtidos {
            min-width: 1380px !important;
        }
    }

    /* COMPACTAR LETRA - Confirmado Vs Embarcado */
    body {
        font-size: 12px !important;
    }

    .section-title {
        font-size: 12px !important;
        padding: 6px 8px !important;
    }

    .section-body {
        padding: 8px !important;
    }

    .form-label {
        font-size: 11px !important;
    }

    .form-control,
    .form-select {
        font-size: 12px !important;
        height: 30px !important;
    }

    .cg-ms-button {
        height: 30px !important;
        font-size: 12px !important;
    }

    .cg-ms-panel {
        top: 32px !important;
    }

    .btn-main,
    .btn-excel,
    .btn-light {
        font-size: 12px !important;
        height: 30px !important;
        padding: 0 10px !important;
    }

    .kpi-card {
        min-width: 145px !important;
        padding: 7px 9px !important;
    }

    .kpi-title {
        font-size: 10px !important;
    }

    .kpi-value {
        font-size: 15px !important;
    }

    #tbl-surtidos {
        font-size: 11px !important;
    }

        #tbl-surtidos thead th,
        #tbl-surtidos tbody td {
            font-size: 11px !important;
            padding: 5px 4px !important;
        }

    .th-inner {
        padding: 5px 4px !important;
    }

    .detail-head {
        font-size: 12px !important;
        padding: 6px 8px !important;
    }

    .detail-table {
        font-size: 11px !important;
    }

        .detail-table th,
        .detail-table td {
            font-size: 11px !important;
            padding: 5px 4px !important;
        }

    .statusbar {
        font-size: 11px !important;
        padding: 6px 8px !important;
    }


    /* =========================================================
       KPIS A COLOR - Confirmado Vs Embarcado
       ========================================================= */

    .kpi-card.kpi-colored {
        position: relative;
        overflow: hidden;
        min-height: 86px !important;
        border-radius: 16px !important;
        border: 1px solid rgba(255,255,255,.32) !important;
        box-shadow: inset 5px 0 0 rgba(255,255,255,.18), 0 12px 26px rgba(45,8,8,.16) !important;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .kpi-card.kpi-colored::after {
        content: "";
        position: absolute;
        right: -34px;
        bottom: -42px;
        width: 118px;
        height: 118px;
        border-radius: 999px;
        background: rgba(255,255,255,.15);
        pointer-events: none;
    }

    .kpi-card.kpi-colored::before {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(255,255,255,.12), transparent 52%);
        pointer-events: none;
    }

    .kpi-card.kpi-colored .kpi-title,
    .kpi-card.kpi-colored .kpi-value {
        position: relative;
        z-index: 1;
    }

    .kpi-card.kpi-colored .kpi-title {
        color: rgba(255,255,255,.90) !important;
        letter-spacing: .06em;
        text-shadow: 0 1px 4px rgba(0,0,0,.16);
    }

    .kpi-card.kpi-colored .kpi-value {
        color: #fff !important;
        font-size: clamp(17px, 1.35vw, 24px) !important;
        font-weight: 900 !important;
        text-shadow: 0 2px 9px rgba(0,0,0,.24);
        background: transparent !important;
        padding: 0 !important;
    }

    .kpi-kg-pedidos {
        background: linear-gradient(135deg, #5c090b 0%, #9f1116 56%, #6b0d10 100%) !important;
    }

    .kpi-cajas-pedidas {
        background: linear-gradient(135deg, #7c2d12 0%, #ea580c 56%, #9a3412 100%) !important;
    }

    .kpi-kg-surtidos {
        background: linear-gradient(135deg, #065f46 0%, #16a34a 56%, #047857 100%) !important;
    }

    .kpi-cajas-surtidas {
        background: linear-gradient(135deg, #0f766e 0%, #14b8a6 56%, #115e59 100%) !important;
    }

    .kpi-gap-kg-card,
    .kpi-gap-cajas-card,
    .kpi-gap-empty {
        background: linear-gradient(135deg, #2b1515 0%, #4b1113 56%, #140506 100%) !important;
    }

    .kpi-card.kpi-gap-ok {
        background: linear-gradient(135deg, #0f5132 0%, #198754 56%, #146c43 100%) !important;
    }

    .kpi-card.kpi-gap-warn {
        background: linear-gradient(135deg, #b7791f 0%, #ffc107 56%, #d39e00 100%) !important;
    }

    .kpi-card.kpi-gap-bad {
        background: linear-gradient(135deg, #7f1d1d 0%, #dc3545 56%, #991b1b 100%) !important;
    }

    .kpi-card.kpi-colored .kpi-value.gap-ok,
    .kpi-card.kpi-colored .kpi-value.gap-bad,
    .kpi-card.kpi-colored .kpi-value.gap-empty {
        background: transparent !important;
        color: #fff !important;
    }

    .kpi-card.kpi-gap-warn .kpi-title,
    .kpi-card.kpi-gap-warn .kpi-value,
    .kpi-card.kpi-gap-warn .kpi-value.gap-warn {
        background: transparent !important;
        color: #2b1515 !important;
        text-shadow: none !important;
    }

    .kpi-card.kpi-gap-warn::after {
        background: rgba(255,255,255,.20);
    }

    @@media (max-width: 768px) {
        .kpi-card.kpi-colored {
            min-height: 78px !important;
        }

        .kpi-card.kpi-colored .kpi-value {
            font-size: clamp(15px, 4.8vw, 20px) !important;
        }
    }


    /* =========================================================
       ESTRUCTURA TIPO AJUSTE DE PRECIOS SKU
       Pantalla completa dentro del área real de _Layout2.
       Se expande y se contrae automáticamente con el sidebar.
       ========================================================= */

    :root {
        --sap-bg: #f0dede;
        --sap-panel: #f8eeee;
        --sap-panel-2: #f1dede;
        --sap-surface: #fffafa;
        --sap-soft: #fff7f7;
        --sap-soft-2: #f4dddd;
        --sap-line: #c79d9d;
        --sap-line-dark: #8f4c4c;
        --sap-text: #3b1717;
        --sap-muted: #6a3a3a;
        --sap-brand: #8b0000;
        --sap-header: linear-gradient(180deg,#b30000 0%,#8b0000 55%,#5c0000 100%);
        --sap-toolbar: linear-gradient(#fff6f6,#ecd8d8);
        --sap-shadow:
            0 0 0 1px rgba(255,255,255,.45) inset,
            0 8px 18px rgba(70,12,12,.14);
    }

    body[data-theme="dark"] {
        --sap-bg: #0b1120;
        --sap-panel: #111827;
        --sap-panel-2: #182235;
        --sap-surface: #111827;
        --sap-soft: #1f2937;
        --sap-soft-2: #243044;
        --sap-line: #374151;
        --sap-line-dark: #4b5563;
        --sap-text: #f9fafb;
        --sap-muted: #9ca3af;
        --sap-header: linear-gradient(180deg,#7f1d1d 0%,#5f1212 55%,#2b0505 100%);
        --sap-toolbar: linear-gradient(180deg,#1f2937 0%,#111827 100%);
        --sap-shadow: 0 10px 24px rgba(0,0,0,.35);
    }

    html,
    body {
        width: 100% !important;
        min-width: 0 !important;
        min-height: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
        overflow-x: hidden !important;
        background: transparent !important;
    }

    /*
     * Igual que Ajuste de Precios SKU:
     * la vista mide el 100% del contenedor entregado por _Layout2.
     * No usa 100vw, translate, left ni cálculos de ancho en JavaScript.
     */
    .container,
    .container-fluid {
        width: 100% !important;
        max-width: 100% !important;
        min-width: 0 !important;
        margin: 0 !important;
        padding: 0 !important;
    }

    .window {
        position: relative !important;
        inset: auto !important;
        transform: none !important;

        width: 100% !important;
        max-width: 100% !important;
        min-width: 0 !important;

        height: calc(100vh - 60px) !important;
        height: calc(100dvh - 60px) !important;
        min-height: 560px !important;

        margin: 0 !important;
        padding: 0 !important;

        display: flex !important;
        flex-direction: column !important;

        border: 1px solid var(--sap-line-dark) !important;
        border-radius: 0 !important;
        background: var(--sap-panel) !important;
        color: var(--sap-text) !important;
        box-shadow: var(--sap-shadow) !important;
        overflow: hidden !important;
        box-sizing: border-box !important;

        container-type: inline-size;
        container-name: confirmado-embarcado;
    }

    .window *,
    .window *::before,
    .window *::after {
        box-sizing: border-box;
    }

    /* ENCABEZADO */
    .titlebar {
        display: flex !important;
        width: 100% !important;
        min-height: 58px !important;
        height: auto !important;

        margin: 0 !important;
        padding: 10px 12px !important;

        align-items: center !important;
        justify-content: space-between !important;
        gap: 12px !important;
        flex: 0 0 auto !important;
        flex-wrap: wrap !important;

        border-bottom: 1px solid #4a0000 !important;
        background: var(--sap-header) !important;
        color: #fff !important;
        box-shadow: none !important;
    }

    .report-title {
        display: flex !important;
        align-items: center !important;
        gap: 10px !important;
        min-width: 0 !important;
    }

    .report-title-icon {
        width: 38px !important;
        height: 38px !important;
        flex: 0 0 38px !important;

        display: grid !important;
        place-items: center !important;

        border: 1px solid rgba(255,255,255,.30) !important;
        border-radius: 0 !important;
        background: rgba(255,255,255,.12) !important;
        color: #fff !important;
        font-size: 17px !important;
    }

    .report-title-main {
        margin: 0 !important;
        color: #fff !important;
        font-size: 16px !important;
        line-height: 1.15 !important;
        font-weight: 800 !important;
    }

    .report-title small {
        display: block !important;
        margin-top: 2px !important;
        color: #f4d7d7 !important;
        font-size: 10px !important;
        line-height: 1.2 !important;
        font-weight: 400 !important;
    }

    .report-title-source {
        display: inline-flex !important;
        align-items: center !important;
        gap: 7px !important;
        margin-left: auto !important;

        padding: 5px 9px !important;
        border: 1px solid rgba(255,255,255,.35) !important;
        border-radius: 0 !important;
        background: rgba(0,0,0,.15) !important;
        color: #fff !important;

        font-size: 10px !important;
        font-weight: 700 !important;
        white-space: nowrap !important;
    }

    /* CONTENIDO PRINCIPAL */
    .content {
        width: 100% !important;
        max-width: 100% !important;
        min-width: 0 !important;
        min-height: 0 !important;

        margin: 0 !important;
        padding: 8px !important;

        display: flex !important;
        flex-direction: column !important;
        flex: 1 1 auto !important;
        gap: 8px !important;

        background: var(--sap-bg) !important;
        overflow: hidden !important;
        box-sizing: border-box !important;
    }

    .content > .section {
        width: 100% !important;
        max-width: 100% !important;
        min-width: 0 !important;
        margin: 0 !important;

        border: 1px solid var(--sap-line) !important;
        border-radius: 0 !important;
        background: var(--sap-surface) !important;
        box-shadow: none !important;
    }

    .content > .section:nth-child(1),
    .content > .section:nth-child(2) {
        flex: 0 0 auto !important;
    }

    .content > .section:last-child {
        display: flex !important;
        flex-direction: column !important;
        flex: 1 1 auto !important;
        min-height: 0 !important;
        overflow: hidden !important;
    }

    .section-title {
        min-height: 29px !important;
        padding: 6px 8px !important;
        flex: 0 0 auto !important;

        border-bottom: 1px solid #4a0000 !important;
        background: var(--sap-header) !important;
        color: #fff !important;

        font-size: 11px !important;
        font-weight: 800 !important;
    }

    .section-body {
        padding: 8px !important;
        background: var(--sap-surface) !important;
    }

    /* FILTROS */
    .filters {
        width: 100% !important;
        max-width: 100% !important;
        min-width: 0 !important;

        grid-template-columns:
            minmax(170px,1.3fr)
            minmax(110px,.8fr)
            minmax(120px,.8fr)
            minmax(125px,.8fr)
            minmax(125px,.8fr)
            minmax(130px,.8fr)
            minmax(270px,1.4fr) !important;

        gap: 7px !important;
        align-items: end !important;
    }

    .filters > div {
        min-width: 0 !important;
    }

    .form-label {
        margin-bottom: 3px !important;
        color: var(--sap-text) !important;
        font-size: 10px !important;
        font-weight: 800 !important;
    }

    .form-control,
    .form-select,
    .cg-ms-button {
        width: 100% !important;
        min-width: 0 !important;
        min-height: 30px !important;
        height: 30px !important;

        padding: 3px 7px !important;
        border: 1px solid var(--sap-line-dark) !important;
        border-radius: 0 !important;
        background: var(--sap-surface) !important;
        color: var(--sap-text) !important;

        font-size: 11px !important;
        box-shadow: none !important;
    }

    .cg-ms-panel {
        top: 32px !important;
        max-width: min(320px,90vw) !important;
        border: 1px solid var(--sap-line-dark) !important;
        background: var(--sap-surface) !important;
        box-shadow: 0 10px 28px rgba(70,12,12,.18) !important;
    }

    .btn-main,
    .btn-light,
    .btn-excel {
        min-height: 30px !important;
        height: 30px !important;
        padding: 0 10px !important;
        border-radius: 0 !important;
        font-size: 10px !important;
        box-shadow: none !important;
    }

    /* KPIs */
    .kpis {
        display: grid !important;
        grid-template-columns: repeat(6,minmax(0,1fr)) !important;
        gap: 8px !important;
        width: 100% !important;
    }

    .kpi-card {
        width: auto !important;
        min-width: 0 !important;
        min-height: 70px !important;
        padding: 8px 9px !important;
        border-radius: 0 !important;
    }

    .kpi-card.kpi-colored {
        min-height: 76px !important;
        border-radius: 0 !important;
        box-shadow:
            inset 4px 0 0 rgba(255,255,255,.18),
            0 4px 12px rgba(45,8,8,.12) !important;
    }

    .kpi-title {
        font-size: 9px !important;
    }

    .kpi-value,
    .kpi-card.kpi-colored .kpi-value {
        font-size: clamp(15px,1.15vw,20px) !important;
    }

    /* TABLA PRINCIPAL */
    .table-card {
        width: 100% !important;
        max-width: 100% !important;
        min-width: 0 !important;
        min-height: 0 !important;

        display: flex !important;
        flex-direction: column !important;
        flex: 1 1 auto !important;

        border: 0 !important;
        background: var(--sap-surface) !important;
        overflow: hidden !important;
    }

    .table-responsive-sticky {
        width: 100% !important;
        max-width: 100% !important;
        min-width: 0 !important;
        min-height: 260px !important;
        max-height: none !important;

        flex: 1 1 auto !important;
        overflow: auto !important;
        overscroll-behavior-inline: contain;
        scrollbar-gutter: stable;

        border-top: 0 !important;
        background: var(--sap-surface) !important;
    }

    #tbl-surtidos {
        width: 100% !important;
        min-width: 1400px !important;
        background: var(--sap-surface) !important;
        color: var(--sap-text) !important;
        font-size: 10px !important;
    }

    #tbl-surtidos thead th {
        padding: 0 !important;
        background: var(--sap-header) !important;
        color: #fff !important;
        font-size: 10px !important;
    }

    #tbl-surtidos tbody td {
        padding: 5px 4px !important;
        border-right: 1px solid var(--sap-line) !important;
        border-bottom: 1px solid var(--sap-line) !important;
        background: var(--sap-surface) !important;
        color: var(--sap-text) !important;
        font-size: 10px !important;
    }

    #tbl-surtidos tbody tr:nth-of-type(even) > * {
        background: var(--sap-panel-2) !important;
    }

    #tbl-surtidos tbody tr:hover > * {
        background: var(--sap-soft-2) !important;
    }

    .th-inner {
        padding: 5px 4px !important;
    }

    .detail-table-wrap {
        max-width: 100% !important;
        overflow: auto !important;
    }

    .detail-table {
        min-width: 960px !important;
    }

    .statusbar {
        width: 100% !important;
        flex: 0 0 auto !important;
        padding: 6px 9px !important;

        border-top: 1px solid var(--sap-line) !important;
        background: var(--sap-toolbar) !important;
        color: var(--sap-muted) !important;
        font-size: 9px !important;
    }

    /*
     * Container queries: reaccionan al ancho real que deja el sidebar,
     * aun cuando la ventana del navegador siga siendo grande.
     */
    @@container confirmado-embarcado (max-width: 1350px) {
        .filters {
            grid-template-columns: repeat(3,minmax(0,1fr)) !important;
        }

        .filters > div:last-child {
            grid-column: 1 / -1 !important;
            justify-content: flex-end !important;
        }

        .kpis {
            grid-template-columns: repeat(3,minmax(0,1fr)) !important;
        }
    }

    @@container confirmado-embarcado (max-width: 900px) {
        .report-title-source {
            display: none !important;
        }

        .filters {
            grid-template-columns: repeat(2,minmax(0,1fr)) !important;
        }

        .kpis {
            grid-template-columns: repeat(2,minmax(0,1fr)) !important;
        }
    }

    @@container confirmado-embarcado (max-width: 620px) {
        .titlebar {
            align-items: flex-start !important;
        }

        .filters,
        .kpis {
            grid-template-columns: 1fr !important;
        }

        .filters > div:last-child {
            grid-column: auto !important;
            display: grid !important;
            grid-template-columns: 1fr !important;
        }

        .btn-main,
        .btn-light,
        .btn-excel {
            width: 100% !important;
        }

        .kpi-card.kpi-colored {
            min-height: 68px !important;
        }
    }

    @@media (max-height: 720px) {
        .window {
            min-height: 500px !important;
        }

        .kpi-card.kpi-colored {
            min-height: 64px !important;
        }

        .section-body {
            padding: 6px !important;
        }
    }

    @@media (max-width: 700px) {
        .content {
            padding: 6px !important;
        }
    }


    /* =========================================================
       GRID COMPACTO — Confirmado Vs Embarcado
       Mantiene IDs, JavaScript y comportamiento con sidebar.
       ========================================================= */

    #confirmadoEmbarcadoApp .content {
        padding: 5px !important;
        gap: 5px !important;
    }

    #confirmadoEmbarcadoApp .content > .section {
        margin: 0 !important;
    }

    #confirmadoEmbarcadoApp .section-title {
        min-height: 25px !important;
        padding: 4px 6px !important;
        font-size: 10px !important;
        line-height: 1.1 !important;
    }

    #confirmadoEmbarcadoApp .section-body {
        padding: 5px 6px !important;
    }

    /* 16 columnas: aprovecha mejor el ancho disponible sin dejar huecos. */
    #confirmadoEmbarcadoApp .filters {
        display: grid !important;
        grid-template-columns: repeat(16, minmax(0, 1fr)) !important;
        column-gap: 6px !important;
        row-gap: 4px !important;
        align-items: end !important;
    }

    #confirmadoEmbarcadoApp .filters > div {
        min-width: 0 !important;
    }

    #confirmadoEmbarcadoApp .filters > div:nth-child(1) { grid-column: span 4 !important; } /* Cliente */
    #confirmadoEmbarcadoApp .filters > div:nth-child(2) { grid-column: span 2 !important; } /* Folio */
    #confirmadoEmbarcadoApp .filters > div:nth-child(3) { grid-column: span 2 !important; } /* Serie */
    #confirmadoEmbarcadoApp .filters > div:nth-child(4) { grid-column: span 2 !important; } /* Fecha inicio */
    #confirmadoEmbarcadoApp .filters > div:nth-child(5) { grid-column: span 2 !important; } /* Fecha fin */
    #confirmadoEmbarcadoApp .filters > div:nth-child(6) { grid-column: span 2 !important; } /* Tipo */
    #confirmadoEmbarcadoApp .filters > div:nth-child(7) {
        grid-column: span 2 !important;
        display: grid !important;
        grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
        gap: 4px !important;
        align-items: end !important;
        flex-wrap: nowrap !important;
