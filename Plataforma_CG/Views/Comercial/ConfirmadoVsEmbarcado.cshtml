@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewBag.Title = "Confirmado vs Embarcado";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    /* =====================================================================
       CONFIRMADO VS EMBARCADO · SIGO — hoja de estilos única
       Mismo sistema visual que el resto de módulos. Sustituye las capas
       anteriores y la hoja externa confirmado-embarcado-erp-compacto.css
       (incluidas las reglas que cambiaban el z-index del menú lateral).
       ===================================================================== */
    :root {
        --es-tinto: #8d3e46;
        --es-tinto-deep: #5c2229;
        --es-tinto-soft: #f7eced;
        --es-tinto-line: #e8d3d6;
        --es-paper: #f6f4f4;
        --es-surface: #ffffff;
        --es-field: #ffffff;
        --es-head: #faf7f7;
        --es-hover: #fcf9f9;
        --es-row-line: #f0eaeb;
        --es-ink: #231a1c;
        --es-muted: #76686b;
        --es-line: #e6dfe0;
        --es-line-strong: #cfc4c6;
        --es-ok: #2f7a55;
        --es-ok-bg: #e7f3ec;
        --es-warn: #9a6410;
        --es-warn-bg: #fbf1de;
        --es-bad: #b42d2d;
        --es-bad-bg: #fbe9e8;
        --es-info: #2f5d86;
        --es-info-bg: #e9f0f7;
        --es-teal: #2b7a72;
        --es-accent-col: #fbf6ea;
        --es-font: "Poppins", "Segoe UI", system-ui, -apple-system, Arial, sans-serif;
    }
    body[data-theme="dark"] {
        --es-tinto: #c56b74;
        --es-tinto-deep: #7a2d36;
        --es-tinto-soft: #3a2427;
        --es-tinto-line: #5a3439;
        --es-paper: #16181c;
        --es-surface: #202328;
        --es-field: #181a1e;
        --es-head: #262a30;
        --es-hover: #2a2e34;
        --es-row-line: #30343b;
        --es-ink: #edf0f3;
        --es-muted: #a9b0b9;
        --es-line: #363b43;
        --es-line-strong: #4a5059;
        --es-ok: #6cc596;
        --es-ok-bg: #1d3328;
        --es-warn: #e0b061;
        --es-warn-bg: #3a2f1b;
        --es-bad: #f08a83;
        --es-bad-bg: #3d2223;
        --es-info: #8bb8e0;
        --es-info-bg: #1e2b38;
        --es-teal: #6cc5ba;
        --es-accent-col: #2a2a22;
    }

    .cvx { font-family: var(--es-font) !important; color: var(--es-ink); font-size: 13px; line-height: 1.4; }
    .cvx *, .cv-ctx * { box-sizing: border-box; }
    .cvx .bi, .cv-ctx .bi { font-family: "bootstrap-icons" !important; }
    .text-end { text-align: right !important; font-variant-numeric: tabular-nums; }
    .text-center { text-align: center !important; }

    .cvx { display: flex; flex-direction: column; gap: 10px; height: calc(100dvh - 92px); min-height: 600px; padding: 14px 16px 8px; background: var(--es-paper); overflow: hidden; min-width: 0; }

    /* ---------- Encabezado ---------- */
    .cv-header { flex: none; display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap; }
    .cv-header__title { display: flex; align-items: center; gap: 12px; min-width: 0; }
    .cv-header__icon { width: 40px; height: 40px; flex: none; border-radius: 10px; display: grid; place-items: center; background: var(--es-tinto); color: #fff; font-size: 19px; }
    .cv-header h1 { margin: 0; font-size: 20px; font-weight: 700; letter-spacing: -.01em; line-height: 1.15; color: var(--es-ink); }
    .cv-header p { margin: 2px 0 0; font-size: 12px; color: var(--es-muted); }
    .cv-leyenda { display: flex; gap: 12px; flex-wrap: wrap; font-size: 11.5px; color: var(--es-muted); }
    .cv-leyenda span { display: inline-flex; align-items: center; gap: 5px; }
    .cv-leyenda i { width: 10px; height: 10px; border-radius: 3px; display: inline-block; }

    /* ---------- Botones ---------- */
    .btn-main, .btn-excel, .btn-light {
        display: inline-flex; align-items: center; justify-content: center; gap: 6px;
        height: 36px; padding: 0 14px; border: 1px solid var(--es-line-strong); border-radius: 7px;
        background: var(--es-field); color: var(--es-ink); font: 600 12.5px/1 var(--es-font); white-space: nowrap; cursor: pointer;
        transition: background .12s, border-color .12s, color .12s;
    }
    .btn-excel:hover, .btn-light:hover { background: var(--es-tinto-soft); border-color: var(--es-tinto-line); }
    .btn-main { background: var(--es-tinto); border-color: var(--es-tinto); color: #fff; }
    .btn-main:hover { background: var(--es-tinto-deep); border-color: var(--es-tinto-deep); }
    .btn-main:disabled, .btn-excel:disabled { opacity: .6; cursor: progress; }
    .btn-main:focus-visible, .btn-excel:focus-visible, .btn-light:focus-visible { outline: 2px solid var(--es-tinto); outline-offset: 2px; }

    /* ---------- Filtros ---------- */
    .cv-card { background: var(--es-surface); border: 1px solid var(--es-line); border-radius: 10px; min-width: 0; }
    .cv-filters { flex: none; padding: 10px 14px; position: relative; z-index: 5; }
    .filters { display: grid; grid-template-columns: minmax(170px, 1.6fr) minmax(90px, .7fr) minmax(120px, .9fr) minmax(130px, .9fr) minmax(130px, .9fr) minmax(130px, .9fr) minmax(100px, .8fr) minmax(120px, .9fr); gap: 10px; align-items: end; }
    .filter-actions { grid-column: 1 / -1; display: flex; justify-content: flex-end; align-items: center; gap: 8px; flex-wrap: wrap; }
    .filter-actions .cv-filtro-aviso { margin-right: auto; font-size: 12px; color: var(--es-warn); }
    .cvx .form-label { display: block; margin: 0 0 5px; font-size: 12px; font-weight: 600; color: var(--es-muted); }
    .cvx .form-control, .cvx .form-select, .cg-ms-button {
        width: 100%; height: 36px; padding: 0 10px; border: 1px solid var(--es-line-strong); border-radius: 7px;
        background-color: var(--es-field); color: var(--es-ink); font: 500 13px/1.2 var(--es-font); box-shadow: none; outline: none;
    }
    .cvx .form-select { padding-right: 30px; }
    .cvx .form-control:focus, .cvx .form-select:focus, .cg-ms-button:focus-visible { border-color: var(--es-tinto); box-shadow: 0 0 0 3px rgba(141,62,70,.16); background-color: var(--es-field); color: var(--es-ink); }
    body[data-theme="dark"] .cvx .form-control, body[data-theme="dark"] .cvx .form-select { color-scheme: dark; }

    /* Serie: selección múltiple */
    .cg-multiselect { position: relative; }
    .cg-ms-button { display: flex; align-items: center; justify-content: space-between; gap: 6px; cursor: pointer; text-align: left; }
    .cg-ms-button #lbl-serie { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .cg-ms-button.has-value { border-color: var(--es-tinto); background: var(--es-tinto-soft); font-weight: 600; }
    .cg-ms-arrow { color: var(--es-muted); font-size: 11px; }
    .cg-ms-panel { display: none; position: absolute; top: calc(100% + 4px); left: 0; z-index: 50; width: max(100%, 240px); padding: 8px; border: 1px solid var(--es-line-strong); border-radius: 10px; background: var(--es-surface); box-shadow: 0 12px 30px rgba(0,0,0,.16); }
    .cg-multiselect.open .cg-ms-panel { display: block; }
    .cg-ms-search { width: 100%; height: 32px; margin-bottom: 6px; padding: 0 9px; border: 1px solid var(--es-line-strong); border-radius: 7px; background: var(--es-field); color: var(--es-ink); font: 500 12.5px var(--es-font); outline: none; }
    .cg-ms-search:focus { border-color: var(--es-tinto); }
    .cg-ms-tools { display: flex; justify-content: space-between; margin-bottom: 4px; font-size: 11.5px; }
    .cg-ms-tools button { border: 0; background: none; padding: 2px 4px; color: var(--es-tinto); font: 600 11.5px var(--es-font); cursor: pointer; }
    .cg-ms-options { max-height: 220px; overflow-y: auto; }
    .cg-ms-item { display: flex; align-items: center; gap: 9px; padding: 6px 8px; margin: 0; border-radius: 6px; font-size: 12.5px; font-weight: 500; color: var(--es-ink); cursor: pointer; user-select: none; }
    .cg-ms-item:hover { background: var(--es-tinto-soft); }
    .cg-ms-item input { width: 16px; height: 16px; margin: 0; accent-color: var(--es-tinto); cursor: pointer; }
    .cg-ms-empty { padding: 8px; color: var(--es-muted); font-size: 12px; }

    /* ---------- KPIs ---------- */
    .kpis { flex: none; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 10px; }
    .kpi-card { padding: 10px 14px; border-radius: 10px; background: var(--es-surface); border: 1px solid var(--es-line); border-top: 3px solid var(--k, var(--es-line-strong)); min-width: 0; }
    .kpi-title { display: flex; align-items: center; gap: 6px; font-size: 11.5px; font-weight: 600; color: var(--es-muted); letter-spacing: .02em; }
    .kpi-title i { color: var(--k); }
    .kpi-value { margin-top: 2px; font-size: clamp(17px, 1.4vw, 22px); font-weight: 700; color: var(--es-ink); font-variant-numeric: tabular-nums; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .kpi-sub { font-size: 11px; color: var(--es-muted); }
    .kpi-kg-pedidos { --k: var(--es-tinto); }
    .kpi-cajas-pedidas { --k: var(--es-warn); }
    .kpi-kg-surtidos { --k: var(--es-ok); }
    .kpi-cajas-surtidas { --k: var(--es-teal); }
    .kpi-gap-empty { --k: var(--es-muted); }
    .kpi-card.kpi-gap-ok { --k: var(--es-ok); background: var(--es-ok-bg); }
    .kpi-card.kpi-gap-warn { --k: var(--es-warn); background: var(--es-warn-bg); }
    .kpi-card.kpi-gap-bad { --k: var(--es-bad); background: var(--es-bad-bg); }
    .kpi-card.kpi-gap-ok .kpi-value { color: var(--es-ok); }
    .kpi-card.kpi-gap-warn .kpi-value { color: var(--es-warn); }
    .kpi-card.kpi-gap-bad .kpi-value { color: var(--es-bad); }

    /* ---------- Tabla ---------- */
    .table-card { flex: 1 1 auto; display: flex; flex-direction: column; min-height: 0; background: var(--es-surface); border: 1px solid var(--es-line); border-radius: 10px; overflow: hidden; }
    .table-card-head { flex: none; display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; padding: 9px 14px; border-bottom: 1px solid var(--es-line); font-size: 13px; font-weight: 600; }
    .table-card-head i { color: var(--es-tinto); }
    .table-card-head small { font-size: 11.5px; font-weight: 500; color: var(--es-muted); }
    .table-responsive-sticky { flex: 1 1 auto; min-height: 0; overflow: auto; }
    #tbl-surtidos { width: 100%; min-width: 0; margin: 0; border-collapse: separate; border-spacing: 0; table-layout: fixed; font-size: 12.5px; color: var(--es-ink);
        --bs-table-bg: transparent; --bs-table-color: var(--es-ink); --bs-table-striped-bg: transparent; --bs-table-hover-bg: transparent; --bs-table-border-color: transparent; }
    #tbl-surtidos > :not(caption) > * > * { border-width: 0; box-shadow: none; }
    #tbl-surtidos thead th { position: sticky; top: 0; z-index: 2; padding: 0; background: var(--es-head); border-bottom: 1px solid var(--es-line); color: var(--es-muted); font-size: 11.5px; font-weight: 600; white-space: nowrap; }
    #tbl-surtidos thead th.col-surt { background: #f7f1e1; }
    body[data-theme="dark"] #tbl-surtidos thead th.col-surt { background: #2e2c22; }
    .th-inner { display: flex; align-items: center; gap: 4px; padding: 9px 9px; user-select: none; }
    .th-inner.sortable { cursor: pointer; }
    .th-inner.sortable:hover { color: var(--es-ink); }
    th.text-end .th-inner { justify-content: flex-end; }
    th.text-center .th-inner { justify-content: center; }
    .sort-ind { width: 10px; color: var(--es-tinto); font-size: 10px; }
    th.sort-asc .sort-ind::after { content: "▲"; }
    th.sort-desc .sort-ind::after { content: "▼"; }
    #tbl-surtidos tbody td { padding: 7px 9px; border-bottom: 1px solid var(--es-row-line); background: var(--es-surface); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; vertical-align: middle; }
    #tbl-surtidos > tbody > tr[data-folio]:hover > td { background: var(--es-hover); }
    #tbl-surtidos > tbody > tr[data-folio] > td:nth-child(4) { font-weight: 600; }
    #tbl-surtidos > tbody > tr[data-folio] > td:nth-child(11), #tbl-surtidos > tbody > tr[data-folio] > td:nth-child(12) { background: var(--es-accent-col); font-weight: 600; }
    #tbl-surtidos > tbody > tr.is-open > td { background: var(--es-tinto-soft) !important; }
    .cv-idx { display: inline-flex; align-items: center; gap: 6px; }
    .cv-idx span { min-width: 22px; text-align: right; color: var(--es-muted); font-size: 11.5px; }
    .toggle-btn { width: 26px; height: 26px; padding: 0; border: 1px solid var(--es-line-strong); border-radius: 6px; background: var(--es-field); color: var(--es-ink); cursor: pointer; display: inline-grid; place-items: center; }
    .toggle-btn:hover { background: var(--es-tinto-soft); }
    .toggle-btn i { transition: transform .15s; }
    .toggle-btn[data-open="1"] { background: var(--es-tinto); border-color: var(--es-tinto); color: #fff; }
    .toggle-btn[data-open="1"] i { transform: rotate(90deg); }
    .t-msg td { padding: 40px 12px !important; text-align: center !important; color: var(--es-muted); white-space: normal !important; }
    .t-msg.is-error td { color: var(--es-bad); background: var(--es-bad-bg) !important; }


    /* ---------- Tabla sin desplazamiento horizontal ----------
       Las columnas se reparten el ancho disponible (colgroup) y los textos largos
       (cliente, ruta, serie) bajan a una segunda línea. Solo en pantallas de menos de
       ~1,280 px vuelve el desplazamiento para que los datos no queden ilegibles. */
    #tbl-surtidos thead th { white-space: normal; line-height: 1.2; vertical-align: bottom; }
    #tbl-surtidos .th-inner { padding: 8px 6px; align-items: flex-end; }
    #tbl-surtidos tbody td { white-space: normal; overflow: visible; text-overflow: clip; overflow-wrap: anywhere; padding: 6px 6px; font-size: 12px; line-height: 1.3; }
    #tbl-surtidos tbody td.text-end, #tbl-surtidos > tbody > tr[data-folio] > td:nth-child(6), #tbl-surtidos > tbody > tr[data-folio] > td:nth-child(4) { white-space: nowrap; overflow-wrap: normal; }
    #tbl-surtidos .clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    #tbl-surtidos .cv-idx { gap: 4px; }
    #tbl-surtidos .cv-idx span { min-width: 16px; font-size: 11px; }
    #tbl-surtidos .toggle-btn { width: 24px; height: 24px; }
    .detail-box { margin: 8px 8px 12px 24px; }
    .detail-table { min-width: 0; table-layout: fixed; }
    .detail-table th { white-space: normal; }
    .detail-table td { white-space: nowrap; }
    .detail-table td.td-wrap { min-width: 0; white-space: normal !important; overflow-wrap: anywhere; }
    @@media (max-width: 1280px) { .table-responsive-sticky { overflow-x: auto; } #tbl-surtidos { min-width: 1100px; } }
    /* Semáforo de cumplimiento */
    td.gap-ok, td.gap-warn, td.gap-bad, td.gap-empty { font-weight: 700; }
    #tbl-surtidos tbody td.gap-ok, .detail-table td.gap-ok { background: var(--es-ok-bg) !important; color: var(--es-ok); }
    #tbl-surtidos tbody td.gap-warn, .detail-table td.gap-warn { background: var(--es-warn-bg) !important; color: var(--es-warn); }
    #tbl-surtidos tbody td.gap-bad, .detail-table td.gap-bad { background: var(--es-bad-bg) !important; color: var(--es-bad); }
    td.gap-empty { color: var(--es-muted); }

    /* Detalle */
    #tbl-surtidos tr.detail-row > td { padding: 0 !important; background: var(--es-paper) !important; white-space: normal; overflow: visible; }
    .detail-box { margin: 8px 10px 12px 40px; border-radius: 10px; background: var(--es-surface); border: 1px solid var(--es-line); box-shadow: inset 3px 0 0 var(--es-tinto); overflow: hidden; }
    .detail-head { padding: 8px 12px; border-bottom: 1px solid var(--es-line); font-size: 13px; font-weight: 600; }
    .detail-table-wrap { overflow: auto; }
    .detail-table { width: 100%; min-width: 860px; border-collapse: separate; border-spacing: 0; font-size: 12.5px; }
    .detail-table th { padding: 7px 9px; background: var(--es-head); border-bottom: 1px solid var(--es-line); color: var(--es-muted); font-size: 11.5px; font-weight: 600; white-space: nowrap; text-align: left; }
    .detail-table th.text-end { text-align: right; }
    .detail-table td { padding: 6px 9px; border-bottom: 1px solid var(--es-row-line); white-space: nowrap; }
    .detail-table td:first-child { font-weight: 600; }
    .detail-table tbody tr:hover td { background: var(--es-hover); }
    .td-wrap { white-space: normal !important; min-width: 260px; }

    .statusbar { flex: none; display: flex; gap: 18px; flex-wrap: wrap; font-size: 11.5px; color: var(--es-muted); }

    /* Menú de clic derecho (copiar a Excel) */
    .cv-ctx { position: fixed; z-index: 1100; min-width: 230px; padding: 4px; border-radius: 10px; background: var(--es-surface); border: 1px solid var(--es-line-strong); box-shadow: 0 14px 34px rgba(0,0,0,.2); font-family: var(--es-font); display: none; }
    .cv-ctx.show { display: block; }
    .cv-ctx button { width: 100%; display: flex; align-items: center; gap: 9px; padding: 8px 10px; border: 0; border-radius: 6px; background: transparent; color: var(--es-ink); font: 500 12.5px/1.2 var(--es-font); text-align: left; cursor: pointer; }
    .cv-ctx button:hover, .cv-ctx button:focus-visible { background: var(--es-tinto-soft); outline: none; }
    .cv-ctx button i { color: var(--es-tinto); width: 16px; }
    .cv-ctx button small { margin-left: auto; color: var(--es-muted); font-size: 11px; }
    .cv-ctx hr { margin: 4px 6px; border: 0; border-top: 1px solid var(--es-line); }
    .cv-toast { position: fixed; left: 50%; bottom: 24px; z-index: 1110; transform: translateX(-50%); padding: 9px 16px; border-radius: 999px; background: var(--es-ink); color: var(--es-surface); font: 600 12.5px var(--es-font); box-shadow: 0 8px 22px rgba(0,0,0,.25); opacity: 0; pointer-events: none; transition: opacity .18s; }
    .cv-toast.show { opacity: 1; }
    td.ctx-cell { box-shadow: inset 0 0 0 2px var(--es-tinto) !important; }

    @@media (max-width: 1400px) { .filters { grid-template-columns: repeat(4, minmax(0, 1fr)); } .kpis { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
    @@media (max-width: 900px) { .cvx { height: auto; overflow: visible; } .table-card { min-height: 520px; } .filters, .kpis { grid-template-columns: 1fr 1fr; } }
</style>

<div class="cvx window" id="confirmadoEmbarcadoApp">
    <header class="cv-header">
        <div class="cv-header__title">
            <span class="cv-header__icon"><i class="bi bi-truck"></i></span>
            <div>
                <h1>Confirmado vs embarcado</h1>
                <p>Cumplimiento de surtido por pedido y transferencia: lo confirmado contra lo que realmente se embarcó.</p>
            </div>
        </div>
        <div class="cv-leyenda" aria-label="Semáforo de cumplimiento">
            <span><i style="background:var(--es-ok)"></i>100% o más</span>
            <span><i style="background:var(--es-warn)"></i>97% a 99.9%</span>
            <span><i style="background:var(--es-bad)"></i>menos de 97%</span>
        </div>
    </header>

    <section class="cv-card cv-filters">
        <form id="frm-filtros" class="filters" autocomplete="off">
            <div>
                <label class="form-label" for="txt-cliente">Cliente</label>
                <input type="text" id="txt-cliente" class="form-control" placeholder="Nombre del cliente" />
            </div>
            <div>
                <label class="form-label" for="txt-folio">Folio</label>
                <input type="text" id="txt-folio" class="form-control" placeholder="OV o TR" />
            </div>
            <div>
                <label class="form-label" for="btn-serie">Serie</label>
                <div class="cg-multiselect" id="ms-serie">
                    <button type="button" class="cg-ms-button" id="btn-serie" aria-haspopup="listbox" aria-expanded="false">
                        <span id="lbl-serie">Todas</span><span class="cg-ms-arrow"><i class="bi bi-chevron-down"></i></span>
                    </button>
                    <div class="cg-ms-panel" id="panel-serie">
                        <input type="text" id="txt-buscar-serie" class="cg-ms-search" placeholder="Buscar serie…" aria-label="Buscar serie" />
                        <div class="cg-ms-tools"><button type="button" id="btn-serie-todas">Marcar visibles</button><button type="button" id="btn-serie-ninguna">Quitar todas</button></div>
                        <div class="cg-ms-options" id="lst-serie" role="listbox" aria-multiselectable="true"></div>
                    </div>
                </div>
            </div>
            <div>
                <label class="form-label" for="txt-fecha-inicio">Fecha inicio</label>
                <input type="date" id="txt-fecha-inicio" class="form-control" />
            </div>
            <div>
                <label class="form-label" for="txt-fecha-fin">Fecha fin</label>
                <input type="date" id="txt-fecha-fin" class="form-control" />
            </div>
            <div>
                <label class="form-label" for="sel-tipo">Tipo</label>
                <select id="sel-tipo" class="form-select">
                    <option value="">Ambos</option>
                    <option value="OV">Orden de venta</option>
                    <option value="TR">Transferencia</option>
                </select>
            </div>
            <div>
                <label class="form-label" for="txt-embarque">Embarque</label>
                <input type="text" id="txt-embarque" class="form-control" placeholder="No. embarque" />
            </div>
            <div>
                <label class="form-label" for="txt-ruta">Ruta</label>
                <input type="text" id="txt-ruta" class="form-control" placeholder="Ruta" />
            </div>
            <div class="filter-actions">
                <span class="cv-filtro-aviso" id="cv-filtro-aviso" role="status" aria-live="polite"></span>
                <button type="button" id="btn-limpiar" class="btn-light"><i class="bi bi-eraser"></i> Limpiar</button>
                <button type="button" id="btn-excel" class="btn-excel"><i class="bi bi-file-earmark-excel"></i> Exportar Excel</button>
                <button type="submit" class="btn-main" id="btn-buscar"><i class="bi bi-search"></i> Buscar</button>
            </div>
        </form>
    </section>

    <section class="kpis" aria-label="Resumen">
        <div class="kpi-card kpi-kg-pedidos"><div class="kpi-title"><i class="bi bi-clipboard-check"></i> Kg pedidos</div><div class="kpi-value" id="kpi-kg-pedidos">0</div><div class="kpi-sub">Confirmados</div></div>
        <div class="kpi-card kpi-cajas-pedidas"><div class="kpi-title"><i class="bi bi-box"></i> Cajas pedidas</div><div class="kpi-value" id="kpi-cajas-pedidas">0</div><div class="kpi-sub">Confirmadas</div></div>
        <div class="kpi-card kpi-kg-surtidos"><div class="kpi-title"><i class="bi bi-truck"></i> Kg surtidos</div><div class="kpi-value" id="kpi-kg-surtidos">0</div><div class="kpi-sub">Embarcados</div></div>
        <div class="kpi-card kpi-cajas-surtidas"><div class="kpi-title"><i class="bi bi-box-seam"></i> Cajas surtidas</div><div class="kpi-value" id="kpi-cajas-surtidas">0</div><div class="kpi-sub">Embarcadas</div></div>
        <div class="kpi-card kpi-gap-kg-card kpi-gap-empty"><div class="kpi-title"><i class="bi bi-percent"></i> Cumplimiento kg</div><div class="kpi-value" id="kpi-gap-kg">-</div><div class="kpi-sub">Surtido ÷ pedido</div></div>
        <div class="kpi-card kpi-gap-cajas-card kpi-gap-empty"><div class="kpi-title"><i class="bi bi-percent"></i> Cumplimiento cajas</div><div class="kpi-value" id="kpi-gap-cajas">-</div><div class="kpi-sub">Surtido ÷ pedido</div></div>
    </section>

    <section class="table-card">
        <div class="table-card-head">
            <span><i class="bi bi-table"></i> Pedidos y transferencias <small id="cv-conteo"></small></span>
            <small>Clic en la flecha para ver los SKU · clic derecho para copiar a Excel</small>
        </div>
        <div class="table-responsive-sticky">
            <table class="table mb-0" id="tbl-surtidos">
                <colgroup>
                    <col style="width:5%"><col style="width:4%"><col style="width:6%"><col style="width:7.5%"><col style="width:18%">
                    <col style="width:7%"><col style="width:6.5%"><col style="width:10%">
                    <col style="width:6.5%"><col style="width:6%"><col style="width:6.5%"><col style="width:6%"><col style="width:5.5%"><col style="width:5.5%">
                </colgroup>
                <thead>
                    <tr>
                        <th class="text-center"><div class="th-inner">#</div></th>
                        <th data-col="tipo"><div class="th-inner sortable">Tipo<span class="sort-ind"></span></div></th>
                        <th data-col="serie"><div class="th-inner sortable">Serie<span class="sort-ind"></span></div></th>
                        <th data-col="folio"><div class="th-inner sortable">Folio<span class="sort-ind"></span></div></th>
                        <th data-col="cliente"><div class="th-inner sortable">Cliente<span class="sort-ind"></span></div></th>
                        <th data-col="fecha"><div class="th-inner sortable">Fecha<span class="sort-ind"></span></div></th>
                        <th data-col="embarque"><div class="th-inner sortable">Embarque<span class="sort-ind"></span></div></th>
                        <th data-col="ruta"><div class="th-inner sortable">Ruta<span class="sort-ind"></span></div></th>
                        <th data-col="kgPedidos" class="text-end"><div class="th-inner sortable">Kg pedido<span class="sort-ind"></span></div></th>
                        <th data-col="cajasPedidas" class="text-end"><div class="th-inner sortable">Cajas pedidas<span class="sort-ind"></span></div></th>
                        <th data-col="kgSurtidos" class="text-end col-surt"><div class="th-inner sortable">Kg surtidos<span class="sort-ind"></span></div></th>
                        <th data-col="cajasSurtidas" class="text-end col-surt"><div class="th-inner sortable">Cajas surtidas<span class="sort-ind"></span></div></th>
                        <th data-col="gapKg" class="text-end col-surt"><div class="th-inner sortable">GAP kg<span class="sort-ind"></span></div></th>
                        <th data-col="gapCaja" class="text-end col-surt"><div class="th-inner sortable">GAP caja<span class="sort-ind"></span></div></th>
                    </tr>
                </thead>
                <tbody id="tbody-surtidos">
                    <tr class="t-msg"><td colspan="14">Cargando…</td></tr>
                </tbody>
            </table>
        </div>
    </section>

    <footer class="statusbar">
        <span>Usuario: @(User?.Identity?.Name ?? "")</span>
        <span>Carnes G SA de CV</span>
        <span>Módulo: Confirmado vs embarcado</span>
    </footer>
</div>

<div id="cvCtxMenu" class="cv-ctx" role="menu" aria-label="Copiar">
    <button type="button" role="menuitem" data-copiar="tabla"><i class="bi bi-table"></i> Copiar tabla completa <small id="cvCtxFilas"></small></button>
    <button type="button" role="menuitem" data-copiar="fila"><i class="bi bi-distribute-vertical"></i> Copiar este renglón</button>
    <button type="button" role="menuitem" data-copiar="celda"><i class="bi bi-input-cursor-text"></i> Copiar esta celda</button>
    <hr />
    <button type="button" role="menuitem" data-copiar="excel"><i class="bi bi-file-earmark-excel"></i> Descargar en Excel (con detalle)</button>
</div>
<div id="cvToast" class="cv-toast" role="status" aria-live="polite"></div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <script>
        (() => {
            const URL_RESUMEN = '/Comercial/ObtenerSurtidosMeatResumen';
            const URL_DETALLE = '/Comercial/ObtenerSurtidosMeatDetalle';
            const URL_DETALLE_EXCEL = '/Comercial/ObtenerSurtidosMeatDetalleExcel';
            const URL_SERIES = '/Comercial/ObtenerSeriesSurtidosMeat';

            const $ = id => document.getElementById(id);
            const $frm = $('frm-filtros'), $cliente = $('txt-cliente'), $folio = $('txt-folio');
            const $msSerie = $('ms-serie'), $btnSerie = $('btn-serie'), $lblSerie = $('lbl-serie'), $buscarSerie = $('txt-buscar-serie'), $lstSerie = $('lst-serie');
            const $fechaInicio = $('txt-fecha-inicio'), $fechaFin = $('txt-fecha-fin'), $tipo = $('sel-tipo'), $embarque = $('txt-embarque'), $ruta = $('txt-ruta');
            const $btnLimpiar = $('btn-limpiar'), $btnExcel = $('btn-excel'), $btnBuscar = $('btn-buscar'), $tbody = $('tbody-surtidos');
            const $kpiKgPedidos = $('kpi-kg-pedidos'), $kpiCajasPedidas = $('kpi-cajas-pedidas'), $kpiKgSurtidos = $('kpi-kg-surtidos');
            const $kpiCajasSurtidas = $('kpi-cajas-surtidas'), $kpiGapKg = $('kpi-gap-kg'), $kpiGapCajas = $('kpi-gap-cajas');

            const nf = new Intl.NumberFormat('es-MX', { maximumFractionDigits: 0 });
            const nfPct = new Intl.NumberFormat('es-MX', { minimumFractionDigits: 0, maximumFractionDigits: 2 });

            let resumenActual = [], detalleCache = {}, seriesCatalogo = [], seriesSeleccionadas = new Set();
            let sortCol = null, sortDir = 'asc';

            // ---------- Utilidades ----------
            const num = v => nf.format(Number(v || 0));
            const pct = v => nfPct.format(Number(v || 0)) + '%';
            const esVacio = v => v === null || v === undefined || v === '' || !isFinite(Number(v));
            const pctGap = v => esVacio(v) ? '-' : pct(v);
            // Semáforo sin cambios: ≥100 verde · ≥97 amarillo · <97 rojo · sin dato sin color
            function getGapClass(v) {
                if (esVacio(v)) return 'gap-empty';
                const n = Number(v);
                return n >= 100 ? 'gap-ok' : n >= 97 ? 'gap-warn' : 'gap-bad';
            }
            function setKpiCardGapClass(el, v) {
                const card = el?.closest('.kpi-card');
                if (!card) return;
                card.classList.remove('kpi-gap-ok', 'kpi-gap-warn', 'kpi-gap-bad', 'kpi-gap-empty');
                card.classList.add(`kpi-${getGapClass(v)}`);
            }
            const getGapKgValue = item => item?.gapKg ?? item?.gapKG ?? null;
            const getGapCajaValue = item => item?.gapCaja ?? item?.gapCajas ?? null;
            const escapeHtml = v => String(v ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
            function formatFecha(v) {
                if (!v) return '';
                const s = String(v);
                // CORRECCIÓN: se toma la fecha tal cual (yyyy-mm-dd) para evitar que salga un día antes por zona horaria
                const m = s.match(/^(\d{4})-(\d{2})-(\d{2})/);
                if (m) return `${m[1]}-${m[2]}-${m[3]}`;
                const d = new Date(v);
                return isNaN(d) ? '' : `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
            }
            const getDetalleKey = (folio, tipo, serie) => `${tipo || ''}__${serie || ''}__${folio || ''}`;
            const getSerieValue = item => item?.serie ?? item?.Serie ?? '';
            const getSeriesParam = () => Array.from(seriesSeleccionadas).join(',');
            const msgFila = (texto, error) => `<tr class="t-msg${error ? ' is-error' : ''}"><td colspan="14">${escapeHtml(texto)}</td></tr>`;

            async function leerJson(res, nombre) {
                const raw = await res.text();
                try { return JSON.parse(raw); }
                catch { console.error(`Respuesta no JSON de ${nombre}:`, raw); throw new Error(`El servidor respondió ${res.status} sin datos válidos.`); }
            }

            function parametros() {
                return new URLSearchParams({
                    cliente: $cliente.value.trim(), folio: $folio.value.trim(), serie: getSeriesParam(),
                    fechaInicio: $fechaInicio.value || '', fechaFin: $fechaFin.value || '', tipo: $tipo.value || '',
                    embarque: $embarque.value.trim(), ruta: $ruta.value.trim()
                });
            }

            // ---------- Ordenar ----------
            function getSortValue(item, col) {
                switch (col) {
                    case 'tipo': return (item.tipo || '').toLowerCase();
                    case 'serie': return getSerieValue(item).toLowerCase();
                    case 'folio': return (item.folio || '').toLowerCase();
                    case 'cliente': return (item.cliente || '').toLowerCase();
                    case 'fecha': return formatFecha(item.fecha);
                    case 'embarque': return (item.embarque || '').toLowerCase();
                    case 'ruta': return (item.ruta || '').toLowerCase();
                    case 'kgPedidos': return Number(item.kgPedidos || 0);
                    case 'cajasPedidas': return Number(item.cajasPedidas || 0);
                    case 'kgSurtidos': return Number(item.kgSurtidos || 0);
                    case 'cajasSurtidas': return Number(item.cajasSurtidas || 0);
                    case 'gapKg': return esVacio(getGapKgValue(item)) ? null : Number(getGapKgValue(item));
                    case 'gapCaja': return esVacio(getGapCajaValue(item)) ? null : Number(getGapCajaValue(item));
                    default: return '';
                }
            }
            function applySortUI() {
                document.querySelectorAll('#tbl-surtidos thead th[data-col]').forEach(th => {
                    th.classList.remove('sort-asc', 'sort-desc');
                    th.removeAttribute('aria-sort');
                    if (th.dataset.col === sortCol) { th.classList.add(sortDir === 'asc' ? 'sort-asc' : 'sort-desc'); th.setAttribute('aria-sort', sortDir === 'asc' ? 'ascending' : 'descending'); }
                });
            }
            function sortedData() {
                if (!sortCol) return resumenActual;
                return [...resumenActual].sort((a, b) => {
                    const va = getSortValue(a, sortCol), vb = getSortValue(b, sortCol);
                    // CORRECCIÓN: los renglones sin GAP van siempre al final (antes se mezclaban como 0)
                    if (va === null && vb === null) return 0;
                    if (va === null) return 1;
                    if (vb === null) return -1;
                    return va < vb ? (sortDir === 'asc' ? -1 : 1) : va > vb ? (sortDir === 'asc' ? 1 : -1) : 0;
                });
            }
            document.querySelectorAll('#tbl-surtidos thead th[data-col]').forEach(th => {
                th.querySelector('.th-inner').addEventListener('click', () => {
                    const col = th.dataset.col;
                    if (sortCol === col) sortDir = sortDir === 'asc' ? 'desc' : 'asc'; else { sortCol = col; sortDir = 'asc'; }
                    applySortUI();
                    rerenderRows();
                });
            });

            // ---------- Tabla ----------
            function setEmpty(msg, error) {
                resumenActual = []; detalleCache = {};
                $tbody.innerHTML = msgFila(msg, error);
                $('cv-conteo').textContent = '';
            }
            function buildResumenRow(item, idx) {
                const tr = document.createElement('tr');
                tr.dataset.folio = item.folio || '';
                tr.dataset.tipo = item.tipo || '';
                tr.dataset.serie = getSerieValue(item);
                const gapKg = getGapKgValue(item), gapCaja = getGapCajaValue(item);
                tr.innerHTML = `
                    <td class="text-center" data-copy="${idx + 1}"><div class="cv-idx"><span>${idx + 1}</span><button type="button" class="toggle-btn js-expand" data-open="0" aria-expanded="false" aria-label="Ver SKU de ${escapeHtml(item.folio || '')}"><i class="bi bi-chevron-right"></i></button></div></td>
                    <td>${escapeHtml(item.tipo || '')}</td>
                    <td>${escapeHtml(getSerieValue(item))}</td>
                    <td>${escapeHtml(item.folio || '')}</td>
                    <td title="${escapeHtml(item.cliente || '')}"><span class="clamp-2">${escapeHtml(item.cliente || '')}</span></td>
                    <td>${escapeHtml(formatFecha(item.fecha))}</td>
                    <td>${escapeHtml(item.embarque || '')}</td>
                    <td title="${escapeHtml(item.ruta || '')}"><span class="clamp-2">${escapeHtml(item.ruta || '')}</span></td>
                    <td class="text-end">${num(item.kgPedidos)}</td>
                    <td class="text-end">${num(item.cajasPedidas)}</td>
                    <td class="text-end">${num(item.kgSurtidos)}</td>
                    <td class="text-end">${num(item.cajasSurtidas)}</td>
                    <td class="text-end ${getGapClass(gapKg)}">${pctGap(gapKg)}</td>
                    <td class="text-end ${getGapClass(gapCaja)}">${pctGap(gapCaja)}</td>`;
                return tr;
            }
            function rerenderRows() {
                const frag = document.createDocumentFragment();
                sortedData().forEach((item, idx) => frag.appendChild(buildResumenRow(item, idx)));
                $tbody.innerHTML = '';
                $tbody.appendChild(frag);
            }
            function renderResumen(data) {
                resumenActual = Array.isArray(data) ? data : [];
                detalleCache = {};
                if (!resumenActual.length) { setEmpty('Sin pedidos ni transferencias con estos filtros.'); renderKpis([]); return; }
                applySortUI();
                rerenderRows();
                renderKpis(resumenActual);
                const ov = resumenActual.filter(x => String(x.tipo || '').toUpperCase() === 'OV').length;
                $('cv-conteo').textContent = `· ${resumenActual.length} documento(s) · ${ov} OV · ${resumenActual.length - ov} TR`;
            }
            function renderKpis(data) {
                const sum = f => data.reduce((a, b) => a + Number(b[f] || 0), 0);
                const kgP = sum('kgPedidos'), cjP = sum('cajasPedidas'), kgS = sum('kgSurtidos'), cjS = sum('cajasSurtidas');
                // CORRECCIÓN: sin datos el cumplimiento queda vacío (antes mostraba 0% en rojo)
                const gapKg = kgP > 0 ? (kgS * 100) / kgP : null;
                const gapCj = cjP > 0 ? (cjS * 100) / cjP : null;
                $kpiKgPedidos.textContent = num(kgP);
                $kpiCajasPedidas.textContent = num(cjP);
                $kpiKgSurtidos.textContent = num(kgS);
                $kpiCajasSurtidas.textContent = num(cjS);
                $kpiGapKg.textContent = pctGap(gapKg);
                $kpiGapCajas.textContent = pctGap(gapCj);
                setKpiCardGapClass($kpiGapKg, gapKg);
                setKpiCardGapClass($kpiGapCajas, gapCj);
            }

            // ---------- Detalle por SKU ----------
            function buildDetailShell(folio, tipo, serie) {
                const tr = document.createElement('tr');
                tr.className = 'detail-row';
                tr.innerHTML = `
                    <td colspan="14">
                        <div class="detail-box">
                            <div class="detail-head">SKU de ${escapeHtml(folio)}${serie ? ' · serie ' + escapeHtml(serie) : ''}</div>
                            <div class="detail-table-wrap">
                                <table class="detail-table">
                                    <colgroup><col style="width:9%"><col style="width:31%"><col style="width:10%"><col style="width:10%"><col style="width:10%"><col style="width:10%"><col style="width:10%"><col style="width:10%"></colgroup>
                                    <thead><tr><th>SKU</th><th>Producto</th><th class="text-end">Kg pedidos</th><th class="text-end">Cajas pedidas</th><th class="text-end">Kg surtidos</th><th class="text-end">Cajas surtidas</th><th class="text-end">GAP kg</th><th class="text-end">GAP caja</th></tr></thead>
                                    <tbody><tr class="t-msg"><td colspan="8">Cargando detalle…</td></tr></tbody>
                                </table>
                            </div>
                        </div>
                    </td>`;
                return tr;
            }
            function renderDetailRows(items) {
                return items.map(x => {
                    // CORRECCIÓN: un GAP sin dato se muestra "-" sin color (antes salía 0% en rojo)
                    const gk = x?.gapKg ?? x?.gapKG ?? null, gc = x?.gapCaja ?? x?.gapCajas ?? null;
                    return `<tr>
                        <td>${escapeHtml(x.sku || '')}</td>
                        <td class="td-wrap">${escapeHtml(x.producto || '')}</td>
                        <td class="text-end">${num(x.kgPedidos)}</td>
                        <td class="text-end">${num(x.cajasPedidas)}</td>
                        <td class="text-end">${num(x.kgSurtidos)}</td>
                        <td class="text-end">${num(x.cajasSurtidas)}</td>
                        <td class="text-end ${getGapClass(gk)}">${pctGap(gk)}</td>
                        <td class="text-end ${getGapClass(gc)}">${pctGap(gc)}</td>
                    </tr>`;
                }).join('');
            }
            async function cargarDetalle(trMaster) {
                const folio = trMaster.dataset.folio, tipo = trMaster.dataset.tipo, serie = trMaster.dataset.serie || '';
                const btn = trMaster.querySelector('.js-expand');
                const key = getDetalleKey(folio, tipo, serie);
                if (btn.dataset.open === '1') {
                    const next = trMaster.nextElementSibling;
                    if (next && next.classList.contains('detail-row')) next.remove();
                    trMaster.classList.remove('is-open');
                    btn.dataset.open = '0'; btn.setAttribute('aria-expanded', 'false');
                    return;
                }
                const shell = buildDetailShell(folio, tipo, serie);
                trMaster.insertAdjacentElement('afterend', shell);
                trMaster.classList.add('is-open');
                btn.dataset.open = '1'; btn.setAttribute('aria-expanded', 'true');
                const tbody = shell.querySelector('tbody');
                if (detalleCache[key]?.length) { tbody.innerHTML = renderDetailRows(detalleCache[key]); return; }
                try {
                    const res = await fetch(`${URL_DETALLE}?${new URLSearchParams({ folio, tipo, serie })}`, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                    const json = await leerJson(res, 'ObtenerSurtidosMeatDetalle');
                    if (!Array.isArray(json) || !json.length) { detalleCache[key] = []; tbody.innerHTML = '<tr class="t-msg"><td colspan="8">Sin detalle.</td></tr>'; return; }
                    detalleCache[key] = json;
                    tbody.innerHTML = renderDetailRows(json);
                } catch {
                    tbody.innerHTML = '<tr class="t-msg is-error"><td colspan="8">Error al cargar el detalle. Cierra y vuelve a abrir para reintentar.</td></tr>';
                }
            }

            // ---------- Serie (selección múltiple) ----------
            const normalizarSerie = x => typeof x === 'string' ? x.trim() : String(x?.serie ?? x?.Serie ?? '').trim();
            function actualizarLabelSeries() {
                const arr = Array.from(seriesSeleccionadas);
                $lblSerie.textContent = !arr.length ? 'Todas' : arr.length <= 2 ? arr.join(', ') : `${arr.length} seleccionadas`;
                $btnSerie.classList.toggle('has-value', arr.length > 0);
                $btnSerie.title = arr.join(', ');
            }
            function renderSerieOptions() {
                const texto = ($buscarSerie.value || '').trim().toLowerCase();
                const filtradas = seriesCatalogo.filter(s => !texto || s.toLowerCase().includes(texto));
                $lstSerie.innerHTML = filtradas.length
                    ? filtradas.map(s => `<label class="cg-ms-item"><input type="checkbox" value="${escapeHtml(s)}" ${seriesSeleccionadas.has(s) ? 'checked' : ''} /><span>${escapeHtml(s)}</span></label>`).join('')
                    : `<div class="cg-ms-empty">${seriesCatalogo.length ? 'Sin coincidencias.' : 'No se pudieron cargar las series.'}</div>`;
            }
            async function cargarSeries() {
                try {
                    const res = await fetch(URL_SERIES, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                    const json = await leerJson(res, 'ObtenerSeriesSurtidosMeat');
                    seriesCatalogo = Array.from(new Set((Array.isArray(json) ? json : []).map(normalizarSerie).filter(Boolean))).sort((a, b) => a.localeCompare(b));
                } catch (e) { console.warn('No fue posible cargar series.', e); seriesCatalogo = []; }
                renderSerieOptions();
                actualizarLabelSeries();
            }
            function abrirSerie(abrir) {
                $msSerie.classList.toggle('open', abrir);
                $btnSerie.setAttribute('aria-expanded', String(abrir));
                if (abrir) setTimeout(() => $buscarSerie.focus(), 0);
            }
            $btnSerie.addEventListener('click', e => { e.preventDefault(); e.stopPropagation(); abrirSerie(!$msSerie.classList.contains('open')); });
            document.addEventListener('click', e => { if (!$msSerie.contains(e.target)) abrirSerie(false); });
            $msSerie.addEventListener('keydown', e => { if (e.key === 'Escape') { abrirSerie(false); $btnSerie.focus(); } });
            $buscarSerie.addEventListener('input', renderSerieOptions);
            $buscarSerie.addEventListener('keydown', e => { if (e.key === 'Enter') e.preventDefault(); });
            $lstSerie.addEventListener('change', e => {
                const chk = e.target.closest('input[type="checkbox"]');
                if (!chk) return;
                chk.checked ? seriesSeleccionadas.add(chk.value) : seriesSeleccionadas.delete(chk.value);
                actualizarLabelSeries();
            });
            $('btn-serie-todas').addEventListener('click', () => { $lstSerie.querySelectorAll('input').forEach(c => { c.checked = true; seriesSeleccionadas.add(c.value); }); actualizarLabelSeries(); });
            $('btn-serie-ninguna').addEventListener('click', () => { seriesSeleccionadas.clear(); renderSerieOptions(); actualizarLabelSeries(); });

            // ---------- Consulta ----------
            function validarFechas() {
                const aviso = $('cv-filtro-aviso');
                aviso.textContent = '';
                if ($fechaInicio.value && $fechaFin.value && $fechaInicio.value > $fechaFin.value) {
                    // CORRECCIÓN: si las fechas vienen al revés se intercambian y se avisa (antes no traía nada)
                    [$fechaInicio.value, $fechaFin.value] = [$fechaFin.value, $fechaInicio.value];
                    aviso.textContent = 'Las fechas estaban invertidas; se intercambiaron.';
                }
            }
            let _seq = 0;
            async function cargarResumen() {
                const seq = ++_seq; // CORRECCIÓN: solo se pinta la consulta más reciente
                validarFechas();
                abrirSerie(false);
                $tbody.innerHTML = msgFila('Cargando…');
                $btnBuscar.disabled = true;
                try {
                    const res = await fetch(`${URL_RESUMEN}?${parametros()}`, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                    const json = await leerJson(res, 'ObtenerSurtidosMeatResumen');
                    if (seq !== _seq) return;
                    if (!Array.isArray(json)) { setEmpty('No fue posible cargar la información.', true); renderKpis([]); return; }
                    renderResumen(json);
                } catch (e) {
                    console.error(e);
                    if (seq !== _seq) return;
                    setEmpty('Error al cargar la información. ' + (e.message || ''), true);
                    renderKpis([]);
                } finally {
                    if (seq === _seq) $btnBuscar.disabled = false;
                }
            }

            // ---------- Excel (mismo contenido; el GAP sin dato queda vacío en lugar de 0) ----------
            let exportando = false;
            async function exportarExcel() {
                if (exportando) return;
                if (typeof XLSX === 'undefined') { alert('La biblioteca de Excel no se cargó.'); return; }
                validarFechas();
                exportando = true;
                const original = $btnExcel.innerHTML;
                $btnExcel.disabled = true;
                $btnExcel.innerHTML = '<i class="bi bi-hourglass-split"></i> Exportando…';
                const params = parametros();
                const gapExcel = v => esVacio(v) ? '' : Number(v);
                try {
                    const [resR, resD] = await Promise.all([
                        fetch(`${URL_RESUMEN}?${params}`, { headers: { 'X-Requested-With': 'XMLHttpRequest' } }),
                        fetch(`${URL_DETALLE_EXCEL}?${params}`, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
                    ]);
                    const resumenJson = await leerJson(resR, 'Resumen');
                    const detalleJson = await leerJson(resD, 'DetalleExcel');
                    if (!Array.isArray(resumenJson) || !resumenJson.length) { alert('No hay datos para exportar.'); return; }
                    const resumenRows = resumenJson.map(x => ({
                        Tipo: x.tipo || '', Serie: getSerieValue(x), Folio: x.folio || '', Cliente: x.cliente || '', Fecha: formatFecha(x.fecha),
                        Embarque: x.embarque || '', Ruta: x.ruta || '',
                        'Kg pedidos': Number(x.kgPedidos || 0), 'Cajas pedidas': Number(x.cajasPedidas || 0),
                        'Kg surtidos': Number(x.kgSurtidos || 0), 'Cajas surtidas': Number(x.cajasSurtidas || 0),
                        'GAP kg %': gapExcel(getGapKgValue(x)), 'GAP cajas %': gapExcel(getGapCajaValue(x))
                    }));
                    const detalleRows = Array.isArray(detalleJson) ? detalleJson.map(x => ({
                        Tipo: x.tipo || '', Serie: getSerieValue(x), Folio: x.folio || '', Cliente: x.cliente || '', Fecha: formatFecha(x.fecha),
                        SKU: x.sku || '', Producto: x.producto || '',
                        'Kg pedidos': Number(x.kgPedidos || 0), 'Cajas pedidas': Number(x.cajasPedidas || 0),
                        'Kg surtidos': Number(x.kgSurtidos || 0), 'Cajas surtidas': Number(x.cajasSurtidas || 0),
                        'GAP kg %': gapExcel(getGapKgValue(x)), 'GAP caja %': gapExcel(getGapCajaValue(x))
                    })) : [];
                    const wb = XLSX.utils.book_new();
                    const wsR = XLSX.utils.json_to_sheet(resumenRows);
                    wsR['!cols'] = [{ wch: 8 }, { wch: 12 }, { wch: 16 }, { wch: 36 }, { wch: 12 }, { wch: 14 }, { wch: 26 }, { wch: 12 }, { wch: 13 }, { wch: 12 }, { wch: 14 }, { wch: 10 }, { wch: 12 }];
                    XLSX.utils.book_append_sheet(wb, wsR, 'Resumen');
                    const wsD = XLSX.utils.json_to_sheet(detalleRows.length ? detalleRows : [{ Mensaje: 'Sin detalle.' }]);
                    wsD['!cols'] = detalleRows.length ? [{ wch: 8 }, { wch: 12 }, { wch: 16 }, { wch: 36 }, { wch: 12 }, { wch: 12 }, { wch: 40 }, { wch: 12 }, { wch: 13 }, { wch: 12 }, { wch: 14 }, { wch: 10 }, { wch: 10 }] : [{ wch: 40 }];
                    XLSX.utils.book_append_sheet(wb, wsD, 'Detalle');
                    const hoy = new Date();
                    XLSX.writeFile(wb, `ConfirmadoVsEmbarcado_${hoy.getFullYear()}${String(hoy.getMonth() + 1).padStart(2, '0')}${String(hoy.getDate()).padStart(2, '0')}.xlsx`);
                } catch (e) {
                    console.error(e);
                    alert('Ocurrió un error al exportar el Excel.');
                } finally {
                    exportando = false;
                    $btnExcel.disabled = false;
                    $btnExcel.innerHTML = original;
                }
            }

            // ---------- Eventos ----------
            function ponerFechaHoy() {
                const hoy = new Date();
                const ts = `${hoy.getFullYear()}-${String(hoy.getMonth() + 1).padStart(2, '0')}-${String(hoy.getDate()).padStart(2, '0')}`;
                $fechaInicio.value = ts; $fechaFin.value = ts;
            }
            $frm.addEventListener('submit', e => { e.preventDefault(); cargarResumen(); });
            $btnLimpiar.addEventListener('click', () => {
                $cliente.value = ''; $folio.value = ''; $tipo.value = ''; $embarque.value = ''; $ruta.value = '';
                seriesSeleccionadas.clear(); $buscarSerie.value = '';
                renderSerieOptions(); actualizarLabelSeries(); ponerFechaHoy();
                cargarResumen();
            });
            $btnExcel.addEventListener('click', exportarExcel);
            $tbody.addEventListener('click', e => { const btn = e.target.closest('.js-expand'); if (btn) cargarDetalle(btn.closest('tr')); });

            // ---------- Copiar con clic derecho ----------
            (function () {
                const menu = $('cvCtxMenu'), toast = $('cvToast');
                let ctx = null;
                const limpio = t => (t || '').replace(/\s+/g, ' ').trim();
                function textoCelda(td) {
                    if (td.dataset.copy !== undefined) return td.dataset.copy;
                    let t = limpio(td.innerText);
                    if (t === '-') return '';
                    if (td.classList.contains('text-end')) {
                        const n = t.replace(/,/g, '').replace(/%$/, '');
                        if (n !== '' && !isNaN(Number(n))) t = n;
                    }
                    return t;
                }
                const esPrincipal = t => t.id === 'tbl-surtidos';
                const filasDatos = t => esPrincipal(t) ? [...t.tBodies[0].rows].filter(r => r.dataset.folio !== undefined) : [...t.tBodies[0].rows].filter(r => !r.classList.contains('t-msg'));
                const encabezados = t => [...t.tHead.rows[0].cells].map(th => limpio(th.innerText).replace(/^#$/, 'No.'));
                const filaTexto = tr => [...tr.cells].map(textoCelda);
                const aTsv = filas => filas.map(f => f.map(v => /[\t\n"]/.test(v) ? `"${v.replace(/"/g, '""')}"` : v).join('\t')).join('\r\n');
                const escH = v => String(v ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
                const aHtml = (filas, enc) => `<table>${filas.map((f, i) => `<tr>${f.map(v => (enc && i === 0) ? `<th>${escH(v)}</th>` : `<td>${escH(v)}</td>`).join('')}</tr>`).join('')}</table>`;
                function avisar(msg) { toast.textContent = msg; toast.classList.add('show'); clearTimeout(avisar._t); avisar._t = setTimeout(() => toast.classList.remove('show'), 2200); }
                async function copiar(filas, enc, msg) {
                    const tsv = aTsv(filas);
                    try {
                        if (window.ClipboardItem && navigator.clipboard?.write) {
                            await navigator.clipboard.write([new ClipboardItem({ 'text/plain': new Blob([tsv], { type: 'text/plain' }), 'text/html': new Blob([aHtml(filas, enc)], { type: 'text/html' }) })]);
                        } else if (navigator.clipboard?.writeText) await navigator.clipboard.writeText(tsv);
                        else throw 0;
                        avisar(msg);
                    } catch {
                        const ta = document.createElement('textarea');
                        ta.value = tsv; ta.style.cssText = 'position:fixed;left:-9999px;top:0';
                        document.body.appendChild(ta); ta.select();
                        const ok = document.execCommand('copy'); ta.remove();
                        avisar(ok ? msg : 'No se pudo copiar; usa Descargar en Excel.');
                    }
                }
                function cerrar() { menu.classList.remove('show'); document.querySelectorAll('.ctx-cell').forEach(x => x.classList.remove('ctx-cell')); ctx = null; }

                $('tbl-surtidos').addEventListener('contextmenu', e => {
                    // El detalle de SKU está dentro de la tabla principal: se copia la tabla más cercana al clic
                    const tabla = e.target.closest('.detail-table') || $('tbl-surtidos');
                    const n = filasDatos(tabla).length;
                    if (!n) return;
                    e.preventDefault();
                    cerrar();
                    const td = e.target.closest('td');
                    const tr = td?.closest('tr');
                    const valida = tr && tr.closest('table') === tabla && !tr.classList.contains('t-msg') && !tr.classList.contains('detail-row');
                    ctx = { tabla, fila: valida ? tr : null, celda: valida ? td : null };
                    if (ctx.celda) ctx.celda.classList.add('ctx-cell');
                    menu.querySelector('[data-copiar="fila"]').hidden = !ctx.fila;
                    menu.querySelector('[data-copiar="celda"]').hidden = !ctx.celda;
                    menu.querySelector('[data-copiar="tabla"]').firstChild.nextSibling.textContent = esPrincipal(tabla) ? ' Copiar tabla completa ' : ' Copiar detalle de SKU ';
                    $('cvCtxFilas').textContent = `${n} renglón${n === 1 ? '' : 'es'}`;
                    menu.classList.add('show');
                    const r = menu.getBoundingClientRect();
                    menu.style.left = Math.min(e.clientX, window.innerWidth - r.width - 8) + 'px';
                    menu.style.top = Math.min(e.clientY, window.innerHeight - r.height - 8) + 'px';
                    menu.querySelector('button:not([hidden])')?.focus();
                });
                menu.addEventListener('click', async e => {
                    const b = e.target.closest('button[data-copiar]');
                    if (!b || !ctx) return;
                    const { tabla, fila, celda } = ctx;
                    const accion = b.dataset.copiar;
                    cerrar();
                    if (accion === 'tabla') { const filas = filasDatos(tabla).map(filaTexto); await copiar([encabezados(tabla), ...filas], true, `Copiado (${filas.length} renglones). Pégalo en Excel con Ctrl+V.`); }
                    else if (accion === 'fila' && fila) await copiar([encabezados(tabla), filaTexto(fila)], true, 'Renglón copiado con encabezados.');
                    else if (accion === 'celda' && celda) await copiar([[textoCelda(celda)]], false, 'Celda copiada.');
                    else if (accion === 'excel') exportarExcel();
                });
                document.addEventListener('click', e => { if (menu.classList.contains('show') && !menu.contains(e.target)) cerrar(); });
                document.addEventListener('keydown', e => {
                    if (!menu.classList.contains('show')) return;
                    if (e.key === 'Escape') { e.preventDefault(); cerrar(); return; }
                    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
                        e.preventDefault();
                        const bs = [...menu.querySelectorAll('button:not([hidden])')];
                        const i = bs.indexOf(document.activeElement);
                        bs[(i + (e.key === 'ArrowDown' ? 1 : -1) + bs.length) % bs.length]?.focus();
                    }
                });
                ['scroll', 'resize', 'blur'].forEach(ev => window.addEventListener(ev, () => { if (menu.classList.contains('show')) cerrar(); }, true));
            })();

            (async function init() {
                ponerFechaHoy();
                await cargarSeries();
                await cargarResumen();
            })();
        })();
    </script>
}
