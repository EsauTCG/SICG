    /* Reacciona al ancho REAL del contenedor que deja el sidebar. */
    @@container confirmado-embarcado (max-width: 1380px) {
        #confirmadoEmbarcadoApp .filters {
            grid-template-columns: repeat(8, minmax(0, 1fr)) !important;
        }

        #confirmadoEmbarcadoApp .filters > div:nth-child(1) { grid-column: span 3 !important; }
        #confirmadoEmbarcadoApp .filters > div:nth-child(2) { grid-column: span 1 !important; }
        #confirmadoEmbarcadoApp .filters > div:nth-child(3) { grid-column: span 2 !important; }
        #confirmadoEmbarcadoApp .filters > div:nth-child(4) { grid-column: span 1 !important; }
        #confirmadoEmbarcadoApp .filters > div:nth-child(5) { grid-column: span 1 !important; }
        #confirmadoEmbarcadoApp .filters > div:nth-child(6) { grid-column: span 2 !important; }
        #confirmadoEmbarcadoApp .filters > div:nth-child(7) { grid-column: span 6 !important; }

        #confirmadoEmbarcadoApp .kpis {
            grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
        }
    }

    @@container confirmado-embarcado (max-width: 900px) {
        #confirmadoEmbarcadoApp .filters {
            grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
        }

        #confirmadoEmbarcadoApp .filters > div:nth-child(1) { grid-column: span 2 !important; }
        #confirmadoEmbarcadoApp .filters > div:nth-child(2),
        #confirmadoEmbarcadoApp .filters > div:nth-child(3),
        #confirmadoEmbarcadoApp .filters > div:nth-child(4),
        #confirmadoEmbarcadoApp .filters > div:nth-child(5),
        #confirmadoEmbarcadoApp .filters > div:nth-child(6) { grid-column: span 1 !important; }
        #confirmadoEmbarcadoApp .filters > div:nth-child(7) { grid-column: 1 / -1 !important; }

        #confirmadoEmbarcadoApp .kpis {
            grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        }
    }

    @@container confirmado-embarcado (max-width: 620px) {
        #confirmadoEmbarcadoApp .filters,
        #confirmadoEmbarcadoApp .kpis {
            grid-template-columns: 1fr !important;
        }

        #confirmadoEmbarcadoApp .filters > div {
            grid-column: auto !important;
        }

        #confirmadoEmbarcadoApp .filters > div:nth-child(7) {
            grid-template-columns: 1fr !important;
        }
    }


    /* =========================================================
       SEMÁFORO GAP - REGLAS FINALES
       Estas reglas van al final para que zebra/hover no borren
       los colores de GAP Kg y GAP Caja.
       >= 100% = verde
       >= 97% y < 100% = amarillo
       < 97% = rojo
       sin dato = sin semáforo
       ========================================================= */

    /* VERDE */
    #confirmadoEmbarcadoApp #tbl-surtidos tbody td.gap-ok,
    #confirmadoEmbarcadoApp #tbl-surtidos tbody tr:nth-of-type(even) > td.gap-ok,
    #confirmadoEmbarcadoApp #tbl-surtidos tbody tr:hover > td.gap-ok,
    #confirmadoEmbarcadoApp #tbl-surtidos tbody tr.is-open > td.gap-ok,
    #confirmadoEmbarcadoApp .detail-table tbody td.gap-ok,
    #confirmadoEmbarcadoApp .detail-table tbody tr:nth-of-type(even) > td.gap-ok,
    #confirmadoEmbarcadoApp .detail-table tbody tr:hover > td.gap-ok {
        background: #198754 !important;
        background-color: #198754 !important;
        color: #ffffff !important;
        font-weight: 700 !important;
    }

    /* AMARILLO */
    #confirmadoEmbarcadoApp #tbl-surtidos tbody td.gap-warn,
    #confirmadoEmbarcadoApp #tbl-surtidos tbody tr:nth-of-type(even) > td.gap-warn,
    #confirmadoEmbarcadoApp #tbl-surtidos tbody tr:hover > td.gap-warn,
    #confirmadoEmbarcadoApp #tbl-surtidos tbody tr.is-open > td.gap-warn,
    #confirmadoEmbarcadoApp .detail-table tbody td.gap-warn,
    #confirmadoEmbarcadoApp .detail-table tbody tr:nth-of-type(even) > td.gap-warn,
    #confirmadoEmbarcadoApp .detail-table tbody tr:hover > td.gap-warn {
        background: #ffc107 !important;
        background-color: #ffc107 !important;
        color: #111111 !important;
        font-weight: 700 !important;
    }

    /* ROJO */
    #confirmadoEmbarcadoApp #tbl-surtidos tbody td.gap-bad,
    #confirmadoEmbarcadoApp #tbl-surtidos tbody tr:nth-of-type(even) > td.gap-bad,
    #confirmadoEmbarcadoApp #tbl-surtidos tbody tr:hover > td.gap-bad,
    #confirmadoEmbarcadoApp #tbl-surtidos tbody tr.is-open > td.gap-bad,
    #confirmadoEmbarcadoApp .detail-table tbody td.gap-bad,
    #confirmadoEmbarcadoApp .detail-table tbody tr:nth-of-type(even) > td.gap-bad,
    #confirmadoEmbarcadoApp .detail-table tbody tr:hover > td.gap-bad {
        background: #dc3545 !important;
        background-color: #dc3545 !important;
        color: #ffffff !important;
        font-weight: 700 !important;
    }

    /* SIN DATO */
    #confirmadoEmbarcadoApp #tbl-surtidos tbody td.gap-empty,
    #confirmadoEmbarcadoApp .detail-table tbody td.gap-empty {
        background: transparent !important;
        background-color: transparent !important;
        color: var(--sap-text) !important;
        font-weight: 700 !important;
    }

</style>

