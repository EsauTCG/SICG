            return { init: async () => { bind(); await cargarCanales(); } };
          })();

          // =========================================================
          // ========================== VENDEDOR ======================
          // =========================================================
          const VENDEDOR = (function () {

            function updateTotales() {
              let obj = 0, pre = 0;
              document.querySelectorAll('#tbodyVendedor input[name$=".Objetivo"]').forEach(x => obj += Number(x.value || 0));
              document.querySelectorAll('#tbodyVendedor input.pre').forEach(x => pre += Number(x.value || 0));
              document.getElementById('venTotObj').textContent = fmt(obj);
              document.getElementById('venTotPre').textContent = fmt(pre);
            }

            function recalcPart() {
              const pres = [...document.querySelectorAll('#tbodyVendedor input.pre')];
              const tot = pres.reduce((a, i) => a + Number(i.value || 0), 0);
              pres.forEach(inp => {
                const td = inp.closest('tr').querySelector('.part-cell');
                const v = Number(inp.value || 0);
                td.textContent = (tot > 0 ? (v * 100 / tot) : 0).toFixed(1) + '%';
              });
            }

            async function cargarVendedores() {
              const $sel = $("#selVendedor").empty().append('<option value="">Selecciona vendedor</option>');
              try {
                toggleSpin(true);
                const r = await fetch(API.vendedores, { credentials: 'same-origin' });
                const data = r.ok ? await r.json() : [];
                (data || []).forEach(v => {
                  const id = v.id ?? v.Id;
                  const nom = v.nombre ?? v.Nombre ?? '';
                  if (id == null) return;
                  $sel.append(`<option value="${escapeHtml(id)}">${escapeHtml(id)}${nom ? " - " + escapeHtml(nom) : ""}</option>`);
                });
              } catch {
                showToast("Error al cargar vendedores.", "danger");
              } finally {
                toggleSpin(false);
              }
            }

            async function traerVentas() {
              const vendedorId = parseInt($("#selVendedor").val() || "0", 10);
              const meses = parseInt($("#venMesesObjetivo").val() || "12", 10);
              if (!vendedorId) { showToast("Selecciona un vendedor.", "warning"); return null; }

              const url = `${API.datosVendedor}?vendedorId=${vendedorId}&meses=${meses}`;
              try {
                toggleSpin(true);
                const r = await fetch(url, { credentials: 'same-origin' });
                if (!r.ok) throw 0;

                const data = await r.json();
                if (!Array.isArray(data) || !data.length) {
                  showToast("Sin datos para ese vendedor.", "warning");
                  return null;
                }

                const refs = buildMonthRefs(meses);
                const porSku = {};

                data.forEach(d => {
                  const sku = d.sku || d.Sku || d.productoCodigo || d.ProductoCodigo;
                  if (!sku) return;

                  const f = new Date(d.fecha || d.Fecha);
                  const ym = `${f.getFullYear()}-${String(f.getMonth() + 1).padStart(2, '0')}`;

                  porSku[sku] = porSku[sku] || { porMes: {}, objetivo: 0, presupuesto: 0 };
                  porSku[sku].porMes[ym] = (porSku[sku].porMes[ym] || 0) + Number(d.totalKilos || d.TotalKilos || d.total || 0);
                });

                Object.keys(porSku).forEach(s => {
                  const sum = refs.reduce((a, r) => a + (porSku[s].porMes[r.key] || 0), 0);
                  porSku[s].objetivo = Math.round(sum / Math.max(1, meses));
                  porSku[s].presupuesto = porSku[s].objetivo;
                });

                return { porSku, refs };
              } catch {
                showToast("Error al consultar ventas por vendedor.", "danger");
                return null;
              } finally {
                toggleSpin(false);
              }
            }

            function renderTabla(model) {
              const { porSku, refs } = model;
              const thead = document.querySelector('#tablaVendedor thead');
              const tbody = document.getElementById('tbodyVendedor');

              const thMeses = refs.map(r => {
                const [m, y] = r.label.split(' ');
                return `<th class="text-end"><div class="text-capitalize">${escapeHtml(m)}</div><div class="small text-muted">${escapeHtml(y)}</div></th>`;
              }).join('');

              thead.innerHTML = `
                <tr>
                  <th>SKU</th>
                  ${thMeses}
                  <th class="text-end">Objetivo</th>
                  <th class="text-end">Presupuesto</th>
                  <th class="text-end">Participación</th>
                  <th class="text-center">Comentario</th>
                </tr>`;

              tbody.innerHTML = '';
              let i = 0;

              Object.keys(porSku).sort().forEach(sku => {
                const d = porSku[sku];
                if (!shouldIncludeRow(d.objetivo, d.presupuesto)) return;

                const tds = refs.map(r => `<td class="text-end">${fmt(d.porMes[r.key] || 0)}</td>`).join('');
                const skuSafe = escapeHtml(sku);

                tbody.insertAdjacentHTML('beforeend', `
                  <tr data-sku="${skuSafe}">
                    <td>${skuSafe}
                      <input type="hidden" name="items[${i}].ProductoCodigo" value="${skuSafe}">
                      <input type="hidden" name="items[${i}].Objetivo" value="${d.objetivo}">
                    </td>
                    ${tds}
                    <td class="text-end">${fmt(d.objetivo)}</td>
                    <td class="text-end">
                      <input type="number" class="form-control form-control-sm text-end pre" name="items[${i}].Presupuesto" value="${d.presupuesto}" min="0" step="1">
                    </td>
                    <td class="text-end part-cell">0.0%</td>
                    <td class="text-center">
                      <button type="button" class="btn btn-outline-secondary btn-sm btnComentarioVendedor"
                              data-sku="${skuSafe}" data-index="${i}" title="Agregar comentario">
                        <i class="bi bi-chat-left-text"></i>
                      </button>
                      <input type="hidden" name="items[${i}].Comentario" id="ven-comentario-${i}" />
                    </td>
                  </tr>`);
                i++;
              });

              updateTotales();
              recalcPart();
            }

            function bind() {
              let comentarioTargetId = null;

              $("#btnCargarVendedor").on("click", async function () {
                const res = await traerVentas();
                if (!res) return;
                renderTabla(res);
                showToast("Datos por vendedor cargados.", "success");
              });

              $(document).on('input', '#tbodyVendedor input.pre', () => { updateTotales(); recalcPart(); });

              // Comentarios
              $(document).on("click", ".btnComentarioVendedor", function () {
                const sku = $(this).data("sku");
                const index = $(this).data("index");
                const targetId = `ven-comentario-${index}`;
                comentarioTargetId = targetId;

                const ex = $(`#${targetId}`).val();
                $("#comentarioSkuVendedor").text(sku);
                $("#comentarioTextoVendedor").val(ex || "");

                bootstrap.Modal.getOrCreateInstance(document.getElementById("comentarioModalVendedor")).show();
              });

              $("#guardarComentarioVendedor").on("click", function () {
                const c = $("#comentarioTextoVendedor").val();
                if (comentarioTargetId) $(`#${comentarioTargetId}`).val(c);
                bootstrap.Modal.getInstance(document.getElementById('comentarioModalVendedor'))?.hide();
                showToast("Comentario vendedor guardado.", "success");
              });

              // Guardar
              $("#btnGuardarVendedor").on("click", async function () {
                const rows = document.querySelectorAll('#tbodyVendedor tr');
                if (!rows.length) { showToast("No hay filas para guardar.", "warning"); return; }

                let ok = true;
                document.querySelectorAll('#tbodyVendedor input.pre').forEach(i => {
                  if (Number(i.value || 0) <= 0) { ok = false; i.classList.add('is-invalid'); }
                  else i.classList.remove('is-invalid');
                });
                if (!ok) { showToast("Hay presupuestos en 0.", "danger"); return; }

                const mes = parseInt($("#venMes").val(), 10);
                const anio = parseInt($("#venAnio").val(), 10);
                if (!isPeriodoValido(mes, anio)) {
                  showToast("El periodo debe ser igual o posterior al mes actual.", "warning");
                  return;
                }

                const vendedorId = parseInt($("#selVendedor").val() || "0", 10);
                if (!vendedorId) { showToast("Selecciona un vendedor.", "warning"); return; }

                try {
                  toggleSpin(true);

                  const fd = new FormData();
                  fd.append("VendedorId", vendedorId);
                  fd.append("Mes", mes);
                  fd.append("Anio", anio);

                  document.querySelectorAll('#tbodyVendedor input[name^="items["]').forEach(inp => fd.append(inp.name, inp.value));

                  const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
                  const r = await fetch(API.guardarVendedor, {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: { 'RequestVerificationToken': token, 'X-Requested-With': 'XMLHttpRequest' },
                    body: fd
                  });

                  const ct = r.headers.get('content-type') || '';
                  const data = ct.includes('json') ? await r.json().catch(() => null) : null;

                  if (r.ok && (!data || data.ok || data.success)) {
                    showToast("Presupuesto por vendedor guardado.", "success");
                  } else {
                    showToast(data?.message || "No se pudo guardar.", "danger");
                  }
                } catch {
                  showToast("Error de red al guardar.", "danger");
                } finally {
                  toggleSpin(false);
                }
              });

              document.getElementById("tab-ven")?.addEventListener("shown.bs.tab", async () => {
                setPeriodoSiguienteMes($("#venMes"), $("#venAnio"));
                if (!$("#selVendedor option").length || $("#selVendedor option").length <= 1) {
                  await cargarVendedores();
                }
              });
            }

            return { init: bind };
          })();

          // =========================================================
          // ============================ CLIENTE =====================
          // =========================================================
          const CLIENTE = (function () {
            let _cliAll = [];
            let _cliFiltered = [];
            let _cliLoaded = false;
            let _binded = false;

            function cliUpdateTotales() {
              let obj = 0, pre = 0;
              document.querySelectorAll('#tbodyCliente input[name$=".Objetivo"]').forEach(x => obj += Number(x.value || 0));
              document.querySelectorAll('#tbodyCliente input.pre').forEach(x => pre += Number(x.value || 0));
              document.getElementById('cliTotObj').textContent = fmt(obj);
              document.getElementById('cliTotPre').textContent = fmt(pre);
            }

            function cliRecalcPart() {
              const pres = [...document.querySelectorAll('#tbodyCliente input.pre')];
              const tot = pres.reduce((a, i) => a + Number(i.value || 0), 0);
              pres.forEach(inp => {
                const td = inp.closest('tr')?.querySelector('.part-cell');
                if (!td) return;
                const v = Number(inp.value || 0);
                td.textContent = (tot > 0 ? (v * 100 / tot) : 0).toFixed(1) + '%';
              });
            }

            function cliSetPeriodoDefault() {
              const f = new Date(), m = f.getMonth() + 1, y = f.getFullYear();
              const ms = m === 12 ? 1 : m + 1, ys = m === 12 ? y + 1 : y;
              $("#cliMes").val(ms);
              $("#cliAnio").val(ys);
            }

            async function cliLoadCanales() {
              const $sel = $("#cliCanal").empty().append('<option value="">Todos los canales</option>');
              try {
                const r = await fetch(API.canalesCliente, { credentials: 'same-origin' });
                const data = r.ok ? await r.json() : [];
                (data || [])
                  .map(x => (typeof x === 'string' ? x : (x.value ?? x.nombre ?? x.name ?? x.id)))
                  .filter(Boolean)
                  .sort((a, b) => String(a).localeCompare(String(b)))
                  .forEach(c => $sel.append(`<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`));
              } catch {
                showToast("Error al cargar canales (cliente).", "danger");
              }
            }

            async function cliLoadClasificaciones() {
              const $sel = $("#cliClasificacion").empty().append('<option value="">Todas</option>');
              try {
                const r = await fetch(API.clasificacionesCliente, { credentials: 'same-origin' });
                const data = r.ok ? await r.json() : [];
                (data || [])
                  .map(x => (typeof x === 'string' ? x : (x.value ?? x.nombre ?? x.name ?? x.id)))
                  .filter(Boolean)
                  .sort((a, b) => String(a).localeCompare(String(b)))
                  .forEach(x => $sel.append(`<option value="${escapeHtml(x)}">${escapeHtml(x)}</option>`));
              } catch {
                showToast("Error al cargar clasificaciones (cliente).", "danger");
              }
            }

            async function cliLoadVendedores() {
              const $sel = $("#cliVendedores").empty();
              try {
                const r = await fetch(API.vendedores, { credentials: 'same-origin' });
                const data = r.ok ? await r.json() : [];
                (data || []).forEach(v => {
                  const id = v.id ?? v.Id ?? v.slpCode ?? v.SlpCode;
                  const nom = v.nombre ?? v.Nombre ?? v.name ?? v.Name ?? '';
                  if (id == null) return;
                  $sel.append(`<option value="${escapeHtml(id)}">${escapeHtml(id)}${nom ? " - " + escapeHtml(nom) : ""}</option>`);
                });
              } catch {
                showToast("Error al cargar vendedores (cliente).", "danger");
              }
            }

            function cliRenderList(list) {
              const wrap = document.getElementById("cliListaClientes");
              if (!wrap) return;

              if (!list.length) {
                wrap.innerHTML = `<div class="text-muted p-2">No hay clientes con esos filtros.</div>`;
                return;
              }

              wrap.innerHTML = list.map(c => {
                const label = `${escapeHtml(c.id)}${c.nom ? " - " + escapeHtml(c.nom) : ""}`;
                const meta = [c.canal, c.clas, c.vend].filter(Boolean).map(escapeHtml).join(" · ");
                return `
                  <label class="d-flex align-items-start gap-2 border-bottom py-2">
                    <input class="form-check-input mt-1 cliChk" type="checkbox" value="${escapeHtml(c.id)}">
                    <span>
                      <div class="fw-semibold">${label}</div>
                      ${meta ? `<div class="text-muted" style="font-size:.82rem">${meta}</div>` : ``}
                    </span>
                  </label>
                `;
              }).join("");
            }

            function _N(x){ return String(x ?? "").trim().toUpperCase(); }

            function cliApplyFiltersLocal() {
              const q = String($("#cliBuscarLista").val() || "").trim().toLowerCase();
              const canal = _N($("#cliCanal").val() || "");
              const clas  = _N($("#cliClasificacion").val() || "");
              const vends = ($("#cliVendedores").val() || []).map(_N);

              const hasMeta = (_cliAll || []).some(c => (c.canal || c.clas || c.vend));

              _cliFiltered = (_cliAll || []).filter(c => {
                if (hasMeta) {
                  if (canal && _N(c.canal) !== canal) return false;
                  if (clas  && _N(c.clas)  !== clas)  return false;
                  if (vends.length && !vends.includes(_N(c.vend))) return false;
                }

                if (q) {
                  const bag = (String(c.id) + " " + String(c.nom)).toLowerCase();
                  if (!bag.includes(q)) return false;
                }
                return true;
              });

              cliRenderList(_cliFiltered);
            }

            function cliSetupAutocomplete() {
              const input = $("#cliClienteIndividual");
              if (!input.length || !$.fn.autocomplete) return;

              const src = (_cliAll || []).map(c => ({
                label: `${c.id}${c.nom ? " - " + c.nom : ""}`,
                value: `${c.id}${c.nom ? " - " + c.nom : ""}`,
                id: c.id
              }));

              input.autocomplete({
                minLength: 2,
                source: (req, res) => {
                  const t = String(req.term || "").toLowerCase();
                  res(src.filter(x => x.label.toLowerCase().includes(t)).slice(0, 50));
                },
                select: (e, ui) => {
                  $("#cliClienteIndividualId").val(ui.item.id);
                }
              });

              input.on("input", function () {
                if (!this.value) $("#cliClienteIndividualId").val("");
              });
            }

            async function cliCargarClientes() {
              try {
                toggleSpin(true);

                const canal = $("#cliCanal").val() || "";
                const clasif = $("#cliClasificacion").val() || "";
                const vendsArr = $("#cliVendedores").val() || [];
                const vendedores = vendsArr.join(",");

                let url = "";
                if (!canal && vendedores && vendedores.split(",").length === 1) {
                  url = `/Comercial/GetClientesPorVendedor?vendedorId=${encodeURIComponent(vendedores)}&clasif=${encodeURIComponent(clasif)}`;
                } else {
                  url = `/Comercial/GetClientes?vendedores=${encodeURIComponent(vendedores)}&canal=${encodeURIComponent(canal)}&clasif=${encodeURIComponent(clasif)}`;
                }

                const r = await fetch(url, { credentials: "same-origin" });
                const data = r.ok ? await r.json() : [];

                _cliAll = (Array.isArray(data) ? data : []).map(raw => ({
                  id: String(raw.id ?? raw.value ?? raw.cardCode ?? raw.CardCode ?? ""),
                  nom: String(raw.text ?? raw.label ?? raw.nombre ?? raw.Nombre ?? raw.cardName ?? raw.CardName ?? ""),
                  canal: String(raw.canal ?? raw.Canal ?? ""),
                  clas: String(raw.clas ?? raw.Clasificacion ?? ""),
                  vend: String(raw.vend ?? raw.VendedorId ?? raw.slpCode ?? "")
                })).filter(x => x.id);

                _cliLoaded = true;

                cliApplyFiltersLocal();
                cliSetupAutocomplete();
                showToast("Clientes cargados.", "success");
              } catch (e) {
                console.error(e);
                showToast("Error al cargar clientes.", "danger");
              } finally {
                toggleSpin(false);
              }
            }

            function cliGetSelectedClientIds() {
              const one = String($("#cliClienteIndividualId").val() || "");
              if (one) return [one];
              return [...document.querySelectorAll("#cliListaClientes .cliChk:checked")].map(x => String(x.value));
            }

                  // 1) Trae ventas por clientes y "inyecta" el cliente en cada registro (por si el API no lo trae)
        async function cliTraerVentasPorClientes(ids) {
          const meses = parseInt($("#cliMesesObjetivo").val() || "12", 10);
          const refs = buildMonthRefs(meses);

          const all = [];
          for (const id of ids) {
            const url = `${API.ventasCliente}?cardCode=${encodeURIComponent(id)}`;
            const r = await fetch(url, { credentials: "same-origin" });
            if (!r.ok) continue;

            const j = await r.json().catch(() => []);
            if (!Array.isArray(j)) continue;

            // 👇 IMPORTANTÍSIMO: asegura que cada registro "sepa" de qué cliente es
            j.forEach(x => {
              all.push({
                ...x,
                __cliente: id // inyectado
              });
            });
          }

          if (!all.length) return null;
          return { data: all, refs, meses };
        }


        // 2) Construye filas por Cliente+SKU (ya NO por SKU solamente)
        function cliBuildPorClienteSkuFromVentas(raw, refs, meses) {
          const porKey = {};

          (raw || []).forEach(d => {
            const sku = String(d.sku || d.Sku || d.productoCodigo || d.ProductoCodigo || "").trim();
            if (!sku) return;

            // ClienteId: intenta leerlo del payload; si no existe usa el inyectado __cliente
            const clienteId = String(
              d.Cliente || d.cliente ||
              d.CardCode || d.cardCode ||
              d.ClienteId || d.clienteId ||
              d.__cliente || ""
            ).trim();
            if (!clienteId) return;

            // Nombre cliente si existe (opcional)
            const clienteNom = String(d.CardName || d.cardName || d.nombreCliente || d.NombreCliente || "").trim();

            const f = new Date(d.fecha || d.Fecha);
            if (isNaN(f.getTime())) return;

            const ym = `${f.getFullYear()}-${String(f.getMonth() + 1).padStart(2, "0")}`;

            const key = `${clienteId}||${sku}`.toUpperCase();

            porKey[key] ||= {
              sku: sku.toUpperCase(),
              clienteId: clienteId.toUpperCase(),
              clienteNom,
              porMes: {},
              objetivo: 0,
              presupuesto: 0
            };

            porKey[key].porMes[ym] =
              (porKey[key].porMes[ym] || 0) +
              Number(d.totalKilos ?? d.TotalKilos ?? d.kilos ?? d.Kilos ?? d.total ?? 0);
          });

          const rows = Object.values(porKey);

          rows.forEach(r => {
            const sum = refs.reduce((a, m) => a + (r.porMes[m.key] || 0), 0);
            r.objetivo = Math.round(sum / Math.max(1, meses));
            r.presupuesto = r.objetivo;
          });

          // Orden opcional: por cliente y sku
          rows.sort((a, b) => (a.clienteId + " " + a.sku).localeCompare(b.clienteId + " " + b.sku));

          return rows;
        }


