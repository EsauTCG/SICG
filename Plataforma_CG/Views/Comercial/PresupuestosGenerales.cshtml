                showToast("Datos cargados por mes.", "success");
              });

              $("#btnAbrirModalGuardar").on("click", function () {
                if (!document.querySelector('#tbodyCedis tr')) {
                  showToast("No hay filas para guardar.", "warning");
                  return;
                }
                bootstrap.Modal.getOrCreateInstance(document.getElementById('modalGuardarCedis')).show();
              });

              $("#btnGuardarModalCedis").on("click", guardarDesdeModal);

              // ✅ FIX: quitamos el typo "look" y dejamos un solo handler
              $(document).on('input', '#tbodyCedis input.pre', () => { updateTotales(); recalcPart(); });

              $(document).on('click', '#tbodyCedis .del', function () {
                this.closest('tr')?.remove();

                // Renumerar items[] para el binder MVC
                document.querySelectorAll('#tbodyCedis tr').forEach((tr, idx) => {
                  tr.querySelectorAll('input[name^="items["]').forEach(inp => {
                    inp.name = inp.name.replace(/items\[\d+\]/, `items[${idx}]`);
