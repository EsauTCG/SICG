            // Comentarios
            function abrirModalComentario($btn) {
              const sku = $btn.data("sku");
              const index = $btn.data("index");
              const targetId = `comentario-${index}`;
              comentarioTargetId = targetId;

              const ex = $(`#${targetId}`).val();
              $("#comentarioSkuCedis").text(sku);
              $("#comentarioTextoCedis").val(ex || "");

              bootstrap.Modal.getOrCreateInstance(document.getElementById('comentarioModalCedis')).show();
