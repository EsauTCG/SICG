            $("#btnExportarXlsx").on("click", () => {
              const canal = (document.getElementById('selCanal')?.value || 'CEDIS').replace(/[^\w\- ]/g, '');
              EXCEL.exportar({
                tbodySelector: '#tbodyCedis',
                $selMesesObjetivo: $("#filtroMesesObjetivo"),
                sheetName: 'CEDIS',
                fileNameBase: `Presupuesto_CEDIS_${canal}`
              });
            });

            $("#btnPlantillaXlsx").on("click", () => {
              const canal = (document.getElementById('selCanal')?.value || 'CEDIS').replace(/[^\w\- ]/g, '');
              EXCEL.plantilla({
                $selMesesObjetivo: $("#filtroMesesObjetivo"),
                sheetName: 'Plantilla',
                fileNameBase: `Plantilla_Presupuesto_CEDIS_${canal}`
              });
