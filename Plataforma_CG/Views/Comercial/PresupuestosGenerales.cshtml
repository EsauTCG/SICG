@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Presupuestos (CEDIS / Vendedor / Cliente)";
    var meses = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat;
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    /* =====================================================================
           PRESUPUESTOS · SIGO — hoja de estilos única
           Mismo sistema visual que el resto de módulos. Sustituye las 2 capas
           anteriores (incluidas las que forzaban el ancho del layout).
           ===================================================================== */
    :root {
        --es-tinto: #8d3e46;
        --es-tinto-deep: #5c2229;
        --es-tinto-soft: #f7eced;
        --es-tinto-line: #e8d3d6;
        --es-paper: #f6f4f4;
        --es-surface: #ffffff;
        --es-field: #ffffff;
        --es-field-ro: #f6f3f3;
        --es-head: #faf7f7;
        --es-hover: #fcf9f9;
        --es-row-line: #f0eaeb;
        --es-ink: #231a1c;
        --es-muted: #76686b;
        --es-line: #e6dfe0;
        --es-line-strong: #cfc4c6;
        --es-ok: #2f7a55;
        --es-ok-bg: #e7f3ec;
        --es-warn: #9a6410;
        --es-warn-bg: #fbf1de;
        --es-bad: #b42d2d;
        --es-bad-bg: #fbe9e8;
        --es-info: #2f5d86;
        --es-info-bg: #e9f0f7;
        --es-neutral-bg: #efecec;
        --es-font: "Poppins", "Segoe UI", system-ui, -apple-system, Arial, sans-serif;
    }

    body[data-theme="dark"] {
        --es-tinto: #c56b74;
        --es-tinto-deep: #7a2d36;
        --es-tinto-soft: #3a2427;
        --es-tinto-line: #5a3439;
        --es-paper: #16181c;
        --es-surface: #202328;
        --es-field: #181a1e;
        --es-field-ro: #262a30;
        --es-head: #262a30;
        --es-hover: #2a2e34;
        --es-row-line: #30343b;
        --es-ink: #edf0f3;
        --es-muted: #a9b0b9;
        --es-line: #363b43;
        --es-line-strong: #4a5059;
        --es-ok: #6cc596;
        --es-ok-bg: #1d3328;
        --es-warn: #e0b061;
        --es-warn-bg: #3a2f1b;
        --es-bad: #f08a83;
        --es-bad-bg: #3d2223;
        --es-info: #8bb8e0;
        --es-info-bg: #1e2b38;
        --es-neutral-bg: #2c3036;
    }

    .prx, .prx-modal {
        font-family: var(--es-font) !important;
        color: var(--es-ink);
        font-size: 13px;
        line-height: 1.4;
    }

        .prx *, .prx-modal * {
            box-sizing: border-box;
        }

        .prx .bi, .prx-modal .bi {
            font-family: "bootstrap-icons" !important;
        }

    .prx {
        background: var(--es-paper);
        padding: 16px 18px 10px;
        min-width: 0;
    }

        .prx .text-muted, .prx-modal .text-muted, .prx .form-text {
            color: var(--es-muted) !important;
        }

    .text-end {
        font-variant-numeric: tabular-nums;
    }

    /* ---------- Encabezado ---------- */
    .pr-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 14px;
    }

    .pr-header__title {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .pr-header__icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: grid;
        place-items: center;
        background: var(--es-tinto);
        color: #fff;
        font-size: 19px;
    }

    .pr-header h1 {
        margin: 0;
        font-size: 20px;
        font-weight: 700;
        letter-spacing: -.01em;
        line-height: 1.15;
        color: var(--es-ink);
    }

    .pr-header p {
        margin: 2px 0 0;
        font-size: 12px;
        color: var(--es-muted);
    }

    .pr-header__actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .modo-pill {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 4px 4px 4px 12px;
        border-radius: 10px;
        background: var(--es-surface);
        border: 1px solid var(--es-line);
    }

    .modo-title {
        font-size: 11.5px;
        font-weight: 600;
        color: var(--es-muted);
        white-space: nowrap;
    }

    .modo-pill .btn-group {
        display: inline-flex;
        gap: 2px;
        padding: 2px;
        border-radius: 8px;
        background: var(--es-neutral-bg);
    }

        .modo-pill .btn-group .btn {
            height: 30px;
            padding: 0 12px;
            border: 0 !important;
            border-radius: 6px !important;
            background: transparent;
            color: var(--es-muted);
            font: 600 12px/1 var(--es-font);
            box-shadow: none;
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

            .modo-pill .btn-group .btn.active {
                background: var(--es-tinto);
                color: #fff;
            }

            .modo-pill .btn-group .btn:disabled {
                opacity: .55;
                cursor: not-allowed;
            }

    /* ---------- Botones ---------- */
    .tbtn, .prx .btn, .prx-modal .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        height: 36px;
        padding: 0 14px;
        border: 1px solid var(--es-line-strong);
        border-radius: 7px;
        background: var(--es-field);
        color: var(--es-ink);
        font: 600 12.5px/1 var(--es-font);
        white-space: nowrap;
        cursor: pointer;
        box-shadow: none;
        transition: background .12s, border-color .12s, color .12s;
    }

        .tbtn:hover, .prx .btn:hover, .prx-modal .btn:hover {
            background: var(--es-tinto-soft);
            border-color: var(--es-tinto-line);
            color: var(--es-ink);
        }

        .tbtn:focus-visible, .prx .btn:focus-visible, .prx-modal .btn:focus-visible {
            outline: 2px solid var(--es-tinto);
            outline-offset: 2px;
            box-shadow: none;
        }

        .tbtn:disabled {
            opacity: .55;
            cursor: not-allowed;
        }

        .tbtn.primary, .prx-modal .btn-danger {
            background: var(--es-tinto);
            border-color: var(--es-tinto);
            color: #fff;
        }

            .tbtn.primary:hover, .prx-modal .btn-danger:hover {
                background: var(--es-tinto-deep);
                border-color: var(--es-tinto-deep);
                color: #fff;
            }

        .tbtn.danger {
            color: var(--es-bad);
        }

            .tbtn.danger:hover {
                background: var(--es-bad-bg);
                border-color: var(--es-bad);
                color: var(--es-bad);
            }

    .tbtn-sm {
        height: 30px;
        padding: 0 10px;
        font-size: 12px;
        border-radius: 6px;
    }

    /* ---------- Pestañas ---------- */
    .pr-tabs {
        display: inline-flex;
        gap: 2px;
        padding: 3px;
        margin: 0 0 12px;
        border-radius: 9px;
        background: var(--es-neutral-bg);
        border: 0;
        list-style: none;
    }

        .pr-tabs .nav-link {
            height: 34px;
            padding: 0 16px;
            border: 0 !important;
            border-radius: 7px;
            background: transparent;
            color: var(--es-muted);
            font: 600 12.5px/1 var(--es-font);
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

            .pr-tabs .nav-link:hover {
                color: var(--es-ink);
            }

            .pr-tabs .nav-link.active {
                background: var(--es-surface) !important;
                color: var(--es-ink) !important;
                box-shadow: 0 1px 3px rgba(0,0,0,.12);
            }

            .pr-tabs .nav-link:focus-visible {
                outline: 2px solid var(--es-tinto);
                outline-offset: 1px;
            }

    /* ---------- Barra de acciones ---------- */
    .toolbar {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        padding: 10px 12px;
        margin-bottom: 12px;
        border-radius: 10px;
        background: var(--es-surface);
        border: 1px solid var(--es-line);
    }

        .toolbar .ms-auto {
            flex: 1 1 auto;
        }

        .toolbar .pr-sep {
            width: 1px;
            height: 24px;
            background: var(--es-line);
            margin: 0 2px;
        }

    /* ---------- Paneles ---------- */
    .pr-grid {
        display: grid;
        grid-template-columns: 280px minmax(0, 1fr);
        gap: 12px;
        align-items: start;
    }

    .pr-grid--cli {
        grid-template-columns: 300px minmax(0, 1fr);
        margin-bottom: 12px;
    }

    .panel {
        background: var(--es-surface);
        border: 1px solid var(--es-line);
        border-radius: 10px;
        overflow: hidden;
        min-width: 0;
    }

    .panel-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        flex-wrap: wrap;
        padding: 10px 14px;
        border-bottom: 1px solid var(--es-line);
        font-size: 14px;
        font-weight: 600;
        color: var(--es-ink);
    }

        .panel-head i {
            color: var(--es-tinto);
        }

        .panel-head .pr-head-nota {
            font-size: 11.5px;
            font-weight: 500;
            color: var(--es-muted);
        }

    .panel-body {
        padding: 14px;
    }

    .pr-field + .pr-field {
        margin-top: 14px;
    }

    .prx .form-label, .prx-modal .form-label {
        display: block;
        margin: 0 0 5px;
        font-size: 12px;
        font-weight: 600;
        color: var(--es-muted);
    }

    .prx .form-control, .prx .form-select, .prx-modal .form-control, .prx-modal .form-select, .prx .input-group-text {
        height: 36px;
        min-height: 36px;
        padding: 0 10px;
        border: 1px solid var(--es-line-strong);
        border-radius: 7px;
        background-color: var(--es-field);
        color: var(--es-ink);
        font: 500 13px/1.2 var(--es-font);
        box-shadow: none;
    }

    .prx .form-select, .prx-modal .form-select {
        padding-right: 30px;
    }

    .prx select[multiple].form-select {
        height: auto;
        min-height: 104px;
        padding: 4px;
        background-image: none;
    }

    .prx-modal textarea.form-control {
        height: auto;
        padding: 9px 10px;
        line-height: 1.45;
        resize: vertical;
    }

    .prx .form-control:focus, .prx .form-select:focus, .prx-modal .form-control:focus, .prx-modal .form-select:focus {
        border-color: var(--es-tinto);
        box-shadow: 0 0 0 3px rgba(141,62,70,.16);
        outline: none;
        background-color: var(--es-field);
        color: var(--es-ink);
    }

    body[data-theme="dark"] .prx .form-control, body[data-theme="dark"] .prx .form-select, body[data-theme="dark"] .prx-modal .form-control, body[data-theme="dark"] .prx-modal .form-select {
        color-scheme: dark;
    }

    .prx .form-text {
        margin-top: 5px;
        font-size: 11.5px;
        line-height: 1.35;
    }

    .prx .input-group-text {
        color: var(--es-muted);
    }

    .pr-periodo {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 96px;
        gap: 8px;
    }

    .pr-divider {
        height: 1px;
        margin: 14px 0;
        background: var(--es-line);
    }

    .pr-filtros-cli {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
    }

    .pr-nota {
        display: flex;
        gap: 8px;
        align-items: flex-start;
        padding: 9px 12px;
        margin-bottom: 12px;
        border-radius: 8px;
        background: var(--es-info-bg);
        color: var(--es-info);
        font-size: 12.5px;
    }

    /* Lista de clientes */
    .pr-cli-tools {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 8px;
    }

        .pr-cli-tools .input-group {
            max-width: 420px;
            flex: 1 1 260px;
        }

            .pr-cli-tools .input-group .form-control {
                border-radius: 0 7px 7px 0;
            }

            .pr-cli-tools .input-group .input-group-text {
                border-radius: 7px 0 0 7px;
            }

    .pr-cli-box {
        height: 240px;
        overflow: auto;
        border: 1px solid var(--es-line);
        border-radius: 8px;
        background: var(--es-surface);
    }

    #cliListaClientes {
        padding: 4px;
        font-size: 12.5px;
        color: var(--es-ink);
    }

        #cliListaClientes label {
            display: flex;
            align-items: flex-start;
            gap: 9px;
            padding: 7px 9px;
            margin: 0;
            border-radius: 6px;
            cursor: pointer;
        }

            #cliListaClientes label:hover {
                background: var(--es-tinto-soft);
            }

        #cliListaClientes .cliChk {
            width: 16px;
            height: 16px;
            margin: 2px 0 0;
            flex: none;
            accent-color: var(--es-tinto);
        }

        #cliListaClientes .fw-semibold {
            font-weight: 600;
        }

    #cliSelCount {
        font-size: 12px;
        color: var(--es-muted);
    }

    /* ---------- Tablas ---------- */
    .table-responsive-sticky, .table-wrapper {
        overflow: auto;
        max-height: 62vh;
    }

    .prx .table, .prx-modal .table {
        width: 100%;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
        font-size: 12.5px;
        color: var(--es-ink);
        --bs-table-bg: transparent;
        --bs-table-color: var(--es-ink);
        --bs-table-hover-bg: transparent;
        --bs-table-border-color: transparent;
    }

        .prx .table > :not(caption) > * > *, .prx-modal .table > :not(caption) > * > * {
            border-width: 0;
            box-shadow: none;
        }

    .prx #tablaCedis, .prx #tablaVendedor, .prx #tablaCliente {
        width: max-content;
        min-width: 100%;
    }

    .prx .table thead th, .prx-modal .table thead th {
        position: sticky;
        top: 0;
        z-index: 2;
        padding: 8px 10px;
        background: var(--es-head);
        border-bottom: 1px solid var(--es-line);
        color: var(--es-muted);
        font-size: 11.5px;
        font-weight: 600;
        white-space: nowrap;
        vertical-align: bottom;
    }

        .prx .table thead th .small {
            font-size: 10.5px;
            font-weight: 500;
        }

    .prx .table tbody td, .prx-modal .table tbody td {
        padding: 6px 10px;
        border-bottom: 1px solid var(--es-row-line);
        background: var(--es-surface);
        vertical-align: middle;
        white-space: nowrap;
    }

    .prx .table tbody tr:hover > td, .prx-modal .table tbody tr:hover > td {
        background: var(--es-hover);
    }

    .prx .table tbody td:first-child {
        font-weight: 600;
    }

    .prx .table td.pr-obj {
        font-weight: 600;
        background: var(--es-head);
    }

    .prx .table input.pre {
        width: 110px;
        height: 32px;
        min-height: 32px;
        margin-left: auto;
        text-align: right;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
    }

        .prx .table input.pre.is-invalid {
            border-color: var(--es-bad);
            background-color: var(--es-bad-bg);
        }

        .prx .table input.pre.is-changed {
            border-color: var(--es-warn);
            background-color: var(--es-warn-bg);
        }

    .prx .table .btn-sm {
        width: 32px;
        height: 30px;
        padding: 0;
        border-radius: 6px;
    }

        .prx .table .btn-sm.has-note {
            background: var(--es-info-bg);
            border-color: var(--es-info);
            color: var(--es-info);
        }

    .prx .table .del:hover {
        background: var(--es-bad-bg);
        border-color: var(--es-bad);
        color: var(--es-bad);
    }

    .prx .table .part-cell {
        color: var(--es-muted);
    }

    .pr-empty {
        padding: 40px 14px;
        text-align: center;
        color: var(--es-muted);
    }

        .pr-empty i {
            display: block;
            font-size: 26px;
            margin-bottom: 6px;
            color: var(--es-line-strong);
        }

    .totales-sap {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 22px;
        flex-wrap: wrap;
        padding: 10px 14px;
        border-top: 1px solid var(--es-line);
        background: var(--es-head);
        font-size: 12px;
        color: var(--es-muted);
    }

        .totales-sap span {
            font-size: 16px;
            font-weight: 700;
            color: var(--es-ink);
            font-variant-numeric: tabular-nums;
            margin-left: 4px;
        }

        .totales-sap .pr-diff {
            font-size: 12.5px;
            font-weight: 600;
        }

            .totales-sap .pr-diff.up {
                color: var(--es-ok);
            }

            .totales-sap .pr-diff.down {
                color: var(--es-bad);
            }

    #alertsZone .alert, #venAlerts .alert, #cliAlerts .alert {
        margin: 0 0 12px;
        padding: 10px 14px;
        border: 0;
        border-radius: 8px;
        font-size: 13px;
    }

    #alertsZone .alert-success {
        background: var(--es-ok-bg);
        color: var(--es-ok);
    }

    #alertsZone .alert-warning {
        background: var(--es-warn-bg);
        color: var(--es-warn);
    }

    /* ---------- Cargando ---------- */
    #loadingSpinnerCedis {
        position: fixed;
        inset: 0;
        z-index: 2000;
        display: none;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 12px;
        background: rgba(246,244,244,.7);
        font-family: var(--es-font);
        font-weight: 600;
        color: var(--es-ink);
    }

    body[data-theme="dark"] #loadingSpinnerCedis {
        background: rgba(22,24,28,.75);
    }

    .pr-spinner {
        width: 38px;
        height: 38px;
        border: 3px solid var(--es-tinto-line);
        border-top-color: var(--es-tinto);
        border-radius: 50%;
        animation: pr-spin .8s linear infinite;
    }

    @@keyframes pr-spin {
        to {
            transform: rotate(360deg);
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .pr-spinner {
            animation-duration: 2s;
        }
    }

    /* ---------- Modales ---------- */
    .prx-modal.modal-content {
        border: 0;
        border-radius: 12px;
        overflow: hidden;
        background: var(--es-surface);
        box-shadow: 0 18px 50px rgba(35,26,28,.25);
    }

    .prx-modal .modal-header {
        padding: 13px 18px;
        background: var(--es-tinto-deep);
        color: #fff;
        border-bottom: 0;
    }

    .prx-modal .modal-title {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 15px;
        font-weight: 600;
        color: #fff;
    }

    .prx-modal .btn-close {
        filter: invert(1) grayscale(1) brightness(2);
        opacity: .9;
    }

    .prx-modal .modal-body {
        background: var(--es-surface);
    }

    .prx-modal .modal-footer {
        background: var(--es-head);
        border-top: 1px solid var(--es-line);
    }

    .prx-modal .btn-outline-secondary {
        background: var(--es-field);
    }

    #modalAdminPres .modal-dialog {
        max-width: min(1150px, 96vw);
    }

    #modalAdminPres .modal-body {
        background: var(--es-paper);
    }

    .adm-filtros {
        display: grid;
        grid-template-columns: repeat(7, minmax(0, 1fr));
        gap: 10px;
        align-items: end;
    }

    .adm-acciones {
        display: flex;
        gap: 8px;
        justify-content: flex-end;
        flex-wrap: wrap;
        margin-top: 12px;
    }

    .adm-aviso {
        display: flex;
        gap: 8px;
        padding: 9px 12px;
        margin-top: 12px;
        border-radius: 8px;
        background: var(--es-warn-bg);
        color: var(--es-warn);
        font-size: 12.5px;
    }

    #modalAdminPres .table-responsive-sticky {
        max-height: 50vh;
        margin-top: 12px;
        border: 1px solid var(--es-line);
        border-radius: 8px;
        background: var(--es-surface);
    }

    #modalAdminPres input[type="checkbox"] {
        width: 16px;
        height: 16px;
        accent-color: var(--es-tinto);
    }

    @@media (max-width: 1100px) {
        .pr-grid, .pr-grid--cli {
            grid-template-columns: 1fr;
        }

        .adm-filtros {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (max-width: 700px) {
        .prx {
            padding: 10px;
        }

        .pr-filtros-cli, .adm-filtros {
            grid-template-columns: 1fr;
        }

        .toolbar .ms-auto {
            display: none;
        }
    }
</style>

<div class="prx presupuesto-app">

    <header class="pr-header">
        <div class="pr-header__title">
            <span class="pr-header__icon"><i class="bi bi-graph-up-arrow"></i></span>
            <div>
                <h1>Presupuestos</h1>
                <p>Calcula el objetivo con el promedio de venta por SKU y ajusta el presupuesto por CEDIS, vendedor o cliente.</p>
            </div>
        </div>
        <div class="pr-header__actions">
