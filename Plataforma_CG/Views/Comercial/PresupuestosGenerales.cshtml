@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Presupuesto (CEDIS / Vendedor / Cliente)";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap');

    :root {
        --pres-font: "Poppins", "Segoe UI", Arial, sans-serif;
        --pres-bg: #eadede;
        --pres-surface: #fffafa;
        --pres-surface-2: #f7eeee;
        --pres-line: #d7bcbc;
        --pres-line-dark: #a56d6d;
        --pres-text: #361515;
        --pres-muted: #765151;
        --pres-brand: #8b0000;
        --pres-brand-2: #6d0000;
        --pres-brand-3: #4d0000;
        --pres-ok: #176b3a;
        --pres-danger: #b40000;
    }

    * {
        box-sizing: border-box;
    }

    html,
    body {
        width: 100% !important;
        max-width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
        overflow-x: hidden !important;
    }

    body {
        background: #ece6e6 !important;
        color: var(--pres-text) !important;
        font-family: var(--pres-font) !important;
    }

    body:has(.presupuesto-app),
    body:has(.presupuesto-app) .layout-main-content,
    body:has(.presupuesto-app) .layout-main-content .layout-container-fluid,
    body:has(.presupuesto-app) main[role="main"] {
        min-height: 0 !important;
        height: auto !important;
        max-height: none !important;
    }

    body:has(.presupuesto-app) .layout-main-content {
        flex: 0 0 auto !important;
        width: auto !important;
        max-width: 100% !important;
        min-width: 0 !important;
        overflow-x: hidden !important;
        overflow-y: visible !important;
    }

    body:has(.presupuesto-app) .layout-main-content .layout-container-fluid {
        width: 100% !important;
        max-width: 100% !important;
        min-width: 0 !important;
        margin: 0 !important;
        padding: 0 !important;
        overflow: visible !important;
    }

    body:has(.presupuesto-app) footer,
    body:has(.presupuesto-app) .footer,
    body:has(.presupuesto-app) .layout-footer {
        position: static !important;
        min-height: 29px !important;
        height: auto !important;
        margin-top: 4px !important;
        padding: 4px 0 !important;
        font-family: var(--pres-font) !important;
        font-size: 10.5px !important;
        line-height: 1.15 !important;
    }

    .presupuesto-app {
        width: 100% !important;
        max-width: 100% !important;
        min-width: 0 !important;
        margin: 0 !important;
        padding: 0 !important;
        font-family: var(--pres-font) !important;
        font-size: 11px !important;
        line-height: 1.22 !important;
        color: var(--pres-text) !important;
        container-type: inline-size;
        container-name: presupuesto;
    }

    .presupuesto-app,
    .presupuesto-app *,
    #modalGuardarCedis,
    #modalGuardarCedis *,
    #comentarioModalCedis,
    #comentarioModalCedis *,
    #comentarioModalVendedor,
    #comentarioModalVendedor *,
    #comentarioModalCliente,
    #comentarioModalCliente *,
    #modalAdminPres,
    #modalAdminPres * {
        font-family: var(--pres-font) !important;
    }

    .presupuesto-app > .shell,
    .presupuesto-app .shell {
        width: 100% !important;
        max-width: 100% !important;
        min-width: 0 !important;
        margin: 0 !important;
        padding: 0 !important;
        border: 1px solid #8d5555 !important;
        border-radius: 0 !important;
        background: var(--pres-surface) !important;
        box-shadow: none !important;
        overflow: hidden !important;
    }

    /* ============================================================
       CABECERA
       ============================================================ */
    .presupuesto-app .module-titlebar {
        min-height: 39px !important;
        padding: 4px 7px !important;
        display: grid !important;
        grid-template-columns: minmax(0, 1fr) auto !important;
        align-items: center !important;
        gap: 6px !important;
        border: 0 !important;
        border-bottom: 1px solid #5a0000 !important;
        border-radius: 0 !important;
        background: linear-gradient(180deg, #b30000 0%, #870000 56%, #5c0000 100%) !important;
        box-shadow: none !important;
        color: #fff !important;
    }

    .presupuesto-app .module-titlebar > div:first-child {
        min-width: 0 !important;
    }

    .presupuesto-app .module-title {
        margin: 0 !important;
        display: flex !important;
        align-items: center !important;
        gap: 5px !important;
        color: #fff !important;
        font-size: 13px !important;
        font-weight: 700 !important;
        line-height: 1.05 !important;
    }

    .presupuesto-app .module-title i {
        font-size: 12px !important;
    }

    .presupuesto-app .module-subtitle {
        margin: 2px 0 0 !important;
        color: #f8dddd !important;
        font-size: 9px !important;
        line-height: 1.05 !important;
    }

    .presupuesto-app .module-titlebar > .d-flex {
        min-width: 0 !important;
        gap: 4px !important;
        flex-wrap: nowrap !important;
        justify-content: flex-end !important;
    }

    .presupuesto-app .modo-pill {
        min-height: 31px !important;
        padding: 2px 4px !important;
        display: flex !important;
        flex-direction: row !important;
        align-items: center !important;
        gap: 4px !important;
        border: 1px solid rgba(255,255,255,.28) !important;
        border-radius: 2px !important;
        background: rgba(255,255,255,.10) !important;
        box-shadow: none !important;
    }

    .presupuesto-app .modo-pill center {
        display: contents !important;
    }

    .presupuesto-app .modo-title {
        margin: 0 !important;
        color: #fff !important;
        font-size: 8.2px !important;
        font-weight: 600 !important;
        line-height: 1 !important;
        letter-spacing: 0 !important;
        white-space: nowrap !important;
    }

    .presupuesto-app #modoPresupuestoBox .btn {
        min-height: 25px !important;
        height: 25px !important;
        padding: 0 7px !important;
        border: 1px solid rgba(255,255,255,.30) !important;
        border-radius: 0 !important;
        background: rgba(255,255,255,.11) !important;
        color: #fff !important;
        box-shadow: none !important;
        font-size: 8.5px !important;
        font-weight: 600 !important;
        line-height: 1 !important;
    }

    .presupuesto-app #modoPresupuestoBox .btn.active {
        background: #fff !important;
        color: var(--pres-brand) !important;
        border-color: #fff !important;
    }

    .presupuesto-app .module-titlebar .tbtn {
        width: auto !important;
        min-width: 0 !important;
        min-height: 27px !important;
        height: 27px !important;
        padding: 0 8px !important;
        border: 1px solid rgba(255,255,255,.32) !important;
        border-radius: 0 !important;
        background: rgba(255,255,255,.10) !important;
        color: #fff !important;
        box-shadow: none !important;
        font-size: 8.8px !important;
        font-weight: 600 !important;
    }

    .presupuesto-app .module-titlebar .tbtn:hover {
        background: rgba(255,255,255,.19) !important;
    }

    /* ============================================================
       WORKFLOW
       ============================================================ */
    .presupuesto-app .pp-workflow {
        display: grid !important;
        grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
        gap: 3px !important;
        padding: 4px !important;
        border: 0 !important;
        border-bottom: 1px solid var(--pres-line) !important;
        background: #f2e5e5 !important;
        box-shadow: none !important;
    }

    .presupuesto-app .pp-step-card {
        min-width: 0 !important;
        min-height: 38px !important;
        padding: 4px 5px !important;
        display: grid !important;
        grid-template-columns: 23px minmax(0, 1fr) !important;
        align-items: center !important;
        gap: 5px !important;
        border: 1px solid var(--pres-line) !important;
        border-radius: 0 !important;
        background: #fffafa !important;
    }

    .presupuesto-app .pp-step-num {
        width: 22px !important;
        height: 22px !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        border-radius: 50% !important;
        background: var(--pres-brand) !important;
        color: #fff !important;
        font-size: 8.5px !important;
        font-weight: 700 !important;
    }

    .presupuesto-app .pp-step-title {
        display: block !important;
        color: var(--pres-text) !important;
        font-size: 9px !important;
        font-weight: 700 !important;
        line-height: 1.05 !important;
        white-space: nowrap !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
    }

    .presupuesto-app .pp-step-help {
        display: block !important;
        margin-top: 1px !important;
        color: var(--pres-muted) !important;
        font-size: 7.8px !important;
        line-height: 1.08 !important;
        white-space: nowrap !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
    }

    /* ============================================================
       CONTENIDO / TABS
       ============================================================ */
    .presupuesto-app .content,
    .presupuesto-app .tab-content {
        width: 100% !important;
        max-width: 100% !important;
        min-width: 0 !important;
        background: var(--pres-bg) !important;
    }

    .presupuesto-app .content {
        border: 0 !important;
        border-radius: 0 !important;
        box-shadow: none !important;
        overflow: visible !important;
    }

    .presupuesto-app .content > .p-3:first-child {
        padding: 3px 4px !important;
        border-bottom: 0 !important;
        background: var(--pres-bg) !important;
    }

    .presupuesto-app #alertsZone .alert,
    .presupuesto-app .alert {
        margin: 0 0 4px !important;
        padding: 5px 7px !important;
        border-radius: 0 !important;
        font-size: 9.2px !important;
        line-height: 1.15 !important;
    }

    .presupuesto-app .nav-tabs {
        min-height: 32px !important;
        padding: 3px 4px 0 !important;
        display: flex !important;
        gap: 3px !important;
        flex-wrap: nowrap !important;
        overflow-x: auto !important;
        border: 0 !important;
        border-bottom: 1px solid var(--pres-line) !important;
        background: #f5eaea !important;
    }

    .presupuesto-app .nav-tabs .nav-link {
        min-width: max-content !important;
        min-height: 27px !important;
        height: 27px !important;
        margin: 0 !important;
        padding: 0 10px !important;
        border: 1px solid var(--pres-line-dark) !important;
        border-radius: 0 !important;
        background: linear-gradient(#fffefe, #ead6d6) !important;
        color: #5a2020 !important;
        box-shadow: none !important;
        font-size: 9.5px !important;
        font-weight: 600 !important;
        line-height: 25px !important;
    }

    .presupuesto-app .nav-tabs .nav-link.active {
        border-color: #730000 !important;
        background: linear-gradient(180deg, #ad0000 0%, #840000 58%, #620000 100%) !important;
        color: #fff !important;
    }

    .presupuesto-app .tab-content {
        padding: 4px !important;
    }

    /* ============================================================
       TOOLBARS / BOTONES
       ============================================================ */
    .presupuesto-app .toolbar {
        min-height: 34px !important;
        margin-bottom: 4px !important;
        padding: 3px 4px !important;
        display: flex !important;
        align-items: center !important;
        flex-wrap: wrap !important;
        gap: 3px !important;
        border: 1px solid var(--pres-line) !important;
        border-radius: 0 !important;
        background: #f6ebeb !important;
    }

    .presupuesto-app .tbtn,
    .presupuesto-app .btn-outline-secondary {
        min-width: 0 !important;
        min-height: 27px !important;
        height: 27px !important;
        padding: 0 8px !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        gap: 4px !important;
        border: 1px solid var(--pres-line-dark) !important;
        border-radius: 0 !important;
        background: linear-gradient(#fffefe, #ecd7d7) !important;
        color: #4c1919 !important;
        box-shadow: none !important;
        font-size: 9px !important;
        font-weight: 600 !important;
        line-height: 1 !important;
        white-space: nowrap !important;
    }

    .presupuesto-app .tbtn:hover,
    .presupuesto-app .btn-outline-secondary:hover {
        background: #f7e7e7 !important;
        color: #3f1010 !important;
    }

    .presupuesto-app .tbtn.primary,
    .presupuesto-app .btn-danger {
        border-color: #760000 !important;
        background: linear-gradient(180deg, #b30000 0%, #870000 58%, #620000 100%) !important;
        color: #fff !important;
    }

    .presupuesto-app .toolbar .ms-auto {
        flex: 1 1 auto !important;
    }

    /* ============================================================
       PANELES / FORMULARIOS
       ============================================================ */
    .presupuesto-app .row {
        --bs-gutter-x: 4px !important;
        --bs-gutter-y: 4px !important;
    }

    .presupuesto-app .panel {
        height: 100% !important;
        margin: 0 !important;
        border: 1px solid var(--pres-line) !important;
        border-radius: 0 !important;
        background: var(--pres-surface) !important;
        box-shadow: none !important;
        overflow: hidden !important;
    }

    .presupuesto-app .panel-head {
        min-height: 28px !important;
        padding: 5px 6px !important;
        display: flex !important;
        align-items: center !important;
        gap: 4px !important;
        border: 0 !important;
        border-bottom: 1px solid #6c1e1e !important;
        border-radius: 0 !important;
        background: linear-gradient(180deg, #aa0000 0%, #820000 58%, #610000 100%) !important;
        color: #fff !important;
        font-size: 10px !important;
        font-weight: 600 !important;
        line-height: 1.05 !important;
    }

    .presupuesto-app .panel-head i {
        color: #fff !important;
    }

    .presupuesto-app .panel-body {
        padding: 6px !important;
        background: #fffafa !important;
    }

    .presupuesto-app .form-label,
    .presupuesto-app .sap-field label {
        margin: 0 0 2px !important;
        color: #5d2727 !important;
        font-size: 9px !important;
        font-weight: 600 !important;
        line-height: 1.05 !important;
        text-transform: none !important;
        letter-spacing: 0 !important;
    }

    .presupuesto-app .form-control,
    .presupuesto-app .form-select,
    .presupuesto-app .input-group-text {
        min-height: 28px !important;
        height: 28px !important;
        padding: 3px 6px !important;
        border: 1px solid #b88989 !important;
        border-radius: 0 !important;
        background: #fff !important;
        color: #331414 !important;
        box-shadow: none !important;
        font-size: 10.2px !important;
        line-height: 1.1 !important;
    }

    .presupuesto-app .form-control:focus,
    .presupuesto-app .form-select:focus {
        border-color: var(--pres-brand) !important;
        box-shadow: 0 0 0 1px rgba(139,0,0,.12) !important;
    }

    .presupuesto-app .form-text,
    .presupuesto-app .small,
    .presupuesto-app small {
        color: var(--pres-muted) !important;
        font-size: 8.3px !important;
        line-height: 1.12 !important;
    }

    .presupuesto-app hr {
        margin: 6px 0 !important;
        border-color: #dcc3c3 !important;
        opacity: 1 !important;
    }

    .presupuesto-app .mb-2,
    .presupuesto-app .mt-2,
    .presupuesto-app .mt-3,
    .presupuesto-app .mb-3,
    .presupuesto-app .my-3 {
        margin-top: 4px !important;
        margin-bottom: 4px !important;
    }

    .presupuesto-app #cliVendedores {
        min-height: 76px !important;
        height: 76px !important;
    }

    .presupuesto-app #cliListaClientes {
        padding: 3px 5px !important;
        background: #fff !important;
        color: var(--pres-text) !important;
        font-size: 9.2px !important;
    }

    .presupuesto-app #cliListaClientes label {
        gap: 4px !important;
        padding-top: 3px !important;
        padding-bottom: 3px !important;
        font-size: 9.2px !important;
    }

    .presupuesto-app .form-check-input,
    .presupuesto-app input[type="checkbox"] {
        width: 14px !important;
        height: 14px !important;
        min-width: 14px !important;
        min-height: 14px !important;
    }

    /* Escritorio: filtros compactos a la izquierda */
    @@container presupuesto (min-width: 992px) {
        .presupuesto-app #pane-cedis > form > .row,
        .presupuesto-app #pane-ven > .row {
            display: grid !important;
            grid-template-columns: 245px minmax(0, 1fr) !important;
            gap: 4px !important;
            margin: 0 !important;
        }

        .presupuesto-app #pane-cedis > form > .row > [class*="col-"],
        .presupuesto-app #pane-ven > .row > [class*="col-"] {
            width: auto !important;
            max-width: none !important;
            min-width: 0 !important;
            padding: 0 !important;
        }

        .presupuesto-app #pane-cli form > .row.g-3:first-of-type {
            display: grid !important;
            grid-template-columns: 240px minmax(0, 1fr) !important;
            gap: 4px !important;
            margin: 0 !important;
        }

        .presupuesto-app #pane-cli form > .row.g-3:first-of-type > [class*="col-"] {
            width: auto !important;
            max-width: none !important;
            min-width: 0 !important;
            padding: 0 !important;
        }
    }

    /* ============================================================
       TABLAS
       ============================================================ */
    .presupuesto-app .table-responsive-sticky,
    .presupuesto-app .table-wrapper,
    .presupuesto-app .table-responsive {
        width: 100% !important;
        max-width: 100% !important;
        min-width: 0 !important;
        max-height: none !important;
        height: auto !important;
        padding: 0 !important;
        border: 0 !important;
        border-radius: 0 !important;
        background: #fff !important;
        overflow-x: auto !important;
        overflow-y: visible !important;
        scrollbar-gutter: auto !important;
    }

    .presupuesto-app #tablaCedis,
    .presupuesto-app #tablaVendedor,
    .presupuesto-app #tablaCliente {
        width: max-content !important;
        min-width: 1120px !important;
        margin: 0 !important;
        border-collapse: separate !important;
        border-spacing: 0 !important;
        table-layout: auto !important;
        background: #fff !important;
        color: #241313 !important;
        font-size: 10.5px !important;
    }

    .presupuesto-app .table thead,
    .presupuesto-app .table thead th {
        position: sticky !important;
        top: 0 !important;
        z-index: 15 !important;
        background: linear-gradient(180deg, #a90000 0%, #820000 58%, #610000 100%) !important;
        color: #fff !important;
        border-top: 1px solid #b64747 !important;
        border-right: 1px solid #742727 !important;
        border-bottom: 1px solid #540000 !important;
        box-shadow: none !important;
    }

    .presupuesto-app .table thead th {
        padding: 5px 4px !important;
        font-size: 9.3px !important;
        font-weight: 600 !important;
        line-height: 1.08 !important;
        text-transform: none !important;
        letter-spacing: 0 !important;
        white-space: nowrap !important;
    }

    .presupuesto-app .table thead th .small,
    .presupuesto-app .table thead th .text-muted {
        color: #f3cece !important;
        font-size: 7.8px !important;
    }

    .presupuesto-app .table tbody td {
        padding: 4px !important;
        border-right: 1px solid #e0caca !important;
        border-bottom: 1px solid #e0caca !important;
        background: #fffafa !important;
        color: #251313 !important;
        font-size: 10.5px !important;
        line-height: 1.12 !important;
        vertical-align: middle !important;
        white-space: nowrap !important;
    }

    .presupuesto-app .table tbody tr:nth-of-type(even) > * {
        background: #f9eeee !important;
    }

    .presupuesto-app .table-hover tbody tr:hover > * {
        background: #f1dddd !important;
    }

    .presupuesto-app .table input.form-control,
    .presupuesto-app .table .form-control-sm {
        min-width: 82px !important;
        min-height: 25px !important;
        height: 25px !important;
        padding: 2px 4px !important;
        font-size: 9.8px !important;
        font-weight: 500 !important;
    }

    .presupuesto-app .table .btn,
    .presupuesto-app .table .btn-sm {
        min-width: 24px !important;
        min-height: 23px !important;
        height: 23px !important;
        padding: 0 5px !important;
        border-radius: 0 !important;
        font-size: 8.5px !important;
        line-height: 1 !important;
    }

    .presupuesto-app .totales-sap {
        min-height: 28px !important;
        padding: 5px 7px !important;
        display: flex !important;
        flex-wrap: wrap !important;
        align-items: center !important;
        justify-content: flex-end !important;
        gap: 5px 14px !important;
        border-top: 1px solid var(--pres-line) !important;
        background: #f3e5e5 !important;
        color: #4a1a1a !important;
        font-size: 10px !important;
        line-height: 1.1 !important;
    }

    .presupuesto-app .totales-sap span {
        color: var(--pres-brand) !important;
        font-weight: 700 !important;
    }

    /* ============================================================
       SPINNER
       ============================================================ */
    #loadingSpinnerCedis {
        background: rgba(255,255,255,.78) !important;
        backdrop-filter: blur(1px) !important;
        font-family: var(--pres-font) !important;
        font-size: 10.5px !important;
    }

    #loadingSpinnerCedis .spinner-border {
        width: 2.2rem !important;
        height: 2.2rem !important;
    }

    /* ============================================================
       MODALES
       ============================================================ */
    #modalGuardarCedis .modal-content,
    #comentarioModalCedis .modal-content,
    #comentarioModalVendedor .modal-content,
    #comentarioModalCliente .modal-content,
    #modalAdminPres .modal-content {
        border: 1px solid #844d4d !important;
        border-radius: 0 !important;
        background: #fffafa !important;
        box-shadow: 0 8px 24px rgba(55,0,0,.18) !important;
        overflow: hidden !important;
    }

    #modalGuardarCedis .modal-header,
    #comentarioModalCedis .modal-header,
    #comentarioModalVendedor .modal-header,
    #comentarioModalCliente .modal-header,
    #modalAdminPres .modal-header {
        min-height: 36px !important;
        padding: 5px 7px !important;
        border: 0 !important;
        border-bottom: 1px solid #570000 !important;
        background: linear-gradient(180deg, #af0000 0%, #830000 58%, #5e0000 100%) !important;
        color: #fff !important;
    }

    #modalGuardarCedis .modal-title,
    #comentarioModalCedis .modal-title,
