@section Scripts {
    @* CORRECCIÓN: jQuery, jQuery UI y Bootstrap ya no se vuelven a cargar (los trae _Layout2;
       jQuery UI solo servía a un buscador de cliente que estaba desactivado). *@
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>

    <script>
        (function() {
            if (window.__PRESUPUESTOS_APP_BOUND__) return;
            window.__PRESUPUESTOS_APP_BOUND__ = true;

            const API = {
                canales: '@Url.Action("ObtenerCanalesCedis", "Comercial")',
                datos: '@Url.Action("ObtenerPresupuestoPorCedis2", "Comercial")',
                guardar: '@Url.Action("GuardarPresupuestoCedis", "Comercial")',
                reporte: '@Url.Action("ObtenerPresupuestoReporteCedis", "Comercial")',
                vendedores: '@Url.Action("ObtenerVendedores", "Comercial")',
                datosVendedor: '@Url.Action("ObtenerPresupuestoPorVendedor", "Comercial")',
                guardarVendedor: '@Url.Action("GuardarPresupuestoVendedor", "Comercial")',
                clientes: '@Url.Action("GetClientes", "Comercial")',
                clientesPorVendedor: '@Url.Action("GetClientesPorVendedor", "Comercial")',
                ventasCliente: '@Url.Action("ObtenerPresupuesto", "Comercial")',
                presupuestosMes: '@Url.Action("ObtenerPresupuestos", "Comercial")',
                guardarCliente: '@Url.Action("GuardarPresupuesto", "Comercial")',
                canalesCliente: '@Url.Action("GetCanales", "Comercial")',
                clasificacionesCliente: '@Url.Action("GetClasificacionesClientes", "Comercial")',
                modoGet: '@Url.Action("ObtenerModoPresupuesto", "Comercial")',
                modoSet: '@Url.Action("GuardarModoPresupuesto", "Comercial")',
                adminList: '@Url.Action("AdminListPresupuestos", "Comercial")',
                adminDelIds: '@Url.Action("AdminDeleteByIds", "Comercial")',
                adminDelFilter: '@Url.Action("AdminDeleteByFilter", "Comercial")'
            };

            // =================== Utilidades ===================
            const fmt = n => Number(n || 0).toLocaleString('es-MX');

            // CORRECCIÓN: el indicador "Cargando" lleva un contador; antes una consulta interna lo
            // ocultaba mientras la principal seguía trabajando. Además ahora bloquea la pantalla
            // (antes aparecía al final de la página y no evitaba dobles clics en Guardar).
            let _spin = 0;
            function toggleSpin(flag, texto) {
                _spin = Math.max(0, _spin + (flag ? 1 : -1));
                const el = document.getElementById('loadingSpinnerCedis');
                if (texto) document.getElementById('loadingSpinnerTexto').textContent = texto;
                else if (flag) document.getElementById('loadingSpinnerTexto').textContent = 'Cargando, por favor espera…';
                if (el) el.style.display = _spin > 0 ? 'flex' : 'none';
            }

            function escapeHtml(s) {
                return String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#39;');
            }
            const tokenAny = () => document.querySelector('input[name="__RequestVerificationToken"]')?.value || "";

            function showToast(msg, variant = "light") {
                let root = document.getElementById("appToastCedis");
                if (!root) {
                    root = document.createElement('div');
                    root.id = "appToastCedis";
                    root.className = "position-fixed bottom-0 end-0 p-3";
                    root.style.zIndex = 2100;
                    root.innerHTML = `<div class="toast align-items-center border-0" role="status" aria-live="polite"><div class="d-flex"><div class="toast-body" style="font-family:var(--es-font)"></div><button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Cerrar"></button></div></div>`;
                    document.body.appendChild(root);
                }
                const el = root.querySelector('.toast');
                el.className = `toast align-items-center text-bg-${variant} border-0`;
                el.querySelector('.toast-body').textContent = msg;
                bootstrap.Toast.getOrCreateInstance(el, { delay: 3200 }).show();
            }

            function banner(msg, type = "success") {
                const z = document.getElementById('alertsZone');
                if (!z) return;
                z.innerHTML = msg ? `<div class="alert alert-${type}"><i class="bi ${type === 'success' ? 'bi-check-circle' : 'bi-exclamation-triangle'} me-2"></i>${escapeHtml(msg)}</div>` : '';
            }

            function buildMonthRefs(n) {
                const out = [], hoy = new Date();
                for (let i = n - 1; i >= 0; i--) {
                    const d = new Date(hoy.getFullYear(), hoy.getMonth() - i, 1);
                    out.push({ key: `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`, label: d.toLocaleString('es-MX', { month: 'short', year: 'numeric' }) });
                }
                return out;
            }
            function thMesesHtml(refs) {
                return refs.map(r => {
                    const partes = String(r.label).split(' ');
                    const y = partes.pop();
                    return `<th class="text-end"><div class="text-capitalize">${escapeHtml(partes.join(' ').replace('.', ''))}</div><div class="small text-muted">${escapeHtml(y)}</div></th>`;
                }).join('');
            }

            function shouldIncludeRow(objetivo, presupuesto) {
                const obj = Math.round(Number(objetivo || 0));
                const pre = Math.round(Number(presupuesto || obj));
                return Math.max(obj, pre) >= 100;
            }
            function isPeriodoValido(mes, anio) {
                mes = Number(mes || 0); anio = Number(anio || 0);
                return mes >= 1 && mes <= 12 && anio >= 2020 && anio <= 2100;
            }
            function setPeriodoSiguienteMes($selMes, $inpAnio) {
                const f = new Date(), m = f.getMonth() + 1, y = f.getFullYear();
                $selMes.val(m === 12 ? 1 : m + 1);
                $inpAnio.val(m === 12 ? y + 1 : y);
            }

            // Totales, participación, diferencia y marcas de cambio (las tres pestañas usan lo mismo)
            const PANES = {
                '#tbodyCedis': { obj: 'totObj', pre: 'totPre', diff: 'cedisDiff', vacio: 'cedisVacio', info: 'cedisInfo' },
                '#tbodyVendedor': { obj: 'venTotObj', pre: 'venTotPre', diff: 'venDiff', vacio: 'venVacio', info: 'venInfo' },
                '#tbodyCliente': { obj: 'cliTotObj', pre: 'cliTotPre', diff: 'cliDiff', vacio: 'cliVacio', info: 'cliInfo' }
            };
            function refrescarTabla(tbodySelector) {
                const cfg = PANES[tbodySelector];
                let obj = 0, pre = 0;
                const filas = document.querySelectorAll(`${tbodySelector} tr`);
                document.querySelectorAll(`${tbodySelector} input[name$=".Objetivo"]`).forEach(x => obj += Number(x.value || 0));
                const pres = [...document.querySelectorAll(`${tbodySelector} input.pre`)];
                pres.forEach(x => pre += Number(x.value || 0));
                pres.forEach(inp => {
                    const tr = inp.closest('tr');
                    const v = Number(inp.value || 0);
                    const td = tr?.querySelector('.part-cell');
                    if (td) td.textContent = (pre > 0 ? (v * 100 / pre) : 0).toFixed(1) + '%';
                    const o = Number(tr?.querySelector('input[name$=".Objetivo"]')?.value || 0);
                    inp.classList.toggle('is-changed', v !== o);
                    if (v > 0) inp.classList.remove('is-invalid');
                });
                document.getElementById(cfg.obj).textContent = fmt(obj);
                document.getElementById(cfg.pre).textContent = fmt(pre);
                const d = document.getElementById(cfg.diff);
                if (d) {
                    const pct = obj > 0 ? ((pre - obj) * 100 / obj) : 0;
                    d.textContent = filas.length && obj > 0 ? `${pct >= 0 ? '+' : ''}${pct.toFixed(1)}% vs objetivo` : '';
                    d.className = 'pr-diff' + (pct > 0.05 ? ' up' : pct < -0.05 ? ' down' : '');
                }
                document.getElementById(cfg.vacio).style.display = filas.length ? 'none' : '';
                const info = document.getElementById(cfg.info);
                if (info) info.textContent = filas.length ? `${filas.length} renglón(es) · amarillo = ajustado vs objetivo` : '';
            }
            // Compatibilidad con los nombres anteriores
            const updateTotalesUI = (tb) => refrescarTabla(tb);
            const recalcPartUI = (tb) => refrescarTabla(tb);

            function validarNoCero(tbodySelector) {
                let ok = true, primero = null;
                document.querySelectorAll(`${tbodySelector} input.pre`).forEach(i => {
                    const malo = Number(i.value || 0) <= 0;
                    i.classList.toggle('is-invalid', malo);
                    if (malo) { ok = false; primero = primero || i; }
                });
                primero?.scrollIntoView({ behavior: 'smooth', block: 'center' });
                primero?.focus();
                return ok;
            }

            function marcarNota(btn, texto) {
                if (!btn) return;
                const tiene = !!String(texto || '').trim();
                btn.classList.toggle('has-note', tiene);
                btn.title = tiene ? texto : 'Agregar comentario';
            }

            // Fila genérica de SKU (CEDIS / Vendedor / Cliente)
            function filaHtml({ i, sku, cliente, clienteLabel, refs, porMes, objetivo, presupuesto, comentario, comPrefix, comClass, conBorrar }) {
                const skuSafe = escapeHtml(sku);
                const cliSafe = escapeHtml(cliente || '');
                const tdsMeses = refs.map(r => `<td class="text-end">${fmt(porMes ? (porMes[r.key] || 0) : 0)}</td>`).join('');
                const com = String(comentario || '');
                return `
                            <tr data-sku="${skuSafe}" ${cliente != null ? `data-cliente="${cliSafe}"` : ''}>
                                <td>${skuSafe}
                                    <input type="hidden" name="items[${i}].ProductoCodigo" value="${skuSafe}">
                                    <input type="hidden" name="items[${i}].Objetivo" value="${Number(objetivo) || 0}">
                                    ${cliente != null ? `<input type="hidden" name="items[${i}].Cliente" value="${cliSafe}">` : ''}
                                </td>
                                ${clienteLabel != null ? `<td title="${escapeHtml(clienteLabel)}">${escapeHtml(clienteLabel)}</td>` : ''}
                                ${tdsMeses}
                                <td class="text-end pr-obj">${fmt(objetivo)}</td>
                                <td class="text-end"><input type="number" class="form-control form-control-sm text-end pre" name="items[${i}].Presupuesto" value="${Number(presupuesto) || 0}" min="0" step="1" aria-label="Presupuesto ${skuSafe}"></td>
                                <td class="text-end part-cell">0.0%</td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-outline-secondary btn-sm ${comClass} ${com.trim() ? 'has-note' : ''}" data-sku="${skuSafe}" data-index="${i}" title="${com.trim() ? escapeHtml(com) : 'Agregar comentario'}" aria-label="Comentario ${skuSafe}"><i class="bi bi-chat-left-text"></i></button>
                                    <input type="hidden" name="items[${i}].Comentario" id="${comPrefix}${i}" value="${escapeHtml(com)}" />
                                </td>
                                ${conBorrar ? `<td class="text-center"><button type="button" class="btn btn-outline-danger btn-sm del" title="Quitar SKU" aria-label="Quitar ${skuSafe}"><i class="bi bi-trash"></i></button></td>` : ''}
                            </tr>`;
            }

            async function postFormData(url, fd) {
                const r = await fetch(url, { method: 'POST', credentials: 'same-origin', headers: { 'RequestVerificationToken': tokenAny(), 'X-Requested-With': 'XMLHttpRequest' }, body: fd });
                const ct = r.headers.get('content-type') || '';
                const data = ct.includes('json') ? await r.json().catch(() => null) : null;
                const text = data ? '' : await r.text().catch(() => '');
                return { r, data, text };
            }

            // =================== CEDIS ===================
            const CEDIS = (function() {
                let comentarioTargetId = null;

                async function cargarCanales() {
                    const $sel = $("#selCanal").empty().append('<option value="">Selecciona CEDIS</option>');
                    try {
                        toggleSpin(true, 'Cargando CEDIS…');
                        const r = await fetch(API.canales, { credentials: 'same-origin' });
                        const data = r.ok ? await r.json() : [];
                        (data || []).filter(c => /^CEDIS/i.test(c)).sort((a, b) => String(a).localeCompare(String(b)))
                            .forEach(c => $sel.append(`<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`));
                    } catch { showToast("Error al cargar CEDIS.", "danger"); }
                    finally { toggleSpin(false); }
                }

                async function traerVentas() {
                    const canal = $("#selCanal").val() || '';
                    const meses = parseInt($("#filtroMesesObjetivo").val() || "12", 10);
                    if (!canal) { showToast("Selecciona un CEDIS.", "warning"); $("#selCanal").trigger('focus'); return null; }
                    try {
                        toggleSpin(true, `Calculando objetivo de ${canal}…`);
                        const r = await fetch(`${API.datos}?canal=${encodeURIComponent(canal)}&meses=${meses}`, { credentials: 'same-origin' });
                        if (!r.ok) throw 0;
                        const data = await r.json();
                        if (!Array.isArray(data) || !data.length) { showToast("Sin ventas para ese CEDIS en la ventana elegida.", "warning"); return null; }
                        const refs = buildMonthRefs(meses), porSku = {};
                        data.forEach(d => {
                            const sku = d.sku;
                            if (!sku) return;
                            const f = new Date(d.fecha);
                            const ym = `${f.getFullYear()}-${String(f.getMonth() + 1).padStart(2, '0')}`;
                            porSku[sku] = porSku[sku] || { porMes: {}, objetivo: 0 };
                            porSku[sku].porMes[ym] = (porSku[sku].porMes[ym] || 0) + Number(d.totalKilos || 0);
                        });
                        Object.keys(porSku).forEach(s => {
                            const sum = refs.reduce((a, r) => a + (porSku[s].porMes[r.key] || 0), 0);
                            porSku[s].objetivo = Math.round(sum / Math.max(1, meses));
                        });
                        return { porSku, refs };
                    } catch { showToast("Error al consultar ventas.", "danger"); return null; }
                    finally { toggleSpin(false); }
                }

                function renderTabla({ porSku, refs }) {
                    document.querySelector('#tablaCedis thead').innerHTML = `<tr><th>SKU</th>${thMesesHtml(refs)}<th class="text-end">Objetivo</th><th class="text-end">Presupuesto</th><th class="text-end">Participación</th><th class="text-center">Comentario</th><th style="width:44px;"></th></tr>`;
                    let i = 0, html = '';
                    Object.keys(porSku).sort().forEach(sku => {
                        const d = porSku[sku];
                        if (!shouldIncludeRow(d.objetivo, d.objetivo)) return;
                        html += filaHtml({ i, sku, refs, porMes: d.porMes, objetivo: d.objetivo, presupuesto: d.objetivo, comPrefix: 'comentario-', comClass: 'btnComentarioCedis', conBorrar: true });
                        i++;
                    });
                    document.getElementById('tbodyCedis').innerHTML = html;
                    refrescarTabla('#tbodyCedis');
                }

                function renumerar() {
                    document.querySelectorAll('#tbodyCedis tr').forEach((tr, idx) => {
                        tr.querySelectorAll('input[name^="items["]').forEach(inp => inp.name = inp.name.replace(/items\[\d+\]/, `items[${idx}]`));
                        tr.querySelector('.btnComentarioCedis')?.setAttribute('data-index', idx);
                        const com = tr.querySelector('input[name$=".Comentario"]');
                        if (com) com.id = `comentario-${idx}`;
                    });
                }

                async function guardarDesdeModal() {
                    if (!validarNoCero('#tbodyCedis')) { showToast("Hay presupuestos en 0; corrígelos o quita esos SKU.", "danger"); bootstrap.Modal.getInstance(document.getElementById('modalGuardarCedis'))?.hide(); return; }
                    const mes = parseInt($("#modalMes").val(), 10), anio = parseInt($("#modalAnio").val(), 10);
                    if (!isPeriodoValido(mes, anio)) { showToast("Selecciona un mes y año válidos.", "warning"); return; }
                    const canal = $("#selCanal").val() || '';
                    if (!canal) { showToast("Selecciona un CEDIS.", "warning"); return; }
                    $("#CanalInput").val(canal); $("#MesInput").val(mes); $("#AnioInput").val(anio);
                    try {
                        toggleSpin(true, 'Guardando presupuesto CEDIS…');
                        const { r, data } = await postFormData(API.guardar, new FormData(document.getElementById('frmPresupuestoCedis')));
                        if (r.ok && (!data || data.ok || data.success)) {
                            banner(`Presupuesto de ${canal} guardado para ${String(mes).padStart(2, '0')}/${anio}.`, "success");
                            showToast("Guardado.", "success");
                            bootstrap.Modal.getInstance(document.getElementById('modalGuardarCedis'))?.hide();
                        } else {
                            showToast("No se pudo guardar.", "danger");
                            banner(data?.message || 'Error al guardar', "warning");
                        }
                    } catch { showToast("Error de red al guardar. Revisa en Administrar si se guardó antes de reintentar.", "danger"); }
                    finally { toggleSpin(false); }
                }

                function bind() {
                    $("#btnAgregar").on('click', async () => {
                        const res = await traerVentas();
                        if (!res) return;
                        renderTabla(res);
                        banner("", "success");
                        showToast("Ventas cargadas.", "success");
                    });
                    $("#btnAbrirModalGuardar").on("click", () => {
                        const filas = document.querySelectorAll('#tbodyCedis tr').length;
                        if (!filas) { showToast("No hay renglones para guardar.", "warning"); return; }
                        if (!$("#selCanal").val()) { showToast("Selecciona el CEDIS antes de guardar.", "warning"); $("#selCanal").trigger('focus'); return; }
                        $("#mgcResumen").html(`Se guardarán <b>${filas}</b> SKU de <b>${escapeHtml($("#selCanal").val())}</b> con un total de <b>${escapeHtml($("#totPre").text())}</b> kg.`);
                        bootstrap.Modal.getOrCreateInstance(document.getElementById('modalGuardarCedis')).show();
                    });
                    $("#btnGuardarModalCedis").on("click", guardarDesdeModal);
                    $(document).on('input', '#tbodyCedis input.pre', () => refrescarTabla('#tbodyCedis'));
                    $(document).on('click', '#tbodyCedis .del', function() {
                        this.closest('tr')?.remove();
                        renumerar();
                        refrescarTabla('#tbodyCedis');
                    });
                    $(document).on("click", ".btnComentarioCedis", function() {
                        comentarioTargetId = `comentario-${$(this).data("index")}`;
                        $("#comentarioSkuCedis").text($(this).data("sku"));
                        $("#comentarioTextoCedis").val($(`#${comentarioTargetId}`).val() || "");
                        bootstrap.Modal.getOrCreateInstance(document.getElementById('comentarioModalCedis')).show();
                    });
                    $("#guardarComentarioCedis").on("click", () => {
                        const c = $("#comentarioTextoCedis").val();
                        if (comentarioTargetId) { $(`#${comentarioTargetId}`).val(c); marcarNota(document.getElementById(comentarioTargetId)?.previousElementSibling, c); }
                        bootstrap.Modal.getInstance(document.getElementById('comentarioModalCedis'))?.hide();
                    });
                    const f = new Date(), m = f.getMonth() + 1, y = f.getFullYear();
                    $("#modalMes").val(m === 12 ? 1 : m + 1);
                    $("#modalAnio").val(m === 12 ? y + 1 : y).attr("min", y);
                }

                return { init: async () => { bind(); refrescarTabla('#tbodyCedis'); await cargarCanales(); } };
            })();

            // =================== VENDEDOR ===================
            const VENDEDOR = (function() {
                async function cargarVendedores() {
                    const $sel = $("#selVendedor").empty().append('<option value="">Selecciona vendedor</option>');
                    try {
                        toggleSpin(true, 'Cargando vendedores…');
                        const r = await fetch(API.vendedores, { credentials: 'same-origin' });
                        const data = r.ok ? await r.json() : [];
                        (data || []).forEach(v => {
                            const id = v.id ?? v.Id, nom = v.nombre ?? v.Nombre ?? '';
                            if (id != null) $sel.append(`<option value="${escapeHtml(id)}">${escapeHtml(id)}${nom ? " - " + escapeHtml(nom) : ""}</option>`);
                        });
                    } catch { showToast("Error al cargar vendedores.", "danger"); }
                    finally { toggleSpin(false); }
                }

                async function traerVentas() {
                    const vendedorId = parseInt($("#selVendedor").val() || "0", 10);
                    const meses = parseInt($("#venMesesObjetivo").val() || "12", 10);
                    if (!vendedorId) { showToast("Selecciona un vendedor.", "warning"); $("#selVendedor").trigger('focus'); return null; }
                    try {
                        toggleSpin(true, 'Calculando objetivo del vendedor…');
                        const r = await fetch(`${API.datosVendedor}?vendedorId=${vendedorId}&meses=${meses}`, { credentials: 'same-origin' });
                        if (!r.ok) throw 0;
                        const data = await r.json();
                        if (!Array.isArray(data) || !data.length) { showToast("Sin ventas para ese vendedor en la ventana elegida.", "warning"); return null; }
                        const refs = buildMonthRefs(meses), porSku = {};
                        data.forEach(d => {
                            const sku = d.sku || d.Sku || d.productoCodigo || d.ProductoCodigo;
                            if (!sku) return;
                            const f = new Date(d.fecha || d.Fecha);
                            const ym = `${f.getFullYear()}-${String(f.getMonth() + 1).padStart(2, '0')}`;
                            porSku[sku] = porSku[sku] || { porMes: {}, objetivo: 0, presupuesto: 0 };
                            porSku[sku].porMes[ym] = (porSku[sku].porMes[ym] || 0) + Number(d.totalKilos || d.TotalKilos || d.total || 0);
                        });
                        Object.keys(porSku).forEach(s => {
                            const sum = refs.reduce((a, r) => a + (porSku[s].porMes[r.key] || 0), 0);
                            porSku[s].objetivo = Math.round(sum / Math.max(1, meses));
                            porSku[s].presupuesto = porSku[s].objetivo;
                        });
                        return { porSku, refs };
                    } catch { showToast("Error al consultar ventas por vendedor.", "danger"); return null; }
                    finally { toggleSpin(false); }
                }

                function renderTabla({ porSku, refs }) {
                    document.querySelector('#tablaVendedor thead').innerHTML = `<tr><th>SKU</th>${thMesesHtml(refs)}<th class="text-end">Objetivo</th><th class="text-end">Presupuesto</th><th class="text-end">Participación</th><th class="text-center">Comentario</th></tr>`;
                    let i = 0, html = '';
                    Object.keys(porSku).sort().forEach(sku => {
                        const d = porSku[sku];
                        if (!shouldIncludeRow(d.objetivo, d.presupuesto)) return;
                        html += filaHtml({ i, sku, refs, porMes: d.porMes, objetivo: d.objetivo, presupuesto: d.presupuesto, comPrefix: 'ven-comentario-', comClass: 'btnComentarioVendedor' });
                        i++;
                    });
                    document.getElementById('tbodyVendedor').innerHTML = html;
                    refrescarTabla('#tbodyVendedor');
                }

                function bind() {
                    let comentarioTargetId = null;
                    $("#btnCargarVendedor").on("click", async () => {
                        const res = await traerVentas();
                        if (!res) return;
                        renderTabla(res);
                        showToast("Ventas del vendedor cargadas.", "success");
                    });
                    $(document).on('input', '#tbodyVendedor input.pre', () => refrescarTabla('#tbodyVendedor'));
                    $(document).on("click", ".btnComentarioVendedor", function() {
                        comentarioTargetId = `ven-comentario-${$(this).data("index")}`;
                        $("#comentarioSkuVendedor").text($(this).data("sku"));
                        $("#comentarioTextoVendedor").val($(`#${comentarioTargetId}`).val() || "");
                        bootstrap.Modal.getOrCreateInstance(document.getElementById("comentarioModalVendedor")).show();
                    });
                    $("#guardarComentarioVendedor").on("click", () => {
                        const c = $("#comentarioTextoVendedor").val();
                        if (comentarioTargetId) { $(`#${comentarioTargetId}`).val(c); marcarNota(document.getElementById(comentarioTargetId)?.previousElementSibling, c); }
                        bootstrap.Modal.getInstance(document.getElementById('comentarioModalVendedor'))?.hide();
                    });

                    $("#btnGuardarVendedor").on("click", async () => {
                        if (!document.querySelectorAll('#tbodyVendedor tr').length) { showToast("No hay renglones para guardar.", "warning"); return; }
                        if (!validarNoCero('#tbodyVendedor')) { showToast("Hay presupuestos en 0.", "danger"); return; }
                        const mes = parseInt($("#venMes").val(), 10), anio = parseInt($("#venAnio").val(), 10);
                        if (!isPeriodoValido(mes, anio)) { showToast("Selecciona un mes y año válidos.", "warning"); return; }
                        const vendedorId = parseInt($("#selVendedor").val() || "0", 10);
                        if (!vendedorId) { showToast("Selecciona un vendedor.", "warning"); return; }
                        if (!confirm(`¿Guardar el presupuesto de ${$("#selVendedor option:selected").text()} para ${String(mes).padStart(2, '0')}/${anio}?\n\nTotal: ${$("#venTotPre").text()} kg`)) return;
                        try {
                            toggleSpin(true, 'Guardando presupuesto del vendedor…');
                            const fd = new FormData();
                            fd.append("VendedorId", vendedorId); fd.append("Mes", mes); fd.append("Anio", anio);
                            document.querySelectorAll('#tbodyVendedor input[name^="items["]').forEach(inp => fd.append(inp.name, inp.value));
                            const { r, data } = await postFormData(API.guardarVendedor, fd);
                            if (r.ok && (!data || data.ok || data.success)) showToast("Presupuesto del vendedor guardado.", "success");
                            else showToast(data?.message || "No se pudo guardar.", "danger");
                        } catch { showToast("Error de red al guardar. Revisa en Administrar si se guardó antes de reintentar.", "danger"); }
                        finally { toggleSpin(false); }
                    });

                    document.getElementById("tab-ven")?.addEventListener("shown.bs.tab", async () => {
                        if ($("#selVendedor option").length <= 1) {
                            setPeriodoSiguienteMes($("#venMes"), $("#venAnio"));
                            await cargarVendedores();
                        }
                    });
                }
                return { init: () => { bind(); refrescarTabla('#tbodyVendedor'); } };
            })();

            // =================== CLIENTE ===================
            const CLIENTE = (function() {
                let _cliAll = [], _cliLoaded = false, _combosCargados = false;
                const _N = x => String(x ?? "").trim().toUpperCase();

                async function cargarCombo(url, $sel, primero, mapear) {
                    $sel.empty();
                    if (primero) $sel.append(primero);
                    try {
                        const r = await fetch(url, { credentials: 'same-origin' });
                        const data = r.ok ? await r.json() : [];
                        mapear(data || []).forEach(o => $sel.append(o));
                    } catch { showToast("Error al cargar opciones de filtro.", "danger"); }
                }
                const textoOpcion = x => (typeof x === 'string' ? x : (x.value ?? x.nombre ?? x.name ?? x.id));
                async function cargarCombos() {
                    toggleSpin(true, 'Cargando filtros…');
                    try {
                        await Promise.all([
                            cargarCombo(API.canalesCliente, $("#cliCanal"), '<option value="">Todos los canales</option>', d => d.map(textoOpcion).filter(Boolean).sort((a, b) => String(a).localeCompare(String(b))).map(c => `<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`)),
                            cargarCombo(API.clasificacionesCliente, $("#cliClasificacion"), '<option value="">Todas</option>', d => d.map(textoOpcion).filter(Boolean).sort((a, b) => String(a).localeCompare(String(b))).map(c => `<option value="${escapeHtml(c)}">${escapeHtml(c)}</option>`)),
                            cargarCombo(API.vendedores, $("#cliVendedores"), '', d => d.map(v => {
                                const id = v.id ?? v.Id ?? v.slpCode ?? v.SlpCode, nom = v.nombre ?? v.Nombre ?? v.name ?? v.Name ?? '';
                                return id == null ? '' : `<option value="${escapeHtml(id)}">${escapeHtml(id)}${nom ? " - " + escapeHtml(nom) : ""}</option>`;
                            }).filter(Boolean))
                        ]);
                        _combosCargados = true;
                    } finally { toggleSpin(false); }
                }

                function actualizarConteo() {
                    const n = document.querySelectorAll("#cliListaClientes .cliChk:checked").length;
                    $("#cliSelCount").text(`${n} seleccionado${n === 1 ? '' : 's'}${_cliLoaded ? ` de ${_cliAll.length}` : ''}`);
                }

                function cliRenderList(list) {
                    const wrap = document.getElementById("cliListaClientes");
                    if (!wrap) return;
                    const marcados = new Set([...document.querySelectorAll("#cliListaClientes .cliChk:checked")].map(x => x.value));
                    if (!list.length) { wrap.innerHTML = `<div class="text-muted p-2">No hay clientes con esos filtros.</div>`; actualizarConteo(); return; }
                    wrap.innerHTML = list.map(c => {
                        const meta = [c.canal, c.clas, c.vend].filter(Boolean).map(escapeHtml).join(" · ");
                        return `<label><input class="form-check-input cliChk" type="checkbox" value="${escapeHtml(c.id)}" ${marcados.has(c.id) ? 'checked' : ''}><span><div class="fw-semibold">${escapeHtml(c.id)}${c.nom ? " - " + escapeHtml(c.nom) : ""}</div>${meta ? `<div class="text-muted" style="font-size:11.5px">${meta}</div>` : ''}</span></label>`;
                    }).join("");
                    actualizarConteo();
                }

                function cliApplyFiltersLocal() {
                    const q = String($("#cliBuscarLista").val() || "").trim().toLowerCase();
                    const canal = _N($("#cliCanal").val()), clas = _N($("#cliClasificacion").val());
                    const vends = ($("#cliVendedores").val() || []).map(_N);
                    const hasMeta = _cliAll.some(c => (c.canal || c.clas || c.vend));
                    cliRenderList(_cliAll.filter(c => {
                        if (hasMeta) {
                            if (canal && _N(c.canal) !== canal) return false;
                            if (clas && _N(c.clas) !== clas) return false;
                            if (vends.length && !vends.includes(_N(c.vend))) return false;
                        }
                        return !q || (String(c.id) + " " + String(c.nom)).toLowerCase().includes(q);
                    }));
                }

                let _cargaSeq = 0;
                async function cliCargarClientes() {
                    const seq = ++_cargaSeq;
                    try {
                        toggleSpin(true, 'Cargando clientes…');
                        const canal = $("#cliCanal").val() || "", clasif = $("#cliClasificacion").val() || "";
                        const vendedores = ($("#cliVendedores").val() || []).join(",");
                        const url = (!canal && vendedores && vendedores.split(",").length === 1)
                            ? `${API.clientesPorVendedor}?vendedorId=${encodeURIComponent(vendedores)}&clasif=${encodeURIComponent(clasif)}`
                            : `${API.clientes}?vendedores=${encodeURIComponent(vendedores)}&canal=${encodeURIComponent(canal)}&clasif=${encodeURIComponent(clasif)}`;
                        const r = await fetch(url, { credentials: "same-origin" });
                        const data = r.ok ? await r.json() : [];
                        if (seq !== _cargaSeq) return;
                        _cliAll = (Array.isArray(data) ? data : []).map(raw => ({
                            id: String(raw.id ?? raw.value ?? raw.cardCode ?? raw.CardCode ?? ""),
                            nom: String(raw.text ?? raw.label ?? raw.nombre ?? raw.Nombre ?? raw.cardName ?? raw.CardName ?? ""),
                            canal: String(raw.canal ?? raw.Canal ?? ""),
                            clas: String(raw.clas ?? raw.Clasificacion ?? ""),
                            vend: String(raw.vend ?? raw.VendedorId ?? raw.slpCode ?? "")
                        })).filter(x => x.id);
                        _cliLoaded = true;
                        cliApplyFiltersLocal();
                    } catch (e) { console.error(e); showToast("Error al cargar clientes.", "danger"); }
                    finally { toggleSpin(false); }
                }

                function cliGetSelectedClientIds() {
                    const one = String($("#cliClienteIndividualId").val() || "");
                    if (one) return [one];
                    return [...document.querySelectorAll("#cliListaClientes .cliChk:checked")].map(x => String(x.value));
                }

                // Ventas por cliente (4 consultas a la vez; antes eran una por una)
                async function cliTraerVentasPorClientes(ids) {
                    const meses = parseInt($("#cliMesesObjetivo").val() || "12", 10);
                    const refs = buildMonthRefs(meses);
                    const all = [];
                    let idx = 0, hechos = 0;
                    async function worker() {
                        while (idx < ids.length) {
                            const id = ids[idx++];
                            try {
                                const r = await fetch(`${API.ventasCliente}?cardCode=${encodeURIComponent(id)}`, { credentials: "same-origin" });
                                if (r.ok) {
                                    const j = await r.json().catch(() => []);
                                    if (Array.isArray(j)) j.forEach(x => all.push({ ...x, __cliente: id }));
                                }
                            } catch { }
                            document.getElementById('loadingSpinnerTexto').textContent = `Consultando ventas… ${++hechos} de ${ids.length} clientes`;
                        }
                    }
                    await Promise.all(Array.from({ length: Math.min(4, ids.length) }, worker));
                    return all.length ? { data: all, refs, meses } : null;
                }

                function cliBuildPorClienteSkuFromVentas(raw, refs, meses) {
                    const porKey = {};
                    (raw || []).forEach(d => {
                        const sku = String(d.sku || d.Sku || d.productoCodigo || d.ProductoCodigo || "").trim();
                        if (!sku) return;
                        const clienteId = String(d.Cliente || d.cliente || d.CardCode || d.cardCode || d.ClienteId || d.clienteId || d.__cliente || "").trim();
                        if (!clienteId) return;
                        const clienteNom = String(d.CardName || d.cardName || d.nombreCliente || d.NombreCliente || "").trim();
                        const f = new Date(d.fecha || d.Fecha);
                        if (isNaN(f.getTime())) return;
                        const ym = `${f.getFullYear()}-${String(f.getMonth() + 1).padStart(2, "0")}`;
                        const key = `${clienteId}||${sku}`.toUpperCase();
                        porKey[key] ||= { sku: sku.toUpperCase(), clienteId: clienteId.toUpperCase(), clienteNom, porMes: {}, objetivo: 0, presupuesto: 0 };
                        porKey[key].porMes[ym] = (porKey[key].porMes[ym] || 0) + Number(d.totalKilos ?? d.TotalKilos ?? d.kilos ?? d.Kilos ?? d.total ?? 0);
                    });
                    const rows = Object.values(porKey);
                    rows.forEach(r => {
                        r.objetivo = Math.round(refs.reduce((a, m) => a + (r.porMes[m.key] || 0), 0) / Math.max(1, meses));
                        r.presupuesto = r.objetivo;
                    });
                    rows.sort((a, b) => (a.clienteId + " " + a.sku).localeCompare(b.clienteId + " " + b.sku));
                    return rows;
                }

                const nombreCliente = id => (_cliAll.find(c => _N(c.id) === _N(id))?.nom || '');

                function renderTablaCliente({ rows, refs }) {
                    document.querySelector("#tablaCliente thead").innerHTML = `<tr><th>SKU</th><th>Cliente</th>${thMesesHtml(refs)}<th class="text-end">Objetivo</th><th class="text-end">Presupuesto</th><th class="text-end">Participación</th><th class="text-center">Comentario</th></tr>`;
                    let i = 0, html = '';
                    (rows || []).forEach(d => {
                        if (!shouldIncludeRow(d.objetivo, d.presupuesto)) return;
                        const nom = d.clienteNom || nombreCliente(d.clienteId);
                        html += filaHtml({ i, sku: d.sku, cliente: d.clienteId, clienteLabel: nom ? `${nom} (${d.clienteId})` : d.clienteId, refs, porMes: d.porMes, objetivo: d.objetivo, presupuesto: d.presupuesto, comPrefix: 'cli-comentario-', comClass: 'btnComentarioCliente' });
                        i++;
                    });
                    document.getElementById("tbodyCliente").innerHTML = html;
                    refrescarTabla('#tbodyCliente');
                }

                async function cliConsultar() {
                    const ids = cliGetSelectedClientIds();
                    if (!ids.length) { showToast("Selecciona al menos 1 cliente de la lista.", "warning"); return; }
                    try {
                        toggleSpin(true, `Consultando ventas de ${ids.length} cliente(s)…`);
                        const pack = await cliTraerVentasPorClientes(ids);
                        if (!pack) { showToast("Sin ventas para esos clientes.", "warning"); return; }
                        renderTablaCliente({ rows: cliBuildPorClienteSkuFromVentas(pack.data, pack.refs, pack.meses), refs: pack.refs });
                        showToast("Ventas cargadas.", "success");
                    } catch (e) { console.error(e); showToast("Error al consultar ventas por cliente(s).", "danger"); }
                    finally { toggleSpin(false); }
                }

                /* CORRECCIÓN DEL GUARDADO POR CLIENTE
                   Antes, con varios clientes seleccionados, se enviaban TODOS los renglones (de todos los
                   clientes) una vez por cada cliente, y cada renglón se repetía con unos diez nombres de campo
                   distintos (más de 100 campos por renglón; el servidor rechaza formularios de más de 1024
                   campos por omisión). Ahora cada envío lleva solo los renglones de ese cliente, con los mismos
                   nombres que usan CEDIS y Vendedor: items[i].ProductoCodigo / Objetivo / Presupuesto /
                   Comentario / Cliente, más Cliente, Mes y Anio. */
                function filasDelCliente(clienteId, unicoSeleccionado) {
                    const out = [];
                    document.querySelectorAll("#tbodyCliente tr").forEach(tr => {
                        const cli = _N(tr.getAttribute("data-cliente") || '');
                        // Renglones importados sin cliente se asignan al cliente si es el único seleccionado
                        if (cli ? cli !== _N(clienteId) : !unicoSeleccionado) return;
                        const sku = String(tr.querySelector('input[name$=".ProductoCodigo"]')?.value || tr.getAttribute("data-sku") || "").trim();
                        if (!sku) return;
                        out.push({
                            sku,
                            obj: String(tr.querySelector('input[name$=".Objetivo"]')?.value ?? "0"),
                            pre: String(tr.querySelector("input.pre")?.value ?? "0"),
                            com: String(tr.querySelector('input[name$=".Comentario"]')?.value ?? "")
                        });
                    });
                    return out;
                }

                async function guardarCliente(mes, anio, cardCode, unicoSeleccionado) {
                    const cc = String(cardCode || "").trim();
                    const filas = filasDelCliente(cc, unicoSeleccionado);
                    if (!filas.length) return { ok: true, vacio: true };
                    const fd = new FormData();
                    fd.append("Cliente", cc); fd.append("Mes", mes); fd.append("Anio", anio);
                    filas.forEach((f, i) => {
                        fd.append(`items[${i}].ProductoCodigo`, f.sku);
                        fd.append(`items[${i}].Objetivo`, f.obj);
                        fd.append(`items[${i}].Presupuesto`, f.pre);
                        fd.append(`items[${i}].Comentario`, f.com);
                        fd.append(`items[${i}].Cliente`, cc);
                    });
                    const url = (document.getElementById("frmPresupuestoCliente")?.getAttribute("action") || "").trim() || API.guardarCliente;
                    const { r, data, text } = await postFormData(url, fd);
                    if (r.ok && (data?.ok || data?.success)) return { ok: true, n: filas.length };
                    console.warn("Respuesta del servidor al guardar cliente", cc, data || text);
                    return { ok: false, msg: data?.message || data?.error || text || `HTTP ${r.status}` };
                }

                async function cliGuardar() {
                    const ids = cliGetSelectedClientIds();
                    if (!ids.length) { showToast("Selecciona los clientes a guardar.", "warning"); return; }
                    if (!document.querySelectorAll("#tbodyCliente tr").length) { showToast("No hay renglones para guardar.", "warning"); return; }
                    const sinCliente = document.querySelectorAll("#tbodyCliente tr:not([data-cliente])").length;
                    if (sinCliente && ids.length > 1) { showToast(`Hay ${sinCliente} renglón(es) importados sin columna Cliente; selecciona un solo cliente o agrega la columna en el Excel.`, "warning"); return; }
                    const mes = parseInt($("#cliMes").val(), 10), anio = parseInt($("#cliAnio").val(), 10);
                    if (!isPeriodoValido(mes, anio)) { showToast("Selecciona un mes y año válidos.", "warning"); return; }
                    if (!confirm(`¿Guardar el presupuesto de ${ids.length} cliente(s) para ${String(mes).padStart(2, '0')}/${anio}?\n\nTotal: ${$("#cliTotPre").text()} kg`)) return;

                    toggleSpin(true, 'Guardando presupuestos por cliente…');
                    let ok = 0, fallos = [], vacios = 0, n = 0;
                    try {
                        for (const id of ids) {
                            document.getElementById('loadingSpinnerTexto').textContent = `Guardando… ${++n} de ${ids.length} clientes`;
                            try {
                                const res = await guardarCliente(mes, anio, id, ids.length === 1);
                                if (res.vacio) vacios++; else if (res.ok) ok++; else fallos.push(`${id}: ${res.msg}`);
                            } catch (e) { fallos.push(`${id}: error de red`); }
                        }
                    } finally { toggleSpin(false); }
                    if (!fallos.length) showToast(`Guardado: ${ok} cliente(s)${vacios ? ` · ${vacios} sin renglones` : ''}.`, "success");
                    else {
                        showToast(`Guardados ${ok} de ${ids.length}. Fallaron ${fallos.length}.`, "danger");
                        banner(`No se guardaron: ${fallos.slice(0, 5).join(' | ')}${fallos.length > 5 ? '…' : ''}`, "warning");
                    }
                }

                function bindClienteUI() {
                    // CORRECCIÓN: los filtros se cargan una vez; antes se recargaban (y se perdía la
                    // selección) cada vez que se regresaba a esta pestaña.
                    document.getElementById("tab-cli")?.addEventListener("shown.bs.tab", async () => {
                        if (_combosCargados) return;
                        setPeriodoSiguienteMes($("#cliMes"), $("#cliAnio"));
                        await cargarCombos();
                    });
                    $("#cliCanal, #cliClasificacion, #cliVendedores").on("change", cliCargarClientes);
                    $("#cliBuscarLista").on("input", cliApplyFiltersLocal);
                    $("#cliBtnCargarClientes").on("click", cliCargarClientes);
                    $("#cliBtnSelTodo").on("click", () => { document.querySelectorAll("#cliListaClientes .cliChk").forEach(x => x.checked = true); actualizarConteo(); });
                    $("#cliBtnLimpiar").on("click", () => {
                        $("#cliBuscarLista").val("");
                        document.querySelectorAll("#cliListaClientes .cliChk").forEach(x => x.checked = false);
                        cliApplyFiltersLocal();
                    });
                    $(document).on("change", "#cliListaClientes .cliChk", actualizarConteo);
                    $("#cliBtnPresupuestar").on("click", cliConsultar);
                    $(document).on('input', '#tbodyCliente input.pre', () => refrescarTabla('#tbodyCliente'));

                    let target = null;
                    $(document).on("click", ".btnComentarioCliente", function() {
                        target = `cli-comentario-${$(this).data("index")}`;
                        $("#comentarioSkuCliente").text($(this).data("sku"));
                        $("#comentarioTextoCliente").val($(`#${target}`).val() || "");
                        bootstrap.Modal.getOrCreateInstance(document.getElementById("comentarioModalCliente")).show();
                    });
                    $("#guardarComentarioCliente").on("click", () => {
                        const c = $("#comentarioTextoCliente").val();
                        if (target) { $(`#${target}`).val(c); marcarNota(document.getElementById(target)?.previousElementSibling, c); }
                        bootstrap.Modal.getInstance(document.getElementById('comentarioModalCliente'))?.hide();
                    });
                    $("#btnGuardarCliente").on("click", e => { e.preventDefault(); cliGuardar(); });
                }

                function getClienteLabelParaExcel() {
                    const ids = cliGetSelectedClientIds();
                    return ids.length === 1 ? ids[0] : (ids.length ? `${ids.length}clientes` : "Cliente");
                }
                return { init: () => { bindClienteUI(); refrescarTabla('#tbodyCliente'); }, getClienteLabelParaExcel, nombreCliente };
            })();

            // =================== EXCEL ===================
            const EXCEL = (function() {
                const ES_MONTHS = { 'enero': 1, 'ene': 1, 'febrero': 2, 'feb': 2, 'marzo': 3, 'mar': 3, 'abril': 4, 'abr': 4, 'mayo': 5, 'may': 5, 'junio': 6, 'jun': 6, 'julio': 7, 'jul': 7, 'agosto': 8, 'ago': 8, 'septiembre': 9, 'sep': 9, 'setiembre': 9, 'set': 9, 'octubre': 10, 'oct': 10, 'noviembre': 11, 'nov': 11, 'diciembre': 12, 'dic': 12 };
                const pad2 = n => String(n).padStart(2, '0');

                function canonYMFromHeader(h) {
                    if (!h) return null;
                    const s = String(h).toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/\./g, ' ').replace(/\n/g, ' ').replace(/\s+/g, ' ').trim();
                    let m = s.match(/^(\d{4})[\/\- ](\d{1,2})$/); if (m) { const y = +m[1], mm = +m[2]; if (y >= 1900 && mm >= 1 && mm <= 12) return `${y}-${pad2(mm)}`; }
                    m = s.match(/^(\d{1,2})[\/\- ](\d{4})$/); if (m) { const mm = +m[1], y = +m[2]; if (y >= 1900 && mm >= 1 && mm <= 12) return `${y}-${pad2(mm)}`; }
                    m = s.match(/^([a-z\u00f1]+)[ ]+(\d{4})$/i); if (m) { const mm = ES_MONTHS[m[1]], y = +m[2]; if (mm) return `${y}-${pad2(mm)}`; }
                    m = s.match(/^(\d{4})[ ]+([a-z\u00f1]+)$/i); if (m) { const y = +m[1], mm = ES_MONTHS[m[2]]; if (mm) return `${y}-${pad2(mm)}`; }
                    return null;
                }
                function currentMonthRefsFromSelect($sel) {
                    return buildMonthRefs(parseInt($sel.val() || "12", 10)).map(r => {
                        const parts = String(r.label).split(' ');
                        const anio = parts.pop();
                        const mesSrc = parts.join(' ').replace('.', '');
                        return { key: r.key, nice: `${mesSrc.charAt(0).toUpperCase() + mesSrc.slice(1).toLowerCase()} ${anio}` };
                    });
                }

                // CORRECCIÓN: en Cliente la segunda columna es el cliente; antes el Excel leía los meses
                // corridos una columna (el primer mes salía en 0 y el resto desplazado).
                function armarDataDesdeTabla(tbodySelector, months, conCliente) {
                    const rows = [];
                    document.querySelectorAll(`${tbodySelector} tr`).forEach(tr => {
                        const c = { SKU: tr.getAttribute('data-sku') || tr.querySelector('td')?.innerText?.trim() || '' };
                        if (conCliente) c.Cliente = tr.getAttribute('data-cliente') || '';
                        const tds = [...tr.children];
                        let idx = conCliente ? 2 : 1;
                        months.forEach(m => { c[m.nice] = Number((tds[idx++]?.innerText || '0').replace(/[^\d.-]/g, '')) || 0; });
                        c.Objetivo = Number(tr.querySelector('input[name$=".Objetivo"]')?.value || 0);
                        c.Presupuesto = Number(tr.querySelector('input.pre')?.value || 0);
                        c.Comentario = tr.querySelector('input[name$=".Comentario"]')?.value || '';
                        rows.push(c);
                    });
                    return rows;
                }
                const columnas = (months, conCliente) => ["SKU", ...(conCliente ? ["Cliente"] : []), ...months.map(m => m.nice), "Objetivo", "Presupuesto", "Comentario"];

                function exportar({ tbodySelector, $selMesesObjetivo, sheetName, fileNameBase, conCliente }) {
                    const months = currentMonthRefsFromSelect($selMesesObjetivo);
                    const rows = armarDataDesdeTabla(tbodySelector, months, conCliente);
                    if (!rows.length) { showToast("No hay datos para exportar.", "warning"); return; }
                    const cols = columnas(months, conCliente);
                    const ws = XLSX.utils.json_to_sheet(rows.map(r => Object.fromEntries(cols.map(k => [k, r[k] ?? ((k === "Comentario" || k === "Cliente") ? "" : 0)]))), { header: cols });
                    ws['!cols'] = cols.map(c => ({ wch: Math.max(12, c.length + 2) }));
                    const wb = XLSX.utils.book_new();
                    XLSX.utils.book_append_sheet(wb, ws, sheetName);
                    const f = new Date();
                    XLSX.writeFile(wb, `${fileNameBase}_${f.getFullYear()}${pad2(f.getMonth() + 1)}${pad2(f.getDate())}.xlsx`);
                    showToast("Excel exportado.", "success");
                }

                function plantilla({ $selMesesObjetivo, sheetName, fileNameBase, conCliente }) {
                    const cols = columnas(currentMonthRefsFromSelect($selMesesObjetivo), conCliente);
                    const ws = XLSX.utils.aoa_to_sheet([cols]);
                    ws['!cols'] = cols.map(c => ({ wch: Math.max(12, c.length + 2) }));
                    const wb = XLSX.utils.book_new();
                    XLSX.utils.book_append_sheet(wb, ws, sheetName);
                    XLSX.writeFile(wb, `${fileNameBase}.xlsx`);
                    showToast("Plantilla descargada.", "success");
                }

                function importar({ file, tbodySelector, theadSelector, $selMesesObjetivo, comentarioIdPrefix, comentarioBtnClass, conCliente }) {
                    if (!file) { showToast("Selecciona un archivo Excel.", "warning"); return; }
                    const tbodyActual = document.querySelector(tbodySelector);
                    if (tbodyActual.children.length && !confirm("La importación reemplaza los renglones que tienes en pantalla. ¿Continuar?")) return;
                    toggleSpin(true, 'Leyendo Excel…');
                    const reader = new FileReader();
                    reader.onload = (e) => {
                        try {
                            const wb = XLSX.read(e.target.result, { type: 'binary' });
                            const data = XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[0]], { defval: '' });
                            if (!data.length) { showToast("El Excel está vacío.", "warning"); return; }
                            const mapYM = {};
                            Object.keys(data[0] || {}).forEach(h => { const ym = canonYMFromHeader(h); if (ym) mapYM[ym] = h; });
                            const months = currentMonthRefsFromSelect($selMesesObjetivo);
                            const refs = months.map(m => ({ key: m.key, label: m.nice }));
                            const traeCliente = conCliente && data.some(r => String(r['Cliente'] ?? r['cliente'] ?? '').trim());

                            document.querySelector(theadSelector).innerHTML = `<tr><th>SKU</th>${traeCliente ? '<th>Cliente</th>' : ''}${thMesesHtml(refs)}<th class="text-end">Objetivo</th><th class="text-end">Presupuesto</th><th class="text-end">Participación</th><th class="text-center">Comentario</th>${tbodySelector === '#tbodyCedis' ? '<th style="width:44px;"></th>' : ''}</tr>`;

                            let i = 0, html = '', omitidos = 0;
                            data.forEach(row => {
                                const sku = String(row['SKU'] || row['sku'] || row['ProductoCodigo'] || row['productoCodigo'] || '').trim().toUpperCase();
                                if (!sku) return;
                                const porMes = {};
                                months.forEach(m => { const col = mapYM[m.key]; porMes[m.key] = col ? Number(row[col] ?? 0) : 0; });
                                const objetivo = Math.round(Number(row['Objetivo'] ?? row['objetivo'] ?? 0));
                                const presupuesto = Math.round(Number(row['Presupuesto'] ?? row['presupuesto'] ?? objetivo));
                                const comentario = String(row['Comentario'] ?? row['comentario'] ?? '');
                                // Mismo criterio que antes: CEDIS y Vendedor importan todo; Cliente omite < 100 kg
                                if (tbodySelector === '#tbodyCliente' && !shouldIncludeRow(objetivo, presupuesto)) { omitidos++; return; }
                                const cli = traeCliente ? String(row['Cliente'] ?? row['cliente'] ?? '').trim().toUpperCase() : null;
                                const nom = cli ? CLIENTE.nombreCliente(cli) : '';
                                html += filaHtml({ i, sku, cliente: cli, clienteLabel: traeCliente ? (nom ? `${nom} (${cli})` : cli) : null, refs, porMes, objetivo, presupuesto, comentario, comPrefix: comentarioIdPrefix, comClass: comentarioBtnClass, conBorrar: tbodySelector === '#tbodyCedis' });
                                i++;
                            });
                            tbodyActual.innerHTML = html;
                            refrescarTabla(tbodySelector);
                            showToast(`Importación completada: ${i} renglón(es)${omitidos ? `, ${omitidos} omitidos por objetivo < 100 kg` : ''}.`, "success");
                        } catch (err) { console.error(err); showToast("No se pudo leer el Excel.", "danger"); }
                        finally { toggleSpin(false); }
                    };
                    reader.onerror = () => { toggleSpin(false); showToast("Error leyendo el archivo.", "danger"); };
                    reader.readAsBinaryString(file);
                }

                return { exportar, plantilla, importar };
            })();

            // =================== MODO PRESUPUESTO (global) ===================
            async function initModoPresupuesto() {
                const box = document.getElementById("modoPresupuestoBox");
                if (!box) return;
                const norm = m => (String(m || "").trim().toUpperCase() === "VENDEDOR") ? "VENDEDOR" : "CLIENTE";
                const setActive = (modo) => {
                    const m = norm(modo);
                    box.querySelectorAll("[data-modo]").forEach(b => { const on = b.getAttribute('data-modo') === m; b.classList.toggle("active", on); b.setAttribute('aria-pressed', String(on)); });
                    window.__MODO_PRESUPUESTO__ = m;
                    try { localStorage.setItem("modoPresupuesto", m); } catch { }
                };
                try {
                    const r = await fetch(API.modoGet, { credentials: "same-origin" });
                    const j = r.ok ? await r.json() : null;
                    if (!j?.puedeLeer) { box.style.display = "none"; return; }
                    box.style.display = "";
                    let fallback = null; try { fallback = localStorage.getItem("modoPresupuesto"); } catch { }
                    setActive(j?.modo || fallback || "CLIENTE");
                    box.querySelectorAll("[data-modo]").forEach(btn => btn.disabled = !j?.puedeEscribir);
                    if (!j?.puedeEscribir) return;
                } catch (e) { console.error("No se pudo cargar modo presupuesto:", e); box.style.display = "none"; return; }

                box.querySelectorAll("[data-modo]").forEach(btn => {
                    btn.addEventListener("click", async () => {
                        if (btn.disabled || btn.classList.contains('active')) return;
                        const modo = norm(btn.getAttribute("data-modo"));
                        // CORRECCIÓN: se pide confirmación; el modo aplica a todas las órdenes de venta de la empresa.
                        if (!confirm(`¿Cambiar el modo de presupuesto a ${modo}?\n\nAfecta la validación de presupuesto en las órdenes de venta de todos los usuarios.`)) return;
                        const fd = new FormData();
                        fd.append("modo", modo);
                        try {
                            toggleSpin(true, 'Cambiando modo…');
                            const { r, data } = await postFormData(API.modoSet, fd);
                            if (r.status === 403) { showToast("No tienes permiso para cambiar el modo.", "warning"); return; }
                            if (r.ok && data?.ok) { setActive(data.modo); showToast(`Modo de presupuesto: ${norm(data.modo)}.`, "success"); }
                            else showToast("No se pudo guardar el modo.", "danger");
                        } catch { showToast("Error al guardar el modo de presupuesto.", "danger"); }
                        finally { toggleSpin(false); }
                    });
                });
            }

            // =================== ADMINISTRAR ===================
            function fillAdminMeses() {
                const $m = $("#admMes").empty();
                ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"].forEach((n, i) => $m.append(`<option value="${i + 1}">${n}</option>`));
            }
            function rowAmbito(r) {
                const t = String(r.tipo || r.Tipo || "").toUpperCase();
                if (t === "CEDIS") return r.canal || r.Canal || "";
                if (t === "VENDEDOR") return `Vendedor ${r.vendedorId ?? r.VendedorId ?? ""}`;
                if (t === "CLIENTE") return r.cliente || r.Cliente || "";
                return "";
            }
            const admFiltros = () => ({
                tipo: $("#admTipo").val(), mes: +$("#admMes").val(), anio: +$("#admAnio").val(),
                sku: ($("#admSku").val() || "").trim(), canal: ($("#admCanal").val() || "").trim(),
                vendedorId: ($("#admVendedorId").val() || "").trim(), cliente: ($("#admCliente").val() || "").trim()
            });

            async function admBuscar() {
                const f = admFiltros();
                toggleSpin(true, 'Buscando presupuestos…');
                try {
                    const r = await fetch(`${API.adminList}?${new URLSearchParams(f).toString()}`, { credentials: "same-origin" });
                    const j = await r.json().catch(() => null);
                    if (!r.ok || !j?.ok) { showToast(j?.message || `No se pudo listar (${r.status})`, "danger"); return; }
                    const rows = j.rows || [];
                    $("#admMsg").text(`${rows.length} resultado(s).`);
                    $("#admChkAll").prop('checked', false);
                    $("#admTbody").html(rows.map(x => {
                        const rowId = x.rowId ?? x.RowId ?? 0;
                        return `<tr data-rowid="${escapeHtml(rowId)}">
                                    <td><input class="form-check-input admChk" type="checkbox" value="${escapeHtml(rowId)}" aria-label="Seleccionar"></td>
                                    <td>${escapeHtml(String(x.tipo ?? x.Tipo ?? ""))}</td>
                                    <td>${String(x.mes ?? x.Mes ?? 0).padStart(2, '0')}/${escapeHtml(x.anio ?? x.Anio ?? 0)}</td>
                                    <td>${escapeHtml(rowAmbito(x))}</td>
                                    <td style="font-weight:600">${escapeHtml(String(x.sku ?? x.Sku ?? ""))}</td>
                                    <td class="text-end">${fmt(x.objetivo ?? x.Objetivo ?? 0)}</td>
                                    <td class="text-end">${fmt(x.presupuesto ?? x.Presupuesto ?? 0)}</td>
                                    <td class="text-muted small">${escapeHtml(String(x.comentario ?? x.Comentario ?? ""))}</td>
                                </tr>`;
                    }).join("") || `<tr><td colspan="8" class="text-muted p-3">Sin resultados.</td></tr>`);
                } catch (err) { console.error("[ADMIN] error:", err); showToast("Error de red al buscar.", "danger"); }
                finally { toggleSpin(false); }
            }

            // CORRECCIÓN: las eliminaciones piden motivo obligatorio (antes era opcional) para que quede registro.
            function pedirMotivo() {
                const m = (prompt("Motivo de la eliminación (obligatorio):") || "").trim();
                if (!m) { showToast("Escribe un motivo para eliminar.", "warning"); return null; }
                return m;
            }

            async function admDeleteSelected() {
                const tipo = $("#admTipo").val();
                const ids = [...document.querySelectorAll("#admTbody .admChk:checked")].map(x => +x.value).filter(Boolean);
                if (!ids.length) { showToast("Selecciona al menos 1 renglón.", "warning"); return; }
                if (!confirm(`¿Eliminar ${ids.length} renglón(es) de presupuesto ${tipo}?`)) return;
                const reason = pedirMotivo(); if (!reason) return;
                toggleSpin(true, 'Eliminando…');
                try {
                    const fd = new FormData();
                    fd.append("Tipo", tipo); ids.forEach(i => fd.append("RowIds", i)); fd.append("Reason", reason);
                    const { r, data } = await postFormData(API.adminDelIds, fd);
                    if (r.ok && data?.ok) { showToast(`Eliminados: ${data.deleted}`, "success"); await admBuscar(); }
                    else showToast(data?.message || "No se pudo eliminar.", "danger");
                } catch { showToast("Error de red al eliminar.", "danger"); }
                finally { toggleSpin(false); }
            }

            async function admDeleteByFilter() {
                const f = admFiltros();
                const periodo = `${String(f.mes).padStart(2, '0')}/${f.anio}`;
                const todo = !f.sku && !f.canal && !f.vendedorId && !f.cliente;
                if (todo) {
                    const escrito = prompt(`Vas a borrar TODO el presupuesto ${f.tipo} del periodo ${periodo}.\n\nPara confirmar escribe: BORRAR`);
                    if ((escrito || '').trim().toUpperCase() !== 'BORRAR') { showToast("Eliminación cancelada.", "light"); return; }
                } else if (!confirm(`¿Borrar el presupuesto ${f.tipo} de ${periodo} que coincide con los filtros?`)) return;
                const reason = pedirMotivo(); if (!reason) return;
                toggleSpin(true, 'Eliminando…');
                try {
                    const fd = new FormData();
                    fd.append("Tipo", f.tipo); fd.append("Mes", f.mes); fd.append("Anio", f.anio);
                    fd.append("Sku", f.sku); fd.append("Canal", f.canal); fd.append("VendedorId", f.vendedorId); fd.append("Cliente", f.cliente);
                    fd.append("DeleteAllInScope", "true"); fd.append("Reason", reason);
                    const { r, data } = await postFormData(API.adminDelFilter, fd);
                    if (r.ok && data?.ok) { showToast(`Eliminados: ${data.deleted}`, "success"); await admBuscar(); }
                    else showToast(data?.message || "No se pudo eliminar.", "danger");
                } catch { showToast("Error de red al eliminar.", "danger"); }
                finally { toggleSpin(false); }
            }

            function bindAdminPresupuestos() {
                $("#btnAdminPres").on("click", () => {
                    if (!$("#admMes option").length) fillAdminMeses();
                    const now = new Date();
                    if (!$("#admAnio").val()) { $("#admMes").val(now.getMonth() + 1); $("#admAnio").val(now.getFullYear()); }
                    $("#admTbody").html(`<tr><td colspan="8" class="text-muted p-3">Elige los filtros y presiona Buscar.</td></tr>`);
                    $("#admMsg").text("");
                    bootstrap.Modal.getOrCreateInstance(document.getElementById("modalAdminPres")).show();
                });
                $("#admBuscar").on("click", e => { e.preventDefault(); admBuscar(); });
                $("#admDeleteSelected").on("click", e => { e.preventDefault(); admDeleteSelected(); });
                $("#admDeleteByFilter").on("click", e => { e.preventDefault(); admDeleteByFilter(); });
                $("#admChkAll").on("change", function() { document.querySelectorAll("#admTbody .admChk").forEach(x => x.checked = this.checked); });
            }

            // =================== Excel: botones ===================
            function bindExcel() {
                const limpiar = s => String(s || '').replace(/[^\w\- ]/g, '');
                const conf = [
                    { exp: '#btnExportarXlsx', pla: '#btnPlantillaXlsx', imp: '#btnImportarXlsx', file: '#fileExcelCedis', tbody: '#tbodyCedis', thead: '#tablaCedis thead', sel: '#filtroMesesObjetivo', hoja: 'CEDIS', base: () => `Presupuesto_CEDIS_${limpiar($('#selCanal').val() || 'CEDIS')}`, basePla: () => `Plantilla_Presupuesto_CEDIS_${limpiar($('#selCanal').val() || 'CEDIS')}`, pre: 'comentario-', cls: 'btnComentarioCedis' },
                    { exp: '#btnExportarXlsxVen', pla: '#btnPlantillaXlsxVen', imp: '#btnImportarXlsxVen', file: '#fileExcelVendedor', tbody: '#tbodyVendedor', thead: '#tablaVendedor thead', sel: '#venMesesObjetivo', hoja: 'VENDEDOR', base: () => `Presupuesto_Vendedor_${$('#selVendedor').val() || 'Vendedor'}`, basePla: () => `Plantilla_Presupuesto_Vendedor_${$('#selVendedor').val() || 'Vendedor'}`, pre: 'ven-comentario-', cls: 'btnComentarioVendedor' },
                    { exp: '#btnExportarXlsxCli', pla: '#btnPlantillaXlsxCli', imp: '#btnImportarXlsxCli', file: '#fileExcelCliente', tbody: '#tbodyCliente', thead: '#tablaCliente thead', sel: '#cliMesesObjetivo', hoja: 'CLIENTE', base: () => `Presupuesto_Cliente_${CLIENTE.getClienteLabelParaExcel()}`, basePla: () => `Plantilla_Presupuesto_Cliente_${CLIENTE.getClienteLabelParaExcel()}`, pre: 'cli-comentario-', cls: 'btnComentarioCliente', cli: true }
                ];
                conf.forEach(c => {
                    $(c.exp).on("click", () => EXCEL.exportar({ tbodySelector: c.tbody, $selMesesObjetivo: $(c.sel), sheetName: c.hoja, fileNameBase: c.base(), conCliente: !!c.cli }));
                    $(c.pla).on("click", () => EXCEL.plantilla({ $selMesesObjetivo: $(c.sel), sheetName: 'Plantilla', fileNameBase: c.basePla(), conCliente: !!c.cli }));
                    $(c.imp).on("click", () => document.querySelector(c.file)?.click());
                    $(c.file).on("change", function() {
                        const f = this.files?.[0];
                        if (f) EXCEL.importar({ file: f, tbodySelector: c.tbody, theadSelector: c.thead, $selMesesObjetivo: $(c.sel), comentarioIdPrefix: c.pre, comentarioBtnClass: c.cls, conCliente: !!c.cli });
                        this.value = '';
                    });
                });
            }

            // =================== Inicio ===================
            (async function init() {
                try {
                    if (typeof XLSX === 'undefined') console.warn('La biblioteca de Excel no se cargó.');
                    VENDEDOR.init();
                    CLIENTE.init();
                    bindExcel();
                    bindAdminPresupuestos();
                    initModoPresupuesto();
                    await CEDIS.init();
                } catch (e) {
                    console.error(e);
                    showToast("Error al iniciar la pantalla. Recarga la página.", "danger");
                }
            })();
        })();
    </script>
}
