        .presupuesto-app .pp-workflow {
            grid-template-columns: 1fr !important;
        }

        .presupuesto-app .module-titlebar {
            padding: 5px !important;
        }

        .presupuesto-app .module-titlebar > .d-flex,
        .presupuesto-app .toolbar {
            display: grid !important;
            grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
            width: 100% !important;
        }

        .presupuesto-app .modo-pill {
            grid-column: 1 / -1 !important;
            width: 100% !important;
        }

        .presupuesto-app .module-titlebar .tbtn,
        .presupuesto-app .toolbar .tbtn {
            width: 100% !important;
        }

        .presupuesto-app .toolbar .ms-auto {
