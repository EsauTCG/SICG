        async function initModoPresupuesto() {
        const box = document.getElementById("modoPresupuestoBox");
        if (!box) return;

        const token =
        document.querySelector('#frmPresupuestoCedis input[name="__RequestVerificationToken"]')?.value ||
        document.querySelector('#frmPresupuestoCliente input[name="__RequestVerificationToken"]')?.value ||
        document.querySelector('input[name="__RequestVerificationToken"]')?.value || "";

        const norm = (modo) => {
        const m = String(modo || "").trim().toUpperCase();
        return (m === "VENDEDOR") ? "VENDEDOR" : "CLIENTE";
        };

        const setActive = (modo) => {
        const m = norm(modo);

        box.querySelectorAll("[data-modo]").forEach(b => b.classList.remove("active"));
        const active = box.querySelector(`[data-modo="${m}"]`);
        if (active) active.classList.add("active");

        window.__MODO_PRESUPUESTO__ = m;
        try { localStorage.setItem("modoPresupuesto", m); } catch {}
        };

        try {
        const r = await fetch(API.modoGet, { credentials: "same-origin" });
        const j = r.ok ? await r.json() : null;

        // sin permiso de lectura: ocultar
        if (!j?.puedeLeer) {
        box.style.display = "none";
        return;
        }

        // con permiso de lectura: mostrar
        box.style.display = "";

        const fallback = (() => {
        try { return localStorage.getItem("modoPresupuesto"); } catch { return null; }
        })();

        setActive(j?.modo || fallback || "CLIENTE");

        // sin permiso de escritura: deshabilitar
        if (!j?.puedeEscribir) {
        box.querySelectorAll("[data-modo]").forEach(btn => {
        btn.disabled = true;
        });
        return;
        }

        // con permiso de escritura: habilitar
        box.querySelectorAll("[data-modo]").forEach(btn => {
        btn.disabled = false;
        });

        } catch (e) {
        console.error("No se pudo cargar modo presupuesto:", e);
        box.style.display = "none";
        return;
        }

        box.querySelectorAll("[data-modo]").forEach(btn => {
        btn.addEventListener("click", async () => {
        if (btn.disabled) return;

        const modo = norm(btn.getAttribute("data-modo"));
        const fd = new FormData();
        fd.append("modo", modo);

        try {
        toggleSpin(true);

        const r = await fetch(API.modoSet, {
        method: "POST",
        credentials: "same-origin",
        headers: {
        "RequestVerificationToken": token,
        "X-Requested-With": "XMLHttpRequest"
        },
        body: fd
        });

        if (r.status === 403) {
        showToast("No tienes permiso para cambiar el modo.", "warning");
        return;
        }

        const j = r.ok ? await r.json() : null;
        if (r.ok && j?.ok) {
        setActive(j.modo);
        } else {
        showToast("No se pudo guardar el modo.", "danger");
        }
        } catch {
        showToast("Error al guardar modo presupuesto.", "danger");
        } finally {
        toggleSpin(false);
        }
        });
        });
        }


       function getTokenAny() {
          return document.querySelector('input[name="__RequestVerificationToken"]')?.value || "";
        }

        function fillAdminMeses() {
          const $m = $("#admMes").empty();
          const names = [
            "Enero","Febrero","Marzo","Abril","Mayo","Junio",
            "Julio","Agosto","Septiembre","Octubre","Noviembre","Diciembre"
          ];
          for (let i=1;i<=12;i++) $m.append(`<option value="${i}">${names[i-1]}</option>`);
        }

        function rowAmbito(r){
          const t = String(r.tipo || r.Tipo || "").toUpperCase();
          if (t === "CEDIS") return r.canal || r.Canal || "";
          if (t === "VENDEDOR") return `Vendedor ${r.vendedorId ?? r.VendedorId ?? ""}`;
          if (t === "CLIENTE") return r.cliente || r.Cliente || "";
          return "";
        }

              async function admBuscar() {
          const tipo = $("#admTipo").val();
          const mes = +$("#admMes").val();
          const anio = +$("#admAnio").val();

          const sku = ($("#admSku").val() || "").trim();
          const canal = ($("#admCanal").val() || "").trim();
          const vendedorId = ($("#admVendedorId").val() || "").trim();
          const cliente = ($("#admCliente").val() || "").trim();

          if (!API.adminList) {
            console.error("[ADMIN] API.adminList viene vacío. Revisa Url.Action('AdminListPresupuestos','Comercial')");
            showToast("API.adminList vacío. Revisa Url.Action.", "danger");
            return;
          }

          const qs = new URLSearchParams({ tipo, mes, anio, sku, canal, vendedorId, cliente });
          const url = `${API.adminList}?${qs.toString()}`;

          console.log("[ADMIN] fetch:", url);

          toggleSpin(true);
          try {
            const r = await fetch(url, { credentials: "same-origin" });

            console.log("[ADMIN] status:", r.status);

            const j = await r.json().catch(() => null);
            console.log("[ADMIN] json:", j);

            if (!r.ok || !j?.ok) {
              showToast(j?.message || `No se pudo listar (${r.status})`, "danger");
              return;
            }

            const rows = j.rows || [];
            $("#admMsg").text(`Resultados: ${rows.length}`);

            const html = rows.map(x => {
              const tipo2 = x.tipo ?? x.Tipo ?? "";
              const mes2 = x.mes ?? x.Mes ?? 0;
              const anio2 = x.anio ?? x.Anio ?? 0;
              const sku2 = x.sku ?? x.Sku ?? "";
              const obj2 = x.objetivo ?? x.Objetivo ?? 0;
              const pre2 = x.presupuesto ?? x.Presupuesto ?? 0;
              const com2 = x.comentario ?? x.Comentario ?? "";
              const rowId = x.rowId ?? x.RowId ?? 0;

              return `
                <tr data-rowid="${rowId}">
                  <td><input class="form-check-input admChk" type="checkbox" value="${rowId}"></td>
                  <td>${escapeHtml(String(tipo2))}</td>
                  <td>${String(mes2).padStart(2,'0')}/${anio2}</td>
                  <td>${escapeHtml(rowAmbito(x))}</td>
                  <td class="fw-semibold">${escapeHtml(String(sku2))}</td>
                  <td class="text-end">${fmt(obj2)}</td>
                  <td class="text-end">${fmt(pre2)}</td>
                  <td class="text-muted small">${escapeHtml(String(com2 || ""))}</td>
                </tr>`;
            }).join("");

            $("#admTbody").html(html || `<tr><td colspan="8" class="text-muted p-3">Sin resultados.</td></tr>`);

          } catch (err) {
            console.error("[ADMIN] error:", err);
            showToast("Error de red/JS en buscar. Revisa consola.", "danger");
          } finally {
            toggleSpin(false);
          }
        }


        async function admDeleteSelected() {
          const tipo = $("#admTipo").val();
          const ids = [...document.querySelectorAll("#admTbody .admChk:checked")]
            .map(x => +x.value).filter(Boolean);

          if (!ids.length) { showToast("Selecciona al menos 1 fila.", "warning"); return; }
          if (!confirm(`Eliminar ${ids.length} filas seleccionadas?`)) return;

          const reason = prompt("Motivo (opcional):") || "";

          toggleSpin(true);
          try {
            const fd = new FormData();
            fd.append("Tipo", tipo);
            ids.forEach(i => fd.append("RowIds", i));
            fd.append("Reason", reason);

            const r = await fetch(API.adminDelIds, {
              method:"POST",
              credentials:"same-origin",
              headers:{ "RequestVerificationToken": getTokenAny(), "X-Requested-With":"XMLHttpRequest" },
              body: fd
            });

            const j = await r.json().catch(()=>null);
            if (r.ok && j?.ok) {
              showToast(`Eliminadas: ${j.deleted}`, "success");
              await admBuscar();
            } else {
              showToast(j?.message || "No se pudo eliminar.", "danger");
            }
          } finally { toggleSpin(false); }
        }

        async function admDeleteByFilter() {
          const tipo = $("#admTipo").val();
          const mes = +$("#admMes").val();
          const anio = +$("#admAnio").val();

          const sku = ($("#admSku").val() || "").trim();
          const canal = ($("#admCanal").val() || "").trim();
          const vendedorId = ($("#admVendedorId").val() || "").trim();
          const cliente = ($("#admCliente").val() || "").trim();

          const dangerous = !sku && !canal && !vendedorId && !cliente;
          const msg = dangerous
            ? `Vas a borrar TODO ${tipo} del periodo ${String(mes).padStart(2,'0')}/${anio}. ¿Seguro?`
            : `Vas a borrar por filtros. ¿Continuar?`;

          if (!confirm(msg)) return;

          const reason = prompt("Motivo (opcional):") || "";

          toggleSpin(true);
          try {
            const fd = new FormData();
            fd.append("Tipo", tipo);
            fd.append("Mes", mes);
            fd.append("Anio", anio);
            fd.append("Sku", sku);
            fd.append("Canal", canal);
            fd.append("VendedorId", vendedorId);
            fd.append("Cliente", cliente);
            fd.append("DeleteAllInScope", "true");
            fd.append("Reason", reason);

            const r = await fetch(API.adminDelFilter, {
              method:"POST",
              credentials:"same-origin",
              headers:{ "RequestVerificationToken": getTokenAny(), "X-Requested-With":"XMLHttpRequest" },
              body: fd
            });

            const j = await r.json().catch(()=>null);
            if (r.ok && j?.ok) {
              showToast(`Eliminadas: ${j.deleted}`, "success");
              await admBuscar();
            } else {
              showToast(j?.message || "No se pudo eliminar.", "danger");
            }
          } finally { toggleSpin(false); }
        }

              function bindAdminPresupuestos() {

          // Abre modal
          $("#btnAdminPres")
            .off("click")
            .on("click", () => {
              console.log("[ADMIN] click btnAdminPres");
              fillAdminMeses();

              const now = new Date();
              $("#admMes").val(now.getMonth() + 1);
              $("#admAnio").val(now.getFullYear());

              $("#admTbody").html(`<tr><td colspan="8" class="text-muted p-3">Busca para ver resultados.</td></tr>`);
              $("#admMsg").text("");

              bootstrap.Modal.getOrCreateInstance(document.getElementById("modalAdminPres")).show();
            });

          // Buscar
          $("#admBuscar")
            .off("click")
            .on("click", (e) => {
              e.preventDefault();
              console.log("[ADMIN] click Buscar");
              admBuscar();
            });

          // Eliminar seleccionados
          $("#admDeleteSelected")
            .off("click")
            .on("click", (e) => {
              e.preventDefault();
              admDeleteSelected();
            });

          // Eliminar por filtros
          $("#admDeleteByFilter")
            .off("click")
            .on("click", (e) => {
              e.preventDefault();
              admDeleteByFilter();
            });

          // Check all
          $("#admChkAll")
            .off("change")
            .on("change", function () {
              document.querySelectorAll("#admTbody .admChk").forEach(x => x.checked = this.checked);
            });

          console.log("[ADMIN] bindAdminPresupuestos listo");
        }





