            function guardarComentario() {
              const c = $("#comentarioTextoCedis").val();
              if (comentarioTargetId) $(`#${comentarioTargetId}`).val(c);
              bootstrap.Modal.getInstance(document.getElementById('comentarioModalCedis'))?.hide();
              showToast("Comentario CEDIS guardado.", "success");
            }

            async function guardarDesdeModal() {
              if (!validarNoCero()) { showToast("Hay presupuestos en 0.", "danger"); return; }

              const mes = parseInt($("#modalMes").val(), 10);
              const anio = parseInt($("#modalAnio").val(), 10);
              if (!isPeriodoValido(mes, anio)) {
        showToast("Selecciona un mes y año válidos.", "warning");
                return;
              }

              const canal = $("#selCanal").val() || '';
              if (!canal) { showToast("Selecciona un CEDIS.", "warning"); return; }

              $("#CanalInput").val(canal);
              $("#MesInput").val(mes);
              $("#AnioInput").val(anio);

              try {
                toggleSpin(true);
                const fd = new FormData(document.getElementById('frmPresupuestoCedis'));
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

                const r = await fetch(API.guardar, {
                  method: 'POST',
                  credentials: 'same-origin',
                  headers: { 'RequestVerificationToken': token, 'X-Requested-With': 'XMLHttpRequest' },
                  body: fd
                });

                const ct = r.headers.get('content-type') || '';
                const data = ct.includes('json') ? await r.json().catch(() => null) : null;

                if (r.ok && (!data || data.ok || data.success)) {
                  banner("Presupuesto guardado correctamente.", "success");
                  showToast("Guardado", "success");
                  bootstrap.Modal.getInstance(document.getElementById('modalGuardarCedis'))?.hide();
                } else {
                  showToast("No se pudo guardar.", "danger");
                  banner((data?.message || 'Error al guardar'), "warning");
                }
              } catch {
                showToast("Error de red al guardar.", "danger");
              } finally {
                toggleSpin(false);
              }
            }

            function setPeriodoDefaultModal() {
              const f = new Date(), m = f.getMonth() + 1, y = f.getFullYear();
              const ms = m === 12 ? 1 : m + 1, ys = m === 12 ? y + 1 : y;
              $("#modalMes").val(ms);
              $("#modalAnio").val(ys).attr("min", y);
            }

            function bind() {
              $("#btnAgregar").on('click', async function () {
                const res = await traerVentas();
                if (!res) return;
                renderTabla(res);
