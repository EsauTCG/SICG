@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jspdf-autotable@3.8.2/dist/jspdf.plugin.autotable.min.js"></script>

    <script>
        /* =====================================================================
           PEDIDOS LIBERADOS — misma lógica y endpoints que la versión anterior.
           Funciones duplicadas se dejaron una sola vez.
           Los cambios de comportamiento están marcados con "CORRECCIÓN".
        ===================================================================== */

        // Siempre limpiar borradores en cada carga (igual que antes)
        localStorage.removeItem('ovDraftsByConsecutivo');

        /* ===== Utilidades ===== */
        const DIAS_AVISO = 2;
        function startOfDay(d) { const x = new Date(d); x.setHours(0, 0, 0, 0); return x; }
        function daysDiff(a, b) { return Math.floor((startOfDay(a) - startOfDay(b)) / 86400000); }
        function formatDateOnly(val) {
            if (!val) return '';
            const s = String(val);
            const m = s.match(/^(\d{4}-\d{2}-\d{2})/);
            if (m) { const [y, mo, d] = m[1].split('-'); return `${d}/${mo}/${y}`; }
            const d = new Date(s);
            return isNaN(d) ? s : d.toLocaleDateString('es-MX');
        }
        function formatDateTime(val) { if (!val) return ''; const d = new Date(val); return isNaN(d) ? String(val) : d.toLocaleString('es-MX'); }
        const mxn = n => (Number(n || 0)).toLocaleString('es-MX', { style: 'currency', currency: 'MXN' });
        const num = n => (Number(n || 0)).toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        const intn = n => (Math.floor(Number(n || 0))).toLocaleString('es-MX', { maximumFractionDigits: 0 });
        const toISODate = d => {
            if (!d) return '';
            const m = String(d).match(/^(\d{4}-\d{2}-\d{2})/);
            if (m) return m[1];
            const x = new Date(d);
            return `${x.getFullYear()}-${String(x.getMonth() + 1).padStart(2, '0')}-${String(x.getDate()).padStart(2, '0')}`;
        };
        function addDays(date, days) { const d = new Date(date); d.setDate(d.getDate() + days); return d; }

        // CORRECCIÓN: los textos del servidor se escapan antes de pintarse
        // (un nombre u observación con comillas o "<" ya no rompe filas ni botones).
        function esc(v) {
            return String(v ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
        }
        const _escapeHtmlDiagnostico = esc;

        function _tokenAF() {
            return document.querySelector('#antiForgeryForm input[name="__RequestVerificationToken"]')?.value || null;
        }
        function _modal(id, opts) {
            // CORRECCIÓN: se reutiliza la misma instancia del modal; antes se creaba una nueva
            // en cada apertura y podían quedar fondos oscuros encimados.
            return bootstrap.Modal.getOrCreateInstance(document.getElementById(id), opts || {});
        }

        function setRangoEntregaDefault() {
            const $d = $('#fEntregaD'), $h = $('#fEntregaH');
            if (!$d.length || !$h.length) return;
            const hoy = new Date();
            $d.val(toISODate(addDays(hoy, -2))); // hoy - 2
            $h.val(toISODate(hoy));               // hoy
            actualizarHintRango();
        }

        // Aviso visible del rango de fechas que filtra la lista (antes no se veía a simple vista).
        function actualizarHintRango() {
            const d = $('#fEntregaD').val(), h = $('#fEntregaH').val();
            let t;
            if (d && h) t = `Mostrando entregas del ${formatDateOnly(d)} al ${formatDateOnly(h)}. Los pedidos con entrega fuera de este rango no aparecen; cambia las fechas para verlos.`;
            else if (d) t = `Mostrando entregas desde el ${formatDateOnly(d)}.`;
            else if (h) t = `Mostrando entregas hasta el ${formatDateOnly(h)}.`;
            else t = 'Sin filtro de fechas: se muestran todas las entregas.';
            $('#plRangoHintTxt').text(t);
        }

        /* ===== Cliente ===== */
        function getClienteNombre(obj) {
            return (obj?.clienteNombre ?? obj?.ClienteNombre ?? obj?.nombreCliente ?? obj?.NombreCliente ??
                obj?.razonSocial ?? obj?.RazonSocial ?? obj?.clienteNombreFiscal ?? obj?.ClienteNombreFiscal ?? '').toString().trim();
        }
        function getClienteId(obj) { return (obj?.clienteId ?? obj?.ClienteId ?? obj?.cliente ?? obj?.Cliente ?? '').toString().trim(); }
        function getClienteTextoBusqueda(obj) { return `${getClienteNombre(obj)} ${getClienteId(obj)}`.toLowerCase(); }

        /* ===== Almacenes (opciones del select global #ovAlmacen) ===== */
        function _opcionesAlmacen() { const sel = document.getElementById('ovAlmacen'); return sel ? [...sel.options] : []; }

        function normalizarAlmacenValue(inputVal) {
            const raw = (inputVal ?? '').toString().trim();
            if (!raw) return '';
            const up = raw.toUpperCase();
            const opts = _opcionesAlmacen();
            const byVal = opts.find(o => (o.value || '').toString().trim().toUpperCase() === up);
            if (byVal) return byVal.value;
            const byTxt = opts.find(o => (o.textContent || '').toString().trim().toUpperCase() === up);
            if (byTxt) return byTxt.value;
            return '';
        }

        function _opcionesAlmacenHtml(value) {
            const v = (value || '').toString().trim().toUpperCase();
            return _opcionesAlmacen().map(o => {
                const val = (o.value || '').toString();
                return `<option value="${esc(val)}" ${val.trim().toUpperCase() === v ? 'selected' : ''}>${esc(o.textContent)}</option>`;
            }).join('');
        }
        function buildAlmacenSelectHtml(value, disabled) {
            return `<select class="form-select form-select-sm sel-almacen" aria-label="Almacén" ${disabled ? 'disabled' : ''}>${_opcionesAlmacenHtml(value)}</select>`;
        }
        function buildPreviewAlmacenSelectHtml(value) {
            return `<select class="form-select form-select-sm pv-almacen" aria-label="Almacén">${_opcionesAlmacenHtml(value)}</select>`;
        }

        /* ===== Estado ===== */
        let pedidosCache = [];
        let ovState = { id: null, productos: [] };
        let ovSoloLectura = false;
        let flujoRapidoActivo = false;   // pendiente -> guardar -> subpedidos
        let guardandoOV = false;
        const pvState = { id: null, ov: null };

        // CORRECCIÓN: la vista guardada solo puede ser pendientes o completados.
        // Antes, si la última vista era "Informe", al recargar se mostraban pendientes
        // y completados mezclados bajo la pestaña Pendientes.
        let vistaActual = localStorage.getItem('vistaOV');
        if (vistaActual !== 'pendientes' && vistaActual !== 'completados') vistaActual = 'pendientes';

        function setActualizadoAhora() {
            const lbl = document.getElementById('lblActualizado');
            if (lbl) lbl.textContent = 'Actualizado: ' + new Date().toLocaleTimeString('es-MX');
        }
        function isCompletado(p) { return Number(p?.estatus ?? p?.Estatus ?? 0) === 4; }

        function contarCriticos(list) {
            const hoy = new Date();
            let urgentes = 0;
            for (const p of list) {
                if (isCompletado(p)) continue;
                const fe = p.fechaEntrega ?? p.FechaEntrega;
                if (!fe) continue;
                if (daysDiff(new Date(fe), hoy) <= DIAS_AVISO) urgentes++;
            }
            return urgentes;
        }
        function setConteoFromRows(rows) {
            const urg = contarCriticos(rows);
            const n = rows.length;
            document.getElementById('chipConteo').innerHTML =
                `<i class="bi bi-list-ol"></i> ${n} pedido${n === 1 ? '' : 's'}`;
            const chipU = document.getElementById('chipUrgentes');
            chipU.innerHTML = `<i class="bi bi-exclamation-triangle"></i> ${urg} urgente${urg === 1 ? '' : 's'}`;
            chipU.style.display = urg > 0 ? '' : 'none';
        }
        function setConteo(n) { setConteoFromRows(pedidosCache.slice(0, n)); }

        function debounce(fn, ms = 250) { let t; return (...a) => { clearTimeout(t); t = setTimeout(() => fn(...a), ms); }; }

        function bloquearOVLectura() {
            const badge = document.getElementById('ovDoneBadge'); if (badge) badge.style.display = '';
            const fe = document.getElementById('ovFechaEmbarque'); const alm = document.getElementById('ovAlmacen');
            if (fe) fe.disabled = true; if (alm) alm.disabled = true;
            const btnGuardar = document.getElementById('btnGuardarProductos');
            const rowAgregar = document.getElementById('rowAgregar');
            if (btnGuardar) { btnGuardar.setAttribute('disabled', 'disabled'); btnGuardar.style.display = 'none'; }
            if (rowAgregar) rowAgregar.style.display = 'none';
            document.querySelectorAll('#ovQuickBar button, #ovQuickBar select, #ovQuickBar input').forEach(x => x.disabled = true);
            const tbody = document.querySelector('#ovProductos tbody');
            if (tbody) [...tbody.querySelectorAll('button.btn-outline-danger')].forEach(b => { b.disabled = true; b.style.display = 'none'; });
        }
        function desbloquearOVLectura() {
            const badge = document.getElementById('ovDoneBadge'); if (badge) badge.style.display = 'none';
            const fe = document.getElementById('ovFechaEmbarque'); const alm = document.getElementById('ovAlmacen');
            if (fe) fe.disabled = false; if (alm) alm.disabled = false;
            const btnGuardar = document.getElementById('btnGuardarProductos');
            const rowAgregar = document.getElementById('rowAgregar');
            if (btnGuardar) { btnGuardar.removeAttribute('disabled'); btnGuardar.style.display = ''; }
            if (rowAgregar) rowAgregar.style.display = 'none';
            document.querySelectorAll('#ovQuickBar button, #ovQuickBar select, #ovQuickBar input').forEach(x => x.disabled = false);
            const tbody = document.querySelector('#ovProductos tbody');
            if (tbody) [...tbody.querySelectorAll('button')].forEach(b => { b.disabled = false; b.style.display = ''; });
        }

        /* ===== Borradores por consecutivo (solo durante la sesión de la página) ===== */
        const LS_DRAFTS_KEY = 'ovDraftsByConsecutivo';
        function _loadDraftMap() { try { return new Map(Object.entries(JSON.parse(localStorage.getItem(LS_DRAFTS_KEY) || '{}'))); } catch { return new Map(); } }
        function _saveDraftMap(map) { try { localStorage.setItem(LS_DRAFTS_KEY, JSON.stringify(Object.fromEntries(map))); } catch { } }
        let _drafts = _loadDraftMap();
        function getConsecutivoActual() { return (document.getElementById('ovConsecutivo')?.value || '').toString().trim(); }
        function draftGuardar(cons, productos) { if (!cons) return; _drafts.set(cons, productos); _saveDraftMap(_drafts); }
        function draftObtener(cons) { if (!cons) return null; const v = _drafts.get(cons); return Array.isArray(v) ? JSON.parse(JSON.stringify(v)) : null; }
        function draftBorrar(cons) { if (!cons) return; _drafts.delete(cons); _saveDraftMap(_drafts); }

        /* ===== Filtros ===== */
        function getFiltros() {
            return {
                q: (document.getElementById('txtBuscar').value || '').trim().toLowerCase(),
                consecutivo: (document.getElementById('fConsecutivo').value || '').trim().toLowerCase(),
                cliente: (document.getElementById('fCliente').value || '').trim().toLowerCase(),
                vendedor: (document.getElementById('fVendedor').value || '').trim().toLowerCase(),
                entregaD: (document.getElementById('fEntregaD').value || '').trim(),
                entregaH: (document.getElementById('fEntregaH').value || '').trim()
            };
        }
        function pasaFiltros(p, f) {
            const cons = String(p.ordenDeVenta ?? p.OrdenDeVenta ?? '').toLowerCase();
            const clienteTexto = getClienteTextoBusqueda(p);
            const vendedor = String(p.vendedor ?? p.Vendedor ?? '').toLowerCase();
            const obs = String(p.observacion ?? p.Observacion ?? '').toLowerCase();
            if (f.q && !(cons.includes(f.q) || clienteTexto.includes(f.q) || vendedor.includes(f.q) || obs.includes(f.q))) return false;
            if (f.consecutivo && !cons.includes(f.consecutivo)) return false;
            if (f.cliente && !clienteTexto.includes(f.cliente)) return false;
            if (f.vendedor && !vendedor.includes(f.vendedor)) return false;
            const fe = p.fechaEntrega ?? p.FechaEntrega;
            if (f.entregaD) { const dmin = new Date(f.entregaD + 'T00:00:00'); if (!fe || startOfDay(new Date(fe)) < dmin) return false; }
            if (f.entregaH) { const dmax = new Date(f.entregaH + 'T00:00:00'); if (!fe || startOfDay(new Date(fe)) > dmax) return false; }
            return true;
        }

        /* ===== Lista de pedidos ===== */
        function renderPedidos() {
            const tbody = $('#pedidosBody');
            const f = getFiltros();
            const rows = pedidosCache.filter(p => {
                const esCompleto = isCompletado(p);
                if (vistaActual === 'pendientes' && esCompleto) return false;
                if (vistaActual === 'completados' && !esCompleto) return false;
                return pasaFiltros(p, f);
            });

            setConteoFromRows(rows);
            $('#lblPanelPedidos').text(vistaActual === 'completados' ? 'Pedidos completados' : 'Pedidos pendientes');

            if (rows.length === 0) {
                tbody.html(`<tr><td colspan="8" class="empty">${vistaActual === 'pendientes'
                    ? 'No hay pedidos pendientes con estos filtros. Revisa el rango de fechas de entrega.'
                    : 'No hay pedidos completados con estos filtros.'}</td></tr>`);
                return;
            }

            tbody.html(rows.map(p => {
                const id = (p.id ?? p.Id ?? p.IdOrden ?? p.idOrden ?? p.OVId ?? p.ovId);
                const tieneId = !(id === null || id === undefined || id === '');
                const cons = p.ordenDeVenta ?? p.OrdenDeVenta ?? '';
                const serie = p.serie ?? '';
                const clienteNombre = getClienteNombre(p) || '—';
                const clienteId = getClienteId(p);
                const vendedor = p.vendedor ?? p.Vendedor ?? '';
                const fechaEntrega = p.fechaEntrega ?? p.FechaEntrega;
                const present = (p.presentacion ?? p.Presentacion ?? '').toString();
                const obs = p.observacion ?? p.Observacion ?? '';

                let rowClass = '';
                if (fechaEntrega) {
                    const diff = daysDiff(new Date(fechaEntrega), new Date());
                    if (diff < 0) rowClass = 'table-danger';
                    else if (diff <= DIAS_AVISO) rowClass = 'table-warning';
                }

                let botones = '';
                if (isCompletado(p)) {
                    botones += `<button type="button" class="btn btn-sm btn-open btn-preview-ov" data-id="${esc(id ?? '')}" data-cons="${esc(cons)}"><i class="bi bi-eye"></i> Vista previa</button>`;
                    botones += tieneId
                        ? `<button type="button" class="btn btn-sm btn-open btn-subpedidos" data-id="${esc(id)}"><i class="bi bi-diagram-3"></i> Subpedidos</button>`
                        : `<button type="button" class="btn btn-sm" disabled title="Sin id (reportar)"><i class="bi bi-exclamation-triangle"></i> Subpedidos</button>`;
                } else {
                    botones += tieneId
                        ? `<button type="button" class="btn btn-sm btn-exec-red btn-flujo-ov" data-id="${esc(id)}" data-cons="${esc(cons)}"><i class="bi bi-lightning-charge"></i> Administrar y enviar</button>`
                        : `<button type="button" class="btn btn-sm" disabled title="Sin id (reportar)"><i class="bi bi-exclamation-triangle"></i> Abrir</button>`;
                    botones += `<button type="button" class="btn btn-sm btn-exec-red-outline btn-cancel-ov" data-id="${esc(id ?? '')}" data-cons="${esc(cons)}"><i class="bi bi-x-circle"></i> Cancelar</button>`;
                }

                return `
                    <tr class="${rowClass}">
                        <td class="t-cons">${esc(cons)}</td>
                        <td>${esc(serie || '—')}</td>
                        <td title="${esc(clienteId)} · ${esc(clienteNombre)}">${esc(clienteNombre)}</td>
                        <td title="${esc(vendedor)}">${esc(vendedor)}</td>
                        <td>${esc(formatDateOnly(fechaEntrega))}</td>
                        <td><span class="badge-present">${esc(present || '—')}</span></td>
                        <td title="${esc(obs)}">${esc(obs)}</td>
                        <td class="actions-cell">${botones}</td>
                    </tr>`;
            }).join(''));
        }

        async function cargarPedidos() {
            const tbody = $('#pedidosBody');
            tbody.html(`<tr><td colspan="8" class="empty">Cargando pedidos…</td></tr>`);
            const endpoint = (vistaActual === 'completados') ? '/Comercial/ObtenerPedidosCompletados' : '/Comercial/ObtenerPedidosLiberados';
            try {
                const res = await fetch(endpoint, { headers: { 'Accept': 'application/json' }, cache: 'no-store' });
                const raw = await res.text();
                if (!res.ok) {
                    console.error('Error al consultar pedidos', { endpoint, status: res.status, respuesta: raw });
                    throw new Error(`Error al consultar pedidos. HTTP ${res.status}${raw ? ' - ' + raw.substring(0, 500) : ''}`);
                }
                let pedidos = [];
                try { pedidos = raw ? JSON.parse(raw) : []; }
                catch { console.error('El servidor no devolvió JSON válido al cargar pedidos:', raw); throw new Error('La respuesta de pedidos no es JSON válido.'); }
                pedidosCache = Array.isArray(pedidos) ? pedidos : [];
                renderPedidos();
                setActualizadoAhora();
            } catch (e) {
                console.error('cargarPedidos:', e);
                tbody.html(`<tr><td colspan="8" class="empty text-danger">No se pudieron cargar los pedidos.<br><small>${esc(e?.message || String(e))}</small></td></tr>`);
                setConteoFromRows([]);
            }
        }

        /* ===== División de un SKU entre almacenes (tope base + 30 cajas compartido por grupo) ===== */
        function _gid() { return Math.random().toString(36).slice(2, 9); }
        function groupSumCajas(groupId) {
            return (ovState.productos || []).filter(p => p.groupId === groupId && !p.eliminado)
                .reduce((s, p) => s + Math.max(0, Math.floor(Number(p.cajas ?? 0) || 0)), 0);
        }
        function groupCapTotal(groupId) {
            const any = (ovState.productos || []).find(p => p.groupId === groupId);
            if (!any) return 0;
            return Math.max(0, Math.floor(Number(any.baseMaxCajas ?? any.maxCajas ?? any.cajas ?? 0) || 0)) + 30;
        }
        function lineMaxFor(r) {
            if (!r.groupId) return Math.max(0, Math.floor(Number(r.maxCajas ?? r.cajas ?? 0) || 0)) + 30;
            const mi = Math.max(0, Math.floor(Number(r.cajas ?? 0) || 0));
            return Math.max(0, groupCapTotal(r.groupId) - (groupSumCajas(r.groupId) - mi));
        }
        function dividirProducto(idx) {
            if (ovSoloLectura) return;
            const base = ovState.productos?.[idx];
            if (!base) return;
            if (!base.groupId) {
                base.groupId = _gid();
                base.baseMaxCajas = Math.max(0, Math.floor(Number(base.maxCajas ?? base.cajas ?? 0) || 0));
            }
            ovState.productos.splice(idx + 1, 0, { ...base, almacen: '', cajas: 0, eliminado: false, groupId: base.groupId, baseMaxCajas: base.baseMaxCajas });
            renderProductosTabla();
            const cons = getConsecutivoActual();
            if (cons) draftGuardar(cons, ovState.productos);
        }

        /* ===== Barra rápida (almacén / cajas default) ===== */
        function quickBarSyncOptions() {
            const src = document.getElementById('ovAlmacen');
            const dst = document.getElementById('ovAlmacenDefault');
            if (!src || !dst) return;
            dst.innerHTML = '';
            [...src.options].forEach(o => { const opt = document.createElement('option'); opt.value = o.value; opt.textContent = o.textContent; dst.appendChild(opt); });
            if (src.value) dst.value = src.value;
        }
        function getDefaultAlmacenValue() {
            return normalizarAlmacenValue(document.getElementById('ovAlmacenDefault')?.value)
                || normalizarAlmacenValue(document.getElementById('ovAlmacen')?.value) || '';
        }
        function getDefaultCajasValue() { return Math.max(0, Math.floor(Number(document.getElementById('ovCajasDefault')?.value || 0))); }

        function aplicarAlmacen({ soloVacios = false } = {}) {
            if (ovSoloLectura) return;
            const alm = getDefaultAlmacenValue();
            if (!alm) { alert('Selecciona un almacén default válido.'); return; }
            (ovState.productos || []).forEach(p => {
                if (p.eliminado) return;
                if (soloVacios && normalizarAlmacenValue(p.almacen)) return;
                p.almacen = alm;
            });
            renderProductosTabla();
        }
        function aplicarCajas({ soloVacios = false } = {}) {
            if (ovSoloLectura) return;
            const cajas = getDefaultCajasValue();
            (ovState.productos || []).forEach(p => {
                if (p.eliminado) return;
                if (soloVacios && Math.max(0, Math.floor(Number(p.cajas ?? 0) || 0)) > 0) return;
                p.cajas = Math.min(cajas, lineMaxFor(p)); // respeta el tope por grupo
            });
            renderProductosTabla();
        }
        // Si la línea viene sin almacén, usa default / global / primera opción
        function autoFillAlmacenSiVacio() {
            const firstValid = (_opcionesAlmacen().find(o => (o.value || '').toString().trim() !== '')?.value || '').toString().trim();
            const def = getDefaultAlmacenValue() || firstValid || '';
            (ovState.productos || []).forEach(p => {
                if (p.eliminado) return;
                const actual = normalizarAlmacenValue(p.almacen);
                if (actual) { p.almacen = actual; return; }
                if (def) p.almacen = def;
            });
        }

        /* ===== Atajos ===== */
        function bindQuickShortcuts() {
            // CORRECCIÓN: Ctrl+S solo guarda si el modal de la orden está abierto.
            // Antes también se activaba con el modal cerrado y podía volver a enviar la última orden abierta.
            document.addEventListener('keydown', function (e) {
                if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 's') {
                    if (!document.getElementById('ovModal')?.classList.contains('show')) return;
                    e.preventDefault();
                    document.getElementById('btnGuardarProductos')?.click();
                }
            });
            // Enter en cajas -> siguiente renglón
            $(document).on('keydown', '#ovProductos .inp-cajas', function (e) {
                if (e.key !== 'Enter') return;
                e.preventDefault();
                const $rows = $('#ovProductos tbody tr');
                const idx = $rows.index($(this).closest('tr'));
                for (let i = idx + 1; i < $rows.length; i++) {
                    const next = $rows.eq(i).find('.inp-cajas:not(:disabled)').get(0);
                    if (next) { next.focus(); next.select?.(); return; }
                }
            });
        }

        /* ===== Tabla de productos del modal ===== */
        function recalcularTotalesOV() {
            let tImp = 0, tPeso = 0;
            (ovState.productos || []).forEach(p => {
                if (p.eliminado) return;
                const kTot = (Number(p.kilosCaja ?? p.peso ?? 0) || 0) * Math.max(0, Math.floor(Number(p.cajas ?? 0) || 0));
                tImp += (Number(p.precio ?? 0) || 0) * kTot;
                tPeso += kTot;
            });
            document.getElementById('ovTotalImporte').textContent = mxn(tImp);
            document.getElementById('ovTotalPeso').textContent = num(tPeso);
        }

        function renderProductosTabla() {
            const tbody = document.querySelector('#ovProductos tbody');
            if (!tbody) return;
            const cons = getConsecutivoActual();

            if (!ovState.productos || ovState.productos.length === 0) {
                tbody.innerHTML = `<tr><td colspan="9" class="empty">Sin productos.</td></tr>`;
            } else {
                tbody.innerHTML = ovState.productos.map((r, i) => {
                    const eliminado = !!r.eliminado;
                    const sku = r.productoCodigo ?? r.sku ?? '';
                    const nombre = r.productoNombre ?? r.producto ?? '';
                    const kilosCaja = Number(r.kilosCaja ?? r.peso ?? 0) || 0;
                    const maxCajas = lineMaxFor(r);
                    const cajasUI = Math.max(0, Math.floor(Number(r.cajas ?? 0) || 0));
                    const precio = Number(r.precio ?? 0) || 0;
                    const kilosTotales = kilosCaja * cajasUI;
                    const importe = precio * kilosTotales;
                    const nombreHtml = eliminado ? `<s>${esc(nombre)}</s> <span class="badge-present">Eliminado</span>` : esc(nombre);

                    let acciones;
                    if (ovSoloLectura) {
                        acciones = `<button type="button" class="btn btn-sm" disabled aria-label="Sustituir SKU"><i class="bi bi-arrow-left-right"></i></button>
                                    <button type="button" class="btn btn-sm btn-outline-danger" disabled aria-label="Eliminar"><i class="bi bi-trash"></i></button>`;
                    } else if (!eliminado) {
                        acciones = `<button type="button" class="btn btn-sm" onclick="dividirProducto(${i})" title="Dividir en otro almacén" aria-label="Dividir en otro almacén"><i class="bi bi-diagram-2"></i></button>
                                    <button type="button" class="btn btn-sm" onclick="abrirSustitucion(${i})" title="Sustituir SKU" aria-label="Sustituir SKU"><i class="bi bi-arrow-left-right"></i></button>
                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="eliminarProducto(${i})" title="Eliminar renglón" aria-label="Eliminar renglón"><i class="bi bi-trash"></i></button>`;
                    } else {
                        acciones = `<button type="button" class="btn btn-sm btn-outline-success" onclick="restaurarProducto(${i})" title="Restaurar" aria-label="Restaurar"><i class="bi bi-arrow-counterclockwise"></i></button>`;
                    }

                    return `
                        <tr data-idx="${i}" class="${eliminado ? 'table-secondary' : ''}">
                            <td>${i + 1}</td>
                            <td style="font-weight:600">${esc(sku)}</td>
                            <td>${nombreHtml}</td>
                            <td class="text-end num"><span class="cell-kgtot">${num(kilosTotales)}</span></td>
                            <td class="text-end num">${mxn(precio)}</td>
                            <td>
                                <input type="number" min="0" step="1" class="form-control form-control-sm inp-cajas" data-idx="${i}"
                                       value="${cajasUI}" max="${maxCajas}" title="Máximo permitido: ${maxCajas}" aria-label="Cajas"
                                       ${eliminado || ovSoloLectura ? 'disabled' : ''}>
                                <div class="form-text text-end cell-max">Máx: ${maxCajas}</div>
                            </td>
                            <td>${buildAlmacenSelectHtml(r.almacen, (eliminado || ovSoloLectura))}</td>
                            <td class="text-end num"><span class="cell-importe">${mxn(importe)}</span></td>
                            <td><div class="btn-group">${acciones}</div></td>
                        </tr>`;
                }).join('');
            }

            recalcularTotalesOV();
            if (cons && !ovSoloLectura) draftGuardar(cons, ovState.productos);
            if (ovSoloLectura) bloquearOVLectura();
        }

        // CORRECCIÓN: un solo manejador para las cajas de cada renglón.
        // Antes había dos; uno redibujaba toda la tabla en cada tecla (se perdía el cursor
        // al escribir un número de dos dígitos) y no respetaba el tope de cajas.
        $(document).on('input', '#ovProductos .inp-cajas', function () {
            if (ovSoloLectura) return;
            const tr = $(this).closest('tr');
            const idx = Number(tr.data('idx'));
            const r = (ovState.productos || [])[idx];
            if (!r) return;

            const cap = lineMaxFor(r);
            let val = Math.max(0, Math.floor(Number(this.value) || 0));
            if (val > cap) { val = cap; this.value = val; }
            r.cajas = val;
            this.max = cap;
            this.title = `Máximo permitido: ${cap}`;

            const kilosTot = (Number(r.kilosCaja ?? r.peso ?? 0) || 0) * val;
            tr.find('.cell-kgtot').text(num(kilosTot));
            tr.find('.cell-importe').text(mxn((Number(r.precio ?? 0) || 0) * kilosTot));

            // Si el SKU está dividido, actualiza el "Máx" de sus otras líneas
            if (r.groupId) {
                $('#ovProductos tbody tr').each(function () {
                    const j = Number($(this).data('idx'));
                    const p = ovState.productos[j];
                    if (!p || j === idx || p.groupId !== r.groupId) return;
                    const capJ = lineMaxFor(p);
                    $(this).find('.inp-cajas').attr({ max: capJ, title: `Máximo permitido: ${capJ}` });
                    $(this).find('.cell-max').text(`Máx: ${capJ}`);
                });
            }

            recalcularTotalesOV();
            const cons = getConsecutivoActual();
            if (cons) draftGuardar(cons, ovState.productos);
        });

        // Al cambiar el almacén de un renglón se guarda en el estado
        $(document).on('change', '#ovProductos .sel-almacen', function () {
            if (ovSoloLectura) return;
            const idx = Number($(this).closest('tr').data('idx'));
            if (!Number.isNaN(idx) && ovState.productos[idx]) {
                ovState.productos[idx].almacen = (this.value || '').toString().trim();
                const cons = getConsecutivoActual();
                if (cons) draftGuardar(cons, ovState.productos);
            }
        });

        function limpiarFormAgregar() { $('#agSku,#agNombre,#agKilos,#agPrecio,#agCajas').val(''); }

        function eliminarProducto(idx) {
            if (ovSoloLectura) return;
            if (idx == null || idx < 0 || idx >= ovState.productos.length) return;
            if (!confirm('¿Eliminar este producto de la orden?')) return;
            ovState.productos[idx].eliminado = true;
            renderProductosTabla();
        }
        function restaurarProducto(idx) {
            if (ovSoloLectura) return;
            if (idx == null || idx < 0 || idx >= ovState.productos.length) return;
            ovState.productos[idx].eliminado = false;
            renderProductosTabla();
        }

        function validarAgregarForm() {
            const sku = $('#agSku').val().trim();
            const nombre = $('#agNombre').val().trim();
            const kilos = Number($('#agKilos').val());
            const precio = Number($('#agPrecio').val());
            const cajas = Number($('#agCajas').val());
            if (!sku) return { ok: false, msg: 'SKU es requerido.' };
            if (!nombre) return { ok: false, msg: 'Nombre del producto es requerido.' };
            if (isNaN(kilos) || kilos < 0) return { ok: false, msg: 'Peso/Caja inválido.' };
            if (isNaN(precio) || precio < 0) return { ok: false, msg: 'Precio inválido.' };
            if (isNaN(cajas) || cajas < 0) return { ok: false, msg: 'Cajas inválidas.' };
            return {
                ok: true, data: {
                    productoCodigo: sku, sku, productoNombre: nombre, producto: nombre,
                    kilosCaja: kilos, precio, cajas, maxCajas: cajas,
                    almacen: ($('#ovAlmacen').val() || '').toString().trim()
                }
            };
        }

        // Copia los valores elegidos en los <select> al estado
        function syncAlmacenesDesdeDOM() {
            const tbody = document.querySelector('#ovProductos tbody');
            (ovState.productos || []).forEach((p, i) => {
                const tr = tbody?.querySelector(`tr[data-idx="${i}"]`);
                if (!tr || p.eliminado) return;
                p.almacen = (tr.querySelector('.sel-almacen')?.value || '').toString().trim();
            });
        }

        function _esLineaEliminada(p, tr) {
            return !!p?.eliminado || tr.classList.contains('table-secondary') || tr.querySelector('.inp-cajas')?.disabled === true;
        }
        function validarAlmacenesPorLinea() {
            const tbody = document.querySelector('#ovProductos tbody');
            let firstIdx = null;
            (ovState.productos || []).forEach((p, i) => {
                const tr = tbody?.querySelector(`tr[data-idx="${i}"]`);
                if (!tr) return;
                if (_esLineaEliminada(p, tr)) { tr.classList.remove('table-danger'); return; }
                const valor = ((p?.almacen && String(p.almacen).trim()) ? String(p.almacen) : (tr.querySelector('.sel-almacen')?.value || '')).trim();
                tr.classList.toggle('table-danger', !valor);
                if (!valor && firstIdx == null) firstIdx = i;
            });
            if (firstIdx != null) {
                tbody.querySelector(`tr[data-idx="${firstIdx}"]`)?.scrollIntoView({ behavior: 'smooth', block: 'center' });
                alert('Selecciona el almacén en todas las líneas no eliminadas antes de guardar.');
                return false;
            }
            return true;
        }
        function validarCajasMayoresCero() {
            const tbody = document.querySelector('#ovProductos tbody');
            let firstIdx = null;
            (ovState.productos || []).forEach((p, i) => {
                const tr = tbody?.querySelector(`tr[data-idx="${i}"]`);
                if (!tr) return;
                if (_esLineaEliminada(p, tr)) { tr.classList.remove('table-danger'); return; }
                const cajas = Math.max(0, Math.floor(Number(p.cajas ?? 0) || 0));
                const kilosCaja = Number(p.kilosCaja ?? p.peso ?? 0) || 0;
                const malo = cajas <= 0 || kilosCaja <= 0;
                tr.classList.toggle('table-danger', malo);
                if (malo && firstIdx == null) firstIdx = i;
            });
            if (firstIdx != null) {
                tbody.querySelector(`tr[data-idx="${firstIdx}"]`)?.scrollIntoView({ behavior: 'smooth', block: 'center' });
                alert('No puedes guardar: hay líneas con cajas = 0 o kg = 0. Captura valores válidos o elimina la línea.');
                return false;
            }
            return true;
        }

        /* ===== Guardar cambios de la orden ===== */
        async function guardarCambiosProductos() {
            if (guardandoOV) return false; // CORRECCIÓN: evita doble envío (doble clic o Ctrl+S repetido)
            if (!ovState.id) { alert('Orden no cargada.'); return false; }
            if (ovSoloLectura) { alert('Esta orden está completada (solo lectura).'); return false; }

            syncAlmacenesDesdeDOM();
            if (!validarAlmacenesPorLinea()) return false;
            if (!validarCajasMayoresCero()) return false;

            for (const p of ovState.productos) {
                if (p.eliminado) continue;
                const cap = lineMaxFor(p);
                if (Number(p.cajas ?? 0) > cap) { alert(`El producto ${p.productoCodigo} excede el máximo permitido (${cap} cajas).`); return false; }
            }

            const consecutivoVal = getConsecutivoActual();
            if (!consecutivoVal) { alert('Esta orden no tiene consecutivo aún.'); return false; }

            const feInput = document.getElementById('ovFechaEmbarque');
            const fechaEmbarqueVal = feInput?.value || '';
            if (!fechaEmbarqueVal) { alert('Selecciona la fecha de embarque.'); feInput?.focus(); return false; }
            if (feInput.min && fechaEmbarqueVal < feInput.min) { alert('La fecha de embarque no puede ser menor a la fecha de entrega.'); return false; }

            const payload = {
                ordenId: ovState.id,
                fechaEmbarque: new Date(fechaEmbarqueVal).toISOString(),
                almacenSurtir: (document.getElementById('ovAlmacen')?.value || '').trim(),
                productos: ovState.productos.map(p => ({
                    productoCodigo: p.productoCodigo ?? p.sku ?? '',
                    productoNombre: p.productoNombre ?? p.producto ?? '',
                    sku: p.productoCodigo ?? p.sku ?? '',
                    producto: p.productoNombre ?? p.producto ?? '',
                    kilosCaja: Number(p.kilosCaja ?? p.peso ?? 0),
                    precio: Number(p.precio ?? 0),
                    cajas: Number(p.cajas ?? 0),
                    eliminado: !!p.eliminado,
                    almacen: (p.almacen || '').toString().trim()
                }))
            };

            const token = _tokenAF();
            const btn = document.getElementById('btnGuardarProductos');
            const htmlBtn = btn?.innerHTML;
            guardandoOV = true;
            if (btn) { btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Guardando…'; }

            try {
                const res = await fetch('/Comercial/GestionarPedido', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', ...(token ? { 'RequestVerificationToken': token } : {}) },
                    body: JSON.stringify(payload)
                });
                const text = await res.text();
                if (!res.ok) { console.error('Error HTTP', res.status, text); alert(text || 'No se pudieron guardar los cambios.'); return false; }

                alert('Pedido gestionado y guardado.');

                const idx = pedidosCache.findIndex(x => (x.id ?? x.Id) === ovState.id);
                if (idx > -1) pedidosCache[idx].estatus = 4;
                _ovModalCache.delete(String(ovState.id)); // CORRECCIÓN: no volver a mostrar datos previos al guardado

                ovSoloLectura = true;
                bloquearOVLectura();
                draftBorrar(consecutivoVal);
                renderPedidos();
                setActualizadoAhora();

                if (flujoRapidoActivo && ovState.id) {
                    pvState.id = ovState.id;
                    pvState.ov = pvState.ov || { consecutivo: consecutivoVal };
                    await abrirSubpedidosPorOrden(ovState.id);
                }
                return true;
            } catch (e) {
                console.error(e);
                alert('No se pudieron guardar los cambios. Antes de reintentar, revisa si el pedido ya aparece en Completados.');
                return false;
            } finally {
                guardandoOV = false;
                if (btn) { btn.innerHTML = htmlBtn; if (!ovSoloLectura) btn.disabled = false; }
            }
        }

        /* ===== Vista previa (completados) ===== */
        async function abrirVistaPrevia(id) {
            pvState.id = id; pvState.ov = null;
            document.getElementById('pvConsecutivo').textContent = '—';
            ['pvCliente', 'pvVendedor', 'pvEntrega', 'pvSerie', 'pvCreacion', 'pvPresentacion', 'pvObservacion'].forEach(x => { const el = document.getElementById(x); if (el) el.value = ''; });
            const pvTbody = document.querySelector('#pvTabla tbody');
            pvTbody.innerHTML = `<tr><td colspan="8" class="empty">Cargando…</td></tr>`;
            document.getElementById('pvTotalImporte').textContent = '$0.00';
            document.getElementById('pvTotalPeso').textContent = '0.00';
            _modal('ovPreviewModal', { backdrop: 'static' }).show();

            let data;
            try {
                const res = await fetch(`/Comercial/OrdenVentaJson?id=${encodeURIComponent(id)}`, { headers: { 'Accept': 'application/json' }, cache: 'no-store' });
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                data = await res.json();
            } catch (e) {
                console.error('Error al cargar OV (vista previa):', e);
                pvTbody.innerHTML = `<tr><td colspan="8" class="empty text-danger">No se pudo cargar la orden (${esc(e.message)}).</td></tr>`;
                return;
            }

            const ov = {
                id: data.id ?? data.Id,
                pedidoVentaId: data.pedidoVentaId ?? data.PedidoVentaId ?? null,
                consecutivo: data.consecutivo ?? data.Consecutivo ?? data.ordenDeVenta ?? data.OrdenDeVenta,
                cliente: data.cliente ?? data.Cliente,
                clienteNombre: data.clienteNombre ?? data.ClienteNombre ?? null,
                vendedor: data.vendedor ?? data.Vendedor,
                fechaEntrega: data.fechaEntrega ?? data.FechaEntrega,
                fechaRegistro: data.fechaRegistro ?? data.FechaRegistro,
                presentacion: data.presentacion ?? data.Presentacion,
                observacion: data.observacion ?? data.Observacion,
                direccion: data.direccion ?? data.Direccion ?? data.ruta ?? data.Ruta,
                saldo: data.saldo ?? data.Saldo,
                otrosPedidos: data.otrosPedidos ?? data.OtrosPedidos,
                credito: data.credito ?? data.Credito,
                fechaEmbarque: data.fechaEmbarque ?? data.FechaEmbarque,
                almacenSurtir: data.almacenSurtir ?? data.AlmacenSurtir,
                productos: data.productos ?? data.Productos ?? [],
                cardCode: data.cardCode ?? data.CardCode ?? data.cliente ?? data.Cliente ?? ''
            };
            ov.clienteNombre = getClienteNombre(data) || getClienteNombre(ov) || '';
            const draftPv = draftObtener((ov.consecutivo || '').toString().trim());
            if (draftPv) ov.productos = draftPv;

            pvState.ov = ov;
            window._ovDataLast = ov;

            document.getElementById('pvConsecutivo').textContent = ov.consecutivo || '—';
            document.getElementById('pvCliente').value = ov.clienteNombre || '';
            document.getElementById('pvVendedor').value = ov.vendedor || '';
            document.getElementById('pvEntrega').value = formatDateOnly(ov.fechaEntrega);
            document.getElementById('pvSerie').value = data.serie ?? data.Serie ?? '';
            document.getElementById('pvCreacion').value = formatDateTime(ov.fechaRegistro);
            document.getElementById('pvPresentacion').value = ov.presentacion || '';
            document.getElementById('pvObservacion').value = ov.observacion || '';

            if (!ov.productos.length) {
                pvTbody.innerHTML = `<tr><td colspan="8" class="empty">Sin productos.</td></tr>`;
                return;
            }
            let tImp = 0, tPeso = 0;
            pvTbody.innerHTML = ov.productos.map((r, i) => {
                const sku = r.productoCodigo ?? r.ProductoCodigo ?? r.sku ?? r.SKU ?? '';
                const nombre = r.productoNombre ?? r.ProductoNombre ?? r.producto ?? r.Producto ?? '';
                const kilosCaja = Number(r.kilosCaja ?? r.KilosCaja ?? r.peso ?? r.Peso ?? 0) || 0;
                const precio = Number(r.precio ?? r.Precio ?? 0) || 0;
                const cajas = Math.max(0, Math.floor(Number(r.cajas ?? r.Cajas ?? 0) || 0));
                // En órdenes completadas el campo kilosCaja ya trae el total de kg del renglón (igual que antes).
                const kilosTot = kilosCaja;
                const importe = precio * kilosTot;
                tImp += importe; tPeso += kilosTot;
                const detalleId = Number(r.detalleId ?? r.DetalleId ?? 0);
                const almacen = (r.almacen ?? r.Almacen ?? ov.almacenSurtir ?? '').toString().trim();
                return `
                    <tr data-idx="${i}" data-detalle-id="${detalleId}">
                        <td>${i + 1}</td>
                        <td style="font-weight:600">${esc(sku)}</td>
