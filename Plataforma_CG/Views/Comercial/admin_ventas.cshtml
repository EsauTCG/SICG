        // Enviar subpedido a SAP (con confirmación, sin contraseña — igual que antes)
        $(document).on('click', '.btn-sp-send', async function () {
            const subId = parseInt((this.getAttribute('data-subid') || '').toString().trim(), 10);
            if (!Number.isFinite(subId) || subId <= 0) { alert('Subpedido inválido.'); return; }
            if (!confirm(`¿Enviar el subpedido ${subId} a SAP?`)) return;

            const token = _tokenAF();
            const $btn = $(this), old = $btn.html();
            $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span> Enviando…');
            try {
                const res = await fetch(`/Comercial/SubpedidoEnviarASAP?id=${encodeURIComponent(subId)}`, {
                    method: 'POST',
                    headers: { 'Accept': 'application/json', ...(token ? { 'RequestVerificationToken': token } : {}) }
                });
                const rawTxt = await res.text();
                if (!res.ok) { alert(rawTxt || `Error ${res.status} al enviar a SAP.`); return; }
                let json = {}; try { json = JSON.parse(rawTxt); } catch { }
                const doc = json.documentoSAP || json.DocEntry || json.DocNum || '(sin folio)';
                const cell = document.getElementById(`spDocSap_${subId}`);
                if (cell) cell.textContent = doc;
                alert(`Enviado a SAP. Documento: ${doc}`);
            } catch (e) {
                console.error(e);
                alert('Error de red al enviar a SAP. Antes de reintentar, revisa si el documento SAP ya aparece al refrescar.');
            } finally {
                $btn.prop('disabled', false).html(old);
