            const seq = ++_skuBusquedaSeq;
            $res.html(`<tr><td colspan="4" class="empty">Buscando…</td></tr>`);
            const rows = await buscarProductos(term);
            if (seq !== _skuBusquedaSeq) return;
            if (!rows.length) { $res.html(`<tr><td colspan="4" class="empty">Sin resultados.</td></tr>`); return; }
