                    $(row).data('kg-por-caja', 0);
                    const ft = row.querySelector('.tr-kgcaja');
                    if (ft) ft.textContent = 'Kg/caja: — (SKU sustituido, revisa los kg)';
                    row.classList.add('table-warning');
                }
                trSwapRowIdx = null;
                _modal('skuSwapModal').hide();
                return;
            }

            try {
                if (skuSwapIndex == null || ovSoloLectura) return;
                const cardCode = getOVCardCode();
                let precio = null, kilosCaja = null;
                if (cardCode) {
                    try {
                        const r = await fetch(ENDPOINTS.precioCliente(cardCode, sku), { cache: 'no-store' });
                        if (r.ok) { const j = await r.json(); precio = Number(j?.precio ?? j?.Precio ?? 0); kilosCaja = Number(j?.kilosCaja ?? j?.KilosCaja ?? 0); }
                    } catch (e) { console.warn('precioCliente:', e); }
                }
                const original = ovState.productos[skuSwapIndex] || {};
                const maxCajas = Math.max(0, Math.floor(Number(original.maxCajas ?? original.cajas ?? 0) || 0));
                const cajas = Math.min(maxCajas, Math.max(0, Math.floor(Number(original.cajas ?? 0) || 0)));
                if (!Number.isFinite(kilosCaja) || kilosCaja <= 0) kilosCaja = Number(original.kilosCaja ?? 0) || 0;
                if (!Number.isFinite(precio) || precio < 0) precio = Number(original.precio ?? 0) || 0;

                ovState.productos[skuSwapIndex] = {
                    ...original, productoCodigo: sku, sku, productoNombre: nombre, producto: nombre,
                    kilosCaja, precio, cajas, maxCajas, almacen: (original.almacen || '')
                };
                renderProductosTabla();
                _modal('skuSwapModal').hide();
            } catch (e) {
                console.error(e);
                alert('No fue posible sustituir el SKU.');
            }
        });

        /* ===== Actualizar almacenes de una orden completada ===== */
        $('#btnActualizarAlmacenesPreview').on('click', async function () {
            if (!pvState?.id || !pvState?.ov) { alert('No hay orden cargada.'); return; }
            const productos = [];
            $('#pvTabla tbody tr').each(function () {
                const detalleId = Number($(this).attr('data-detalle-id') || 0);
                const almacen = ($(this).find('.pv-almacen').val() || '').toString().trim();
                if (detalleId > 0) productos.push({ detalleId, almacen });
            });
            if (!productos.length) { alert('No hay renglones válidos para actualizar.'); return; }

            const btn = this, original = btn.innerHTML;
            btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Actualizando…';
            const token = _tokenAF();
            try {
                const res = await fetch('/Comercial/ActualizarAlmacenesCompletado', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', ...(token ? { 'RequestVerificationToken': token } : {}) },
                    body: JSON.stringify({ ordenId: Number(pvState.id), productos })
                });
                const raw = await res.text();
                let json = null; try { json = JSON.parse(raw); } catch { }
                if (!res.ok || json?.ok === false) { alert(json?.msg || raw || 'No se pudieron actualizar los almacenes.'); return; }
                alert(json?.msg || 'Almacenes actualizados correctamente.');
                $('#pvTabla tbody tr').each(function (i) {
                    if (pvState.ov.productos[i]) pvState.ov.productos[i].almacen = ($(this).find('.pv-almacen').val() || '').toString().trim();
                });
            } catch (e) {
                console.error(e);
                alert('No se pudieron actualizar los almacenes.');
            } finally {
                btn.disabled = false; btn.innerHTML = original;
            }
        });

        /* ===== Vistas (pestañas) =====
           CORRECCIÓN: una sola función controla pestañas y paneles. Antes había dos mecanismos
           que se pisaban; por ejemplo, después de volver de Pendientes a Informe ya no
           aparecían los botones "Demanda vs inventario" y "Descargar CSV". */
        function mostrarVista(v) {
            const tabs = { pendientes: 'tabPendientes', completados: 'tabCompletados', transferencias: 'tabTransferencias', demandaDetalle: 'tabDemandaDetalle' };
            Object.entries(tabs).forEach(([key, id]) => {
                const b = document.getElementById(id);
                if (b) { b.classList.toggle('active', key === v); b.setAttribute('aria-selected', key === v ? 'true' : 'false'); }
            });

            $('#panelPedidos').toggle(v === 'pendientes' || v === 'completados');
            $('#panelTransferencias').toggle(v === 'transferencias');
            $('#panelDemandaDetalle').toggle(v === 'demandaDetalle');
            $('#panelDemandaInv').hide();
            $('#accionesInforme').css('display', '');
            toggleAccionesInforme(v === 'demandaDetalle');

            if (v === 'pendientes' || v === 'completados') {
                vistaActual = v;
                localStorage.setItem('vistaOV', v);
                cargarPedidos();
            } else if (v === 'transferencias') {
                cargarTransferencias();
            } else if (v === 'demandaDetalle') {
                cargarDemandaDetalle();
            }
        }
        // Se conserva el nombre anterior por compatibilidad
        function switchVista(v) { mostrarVista(v); }
        function getPanelPedidos() { return $('#panelPedidos'); }

        /* ===== Subpedidos ===== */
        let generandoSubpedidos = false;

        async function refrescarSubpedidosModal(ordenId) {
            const $body = $('#spBody');
            $('#spConsecutivo').text(pvState?.ov?.consecutivo || '—');
            $body.html(`<tr><td colspan="9" class="empty">Cargando…</td></tr>`);
            $('#spKgTot').text('0.00'); $('#spImpTot').text('$0.00'); $('#spRenglonesTot').text('0');

            let data;
            try {
                const res = await fetch(`/Comercial/SubpedidosPreview?ordenId=${encodeURIComponent(ordenId)}`, { cache: 'no-store' });
                const txt = await res.text();
                if (!res.ok) { console.error(res.status, txt); $body.html(`<tr><td colspan="9" class="empty text-danger">${esc(txt || 'No fue posible obtener los subpedidos.')}</td></tr>`); return; }
                data = JSON.parse(txt);
            } catch (e) {
                console.error(e);
                $body.html(`<tr><td colspan="9" class="empty text-danger">No fue posible obtener los subpedidos.</td></tr>`);
                return;
            }

            const grupos = Array.isArray(data?.grupos) ? data.grupos : [];
            if (!grupos.length) {
                $body.html(`<tr><td colspan="9" class="empty">Esta orden aún no tiene subpedidos. Usa "Generar subpedidos".</td></tr>`);
                return;
            }

            let kgTot = 0, impTot = 0, rTot = 0;
            $body.html(grupos.map((g, idx) => {
                const renglones = Array.isArray(g.items) ? g.items.length : 0;
                const subId = g.subpedidoId ?? g.SubpedidoId ?? g.id ?? g.Id;
                const key = subId ?? ('x' + idx);
                kgTot += Number(g.totalKg ?? 0) || 0;
                impTot += Number(g.importe ?? 0) || 0;
                rTot += renglones;
                const docSap = g.documentoSAP ?? g.DocSAP ?? g.DocumentoSAP ?? '—';
                const docMeat = g.documentoMeat ?? g.DocMeat ?? g.DocumentoMeat ?? '—';
                return `
                    <tr id="spRow_${esc(key)}" data-subid="${esc(subId ?? '')}">
                        <td>${idx + 1}</td>
                        <td style="font-weight:600">${esc(g.subFolio ?? '—')}</td>
                        <td>${esc(g.almacen || '—')}</td>
                        <td class="text-end num">${num(g.totalKg)}</td>
                        <td class="text-end num">${mxn(g.importe)}</td>
                        <td class="text-end num">${renglones}</td>
                        <td id="spDocSap_${esc(key)}">${esc(docSap)}</td>
                        <td id="spDocMeat_${esc(key)}">${esc(docMeat)}</td>
                        <td class="text-center">${subId ? `
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-sm btn-primary btn-sp-send" data-subid="${esc(subId)}"><i class="bi bi-cloud-upload"></i> Enviar a SAP</button>
                                <button type="button" class="btn btn-sm btn-sp-json" data-subid="${esc(subId)}" title="Ver JSON SAP" aria-label="Ver JSON SAP"><i class="bi bi-code-slash"></i></button>
                            </div>` : ''}
                        </td>
                    </tr>`;
            }).join(''));
            $('#spKgTot').text(num(kgTot));
            $('#spImpTot').text(mxn(impTot));
            $('#spRenglonesTot').text(rTot.toString());
        }

        async function abrirSubpedidosPreview() {
            if (!pvState?.id) { alert('Primero abre la vista previa de la orden.'); return; }
            _modal('subpedidosModal', { backdrop: 'static', keyboard: true, focus: false }).show();
            await refrescarSubpedidosModal(pvState.id);
        }

        async function abrirSubpedidosPorOrden(ordenId) {
            if (ordenId == null || ordenId === '') { alert('Orden inválida.'); return; }
            let ov = null;
            try {
                const res = await fetch(`/Comercial/OrdenVentaJson?id=${encodeURIComponent(ordenId)}`, { headers: { 'Accept': 'application/json' }, cache: 'no-store' });
                if (res.ok) ov = await res.json();
            } catch (e) { console.warn('OrdenVentaJson (solo título):', e); }
            pvState.id = ordenId;
            pvState.ov = { consecutivo: ov?.consecutivo ?? ov?.Consecutivo ?? ov?.ordenDeVenta ?? ov?.OrdenDeVenta ?? '—' };
            _modal('subpedidosModal', { backdrop: 'static', keyboard: true, focus: false }).show();
            await refrescarSubpedidosModal(ordenId);
        }

        async function generarSubpedidos() {
            if (generandoSubpedidos) return; // CORRECCIÓN: evita doble clic
            if (!pvState?.id) { alert('No hay orden seleccionada.'); return; }
            const ordenId = pvState.id;
            const forzar = document.getElementById('spForzar')?.checked === true;
            if (!confirm(forzar
                ? 'Se REHARÁN los subpedidos por almacén de esta orden. ¿Deseas continuar?'
                : 'Se crearán subpedidos por almacén. ¿Deseas continuar?')) return;

            const token = _tokenAF();
            const btn = document.getElementById('btnGenerarSubpedidos');
            const original = btn.innerHTML;
            generandoSubpedidos = true;
            btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Generando…';
            try {
                const res = await fetch('/Comercial/GenerarSubpedidosPorAlmacen', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', ...(token ? { 'RequestVerificationToken': token } : {}) },
                    body: JSON.stringify({ ordenId, forzarRegeneracion: forzar })
                });
                const txt = await res.text();
                if (res.status === 409) { alert('Ya existen subpedidos para esta orden. Activa "Forzar regeneración" para rehacerlos.'); return; }
                if (!res.ok) { console.error(res.status, txt); alert(txt || 'No fue posible generar los subpedidos.'); return; }
                alert('Subpedidos generados / actualizados.');
                await refrescarSubpedidosModal(ordenId);
            } catch (e) {
                console.error(e);
                alert('Error al generar subpedidos.');
            } finally {
                generandoSubpedidos = false;
                btn.disabled = false; btn.innerHTML = original;
            }
        }

        async function abrirSubpedidoDetalle(subpedidoId) {
            if (!subpedidoId && subpedidoId !== 0) { alert('Id de subpedido inválido.'); return; }
            ['spDetSubFolio', 'spDetCliente', 'spDetEntrega', 'spDetAlmacen', 'spDetCreacion', 'spDetDocSap', 'spDetDocMeat'].forEach(x => document.getElementById(x).value = '');
            document.getElementById('spDetTitulo').textContent = '—';
            const $tbody = $('#spDetBody');
            $tbody.html(`<tr><td colspan="8" class="empty">Cargando…</td></tr>`);
            $('#spDetImpTot').text('$0.00'); $('#spDetKgTot').text('0.00');

            let data;
            try {
                const res = await fetch(`/Comercial/SubpedidoDetalleJson?subpedidoId=${encodeURIComponent(subpedidoId)}`, { cache: 'no-store' });
                const txt = await res.text();
                if (!res.ok) { console.error(res.status, txt); alert(txt || 'No se pudo cargar el subpedido.'); return; }
                data = JSON.parse(txt);
            } catch (e) { console.error(e); alert('Error al cargar el subpedido.'); return; }

            const h = data?.header || {};
            document.getElementById('spDetTitulo').textContent = `#${h.Id ?? subpedidoId}`;
            document.getElementById('spDetSubFolio').value = h.SubFolio ?? '';
            document.getElementById('spDetCliente').value = h.Cliente ?? '';
            document.getElementById('spDetEntrega').value = formatDateOnly(h.FechaEntrega);
            document.getElementById('spDetAlmacen').value = (h.Almacen ?? h.AlmacenSurtir ?? '') || '';
            document.getElementById('spDetCreacion').value = formatDateTime(h.FechaCreacion);
            document.getElementById('spDetDocSap').value = h.DocumentoSAP ?? '';
            document.getElementById('spDetDocMeat').value = h.DocumentoMeat ?? '';

            const rows = Array.isArray(data?.detalle) ? data.detalle : [];
            if (!rows.length) {
                $tbody.html(`<tr><td colspan="8" class="empty">Sin renglones.</td></tr>`);
            } else {
                let totImp = 0, totKg = 0;
                $tbody.html(rows.map((r, i) => {
                    const kilosCaja = Number(r.KilosCaja ?? 0) || 0;
                    const precio = Number(r.Precio ?? 0) || 0;
                    const cajas = Math.max(0, Math.floor(Number(r.Cajas ?? 0) || 0));
                    const imp = precio * kilosCaja;
                    totKg += kilosCaja; totImp += imp;
                    return `<tr>
                        <td>${i + 1}</td><td>${esc(r.ProductoCodigo ?? '')}</td><td>${esc(r.ProductoNombre ?? '')}</td>
                        <td class="text-end num">${num(kilosCaja)}</td><td class="text-end num">${mxn(precio)}</td>
                        <td class="text-end num">${cajas.toLocaleString('es-MX')}</td><td class="text-end num">${mxn(imp)}</td>
                        <td>${esc(r.Almacen ?? '')}</td></tr>`;
                }).join(''));
                $('#spDetImpTot').text(mxn(totImp));
                $('#spDetKgTot').text(num(totKg));
            }
            _modal('subpedidoDetalleModal', { backdrop: 'static' }).show();
        }

