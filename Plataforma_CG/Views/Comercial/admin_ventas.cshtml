                    </div>
                </div>
                <div class="pl-msection">
                    <div class="pl-msection__title">
                        <span>Detalle</span>
                        <button type="button" class="btn btn-sm btn-success" id="btnGuardarTransferencia"><i class="bi bi-save2"></i> Guardar cambios</button>
                    </div>
                    <div class="table-responsive table-responsive-sticky">
                        <table class="table table-sm align-middle mb-0 sapmm-grid" id="trProductos">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>SKU</th>
                                    <th>Producto</th>
                                    <th class="text-end">Cajas</th>
                                    <th class="text-end">KG</th>
                                    <th style="width:190px;">Acciones</th>
                                </tr>
                            </thead>
                            <tbody><tr><td colspan="6" class="empty">—</td></tr></tbody>
                            <tfoot>
                                <tr><th colspan="4" class="text-end">Total KG</th><th id="trTotalKg" class="text-end">0.000</th><th></th></tr>
                            </tfoot>
