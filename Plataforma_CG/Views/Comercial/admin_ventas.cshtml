        function _debounce(fn, ms = 300) { let t; return (...a) => { clearTimeout(t); t = setTimeout(() => fn(...a), ms); }; }

        async function buscarProductos(term) {
            try {
                const r = await fetch(ENDPOINTS.searchProducts(term), { cache: 'no-store' });
                if (!r.ok) throw new Error('HTTP ' + r.status);
                const list = await r.json();
                return (Array.isArray(list) ? list : []).map(it => ({ sku: (it.value || '').toString().toUpperCase(), nombre: (it.label || '').toString().toUpperCase() }));
            } catch (e) { console.error('buscarProductos:', e); return []; }
