        /* ===== Informe: demanda vs inventario y detalle ===== */
        async function cargarDemandaInventario() {
            const desde = ($('#fEntregaD').val() || '').trim();
            const hasta = ($('#fEntregaH').val() || '').trim();
            if (!desde || !hasta) { alert('Selecciona el rango de fechas (entrega desde y hasta).'); return; }
            const almacenes = getAlmacenesSeleccionadosInv();
            if (!almacenes.length) {
                alert('Selecciona al menos un almacén en "Almacenes y leyenda" para consultar Demanda vs inventario.');
                $('#demInvBody').html(`<tr><td colspan="8" class="empty">Selecciona almacenes para ver resultados.</td></tr>`);
                return;
            }
            const $tbody = $('#demInvBody');
            $('#panelDemandaInv').show();
            $tbody.html(`<tr><td colspan="8" class="empty">Cargando…</td></tr>`);
            try {
                const params = new URLSearchParams({ desde, hasta });
                almacenes.forEach(a => params.append('almacenesId', a));
                const res = await fetch(`/Comercial/DemandaInventario?${params.toString()}`, { cache: 'no-store', headers: { 'Accept': 'application/json' } });
                const txt = await res.text();
                if (!res.ok) { console.error(res.status, txt); $tbody.html(`<tr><td colspan="8" class="empty text-danger">${esc(txt || 'Error al cargar demanda vs inventario.')}</td></tr>`); return; }
                const data = JSON.parse(txt);
                if (!Array.isArray(data) || data.length === 0) { $tbody.html(`<tr><td colspan="8" class="empty">Sin resultados en el rango.</td></tr>`); return; }
                $tbody.html(data.map(r => {
                    const cajasConf = Number(r.cajasConfirmadas ?? r.CajasConfirmadas ?? 0);
                    return `<tr class="${cajasConf < 0 ? 'table-danger' : ''}">
                        <td style="font-weight:600">${esc(r.sku ?? r.SKU ?? '')}</td>
                        <td>${esc(r.producto ?? r.Producto ?? '')}</td>
                        <td class="text-end num">${num(r.cajasSolicitadas ?? r.CajasSolicitadas)}</td>
                        <td class="text-end num">${num(r.kilosSolicitados ?? r.KilosSolicitados)}</td>
                        <td class="text-end num">${num(r.cajasDisponibles ?? r.CajasDisponibles)}</td>
                        <td class="text-end num">${num(r.kilosDisponibles ?? r.KilosDisponibles)}</td>
                        <td class="text-end num"><b>${num(r.cajasConfirmadas ?? r.CajasConfirmadas)}</b></td>
                        <td class="text-end num">${num(r.kilosConfirmados ?? r.KilosConfirmados)}</td>
                    </tr>`;
                }).join(''));
            } catch (e) {
                console.error(e);
                $tbody.html(`<tr><td colspan="8" class="empty text-danger">Error al cargar.</td></tr>`);
            }
        }

