<!-- ══════════ MODAL: SUBPEDIDOS ══════════ -->
<div class="modal fade" id="subpedidosModal" tabindex="-1" aria-hidden="true" aria-labelledby="spTitle">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content plx-modal">
            <div class="modal-header">
                <h5 class="modal-title" id="spTitle"><i class="bi bi-diagram-3"></i> Subpedidos de <small id="spConsecutivo">—</small></h5>
