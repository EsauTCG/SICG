        /* ===== Transferencias ===== */
        async function cargarTransferencias() {
            const tbody = document.getElementById('transBody');
            tbody.innerHTML = `<tr><td colspan="6" class="empty">Cargando transferencias…</td></tr>`;
            // CORRECCIÓN: si el servidor falla se muestra el error (antes se quedaba en "Cargando…").
            try {
                const resp = await fetch('/Transferencias/GetTransferencias', { headers: { 'X-Requested-With': 'XMLHttpRequest' }, cache: 'no-store' });
                if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
                const data = await resp.json();
                if (!data || data.length === 0) {
                    tbody.innerHTML = `<tr><td colspan="6" class="empty">Sin transferencias.</td></tr>`;
                } else {
                    tbody.innerHTML = data.map(tr => `
                        <tr>
                            <td style="font-weight:600">${esc(tr.consecutivo ?? '')}</td>
                            <td>${esc(tr.serie ?? '—')}</td>
                            <td title="${esc(tr.sucursal ?? '')}">${esc(tr.sucursal ?? '')}</td>
                            <td>${esc(formatDateOnly(tr.fechaSolicitud ?? tr.fechaCreacion ?? ''))}</td>
                            <td title="${esc(tr.observacion ?? '')}">${esc(tr.observacion ?? '')}</td>
                            <td class="actions-cell">
                                <button type="button" class="btn btn-sm btn-tr-abrir" data-id="${esc(tr.id)}"><i class="bi bi-pencil-square"></i> Editar</button>
                                <button type="button" class="btn btn-sm btn-outline-danger btn-tr-cancelar" data-id="${esc(tr.id)}" data-cons="${esc(tr.consecutivo ?? '')}"><i class="bi bi-x-circle"></i> Cancelar</button>
                            </td>
                        </tr>`).join('');
                }
                document.getElementById('lblTransActualizado').textContent = 'Actualizado: ' + new Date().toLocaleTimeString('es-MX');
            } catch (e) {
                console.error('cargarTransferencias:', e);
                tbody.innerHTML = `<tr><td colspan="6" class="empty text-danger">No se pudieron cargar las transferencias (${esc(e.message)}). Usa Refrescar para reintentar.</td></tr>`;
            }
        }
        $(document).on('click', '.btn-tr-abrir', function () { abrirTransferencia(this.getAttribute('data-id')); });
        $(document).on('click', '.btn-tr-cancelar', function () { cancelarTransferencia(this.getAttribute('data-id'), this.getAttribute('data-cons')); });

        async function cancelarTransferencia(id, consecutivo) {
            if (!id) { alert('Transferencia inválida.'); return; }
            if (!confirm(`¿Seguro que deseas cancelar la transferencia ${consecutivo || id}?`)) return;
            const token = _tokenAF();
            try {
                const resp = await fetch('/Transferencias/CancelarTransferencia', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', ...(token ? { 'RequestVerificationToken': token } : {}) },
                    body: JSON.stringify({ id: Number(id) })
                });
                const txt = await resp.text();
                let json = null; try { json = JSON.parse(txt); } catch { }
                if (!resp.ok || json?.ok === false) { alert(json?.msg || txt || 'No se pudo cancelar la transferencia.'); return; }
                alert(json?.msg || 'Transferencia cancelada correctamente.');
                await cargarTransferencias();
            } catch (e) {
                console.error(e);
                alert('Error al cancelar la transferencia.');
            }
        }

        async function abrirTransferencia(id) {
            let tr;
            try {
                const resp = await fetch(`/Transferencias/GetTransferenciaDetalle?id=${encodeURIComponent(id)}`, { cache: 'no-store' });
                if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
                tr = await resp.json();
            } catch (e) {
                console.error('abrirTransferencia:', e);
                alert(`No se pudo cargar la transferencia (${e.message}).`);
                return;
            }

            document.getElementById('trFolio').value = tr.consecutivo ?? '';
            document.getElementById('trFecha').value = formatDateOnly(tr.fechaSolicitud ?? '');
            document.getElementById('trDestino').value = tr.sucursal ?? '';
            document.getElementById('trObservacion').value = tr.observacion ?? '';
            document.getElementById('trSubtitulo').textContent = tr.consecutivo ?? '—';

            document.querySelector('#trProductos tbody').innerHTML = (tr.items ?? []).map((it, idx) => {
                const kgPorCaja = Number(it.kgPorCaja ?? it.kilosCaja ?? 0) || 0;
                const kg = Number(it.kg ?? 0) || 0;
                const cajas = (it.cajas != null) ? Number(it.cajas) || 0 : (kgPorCaja > 0 ? (kg / kgPorCaja) : 0);
                return `
                    <tr data-idx="${idx}" data-detalle-id="${esc(it.detalleId ?? '')}" data-kg-por-caja="${kgPorCaja}">
                        <td>${idx + 1}</td>
                        <td><input class="form-control form-control-sm tr-sku" value="${esc(it.sku ?? '')}" disabled aria-label="SKU"></td>
                        <td class="tr-prod">${esc(it.producto ?? '')}</td>
                        <td class="text-end">
                            <input class="form-control form-control-sm tr-cajas" type="number" min="0" step="1" value="${Math.floor(Number(cajas) || 0)}" aria-label="Cajas">
                            <div class="form-text text-end tr-kgcaja">${kgPorCaja > 0 ? `Kg/caja: ${kgPorCaja.toFixed(3)}` : 'Kg/caja: —'}</div>
                        </td>
                        <td class="text-end"><input class="form-control form-control-sm tr-kg" type="number" min="0" step="0.001" value="${kg.toFixed(3)}" aria-label="Kg"></td>
                        <td class="actions-cell">
                            <button class="btn btn-sm btn-tr-sustituir" type="button" data-idx="${idx}"><i class="bi bi-arrow-left-right"></i> Sustituir</button>
                            <button type="button" class="btn btn-sm btn-outline-danger btn-tr-eliminar" title="Quitar renglón" aria-label="Quitar renglón"><i class="bi bi-trash"></i></button>
                        </td>
                    </tr>`;
            }).join('') || `<tr><td colspan="6" class="empty">Sin renglones.</td></tr>`;

            bindTrCajasKgSync();
            recalcTrTotal();
            window.__trId = id;
            _modal('trModal').show();
        }

        function recalcTrTotal() {
            let total = 0;
            document.querySelectorAll('#trProductos tbody .tr-kg').forEach(inp => { total += Number(inp.value || 0); });
            document.getElementById('trTotalKg').textContent = total.toFixed(3);
        }
        // CORRECCIÓN: antes, al quitar un renglón, el total sumaba las CAJAS en lugar de los kg.
        function recalcularTotalTransferencia() { recalcTrTotal(); }

        function bindTrCajasKgSync() {
            $(document).off('input.trsync', '#trProductos .tr-cajas');
            $(document).off('input.trsync', '#trProductos .tr-kg');
            $(document).on('input.trsync', '#trProductos .tr-cajas', function () {
                const $tr = $(this).closest('tr');
                const factor = Number($tr.data('kg-por-caja')) || 0;
                if (factor > 0) $tr.find('.tr-kg').val((Math.max(0, Number(this.value || 0)) * factor).toFixed(3));
                recalcTrTotal();
            });
            $(document).on('input.trsync', '#trProductos .tr-kg', function () {
                const $tr = $(this).closest('tr');
                const factor = Number($tr.data('kg-por-caja')) || 0;
                if (factor > 0) $tr.find('.tr-cajas').val(Math.round(Math.max(0, Number(this.value || 0)) / factor));
                recalcTrTotal();
            });
        }

        $(document).on('click', '#trProductos .btn-tr-sustituir', function () {
            const idx = Number($(this).data('idx'));
            if (Number.isFinite(idx)) abrirSkuSwap(idx);
        });
        $(document).on('click', '.btn-tr-eliminar', function () {
            if (!confirm('¿Quitar este producto de la transferencia? Se aplica al guardar.')) return;
            $(this).closest('tr').remove();
            recalcularTotalTransferencia();
        });

        let guardandoTr = false;
        document.getElementById('btnGuardarTransferencia')?.addEventListener('click', async function () {
            if (guardandoTr) return; // CORRECCIÓN: evita doble envío
            const items = [];
            document.querySelectorAll('#trProductos tbody tr[data-idx]').forEach(tr => {
                items.push({
                    detalleId: Number(tr.dataset.detalleId || 0),
                    sku: tr.querySelector('.tr-sku')?.value ?? '',
                    cajas: Number(tr.querySelector('.tr-cajas')?.value ?? 0),
                    kg: Number(tr.querySelector('.tr-kg')?.value ?? 0)
                });
            });
            const token = _tokenAF();
            const btn = this, original = btn.innerHTML;
            guardandoTr = true;
            btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Guardando…';
            try {
                const resp = await fetch('/Transferencias/GuardarTransferencia', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', ...(token ? { 'RequestVerificationToken': token } : {}) },
                    body: JSON.stringify({ id: window.__trId, items })
                });
                if (!resp.ok) {
                    const txt = await resp.text().catch(() => '');
                    alert(txt || 'No se pudo guardar la transferencia.');
                    return;
                }
                _modal('trModal').hide();
                cargarTransferencias();
            } catch (e) {
                console.error(e);
                alert('Error de red al guardar la transferencia.');
            } finally {
                guardandoTr = false;
                btn.disabled = false; btn.innerHTML = original;
            }
        });

        /* ===== Almacenes para el informe (selección múltiple) ===== */
        let almacenesInvCargados = false;
        let almacenesInvData = [];            // [{value, text}]
        let almacenesInvSelected = new Set(); // values seleccionados

        function _debounceLite(fn, ms = 200) {
            let t;
            return function (...args) { const ctx = this; clearTimeout(t); t = setTimeout(() => fn.apply(ctx, args), ms); };
        }
        function getAlmacenesSeleccionadosInv() { return [...almacenesInvSelected]; }

        function _normTxt(s) { return (s ?? '').toString().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/\s+/g, ' ').trim().toLowerCase(); }
        function _matchTokens(haystack, query) {
            const h = _normTxt(haystack), q = _normTxt(query);
            if (!q) return true;
            return q.split(' ').filter(Boolean).every(t => h.includes(t));
        }
        function _levenshtein(a, b) {
            a = _normTxt(a); b = _normTxt(b);
            const n = a.length, m = b.length;
            if (n === 0) return m; if (m === 0) return n;
            let prev = new Array(m + 1), cur = new Array(m + 1);
            for (let j = 0; j <= m; j++) prev[j] = j;
            for (let i = 1; i <= n; i++) {
                cur[0] = i;
                const ca = a.charCodeAt(i - 1);
                for (let j = 1; j <= m; j++) {
                    const cost = (ca === b.charCodeAt(j - 1)) ? 0 : 1;
                    cur[j] = Math.min(prev[j] + 1, cur[j - 1] + 1, prev[j - 1] + cost);
                }
                const tmp = prev; prev = cur; cur = tmp;
            }
            return prev[m];
        }
        function _similarity(a, b) { a = _normTxt(a); b = _normTxt(b); return 1 - (_levenshtein(a, b) / Math.max(a.length, b.length, 1)); }
        function _fuzzyScore(haystack, query) {
            const h = _normTxt(haystack), q = _normTxt(query);
            if (!q) return 0;
            let best = _similarity(h, q);
            const parts = h.split(' ').filter(Boolean);
            for (const p of parts) best = Math.max(best, _similarity(p, q));
            if (h.includes(q)) best = Math.max(best, 0.92);
            const qTokens = q.split(' ').filter(Boolean);
            if (qTokens.length > 1) {
                let sum = 0;
                for (const t of qTokens) {
                    let bt = _similarity(h, t);
                    for (const p of parts) bt = Math.max(bt, _similarity(p, t));
                    if (h.includes(t)) bt = Math.max(bt, 0.92);
                    sum += bt;
                }
                best = Math.max(best, sum / qTokens.length);
            }
            return best;
        }

        function renderAlmacenesInvDropdown(filterText = '') {
            const cont = document.getElementById('lstAlmInv');
            if (!cont) return;
            const qNorm = _normTxt(filterText || '');
            let list = !qNorm ? almacenesInvData : almacenesInvData.filter(x => _matchTokens(`${x.text} ${x.value}`, qNorm));
            let header = '';
            if (qNorm && list.length === 0) {
                const ranked = almacenesInvData
                    .map(x => ({ x, score: _fuzzyScore(`${x.text} ${x.value}`, qNorm) }))
                    .filter(r => r.score >= 0.45)
                    .sort((a, b) => b.score - a.score)
                    .slice(0, 25)
                    .map(r => r.x);
                if (ranked.length) { list = ranked; header = `<div class="text-muted small px-2 pt-2">Resultados similares</div>`; }
            }
            if (!list.length) { cont.innerHTML = `<div class="text-muted small p-2">Sin resultados.</div>`; return; }
            cont.innerHTML = header + list.map(x => {
                const v = String(x.value);
                return `<label class="alm-multi-item"><input type="checkbox" class="form-check-input alm-inv-chk" value="${esc(v)}" ${almacenesInvSelected.has(v) ? 'checked' : ''}><span>${esc(x.text)}</span></label>`;
            }).join('');
        }

        function updateBtnAlmInvText() {
            const btn = document.getElementById('btnAlmInvMulti');
            if (!btn) return;
            const n = almacenesInvSelected.size;
            btn.textContent = n === 0 ? 'Selecciona almacenes...' : (n === 1 ? `${[...almacenesInvSelected][0]}` : `${n} seleccionados`);
        }

        async function cargarAlmacenesInvDesdeSigo() {
            if (almacenesInvCargados) return;
            const cont = document.getElementById('lstAlmInv');
            if (cont) cont.innerHTML = `<div class="text-muted small p-2">Cargando…</div>`;
            try {
                const res = await fetch('/Comercial/AlmacenesInventario', { cache: 'no-store' });
                if (!res.ok) throw new Error('HTTP ' + res.status);
                const data = await res.json();
                almacenesInvData = (Array.isArray(data) ? data : []).map(a => {
                    const value = (a.almacenId ?? a.AlmacenId ?? a.value ?? a.Value ?? '').toString().trim();
                    const text = (a.almacen ?? a.Almacen ?? a.label ?? a.Label ?? value).toString().trim();
                    return value ? { value, text } : null;
                }).filter(Boolean);
                almacenesInvCargados = true;
                renderAlmacenesInvDropdown('');
                updateBtnAlmInvText();
            } catch (e) {
                console.error('AlmacenesInventario:', e);
                almacenesInvCargados = false;
                if (cont) cont.innerHTML = `<div class="text-danger small p-2">No se pudieron cargar los almacenes.</div>`;
            }
        }

        window.getAlmacenesSeleccionadosInv = getAlmacenesSeleccionadosInv;
        window.renderAlmacenesInvDropdown = renderAlmacenesInvDropdown;

        $(document).on('change', '.alm-inv-chk', function () {
            const val = (this.value || '').toString().trim();
            if (!val) return;
            if (this.checked) almacenesInvSelected.add(val); else almacenesInvSelected.delete(val);
            updateBtnAlmInvText();
        });
        $(document).on('input', '#txtAlmInvSearch', _debounceLite(function () { renderAlmacenesInvDropdown(this.value); }, 150));
        $(document).on('click', '#btnAlmInvClear', function () {
            almacenesInvSelected.clear();
            $('#txtAlmInvSearch').val('');
            renderAlmacenesInvDropdown('');
            updateBtnAlmInvText();
        });
        $(document).on('click', '#btnAlmInvApply', function () {
            updateBtnAlmInvText();
            const btn = document.getElementById('btnAlmInvMulti');
            if (btn && window.bootstrap) bootstrap.Dropdown.getOrCreateInstance(btn).hide();
        });

        /* ===== Inicio ===== */
        $(function () {
            setRangoEntregaDefault();
            mostrarVista(vistaActual);

            $('#txtBuscar').on('input', debounce(() => renderPedidos(), 250));
            $('#fConsecutivo,#fCliente,#fVendedor').on('input change', debounce(() => renderPedidos(), 150));
            $('#fEntregaD,#fEntregaH').on('input change', debounce(() => {
                actualizarHintRango();
                renderPedidos();
                if ($('#panelDemandaDetalle').is(':visible')) cargarDemandaDetalle();
            }, 150));

            $('#btnAlmInvMulti').on('shown.bs.dropdown', async function () {
                await cargarAlmacenesInvDesdeSigo();
                renderAlmacenesInvDropdown($('#txtAlmInvSearch').val() || '');
                updateBtnAlmInvText();
            });

            $('#btnLimpiarFiltros').on('click', function () {
                $('#fConsecutivo,#fCliente,#fVendedor').val('');
                setRangoEntregaDefault(); // no borra fechas: anteayer y hoy
                renderPedidos();
            });

            // Barra rápida
            $(document).on('click', '#btnAlmTodos', () => aplicarAlmacen({ soloVacios: false }));
            $(document).on('click', '#btnAlmVacios', () => aplicarAlmacen({ soloVacios: true }));
            $(document).on('click', '#btnCajasTodos', () => aplicarCajas({ soloVacios: false }));
            $(document).on('click', '#btnCajasVacios', () => aplicarCajas({ soloVacios: true }));
            $(document).on('change', '#ovAlmacen', function () { const qb = document.getElementById('ovAlmacenDefault'); if (qb) qb.value = (this.value || ''); });
            bindQuickShortcuts();

            // Pestañas
            $('#tabPendientes').on('click', () => mostrarVista('pendientes'));
            $('#tabCompletados').on('click', () => mostrarVista('completados'));
            $('#tabTransferencias').on('click', () => mostrarVista('transferencias'));
            $('#tabDemandaDetalle').on('click', () => mostrarVista('demandaDetalle'));
            $('#btnRefrescarTransferencias').on('click', cargarTransferencias);

            // Abrir orden (botón antiguo, se conserva)
            $(document).on('click', '.btn-abrir-ov', function (e) {
                e.preventDefault();
                const raw = this.getAttribute('data-id');
                if (raw === null || raw === '') { alert('No se pudo abrir este pedido (id vacío). Consecutivo: ' + (this.getAttribute('data-cons') || '—')); return; }
                abrirOrdenVentaModal(raw);
            });

            // Administrar y enviar (flujo rápido)
            $(document).on('click', '.btn-flujo-ov', async function (e) {
                e.preventDefault();
                const btn = this;
                const raw = btn.getAttribute('data-id');
                if (raw === null || raw === '') { alert('No se pudo abrir este pedido (id vacío). Consecutivo: ' + (btn.getAttribute('data-cons') || '—')); return; }
                if (btn.dataset.loading === '1') return;
                const htmlOriginal = btn.innerHTML;
                btn.dataset.loading = '1';
                btn.disabled = true;
                btn.innerHTML = `<span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span> Abriendo…`;
                try {
                    flujoRapidoActivo = true;
                    await abrirOrdenVentaModal(raw);
                } finally {
                    btn.dataset.loading = '0';
                    btn.disabled = false;
                    btn.innerHTML = htmlOriginal;
                }
            });

            $(document).on('click', '.btn-preview-ov', function () {
                const id = this.getAttribute('data-id');
                if (id === null || id === '') return;
                abrirVistaPrevia(id);
            });
            $(document).on('click', '.btn-subpedidos', function () {
                const raw = this.getAttribute('data-id');
                if (raw === null || raw === '') { alert('No se pudo abrir subpedidos (id vacío).'); return; }
                abrirSubpedidosPorOrden(raw);
            });

            $('#btnMostrarAgregar').on('click', function () {
                if (ovSoloLectura) return;
                const row = document.getElementById('rowAgregar');
                row.style.display = row.style.display === 'none' ? 'block' : 'none';
            });
            $('#btnCancelarAgregar').on('click', function () { document.getElementById('rowAgregar').style.display = 'none'; limpiarFormAgregar(); });
            $('#btnAgregarProducto').on('click', function () {
                if (ovSoloLectura) return;
                const v = validarAgregarForm();
                if (!v.ok) { alert(v.msg); return; }
                ovState.productos.push(v.data);
                renderProductosTabla();
                limpiarFormAgregar();
                document.getElementById('rowAgregar').style.display = 'none';
            });

            $('#btnGuardarProductos').on('click', guardarCambiosProductos);
            $('#btnPdfPreview').on('click', generarPDFPreview);
            $('#btnSubpedidosPreview').on('click', abrirSubpedidosPreview);
            $('#btnGenerarSubpedidos').on('click', generarSubpedidos);

            // Cancelar orden de venta (POST /Comercial/CancelarOV?id=...)
            $(document).on('click', '.btn-cancel-ov', async function () {
                const btn = this;
                const ordenId = btn.getAttribute('data-id');
                const consecutivo = (btn.getAttribute('data-cons') || '').toString().trim();
                if (!ordenId || Number(ordenId) <= 0) { alert('No se encontró el Id de la orden.'); return; }
                if (!confirm(`¿Seguro que deseas cancelar la orden ${consecutivo || ordenId}?\n\nTambién se intentarán cancelar sus documentos en SAP y MEAT.`)) return;

                const token = _tokenAF();
                const textoOriginal = btn.innerHTML;
                try {
                    btn.disabled = true;
                    btn.innerHTML = `<span class="spinner-border spinner-border-sm me-1" aria-hidden="true"></span> Cancelando…`;
                    const resp = await fetch(`/Comercial/CancelarOV?id=${encodeURIComponent(ordenId)}`, {
                        method: 'POST',
                        headers: { 'Accept': 'application/json', ...(token ? { 'RequestVerificationToken': token } : {}) }
                    });
                    const raw = await resp.text();
                    let json = {}; try { json = raw ? JSON.parse(raw) : {}; } catch { }

                    if (resp.status === 409) { alert(json.msg || 'No se puede cancelar porque ya tiene cajas escaneadas/asignadas.'); return; }
                    if (resp.status === 503) { alert(json.msg || 'No fue posible validar las cajas en MEAT. La orden no fue cancelada.'); return; }
                    if (resp.status === 404) { alert(json.msg || 'Orden no encontrada.'); return; }
                    if (resp.status === 400) { alert(json.msg || 'Solicitud inválida.'); return; }
                    if (!resp.ok || json.ok === false) { console.error('Error CancelarOV:', resp.status, raw); alert(json.msg || raw || `No fue posible cancelar la orden. HTTP ${resp.status}`); return; }

                    const idStr = String(ordenId);
                    pedidosCache = pedidosCache.filter(x => String(x.id ?? x.Id ?? x.IdOrden ?? x.idOrden ?? x.OVId ?? x.ovId) !== idStr);
                    renderPedidos();
                    setActualizadoAhora();

                    const sapOk = Number(json.docsSapCancelados || 0), sapNo = Number(json.docsSapNoCancelados || 0);
                    const meatOk = Number(json.docsMeatCancelados || 0), meatNo = Number(json.docsMeatNoCancelados || 0);
                    let mensaje = json.msg || 'Orden cancelada correctamente.';
                    if (sapOk > 0 || sapNo > 0) mensaje += `\nSAP: ${sapOk} cancelado(s), ${sapNo} no cancelado(s).`;
                    if (meatOk > 0 || meatNo > 0) mensaje += `\nMEAT: ${meatOk} cancelado(s), ${meatNo} no cancelado(s).`;
                    alert(mensaje);
                } catch (e) {
                    console.error(e);
                    alert('Error de red al cancelar la orden.');
                } finally {
                    btn.disabled = false;
                    btn.innerHTML = textoOriginal;
                }
            });
        });
    </script>
}
