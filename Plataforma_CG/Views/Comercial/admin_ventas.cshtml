@model Plataforma_CG.ViewModels.AlmacenViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Pedidos Liberados";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    /* =====================================================================
       PEDIDOS LIBERADOS · SIGO — hoja de estilos única
       Mismo sistema visual que el resto de módulos. Sustituye las ~10 capas
       anteriores (incluidas las que forzaban el ancho del layout y del body).
       ===================================================================== */
    :root {
        --es-tinto: #8d3e46;
        --es-tinto-deep: #5c2229;
        --es-tinto-soft: #f7eced;
        --es-tinto-line: #e8d3d6;
        --es-paper: #f6f4f4;
        --es-surface: #ffffff;
        --es-field: #ffffff;
        --es-field-ro: #f6f3f3;
        --es-head: #faf7f7;
        --es-hover: #fcf9f9;
        --es-row-line: #f0eaeb;
        --es-ink: #231a1c;
        --es-muted: #76686b;
        --es-line: #e6dfe0;
        --es-line-strong: #cfc4c6;
        --es-ok: #2f7a55;
        --es-ok-bg: #e7f3ec;
        --es-warn: #9a6410;
        --es-warn-bg: #fbf1de;
        --es-bad: #b42d2d;
        --es-bad-bg: #fbe9e8;
        --es-info: #2f5d86;
        --es-info-bg: #e9f0f7;
        --es-neutral-bg: #efecec;
        --es-font: "Poppins", "Segoe UI", system-ui, -apple-system, Arial, sans-serif;
        --es-mono: ui-monospace, "Cascadia Mono", Consolas, monospace;
    }

    body[data-theme="dark"] {
        --es-tinto: #c56b74;
        --es-tinto-deep: #7a2d36;
        --es-tinto-soft: #3a2427;
        --es-tinto-line: #5a3439;
        --es-paper: #16181c;
        --es-surface: #202328;
        --es-field: #181a1e;
        --es-field-ro: #262a30;
        --es-head: #262a30;
        --es-hover: #2a2e34;
        --es-row-line: #30343b;
        --es-ink: #edf0f3;
        --es-muted: #a9b0b9;
        --es-line: #363b43;
        --es-line-strong: #4a5059;
        --es-ok: #6cc596;
        --es-ok-bg: #1d3328;
        --es-warn: #e0b061;
        --es-warn-bg: #3a2f1b;
        --es-bad: #f08a83;
        --es-bad-bg: #3d2223;
        --es-info: #8bb8e0;
        --es-info-bg: #1e2b38;
        --es-neutral-bg: #2c3036;
    }

    .layout-main-content { min-width: 0 !important; }

    .plx, .plx-modal { font-family: var(--es-font) !important; color: var(--es-ink); font-size: 13px; line-height: 1.4; }
    .plx *, .plx-modal * { box-sizing: border-box; }
    .plx .bi, .plx-modal .bi { font-family: "bootstrap-icons" !important; }
    .plx { background: var(--es-paper); padding: 16px 18px 10px; min-width: 0; }
    .es-muted, .plx .text-muted, .plx-modal .text-muted { color: var(--es-muted) !important; }
    .text-end.num, .num { font-variant-numeric: tabular-nums; }

    /* ---------- Encabezado ---------- */
    .pl-header { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; margin-bottom: 14px; }
    .pl-header__title { display: flex; align-items: center; gap: 12px; }
    .pl-header__icon { width: 40px; height: 40px; border-radius: 10px; display: grid; place-items: center; background: var(--es-tinto); color: #fff; font-size: 19px; }
    .pl-header h1 { margin: 0; font-size: 20px; font-weight: 700; letter-spacing: -.01em; line-height: 1.15; color: var(--es-ink); }
    .pl-header p { margin: 2px 0 0; font-size: 12px; color: var(--es-muted); }
    .pl-chips { display: flex; gap: 8px; flex-wrap: wrap; }
    .sap-chip { display: inline-flex; align-items: center; gap: 6px; height: 30px; padding: 0 12px; border-radius: 999px; background: var(--es-surface); border: 1px solid var(--es-line); font-size: 12.5px; font-weight: 600; color: var(--es-ink); font-variant-numeric: tabular-nums; }
    .sap-chip .badge { font-size: 11px; font-weight: 600; border-radius: 999px; }
    .sap-chip-danger { background: var(--es-bad-bg); border-color: transparent; color: var(--es-bad); }
    .sap-chip-warn { background: var(--es-warn-bg); border-color: transparent; color: var(--es-warn); }
    .sap-chip-muted { background: var(--es-neutral-bg); border-color: transparent; color: var(--es-muted); }

    /* ---------- Botones (Bootstrap acotado a la vista) ---------- */
    .plx .btn, .plx-modal .btn, .btn-round {
        display: inline-flex; align-items: center; justify-content: center; gap: 6px;
        height: 34px; padding: 0 12px; border: 1px solid var(--es-line-strong); border-radius: 7px;
        background: var(--es-field); color: var(--es-ink); font: 600 12.5px/1 var(--es-font);
        white-space: nowrap; box-shadow: none; transition: background .12s, border-color .12s, color .12s;
    }
    .plx .btn:hover, .plx-modal .btn:hover, .btn-round:hover { background: var(--es-tinto-soft); border-color: var(--es-tinto-line); color: var(--es-ink); }
    .plx .btn:focus-visible, .plx-modal .btn:focus-visible { outline: 2px solid var(--es-tinto); outline-offset: 2px; box-shadow: none; }
    .plx .btn:disabled, .plx-modal .btn:disabled { opacity: .5; }
    .plx .btn-sm, .plx-modal .btn-sm { height: 30px; padding: 0 10px; font-size: 12px; border-radius: 6px; }
    .plx .btn-danger, .plx-modal .btn-danger, .plx .btn-primary, .plx-modal .btn-primary, .btn-exec-red, .btn-round.primary { background: var(--es-tinto); border-color: var(--es-tinto); color: #fff; }
    .plx .btn-danger:hover, .plx-modal .btn-danger:hover, .plx .btn-primary:hover, .plx-modal .btn-primary:hover, .btn-exec-red:hover { background: var(--es-tinto-deep); border-color: var(--es-tinto-deep); color: #fff; }
    .plx .btn-success, .plx-modal .btn-success { background: var(--es-ok); border-color: var(--es-ok); color: #fff; }
    .plx .btn-success:hover, .plx-modal .btn-success:hover { filter: brightness(.92); background: var(--es-ok); color: #fff; }
    .plx-modal .btn-warning { background: var(--es-warn-bg); border-color: var(--es-warn); color: var(--es-warn); }
    .plx-modal .btn-warning:hover { background: var(--es-warn); color: #fff; }
    .plx .btn-outline-danger, .plx-modal .btn-outline-danger, .btn-exec-red-outline { color: var(--es-bad); border-color: var(--es-line-strong); background: var(--es-field); }
    .plx .btn-outline-danger:hover, .plx-modal .btn-outline-danger:hover, .btn-exec-red-outline:hover { background: var(--es-bad-bg); border-color: var(--es-bad); color: var(--es-bad); }
    .plx-modal .btn-outline-success { color: var(--es-ok); }
    .plx .btn-group, .plx-modal .btn-group { gap: 4px; }
    .plx .btn-group > .btn, .plx-modal .btn-group > .btn { border-radius: 6px !important; margin: 0 !important; }

    /* ---------- Filtros ---------- */
    .pl-card { background: var(--es-surface); border: 1px solid var(--es-line); border-radius: 10px; min-width: 0; }
    .pl-filters { padding: 12px 14px; margin-bottom: 12px; }
    .sap-filterbar-top { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .segmented { display: inline-flex; gap: 2px; padding: 3px; border-radius: 9px; background: var(--es-neutral-bg); }
    .segmented button { height: 32px; padding: 0 14px; border: 0; border-radius: 7px; background: transparent; color: var(--es-muted); font: 600 12.5px/1 var(--es-font); cursor: pointer; white-space: nowrap; }
    .segmented button:hover { color: var(--es-ink); }
    .segmented button.active { background: var(--es-surface); color: var(--es-ink); box-shadow: 0 1px 3px rgba(0,0,0,.12); }
    .segmented button:focus-visible { outline: 2px solid var(--es-tinto); outline-offset: 1px; }
    .sap-search { position: relative; flex: 1 1 300px; min-width: 220px; }
    .sap-search i { position: absolute; left: 11px; top: 50%; transform: translateY(-50%); color: var(--es-muted); font-size: 13px; pointer-events: none; }
    .plx #txtBuscar { padding-left: 32px; }
    .sap-filterbar-base { display: grid; grid-template-columns: 120px minmax(160px, 1.4fr) minmax(140px, 1.1fr) 150px 150px auto; gap: 10px; align-items: end; margin-top: 12px; }
    .sap-field label, .plx .form-label, .plx-modal .form-label { display: block; margin: 0 0 5px; font-size: 12px; font-weight: 600; color: var(--es-muted); }
    .plx .form-control, .plx .form-select, .plx-modal .form-control, .plx-modal .form-select {
        height: 34px; min-height: 34px; padding: 0 10px; border: 1px solid var(--es-line-strong); border-radius: 7px;
        background-color: var(--es-field); color: var(--es-ink); font: 500 13px/1.2 var(--es-font); box-shadow: none;
    }
    .plx .form-select, .plx-modal .form-select { padding-right: 28px; }
    .plx .form-control-sm, .plx .form-select-sm, .plx-modal .form-control-sm, .plx-modal .form-select-sm { height: 30px; min-height: 30px; font-size: 12.5px; padding: 0 8px; }
    .plx-modal textarea.form-control { height: auto; padding: 8px 10px; line-height: 1.45; resize: vertical; }
    .plx .form-control:focus, .plx .form-select:focus, .plx-modal .form-control:focus, .plx-modal .form-select:focus { border-color: var(--es-tinto); box-shadow: 0 0 0 3px rgba(141,62,70,.16); outline: none; background-color: var(--es-field); color: var(--es-ink); }
    .plx-modal .form-control:disabled, .plx-modal .form-control[readonly] { background: var(--es-field-ro); color: var(--es-ink); opacity: 1; }
    body[data-theme="dark"] .plx .form-control, body[data-theme="dark"] .plx .form-select, body[data-theme="dark"] .plx-modal .form-control, body[data-theme="dark"] .plx-modal .form-select { color-scheme: dark; }
    .plx-modal .form-text { font-size: 11px; color: var(--es-muted); margin-top: 3px; }

    .pl-range-hint { display: flex; align-items: center; gap: 8px; margin-top: 10px; padding: 7px 10px; border-radius: 7px; background: var(--es-info-bg); color: var(--es-info); font-size: 12px; }
    .sap-filterbar-more { display: flex; align-items: flex-end; gap: 16px; flex-wrap: wrap; margin-top: 12px; padding-top: 12px; border-top: 1px dashed var(--es-line-strong); }
    .sap-legend { display: flex; align-items: center; gap: 14px; font-size: 12px; color: var(--es-muted); }
    .dot { width: 10px; height: 10px; border-radius: 3px; display: inline-block; vertical-align: -1px; margin-right: 4px; }
    .dot.red { background: var(--es-bad-bg); box-shadow: inset 3px 0 0 var(--es-bad); }
    .dot.yellow { background: var(--es-warn-bg); box-shadow: inset 3px 0 0 var(--es-warn); }
    .alm-multi-menu { width: 330px; max-width: 92vw; padding: 8px !important; border: 1px solid var(--es-line-strong) !important; border-radius: 8px !important; background: var(--es-surface) !important; box-shadow: 0 10px 28px rgba(0,0,0,.15); }
    .alm-multi-list { max-height: 240px; overflow: auto; padding: 4px; border: 1px solid var(--es-line); border-radius: 6px; }
    .alm-multi-item { display: flex; align-items: center; gap: 8px; padding: 6px 8px; border-radius: 5px; font-size: 12.5px; cursor: pointer; }
    .alm-multi-item:hover { background: var(--es-tinto-soft); }
    .alm-multi-item input { margin: 0; accent-color: var(--es-tinto); }
    #btnAlmInvMulti { min-width: 300px; text-align: left; }

    /* ---------- Paneles y tablas ---------- */
    .panel { background: var(--es-surface); border: 1px solid var(--es-line); border-radius: 10px; margin-bottom: 12px; overflow: hidden; min-width: 0; }
    .panel-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; padding: 10px 14px; border-bottom: 1px solid var(--es-line); font-size: 14px; font-weight: 600; color: var(--es-ink); background: var(--es-surface); }
    .panel-head i { color: var(--es-tinto); }
    .panel-head .small { font-size: 11.5px; font-weight: 500; }
    .table-responsive-sticky { overflow-x: auto; overflow-y: visible; }
    .plx-modal .table-responsive-sticky { overflow: auto; max-height: 55vh; border: 1px solid var(--es-line); border-radius: 8px; }
    .plx .sapmm-grid, .plx-modal .sapmm-grid {
        width: 100%; margin: 0; border-collapse: separate; border-spacing: 0; font-size: 12.5px; color: var(--es-ink);
        --bs-table-bg: transparent; --bs-table-color: var(--es-ink); --bs-table-striped-bg: transparent; --bs-table-hover-bg: transparent; --bs-table-border-color: transparent;
    }
    .plx .sapmm-grid > :not(caption) > * > *, .plx-modal .sapmm-grid > :not(caption) > * > * { border-width: 0; box-shadow: none; }
    .plx .sapmm-grid thead th, .plx-modal .sapmm-grid thead th { position: sticky; top: 0; z-index: 2; padding: 9px 10px; background: var(--es-head); border-bottom: 1px solid var(--es-line); color: var(--es-muted); font-size: 11.5px; font-weight: 600; white-space: nowrap; text-transform: none; }
    .plx .sapmm-grid tbody td, .plx-modal .sapmm-grid tbody td { padding: 7px 10px; border-bottom: 1px solid var(--es-row-line); background: var(--es-surface); color: var(--es-ink); vertical-align: middle; }
    .plx .sapmm-grid tbody tr:hover > td, .plx-modal .sapmm-grid tbody tr:hover > td { background: var(--es-hover); }
    .plx-modal .sapmm-grid tfoot th { padding: 8px 10px; background: var(--es-head); border-top: 1px solid var(--es-line); font-variant-numeric: tabular-nums; }
    .plx .sapmm-grid tbody tr.table-danger > td, .plx-modal .sapmm-grid tbody tr.table-danger > td { background: var(--es-bad-bg); }
    .plx .sapmm-grid tbody tr.table-warning > td { background: var(--es-warn-bg); }
    .plx .sapmm-grid tbody tr.table-danger > td:first-child, .plx-modal .sapmm-grid tbody tr.table-danger > td:first-child { box-shadow: inset 3px 0 0 var(--es-bad); }
    .plx .sapmm-grid tbody tr.table-warning > td:first-child { box-shadow: inset 3px 0 0 var(--es-warn); }
    .plx-modal .sapmm-grid tbody tr.table-secondary > td { color: var(--es-muted); background: var(--es-neutral-bg); }
    .plx .empty, .plx-modal .empty { padding: 30px 12px !important; text-align: center; color: var(--es-muted) !important; white-space: normal; }
    .plx .empty.text-danger { color: var(--es-bad) !important; }

    #panelPedidos .sapmm-grid { min-width: 1150px; table-layout: fixed; }
    #panelPedidos td { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    #panelPedidos td.t-cons { font-weight: 600; font-variant-numeric: tabular-nums; }
    #panelTransferencias .sapmm-grid { min-width: 860px; table-layout: fixed; }
    #panelTransferencias td { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    #panelDemandaInv .sapmm-grid, #panelDemandaDetalle .sapmm-grid { min-width: 900px; }
    th.actions-col { width: 320px; }
    td.actions-cell { white-space: nowrap; }
    td.actions-cell > .btn + .btn { margin-left: 4px; }
    .badge-present { display: inline-flex; align-items: center; height: 22px; padding: 0 9px; border-radius: 999px; background: var(--es-neutral-bg); color: var(--es-ink); font-size: 11.5px; font-weight: 500; }
    #accionesInforme { margin: 0 0 12px; }

    .statusbar { display: flex; gap: 18px; flex-wrap: wrap; padding: 4px 2px 0; font-size: 11.5px; color: var(--es-muted); }

    /* ---------- Modales ---------- */
    .plx-modal.modal-content { border: 0; border-radius: 12px; overflow: hidden; background: var(--es-surface); box-shadow: 0 18px 50px rgba(35,26,28,.25); }
    .plx-modal .modal-header { padding: 13px 18px; background: var(--es-tinto-deep); color: #fff; border-bottom: 0; }
    .plx-modal .modal-title { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; font-size: 15px; font-weight: 600; color: #fff; }
    .plx-modal .modal-title small, .plx-modal .modal-header .text-muted { color: rgba(255,255,255,.75) !important; font-weight: 500; font-size: 13px; }
    .plx-modal .btn-close { filter: invert(1) grayscale(1) brightness(2); opacity: .9; }
    .plx-modal .modal-body { background: var(--es-paper); padding: 14px 16px; }
    .plx-modal .modal-footer { background: var(--es-head); border-top: 1px solid var(--es-line); gap: 8px; }
    .plx-modal .modal-body .panel-head { border: 1px solid var(--es-line); border-radius: 8px; padding: 7px 12px; font-size: 13px; }
    .pl-msection { background: var(--es-surface); border: 1px solid var(--es-line); border-radius: 10px; padding: 12px 14px; margin-bottom: 12px; }
    .pl-msection__title { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; margin: 0 0 10px; font-size: 13.5px; font-weight: 600; }
    .ov-done-badge { display: inline-flex; align-items: center; gap: 5px; height: 24px; padding: 0 10px; border-radius: 999px; background: var(--es-ok-bg); color: var(--es-ok); font-size: 11.5px; font-weight: 600; }
    #ovQuickBar { padding: 10px 12px; border-radius: 8px; background: var(--es-info-bg); margin-bottom: 10px; }
    #ovQuickBar .form-label { color: var(--es-info); }
    #ovQuickBar .small { color: var(--es-info) !important; }
    #rowAgregar { padding: 10px 12px; border-radius: 8px; background: var(--es-warn-bg); margin-bottom: 10px; }
    #ovProductos .inp-cajas { width: 90px; text-align: right; font-variant-numeric: tabular-nums; font-weight: 600; }
    #ovProductos .sel-almacen { min-width: 150px; }
    #ovProductos .form-text { margin-top: 2px; }
    #trProductos .tr-cajas, #trProductos .tr-kg { width: 110px; margin-left: auto; text-align: right; font-variant-numeric: tabular-nums; }
    #trProductos .tr-sku { width: 110px; }
    #ovModal .modal-dialog, #ovPreviewModal .modal-dialog, #subpedidosModal .modal-dialog, #subpedidoDetalleModal .modal-dialog, #trModal .modal-dialog { max-width: min(1400px, 96vw); }
    #skuSwapModal .modal-dialog { max-width: min(760px, 94vw); }
    .pl-sp-totals { display: flex; gap: 16px; flex-wrap: wrap; margin-left: auto; font-size: 12px; color: var(--es-muted); }
    .pl-sp-totals b { color: var(--es-ink); font-variant-numeric: tabular-nums; }

    @@media (max-width: 1200px) { .sap-filterbar-base { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
    @@media (max-width: 700px) {
        .plx { padding: 10px; }
        .sap-filterbar-base { grid-template-columns: 1fr 1fr; }
        .segmented { width: 100%; overflow-x: auto; }
        #btnAlmInvMulti { min-width: 0; width: 100%; }
    }
</style>

<div class="plx pedidos-liberados-app">

    <header class="pl-header">
        <div class="pl-header__title">
            <span class="pl-header__icon"><i class="bi bi-clipboard-check"></i></span>
            <div>
                <h1>Administración de pedidos</h1>
                <p>Revisa los pedidos liberados, asigna almacén por renglón, guarda y genera los subpedidos para SAP.</p>
            </div>
        </div>
        <div class="pl-chips sap-ph-right">
            <span class="sap-chip" id="chipConteo"><i class="bi bi-list-ol"></i> 0 pedidos</span>
            <span class="sap-chip sap-chip-danger" id="chipUrgentes" style="display:none;"><i class="bi bi-exclamation-triangle"></i> 0 urgentes</span>
            <span class="sap-chip sap-chip-warn" id="chip2dias" style="display:none;"><i class="bi bi-clock"></i> 0 ≤2 días</span>
            <span class="sap-chip sap-chip-muted" id="chipVencidos" style="display:none;"><i class="bi bi-hourglass-bottom"></i> 0 vencidos</span>
        </div>
    </header>

    <!-- Filtros -->
    <div class="pl-card pl-filters sapmm-skin">
        <div class="sap-filterbar">
            <div class="sap-filterbar-top">
                <div class="segmented sapmm-tabs" role="tablist" aria-label="Vista">
                    <button class="active" id="tabPendientes" type="button" role="tab">Pendientes</button>
                    <button id="tabCompletados" type="button" role="tab">Completados</button>
                    <button id="tabTransferencias" type="button" role="tab">Transferencias</button>
                    <button id="tabDemandaDetalle" type="button" role="tab">Informe</button>
                </div>
                <div class="sap-search">
                    <i class="bi bi-search"></i>
                    <label for="txtBuscar" class="visually-hidden">Buscar</label>
                    <input type="search" id="txtBuscar" class="form-control" placeholder="Cliente, vendedor, observación o consecutivo">
                </div>
                <button class="btn btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#fbMore" aria-expanded="false" aria-controls="fbMore">
                    <i class="bi bi-funnel"></i> Almacenes y leyenda
                </button>
            </div>

            <div class="sap-filterbar-base">
                <div class="sap-field">
                    <label for="fConsecutivo">Consecutivo</label>
                    <input id="fConsecutivo" class="form-control form-control-sm" placeholder="OV-00001" />
                </div>
                <div class="sap-field">
                    <label for="fCliente">Cliente</label>
                    <input id="fCliente" class="form-control form-control-sm" placeholder="Nombre o código" />
                </div>
                <div class="sap-field">
                    <label for="fVendedor">Vendedor</label>
                    <input id="fVendedor" class="form-control form-control-sm" placeholder="Nombre" />
                </div>
                <div class="sap-field">
                    <label for="fEntregaD">Entrega desde</label>
                    <input type="date" id="fEntregaD" class="form-control form-control-sm" />
                </div>
                <div class="sap-field">
                    <label for="fEntregaH">Entrega hasta</label>
                    <input type="date" id="fEntregaH" class="form-control form-control-sm" />
                </div>
                <div class="sap-filterbar-actions">
                    <button id="btnLimpiarFiltros" type="button" class="btn btn-sm" title="Limpia consecutivo, cliente y vendedor, y regresa las fechas a anteayer–hoy">
                        <i class="bi bi-eraser"></i> Limpiar
                    </button>
                </div>
            </div>

            <div class="pl-range-hint" id="plRangoHint" role="status">
                <i class="bi bi-calendar-range"></i>
                <span id="plRangoHintTxt">—</span>
            </div>

            <div class="collapse" id="fbMore">
                <div class="sap-filterbar-more">
                    <div class="sap-legend">
                        <span><span class="dot red"></span>Entrega vencida</span>
                        <span><span class="dot yellow"></span>Entrega en 2 días o menos</span>
                    </div>
                    <div class="sap-field">
                        <label for="btnAlmInvMulti">Almacenes para "Demanda vs inventario"</label>
                        <div class="dropdown">
                            <button class="form-control form-control-sm dropdown-toggle" type="button" id="btnAlmInvMulti"
                                    data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                                Selecciona almacenes...
                            </button>
                            <div class="dropdown-menu alm-multi-menu" aria-labelledby="btnAlmInvMulti">
                                <input type="text" id="txtAlmInvSearch" class="form-control form-control-sm mb-2" placeholder="Buscar almacén…" autocomplete="off">
                                <div id="lstAlmInv" class="alm-multi-list"><div class="text-muted small p-2">Cargando…</div></div>
                                <div class="d-flex justify-content-between align-items-center mt-2 gap-2">
                                    <button type="button" class="btn btn-sm" id="btnAlmInvClear">Limpiar</button>
                                    <button type="button" class="btn btn-sm btn-danger" id="btnAlmInvApply">Aplicar</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Pedidos -->
    <div class="panel" id="panelPedidos">
        <div class="panel-head">
            <div class="d-flex align-items-center gap-2">
                <span><i class="bi bi-table"></i> <span id="lblPanelPedidos">Pedidos pendientes</span></span>
                <span class="text-muted small" id="lblActualizado">Actualizado: —</span>
            </div>
        </div>
        <div class="table-wrap table-responsive-sticky">
            <table class="table mb-0 sapmm-grid">
                <colgroup>
                    <col style="width:110px"><col style="width:80px"><col style="width:20%"><col style="width:14%">
                    <col style="width:100px"><col style="width:120px"><col><col style="width:330px">
                </colgroup>
                <thead>
                    <tr>
                        <th>Consecutivo</th>
                        <th>Serie</th>
                        <th>Cliente</th>
                        <th>Vendedor</th>
                        <th>Entrega</th>
                        <th>Presentación</th>
                        <th>Observación</th>
                        <th class="actions-col">Acciones</th>
                    </tr>
                </thead>
                <tbody id="pedidosBody">
                    <tr><td colspan="8" class="empty">Cargando pedidos…</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Informe: barra de acciones -->
    <div id="accionesInforme" class="d-flex align-items-center justify-content-between flex-wrap gap-2 d-none">
        <div class="d-flex align-items-center gap-2 flex-wrap">
            <button id="btnDemandaInv" type="button" class="btn btn-sm" title="Requiere elegir almacenes en 'Almacenes y leyenda'">
                <i class="bi bi-clipboard-data"></i> Demanda vs inventario
            </button>
            <button id="btnDescargarDemInv" type="button" class="btn btn-sm">
                <i class="bi bi-download"></i> Descargar CSV demanda vs inventario
            </button>
        </div>
    </div>

    <!-- Demanda vs inventario -->
    <div class="panel" id="panelDemandaInv" style="display:none;">
        <div class="panel-head"><span><i class="bi bi-clipboard-data"></i> Demanda vs inventario</span></div>
        <div class="table-wrap table-responsive-sticky">
            <table class="table mb-0 sapmm-grid">
                <thead>
                    <tr>
                        <th>SKU</th>
                        <th>Producto</th>
                        <th class="text-end">Cajas sol.</th>
                        <th class="text-end">Kg sol.</th>
                        <th class="text-end">Cajas disp.</th>
                        <th class="text-end">Kg disp.</th>
                        <th class="text-end">Cajas conf.</th>
                        <th class="text-end">Kg conf.</th>
                    </tr>
                </thead>
                <tbody id="demInvBody"><tr><td colspan="8" class="empty">—</td></tr></tbody>
            </table>
        </div>
    </div>

    <!-- Informe: detalle -->
    <div class="panel" id="panelDemandaDetalle" style="display:none;">
        <div class="panel-head">
            <span><i class="bi bi-boxes"></i> Pedidos detalle (órdenes y transferencias)</span>
            <button id="btnDescargarDemanda" type="button" class="btn btn-sm"><i class="bi bi-download"></i> Descargar CSV</button>
        </div>
        <div class="table-wrap table-responsive-sticky">
            <table class="table mb-0 sapmm-grid">
                <thead>
                    <tr>
                        <th>Origen</th>
                        <th>Cliente</th>
                        <th>Ruta</th>
                        <th>SKU</th>
                        <th>Producto</th>
                        <th class="text-end">Cajas</th>
                        <th class="text-end">Kg</th>
                        <th>Fecha embarque</th>
                    </tr>
                </thead>
                <tbody id="demDetBody"><tr><td colspan="8" class="empty">—</td></tr></tbody>
            </table>
        </div>
    </div>

    <!-- Transferencias -->
    <div class="panel" id="panelTransferencias" style="display:none;">
        <div class="panel-head">
            <div class="d-flex align-items-center gap-2">
                <span><i class="bi bi-truck"></i> Transferencias</span>
                <span class="text-muted small" id="lblTransActualizado">Actualizado: —</span>
            </div>
            <button id="btnRefrescarTransferencias" type="button" class="btn btn-sm"><i class="bi bi-arrow-clockwise"></i> Refrescar</button>
        </div>
        <div class="table-wrap table-responsive-sticky">
            <table class="table mb-0 sapmm-grid">
                <colgroup><col style="width:120px"><col style="width:80px"><col style="width:18%"><col style="width:110px"><col><col style="width:220px"></colgroup>
                <thead>
                    <tr>
                        <th>Folio</th>
                        <th>Serie</th>
                        <th>Destino</th>
                        <th>Fecha</th>
                        <th>Observación</th>
                        <th class="actions-col">Acciones</th>
                    </tr>
                </thead>
                <tbody id="transBody"><tr><td colspan="6" class="empty">Cargando transferencias…</td></tr></tbody>
            </table>
        </div>
    </div>

    <footer class="statusbar">
        <span>Usuario: @(User?.Identity?.Name ?? "")</span>
        <span>Carnes G SA de CV</span>
        <span>Módulo: Pedidos liberados</span>
    </footer>
</div>

<!-- Logo para PDF (oculto) y token antiforgery -->
<img id="pdfLogo" src="/images/logoCubo.png" alt="" style="display:none;" />
<form id="antiForgeryForm" style="display:none;">@Html.AntiForgeryToken()</form>

<!-- ══════════ MODAL: ORDEN DE VENTA (pendiente, editable) ══════════ -->
<div class="modal fade" id="ovModal" tabindex="-1" aria-hidden="true" aria-labelledby="ovModalTitle">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content plx-modal">
            <div class="modal-header">
                <h5 class="modal-title" id="ovModalTitle">
                    <i class="bi bi-receipt"></i> Orden de venta
                    <small class="ms-1" id="ovSubtitulo">—</small>
                    <span id="ovDoneBadge" style="display:none;"><span class="ov-done-badge"><i class="bi bi-check2-circle"></i> Completado</span></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">
                <div class="pl-msection">
                    <h3 class="pl-msection__title">Datos del pedido</h3>
                    <div class="row g-3">
                        <div class="col-md-3"><label class="form-label" for="ovConsecutivo">Consecutivo</label><input id="ovConsecutivo" class="form-control" disabled></div>
                        <div class="col-md-3"><label class="form-label" for="ovSerie">Serie</label><input id="ovSerie" class="form-control" disabled></div>
                        <div class="col-md-3"><label class="form-label" for="ovFechaEntrega">Fecha de entrega</label><input id="ovFechaEntrega" class="form-control" disabled></div>
                        <div class="col-md-3"><label class="form-label" for="ovFechaRegistro">Fecha de creación</label><input id="ovFechaRegistro" class="form-control" disabled></div>
                        <div class="col-md-6"><label class="form-label" for="ovCliente">Cliente</label><input id="ovCliente" class="form-control" disabled></div>
                        <div class="col-md-6"><label class="form-label" for="ovVendedor">Vendedor</label><input id="ovVendedor" class="form-control" disabled></div>
                        <div class="col-md-4"><label class="form-label" for="ovDireccion">Dirección</label><input id="ovDireccion" class="form-control" disabled></div>
                        <div class="col-md-4"><label class="form-label" for="ovPresentacion">Presentación</label><input id="ovPresentacion" class="form-control" disabled></div>
                        <div class="col-md-4"><label class="form-label" for="ovCredito">Crédito</label><input id="ovCredito" class="form-control" disabled></div>
                        <div class="col-md-3"><label class="form-label" for="ovSaldo">Saldo</label><input id="ovSaldo" class="form-control" disabled></div>
                        <div class="col-md-3"><label class="form-label" for="ovOtrosPedidos">Otros pedidos</label><input id="ovOtrosPedidos" class="form-control" disabled></div>
                        <div class="col-md-6">
                            <label class="form-label" for="ovFechaEmbarque">Fecha de embarque</label>
                            <input type="date" id="ovFechaEmbarque" class="form-control">
                            <div class="form-text">No puede ser menor a la fecha de entrega.</div>
                        </div>
                        <div class="col-12"><label class="form-label" for="ovObservacion">Observación</label><textarea id="ovObservacion" class="form-control" rows="2" disabled></textarea></div>

                        <div class="col-md-6 d-none" aria-hidden="true">
                            <label asp-for="SelectedAlmacenId" class="form-label">Almacén a surtir</label>
                            <select asp-for="SelectedAlmacenId" asp-items="Model.Almacenes" class="form-select" id="ovAlmacen">
                                <option value="">Selecciona…</option>
                            </select>
                            <span asp-validation-for="SelectedAlmacenId" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="pl-msection">
                    <div class="pl-msection__title">
                        <span>Productos</span>
                        <button type="button" class="btn btn-sm btn-success" id="btnGuardarProductos" title="También con Ctrl+S">
                            <i class="bi bi-save2"></i> Guardar cambios
                        </button>
                    </div>

                    <div id="rowAgregar" class="add-row" style="display:none;">
                        <div class="row g-2 align-items-end">
                            <div class="col-md-2"><label class="form-label" for="agSku">SKU</label><input type="text" id="agSku" class="form-control" maxlength="50"></div>
                            <div class="col-md-4"><label class="form-label" for="agNombre">Producto</label><input type="text" id="agNombre" class="form-control" maxlength="200"></div>
                            <div class="col-md-2"><label class="form-label" for="agKilos">kg</label><input type="number" step="0.001" id="agKilos" class="form-control" min="0"></div>
                            <div class="col-md-2"><label class="form-label" for="agPrecio">Precio</label><input type="number" step="0.01" id="agPrecio" class="form-control" min="0"></div>
                            <div class="col-md-2"><label class="form-label" for="agCajas">Cajas</label><input type="number" step="1" id="agCajas" class="form-control" min="0"></div>
                            <div class="col-12 d-flex justify-content-end gap-2 mt-2">
                                <button type="button" class="btn btn-sm" id="btnCancelarAgregar">Cancelar</button>
                                <button type="button" class="btn btn-sm btn-primary" id="btnAgregarProducto"><i class="bi bi-check2"></i> Agregar</button>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2 align-items-end" id="ovQuickBar">
                        <div style="min-width:240px;">
                            <label class="form-label" for="ovAlmacenDefault">Almacén default</label>
                            <select class="form-select form-select-sm" id="ovAlmacenDefault"></select>
                        </div>
                        <div style="width:130px;">
                            <label class="form-label" for="ovCajasDefault">Cajas default</label>
                            <input type="number" min="0" step="1" class="form-control form-control-sm" id="ovCajasDefault" value="1">
                        </div>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-sm" id="btnAlmTodos">Aplicar almacén a todos</button>
                            <button type="button" class="btn btn-sm" id="btnCajasTodos">Aplicar cajas a todos</button>
                        </div>
                        <div class="ms-auto small">Atajos: <b>Ctrl+S</b> guardar · <b>Enter</b> en cajas pasa al siguiente renglón</div>
                    </div>

                    <div class="table-responsive table-responsive-sticky">
                        <table class="table table-sm align-middle mb-0 sapmm-grid" id="ovProductos">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>SKU</th>
                                    <th>Producto</th>
                                    <th class="text-end">kg</th>
                                    <th class="text-end">Precio</th>
                                    <th>Cajas</th>
                                    <th>Almacén</th>
                                    <th class="text-end">Importe</th>
                                    <th style="width:120px;">Acciones</th>
                                </tr>
                            </thead>
                            <tbody><tr><td colspan="9" class="empty">—</td></tr></tbody>
                            <tfoot>
                                <tr><th colspan="7" class="text-end">Total peso (kg)</th><th id="ovTotalPeso" class="text-end">0.00</th><th></th></tr>
                                <tr><th colspan="7" class="text-end">Total importe</th><th id="ovTotalImporte" class="text-end">$0.00</th><th></th></tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn" data-bs-dismiss="modal">Cerrar</button>
                <a id="ovIrPantalla" class="btn btn-round primary d-none" href="#" target="_blank" rel="noopener"></a>
            </div>
        </div>
    </div>
</div>

<!-- ══════════ MODAL: TRANSFERENCIA ══════════ -->
<div class="modal fade" id="trModal" tabindex="-1" aria-hidden="true" aria-labelledby="trModalTitle">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content plx-modal">
            <div class="modal-header">
