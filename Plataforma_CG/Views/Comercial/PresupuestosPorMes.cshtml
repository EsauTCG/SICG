            }

            function filtrarBase() {
                const f = getFiltros();
                // Regla del reporte: solo se consideran registros con origen CEDIS o VENDEDOR.
                let res = data.filter(r => { const o = String(r._origen ?? r.origen ?? '').toUpperCase().trim(); return o === 'CEDIS' || o === 'VENDEDOR'; });
                if (f.Trimestres.length) { const m = new Set(f.Trimestres.flatMap(trimestreToMes)); res = res.filter(r => m.has(String(r._mes))); }
                if (f.Mes) res = res.filter(r => String(r._mes) === String(f.Mes));
                if (f.Anio) res = res.filter(r => String(r._anio) === String(f.Anio));
                if (f.Origenes.length) { const s = new Set(f.Origenes.map(x => String(x).toUpperCase().trim())); res = res.filter(r => s.has(String(r._origen || '').toUpperCase().trim())); }
                if (f.Canales.length) { const s = new Set(f.Canales.map(x => String(x).toUpperCase().trim())); res = res.filter(r => s.has(String(r._canal || '').toUpperCase().trim())); }
                if (f.Vendedores.length) res = res.filter(r => f.Vendedores.some(t => String(r._venNom || '').toUpperCase().includes(t) || String(r._venCod || '').toUpperCase().includes(t)));
                if (f.Masters.length) { const s = new Set(f.Masters.map(x => String(x).toUpperCase().trim())); res = res.filter(r => { const m = String(r._master ?? '').toUpperCase().trim(); return m !== '' && s.has(m); }); }
                if (f.Clasificaciones.length) { const s = new Set(f.Clasificaciones.map(x => String(x).trim())); res = res.filter(r => s.has(String(r._clasificacionId ?? '').trim())); }
                if (f.TiposSKU.length) { const s = new Set(f.TiposSKU.map(x => String(x).trim())); res = res.filter(r => s.has(String(r._tipoSkuId ?? '').trim())); }
                if (f.Skus.length) { const s = new Set(f.Skus.map(x => String(x).toUpperCase().trim())); res = res.filter(r => s.has(String(r._sku || '').toUpperCase().trim())); }
                return res;
            }

            /* ========================= Tendencias (misma regla) ========================= */
            const diasDelMes = (anio, mes) => new Date(Number(anio), Number(mes), 0).getDate();
            function diasTranscurridosVentaNoHoy(anio, mes) {
                const hoy = new Date(), y = Number(anio), m = Number(mes);
                if (hoy.getFullYear() === y && (hoy.getMonth() + 1) === m) return Math.max(0, hoy.getDate() - 1);
                if (y < hoy.getFullYear() || (y === hoy.getFullYear() && m < (hoy.getMonth() + 1))) return diasDelMes(y, m);
                return 0;
            }
            function calcTendVenta(anio, mes, ventaTotal) {
                const totalMes = diasDelMes(anio, mes), trans = diasTranscurridosVentaNoHoy(anio, mes);
                return trans > 0 ? Math.round((Math.round(Number(ventaTotal || 0)) / trans) * totalMes) : 0;
            }
            function isHolidayMX(d) {
                const y = d.getFullYear(), m = d.getMonth(), day = d.getDate();
                if ((m === 0 && day === 1) || (m === 4 && day === 1) || (m === 8 && day === 16) || (m === 11 && day === 25)) return true;
                const same = (a, b) => a.getFullYear() === b.getFullYear() && a.getMonth() === b.getMonth() && a.getDate() === b.getDate();
                const nthMonday = (year, month0, n) => { const x = new Date(year, month0, 1); while (x.getDay() !== 1) x.setDate(x.getDate() + 1); x.setDate(x.getDate() + (n - 1) * 7); return x; };
                return same(d, nthMonday(y, 1, 1)) || same(d, nthMonday(y, 2, 3)) || same(d, nthMonday(y, 10, 3));
            }
            function contarDiasRango(inicio, finIncl, { sinDom = false, sinSab = false, sinFeriadosMX = false } = {}) {
                let c = 0;
                const d = new Date(inicio.getFullYear(), inicio.getMonth(), inicio.getDate());
                const end = new Date(finIncl.getFullYear(), finIncl.getMonth(), finIncl.getDate());
                while (d <= end) { const dow = d.getDay(); if (!((sinDom && dow === 0) || (sinSab && dow === 6) || (sinFeriadosMX && isHolidayMX(d)))) c++; d.setDate(d.getDate() + 1); }
                return c;
