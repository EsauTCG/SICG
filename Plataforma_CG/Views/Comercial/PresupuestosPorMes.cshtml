                scheduleRender(0);
            }
            function getVendedorLabel(row) {
                const id = String(row._venId ?? row.vendedorId ?? row.VendedorId ?? '').trim();
                const cod = String(row._venCod ?? row.vendedorCodigo ?? row.VendedorCodigo ?? '').trim();
                const nom = String(row._venNom ?? row.vendedorNombre ?? row.VendedorNombre ?? '').trim();
                return [cod, nom].filter(Boolean).join(' - ') || (id ? `VENDEDOR ${id}` : '(Sin vendedor)');
            }
            function buildDetalleGeneric(rows, anio, mes) {
                const map = new Map();
                const esTrimestre = String(mes || '').toUpperCase().includes('QTR');
                const getOri = r => String(r._origen ?? r.origen ?? '').toUpperCase().trim();
                function meta(r) {
                    const ori = getOri(r);
                    if (ori === "VENDEDOR") { const label = getVendedorLabel(r); return { key: `VENDEDOR|${label}`, m: { origen: "VENDEDOR", label, vendedorId: r._venId ?? null, canal: null, cliente: null } }; }
                    if (ori === "CEDIS") { const canal = String(r._canal ?? r.canal ?? "").toUpperCase().trim(); return { key: `CEDIS|${canal || "CEDIS"}`, m: { origen: "CEDIS", label: canal || "CEDIS", vendedorId: null, canal: canal || null, cliente: null } }; }
                    return null; // otros orígenes se omiten
                }
                for (const r of rows) {
                    const it = meta(r); if (!it) continue;
                    if (!map.has(it.key)) map.set(it.key, { ...it.m, plan: 0, surt: 0, disp: 0, ventaReal: 0, devoluciones: 0, ped: 0, tend: 0, alc: 0 });
                    const d = map.get(it.key);
                    if (d.vendedorId == null && it.m.vendedorId != null) d.vendedorId = it.m.vendedorId;
                    if (!d.canal && it.m.canal) d.canal = it.m.canal;
                    d.plan += toNumber(r._pres); d.surt += toNumber(r._kgSurtido); d.ventaReal += toNumber(r._ventaReal); d.ped += toNumber(r._kg);
                    const skuDet = String(r._sku || '').toUpperCase().trim(), anioDet = String(anio ?? '').trim(), mesDet = String(r._mes ?? mes ?? '').trim(), ori = getOri(r);
                    let devKey = null;
                    if (ori === 'VENDEDOR') { const v = String(r._venId ?? '').trim(); devKey = v ? `VENDEDOR|${anioDet}|${mesDet}|${skuDet}|${v}` : null; }
                    else if (ori === 'CEDIS') { const c = String(r._canal ?? '').toUpperCase().trim(); devKey = c ? `CEDIS|${anioDet}|${mesDet}|${skuDet}|${c}` : null; }
                    d.devoluciones += devKey ? toNumber(devolucionesMapGlobal.get(devKey)) : 0;
                    d.tend = esTrimestre ? d.ventaReal : calcTendVenta(anio, mes, d.ventaReal); // tendencia sobre venta real neta
                }
                const out = Array.from(map.values());
                out.forEach(d => { d.disp = Math.max(0, d.plan - d.ped - d.surt); d.alc = d.plan > 0 ? (d.tend / d.plan) * 100 : 0; });
                return out.sort((a, b) => b.plan - a.plan);
            }

            function fmtFecha(v) {
                if (!v) return "";
                const m = String(v).match(/^(\d{4})-(\d{2})-(\d{2})/);
                if (m) return `${m[3]}/${m[2]}/${m[1]}`; // CORRECCIÓN: sin desfase de zona horaria
                const d = new Date(v);
