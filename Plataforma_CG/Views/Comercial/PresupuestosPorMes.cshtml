                    g._devoluciones = mesesGrupo.reduce((t, m) => t + toNumber(devolucionesMapGlobal.get(`${g.anio}|${m}|${g.sku}`)), 0);
                    g._disp = Math.max(0, g._pres - g._kg - g._kgSurtido);
                });
