            }

            /* ========================= Agrupación por SKU (misma lógica) ========================= */
            function buildGrouped(rows) {
                const f = getFiltros();
                const usandoTrimestre = f.Trimestres.length > 0;
                const trimestreCsv = f.Trimestres.join(',');
                const periodoTexto = f.Trimestres.map(t => `QTR ${t}`).join(' + ');
                const map = new Map();
                for (const r of rows) {
                    const key = usandoTrimestre ? [r._anio || '', 'T' + trimestreCsv, r._sku || ''].join('|') : [r._anio || '', r._mes || '', r._sku || ''].join('|');
                    if (!map.has(key)) map.set(key, {
                        _key: key, anio: r._anio || "", mes: usandoTrimestre ? periodoTexto : (r._mes || r.mesConsulta || ""), _mesNum: r._mes || "",
                        _trimestre: usandoTrimestre ? trimestreCsv : "", sku: r._sku || r.productoCodigo || "", producto: r._prod || r.productoNombre || "",
                        _planProd: 0, _producido: 0, _planProdMes: new Map(), _producidoMes: new Map(), _tendProd: 0, _ventaReal: 0, _devoluciones: 0,
                        _pres: 0, _kg: 0, _kgSurtido: 0, _tendencia: 0, _invIni: 0, _invAct: 0, _tendInv: 0, _variacion: 0, _rows: []
                    });
                    const g = map.get(key);
                    const pp = pickNumber(r, 'planProduccion', 'PlanProduccion', 'plan_prod', 'planProd', '_planProd');
                    const pr = pickNumber(r, 'producido', 'Producido', 'producidoReal', 'prod_real', 'prodReal', '_producido');
                    // Plan y producido vienen repetidos por cliente/origen: un solo valor por SKU + año + mes.
                    const k = `${r._anio || ''}|${r._mes || ''}|${r._sku || r.productoCodigo || ''}`;
                    g._planProdMes.set(k, Math.max(toNumber(g._planProdMes.get(k)), toNumber(pp)));
                    g._producidoMes.set(k, Math.max(toNumber(g._producidoMes.get(k)), toNumber(pr)));
                    g._pres += toNumber(r._pres); g._kg += toNumber(r._kg); g._kgSurtido += toNumber(r._kgSurtido); g._ventaReal += toNumber(r._ventaReal);
                    g._invIni = Math.max(g._invIni, toNumber(r._invIni)); g._invAct = Math.max(g._invAct, toNumber(r._invAct));
                    g._rows.push(r);
                }
                const out = Array.from(map.values());
                out.forEach(g => {
                    g._planProd = Array.from(g._planProdMes.values()).reduce((t, v) => t + toNumber(v), 0);
                    g._producido = Array.from(g._producidoMes.values()).reduce((t, v) => t + toNumber(v), 0);
                    delete g._planProdMes; delete g._producidoMes;
                    if (usandoTrimestre) { g._tendencia = g._ventaReal; g._tendProd = g._producido; }
                    else { g._tendencia = calcTendVenta(g.anio, g._mesNum, g._ventaReal); g._tendProd = calcTendProd(g.anio, g._mesNum, g._producido); }
