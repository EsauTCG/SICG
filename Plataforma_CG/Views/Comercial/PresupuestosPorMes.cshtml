            }

            const SORT_KEYS = { sku: 'sku', producto: 'producto', planprod: '_planProd', producido: '_producido', tendprod: '_tendProd', ventareal: '_ventaReal', devoluciones: '_devoluciones', alcprod: '_alcProd', presupuesto: '_pres', kg: '_kg', kgsurtido: '_kgSurtido', tendencia: '_tendencia', alcance: '_alc', invini: '_invIni', invact: '_invAct', tendinv: '_tendInv', variacion: '_variacion' };
            function ordenarDatos() {
                const { column: col, direction: dir } = state.sort;
                const key = SORT_KEYS[col];
                if (!key || !dir) return;
                view.sort((a, b) => {
                    let x = a[key], y = b[key];
                    if (typeof x === 'number' && typeof y === 'number') return dir === 'asc' ? x - y : y - x;
                    x = String(x ?? ''); y = String(y ?? '');
                    return dir === 'asc' ? x.localeCompare(y, 'es-MX', { numeric: true }) : y.localeCompare(x, 'es-MX', { numeric: true });
                });
            }

            /* ========================= Exportaciones (mismo contenido) ========================= */
            function buildExportRows() {
                view = buildGrouped(filtrarBase()); ordenarDatos();
                return view.map((g, i) => ({
                    "#": i + 1, "SKU": g.sku, "Producto": g.producto,
                    "Plan Producción": Math.round(g._planProd || 0), "Producido": Math.round(g._producido || 0), "Tend. Producción": Math.round(g._tendProd || 0),
                    "Alc. Prod %": isFinite(Number(g._alcProd)) ? Number(g._alcProd).toFixed(2) : "",
                    "Plan Venta": Math.round(g._pres || 0), "Surtido": Math.round(g._kgSurtido || 0), "Venta Real": Math.round(g._ventaReal || 0),
                    "Devoluciones": Math.round(g._devoluciones || 0), "Tend. Venta": Math.round(g._tendencia || 0), "Pedidos": Math.round(g._kg || 0),
                    "Alcance %": isFinite(Number(g._alc)) ? Number(g._alc).toFixed(2) : "",
                    "Inv. Ini": Math.round(g._invIni || 0), "Inv. Act": Math.round(g._invAct || 0), "Tend. Inv": Math.round(g._tendInv || 0), "Variación": Math.round(g._variacion || 0)
                }));
            }
            const MESES = ["", "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"];
            function buildExportDetalleRows() {
                // Detalle por Año + Mes + SKU (aunque se filtre por trimestre), con tendencias mensuales.
                const grupos = new Map();
                for (const r of filtrarBase()) {
                    const anio = Number(r._anio ?? r.anioConsulta ?? r.AnioConsulta ?? r.anio ?? r.Anio ?? 0);
                    const mesNum = Number(r._mes ?? r.mesConsulta ?? r.MesConsulta ?? r.mes ?? r.Mes ?? 0);
                    const sku = String(r._sku ?? r.productoCodigo ?? r.ProductoCodigo ?? "").trim();
                    const producto = String(r._prod ?? r.productoNombre ?? r.ProductoNombre ?? "").trim();
                    const master = String(r._master ?? r.master ?? r.Master ?? r.MASTER ?? "").trim();
                    if (!sku || mesNum < 1 || mesNum > 12) continue;
                    const key = `${anio}|${mesNum}|${master.toUpperCase()}|${sku.toUpperCase()}`;
                    if (!grupos.has(key)) grupos.set(key, { anio, mesNum, mesNombre: MESES[mesNum], trimestre: `QTR ${Math.ceil(mesNum / 3)}`, master: master || "SIN MASTER", sku, producto, rows: [] });
                    grupos.get(key).rows.push(r);
                }
                const lista = Array.from(grupos.values()).sort((a, b) => (a.anio - b.anio) || (a.mesNum - b.mesNum) || a.master.localeCompare(b.master, undefined, { numeric: true, sensitivity: "base" }) || a.sku.localeCompare(b.sku, undefined, { numeric: true, sensitivity: "base" }));
                const out = [];
                for (const g of lista) {
                    const base = { Anio: g.anio, Trimestre: g.trimestre, Mes: g.mesNombre, Master: g.master, SKU: g.sku, Producto: g.producto };
                    const det = buildDetalleGeneric(g.rows, g.anio, g.mesNum);
                    if (!det.length) { out.push({ ...base, Origen: "", Detalle: "", "Plan Venta": 0, Surtido: 0, "Venta Real": 0, Devoluciones: 0, Disponible: 0, "Tend. Venta": 0, Pedidos: 0, "Alcance %": "" }); continue; }
                    det.forEach(d => out.push({ ...base, Origen: d.origen, Detalle: d.label, "Plan Venta": Math.round(d.plan || 0), Surtido: Math.round(d.surt || 0), "Venta Real": Math.round(d.ventaReal || 0), Devoluciones: Math.round(d.devoluciones || 0), Disponible: Math.round(d.disp || 0), "Tend. Venta": Math.round(d.tend || 0), Pedidos: Math.round(d.ped || 0), "Alcance %": isFinite(Number(d.alc)) ? Number(d.alc).toFixed(2) : "" }));
                }
                return out;
            }
            function buildExportFilename() {
                const f = getFiltros(), parts = ["PresupuestosMes"];
                if (f.Anio) parts.push("A" + f.Anio);
                if (f.Mes) parts.push("M" + f.Mes);
                if (f.Trimestres?.length) parts.push("QTR" + f.Trimestres.join("-"));
                if (f.Canales?.length) parts.push("Canal");
