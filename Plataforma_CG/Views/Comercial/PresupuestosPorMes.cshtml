@using System.Linq
@model Plataforma_CG.Models.PresupuestoConsumoDto
@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Presupuesto y consumo";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    /* =====================================================================
           PRESUPUESTO Y CONSUMO · SIGO — hoja de estilos única
           Sustituye todas las capas anteriores (V4 a V7, tema tinto, compacto)
           y presupuesto-consumo-erp-compacto.css.
           ===================================================================== */
    :root {
        --es-tinto: #8d3e46;
        --es-tinto-deep: #5c2229;
        --es-tinto-soft: #f7eced;
        --es-tinto-line: #e8d3d6;
        --es-paper: #f6f4f4;
        --es-surface: #ffffff;
        --es-field: #ffffff;
        --es-head: #faf7f7;
        --es-hover: #fcf9f9;
        --es-row-line: #f0eaeb;
        --es-ink: #231a1c;
        --es-muted: #76686b;
        --es-line: #e6dfe0;
        --es-line-strong: #cfc4c6;
        --es-ok: #2f7a55;
        --es-ok-bg: #e7f3ec;
        --es-warn: #9a6410;
        --es-warn-bg: #fbf1de;
        --es-bad: #b42d2d;
        --es-bad-bg: #fbe9e8;
        --es-info: #2f5d86;
        --es-info-bg: #e9f0f7;
        --es-teal: #2b7a72;
        --es-teal-bg: #e4f2f0;
        --es-neutral-bg: #efecec;
        --g-prod: #2f5d86;
        --g-prod-bg: #eef3f9;
        --g-venta: #8d3e46;
        --g-venta-bg: #f9f0f1;
        --g-inv: #2b7a72;
        --g-inv-bg: #ecf5f4;
        --es-font: "Poppins", "Segoe UI", system-ui, -apple-system, Arial, sans-serif;
    }

    body[data-theme="dark"] {
        --es-tinto: #c56b74;
        --es-tinto-deep: #7a2d36;
        --es-tinto-soft: #3a2427;
        --es-tinto-line: #5a3439;
        --es-paper: #16181c;
        --es-surface: #202328;
        --es-field: #181a1e;
        --es-head: #262a30;
        --es-hover: #2a2e34;
        --es-row-line: #30343b;
        --es-ink: #edf0f3;
        --es-muted: #a9b0b9;
        --es-line: #363b43;
        --es-line-strong: #4a5059;
        --es-ok: #6cc596;
        --es-ok-bg: #1d3328;
        --es-warn: #e0b061;
        --es-warn-bg: #3a2f1b;
        --es-bad: #f08a83;
        --es-bad-bg: #3d2223;
        --es-info: #8bb8e0;
        --es-info-bg: #1e2b38;
        --es-teal: #6cc5ba;
        --es-teal-bg: #1b302d;
        --es-neutral-bg: #2c3036;
        --g-prod: #8bb8e0;
        --g-prod-bg: #1f2833;
        --g-venta: #c56b74;
        --g-venta-bg: #2c2124;
        --g-inv: #6cc5ba;
        --g-inv-bg: #1c2a29;
    }

    .pcx, .pcx-modal {
        font-family: var(--es-font) !important;
        color: var(--es-ink);
        font-size: 13px;
        line-height: 1.4;
    }

        .pcx *, .pcx-modal * {
            box-sizing: border-box;
        }

        .pcx .bi, .pcx-modal .bi {
            font-family: "bootstrap-icons" !important;
        }

    .text-end {
        text-align: right !important;
        font-variant-numeric: tabular-nums;
    }

    .text-center {
        text-align: center !important;
    }

    .pcx {
        display: flex;
        flex-direction: column;
        gap: 10px;
        padding: 14px 16px 10px;
        background: var(--es-paper);
        min-width: 0;
    }

    /* Encabezado */
    .pc-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        flex-wrap: wrap;
    }

    .pc-header__title {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .pc-header__icon {
        width: 40px;
        height: 40px;
        flex: none;
        border-radius: 10px;
        display: grid;
        place-items: center;
        background: var(--es-tinto);
        color: #fff;
        font-size: 19px;
    }

    .pc-header h1 {
        margin: 0;
        font-size: 20px;
        font-weight: 700;
        letter-spacing: -.01em;
        line-height: 1.15;
        color: var(--es-ink);
    }

    .pc-header p {
        margin: 2px 0 0;
        font-size: 12px;
        color: var(--es-muted);
    }

    .pc-header__acciones {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    /* Botones */
    .pm-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        height: 36px;
        padding: 0 14px;
        border: 1px solid var(--es-line-strong);
        border-radius: 7px;
        background: var(--es-field);
        color: var(--es-ink);
        font: 600 12.5px/1 var(--es-font);
        white-space: nowrap;
        cursor: pointer;
        transition: background .12s, border-color .12s;
    }

        .pm-btn:hover {
            background: var(--es-tinto-soft);
            border-color: var(--es-tinto-line);
        }

    .pm-btn-primary {
        background: var(--es-tinto);
        border-color: var(--es-tinto);
        color: #fff;
    }

        .pm-btn-primary:hover {
            background: var(--es-tinto-deep);
            border-color: var(--es-tinto-deep);
            color: #fff;
        }

    .pm-btn i.ok {
        color: var(--es-ok);
    }

    .pm-btn i.info {
        color: var(--es-info);
    }

    .pm-btn.sm {
        height: 30px;
        padding: 0 10px;
        font-size: 12px;
        border-radius: 6px;
    }

    .pm-btn:disabled {
        opacity: .55;
        cursor: progress;
    }

    .pm-btn:focus-visible {
        outline: 2px solid var(--es-tinto);
        outline-offset: 2px;
    }

    /* Filtros */
    .pc-card {
        background: var(--es-surface);
        border: 1px solid var(--es-line);
        border-radius: 10px;
        min-width: 0;
    }

    .pc-filtros {
        padding: 10px 14px;
        position: relative;
        z-index: 6;
    }

    .pm-filters {
        display: grid;
        grid-template-columns: 1fr 1fr .8fr 1fr 1fr 1.2fr 1.7fr 1fr 1.1fr 1fr;
        gap: 8px;
        align-items: end;
    }

        .pm-filters > div {
            min-width: 0;
        }

        .pm-filters > .d-none {
            display: none !important;
        }

    .pcx .form-label {
        display: block;
        margin: 0 0 4px;
        font-size: 11.5px;
        font-weight: 600;
        color: var(--es-muted);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .pcx .form-control, .pcx .form-select, .btn-select-like, .pcx-modal .form-control, .pcx-modal .form-select {
        width: 100%;
        height: 34px;
        padding: 0 9px;
        border: 1px solid var(--es-line-strong);
        border-radius: 7px;
        background-color: var(--es-field);
        color: var(--es-ink);
        font: 500 12.5px/1.2 var(--es-font);
        box-shadow: none;
        outline: none;
    }

    .pcx .form-select, .pcx-modal .form-select {
        padding-right: 26px;
    }

        .pcx .form-control:focus, .pcx .form-select:focus, .btn-select-like:focus-visible, .pcx-modal .form-control:focus, .pcx-modal .form-select:focus {
            border-color: var(--es-tinto);
            box-shadow: 0 0 0 3px rgba(141,62,70,.16);
            background-color: var(--es-field);
            color: var(--es-ink);
        }

    body[data-theme="dark"] .pcx .form-control, body[data-theme="dark"] .pcx .form-select, body[data-theme="dark"] .pcx-modal .form-control, body[data-theme="dark"] .pcx-modal .form-select {
        color-scheme: dark;
    }

    .btn-select-like {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 6px;
        text-align: left;
        cursor: pointer;
    }

        .btn-select-like::after {
            content: "\F282";
            font-family: "bootstrap-icons";
            font-size: 10px;
            color: var(--es-muted);
            flex: none;
        }

        .btn-select-like.has-selection {
            border-color: var(--es-tinto);
            background: var(--es-tinto-soft);
            font-weight: 600;
        }

    .multi-label {
        display: block;
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .pcx .dropdown-menu, .pcx-modal .dropdown-menu {
        min-width: 100%;
        max-height: 280px;
        overflow-y: auto;
        padding: 6px !important;
        border: 1px solid var(--es-line-strong) !important;
        border-radius: 10px !important;
        background: var(--es-surface) !important;
        box-shadow: 0 12px 30px rgba(0,0,0,.16) !important;
        font: 500 12.5px var(--es-font);
        color: var(--es-ink);
    }

    #dd-sku .dropdown-menu {
        min-width: 320px;
    }

    .pcx .dropdown-menu .form-check, .pcx-modal .dropdown-menu .form-check {
        display: flex;
        align-items: center;
        gap: 8px;
        min-height: 0;
        margin: 0;
        padding: 5px 6px;
        border-radius: 6px;
    }

        .pcx .dropdown-menu .form-check:hover, .pcx-modal .dropdown-menu .form-check:hover {
            background: var(--es-tinto-soft);
        }

    .pcx .dropdown-menu .form-check-input, .pcx-modal .dropdown-menu .form-check-input {
        float: none;
        width: 15px;
        height: 15px;
        margin: 0;
        accent-color: var(--es-tinto);
        cursor: pointer;
    }

        .pcx .dropdown-menu .form-check-input:checked, .pcx-modal .dropdown-menu .form-check-input:checked {
            background-color: var(--es-tinto);
            border-color: var(--es-tinto);
        }

    .pcx .dropdown-menu .form-check-label, .pcx-modal .dropdown-menu .form-check-label {
        flex: 1;
        cursor: pointer;
        color: var(--es-ink);
    }

    .pcx .dropdown-menu li.px-2, .pcx-modal .dropdown-menu li {
        padding: 0 !important;
    }

    .pcx .dropdown-divider, .pcx-modal .dropdown-divider {
        margin: 4px 0;
        border-color: var(--es-line);
        opacity: 1;
    }

    #dd-sku-search, #sp-meses-search {
        height: 30px;
        margin-bottom: 2px;
    }

    /* KPIs agrupados */
    /* Venta ocupa todo el ancho arriba; Producción e Inventario comparten la fila de abajo.
           Así cada cifra tiene espacio para verse completa (antes se cortaban con "…"). */
    .pc-kpis {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .pc-grupo.venta {
        grid-column: 1 / -1;
        order: -1;
    }

    .pc-kpis[hidden] {
        display: none;
    }

    .pc-grupo {
        padding: 10px 12px;
        border-radius: 10px;
        background: var(--es-surface);
        border: 1px solid var(--es-line);
        border-top: 3px solid var(--g);
        min-width: 0;
    }

        .pc-grupo.prod {
            --g: var(--g-prod);
        }

        .pc-grupo.venta {
            --g: var(--g-venta);
        }

        .pc-grupo.inv {
            --g: var(--g-inv);
        }

        .pc-grupo h3 {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            margin: 0 0 8px;
            font-size: 12.5px;
            font-weight: 700;
            color: var(--g);
        }

            .pc-grupo h3 .alc {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                font-size: 11.5px;
                font-weight: 600;
                color: var(--es-muted);
            }

                .pc-grupo h3 .alc b {
                    font-size: 13px;
                }

    .pc-grupo__items {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(125px, 1fr));
        gap: 8px 14px;
    }

    .kpi-card {
        min-width: 0;
    }

    .kpi-title {
        font-size: 11px;
        font-weight: 600;
        color: var(--es-muted);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .kpi-value {
        font-size: clamp(16px, 1.35vw, 21px);
        font-weight: 700;
        color: var(--es-ink);
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
        letter-spacing: -.01em;
    }

        .kpi-value small {
            margin-left: 2px;
            font-size: .6em;
            font-weight: 600;
            color: var(--es-muted);
        }

    .kpi-card.neg .kpi-value {
        color: var(--es-bad);
    }

    .kpi-card.destacado .kpi-value {
        color: var(--g);
    }

    .pc-alc-bar {
        width: 70px;
        height: 6px;
        border-radius: 999px;
        background: var(--es-neutral-bg);
        overflow: hidden;
    }

        .pc-alc-bar span {
            display: block;
            height: 100%;
            border-radius: 999px;
        }

    /* ---------- Tabla: 18 columnas sin desplazamiento horizontal ---------- */
    .table-card {
        display: flex;
        flex-direction: column;
        min-height: 0;
        background: var(--es-surface);
        border: 1px solid var(--es-line);
        border-radius: 10px;
        overflow: hidden;
    }

    .table-card-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
        padding: 8px 12px;
        border-bottom: 1px solid var(--es-line);
        font-size: 13px;
        font-weight: 600;
    }

        .table-card-head i {
            color: var(--es-tinto);
        }

        .table-card-head small {
            font-size: 11.5px;
            font-weight: 500;
            color: var(--es-muted);
        }

    .table-responsive-sticky {
        height: calc(100dvh - 330px);
        min-height: 360px;
        overflow-y: auto;
        overflow-x: hidden;
    }

    #tbl-data {
        width: 100%;
        table-layout: fixed;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
        font-size: 11.5px;
        color: var(--es-ink);
        --bs-table-bg: transparent;
        --bs-table-color: var(--es-ink);
        --bs-table-striped-bg: transparent;
        --bs-table-hover-bg: transparent;
        --bs-table-border-color: transparent;
    }

        #tbl-data > :not(caption) > * > * {
            border-width: 0;
            box-shadow: none;
        }

        #tbl-data thead th {
            position: sticky;
            z-index: 3;
            padding: 6px 4px;
            background: var(--es-head);
            color: var(--es-muted);
            font-size: 10.5px;
            font-weight: 600;
            line-height: 1.15;
            white-space: normal;
            vertical-align: bottom;
            border-bottom: 1px solid var(--es-line);
        }

        #tbl-data thead tr.grupos th {
            top: 0;
            height: 26px;
            padding: 4px;
            text-align: center;
            font-size: 10.5px;
            font-weight: 700;
            letter-spacing: .04em;
            text-transform: uppercase;
            border-bottom: 2px solid var(--g, var(--es-line));
        }

        #tbl-data thead tr.cols th {
            top: 26px;
        }

        #tbl-data thead th.g-prod {
            --g: var(--g-prod);
            background: var(--g-prod-bg);
            color: var(--g-prod);
        }

        #tbl-data thead th.g-venta {
            --g: var(--g-venta);
            background: var(--g-venta-bg);
            color: var(--g-venta);
        }

        #tbl-data thead th.g-inv {
            --g: var(--g-inv);
            background: var(--g-inv-bg);
            color: var(--g-inv);
        }

        #tbl-data thead tr.cols th.g-prod, #tbl-data thead tr.cols th.g-venta, #tbl-data thead tr.cols th.g-inv {
            color: var(--es-muted);
        }

        #tbl-data thead th[data-sort] {
            cursor: pointer;
            user-select: none;
        }

            #tbl-data thead th[data-sort]:hover {
                color: var(--es-ink);
            }

        #tbl-data thead th .sort-ind {
            display: inline-block;
            width: 8px;
            margin-left: 1px;
            color: var(--es-tinto);
            font-size: 8px;
        }

        #tbl-data thead th.asc .sort-ind::after {
            content: "▲";
        }

        #tbl-data thead th.desc .sort-ind::after {
            content: "▼";
        }

        #tbl-data thead th.sep, #tbl-data tbody td.sep, #tbl-data tfoot th.sep {
            border-left: 1px solid var(--es-line-strong) !important;
        }

        #tbl-data tbody td {
            padding: 5px 4px;
            border-bottom: 1px solid var(--es-row-line);
            background: var(--es-surface);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            vertical-align: middle;
        }

        #tbl-data tbody tr:not(.detail-row):hover > td {
            background: var(--es-hover);
        }

        #tbl-data tbody tr.is-open > td {
            background: var(--es-tinto-soft) !important;
        }

        #tbl-data tbody td.prod-cell {
            white-space: normal;
            line-height: 1.2;
        }

            #tbl-data tbody td.prod-cell span {
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
                overflow: hidden;
            }

        #tbl-data tbody td.muted {
            color: var(--es-muted);
        }

        #tbl-data tbody td.neg {
            color: var(--es-bad);
            font-weight: 600;
        }

        #tbl-data tbody td.pos {
            color: var(--es-ok);
            font-weight: 600;
        }

        #tbl-data tbody td.pct-ok {
            color: var(--es-ok);
            font-weight: 700;
        }

        #tbl-data tbody td.pct-warn {
            color: var(--es-warn);
            font-weight: 700;
        }

        #tbl-data tbody td.pct-bad {
            color: var(--es-bad);
            font-weight: 700;
        }

        #tbl-data tfoot th {
            position: sticky;
            bottom: 0;
            z-index: 2;
            padding: 7px 4px;
            background: var(--es-head);
            border-top: 1px solid var(--es-line-strong);
            font-size: 11px;
            font-weight: 700;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            font-variant-numeric: tabular-nums;
        }

    .t-msg td {
        padding: 40px 12px !important;
        text-align: center !important;
        color: var(--es-muted);
        white-space: normal !important;
    }

    .t-msg.is-error td {
        color: var(--es-bad);
    }

    .t-msg .load-status {
        margin-top: 4px;
        font-size: 11.5px;
    }

    .sku-cell {
        display: flex;
        align-items: center;
        gap: 4px;
        min-width: 0;
    }

    .sku-text {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        font-weight: 600;
    }

    .toggle-sku {
        flex: 0 0 20px;
        width: 20px;
        height: 20px;
        padding: 0;
        border: 1px solid var(--es-line-strong);
        border-radius: 5px;
        background: var(--es-field);
        color: var(--es-ink);
        display: inline-grid;
        place-items: center;
        cursor: pointer;
        font-size: 10px;
    }

        .toggle-sku:hover {
            background: var(--es-tinto-soft);
        }

    tr.is-open .toggle-sku {
        background: var(--es-tinto);
        border-color: var(--es-tinto);
        color: #fff;
    }

    .progress-mini {
        height: 5px;
        border-radius: 999px;
        background: var(--es-neutral-bg);
        overflow: hidden;
    }

    .progress-mini-bar {
        height: 100%;
        border-radius: 999px;
        transition: width .3s;
    }

    .progress-success, .sp-bar-ok {
        background: var(--es-ok);
    }

    .progress-warning, .sp-bar-warn {
        background: #d9a43a;
    }

    .progress-danger, .sp-bar-bad {
        background: var(--es-bad);
    }

    .progress-label {
        margin-top: 2px;
        font-size: 10.5px;
        font-weight: 600;
        text-align: right;
    }

    /* Paginador */
    .pc-pager {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 8px;
        padding: 8px 12px;
        border-top: 1px solid var(--es-line);
        font-size: 12px;
        color: var(--es-muted);
    }

        .pc-pager select {
            width: auto;
            height: 30px;
            padding: 0 24px 0 8px;
        }

        .pc-pager .pm-btn {
            height: 30px;
            width: 34px;
            padding: 0;
        }

    /* Detalle expandido */
    #tbl-data tr.detail-row > td {
        padding: 8px 10px 12px 28px !important;
        background: var(--es-paper) !important;
        white-space: normal;
        overflow: visible;
    }

    .pcx {
        --detalle-panel-width: 560px;
    }

    .detail-split {
        display: grid;
        grid-template-columns: minmax(320px, var(--detalle-panel-width)) 10px minmax(300px, 1fr);
        align-items: stretch;
        width: 100%;
    }

    .detail-box {
        min-width: 0;
        border-radius: 10px;
        background: var(--es-surface);
        border: 1px solid var(--es-line);
        box-shadow: inset 3px 0 0 var(--es-tinto);
        overflow: hidden;
    }

    .detail-head {
        padding: 7px 12px;
        border-bottom: 1px solid var(--es-line);
        font-size: 12.5px;
        font-weight: 600;
    }

    .detail-box .table-responsive, .ped-table-wrap {
        overflow: auto;
    }

    .detail-table, .ped-table {
        width: 100%;
        table-layout: fixed;
        border-collapse: separate;
        border-spacing: 0;
        font-size: 11.5px;
        margin: 0;
    }

        .detail-table th, .ped-table th {
            position: sticky;
            top: 0;
            z-index: 1;
            padding: 6px 6px;
            background: var(--es-head);
            border-bottom: 1px solid var(--es-line);
            color: var(--es-muted);
            font-size: 10.5px;
            font-weight: 600;
            white-space: normal;
            line-height: 1.15;
            vertical-align: bottom;
        }

        .detail-table td, .ped-table td {
            padding: 5px 6px;
            border-bottom: 1px solid var(--es-row-line);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

            .detail-table td:first-child {
                font-weight: 600;
                white-space: normal;
            }

        .detail-table tr:hover td, .ped-table tr:hover td {
            background: var(--es-hover);
        }

    .ped-link {
        font-weight: 700;
        color: var(--es-tinto);
        text-decoration: underline dotted;
        text-underline-offset: 2px;
        cursor: pointer;
    }

        .ped-link:hover, .ped-link.is-active {
            text-decoration-style: solid;
        }

    .ped-side-box {
        box-shadow: inset 3px 0 0 var(--es-info);
    }

    .ped-side-body {
        padding: 8px;
    }

    .ped-placeholder {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 110px;
        padding: 12px;
        border: 1px dashed var(--es-line-strong);
        border-radius: 8px;
        color: var(--es-muted);
        text-align: center;
        font-size: 12px;
    }

    .ped-loading, .ped-empty, .ped-error {
        padding: 12px;
        border-radius: 8px;
        font-size: 12px;
    }

    .ped-loading, .ped-empty {
        color: var(--es-muted);
        border: 1px dashed var(--es-line-strong);
    }

    .ped-error {
        color: var(--es-bad);
        background: var(--es-bad-bg);
    }

    .ped-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-bottom: 6px;
    }

    .ped-chip {
        padding: 2px 8px;
        border-radius: 999px;
        background: var(--es-head);
        border: 1px solid var(--es-line);
        font-size: 11px;
        font-weight: 600;
    }

    .detail-resizer {
        position: relative;
        cursor: col-resize;
        touch-action: none;
        user-select: none;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .detail-resizer::before {
            content: "";
            position: absolute;
            inset: 0 -4px;
        }

    .detail-resizer-grip {
        width: 4px;
        height: 36px;
        border-radius: 999px;
        background: var(--es-line-strong);
        pointer-events: none;
    }

    .detail-resizer:hover .detail-resizer-grip, .detail-resizer.is-resizing .detail-resizer-grip {
        background: var(--es-tinto);
    }

    .detail-resizer:focus-visible {
        outline: 2px solid var(--es-tinto);
    }

    body.detail-resizing, body.detail-resizing * {
        cursor: col-resize !important;
        user-select: none !important;
    }

    .statusbar {
        display: flex;
        gap: 18px;
        flex-wrap: wrap;
        font-size: 11.5px;
        color: var(--es-muted);
    }

    /* ---------- Modal Presupuesto vs cumplimiento ---------- */
    #modal-sp .modal-dialog {
        max-width: min(1280px, 96vw);
    }

    .pcx-modal.modal-content {
        border: 0;
        border-radius: 12px;
        overflow: hidden;
        background: var(--es-surface);
        box-shadow: 0 18px 50px rgba(35,26,28,.25);
    }

    .pcx-modal .modal-header {
        padding: 13px 18px;
        background: var(--es-tinto-deep);
        color: #fff;
        border-bottom: 0;
    }

    .pcx-modal .modal-title {
        font-size: 16px;
        font-weight: 600;
        color: #fff;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .pcx-modal .btn-close {
        filter: invert(1) grayscale(1) brightness(2);
        opacity: .9;
    }

    .pcx-modal .modal-body {
        background: var(--es-paper);
        padding: 14px 16px;
    }

    .sp-filtros {
        display: grid;
        grid-template-columns: 120px 200px minmax(180px, 1fr) minmax(220px, 1.3fr) auto;
        gap: 10px;
        align-items: end;
        margin-bottom: 12px;
    }

        .sp-filtros .acciones {
            display: flex;
            gap: 8px;
            align-items: center;
        }

    #sp-status {
        font-size: 12px;
        color: var(--es-muted);
    }

    .sp-kpis-bar {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 10px;
        margin-bottom: 12px;
    }

    .sp-kpi-card {
        padding: 10px 14px;
        border-radius: 10px;
        background: var(--es-surface);
        border: 1px solid var(--es-line);
        border-top: 3px solid var(--k, var(--es-line-strong));
    }

    .sp-kpi-venta {
        --k: var(--es-ok);
    }

    .sp-kpi-presupuesto {
        --k: var(--es-tinto);
    }

    .sp-kpi-cumplimiento {
        --k: var(--es-info);
    }

    .sp-kpi-tendencia {
        --k: var(--es-warn);
    }

    .sp-kpi-title {
        font-size: 11.5px;
        font-weight: 600;
        color: var(--es-muted);
    }

    .sp-kpi-value {
        font-size: 20px;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
    }

        .sp-kpi-value.sp-cump-ok {
            color: var(--es-ok);
        }

        .sp-kpi-value.sp-cump-warn {
            color: var(--es-warn);
        }

        .sp-kpi-value.sp-cump-bad {
            color: var(--es-bad);
        }

    #modal-sp .table-responsive {
        max-height: 54vh;
        overflow: auto;
        border-radius: 10px;
        border: 1px solid var(--es-line);
        background: var(--es-surface);
    }

    #sp-table {
        width: 100%;
        table-layout: fixed;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
        font-size: 12px;
        color: var(--es-ink);
        --bs-table-bg: transparent;
        --bs-table-color: var(--es-ink);
        --bs-table-striped-bg: transparent;
        --bs-table-border-color: transparent;
    }

        #sp-table > :not(caption) > * > * {
            border-width: 0;
            box-shadow: none;
        }

        #sp-table thead th {
            position: sticky;
            top: 0;
            z-index: 1;
            padding: 8px 8px;
            background: var(--es-head);
            border-bottom: 1px solid var(--es-line);
            color: var(--es-muted);
            font-size: 11.5px;
            font-weight: 600;
        }

        #sp-table tbody td {
            padding: 6px 8px;
            border-bottom: 1px solid var(--es-row-line);
            background: var(--es-surface);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        #sp-table tbody tr:hover td {
            background: var(--es-hover);
        }

        #sp-table td.sp-cump-ok {
            background: var(--es-ok-bg) !important;
            color: var(--es-ok);
            font-weight: 700;
        }

        #sp-table td.sp-cump-warn {
            background: var(--es-warn-bg) !important;
            color: var(--es-warn);
            font-weight: 700;
        }

        #sp-table td.sp-cump-bad {
            background: var(--es-bad-bg) !important;
            color: var(--es-bad);
            font-weight: 700;
        }

    .sp-progress {
        height: 5px;
        border-radius: 999px;
        background: var(--es-neutral-bg);
        overflow: hidden;
    }

    .sp-progress-bar {
        height: 100%;
        border-radius: 999px;
    }

    .sp-progress-label {
        font-size: 11px;
        font-weight: 600;
        text-align: right;
    }

    #modal-sp details {
        margin-top: 8px;
        font-size: 12px;
        color: var(--es-muted);
    }

    #modal-sp pre {
        margin: 4px 0 0;
        padding: 8px;
        border-radius: 6px;
        background: var(--es-surface);
        border: 1px solid var(--es-line);
        white-space: pre-wrap;
    }

    @@media (max-width: 1400px) {
        .pm-filters {
            grid-template-columns: repeat(5, minmax(0, 1fr));
        }
    }

    @@media (max-width: 1280px) {
        .table-responsive-sticky {
            overflow-x: auto;
        }

        #tbl-data {
            min-width: 1180px;
        }

        .detail-split {
            grid-template-columns: 1fr;
        }

        .detail-resizer {
            display: none;
        }
    }

    @@media (max-width: 900px) {
        .pm-filters {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .pc-kpis {
            grid-template-columns: 1fr;
        }

        .sp-filtros, .sp-kpis-bar {
            grid-template-columns: 1fr 1fr;
        }
    }
</style>

@Html.AntiForgeryToken()

<div class="pcx window pm-page">
    <header class="pc-header">
        <div class="pc-header__title">
            <span class="pc-header__icon"><i class="bi bi-graph-up-arrow"></i></span>
            <div>
                <h1>Presupuesto y consumo</h1>
                <p>Plan contra real por SKU en tres frentes: producción, venta e inventario. Clic en la flecha de un SKU para ver su detalle por canal o vendedor.</p>
            </div>
        </div>
        <div class="pc-header__acciones">
            <button class="pm-btn" type="button" id="btn-limpiar"><i class="bi bi-eraser"></i> Limpiar</button>
            <button class="pm-btn" type="button" id="btn-sp"><i class="bi bi-clipboard-data info"></i> Presupuesto vs cumplimiento</button>
            <button class="pm-btn" type="button" id="btn-csv"><i class="bi bi-filetype-csv ok"></i> CSV</button>
            <button class="pm-btn pm-btn-primary" type="button" id="btn-xlsx"><i class="bi bi-file-earmark-excel"></i> Exportar Excel</button>
        </div>
    </header>

    <section class="pc-card pc-filtros">
        <form id="filtros" class="pm-filters" autocomplete="off">
            <div>
                <label class="form-label" for="sel-mes">Mes</label>
                <select class="form-select" id="sel-mes" name="Mes">
                    <option value="">(Todos)</option>
                    <option value="1">Enero</option>
                    <option value="2">Febrero</option>
                    <option value="3">Marzo</option>
                    <option value="4">Abril</option>
                    <option value="5">Mayo</option>
                    <option value="6">Junio</option>
                    <option value="7">Julio</option>
                    <option value="8">Agosto</option>
                    <option value="9">Septiembre</option>
                    <option value="10">Octubre</option>
                    <option value="11">Noviembre</option>
                    <option value="12">Diciembre</option>
                </select>
            </div>
            <div>
                <label class="form-label">Trimestre</label>
                <div class="dropdown w-100" id="dd-tri">
                    <button class="btn-select-like" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false"><span class="multi-label">(Todos)</span></button>
                    <ul class="dropdown-menu" id="dd-tri-list">
                        <li><div class="form-check"><input class="form-check-input tri-check-all" type="checkbox" id="tri_all" data-text="TODOS" /><label class="form-check-label fw-bold" for="tri_all">Seleccionar todo</label></div></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><div class="form-check"><input class="form-check-input multi-check-tri" type="checkbox" value="1" id="tri_1" data-text="QTR 1" /><label class="form-check-label" for="tri_1">QTR 1 · ene–mar</label></div></li>
                        <li><div class="form-check"><input class="form-check-input multi-check-tri" type="checkbox" value="2" id="tri_2" data-text="QTR 2" /><label class="form-check-label" for="tri_2">QTR 2 · abr–jun</label></div></li>
                        <li><div class="form-check"><input class="form-check-input multi-check-tri" type="checkbox" value="3" id="tri_3" data-text="QTR 3" /><label class="form-check-label" for="tri_3">QTR 3 · jul–sep</label></div></li>
                        <li><div class="form-check"><input class="form-check-input multi-check-tri" type="checkbox" value="4" id="tri_4" data-text="QTR 4" /><label class="form-check-label" for="tri_4">QTR 4 · oct–dic</label></div></li>
                    </ul>
                </div>
            </div>
            <div>
                <label class="form-label" for="sel-anio">Año</label>
                <select class="form-select" id="sel-anio" name="Anio"><option value="">(Todos)</option></select>
            </div>
            <div id="filtro-origen">
                <label class="form-label">Origen</label>
                <div class="dropdown w-100" id="dd-origen">
                    <button class="btn-select-like" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false"><span class="multi-label">(Todos)</span></button>
                    <ul class="dropdown-menu">
                        <li><div class="form-check"><input class="form-check-input multi-check-origen" type="checkbox" value="CEDIS" id="org_cedis" data-text="CEDIS" /><label class="form-check-label" for="org_cedis">CEDIS</label></div></li>
                        <li><div class="form-check"><input class="form-check-input multi-check-origen" type="checkbox" value="VENDEDOR" id="org_vendedor" data-text="VENDEDOR" /><label class="form-check-label" for="org_vendedor">VENDEDOR</label></div></li>
                    </ul>
                </div>
            </div>
            <div id="filtro-canal">
                <label class="form-label">Canal</label>
                <div class="dropdown w-100" id="dd-canal">
                    <button class="btn-select-like" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false"><span class="multi-label">(Todos)</span></button>
                    <ul class="dropdown-menu" id="dd-canal-list"><li class="text-muted small p-2">Cargando…</li></ul>
                </div>
            </div>
            <div id="filtro-vendedores">
