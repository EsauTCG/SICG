                            <td title="${escapeHtml(r.razonSocial ?? "")}">${escapeHtml(r.razonSocial ?? "")}</td><td>${escapeHtml(r.canal ?? "")}</td><td title="${escapeHtml(r.vendedor ?? "")}">${escapeHtml(r.vendedor ?? "")}</td>
                            <td class="text-end" data-copy="${Math.round(toNumber(r.kgPedido))}">${num(r.kgPedido)}</td><td class="text-end" data-copy="${Math.round(toNumber(r.kgSurtido))}">${num(r.kgSurtido)}</td><td class="text-end" data-copy="${Math.round(toNumber(r.kgPendiente))}"><b>${num(r.kgPendiente)}</b></td></tr>`).join('');
                body.innerHTML = `${meta}<div class="ped-table-wrap"><table class="ped-table ped-table-v6">
                            <colgroup><col style="width:6%"><col style="width:7%"><col style="width:6%"><col style="width:9%"><col style="width:18%"><col style="width:11%"><col style="width:15%"><col style="width:9%"><col style="width:9%"><col style="width:10%"></colgroup>
                            <thead><tr><th>Tipo</th><th class="text-end">Doc</th><th>Serie</th><th>Fecha</th><th>Razón social</th><th>Canal</th><th>Vendedor</th><th class="text-end">Pedido</th><th class="text-end">Surtido</th><th class="text-end">Pendiente</th></tr></thead>
                            <tbody>${filas}</tbody></table></div>`;
            }
            async function openPedidosInline(panelId, params) {
                const body = document.getElementById(panelId)?.querySelector('.ped-side-body'); if (!body) return;
                body.innerHTML = `<div class="ped-loading">Consultando pedidos…</div>`;
                try { renderPedidosPanel(panelId, params, await fetchPedidosDetalle(params)); }
                catch (err) { console.error(err); body.innerHTML = `<div class="ped-error"><b>Error al consultar pedidos.</b><br>${escapeHtml(String(err?.message || ''))}</div>`; }
            }
            function renderDetalleHtml(group) {
                const det = buildDetalleGeneric(group._rows || [], group.anio, group._trimestre ? group.mes : (group._mesNum || group.mes));
                const panelId = `ped-panel-${idSeguro(group._key)}`;
                const filas = det.map(d => `<tr>
                            <td title="${escapeHtml(d.label)}">${escapeHtml(d.label)}</td>
                            <td class="text-end">${num(d.plan)}</td><td class="text-end">${num(d.surt)}</td><td class="text-end">${num(d.disp)}</td>
                            <td class="text-end">${num(d.ventaReal)}</td><td class="text-end">${num(d.devoluciones)}</td><td class="text-end">${num(d.tend)}</td>
                            <td class="text-end">${toNumber(d.ped) > 0 ? `<a href="#" class="ped-link" data-panel-id="${panelId}" data-anio="${escapeHtml(group.anio)}" data-mes="${escapeHtml(group._mesNum || '')}" data-trimestre="${escapeHtml(group._trimestre || '')}" data-sku="${escapeHtml(group.sku)}" data-origen="${escapeHtml(d.origen)}" data-cliente="${escapeHtml(d.cliente || '')}" data-canal="${escapeHtml(d.canal || '')}" data-vendedor="${escapeHtml(d.vendedorId ?? '')}">${num(d.ped)}</a>` : num(d.ped)}</td>
                            <td class="text-end ${pctClass(d.alc)}">${pct(d.alc)}%</td></tr>`).join('') || `<tr class="t-msg"><td colspan="9">Sin detalle por canal o vendedor.</td></tr>`;
                return `<div class="detail-split">
                            <div class="detail-box">
                                <div class="detail-head">${escapeHtml(group.sku)} · detalle por canal o vendedor</div>
                                <div class="table-responsive"><table class="detail-table detail-table-v6">
                                    <colgroup><col style="width:22%"><col style="width:10%"><col style="width:9%"><col style="width:10%"><col style="width:10%"><col style="width:8%"><col style="width:11%"><col style="width:10%"><col style="width:10%"></colgroup>
                                    <thead><tr><th>Canal / vendedor</th><th class="text-end">Plan venta</th><th class="text-end">Surtido</th><th class="text-end">Disponible</th><th class="text-end">Venta real</th><th class="text-end">Dev.</th><th class="text-end">Tendencia</th><th class="text-end">Pedidos</th><th class="text-end">Alcance</th></tr></thead>
                                    <tbody>${filas}</tbody></table></div>
                            </div>
                            <div class="detail-resizer" title="Arrastra para cambiar el tamaño · doble clic para restablecer" role="separator" aria-orientation="vertical" tabindex="0"><span class="detail-resizer-grip"></span></div>
                            <div class="detail-box ped-side-box" id="${panelId}">
                                <div class="detail-head">Pedidos pendientes</div>
                                <div class="ped-side-body"><div class="ped-placeholder">Haz clic en una cifra de Pedidos para ver los documentos.</div></div>
                            </div></div>`;
            }

            /* ========================= Pintar tabla y resumen ========================= */
            function setKpi(id, valor, negativoRojo) {
                const el = $(id); if (!el) return;
                el.innerHTML = `${num(valor)}<small>kg</small>`;
                el.title = `${num(valor)} kg`;
                if (negativoRojo) el.closest('.kpi-card')?.classList.toggle('neg', Number(valor) < 0);
            }
            function setAlcance(id, valor) {
                const el = $(id), bar = $(id + '-bar');
                if (el) el.textContent = isFinite(valor) && valor ? pct(valor) + '%' : '—';
                if (bar) { bar.style.width = `${Math.min(100, Math.max(0, valor || 0))}%`; bar.className = progressClass(valor); }
            }
            const celdaProgreso = (valor, base, titulo) => {
                const p = base > 0 ? (valor / base * 100) : 0;
                return `<td class="text-end" data-copy="${Math.round(toNumber(valor))}" title="${titulo}"><div class="progress-mini"><div class="progress-mini-bar ${progressClass(p)}" style="width:${base > 0 ? Math.min(100, Math.max(0, p)) : 0}%"></div></div><div class="progress-label">${num(valor)}</div></td>`;
            };
            const celdaNum = (v, extra = '', sep = false) => `<td class="text-end${sep ? ' sep' : ''}${extra ? ' ' + extra : ''}" data-copy="${Math.round(toNumber(v))}">${num(v)}</td>`;

            function render() {
                grouped = buildGrouped(filtrarBase());
                view = grouped.slice();
                ordenarDatos();
                const t = { planProd: 0, producido: 0, tendProd: 0, pres: 0, kg: 0, surt: 0, vr: 0, dev: 0, tend: 0, invIni: 0, invAct: 0, tendInv: 0, vari: 0 };
                for (const g of view) {
                    t.planProd += toNumber(g._planProd); t.producido += toNumber(g._producido); t.tendProd += toNumber(g._tendProd);
                    t.pres += toNumber(g._pres); t.kg += toNumber(g._kg); t.surt += toNumber(g._kgSurtido); t.vr += toNumber(g._ventaReal);
                    t.dev += toNumber(g._devoluciones); t.tend += toNumber(g._tendencia); t.invIni += toNumber(g._invIni); t.invAct += toNumber(g._invAct);
                    t.tendInv += toNumber(g._tendInv); t.vari += toNumber(g._variacion);
                }
                const tDisp = t.pres - t.kg - t.surt;
                const tAlc = t.pres > 0 ? (t.tend / t.pres) * 100 : 0;
                const tAlcProd = t.planProd > 0 ? (t.tendProd / t.planProd) * 100 : 0;

                const pon = (id, v) => { const el = $(id); if (el) el.textContent = v; };
                pon('tot-planprod', num(t.planProd)); pon('tot-producido', num(t.producido)); pon('tot-tendprod', num(t.tendProd)); pon('tot-alcprod', pct(tAlcProd) + '%');
                pon('tot-pres', num(t.pres)); pon('tot-surtido', num(t.surt)); pon('tot-vr', num(t.vr)); pon('tot-dev', num(t.dev)); pon('tot-tend', num(t.tend)); pon('tot-kg', num(t.kg)); pon('tot-alc', pct(tAlc) + '%');
                pon('tot-invini', num(t.invIni)); pon('tot-invact', num(t.invAct)); pon('tot-tendinv', num(t.tendInv)); pon('tot-var', num(t.vari));

                if ($pmKpis) {
                    $pmKpis.hidden = !view.length;
                    if (view.length) {
                        setKpi('pm-kpi-planprod', t.planProd); setKpi('pm-kpi-producido', t.producido); setKpi('pm-kpi-tendprod', t.tendProd);
                        setKpi('pm-kpi-pres', t.pres); setKpi('pm-kpi-sur', t.surt); setKpi('pm-kpi-vr', t.vr); setKpi('pm-kpi-dev', t.dev);
                        setKpi('pm-kpi-ten', t.tend); setKpi('pm-kpi-ped', t.kg); setKpi('pm-kpi-dis', tDisp, true);
                        setKpi('pm-kpi-invini', t.invIni); setKpi('pm-kpi-invact', t.invAct); setKpi('pm-kpi-tendinv', t.tendInv); setKpi('pm-kpi-var', t.vari, true);
                        setAlcance('pm-kpi-alcprod', tAlcProd); setAlcance('pm-kpi-alcventa', tAlc);
                    }
                }

                state.maxPage = Math.max(1, Math.ceil(view.length / state.pageSize));
                if (state.page > state.maxPage) state.page = state.maxPage;
                const start = (state.page - 1) * state.pageSize, end = Math.min(start + state.pageSize, view.length);
                const pageSlice = view.slice(start, end);
                const f = getFiltros();
                const periodo = f.Trimestres.length ? f.Trimestres.map(x => 'QTR ' + x).join(' + ') : (f.Mes ? MESES[Number(f.Mes)] : 'todos los meses');
                $('pc-conteo').textContent = view.length ? `· ${view.length} SKU · ${periodo}${f.Anio ? ' ' + f.Anio : ''}` : '';

                if (!pageSlice.length) {
                    $tbody.innerHTML = `<tr class="t-msg"><td colspan="18">Sin resultados con estos filtros.</td></tr>`;
                    if ($pgInfo) $pgInfo.textContent = '0–0 de 0';
                    return;
                }
                const frag = document.createDocumentFragment();
                pageSlice.forEach((g, idx) => {
                    const isOpen = expanded.has(g._key);
                    const tr = document.createElement('tr');
                    if (isOpen) tr.classList.add('is-open');
                    tr.innerHTML = `
                                <td class="text-center muted" data-copy="${start + idx + 1}">${start + idx + 1}</td>
                                <td data-copy="${escapeHtml(g.sku)}"><div class="sku-cell"><button class="toggle-sku" type="button" data-toggle="${escapeHtml(g._key)}" aria-expanded="${isOpen}" aria-label="Ver detalle de ${escapeHtml(g.sku)}"><i class="bi ${isOpen ? 'bi-chevron-down' : 'bi-chevron-right'}"></i></button><span class="sku-text">${escapeHtml(g.sku)}</span></div></td>
                                <td class="prod-cell" title="${escapeHtml(g.producto)}"><span>${escapeHtml(g.producto)}</span></td>
                                ${celdaNum(g._planProd, '', true)}${celdaNum(g._producido)}
                                ${celdaProgreso(g._tendProd, g._planProd, `Tendencia ${num(g._tendProd)} de un plan de ${num(g._planProd)}`)}
                                <td class="text-end ${pctClass(g._alcProd)}" data-copy="${toNumber(g._alcProd).toFixed(2)}">${pct(g._alcProd)}%</td>
                                ${celdaNum(g._pres, '', true)}${celdaNum(g._kgSurtido)}${celdaNum(g._ventaReal)}${celdaNum(g._devoluciones, g._devoluciones > 0 ? 'neg' : 'muted')}
                                ${celdaProgreso(g._tendencia, g._pres, `Tendencia ${num(g._tendencia)} de un plan de ${num(g._pres)}`)}
                                ${celdaNum(g._kg)}
                                <td class="text-end ${pctClass(g._alc)}" data-copy="${toNumber(g._alc).toFixed(2)}">${pct(g._alc)}%</td>
                                ${celdaNum(g._invIni, '', true)}${celdaNum(g._invAct)}
                                ${celdaProgreso(g._tendInv, g._invIni, `Tendencia de inventario ${num(g._tendInv)} contra inicial ${num(g._invIni)}`)}
                                ${celdaNum(g._variacion, g._variacion < 0 ? 'neg' : g._variacion > 0 ? 'pos' : 'muted')}`;
                    frag.appendChild(tr);
                    if (isOpen) {
                        const trd = document.createElement('tr');
                        trd.className = 'detail-row';
                        trd.innerHTML = `<td colspan="18">${renderDetalleHtml(g)}</td>`;
                        frag.appendChild(trd);
                    }
                });
                $tbody.replaceChildren(frag);
                if (pendingRestore && $scrollBox) { const { top } = pendingRestore; pendingRestore = null; requestAnimationFrame(() => { $scrollBox.scrollTop = top; }); }
                if ($pgInfo) $pgInfo.textContent = `${start + 1}–${end} de ${view.length}`;
                if ($pgPrev) $pgPrev.disabled = state.page <= 1;
                if ($pgNext) $pgNext.disabled = state.page >= state.maxPage;
            }

            function initSorting() {
                const ths = [...document.querySelectorAll('#tbl-data thead th[data-sort]')];
                ths.forEach(th => th.addEventListener('click', () => {
                    const col = th.dataset.sort;
                    if (state.sort.column === col) state.sort.direction = state.sort.direction === 'asc' ? 'desc' : state.sort.direction === 'desc' ? null : 'asc';
                    else { state.sort.column = col; state.sort.direction = (col === 'sku' || col === 'producto') ? 'asc' : 'desc'; }
                    if (!state.sort.direction) state.sort.column = null;
                    ths.forEach(h => { const on = h.dataset.sort === state.sort.column; h.classList.toggle('asc', on && state.sort.direction === 'asc'); h.classList.toggle('desc', on && state.sort.direction === 'desc'); h.setAttribute('aria-sort', on ? (state.sort.direction === 'asc' ? 'ascending' : 'descending') : 'none'); });
                    state.page = 1;
                    scheduleRender(0);
                }));
            }

            /* ========================= Carga de datos (mismas fuentes) ========================= */
            async function getJson(url) { const r = await fetch(url, { cache: 'no-store' }); if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); }
            async function fetchDevolucionesPorMeses(meses, anio) {
                const unicos = Array.from(new Set((meses || []).map(x => String(x || '').trim()).filter(Boolean)));
                if (!unicos.length) return [];
                return (await Promise.all(unicos.map(m => getJson(`${ENDPOINT_DM}?mes=${m}&anio=${anio}`)))).flat();
            }
            function buildDevolucionesMap(rows) {
                const map = new Map(), add = (k, v) => map.set(k, (map.get(k) || 0) + v);
                for (const r of rows || []) {
                    const sku = String(r.sku ?? "").toUpperCase().trim(), anio = String(r.anio ?? "").trim(), mes = String(r.mes ?? "").trim(), kg = toNumber(r.kg);
                    const cli = String(r.clienteId ?? "").toUpperCase().trim(), ven = String(r.vendedorId ?? "").trim(), canal = String(r.canal ?? "").toUpperCase().trim();
                    add(`${anio}|${mes}|${sku}`, kg);
                    if (cli) add(`CLIENTE|${anio}|${mes}|${sku}|${cli}`, kg);
                    if (ven) add(`VENDEDOR|${anio}|${mes}|${sku}|${ven}`, kg);
                    if (canal) add(`CEDIS|${anio}|${mes}|${sku}|${canal}`, kg);
                }
                return map;
            }
            function buildVentaRealMap(rows) {
                const map = new Map(), add = (k, v) => map.set(k, (map.get(k) || 0) + v);
                for (const r of rows || []) {
                    const sku = String(r.articuloCodigo ?? "").toUpperCase().trim(), anio = String(r.anio ?? "").trim(), mes = String(r.mes ?? "").trim();
                    const ven = r.vendedorId == null ? "" : String(r.vendedorId).trim(), canal = String(r.u_CANAL ?? "").toUpperCase().trim(), kg = toNumber(r.kgVendidos);
                    if (ven) add(`VENDEDOR|${anio}|${mes}|${sku}|${ven}`, kg);
                    if (canal) add(`CEDIS|${anio}|${mes}|${sku}|${canal}`, kg);
                }
                return map;
            }
            const getMasterValue = r => String(r.master ?? r.Master ?? r.MASTER ?? r.u_MASTER ?? r.productoMaster ?? r.producto_master ?? r.masterNombre ?? r.nombreMaster ?? r.familia ?? r.Familia ?? r.linea ?? r.Linea ?? r.grupo ?? r.Grupo ?? r.categoria ?? r.Categoria ?? r._master ?? '').toUpperCase().trim();

            function normalizarData(rawRows, invIniMap, invActMap, ventaRealMap, devolucionesMap) {
                return (rawRows || []).map(r => {
                    const presupuesto = toNumber(r.presupuestoAsignado), pedidos = toNumber(r.kgPedidosMes), surtido = toNumber(r.kgSurtidoReal);
                    const skuKey = String(r.productoCodigo ?? r._sku ?? '').toUpperCase().trim();
                    const anio = String(r.anioConsulta ?? r.anio ?? r._anio ?? '').trim();
                    const mes = String(r.mesConsulta ?? r.mes ?? r._mes ?? '').trim();
                    const origen = String(r.origen ?? r._origen ?? '').toUpperCase().trim();
                    const canalKey = String(r.canal ?? r.u_CANAL ?? r._canal ?? '').toUpperCase().trim();
                    const venIdKey = String(r.vendedorId ?? r._venId ?? '').trim();
                    const cliCod = String(r.clienteCodigo ?? r.codigoCliente ?? r.CardCode ?? r._cliCod ?? '').toUpperCase().trim();
                    let ventaRealBruta = 0, devKey = null;
                    if (origen === 'VENDEDOR') { ventaRealBruta = toNumber(ventaRealMap.get(`VENDEDOR|${anio}|${mes}|${skuKey}|${venIdKey}`)); devKey = venIdKey ? `VENDEDOR|${anio}|${mes}|${skuKey}|${venIdKey}` : null; }
                    else if (origen === 'CEDIS') { ventaRealBruta = toNumber(ventaRealMap.get(`CEDIS|${anio}|${mes}|${skuKey}|${canalKey}`)); devKey = canalKey ? `CEDIS|${anio}|${mes}|${skuKey}|${canalKey}` : null; }
                    else if (origen === 'CLIENTE') devKey = cliCod ? `CLIENTE|${anio}|${mes}|${skuKey}|${cliCod}` : null;
                    const devoluciones = devKey ? toNumber(devolucionesMap.get(devKey)) : 0;
                    // Regla: en CEDIS la devolución reduce la venta real, pero no regresa kilos al disponible.
                    const ventaRealNeta = origen === 'CEDIS' ? Math.max(0, ventaRealBruta - devoluciones) : ventaRealBruta;
                    return {
                        ...r, _anio: anio, _mes: mes, _sku: skuKey, _prod: String(r.productoNombre ?? r._prod ?? '').trim(), _origen: origen,
                        _canal: canalKey, _venId: r.vendedorId ?? r._venId ?? null,
                        _venCod: String(r.vendedorCodigo ?? r.VendedorCodigo ?? r._venCod ?? '').trim(),
                        _venNom: String(r.vendedorNombre ?? r.VendedorNombre ?? r._venNom ?? '').toUpperCase().trim(),
                        _cliCod: cliCod, _cliNom: String(r.nombreCliente ?? r.clienteNombre ?? r.CardName ?? r._cliNom ?? '').toUpperCase().trim(),
                        _master: getMasterValue(r),
                        _clasificacionId: r.clasificacionId ?? r._clasificacionId ?? null,
                        _clasificacionNombre: String(r.clasificacionNombre ?? r._clasificacionNombre ?? '').toUpperCase().trim(),
                        _tipoSkuId: String(r.idTipoSKU ?? r.IdTipoSKU ?? r.tipoSKUId ?? r.TipoSKUId ?? r.u_TipoporSKU ?? r.U_TipoporSKU ?? r._tipoSkuId ?? '').trim(),
                        _tipoSkuDesc: String(r.tipoSKUDescripcion ?? r.TipoSKUDescripcion ?? r.descripcionTipoSKU ?? r.DescripcionTipoSKU ?? r.descripcion ?? r.Descripcion ?? r._tipoSkuDesc ?? 'POR DEFINIR').toUpperCase().trim(),
                        _pres: presupuesto, _kg: pedidos, _kgSurtido: surtido,
                        _planProd: pickNumber(r, 'planProduccion', 'PlanProduccion', 'plan_prod', 'planProd'),
                        _producido: pickNumber(r, 'producido', 'Producido', 'producidoReal', 'prod_real', 'prodReal'),
                        _ventaRealBruta: ventaRealBruta, _ventaReal: ventaRealNeta,
                        _invIni: toNumber(invIniMap.get(skuKey)), _invAct: toNumber(invActMap.get(skuKey)),
                        _devoluciones: devoluciones, _disp: Math.max(0, presupuesto - pedidos - surtido)
                    };
                });
            }

            let cargaSeq = 0;
            async function cargarTodo() {
                const seq = ++cargaSeq; // CORRECCIÓN: si se cambian mes o año rápido, solo se pinta la última carga
                try {
                    await cargarModoVendedorActual();
                    const now = new Date();
                    const mesesTri = getMesesSeleccionadosPorTrimestre();
                    const mesCarga = ($selMes.value || mesesTri[0] || String(now.getMonth() + 1)).trim();
                    const mesesDev = mesesTri.length ? mesesTri : [mesCarga];
                    const anioCarga = ($selAnio.value || String(now.getFullYear())).trim();
                    if (!$selMes.value && !getTrimestresSeleccionados().length) $selMes.value = mesCarga;
                    if (!$selAnio.value) $selAnio.value = anioCarga;

                    $tbody.innerHTML = `<tr class="t-msg"><td colspan="18"><div>Cargando datos…</div><div class="load-status" id="load-status">0 de 5 fuentes listas</div></td></tr>`;
                    let listas = 0;
                    const tick = msg => { listas++; const el = $('load-status'); if (el) el.textContent = `${listas} de 5 fuentes listas · ${msg}`; };
                    const opcional = (p, nombre) => p.then(d => { tick(nombre + ' ✓'); return d; }).catch(e => { console.warn(nombre, e); tick(nombre + ' ✗'); faltantes.push(nombre); return []; });
                    const faltantes = [];
                    const [rawRes, invIniRows, invActRows, vrRows, devRows] = await Promise.all([
                        getJson(ENDPOINT_URL).then(d => { tick('Presupuestos ✓'); return d; }),
                        opcional(getJson(`${ENDPOINT_INVINI}?mes=${mesCarga}&anio=${anioCarga}`), 'Inventario inicial'),
                        opcional(getJson(ENDPOINT_INVACT), 'Inventario actual'),
                        opcional(getJson(ENDPOINT_VR), 'Venta real'),
                        opcional(fetchDevolucionesPorMeses(mesesDev, anioCarga), 'Devoluciones')
                    ]);
                    if (seq !== cargaSeq) return;
                    raw = rawRes || [];
                    const invIniMap = new Map((invIniRows || []).map(x => [String(x.sku ?? '').toUpperCase().trim(), toNumber(x.invInicial)]));
                    const invActMap = new Map((invActRows || []).map(x => [String(x.sku ?? '').toUpperCase().trim(), toNumber(x.invActual)]));
                    devolucionesMapGlobal = buildDevolucionesMap(devRows);
                    data = normalizarData(raw, invIniMap, invActMap, buildVentaRealMap(vrRows), devolucionesMapGlobal);

                    poblarAnos(data); poblarCanales(data); poblarMasters(data); poblarClasificaciones(data); poblarTiposSku(data); poblarSkus(data);
                    if (!$selAnio.value) $selAnio.value = anioCarga;
                    if (!$selMes.value && !getTrimestresSeleccionados().length) $selMes.value = mesCarga;
                    ensurePager();
                    initMultiDropdown('dd-tri', 'multi-check-tri');
                    initMultiDropdown('dd-origen', 'multi-check-origen');
                    scheduleRender(0);
                    // CORRECCIÓN: si una fuente falla, antes las columnas quedaban en 0 sin avisar
                    if (faltantes.length) setTimeout(() => { const c = $('pc-conteo'); if (c) c.textContent += ` · ⚠ sin ${faltantes.join(', ').toLowerCase()} (se muestra en 0)`; }, 50);
                } catch (err) {
                    console.error(err);
                    if (seq === cargaSeq) $tbody.innerHTML = `<tr class="t-msg is-error"><td colspan="18">Error al cargar datos: ${escapeHtml(err.message)}</td></tr>`;
                }
            }

            /* ========================= Eventos ========================= */
            $form?.addEventListener('submit', e => { e.preventDefault(); state.page = 1; scheduleRender(); });
            $txtVendedores?.addEventListener('input', () => { state.page = 1; scheduleRender(250); });
            $selMes?.addEventListener('change', async () => {
                if ($selMes.value) { document.querySelectorAll('.multi-check-tri,.tri-check-all').forEach(ch => ch.checked = false); setMultiLabel('dd-tri', '.multi-check-tri'); }
                state.page = 1; await cargarTodo();
            });
            $selAnio?.addEventListener('change', async () => { state.page = 1; await cargarTodo(); });

            const TODOS = { 'canal-check-all': ['multi-check-canal', 'dd-canal'], 'master-check-all': ['multi-check-master', 'dd-master'], 'clasificacion-check-all': ['multi-check-clasificacion', 'dd-clasificacion'], 'tiposku-check-all': ['multi-check-tiposku', 'dd-tiposku'], 'sku-check-all': ['multi-check-sku', 'dd-sku'] };
            document.addEventListener('change', async e => {
                const cl = e.target.classList;
                if (!cl) return;
                if (cl.contains('tri-check-all')) {
                    document.querySelectorAll('.multi-check-tri').forEach(c => c.checked = e.target.checked);
                    setMultiLabel('dd-tri', '.multi-check-tri');
                    if (e.target.checked && $selMes) $selMes.value = '';
                    state.page = 1; await cargarTodo(); return;
                }
                for (const [todo, [cls, root]] of Object.entries(TODOS)) {
                    if (cl.contains(todo)) {
                        document.querySelectorAll('.' + cls).forEach(c => { if (c.closest('li')?.style.display !== 'none') c.checked = e.target.checked; });
                        setMultiLabel(root, '.' + cls);
                        state.page = 1; scheduleRender(0); return;
                    }
                }
                if (cl.contains('multi-check-tri')) {
                    const triChecks = Array.from(document.querySelectorAll('.multi-check-tri'));
                    const all = document.querySelector('.tri-check-all');
                    if (all) all.checked = triChecks.length > 0 && triChecks.every(c => c.checked);
                    if (getTrimestresSeleccionados().length && $selMes) $selMes.value = '';
                    setMultiLabel('dd-tri', '.multi-check-tri');
                    state.page = 1; await cargarTodo();
                }
            });

            $('btn-limpiar')?.addEventListener('click', async e => {
                e.preventDefault();
                $selMes.value = ""; $selAnio.value = "";
                if ($txtVendedores) $txtVendedores.value = "";
                document.querySelectorAll('.multi-check-tri,.multi-check-origen,.multi-check-canal,.multi-check-master,.multi-check-clasificacion,.multi-check-tiposku,.multi-check-sku,.tri-check-all,.canal-check-all,.master-check-all,.clasificacion-check-all,.tiposku-check-all,.sku-check-all').forEach(ch => ch.checked = false);
                ['dd-tri', 'dd-origen', 'dd-canal', 'dd-master', 'dd-clasificacion', 'dd-tiposku', 'dd-sku'].forEach(id => { const r = $(id); const l = r?.querySelector('.multi-label'); if (l) l.textContent = '(Todos)'; r?.querySelector('button.btn-select-like')?.classList.remove('has-selection'); });
                expanded.clear();
                state.sort.column = null; state.sort.direction = null;
                document.querySelectorAll('#tbl-data thead th[data-sort]').forEach(h => h.classList.remove('asc', 'desc'));
                state.page = 1;
                await cargarTodo();
            });

            document.addEventListener('click', async e => {
                const btnToggle = e.target.closest('[data-toggle]');
                if (btnToggle && btnToggle.closest('#tbl-data')) { e.preventDefault(); toggleRow(btnToggle.dataset.toggle); return; }
                const link = e.target.closest('.ped-link');
                if (!link) return;
                e.preventDefault();
                link.closest('table')?.querySelectorAll('.ped-link.is-active').forEach(x => x.classList.remove('is-active'));
                link.classList.add('is-active');
                const trimestre = String(link.dataset.trimestre || '').trim() || null;
                const vRaw = String(link.dataset.vendedor || '').trim();
                const vNum = Number(vRaw);
                await openPedidosInline(String(link.dataset.panelId || '').trim(), {
                    anio: Number(link.dataset.anio), mes: trimestre ? null : Number(link.dataset.mes), trimestre,
                    sku: String(link.dataset.sku || '').trim(), origen: String(link.dataset.origen || 'TODOS').trim(),
                    cliente: (link.dataset.cliente || '').trim() || null, canal: (link.dataset.canal || '').trim() || null,
                    vendedorId: vRaw && vRaw !== '0' && Number.isFinite(vNum) && vNum > 0 ? vNum : null
                });
            });

            $('btn-xlsx')?.addEventListener('click', e => { e.preventDefault(); conBloqueo(e.currentTarget, exportToExcel); });
            $('btn-csv')?.addEventListener('click', e => { e.preventDefault(); conBloqueo(e.currentTarget, exportToCsv); });

            initSorting();
            cargarTodo();
        })();
    </script>

    <script>
        /* ========================= Presupuesto vs cumplimiento (misma consulta) ========================= */
        (() => {
            const BTN_OPEN = document.getElementById('btn-sp');
            const modalEl = document.getElementById('modal-sp');
            if (!BTN_OPEN || !modalEl || !window.bootstrap?.Modal) return;
            const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            const SP_ENDPOINT = "/Comercial/ReporteVentasPresupuestoSPDetalle";
            const $ = id => document.getElementById(id);
            const $anio = $('sp-anio'), $ddMeses = $('dd-sp-meses'), $mesSearch = $('sp-meses-search'), $ven = $('sp-vendedores'), $cli = $('sp-clientes');
            const $run = $('sp-run'), $status = $('sp-status'), $tbody = document.querySelector('#sp-table tbody'), $call = $('sp-call');
            const num = n => new Intl.NumberFormat('es-MX', { maximumFractionDigits: 0 }).format(Math.round(Number(n || 0)));
            const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
            const getToken = () => document.querySelector('input[name="__RequestVerificationToken"]')?.value || "";
            const tokens = t => Array.from(new Set(String(t || '').toUpperCase().split(/[\s,;]+/g).map(x => x.trim()).filter(Boolean)));
            const mesChecks = () => Array.from(document.querySelectorAll('.multi-check-sp-mes'));
            const selectedMeses = () => mesChecks().filter(c => c.checked).map(c => Number(c.value));
            function refreshMesLabel() {
                const label = $ddMeses?.querySelector('.multi-label'); if (!label) return;
                const sel = mesChecks().filter(c => c.checked).map(c => c.dataset.text || c.value);
                label.textContent = !sel.length ? '(Todos)' : sel.length <= 2 ? sel.join(', ') : `${sel.length} seleccionados`;
                $ddMeses.querySelector('button')?.classList.toggle('has-selection', sel.length > 0);
            }
            const preselectCurrentMonth = () => { const m = String(new Date().getMonth() + 1); mesChecks().forEach(c => c.checked = c.value === m); refreshMesLabel(); };
            const clearMeses = () => { mesChecks().forEach(c => c.checked = false); refreshMesLabel(); };
            $mesSearch?.addEventListener('input', () => { const q = $mesSearch.value.trim().toUpperCase(); document.querySelectorAll('#dd-sp-meses .sp-meses-item').forEach(li => li.style.display = (li.textContent || '').toUpperCase().includes(q) ? '' : 'none'); });
            $('sp-meses-clear')?.addEventListener('click', e => { e.preventDefault(); clearMeses(); });
            $('sp-meses-apply')?.addEventListener('click', e => { e.preventDefault(); refreshMesLabel(); const btn = $ddMeses?.querySelector('[data-bs-toggle="dropdown"]'); if (btn) bootstrap.Dropdown.getOrCreateInstance(btn).hide(); });
            document.addEventListener('change', e => { if (e.target?.classList?.contains('multi-check-sp-mes')) refreshMesLabel(); });

            const setStatus = m => { if ($status) $status.textContent = m || ""; };
            function resetTable(msg = "Sin datos.") { $tbody.innerHTML = `<tr class="t-msg"><td colspan="8">${esc(msg)}</td></tr>`; const k = $('sp-kpis'); if (k) k.style.display = "none"; }
            function fillYears() {
                const y = new Date().getFullYear();
                $anio.innerHTML = '';
                for (let a = y - 2; a <= y + 1; a++) $anio.insertAdjacentHTML('beforeend', `<option value="${a}" ${a === y ? 'selected' : ''}>${a}</option>`);
            }
            const cumpClass = v => { const n = Number(v); if (!isFinite(n)) return ""; return n >= 80 ? "sp-cump-ok" : n >= 60 ? "sp-cump-warn" : "sp-cump-bad"; };
            const barClass = v => { const n = Number(v); return !isFinite(n) ? "sp-bar-bad" : n >= 80 ? "sp-bar-ok" : n >= 60 ? "sp-bar-warn" : "sp-bar-bad"; };
            function renderRows(rows) {
                if (!rows || !rows.length) { resetTable("Sin resultados."); return; }
                let tv = 0, tp = 0, tt = 0;
                // CORRECCIÓN: los datos del servidor se escapan antes de pintarlos
                $tbody.innerHTML = rows.map(r => {
                    const venta = Number(r.venta || 0), pres = Number(r.presupuesto || 0), tend = Number(r.tend || 0), cump = Number(r.cump || 0);
                    tv += venta; tp += pres; tt += tend;
                    const tendPct = pres > 0 ? (tend / pres) * 100 : 0;
                    return `<tr><td>${esc(r.clienteId)}</td><td title="${esc(r.razonSocial)}">${esc(r.razonSocial)}</td><td title="${esc(r.vendedorNombre)}">${esc(r.vendedorNombre)}</td><td>${esc(r.mes)}</td>
                                <td class="text-end" data-copy="${Math.round(venta)}">${num(venta)}</td><td class="text-end" data-copy="${Math.round(pres)}">${num(pres)}</td>
                                <td class="text-end ${cumpClass(cump)}" data-copy="${cump.toFixed(2)}">${cump.toFixed(2)}%</td>
                                <td class="text-end" data-copy="${Math.round(tend)}"><div class="sp-progress"><div class="sp-progress-bar ${barClass(tendPct)}" style="width:${Math.min(Math.max(tendPct, 0), 100)}%"></div></div><div class="sp-progress-label">${num(tend)}</div></td></tr>`;
                }).join('');
                const tc = tp > 0 ? (tv / tp) * 100 : 0;
                $('sp-kpi-venta').textContent = num(tv);
                $('sp-kpi-presupuesto').textContent = num(tp);
                const c = $('sp-kpi-cump'); c.textContent = tc.toFixed(2) + "%"; c.className = "sp-kpi-value " + cumpClass(tc);
                $('sp-kpi-tend').textContent = num(tt);
                $('sp-kpis').style.display = "grid";
            }
            async function runSP() {
                const Anio = Number($anio.value);
                let Meses = selectedMeses();
                if (!Meses.length) { preselectCurrentMonth(); Meses = selectedMeses(); }
                const Vendedores = tokens($ven.value), Clientes = tokens($cli.value);
                if ($call) $call.textContent = `EXEC dbo.Reporte_Ventas_Presupuesto\n  @@Anio  = ${Anio},\n  @@Meses = '${Meses.join(',')}';`;
                const token = getToken();
                if (!token) { setStatus("No se encontró el token de seguridad; recarga la página."); resetTable("Falta token."); return; }
                setStatus("Consultando…"); $run.disabled = true; resetTable("Cargando…");
                try {
                    const resp = await fetch(SP_ENDPOINT, { method: "POST", headers: { "Content-Type": "application/json", "RequestVerificationToken": token }, body: JSON.stringify({ Anio, Meses, Vendedores, Clientes }), cache: "no-store" });
                    if (!resp.ok) throw new Error("HTTP " + resp.status);
                    const rows = await resp.json();
                    renderRows(rows);
                    setStatus(rows?.length ? `${rows.length} registro(s)` : "");
                } catch (e) { console.error(e); setStatus("Error al consultar."); resetTable("Error al consultar."); }
                finally { $run.disabled = false; }
            }
            function limpiar() { fillYears(); if ($mesSearch) { $mesSearch.value = ''; $mesSearch.dispatchEvent(new Event('input')); } clearMeses(); preselectCurrentMonth(); $ven.value = ""; $cli.value = ""; setStatus(""); if ($call) $call.textContent = ""; resetTable(); }
            BTN_OPEN.addEventListener('click', e => { e.preventDefault(); limpiar(); modal.show(); });
            $run?.addEventListener('click', runSP);
            $('sp-clear')?.addEventListener('click', limpiar);
            [$ven, $cli].forEach(i => i?.addEventListener('keydown', e => { if (e.key === 'Enter') { e.preventDefault(); runSP(); } }));
        })();
    </script>
}
