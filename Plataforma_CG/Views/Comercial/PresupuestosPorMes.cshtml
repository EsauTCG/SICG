            // CORRECCIÓN: antes cada botón de exportar estaba conectado tres veces (botón visible,
            // botón oculto y barra oculta), y un solo clic descargaba el archivo hasta 3 veces.
            let exportando = false;
            async function conBloqueo(btn, fn) {
                if (exportando) return;
                exportando = true;
                const html = btn.innerHTML; btn.disabled = true; btn.innerHTML = '<i class="bi bi-hourglass-split"></i> Generando…';
                await new Promise(r => setTimeout(r, 30));
                try { fn(); } finally { exportando = false; btn.disabled = false; btn.innerHTML = html; }
            }
            function exportToExcel() {
                if (!window.XLSX) { alert("No se cargó la biblioteca de Excel."); return; }
