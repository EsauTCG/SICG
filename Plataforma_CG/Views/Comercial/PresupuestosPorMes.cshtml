                        <th class="text-end g-inv" data-sort="tendinv">Tendencia<span class="sort-ind"></span></th>
                        <th class="text-end g-inv" data-sort="variacion">Variación<span class="sort-ind"></span></th>
                    </tr>
                </thead>
                <tbody><tr class="t-msg"><td colspan="18">Cargando…</td></tr></tbody>
                <tfoot>
                    <tr>
                        <th colspan="3" class="text-end">Totales</th>
                        <th class="text-end sep" id="tot-planprod">0</th>
                        <th class="text-end" id="tot-producido">0</th>
                        <th class="text-end" id="tot-tendprod">0</th>
                        <th class="text-end" id="tot-alcprod">—</th>
                        <th class="text-end sep" id="tot-pres">0</th>
                        <th class="text-end" id="tot-surtido">0</th>
                        <th class="text-end" id="tot-vr">0</th>
                        <th class="text-end" id="tot-dev">0</th>
                        <th class="text-end" id="tot-tend">0</th>
                        <th class="text-end" id="tot-kg">0</th>
                        <th class="text-end" id="tot-alc">—</th>
                        <th class="text-end sep" id="tot-invini">0</th>
                        <th class="text-end" id="tot-invact">0</th>
                        <th class="text-end" id="tot-tendinv">0</th>
                        <th class="text-end" id="tot-var">0</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    </section>

    <footer class="statusbar">
        <span>Usuario: @(User?.Identity?.Name ?? "")</span>
        <span>Carnes G SA de CV</span>
        <span>Módulo: Presupuestos mes</span>
    </footer>
</div>

<!-- ===================== Modal Presupuesto vs cumplimiento ===================== -->
<div class="modal fade" id="modal-sp" tabindex="-1" aria-hidden="true" aria-labelledby="spTitulo">
    <div class="modal-dialog modal-dialog-scrollable modal-sp-wide">
        <div class="modal-content pcx-modal">
            <div class="modal-header">
                <h5 class="modal-title" id="spTitulo"><i class="bi bi-clipboard-data"></i> Presupuesto vs cumplimiento por cliente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="sp-filtros">
                    <div>
                        <label class="form-label" for="sp-anio">Año</label>
                        <select class="form-select" id="sp-anio"></select>
                    </div>
                    <div>
                        <label class="form-label">Mes(es)</label>
                        <div class="dropdown w-100" id="dd-sp-meses">
                            <button class="btn-select-like" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false"><span class="multi-label">(Todos)</span></button>
                            <ul class="dropdown-menu">
                                <li><input class="form-control" id="sp-meses-search" placeholder="Buscar mes…" aria-label="Buscar mes" /></li>
                                <li><hr class="dropdown-divider"></li>
                                @{
                                    var mesesNom = new[] { "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre" };
                                }
                                @for (var m = 1; m <= 12; m++)
                                {
                                    <li class="sp-meses-item"><div class="form-check"><input class="form-check-input multi-check-sp-mes" type="checkbox" value="@m" id="@($"sp_mes_{m}")" data-text="@mesesNom[m - 1]"><label class="form-check-label" for="@($"sp_mes_{m}")">@mesesNom[m - 1]</label></div></li>
                                }
                                <li><hr class="dropdown-divider"></li>
                                <li class="d-flex gap-2"><button type="button" class="pm-btn sm w-50" id="sp-meses-clear">Limpiar</button><button type="button" class="pm-btn pm-btn-primary sm w-50" id="sp-meses-apply">Aplicar</button></li>
                            </ul>
                        </div>
                    </div>
                    <div id="filtro-sp-vendedores">
                        <label class="form-label" for="sp-vendedores">Vendedor(es)</label>
                        <input class="form-control" id="sp-vendedores" placeholder="Nombre o código, separados por coma" />
                    </div>
                    <div>
                        <label class="form-label" for="sp-clientes">Cliente(s)</label>
                        <input class="form-control" id="sp-clientes" placeholder="Código o nombre, separados por coma" />
                    </div>
                    <div class="acciones">
                        <button class="pm-btn" type="button" id="sp-clear">Limpiar</button>
                        <button class="pm-btn pm-btn-primary" type="button" id="sp-run"><i class="bi bi-play-fill"></i> Consultar</button>
                    </div>
                </div>
                <div id="sp-status" role="status" aria-live="polite"></div>

                <div class="sp-kpis-bar" id="sp-kpis" style="display:none;">
                    <div class="sp-kpi-card sp-kpi-venta"><div class="sp-kpi-title">Venta</div><div class="sp-kpi-value" id="sp-kpi-venta">0</div></div>
                    <div class="sp-kpi-card sp-kpi-presupuesto"><div class="sp-kpi-title">Presupuesto</div><div class="sp-kpi-value" id="sp-kpi-presupuesto">0</div></div>
                    <div class="sp-kpi-card sp-kpi-cumplimiento"><div class="sp-kpi-title">Cumplimiento</div><div class="sp-kpi-value" id="sp-kpi-cump">0%</div></div>
                    <div class="sp-kpi-card sp-kpi-tendencia"><div class="sp-kpi-title">Tendencia</div><div class="sp-kpi-value" id="sp-kpi-tend">0</div></div>
                </div>

                <div class="table-responsive">
                    <table class="table sap-grid" id="sp-table">
                        <colgroup><col style="width:11%"><col style="width:27%"><col style="width:18%"><col style="width:7%"><col style="width:9%"><col style="width:9%"><col style="width:8%"><col style="width:11%"></colgroup>
                        <thead><tr><th>Cliente</th><th>Razón social</th><th>Vendedor</th><th>Mes</th><th class="text-end">Venta</th><th class="text-end">Presupuesto</th><th class="text-end">Cump. %</th><th class="text-end">Tendencia</th></tr></thead>
                        <tbody><tr class="t-msg"><td colspan="8">Sin datos.</td></tr></tbody>
                    </table>
                </div>
                <details>
                    <summary>Ver llamada generada</summary>
                    <pre id="sp-call"></pre>
                </details>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <script>
        (() => {
            'use strict';

            /* ========================= Ancho del panel Detalle / Pedidos ========================= */
            const DETAIL_SPLIT_STORAGE_KEY = 'presupuesto-consumo-detail-width';
            const DETAIL_SPLIT_DEFAULT = 560, DETAIL_SPLIT_MIN = 300, PEDIDOS_MIN = 280;
            const pmPage = () => document.querySelector('.pm-page');
            function leerAnchoGuardado() { try { return Number(localStorage.getItem(DETAIL_SPLIT_STORAGE_KEY)); } catch { return NaN; } }
            function setAnchoDetalle(px, guardar = true) {
                const root = pmPage(); if (!root) return;
                const ancho = Math.round(px);
                root.style.setProperty('--detalle-panel-width', `${ancho}px`);
                if (guardar) { try { localStorage.setItem(DETAIL_SPLIT_STORAGE_KEY, String(ancho)); } catch { } }
            }
            (() => { const g = leerAnchoGuardado(); setAnchoDetalle(Number.isFinite(g) && g >= DETAIL_SPLIT_MIN ? g : DETAIL_SPLIT_DEFAULT, false); })();
            const maxAncho = split => Math.max(DETAIL_SPLIT_MIN, split.getBoundingClientRect().width - PEDIDOS_MIN - 10);
            const anchoActual = () => { const v = parseFloat(getComputedStyle(pmPage()).getPropertyValue('--detalle-panel-width')); return Number.isFinite(v) ? v : DETAIL_SPLIT_DEFAULT; };

            document.addEventListener('pointerdown', e => {
                const resizer = e.target.closest?.('.detail-resizer'); if (!resizer) return;
                const split = resizer.closest('.detail-split'); if (!split) return;
                e.preventDefault();
                const startX = e.clientX;
                const startWidth = split.querySelector(':scope > .detail-box:first-child')?.getBoundingClientRect().width || DETAIL_SPLIT_DEFAULT;
                const max = maxAncho(split);
                resizer.classList.add('is-resizing'); document.body.classList.add('detail-resizing');
                try { resizer.setPointerCapture(e.pointerId); } catch { }
                const move = ev => setAnchoDetalle(Math.min(max, Math.max(DETAIL_SPLIT_MIN, startWidth + ev.clientX - startX)), false);
                const end = ev => {
                    resizer.classList.remove('is-resizing'); document.body.classList.remove('detail-resizing');
                    setAnchoDetalle(anchoActual(), true);
                    try { resizer.releasePointerCapture(ev.pointerId); } catch { }
                    resizer.removeEventListener('pointermove', move); resizer.removeEventListener('pointerup', end); resizer.removeEventListener('pointercancel', end);
                };
                resizer.addEventListener('pointermove', move); resizer.addEventListener('pointerup', end); resizer.addEventListener('pointercancel', end);
            });
            document.addEventListener('dblclick', e => {
                if (!e.target.closest?.('.detail-resizer')) return;
                try { localStorage.removeItem(DETAIL_SPLIT_STORAGE_KEY); } catch { }
                setAnchoDetalle(DETAIL_SPLIT_DEFAULT, false);
            });
            document.addEventListener('keydown', e => {
                const resizer = e.target.closest?.('.detail-resizer');
                if (!resizer || (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight')) return;
                e.preventDefault();
                const split = resizer.closest('.detail-split'); if (!split) return;
                setAnchoDetalle(Math.min(maxAncho(split), Math.max(DETAIL_SPLIT_MIN, anchoActual() + (e.key === 'ArrowLeft' ? -20 : 20))), true);
            });

            /* ========================= Endpoints y estado ========================= */
            const ENDPOINT_URL = "/Comercial/ReportePresupuestosMES";
            const ENDPOINT_INVINI = "/Comercial/InventarioInicialAyer";
            const ENDPOINT_INVACT = "/Comercial/InventarioActual";
            const ENDPOINT_PEDDET = "/Comercial/PedidosDetalle";
            const ENDPOINT_VR = "/Comercial/VentaRealResumen";
            const ENDPOINT_DM = "/Comercial/DevolucionesMeat";

            // Regla de acceso: vendedor/usuario normal ve todo; usuario ligado a CEDIS solo ve su CEDIS.
            let ES_USUARIO_CEDIS = false, VENDEDOR_IDS_ACTUALES = [], MODO_VENDEDOR_CARGADO = false;
            // CORRECCIÓN: antes se usaba sin declarar (variable global implícita)
            let devolucionesMapGlobal = new Map();

            const $ = id => document.getElementById(id);
            const $form = $('filtros'), $selMes = $('sel-mes'), $selAnio = $('sel-anio');
            const $canalList = $('dd-canal-list'), $txtVendedores = $('txt-vendedores'), $masterList = $('dd-master-list');
            const $clasificacionList = $('dd-clasificacion-list'), $tipoSkuList = $('dd-tiposku-list'), $skuList = $('dd-sku-list');
            const $tbody = document.querySelector('#tbl-data tbody');
            const $scrollBox = document.querySelector('.table-responsive-sticky');
            const $pmKpis = $('pm-kpis');

            let raw = [], data = [], grouped = [], view = [];
            const expanded = new Set();
            let pendingRestore = null;
            const state = { page: 1, pageSize: 100, maxPage: 1, sort: { column: null, direction: null } };

            const nfInt = new Intl.NumberFormat('es-MX', { maximumFractionDigits: 0 });
            const nfPct = new Intl.NumberFormat('es-MX', { maximumFractionDigits: 2, minimumFractionDigits: 2 });
            const num = n => nfInt.format(Math.round(Number(n || 0)));
            const pct = n => (isFinite(Number(n)) ? nfPct.format(Number(n)) : "—");
            const csvEscape = v => { const s = String(v ?? ""); return /[",\r\n]/.test(s) ? `"${s.replace(/"/g, '""')}"` : s; };
            function toNumber(v) {
                if (v == null) return 0;
                if (typeof v === 'number') return isFinite(v) ? v : 0;
                const s = String(v).trim(); if (!s) return 0;
                const n = Number(s.replace(/[^0-9.-]+/g, ''));
                return isFinite(n) ? n : 0;
            }
            function pickNumber(obj, ...keys) {
                for (const k of keys) if (obj && Object.prototype.hasOwnProperty.call(obj, k) && obj[k] != null) return toNumber(obj[k]);
                return 0;
            }
            const escapeHtml = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
            const idSeguro = s => String(s).replace(/[^a-zA-Z0-9_-]/g, '_');

            function trimestreToMes(tri) {
                return ({ 1: ["1", "2", "3"], 2: ["4", "5", "6"], 3: ["7", "8", "9"], 4: ["10", "11", "12"] })[Number(tri)] || [];
            }
            const getValoresSeleccionados = sel => Array.from(document.querySelectorAll(sel)).filter(c => c.checked).map(c => c.value);
            const getTrimestresSeleccionados = () => getValoresSeleccionados('.multi-check-tri').map(v => String(v || '').trim()).filter(Boolean);
            const getMesesSeleccionadosPorTrimestre = () => Array.from(new Set(getTrimestresSeleccionados().flatMap(trimestreToMes)));
            function progressClass(p) { const v = Number(p); if (!isFinite(v)) return 'progress-danger'; if (v >= 100) return 'progress-success'; if (v >= 80) return 'progress-warning'; return 'progress-danger'; }
            const pctClass = p => { const v = Number(p); return !isFinite(v) || v === 0 ? 'muted' : v >= 100 ? 'pct-ok' : v >= 80 ? 'pct-warn' : 'pct-bad'; };

            async function cargarModoVendedorActual() {
                if (MODO_VENDEDOR_CARGADO) return;
                try {
                    const resp = await fetch('/Comercial/UsuarioVendedorActual', { cache: 'no-store' });
                    if (!resp.ok) throw new Error('HTTP ' + resp.status);
                    const info = await resp.json();
                    ES_USUARIO_CEDIS = !!info.esCedis;
                    VENDEDOR_IDS_ACTUALES = Array.isArray(info.vendedorIds) ? info.vendedorIds : [];
                    MODO_VENDEDOR_CARGADO = true;
                    aplicarModoCedis();
                } catch (e) {
                    console.error('No se pudo cargar UsuarioVendedorActual:', e);
                    ES_USUARIO_CEDIS = false; VENDEDOR_IDS_ACTUALES = []; MODO_VENDEDOR_CARGADO = true;
                }
            }
            function aplicarModoCedis() {
                if (!ES_USUARIO_CEDIS) return;
                // Usuario CEDIS: se ocultan Origen y Vendedor; Canal queda visible pero solo con su CEDIS (lo limita el servidor).
                $('filtro-origen')?.classList.add('d-none');
                $('filtro-canal')?.classList.remove('d-none');
                $('filtro-vendedores')?.classList.add('d-none');
                $('filtro-sp-vendedores')?.classList.add('d-none');
                document.querySelectorAll('.multi-check-origen').forEach(ch => ch.checked = false);
                if ($txtVendedores) $txtVendedores.value = '';
                const spVen = $('sp-vendedores'); if (spVen) spVen.value = '';
            }

            let renderTimer;
            const scheduleRender = (delay = 120) => { clearTimeout(renderTimer); renderTimer = setTimeout(render, delay); };

            /* ========================= Paginador ========================= */
            let $pager, $pgSize, $pgPrev, $pgNext, $pgInfo;
            function ensurePager() {
                if ($pager) return;
                $pager = document.createElement('div');
                $pager.className = 'pc-pager';
                $pager.innerHTML = `<span>Filas por página</span>
                            <select id="pg-size" class="form-select" aria-label="Filas por página"><option>50</option><option selected>100</option><option>200</option><option>500</option></select>
                            <button class="pm-btn" id="pg-prev" aria-label="Página anterior"><i class="bi bi-chevron-left"></i></button>
                            <span id="pg-info">0–0 de 0</span>
                            <button class="pm-btn" id="pg-next" aria-label="Página siguiente"><i class="bi bi-chevron-right"></i></button>`;
                $scrollBox?.after($pager);
                $pgSize = $pager.querySelector('#pg-size'); $pgPrev = $pager.querySelector('#pg-prev'); $pgNext = $pager.querySelector('#pg-next'); $pgInfo = $pager.querySelector('#pg-info');
                $pgSize.addEventListener('change', () => { state.pageSize = +$pgSize.value; state.page = 1; scheduleRender(); });
                $pgPrev.addEventListener('click', () => { if (state.page > 1) { state.page--; scheduleRender(0); $scrollBox.scrollTop = 0; } });
                $pgNext.addEventListener('click', () => { if (state.page < state.maxPage) { state.page++; scheduleRender(0); $scrollBox.scrollTop = 0; } });
            }

            /* ========================= Filtros de selección múltiple ========================= */
            function setMultiLabel(rootId, itemSelector) {
                const root = $(rootId); if (!root) return;
                const label = root.querySelector('.multi-label'), btn = root.querySelector('button.btn-select-like');
                const sel = Array.from(document.querySelectorAll(itemSelector)).filter(c => c.checked);
                if (label) label.textContent = !sel.length ? '(Todos)' : sel.length <= 2 ? sel.map(c => c.dataset.text || c.value).join(', ') : `${sel.length} seleccionados`;
                btn?.classList.toggle('has-selection', sel.length > 0);
                if (btn) btn.title = sel.map(c => c.dataset.text || c.value).join(', ');
            }
            function initMultiDropdown(rootId, checkClass) {
                const root = $(rootId); if (!root) return;
                const refresh = () => { setMultiLabel(rootId, '.' + checkClass); state.page = 1; scheduleRender(0); };
                root.querySelectorAll('.' + checkClass).forEach(ch => { if (ch.dataset.boundMulti !== '1') { ch.addEventListener('change', refresh); ch.dataset.boundMulti = '1'; } });
                setMultiLabel(rootId, '.' + checkClass);
            }
            // CORRECCIÓN: los textos de canal, master, clasificación, tipo y SKU se escapan antes de pintarlos
            function opcionesHtml(items, checkClass, prefijo, prevSelected) {
                return items.map(({ value, texto }) => {
                    const id = `${prefijo}_${idSeguro(value)}`;
                    return `<li><div class="form-check"><input class="form-check-input ${checkClass}" type="checkbox" value="${escapeHtml(value)}" id="${id}" data-text="${escapeHtml(texto.split(' – ')[0])}" ${prevSelected.includes(value) ? 'checked' : ''}/><label class="form-check-label" for="${id}">${escapeHtml(texto)}</label></div></li>`;
                }).join('');
            }
            const cabeceraTodo = (cls, id) => `<li><div class="form-check"><input class="form-check-input ${cls}" type="checkbox" id="${id}"/><label class="form-check-label fw-bold" for="${id}">Seleccionar todo</label></div></li><li><hr class="dropdown-divider"></li>`;
            function poblarLista($lista, items, { checkClass, allClass, prefijo, rootId, vacio }) {
                if (!$lista) return;
                const prev = getValoresSeleccionados('.' + checkClass);
                $lista.innerHTML = items.length ? cabeceraTodo(allClass, prefijo + '_all') + opcionesHtml(items, checkClass, prefijo, prev) : `<li class="text-muted small p-2">${vacio}</li>`;
                initMultiDropdown(rootId, checkClass);
            }

            function poblarAnos(rows) {
                const years = Array.from(new Set(rows.map(r => r._anio).filter(Boolean))).sort((a, b) => Number(a) - Number(b));
                const current = $selAnio.value;
                $selAnio.innerHTML = `<option value="">(Todos)</option>` + years.map(y => `<option value="${escapeHtml(y)}">${escapeHtml(y)}</option>`).join('');
                if (current) $selAnio.value = current;
                if (!$selAnio.value) { const ya = String(new Date().getFullYear()); if (years.includes(ya)) $selAnio.value = ya; }
            }
            function poblarCanales(rows) {
                const canales = Array.from(new Set(rows.map(r => String(r._canal ?? r.canal ?? '').toUpperCase().trim()).filter(v => v && v !== '-'))).sort();
                poblarLista($canalList, canales.map(c => ({ value: c, texto: c })), { checkClass: 'multi-check-canal', allClass: 'canal-check-all', prefijo: 'canal', rootId: 'dd-canal', vacio: 'Sin canales.' });
            }
            function poblarMasters(rows) {
                const masters = Array.from(new Set(rows.map(r => String(r._master ?? '').toUpperCase().trim()).filter(v => v && v !== '-' && v !== 'UNDEFINED'))).sort();
                poblarLista($masterList, masters.map(m => ({ value: m, texto: m })), { checkClass: 'multi-check-master', allClass: 'master-check-all', prefijo: 'master', rootId: 'dd-master', vacio: 'Sin master.' });
            }
            function poblarClasificaciones(rows) {
                const items = Array.from(new Map(rows.filter(r => r._clasificacionId != null && String(r._clasificacionId).trim() !== '')
                    .map(r => [String(r._clasificacionId), { id: String(r._clasificacionId), nombre: String(r._clasificacionNombre || 'POR DEFINIR').toUpperCase().trim() }])).values())
                    .sort((a, b) => Number(a.id) - Number(b.id));
                poblarLista($clasificacionList, items.map(c => ({ value: c.id, texto: `${c.id} - ${c.nombre}` })), { checkClass: 'multi-check-clasificacion', allClass: 'clasificacion-check-all', prefijo: 'clasif', rootId: 'dd-clasificacion', vacio: 'Sin clasificaciones.' });
            }
            function poblarTiposSku(rows) {
                const items = Array.from(new Map(rows.filter(r => r._tipoSkuId != null && String(r._tipoSkuId).trim() !== '')
                    .map(r => [String(r._tipoSkuId).trim(), { id: String(r._tipoSkuId).trim(), nombre: String(r._tipoSkuDesc || 'POR DEFINIR').toUpperCase().trim() }])).values())
                    .sort((a, b) => Number(a.id) - Number(b.id));
                poblarLista($tipoSkuList, items.map(t => ({ value: t.id, texto: `${t.id} - ${t.nombre}` })), { checkClass: 'multi-check-tiposku', allClass: 'tiposku-check-all', prefijo: 'tiposku', rootId: 'dd-tiposku', vacio: 'Sin tipos SKU.' });
            }
            function poblarSkus(rows) {
                if (!$skuList) return;
                const prev = getValoresSeleccionados('.multi-check-sku');
                const skus = Array.from(new Map(rows.filter(r => r._sku).map(r => [r._sku, `${r._sku} – ${String(r._prod || r.productoNombre || '').trim()}`])).entries()).sort((a, b) => a[0].localeCompare(b[0]));
                $skuList.querySelectorAll('.sku-dyn-item, .dd-sku-loading').forEach(el => el.remove());
                const tmp = document.createElement('ul');
                tmp.innerHTML = cabeceraTodo('sku-check-all', 'sku_all') + opcionesHtml(skus.map(([v, t]) => ({ value: v, texto: t })), 'multi-check-sku', 'sku', prev);
                [...tmp.children].forEach(li => { li.classList.add('sku-dyn-item'); $skuList.appendChild(li); });
                const search = $('dd-sku-search');
                if (search && !search.dataset.bound) {
                    search.dataset.bound = '1';
                    search.addEventListener('input', () => {
                        const q = search.value.trim().toUpperCase();
                        $skuList.querySelectorAll('.sku-dyn-item').forEach(li => li.style.display = (!q || (li.textContent || '').toUpperCase().includes(q)) ? '' : 'none');
                    });
                    search.addEventListener('keydown', e => { e.stopPropagation(); if (e.key === 'Enter') e.preventDefault(); });
                }
                initMultiDropdown('dd-sku', 'multi-check-sku');
            }

            const parseTokens = text => Array.from(new Set(String(text || '').toUpperCase().split(/[\s,;]+/g).map(x => x.trim()).filter(Boolean)));
            function getFiltros() {
                const trimestres = getTrimestresSeleccionados();
                return {
                    Mes: trimestres.length ? "" : (($selMes.value || '').trim()),
                    Trimestres: trimestres,
                    Anio: ($selAnio.value || '').trim(),
                    Origenes: ES_USUARIO_CEDIS ? [] : getValoresSeleccionados('.multi-check-origen'),
                    Canales: getValoresSeleccionados('.multi-check-canal'),
