            const DIAS_HABILES = { sinDom: true, sinSab: true, sinFeriadosMX: true };
            const diasProdMes = (anio, mes) => contarDiasRango(new Date(Number(anio), Number(mes) - 1, 1), new Date(Number(anio), Number(mes), 0), DIAS_HABILES);
            function diasProdTransIncluyeHoy(anio, mes) {
                const hoy = new Date(), y = Number(anio), m = Number(mes);
                if (hoy.getFullYear() === y && (hoy.getMonth() + 1) === m) return contarDiasRango(new Date(y, m - 1, 1), new Date(hoy.getFullYear(), hoy.getMonth(), hoy.getDate()), DIAS_HABILES);
                if (y < hoy.getFullYear() || (y === hoy.getFullYear() && m < (hoy.getMonth() + 1))) return diasProdMes(y, m);
