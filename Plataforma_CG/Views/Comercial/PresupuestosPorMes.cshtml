                    </ul>
                </div>
            </div>
            <div>
                <label class="form-label">Master</label>
                <div class="dropdown w-100" id="dd-master">
                    <button class="btn-select-like" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false"><span class="multi-label">(Todos)</span></button>
                    <ul class="dropdown-menu" id="dd-master-list"><li class="text-muted small p-2">Cargando…</li></ul>
                </div>
            </div>
            <div>
                <label class="form-label">Clasificación</label>
                <div class="dropdown w-100" id="dd-clasificacion">
                    <button class="btn-select-like" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false"><span class="multi-label">(Todos)</span></button>
                    <ul class="dropdown-menu" id="dd-clasificacion-list"><li class="text-muted small p-2">Cargando…</li></ul>
                </div>
            </div>
            <div>
                <label class="form-label">Tipo SKU</label>
                <div class="dropdown w-100" id="dd-tiposku">
                    <button class="btn-select-like" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false"><span class="multi-label">(Todos)</span></button>
                    <ul class="dropdown-menu dropdown-menu-end" id="dd-tiposku-list"><li class="text-muted small p-2">Cargando…</li></ul>
                </div>
            </div>
        </form>
    </section>

    <section class="pc-kpis" id="pm-kpis" hidden>
        <div class="pc-grupo prod">
            <h3><span><i class="bi bi-gear"></i> Producción</span><span class="alc" title="Tendencia de producción ÷ plan">Alcance <span class="pc-alc-bar"><span id="pm-kpi-alcprod-bar"></span></span><b id="pm-kpi-alcprod">—</b></span></h3>
