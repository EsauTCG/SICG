            /* ========================= Detalle por origen y pedidos ========================= */
            async function fetchPedidosDetalle({ anio, mes, trimestre, sku, origen, cliente, canal, vendedorId }) {
                const trimestres = String(trimestre || '').split(',').map(x => x.trim()).filter(Boolean);
                async function consultar(triInd) {
                    const qs = new URLSearchParams({ anio, sku, origen: origen || "TODOS" });
                    if (triInd) qs.set("trimestre", triInd); else if (mes) qs.set("mes", mes);
                    if (cliente) qs.set("cliente", cliente);
                    if (canal) qs.set("canal", canal);
                    if (vendedorId != null) qs.set("vendedorId", vendedorId);
                    const resp = await fetch(`${ENDPOINT_PEDDET}?${qs}`, { cache: "no-store" });
                    if (!resp.ok) { let det = ""; try { const j = await resp.json(); det = j?.detalle || j?.msg || ""; } catch { } throw new Error(det || `HTTP ${resp.status}`); }
                    return await resp.json();
