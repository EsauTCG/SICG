                const wb = XLSX.utils.book_new();
                XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(resumen), "Resumen");
                XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(buildExportDetalleRows()), "Detalle");
