der-box}.section-title, .card-title{display:flex;align-items:center;justify-content:space-between;gap:5px;min-height:29px;padding:4px 6px;margin:0;background:var(--sap-header);color:#fff;font-size:10px;font-weight:600;border-bottom:1px solid #4a0000}.section-title .status{padding:2px 5px;border:1px solid rgba(255,255,255,.35);background:rgba(0,0,0,.15);font-size:8px;white-space:nowrap}.table-wrap{width:100%;max-width:100%;min-width:0;min-height:320px;height:var(--sku-work-height, clamp(330px, 52dvh, 620px));flex:1 1 auto;overflow:auto;background:var(--sap-surface);scrollbar-gutter:stable;box-sizing:border-box}.price-window table, .modal-backdrop-custom table{width:100%;min-width:1060px;table-layout:fixed;border-collapse:separate !important;border-spacing:0 !important;color:var(--sap-text);font-size:10.5px}.price-window thead th, .modal-backdrop-custom thead th{position:sticky;top:0;z-index:20;padding:5px 4px;border-right:1px solid rgba(0,0,0,.35);border-bottom:1px solid rgba(0,0,0,.45);background:var(--sap-header) !important;color:#fff !important;text-align:left;white-space:nowrap;font-size:9.4px;font-weight:600}.price-window tbody td, .modal-backdrop-custom tbody td{padding:4px;border-right:1px solid var(--sap-line);border-bottom:1px solid var(--sap-line);background:var(--sap-surface);color:var(--sap-text);overflow:hidden;text-overflow:ellipsis;white-space:nowrap;vertical-align:middle;font-size:10.5px;line-height:1.12}.price-window tbody tr:nth-child(even) td, .modal-backdrop-custom tbody tr:nth-child(even) td{background:var(--sap-panel-2)}.price-window tbody tr:hover td, .modal-backdrop-custom tbody tr:hover td{background:var(--sap-soft-2)}.price-window input[type="checkbox"]{width:15px;height:15px;min-width:15px;padding:0}.input-precio{width:88px !important;height:25px !important;text-align:right;font-family:Consolas, monospace !important;font-size:10.3px !important;font-weight:600}.badge-dif{display:inline-block;padding:2px 6px;font-family:Consolas, monospace;font-size:8.5px;font-weight:600;border-radius:0}.b-up{background:#dcfce7;color:#14532d;border:1px solid #86efac}.b-down{background:#fee2e2;color:#991b1b;border:1px solid #fca5a5}.b-zero{background:#f1f5f9;color:#64748b;border:1px solid #cbd5e1}.pager{display:flex;align-items:center;justify-content:space-between;gap:4px;padding:4px 5px;border-top:1px solid var(--sap-line);background:var(--sap-surface);flex-wrap:wrap}.pag-texto{min-width:155px;padding:4px 8px;border:1px solid var(--sap-line);background:var(--sap-soft);color:var(--sap-text);font-size:8.8px;font-weight:600;text-align:center}.panel-lateral{height:calc(var(--sku-work-height, clamp(330px, 52dvh, 620px)) + 34px);overflow:hidden}.panel-body{flex:1;min-height:0;padding:5px;display:flex;flex-direction:column;gap:5px;background:var(--sap-panel)}.caja-tags{flex:1;min-height:80px;overflow:auto;padding:4px;border:1px solid var(--sap-line);background:var(--sap-surface)}.session-kpi{padding:5px;border:1px solid var(--sap-line);background:var(--sap-panel-2);text-align:center}.session-kpi span{display:block;color:var(--sap-muted);font-size:8px;font-weight:600;text-transform:none}.session-kpi strong{display:block;margin-top:3px;color:var(--sap-brand);font-size:15px}.price-statusbar{display:flex;align-items:center;justify-content:space-between;gap:5px;padding:3px 6px;border-top:1px solid var(--sap-line);background:var(--sap-toolbar);color:var(--sap-muted);font-size:8.4px;flex-wrap:wrap}.modal-backdrop-custom{position:fixed;inset:0;z-index:2500;display:none;align-items:center;justify-content:center;padding:8px;background:rgba(0,0,0,.60)}.modal-backdrop-custom.show{display:flex}.modal-custom{width:min(1050px, 96vw);max-height:92dvh;overflow:auto;border:1px solid #5c0000;background:var(--sap-bg);box-shadow:0 10px 30px rgba(0,0,0,.25);padding:0}.modal-head{position:sticky;top:0;z-index:30;display:flex;align-items:center;justify-content:space-between;gap:5px;padding:5px 7px;margin:0;background:var(--sap-header);color:#fff}.mod