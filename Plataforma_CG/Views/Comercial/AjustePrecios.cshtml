<style>
@@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap');:root{--sap-bg:#f0dede;--sap-panel:#f8eeee;--sap-panel-2:#f1dede;--sap-surface:#fffafa;--sap-soft:#fff7f7;--sap-soft-2:#f4dddd;--sap-line:#c79d9d;--sap-line-dark:#8f4c4c;--sap-text:#3b1717;--sap-muted:#6a3a3a;--sap-brand:#8b0000;--sap-header:linear-gradient(180deg, #b30000 0%, #8b0000 55%, #5c0000 100%);--sap-toolbar:linear-gradient(#fff6f6, #ecd8d8);--sap-font:"Poppins", "Segoe UI", Arial, sans-serif;--sap-shadow:0 0 0 1px rgba(255,255,255,.45) inset, 0 8px 18px rgba(70,12,12,.14);--bg:var(--sap-bg);--panel:var(--sap-panel);--panel-2:var(--sap-panel-2);--line:var(--sap-line);--text:var(--sap-text)}body{margin:0 !important;padding:0 !important;overflow-x:hidden !important;background:transparent !important}body[data-theme="dark"]{--sap-bg:#0b1120;--sap-panel:#111827;--sap-panel-2:#182235;--sap-surface:#111827;--sap-soft:#1f2937;--sap-soft-2:#243044;--sap-line:#374151;--sap-line-dark:#4b5563;--sap-text:#f9fafb;--sap-muted:#9ca3af;--sap-header:linear-gradient(180deg, #7f1d1d 0%, #5f1212 55%, #2b0505 100%);--sap-toolbar:linear-gradient(180deg, #1f2937 0%, #111827 100%);--sap-shadow:0 10px 24px rgba(0,0,0,.35)}.app-shell, .app-shell *{box-sizing:border-box}.app-shell{width:100% !important;max-width:100% !important;min-width:0 !important;min-height:0;margin:0;padding:0;display:flex;flex-direction:column;font-family:var(--sap-font);font-size:10.8px;color:var(--sap-text);background:var(--sap-bg);box-sizing:border-box;container-type:inline-size;container-name:sku-price-app}.price-window{width:100% !important;max-width:100% !important;min-width:0 !important;min-height:0;margin:0 !important;padding:0 !important;display:flex;flex-direction:column;border:1px solid var(--sap-line-dark);background:var(--sap-panel);box-shadow:var(--sap-shadow);color:var(--sap-text);overflow:hidden;box-sizing:border-box}.price-header{display:flex;align-items:center;justify-content:space-between;gap:6px