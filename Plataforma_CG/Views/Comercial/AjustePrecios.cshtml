<style id="ajuste-precios-sku-erp-final">
    /* ===============================================================
       AJUSTE DE PRECIOS SKU — ESTILO ERP FINAL
       =============================================================== */

    body:not([data-theme="dark"]) {
        --aps-bg: #eef2f4 !important;
        --aps-panel: #ffffff !important;
        --aps-panel-2: #f7f9fa !important;
        --aps-line: #bec9cf !important;
        --aps-line-soft: #d3dce1 !important;
        --aps-text: #30373b !important;
        --aps-muted: #66747c !important;
        --aps-tinto: #7a2029 !important;
        --aps-tinto-dark: #5e1820 !important;
        --aps-tinto-soft: #f3e7e9 !important;

        --sap-bg: var(--aps-bg) !important;
        --sap-panel: var(--aps-panel) !important;
        --sap-panel-2: var(--aps-panel-2) !important;
        --sap-surface: #ffffff !important;
        --sap-soft: #f7f9fa !important;
        --sap-soft-2: #f3e7e9 !important;
        --sap-line: var(--aps-line) !important;
        --sap-line-dark: #aebbc3 !important;
        --sap-text: var(--aps-text) !important;
        --sap-muted: var(--aps-muted) !important;
        --sap-brand: var(--aps-tinto) !important;
        --sap-header:
            linear-gradient(
                180deg,
                #5a171d 0%,
                #481318 48%,
                #351014 100%
            ) !important;
        --sap-toolbar:
            linear-gradient(
                180deg,
                #f4f7f8 0%,
                #e8edef 100%
            ) !important;
        --sap-font: "Poppins", sans-serif !important;
    }

    /* ===============================================================
       TIPOGRAFÍA + ICONOS
       =============================================================== */
    body:not([data-theme="dark"]),
    body:not([data-theme="dark"]) button,
    body:not([data-theme="dark"]) input,
    body:not([data-theme="dark"]) select,
    body:not([data-theme="dark"]) textarea,
    body:not([data-theme="dark"]) table,
    body:not([data-theme="dark"]) .ajuste-precios-sku-app,
    body:not([data-theme="dark"]) .ajuste-precios-sku-app * {
        font-family: "Poppins", sans-serif !important;
        -webkit-font-smoothing: antialiased !important;
        -moz-osx-font-smoothing: grayscale !important;
        text-rendering: geometricPrecision !important;
    }

    body:not([data-theme="dark"]) .bi,
    body:not([data-theme="dark"]) .bi::before,
    body:not([data-theme="dark"]) [class^="bi-"],
    body:not([data-theme="dark"]) [class*=" bi-"] {
        font-family: "bootstrap-icons" !important;
        font-style: normal !important;
        font-weight: normal !important;
        font-variant: normal !important;
        text-transform: none !important;
        line-height: 1 !important;
    }

    /* ===============================================================
       ANCHO REAL CON SIDEBAR
       =============================================================== */
    html,
    body {
        width: 100% !important;
        max-width: 100% !important;
        overflow-x: hidden !important;
    }

    body:has(.ajuste-precios-sku-app) .layout-main-content {
        flex: 1 1 auto !important;
        width: 100% !important;
        max-width: 100% !important;
        min-width: 0 !important;
        overflow-x: hidden !important;
        overflow-y: visible !important;
        box-sizing: border-box !important;
    }

    body:has(.ajuste-precios-sku-app)
    .layout-main-content.layout-sidebar-open {
        width: calc(100% - var(--layout-sidebar-width)) !important;
        max-width: calc(100% - var(--layout-sidebar-width)) !important;
        margin-left: var(--layout-sidebar-width) !important;
    }

    body:has(.layout-sidebar.layout-hidden):has(.ajuste-precios-sku-app)
    .layout-main-content,

    body:has(.layout-sidebar.layout-hidden):has(.ajuste-precios-sku-app)
    .layout-main-content.layout-sidebar-open {
        width: calc(100% - var(--layout-sidebar-collapsed-width, 60px)) !important;
        max-width: calc(100% - var(--layout-sidebar-collapsed-width, 60px)) !important;
        margin-left: var(--layout-sidebar-collapsed-width, 60px) !important;
    }

    body:has(.ajuste-precios-sku-app)
    .layout-main-content .layout-container-fluid {
        width: 100% !important;
        max-width: 100% !important;
        min-width: 0 !important;
        margin: 0 !important;
        padding: 0 !important;
        box-sizing: border-box !important;
        overflow-x: hidden !important;
    }

    /* ===============================================================
       CONTENEDOR PRINCIPAL
       =============================================================== */
    body:not([data-theme="dark"]) .app-shell.ajuste-precios-sku-app {
        width: calc(100% - 12px) !important;
        max-width: none !important;
        min-width: 0 !important;

        margin: 6px auto 12px !important;
        padding: 0 !important;

        background: transparent !important;
        color: #30373b !important;

        box-sizing: border-box !important;
        overflow: visible !important;
    }

    body:not([data-theme="dark"]) .ajuste-precios-sku-app .price-window {
        width: 100% !important;
        max-width: 100% !important;
        min-width: 0 !important;

        margin: 0 !important;

        background: #fff !important;

        border: 1px solid #bec9cf !important;
        border-radius: 2px !important;

        box-shadow: none !important;
        overflow: hidden !important;
    }

    /* ===============================================================
       HEADER
       =============================================================== */
    body:not([data-theme="dark"]) .ajuste-precios-sku-app .price-header {
        min-height: 42px !important;

        padding: 6px 9px !important;

        background:
            linear-gradient(
                180deg,
                #5a171d 0%,
                #481318 48%,
                #351014 100%
            ) !important;

        color: #fff !important;

        border-bottom: 1px solid #351014 !important;
    }

    body:not([data-theme="dark"]) .ajuste-precios-sku-app .price-title-icon {
        width: 28px !important;
        height: 28px !important;

        flex: 0 0 28px !important;

        background: rgba(255,255,255,.08) !important;

        border: 1px solid rgba(255,255,255,.20) !important;
        border-radius: 2px !important;

        font-size: 11px !important;
        font-weight: 700 !important;
    }

    body:not([data-theme="dark"]) .ajuste-precios-sku-app .price-title h1 {
        color: #fff !important;

        font-size: 13px !important;
        font-weight: 700 !important;
    }

    body:not([data-theme="dark"]) .ajuste-precios-sku-app .price-title small {
        color: #e8d7da !important;

        font-size: 8.8px !important;
        font-weight: 400 !important;
    }

    body:not([data-theme="dark"]) .ajuste-precios-sku-app .header-source {
        min-height: 28px !important;

        padding: 3px 5px !important;

        background: rgba(255,255,255,.07) !important;

        border: 1px solid rgba(255,255,255,.18) !important;
        border-radius: 2px !important;

        font-size: 8.8px !important;
        font-weight: 600 !important;
    }

    body:not([data-theme="dark"]) .ajuste-precios-sku-app .header-source select {
        height: 24px !important;

        background: #fff !important;
        color: #30373b !important;

        border: 1px solid #c5d0d6 !important;
        border-radius: 2px !important;

        font-size: 9.2px !important;
        font-weight: 600 !important;
    }

    /* ===============================================================
       TOOLBAR / CAMPOS
       =============================================================== */
    body:not([data-theme="dark"]) .ajuste-precios-sku-app .price-toolbar {
        padding: 6px !important;
        gap: 5px !important;

        background:
            linear-gradient(
                180deg,
                #f4f7f8 0%,
                #e8edef 100%
            ) !important;

        border-bottom: 1px solid #bec9cf !important;
    }

    body:not([data-theme="dark"]) .ajuste-precios-sku-app .field label,
    body:not([data-theme="dark"]) .ajuste-precios-sku-app .panel-lateral label,
    body:not([data-theme="dark"]) .modal-backdrop-custom label {
        color: #3f474b !important;

        font-size: 9.3px !important;
