@section Scripts {
    @* CORRECCIÓN: jQuery y Bootstrap ya los carga _Layout2. Antes la vista los volvía a cargar
       (y ANTES que el layout), lo que duplicaba los menús desplegables y anulaba el aviso de sesión vencida. *@
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

    <script>
        /* =====================================================================
           BALANCE MASTER — misma lógica, fórmulas y endpoints.
           Cambios de comportamiento marcados con "CORRECCIÓN".
        ===================================================================== */

        // ---------- Base ----------
        const MES_SELECTOR = document.getElementById('mesSelector');
        let MES = (MES_SELECTOR && MES_SELECTOR.value) ? MES_SELECTOR.value : new Date().toISOString().slice(0, 7);
        const fmt = n => Number(n || 0).toLocaleString('es-MX', { maximumFractionDigits: 0 });
        const noCacheFetchOpts = { method: 'GET', credentials: 'same-origin', cache: 'no-store', headers: { 'Accept': 'application/json', 'Pragma': 'no-cache', 'Cache-Control': 'no-cache' } };

        const PERMISOS_VACIOS = () => ({
            presupuesto: { puedeLeer: false, puedeEscribir: false, puedeEliminar: false },
            produccion: { puedeLeer: false, puedeEscribir: false, puedeEliminar: false }
        });
        let permisosBalance = PERMISOS_VACIOS();

        async function cargarPermisosBalanceMaster() {
            try {
                const r = await fetch('/Comercial/ObtenerPermisosBalanceMaster', { credentials: 'same-origin' });
                permisosBalance = r.ok ? await r.json() : PERMISOS_VACIOS();
            } catch (e) {
                console.error('Error cargando permisos:', e);
                permisosBalance = PERMISOS_VACIOS();
            }
        }

        function obtenerMesCorto(numMes) {
            return ["ENE", "FEB", "MAR", "ABR", "MAY", "JUN", "JUL", "AGO", "SEP", "OCT", "NOV", "DIC"][parseInt(numMes, 10) - 1] || "";
        }
        let MES_CORTO = obtenerMesCorto((MES.split('-')[1] || "01"));

        function normalizeArrayResult(data, label) {
            if (data && typeof data === 'object' && !Array.isArray(data) && data.error) {
                console.warn(`[${label}] Backend devolvió error:`, data.error, data);
                return [];
            }
            return Array.isArray(data) ? data : [];
        }

        function estado(texto) {
            const el = document.getElementById('bmEstado');
            if (!el) return;
            el.innerHTML = texto ? `<span class="bm-spin" aria-hidden="true"></span> ${escHtml(texto)}` : '';
        }

        // ---------- Tendencias (proyección al cierre por días hábiles L–V) ----------
        function getWorkedDaysInMonthExcludingWeekends(year, month1to12) {
            const daysInMonth = new Date(year, month1to12, 0).getDate();
            let worked = 0;
            for (let d = 1; d <= daysInMonth; d++) { const dow = new Date(year, month1to12 - 1, d).getDay(); if (dow !== 0 && dow !== 6) worked++; }
            return worked;
        }
        function getElapsedWorkedDaysExcludingWeekends(year, month1to12, today = new Date()) {
            const isSameMonth = today.getFullYear() === year && (today.getMonth() + 1) === month1to12;
            const lastDay = isSameMonth ? today.getDate() : new Date(year, month1to12, 0).getDate();
            let elapsed = 0;
            for (let d = 1; d <= lastDay; d++) { const dow = new Date(year, month1to12 - 1, d).getDay(); if (dow !== 0 && dow !== 6) elapsed++; }
            return elapsed;
        }
        function getPaceContext() {
            const [yy, mm] = (MES || '').split('-').map(Number);
            return { yy, mm, totalWD: getWorkedDaysInMonthExcludingWeekends(yy, mm), elapsedWD: getElapsedWorkedDaysExcludingWeekends(yy, mm) };
        }
        function projectedMonthValue(actualTotal) {
            const a = Number(actualTotal ?? 0);
            const { totalWD, elapsedWD } = getPaceContext();
            if (elapsedWD <= 0 || totalWD <= 0) return 0;
            return (a / elapsedWD) * totalWD;
        }
        function renderTrendCellProjectedOnly(actualTotal) {
            if (actualTotal == null) return '—';
            const a = Number(actualTotal ?? 0);
            const proj = projectedMonthValue(a);
            const deltaKg = proj - a;
            const icon = deltaKg > 0 ? 'bi-arrow-up-right' : (deltaKg < 0 ? 'bi-arrow-down-right' : 'bi-dash');
            const cls = deltaKg > 0 ? 'text-success' : (deltaKg < 0 ? 'text-danger' : 'text-muted');
            return `<span class="${cls} fw-semibold" title="Real a la fecha: ${fmt(a)}"><i class="bi ${icon}"></i> ${fmt(proj)}</span>`;
        }
        function parseCellNumber(td) {
            if (!td) return 0;
            const n = parseFloat(String(td.textContent || '').replace(/,/g, '').trim());
            return Number.isFinite(n) ? n : 0;
        }
        // GAP con DISPONIBLE (carga inicial y totales) — sin cambios
        function calcGapProjected(prodReal, disponible, ventaReal) {
            return projectedMonthValue(Number(prodReal ?? 0)) + Number(disponible ?? 0) - projectedMonthValue(Number(ventaReal ?? 0));
        }
        // GAP con INVENTARIO (filtros y detalle) — sin cambios
        function calcGapProjectedByInv(prodReal, inventario, ventaReal) {
            return projectedMonthValue(Number(prodReal ?? 0)) + Number(inventario ?? 0) - projectedMonthValue(Number(ventaReal ?? 0));
        }
        const gapBadge = v => `<span class="${v < 0 ? 'badge-neg' : 'badge-pos'}">${fmt(v)}</span>`;

        // ---------- Estado ----------
        let LAST_OPEN_MASTER = null;
        let CURRENT_MODAL_MASTER = null;
        let CURRENT_MODAL_SKU = null;
        const CACHE_PRES = new Map();
        const CACHE_PROD = new Map();
        const CACHE_PROD_REAL = new Map();
        const CACHE_VENTA_REAL = new Map();
        const CACHE_INV_SKU = new Map();
        let MASTER_DATA = [];
        const BASE_MASTER_VIEW = new Map();
        let PRES_MODAL_RAW = [];

        const safeId = s => String(s ?? '').replace(/[^\w\-:.]/g, '_');
        const up = s => String(s ?? '').trim().toUpperCase();
        const getEl = (...ids) => ids.map(id => document.getElementById(id)).find(Boolean) || null;
        const escHtml = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
        // CORRECCIÓN: los selectores por master se escapan (un master con comillas rompía la búsqueda de su fila).
        const rowByMaster = (master) => document.querySelector(`tr.master-row[data-master="${CSS.escape(String(master ?? ''))}"]`);

        function snapshotBaseMasterView() {
            BASE_MASTER_VIEW.clear();
            (MASTER_DATA || []).forEach(m => {
                const master = String(m.u_MASTER ?? '').trim() || 'SIN MASTER';
                BASE_MASTER_VIEW.set(master, {
                    planProduccion: Number(m.planProduccion || 0),
                    produccionReal: Number(m.produccionReal ?? m.realTotalMaster ?? 0),
                    ventaReal: Number(m.ventaReal ?? m.ventaRealTotalMaster ?? 0),
                    presupuesto: Number(m.presupuesto || 0),
                    gap: Number(m.gap || 0),
                    porcentaje: Number(m.porcentaje || 0)
                });
            });
        }

        function updateMasterRowCells(master, { plan, real, venta, ventaReal, gap, porcentaje }) {
            const tr = rowByMaster(master);
            if (!tr) return;
            const tds = tr.querySelectorAll('td');
            if (tds[2] && plan != null) tds[2].textContent = fmt(plan);
            if (tds[3] && real != null) tds[3].textContent = fmt(real);
            if (tds[6] && venta != null) tds[6].textContent = fmt(venta);
            if (tds[7] && ventaReal != null) tds[7].textContent = fmt(ventaReal);
            if (tds[4]) tds[4].innerHTML = renderTrendCellProjectedOnly((real != null) ? Number(real) : parseCellNumber(tds[3]));
            if (tds[8]) tds[8].innerHTML = renderTrendCellProjectedOnly((ventaReal != null) ? Number(ventaReal) : parseCellNumber(tds[7]));
            if (tds[9]) {
                const invNow = Number(tr.getAttribute('data-inventario') ?? 0);
                const realNow = (real != null) ? Number(real) : parseCellNumber(tds[3]);
                const ventaRealNow = (ventaReal != null) ? Number(ventaReal) : parseCellNumber(tds[7]);
                tds[9].innerHTML = gapBadge(calcGapProjectedByInv(realNow, invNow, ventaRealNow));
            }
            if (tds[10] && porcentaje != null) tds[10].textContent = `${Number(porcentaje || 0).toFixed(0)}%`;
        }

