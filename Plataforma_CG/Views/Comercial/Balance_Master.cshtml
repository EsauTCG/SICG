@model TodoVentasModel
@{
    ViewData["Title"] = "Balance Master";
    Layout = "~/Views/Shared/_Layout2.cshtml";

    var mes = (string)(ViewData["Mes"] ?? DateTime.Now.ToString("yyyy-MM"));
    string mesCorto;
    if (!string.IsNullOrEmpty(mes) && mes.Length >= 7)
    {
        int año = int.Parse(mes.Substring(0, 4));
        int mesNum = int.Parse(mes.Substring(5, 2));
        mesCorto = new DateTime(año, mesNum, 1).ToString("MMM", new System.Globalization.CultureInfo("es-ES")).ToUpper().TrimEnd('.');
    }
    else
    {
        mesCorto = DateTime.Now.ToString("MMM", new System.Globalization.CultureInfo("es-ES")).ToUpper().TrimEnd('.');
    }
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    /* =====================================================================
           BALANCE MASTER · SIGO — hoja de estilos única
           Mismo sistema visual que el resto de módulos. Sustituye las 4 capas
           anteriores (incluidas las que forzaban el ancho del layout y del body).
           ===================================================================== */
    :root {
        --es-tinto: #8d3e46;
        --es-tinto-deep: #5c2229;
        --es-tinto-soft: #f7eced;
        --es-tinto-line: #e8d3d6;
        --es-paper: #f6f4f4;
        --es-surface: #ffffff;
        --es-field: #ffffff;
        --es-head: #faf7f7;
        --es-hover: #fcf9f9;
        --es-row-line: #f0eaeb;
        --es-ink: #231a1c;
        --es-muted: #76686b;
        --es-line: #e6dfe0;
        --es-line-strong: #cfc4c6;
        --es-ok: #2f7a55;
        --es-ok-bg: #e7f3ec;
        --es-warn: #9a6410;
        --es-warn-bg: #fbf1de;
        --es-bad: #b42d2d;
        --es-bad-bg: #fbe9e8;
        --es-info: #2f5d86;
        --es-info-bg: #e9f0f7;
        --es-teal: #2b7a72;
        --es-accent-col: #fbf6ea;
        --es-font: "Poppins", "Segoe UI", system-ui, -apple-system, Arial, sans-serif;
    }

    body[data-theme="dark"] {
        --es-tinto: #c56b74;
        --es-tinto-deep: #7a2d36;
        --es-tinto-soft: #3a2427;
        --es-tinto-line: #5a3439;
        --es-paper: #16181c;
        --es-surface: #202328;
        --es-field: #181a1e;
        --es-head: #262a30;
        --es-hover: #2a2e34;
        --es-row-line: #30343b;
        --es-ink: #edf0f3;
        --es-muted: #a9b0b9;
        --es-line: #363b43;
        --es-line-strong: #4a5059;
        --es-ok: #6cc596;
        --es-ok-bg: #1d3328;
        --es-warn: #e0b061;
        --es-warn-bg: #3a2f1b;
        --es-bad: #f08a83;
        --es-bad-bg: #3d2223;
        --es-info: #8bb8e0;
        --es-info-bg: #1e2b38;
        --es-teal: #6cc5ba;
        --es-accent-col: #2a2a22;
    }

    .bmx, .bmx-modal {
        font-family: var(--es-font) !important;
        color: var(--es-ink);
        font-size: 13px;
        line-height: 1.4;
    }

        .bmx *, .bmx-modal * {
            box-sizing: border-box;
        }

        .bmx .bi, .bmx-modal .bi {
            font-family: "bootstrap-icons" !important;
        }

    .bmx {
        background: var(--es-paper);
        padding: 16px 18px 10px;
        min-width: 0;
    }

    .number, .text-end {
        text-align: right !important;
        font-variant-numeric: tabular-nums;
    }

    .bmx .text-success, .bmx-modal .text-success {
        color: var(--es-ok) !important;
    }

    .bmx .text-danger, .bmx-modal .text-danger {
        color: var(--es-bad) !important;
    }

    .bmx .text-muted, .bmx-modal .text-muted {
        color: var(--es-muted) !important;
    }

    /* ---------- Encabezado ---------- */
    .bm-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 14px;
    }

    .bm-header__title {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .bm-header__icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: grid;
        place-items: center;
        background: var(--es-tinto);
        color: #fff;
        font-size: 19px;
    }

    .bm-header h1 {
        margin: 0;
        font-size: 20px;
        font-weight: 700;
        letter-spacing: -.01em;
        line-height: 1.15;
        color: var(--es-ink);
    }

    .bm-header p {
        margin: 2px 0 0;
        font-size: 12px;
        color: var(--es-muted);
    }

    .bm-header__actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    #bmEstado {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-size: 12px;
        color: var(--es-muted);
    }

    .bm-spin {
        display: inline-block;
        width: 13px;
        height: 13px;
        border: 2px solid var(--es-tinto-line);
        border-top-color: var(--es-tinto);
        border-radius: 50%;
        animation: bm-spin .8s linear infinite;
    }

    .bm-spin--light {
        border-color: rgba(255,255,255,.35);
        border-top-color: #fff;
    }

    @@keyframes bm-spin {
        to {
            transform: rotate(360deg);
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .bm-spin {
            animation-duration: 2s;
        }
    }

    /* ---------- Botones ---------- */
    .tbtn, .bmx .btn, .bmx-modal .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        height: 36px;
        padding: 0 14px;
        border: 1px solid var(--es-line-strong);
        border-radius: 7px;
        background: var(--es-field);
        color: var(--es-ink);
        font: 600 12.5px/1 var(--es-font);
        white-space: nowrap;
        cursor: pointer;
        box-shadow: none;
        transition: background .12s, border-color .12s, color .12s;
    }

        .tbtn:hover, .bmx .btn:hover, .bmx-modal .btn:hover {
            background: var(--es-tinto-soft);
            border-color: var(--es-tinto-line);
            color: var(--es-ink);
        }

        .tbtn:focus-visible, .bmx .btn:focus-visible, .bmx-modal .btn:focus-visible {
            outline: 2px solid var(--es-tinto);
            outline-offset: 2px;
            box-shadow: none;
        }

        .tbtn:disabled, .bmx .btn:disabled {
            opacity: .55;
            cursor: progress;
        }

        .tbtn.primary {
            background: var(--es-tinto);
            border-color: var(--es-tinto);
            color: #fff;
        }

            .tbtn.primary:hover {
                background: var(--es-tinto-deep);
                border-color: var(--es-tinto-deep);
                color: #fff;
            }

    .bmx .btn-sm, .bmx-modal .btn-sm {
        height: 30px;
        padding: 0 10px;
        font-size: 12px;
        border-radius: 6px;
    }

    .bmx .btn-danger, .bmx-modal .btn-danger {
        background: var(--es-tinto);
        border-color: var(--es-tinto);
        color: #fff;
    }

        .bmx .btn-danger:hover, .bmx-modal .btn-danger:hover {
            background: var(--es-tinto-deep);
            border-color: var(--es-tinto-deep);
            color: #fff;
        }

    /* ---------- Filtros ---------- */
    .bm-card {
        background: var(--es-surface);
        border: 1px solid var(--es-line);
        border-radius: 10px;
        min-width: 0;
    }

    .bm-filters {
        padding: 12px 14px;
        margin-bottom: 12px;
    }

    .bm-filters__grid {
        display: grid;
        grid-template-columns: 150px repeat(6, minmax(130px, 1fr)) auto;
        gap: 10px;
        align-items: end;
    }

    .bmx .form-label {
        display: block;
        margin: 0 0 5px;
        font-size: 12px;
        font-weight: 600;
        color: var(--es-muted);
    }

    .bmx .form-control, .bmx-modal .form-control {
        height: 36px;
        min-height: 36px;
        padding: 0 10px;
        border: 1px solid var(--es-line-strong);
        border-radius: 7px;
        background-color: var(--es-field);
        color: var(--es-ink);
        font: 500 13px/1.2 var(--es-font);
        box-shadow: none;
        width: 100%;
    }

        .bmx .form-control:focus, .bmx-modal .form-control:focus {
            border-color: var(--es-tinto);
            box-shadow: 0 0 0 3px rgba(141,62,70,.16);
            outline: none;
            background-color: var(--es-field);
            color: var(--es-ink);
        }

    body[data-theme="dark"] .bmx .form-control {
        color-scheme: dark;
    }

    .multi-sigo-btn {
        position: relative;
        text-align: left;
        padding-right: 28px !important;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        cursor: pointer;
    }

        .multi-sigo-btn::after {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            margin: 0 !important;
        }

        .multi-sigo-btn.has-value {
            border-color: var(--es-tinto) !important;
            background: var(--es-tinto-soft) !important;
            font-weight: 600 !important;
        }

    .bm-filters__actions {
        display: flex;
        gap: 8px;
    }

    .bm-filters__hint {
        margin-top: 10px;
        font-size: 11.5px;
        color: var(--es-muted);
    }

    .dropdown-menu.multi-sigo-menu {
        width: 320px;
        max-width: 92vw;
        padding: 0 !important;
        overflow: hidden;
        border: 1px solid var(--es-line-strong) !important;
        border-radius: 10px !important;
        background: var(--es-surface) !important;
        box-shadow: 0 12px 30px rgba(0,0,0,.16) !important;
    }

    .multi-sigo-search-wrap {
        padding: 8px;
        border-bottom: 1px solid var(--es-line);
    }

        .multi-sigo-search-wrap .form-control {
            height: 32px;
            min-height: 32px;
            font-size: 12.5px;
        }

    .multi-sigo-list {
        max-height: 260px;
        overflow-y: auto;
        padding: 4px;
    }

    .multi-sigo-item {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 7px 9px;
        border-radius: 6px;
        font-size: 12.5px;
        color: var(--es-ink);
        cursor: pointer;
        user-select: none;
        margin: 0;
    }

        .multi-sigo-item:hover {
            background: var(--es-tinto-soft);
        }

        .multi-sigo-item.selected {
            font-weight: 600;
        }

        .multi-sigo-item.select-all {
            border-bottom: 1px solid var(--es-line);
            border-radius: 6px 6px 0 0;
            margin-bottom: 2px;
            font-weight: 600;
        }

        .multi-sigo-item input[type="checkbox"] {
            width: 16px;
            height: 16px;
            flex: none;
            margin: 0;
            accent-color: var(--es-tinto);
            cursor: pointer;
        }

        .multi-sigo-item span {
            flex: 1;
            min-width: 0;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

    .multi-sigo-actions {
        display: flex;
        justify-content: space-between;
        gap: 8px;
        padding: 8px;
        border-top: 1px solid var(--es-line);
        background: var(--es-head);
    }

        .multi-sigo-actions .btn {
            flex: 1;
        }

    /* ---------- KPIs ---------- */
    .bm-kpis {
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 10px;
        margin-bottom: 12px;
    }

    .bm-kpi {
        position: relative;
        padding: 12px 14px;
        border-radius: 10px;
        background: var(--es-surface);
        border: 1px solid var(--es-line);
        border-top: 3px solid var(--k, var(--es-line-strong));
        min-width: 0;
    }

        .bm-kpi .bm-kpi__label {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 11.5px;
            font-weight: 600;
            color: var(--es-muted);
            letter-spacing: .03em;
        }

            .bm-kpi .bm-kpi__label i {
                color: var(--k);
            }

        .bm-kpi .bm-kpi__value {
            margin-top: 4px;
            font-size: clamp(18px, 1.5vw, 24px);
            font-weight: 700;
            color: var(--es-ink);
            font-variant-numeric: tabular-nums;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .bm-kpi .bm-kpi__unit {
            font-size: 11px;
            color: var(--es-muted);
        }

    .bm-kpi-plan {
        --k: var(--es-tinto);
    }

    .bm-kpi-prod-real {
        --k: var(--es-teal);
    }

    .bm-kpi-inv {
        --k: var(--es-info);
    }

    .bm-kpi-presup {
        --k: var(--es-warn);
    }

    .bm-kpi-venta-real {
        --k: var(--es-ok);
    }

    .bm-kpi-gap, .bm-kpi-gap-neutral {
        --k: var(--es-muted);
    }

        .bm-kpi-gap.bm-kpi-gap-ok {
            --k: var(--es-ok);
            background: var(--es-ok-bg);
        }

        .bm-kpi-gap.bm-kpi-gap-bad {
            --k: var(--es-bad);
            background: var(--es-bad-bg);
        }

        .bm-kpi-gap.bm-kpi-gap-ok .bm-kpi__value {
            color: var(--es-ok);
        }

        .bm-kpi-gap.bm-kpi-gap-bad .bm-kpi__value {
            color: var(--es-bad);
        }

    /* ---------- Tabla principal ---------- */
    .panel {
        background: var(--es-surface);
        border: 1px solid var(--es-line);
        border-radius: 10px;
        overflow: hidden;
        min-width: 0;
    }

    .panel-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
        padding: 10px 14px;
        border-bottom: 1px solid var(--es-line);
        font-size: 14px;
        font-weight: 600;
    }

        .panel-head i {
            color: var(--es-tinto);
        }

    .bm-leyenda {
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
        font-size: 11.5px;
        font-weight: 500;
        color: var(--es-muted);
    }

        .bm-leyenda span {
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

    .bm-sw {
        width: 12px;
        height: 12px;
        border-radius: 3px;
        display: inline-block;
        background: var(--es-accent-col);
        border: 1px solid var(--es-line-strong);
    }

    .tabla-scroll {
        overflow-x: auto;
        overflow-y: visible;
    }

    .bmx #tablaMaster, .bmx .detail-table, .bmx-modal .table {
        width: 100%;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
        font-size: 12.5px;
        color: var(--es-ink);
        --bs-table-bg: transparent;
        --bs-table-color: var(--es-ink);
        --bs-table-striped-bg: transparent;
        --bs-table-hover-bg: transparent;
        --bs-table-border-color: transparent;
    }

        .bmx #tablaMaster > :not(caption) > * > *, .bmx .detail-table > :not(caption) > * > *, .bmx-modal .table > :not(caption) > * > * {
            border-width: 0;
            box-shadow: none;
        }

    .bmx #tablaMaster {
        min-width: 1050px;
        table-layout: fixed;
    }

        .bmx #tablaMaster thead th {
            position: sticky;
            top: 0;
            z-index: 2;
            padding: 9px 10px;
            background: var(--es-head);
            border-bottom: 1px solid var(--es-line);
            color: var(--es-muted);
            font-size: 11.5px;
            font-weight: 600;
            white-space: nowrap;
            text-align: right;
        }

            .bmx #tablaMaster thead th:nth-child(1), .bmx #tablaMaster thead th:nth-child(2) {
                text-align: left;
            }

            .bmx #tablaMaster thead th span {
                color: var(--es-tinto);
                font-weight: 600;
            }

        .bmx #tablaMaster tbody td {
            padding: 7px 10px;
            border-bottom: 1px solid var(--es-row-line);
            background: var(--es-surface);
            vertical-align: middle;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .bmx #tablaMaster tbody tr.master-row:hover > td {
            background: var(--es-hover);
        }

        .bmx #tablaMaster > tbody > tr.master-row > td:nth-child(4),
        .bmx #tablaMaster > tbody > tr.master-row > td:nth-child(6),
        .bmx #tablaMaster > tbody > tr.master-row > td:nth-child(8) {
            background: var(--es-accent-col);
            font-weight: 600;
        }

        .bmx #tablaMaster > tbody > tr.master-row > td:nth-child(2) {
            font-weight: 600;
        }

        .bmx #tablaMaster th:nth-child(1), .bmx #tablaMaster td:nth-child(1) {
            width: 46px;
        }

        .bmx #tablaMaster th:nth-child(2), .bmx #tablaMaster td:nth-child(2) {
            width: 190px;
        }

        .bmx #tablaMaster tr.master-row.is-open > td {
            background: var(--es-tinto-soft) !important;
        }

    .bmx .t-msg td {
        padding: 34px 10px !important;
        text-align: center !important;
        color: var(--es-muted);
        white-space: normal !important;
    }

    .bmx .t-msg.is-error td {
        color: var(--es-bad);
        background: var(--es-bad-bg) !important;
    }

    .expander-btn {
        width: 28px !important;
        height: 28px !important;
        padding: 0 !important;
        border-radius: 6px !important;
    }

        .expander-btn i {
            transition: transform .15s;
        }

        .expander-btn[aria-expanded="true"] {
            background: var(--es-tinto) !important;
            border-color: var(--es-tinto) !important;
            color: #fff !important;
        }

            .expander-btn[aria-expanded="true"] i {
                transform: rotate(90deg);
            }

    .badge-pos, .badge-neg {
        display: inline-flex;
        align-items: center;
        justify-content: flex-end;
        min-width: 76px;
        height: 24px;
        padding: 0 9px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
    }

    .badge-pos {
        background: var(--es-ok-bg);
        color: var(--es-ok);
    }

    .badge-neg {
        background: var(--es-bad-bg);
        color: var(--es-bad);
    }

    /* Detalle por SKU */
    .bmx tr.detail-row > td {
        padding: 0 !important;
        background: var(--es-paper) !important;
        white-space: normal !important;
        overflow: visible !important;
    }

    .detail-compact {
        margin: 8px 10px 12px 46px;
        padding: 12px;
        border-radius: 10px;
        background: var(--es-surface);
        border: 1px solid var(--es-line);
        box-shadow: inset 3px 0 0 var(--es-tinto);
    }

        .detail-compact .detail-title {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 8px;
            margin-bottom: 8px;
            font-size: 13px;
            font-weight: 600;
        }

        .detail-compact .detail-table {
            min-width: 900px;
            table-layout: auto;
        }

            .detail-compact .detail-table th {
                padding: 7px 8px;
                background: var(--es-head);
                border-bottom: 1px solid var(--es-line);
                color: var(--es-muted);
                font-size: 11.5px;
                font-weight: 600;
                white-space: nowrap;
            }

            .detail-compact .detail-table td {
                padding: 6px 8px;
                border-bottom: 1px solid var(--es-row-line);
                white-space: nowrap;
                vertical-align: middle;
            }

                .detail-compact .detail-table td:nth-child(2) {
                    max-width: 280px;
                    overflow: hidden;
                    text-overflow: ellipsis;
                }

            .detail-compact .detail-table tbody tr:hover td {
                background: var(--es-hover);
            }

            .detail-compact .detail-table tfoot th {
                padding: 8px;
                background: var(--es-head);
                border-top: 1px solid var(--es-line);
                font-weight: 700;
            }

            .detail-compact .detail-table .btn {
                height: 28px;
                padding: 0 9px;
                font-size: 11.5px;
            }

        .detail-compact .detail-nota {
            margin-top: 8px;
            font-size: 11.5px;
            color: var(--es-muted);
        }

    .statusbar {
        display: flex;
        gap: 18px;
        flex-wrap: wrap;
        padding: 8px 2px 0;
        font-size: 11.5px;
        color: var(--es-muted);
    }

    /* ---------- Modales ---------- */
    .bmx-modal.modal-content {
        border: 0;
        border-radius: 12px;
        overflow: hidden;
        background: var(--es-surface);
        box-shadow: 0 18px 50px rgba(35,26,28,.25);
    }

    .bmx-modal .modal-header {
        padding: 13px 18px;
        background: var(--es-tinto-deep);
        color: #fff;
        border-bottom: 0;
    }

    .bmx-modal .modal-title {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 15px;
        font-weight: 600;
        color: #fff;
    }

    .bmx-modal .btn-close {
        filter: invert(1) grayscale(1) brightness(2);
        opacity: .9;
    }

    .bmx-modal .modal-body {
        background: var(--es-paper);
        padding: 14px 16px;
    }

    .bmx-modal .modal-footer {
        background: var(--es-head);
        border-top: 1px solid var(--es-line);
    }

    .bmx-modal .bm-modal-ayuda {
