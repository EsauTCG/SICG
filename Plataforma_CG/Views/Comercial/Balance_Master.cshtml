        // ---------- CSRF ----------
        function getCsrfToken() { return document.querySelector('.bmx input[name="__RequestVerificationToken"]')?.value || document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''; }
        function getRequestVerificationToken() { return getCsrfToken(); }

        // ---------- Endpoints ----------
        function parametrosMes(master) { const [anio, mes] = MES.split('-'); return { U_MASTER: master, mes: parseInt(mes, 10), anio: parseInt(anio, 10) }; }
        function cargarPresupuestosPorMaster(master) { return $.ajax({ url: "/Comercial/ObtenerPresupuestosPorMaster", type: "GET", cache: false, data: parametrosMes(master) }); }
        function cargarProduccionPorMaster(master) { return $.ajax({ url: "/Comercial/ObtenerPlanProduccionPorMaster", type: "GET", cache: false, data: parametrosMes(master) }); }
        function cargarProduccionRealPorMaster(master) { return $.ajax({ url: "/Comercial/ObtenerPlanProduccionRealPorMaster", type: "GET", cache: false, data: parametrosMes(master) }); }
        function cargarVentaRealPorMaster(master) { return $.ajax({ url: "/Comercial/ObtenerVentaRealPorMaster", type: "GET", cache: false, data: parametrosMes(master) }); }

        // CORRECCIÓN: el inventario actual es el mismo para todos los masters; antes se descargaba
        // completo cada vez que se abría el detalle de un master distinto. Ahora se pide una vez por carga.
        let INVENTARIO_PROMESA = null;
        function cargarInventarioPorMaster(master) {
            if (!INVENTARIO_PROMESA) {
                INVENTARIO_PROMESA = Promise.resolve($.ajax({ url: "/Comercial/InventarioActual", type: "GET", cache: false }))
                    .catch(e => { INVENTARIO_PROMESA = null; throw e; });
            }
            return INVENTARIO_PROMESA;
        }

        // ---------- Normalizadores ----------
        const realSku = (x) => String(x?.articuloCodigo ?? x?.ArticuloCodigo ?? x?.productoCodigo ?? x?.ProductoCodigo ?? '').trim();
        const realName = (x) => String(x?.producto ?? x?.Producto ?? x?.productoNombre ?? x?.ProductoNombre ?? '').trim();
        const realKg = (x) => Number(x?.kgProducidos ?? x?.KgProducidos ?? x?.KGPRODUCIDOS ?? 0) || 0;
        const sumKgReal = list => (list || []).reduce((a, x) => a + realKg(x), 0);
        const ventaSku = (x) => String(x?.articulo ?? x?.Articulo ?? x?.sku ?? x?.Sku ?? x?.articuloCodigo ?? x?.ArticuloCodigo ?? '').trim();
        const ventaName = (x) => String(x?.productoNombre ?? x?.ProductoNombre ?? x?.producto ?? x?.Producto ?? '').trim();
        const ventaKg = (x) => Number(x?.kgVendidos ?? x?.KgVendidos ?? x?.kgSurtido ?? x?.KgSurtido ?? x?.kg ?? x?.Kg ?? 0) || 0;
        const sumKgVentaReal = list => (list || []).reduce((a, x) => a + ventaKg(x), 0);
        const invSku = (x) => String(x?.sku ?? x?.SKU ?? x?.productoCodigo ?? x?.ProductoCodigo ?? x?.articuloCodigo ?? x?.ArticuloCodigo ?? '').trim();
        const invName = (x) => String(x?.productoNombre ?? x?.ProductoNombre ?? x?.producto ?? x?.Producto ?? '').trim();
        const invQty = (x) => Number(x?.invActual ?? x?.InvActual ?? x?.inventario ?? x?.Inventario ?? x?.existencia ?? x?.Existencia ?? x?.stock ?? x?.Stock ?? 0) || 0;

        function agruparPorSku(list, skuFn, nameFn, valFn) {
            const map = new Map();
            (list || []).forEach(x => {
                const sku = skuFn(x);
                if (!sku) return;
                const name = nameFn(x);
                const obj = map.get(sku) || { sku, name, sum: 0 };
                obj.sum += valFn(x);
                if (!obj.name && name) obj.name = name;
                map.set(sku, obj);
            });
            return Array.from(map.values());
        }
        const groupSumInventarioBySku = list => agruparPorSku(list, invSku, invName, invQty);
        const groupSumBySku = (list, skuField, nameField, valueField) => agruparPorSku(list, x => String(x[skuField] ?? '').trim(), x => x[nameField] ?? '', x => Number(x[valueField] ?? 0));
        const groupSumRealBySku = list => agruparPorSku(list, realSku, realName, realKg);
        const groupSumVentaRealBySku = list => agruparPorSku(list, ventaSku, ventaName, ventaKg);

        // ---------- Carga en paralelo por master (6 a la vez) ----------
        async function prefetchCache(masters, cache, loader, label) {
            const toFetch = (masters || []).filter(Boolean).filter(m => !cache.has(m));
            if (!toFetch.length) return;
            let idx = 0;
            async function worker() {
                while (idx < toFetch.length) {
                    const master = toFetch[idx++];
                    try { cache.set(master, normalizeArrayResult(await loader(master), `${label} ${master}`)); }
                    catch { cache.set(master, []); }
                }
            }
            await Promise.all(Array.from({ length: 6 }, worker));
        }
        const prefetchPresOnly = m => prefetchCache(m, CACHE_PRES, cargarPresupuestosPorMaster, 'Pres');
        const prefetchRealOnly = m => prefetchCache(m, CACHE_PROD_REAL, cargarProduccionRealPorMaster, 'Real');
        const prefetchVentaRealOnly = m => prefetchCache(m, CACHE_VENTA_REAL, cargarVentaRealPorMaster, 'VentaReal');
        async function prefetchForMasters(masters) {
            await Promise.all([prefetchPresOnly(masters), prefetchCache(masters, CACHE_PROD, cargarProduccionPorMaster, 'Plan')]);
        }

        function mastersScopeForLookups() {
            const mastersAll = (MASTER_DATA || []).map(x => x.u_MASTER).filter(Boolean);
            const sel = (getFilterState?.() || {}).masters || [];
            return sel.length ? mastersAll.filter(m => sel.includes(up(m))) : mastersAll;
        }

        // ---------- Opciones de los filtros ----------
        async function loadClasificacionOptions() {
            const masters = mastersScopeForLookups();
            await prefetchForMasters(masters);
            await prefetchRealOnly(masters);
            await prefetchVentaRealOnly(masters);
            const map = new Map();
            const addClas = (item) => {
                const id = String(item?.clasificacionId ?? item?.ClasificacionId ?? '').trim();
                const nombre = String(item?.clasificacionNombre ?? item?.ClasificacionNombre ?? '').trim();
                if (!id && !nombre) return;
                const value = up(id || nombre);
                if (!map.has(value)) map.set(value, { value, label: id && nombre ? `${id} - ${nombre}` : (nombre || id) });
            };
            for (const m of masters) {
                (CACHE_PRES.get(m) || []).forEach(addClas);
                (CACHE_PROD.get(m) || []).forEach(addClas);
                (CACHE_PROD_REAL.get(m) || []).forEach(addClas);
                (CACHE_VENTA_REAL.get(m) || []).forEach(addClas);
            }
            return Array.from(map.values()).sort((a, b) => a.label.localeCompare(b.label));
        }
        async function opcionesPresupuestoPorFuente(fuente, campo) {
            const masters = mastersScopeForLookups();
            await prefetchPresOnly(masters);
            const set = new Set();
            for (const m of masters) {
                for (const p of (CACHE_PRES.get(m) || [])) {
                    if (up(p.fuente) !== fuente) continue;
                    const v = campo(p);
                    if (v) set.add(v);
                }
            }
            return Array.from(set).sort((a, b) => a.localeCompare(b));
        }
        const loadClientesOptions = () => opcionesPresupuestoPorFuente('GENERAL', p => String(p.razonSocial || '').trim());
        const loadVendedoresOptions = () => opcionesPresupuestoPorFuente('VENDEDOR', p => String(p.razonSocial || '').trim());
        const loadCedisOptions = () => opcionesPresupuestoPorFuente('CEDIS', p => String(p.canalVta || '').trim() || String(p.razonSocial || '').trim());

        async function loadSkuOptions() {
            const masters = mastersScopeForLookups();
            await prefetchForMasters(masters);
            await prefetchRealOnly(masters);
            const map = new Map();
            const add = (sku, name) => {
                const s = up(String(sku || '').trim());
                if (!s) return;
                const n = String(name || '').trim();
                if (!map.get(s) && n) map.set(s, n); else if (!map.has(s)) map.set(s, '');
            };
            for (const m of masters) {
                for (const p of (CACHE_PRES.get(m) || [])) add(p.productoCodigo, p.productoNombre);
                for (const pr of (CACHE_PROD.get(m) || [])) add(pr.productoCodigo, pr.productoNombre);
                for (const rr of (CACHE_PROD_REAL.get(m) || [])) add(realSku(rr), realName(rr));
            }
            return Array.from(map.entries()).map(([sku, name]) => ({ sku, name })).sort((a, b) => a.sku.localeCompare(b.sku));
        }

        // ---------- Estado de filtros ----------
        function getFilterState() {
            const lista = (id, mayus) => { const v = String(getEl(id)?.value || '').trim(); return v ? v.split(',').map(x => mayus ? up(x.trim()) : x.trim()).filter(Boolean) : []; };
            return {
                fuente: up(getEl('fFuente')?.value || 'TODOS'),
                clientes: lista('fCliente', false),
                vendedores: lista('fVendedor', false),
                cedisList: lista('fCedis', false),
                masterRaw: String(getEl('fMaster')?.value || '').trim(),
                masters: lista('fMaster', true),
                skuRaw: String(getEl('fSku')?.value || '').trim(),
                skus: lista('fSku', true),
                clasificacionRaw: String(getEl('fClasificacion')?.value || '').trim(),
                clasificaciones: lista('fClasificacion', true)
            };
        }
        function isAnyFilterActive(s) {
            return !!s && ((s.fuente && s.fuente !== 'TODOS') || s.clientes?.length || s.vendedores?.length || s.cedisList?.length || s.masters?.length || s.skus?.length || s.clasificaciones?.length);
        }
        function filtrarPorClasificacion(data, state) {
            if (!(state.clasificaciones && state.clasificaciones.length)) return data;
            const setClas = new Set(state.clasificaciones.map(up));
            return data.filter(x => setClas.has(up(String(x.clasificacionId ?? x.ClasificacionId ?? '').trim())) || setClas.has(up(String(x.clasificacionNombre ?? x.ClasificacionNombre ?? '').trim())));
        }
        function filtrarPresupuesto(list, state) {
            let data = [...(list || [])];
            const hasClas = (list || []).some(x => x.clasificacionId != null || x.ClasificacionId != null || x.clasificacionNombre != null || x.ClasificacionNombre != null);
            if (hasClas) data = filtrarPorClasificacion(data, state);
            if (state.skus && state.skus.length) { const s = new Set(state.skus.map(up)); data = data.filter(x => s.has(up(String(x.productoCodigo ?? '').trim()))); }
            if (state.fuente && state.fuente !== 'TODOS') data = data.filter(x => up(x.fuente) === state.fuente);
            else {
                if (state.clientes?.length) data = data.filter(x => up(x.fuente) === 'GENERAL');
                if (state.vendedores?.length) data = data.filter(x => up(x.fuente) === 'VENDEDOR');
                if (state.cedisList?.length) data = data.filter(x => up(x.fuente) === 'CEDIS');
            }
            if (state.clientes?.length) { const s = new Set(state.clientes.map(up)); data = data.filter(x => s.has(up(String(x.razonSocial ?? '').trim()))); }
            if (state.vendedores?.length) { const s = new Set(state.vendedores.map(up)); data = data.filter(x => s.has(up(String(x.razonSocial ?? '').trim()))); }
            if (state.cedisList?.length) { const s = new Set(state.cedisList.map(up)); data = data.filter(x => s.has(up(String(x.canalVta ?? '').trim())) || s.has(up(String(x.razonSocial ?? '').trim()))); }
            return data;
        }
        function filtrarProduccion(list, state) {
            let data = filtrarPorClasificacion([...(list || [])], state);
            if (state.skus && state.skus.length) { const s = new Set(state.skus.map(up)); data = data.filter(x => s.has(up(String(x.productoCodigo ?? '').trim()))); }
            return data;
        }
        function filtrarProduccionReal(list, state) {
            let data = filtrarPorClasificacion([...(list || [])], state);
            if (state.skus && state.skus.length) { const s = new Set(state.skus.map(up)); data = data.filter(x => s.has(up(realSku(x)))); }
            return data;
        }
        function filtrarVentaReal(list, state) {
            let data = filtrarPorClasificacion([...(list || [])], state);
            if (state.skus && state.skus.length) { const s = new Set(state.skus.map(up)); data = data.filter(x => s.has(up(ventaSku(x)))); }
            const pick = (obj, names) => { for (const n of names) { const v = obj?.[n]; if (v != null) { const s = String(v).trim(); if (s) return s; } } return ''; };
            const fCliente = ['razonSocial', 'RazonSocial', 'cliente', 'Cliente', 'cardName', 'CardName', 'nombreCliente', 'NombreCliente'];
            const fVendedor = ['vendedor', 'Vendedor', 'nombreVendedor', 'NombreVendedor', 'asesor', 'Asesor', 'slpName', 'SlpName', 'salesPerson', 'SalesPerson'];
            const fCedis = ['cedis', 'Cedis', 'canalVta', 'CanalVta', 'almacen', 'Almacen', 'warehouse', 'Warehouse', 'sucursal', 'Sucursal'];
            const sample = data.slice(0, 30);
            const hasCliente = sample.some(x => pick(x, fCliente)), hasVendedor = sample.some(x => pick(x, fVendedor)), hasCedis = sample.some(x => pick(x, fCedis));
            if (state.clientes?.length) {
                if (!hasCliente) console.warn('[VentaReal] No hay campos de CLIENTE en la data. Se omite filtro por cliente.');
                else { const s = new Set(state.clientes.map(up)); data = data.filter(x => s.has(up(pick(x, fCliente)))); }
            }
            if (state.vendedores?.length) {
                if (!hasVendedor) console.warn('[VentaReal] No hay campos de VENDEDOR en la data. Se omite filtro por vendedor.');
                else { const s = new Set(state.vendedores.map(up)); data = data.filter(x => s.has(up(pick(x, fVendedor)))); }
            }
            if (state.cedisList?.length) {
                if (!hasCedis && !hasCliente) console.warn('[VentaReal] No hay campos de CEDIS/CLIENTE en la data. Se omite filtro por cedis.');
                else { const s = new Set(state.cedisList.map(up)); data = data.filter(x => s.has(up(pick(x, fCedis))) || s.has(up(pick(x, fCliente)))); }
            }
            return data;
        }

        // ---------- KPIs ----------
        function updateBalanceGapKpiClass(totalGap) {
            const card = document.querySelector('.bm-kpi-gap');
            if (!card) return;
            const v = Number(totalGap || 0);
            card.classList.remove('bm-kpi-gap-ok', 'bm-kpi-gap-bad', 'bm-kpi-gap-neutral');
            card.classList.add(v < 0 ? 'bm-kpi-gap-bad' : (v > 0 ? 'bm-kpi-gap-ok' : 'bm-kpi-gap-neutral'));
        }
        function setKpis({ TotalProd, TotalProdReal, TotalInv, TotalInvIdeal, TotalDisp, TotalVenta, TotalVentaReal, TotalGap, TotalPorcentaje }) {
            const set = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };
            set('tProd', fmt(TotalProd)); set('tProdReal', fmt(TotalProdReal)); set('tInv', fmt(TotalInv));
            set('tInvIdeal', fmt(TotalInvIdeal)); set('tDisp', fmt(TotalDisp)); set('tVenta', fmt(TotalVenta));
            set('tVentaReal', fmt(TotalVentaReal)); set('tGap', fmt(TotalGap)); set('tPorcentaje', String(TotalPorcentaje ?? 0));
            updateBalanceGapKpiClass(TotalGap);
        }
        function computeTotalsFromMasterRows(rows) {
            const data = rows || [];
            const sum = f => data.reduce((a, b) => a + Number(f(b) || 0), 0);
            return {
                TotalProd: sum(b => b.planProduccion),
                TotalProdReal: sum(b => b.produccionReal || b.realTotalMaster),
                TotalInv: sum(b => b.inventario),
                TotalInvIdeal: sum(b => b.invIdeal),
                TotalDisp: sum(b => b.disponible),
                TotalVenta: sum(b => b.presupuesto),
                TotalVentaReal: sum(b => b.ventaReal || b.ventaRealTotalMaster),
                TotalGap: data.reduce((a, b) => a + calcGapProjected(Number(b.produccionReal ?? b.realTotalMaster ?? 0), Number(b.disponible ?? 0), Number(b.ventaReal ?? b.ventaRealTotalMaster ?? 0)), 0),
                TotalPorcentaje: (data.length ? (sum(b => b.porcentaje) / data.length) : 0).toFixed(0)
            };
        }
        function applyMasterRowVisibility(matchSet) {
            document.querySelectorAll('tr.master-row[data-master]').forEach(tr => {
                const m = tr.getAttribute('data-master');
                const show = !matchSet || (m && matchSet.has(m));
                tr.style.display = show ? '' : 'none';
                const nxt = tr.nextElementSibling;
                if (!show && nxt && nxt.classList.contains('detail-row')) nxt.remove();
            });
        }

        let KPI_REAL_TIMER = null;
        function scheduleKpiRecalcFromCurrentState() {
            if (KPI_REAL_TIMER) clearTimeout(KPI_REAL_TIMER);
            KPI_REAL_TIMER = setTimeout(() => {
                try {
                    if (!isAnyFilterActive(getFilterState())) setKpis(computeTotalsFromMasterRows(MASTER_DATA));
                    else applyGlobalFiltersAndKpis().catch(console.error);
                } catch (e) { console.error(e); }
            }, 200);
        }

        // ---------- Aplicar filtros ----------
        let FILTER_TIMER = null;
        let FILTER_RUN_ID = 0;

        function updateOpenDetailAndModalFast() {
            if (LAST_OPEN_MASTER) {
                const btn = rowByMaster(LAST_OPEN_MASTER)?.querySelector('.expander-btn');
                if (btn?.getAttribute('aria-expanded') === 'true') {
                    renderDetalleConData(LAST_OPEN_MASTER, safeId(LAST_OPEN_MASTER),
                        CACHE_PRES.get(LAST_OPEN_MASTER) || [], CACHE_PROD.get(LAST_OPEN_MASTER) || [],
                        CACHE_PROD_REAL.get(LAST_OPEN_MASTER) || [], CACHE_VENTA_REAL.get(LAST_OPEN_MASTER) || [], CACHE_INV_SKU.get(LAST_OPEN_MASTER) || []);
                }
            }
            if (document.getElementById('presupuestoModal')?.classList.contains('show')) renderPresupuestoTable(filtrarPresupuesto(PRES_MODAL_RAW, getFilterState()));
        }
        function scheduleApplyFilters() {
            updateOpenDetailAndModalFast();
            if (FILTER_TIMER) clearTimeout(FILTER_TIMER);
            FILTER_TIMER = setTimeout(() => { applyGlobalFiltersAndKpis().catch(console.error); }, 250);
        }

        async function applyGlobalFiltersAndKpis() {
            const runId = ++FILTER_RUN_ID;
            const state = getFilterState();
            if (!MASTER_DATA.length) return;

            if (!isAnyFilterActive(state)) {
                applyMasterRowVisibility(null);
                restoreAllMasterRowsToBase();
                setKpis(computeTotalsFromMasterRows(MASTER_DATA));
                document.querySelector('.t-msg-filtro')?.remove();
                estado('');
                return;
            }

            const presupuestoFiltersActive = presupuestoFiltersActiveFromState(state);
            const skuActive = state.skus?.length > 0;
            const masterActive = state.masters?.length > 0;
            const clasificacionActive = state.clasificaciones?.length > 0;
            const mastersAll = MASTER_DATA.map(x => String(x.u_MASTER ?? '').trim() || 'SIN MASTER');
            const masters = masterActive ? mastersAll.filter(m => state.masters.includes(up(m))) : mastersAll;

            if (masterActive && !presupuestoFiltersActive && !skuActive && !clasificacionActive) {
                const set = new Set(masters);
                applyMasterRowVisibility(set);
                document.querySelector('.t-msg-filtro')?.remove();
                setKpis(computeTotalsFromMasterRows(MASTER_DATA.filter(x => set.has(x.u_MASTER))));
                if (LAST_OPEN_MASTER && !set.has(LAST_OPEN_MASTER)) { closeAllDetails(); LAST_OPEN_MASTER = null; }
                return;
            }

            estado('Aplicando filtros…');
            await prefetchForMasters(masters);
            if (skuActive || presupuestoFiltersActive || clasificacionActive) {
                await prefetchRealOnly(masters);
                await prefetchVentaRealOnly(masters);
            }
            if (runId !== FILTER_RUN_ID) return;

            const matchSet = new Set();
            let totalVenta = 0, totalVentaReal = 0, totalProdSku = 0, totalProdRealSku = 0, totalProdReal = 0;
            let totalInv = 0, totalInvIdeal = 0, totalDisp = 0, sumPor = 0, countPor = 0, totalGap = 0;

            for (const m of MASTER_DATA) {
                const master = String(m.u_MASTER ?? '').trim() || 'SIN MASTER';
                if (masterActive && !state.masters.includes(up(master))) continue;

                const presF = filtrarPresupuesto(CACHE_PRES.get(master) || [], state);
                const prodF = filtrarProduccion(CACHE_PROD.get(master) || [], state);
                let realF = filtrarProduccionReal(CACHE_PROD_REAL.get(master) || [], state);
                const ventaRealF = filtrarVentaReal(CACHE_VENTA_REAL.get(master) || [], state);

                if (!skuActive) {
                    let skuSet = null;
                    if (clasificacionActive) skuSet = skuSetFromSources(presF, prodF, realF, ventaRealF);
                    else if (presupuestoFiltersActive) skuSet = skuSetFromPresupuesto(presF);
                    if (skuSet && skuSet.size) realF = filtrarRealPorSkuSet(realF, skuSet, realSku);
                }

                const match = (clasificacionActive || skuActive || presupuestoFiltersActive) ? (presF.length > 0 || prodF.length > 0 || realF.length > 0) : true;
                if (!match) continue;
                matchSet.add(master);

                totalInv += Number(m.inventario || 0);
                totalInvIdeal += Number(m.invIdeal || 0);
                totalDisp += Number(m.disponible || 0);

                const ventaMaster = presF.reduce((a, x) => a + Number(x.presupuesto || 0), 0);
                totalVenta += ventaMaster;
                const ventaRealMaster = sumKgVentaReal(ventaRealF);
                totalVentaReal += ventaRealMaster;
                const porMaster = ventaMaster > 0 ? (Number(m.disponible || 0) / ventaMaster) * 100 : 0;

                let planMaster = Number(m.planProduccion || 0);
                let realMaster = Number(m.realTotalMaster ?? m.produccionReal ?? 0);
                if (skuActive || clasificacionActive) {
                    planMaster = prodF.reduce((a, x) => a + Number(x.plan || 0), 0);
                    realMaster = sumKgReal(realF);
                    totalProdSku += planMaster;
                    totalProdRealSku += realMaster;
                } else totalProdReal += realMaster;

                const gapMaster = calcGapProjected(realMaster, Number(m.disponible || 0), ventaRealMaster);
                totalGap += gapMaster;

                updateMasterRowCells(master, { plan: (skuActive || clasificacionActive) ? planMaster : null, real: realMaster, venta: ventaMaster, ventaReal: ventaRealMaster, gap: gapMaster, porcentaje: porMaster });
                sumPor += porMaster;
                countPor += 1;
            }

            const totalProd = (skuActive || clasificacionActive) ? totalProdSku : MASTER_DATA.reduce((a, x) => a + (matchSet.has(x.u_MASTER) ? Number(x.planProduccion || 0) : 0), 0);
            applyMasterRowVisibility(matchSet);
            if (LAST_OPEN_MASTER && !matchSet.has(LAST_OPEN_MASTER)) { closeAllDetails(); LAST_OPEN_MASTER = null; }

            setKpis({
                TotalProd: totalProd,
                TotalProdReal: (skuActive || clasificacionActive) ? totalProdRealSku : totalProdReal,
                TotalInv: totalInv, TotalInvIdeal: totalInvIdeal, TotalDisp: totalDisp,
                TotalVenta: totalVenta, TotalVentaReal: totalVentaReal, TotalGap: totalGap,
                TotalPorcentaje: countPor ? (sumPor / countPor).toFixed(0) : 0
            });
            estado('');
            if (!matchSet.size) {
                const tb = document.getElementById('tbodyExcedidos');
                if (tb && !tb.querySelector('.t-msg-filtro')) tb.insertAdjacentHTML('beforeend', `<tr class="t-msg t-msg-filtro"><td colspan="10">Ningún master coincide con los filtros. Presiona "Limpiar" para verlos todos.</td></tr>`);
            } else document.querySelector('.t-msg-filtro')?.remove();
        }

        // ---------- Tabla principal ----------
        function renderMasterRow(r) {
            const gapVal = calcGapProjected(r.produccionReal ?? 0, r.disponible ?? 0, r.ventaReal ?? 0);
            const enCarga = '<span class="text-muted">…</span>';
            return `
                        <tr class="master-row" data-master="${escHtml(r.u_MASTER)}" data-inventario="${Number(r.inventario ?? 0)}" data-disponible="${Number(r.disponible ?? 0)}">
                            <td class="text-center"><button type="button" class="expander-btn btn btn-sm" aria-expanded="false" title="Ver detalle por SKU" aria-label="Ver detalle de ${escHtml(r.u_MASTER)}"><i class="bi bi-chevron-right"></i></button></td>
                            <td title="${escHtml(r.u_MASTER)}">${escHtml(r.u_MASTER)}</td>
                            <td class="number">${fmt(r.planProduccion)}</td>
                            <td class="number">${r.produccionReal == null ? enCarga : fmt(r.produccionReal)}</td>
                            <td class="number">${r.produccionReal == null ? enCarga : renderTrendCellProjectedOnly(r.produccionReal)}</td>
                            <td class="number">${fmt(r.inventario)}</td>
                            <td class="number">${fmt(r.presupuesto)}</td>
                            <td class="number">${r.ventaReal == null ? enCarga : fmt(r.ventaReal)}</td>
                            <td class="number">${r.ventaReal == null ? enCarga : renderTrendCellProjectedOnly(r.ventaReal)}</td>
                            <td class="number">${gapBadge(gapVal)}</td>
                        </tr>`;
        }

        function renderDetailSkeleton(master, idSuffix) {
            return `
                        <tr class="detail-row" data-master="${escHtml(master)}">
                            <td colspan="10">
                                <div class="detail-compact">
                                    <div class="detail-title"><span>Detalle por SKU · ${escHtml(master)}</span></div>
                                    <div class="table-responsive">
                                        <table class="table table-sm align-middle mb-0 detail-table">
                                            <thead>
                                                <tr>
                                                    <th>SKU</th>
                                                    <th>Producto</th>
                                                    <th class="text-end">Inventario</th>
                                                    <th class="text-end">Presupuesto</th>
                                                    <th class="text-end">Planeación</th>
                                                    <th class="text-end">Producción real</th>
                                                    <th class="text-end">Venta real</th>
                                                    <th class="text-end" title="Tendencia de producción + inventario − tendencia de venta">GAP</th>
                                                    <th>Acciones</th>
                                                </tr>
                                            </thead>
                                            <tbody id="tbody-sum-${idSuffix}"><tr><td colspan="9" class="text-center text-muted"><span class="bm-spin"></span> Cargando…</td></tr></tbody>
                                            <tfoot>
                                                <tr>
                                                    <th colspan="2" class="text-end">Totales</th>
                                                    <th class="text-end" id="tot-inv-${idSuffix}">0</th>
                                                    <th class="text-end" id="tot-pres-${idSuffix}">0</th>
                                                    <th class="text-end" id="tot-prod-${idSuffix}">0</th>
                                                    <th class="text-end" id="tot-real-${idSuffix}">0</th>
                                                    <th class="text-end" id="tot-venta-${idSuffix}">0</th>
                                                    <th class="text-end" id="tot-dif-${idSuffix}">0</th>
                                                    <th></th>
                                                </tr>
                                            </tfoot>
                                        </table>
                                    </div>
                                    <div class="detail-nota">Sumatorias del mes seleccionado. Si hay filtros activos, el detalle también se filtra.</div>
                                </div>
                            </td>
                        </tr>`;
        }

        function pintarTabla(rows) {
            const tb = document.getElementById('tbodyExcedidos');
            if (!tb) return;
            tb.innerHTML = (rows || []).length ? rows.map(renderMasterRow).join('') : `<tr class="t-msg"><td colspan="10">No hay masters para el mes seleccionado.</td></tr>`;
        }

        // ---------- Detalle por SKU ----------
        function renderDetalleConData(master, idSuffix, presList, prodList, realList, ventaList, invList = []) {
            const state = getFilterState();
            const pres = filtrarPresupuesto(presList, state);
            const prod = filtrarProduccion(prodList, state);
            let real = filtrarProduccionReal(realList, state);
            let ventaReal = filtrarVentaReal(ventaList || [], state);
            const presActive = presupuestoFiltersActiveFromState(state);
            const skuActive = state.skus?.length > 0;
            const clasificacionActive = state.clasificaciones?.length > 0;

            if (!skuActive) {
                let skuSet = null;
                if (clasificacionActive) skuSet = skuSetFromSources(pres, prod, real, ventaReal);
                else if (presActive) skuSet = skuSetFromPresupuesto(pres);
                if (skuSet && skuSet.size) { real = filtrarRealPorSkuSet(real, skuSet, realSku); ventaReal = filtrarRealPorSkuSet(ventaReal, skuSet, ventaSku); }
            }

            const presMap = new Map(groupSumBySku(pres, 'productoCodigo', 'productoNombre', 'presupuesto').map(x => [x.sku, x]));
            const prodMap = new Map(groupSumBySku(prod, 'productoCodigo', 'productoNombre', 'plan').map(x => [x.sku, x]));
            const realMap = new Map(groupSumRealBySku(real).map(x => [x.sku, x]));
            const ventaMap = new Map(groupSumVentaRealBySku(ventaReal).map(x => [x.sku, x]));
            const invMap = new Map(groupSumInventarioBySku(invList).map(x => [x.sku, x]));
            const allSkus = new Set([...presMap.keys(), ...prodMap.keys(), ...realMap.keys(), ...ventaMap.keys()]);
            const invMapFiltrado = new Map(Array.from(invMap.entries()).filter(([sku]) => allSkus.has(sku)));

            let totInv = 0, totPres = 0, totProd = 0, totReal = 0, totVenta = 0, totDif = 0;
            const rows = Array.from(allSkus).sort().map(sku => {
                const p = presMap.get(sku)?.sum || 0, pl = prodMap.get(sku)?.sum || 0, r = realMap.get(sku)?.sum || 0, v = ventaMap.get(sku)?.sum || 0, inv = invMapFiltrado.get(sku)?.sum || 0;
                const nombre = presMap.get(sku)?.name || prodMap.get(sku)?.name || realMap.get(sku)?.name || ventaMap.get(sku)?.name || invMap.get(sku)?.name || '';
                const gap = calcGapProjectedByInv(r, inv, v);
                totInv += inv; totPres += p; totProd += pl; totReal += r; totVenta += v; totDif += gap;
                const btnPres = permisosBalance.presupuesto.puedeLeer ? `<button type="button" class="btn btn-sm btn-pres-sku" data-master="${escHtml(master)}" data-sku="${escHtml(sku)}"><i class="bi bi-bullseye"></i> Presupuesto</button>` : '';
                const btnPlan = permisosBalance.produccion.puedeLeer ? `<button type="button" class="btn btn-sm btn-plan-sku" data-master="${escHtml(master)}" data-sku="${escHtml(sku)}"><i class="bi bi-gear"></i> Producción</button>` : '';
                return `<tr>
                            <td style="font-weight:600">${escHtml(sku)}</td>
                            <td title="${escHtml(nombre)}">${escHtml(nombre)}</td>
                            <td class="text-end">${fmt(inv)}</td><td class="text-end">${fmt(p)}</td><td class="text-end">${fmt(pl)}</td>
                            <td class="text-end">${fmt(r)}</td><td class="text-end">${fmt(v)}</td>
                            <td class="text-end">${gapBadge(gap)}</td>
                            <td><div class="d-flex gap-1">${btnPres}${btnPlan}</div></td>
                        </tr>`;
            }).join('');

            const tbody = document.getElementById(`tbody-sum-${idSuffix}`);
            if (tbody) tbody.innerHTML = rows || `<tr><td colspan="9" class="text-center text-muted">Sin datos para este master con los filtros actuales.</td></tr>`;
            const setTot = (id, v) => document.getElementById(`${id}-${idSuffix}`)?.replaceChildren(document.createTextNode(fmt(v)));
            setTot('tot-inv', totInv); setTot('tot-pres', totPres); setTot('tot-prod', totProd);
            setTot('tot-real', totReal); setTot('tot-venta', totVenta); setTot('tot-dif', totDif);
        }

        async function toggleDetalle(row) {
            const btn = row.querySelector('.expander-btn');
            const master = row.getAttribute('data-master');
            const idSuffix = safeId(master);
            const expanded = btn.getAttribute('aria-expanded') === 'true';
            const existing = row.nextElementSibling;
            if (expanded && existing && existing.classList.contains('detail-row')) {
                existing.remove();
                btn.setAttribute('aria-expanded', 'false');
                row.classList.remove('is-open');
                LAST_OPEN_MASTER = null;
                return;
            }

            closeAllDetails();
            row.insertAdjacentHTML('afterend', renderDetailSkeleton(master, idSuffix));
            btn.setAttribute('aria-expanded', 'true');
            row.classList.add('is-open');
            LAST_OPEN_MASTER = master;

            try {
                const r = await Promise.allSettled([
                    CACHE_PRES.has(master) ? CACHE_PRES.get(master) : cargarPresupuestosPorMaster(master),
                    CACHE_PROD.has(master) ? CACHE_PROD.get(master) : cargarProduccionPorMaster(master),
                    CACHE_PROD_REAL.has(master) ? CACHE_PROD_REAL.get(master) : cargarProduccionRealPorMaster(master),
                    CACHE_VENTA_REAL.has(master) ? CACHE_VENTA_REAL.get(master) : cargarVentaRealPorMaster(master),
                    CACHE_INV_SKU.has(master) ? CACHE_INV_SKU.get(master) : cargarInventarioPorMaster(master)
                ]);
                const val = (i, label) => normalizeArrayResult(r[i].status === 'fulfilled' ? r[i].value : [], `${label}(det) ${master}`);
                const pres = val(0, 'Pres'), prod = val(1, 'Plan'), real = val(2, 'Real'), venta = val(3, 'Venta'), inv = val(4, 'Inv');
                CACHE_PRES.set(master, pres); CACHE_PROD.set(master, prod); CACHE_PROD_REAL.set(master, real); CACHE_VENTA_REAL.set(master, venta); CACHE_INV_SKU.set(master, inv);
                if (LAST_OPEN_MASTER !== master) return;
                renderDetalleConData(master, idSuffix, pres, prod, real, venta, inv);
                if (r.some(x => x.status === 'rejected')) {
                    document.getElementById(`tbody-sum-${idSuffix}`)?.insertAdjacentHTML('afterbegin',
                        `<tr><td colspan="9" class="text-center small" style="color:var(--es-warn)">Una de las fuentes no respondió; los números pueden estar incompletos. Cierra y abre el detalle para reintentar.</td></tr>`);
                }
            } catch (err) {
                console.error(err);
                const tb = document.getElementById(`tbody-sum-${idSuffix}`);
                if (tb) tb.innerHTML = `<tr><td colspan="9" class="text-center" style="color:var(--es-bad)">Error al cargar el detalle.</td></tr>`;
            }
        }

        function refrescarDetalleSiAbierto(master) {
            if (!LAST_OPEN_MASTER || LAST_OPEN_MASTER !== master) return;
            const btn = rowByMaster(master)?.querySelector('.expander-btn');
            if (btn?.getAttribute('aria-expanded') !== 'true') return;
            renderDetalleConData(master, safeId(master), CACHE_PRES.get(master) || [], CACHE_PROD.get(master) || [], CACHE_PROD_REAL.get(master) || [], CACHE_VENTA_REAL.get(master) || [], CACHE_INV_SKU.get(master) || []);
        }

        // ---------- Producción real y venta real en la tabla principal ----------
        async function llenarRealesPorMaster(masters, cache, loader, sumar, aplicar, label) {
            const list = (masters || []).filter(Boolean);
            if (!list.length) return;
            let idx = 0;
            async function worker() {
                while (idx < list.length) {
                    const master = list[idx++];
                    try {
                        const data = cache.has(master) ? cache.get(master) : await loader(master);
                        const arr = normalizeArrayResult(data, `${label} ${master}`);
                        cache.set(master, arr);
                        aplicar(master, sumar(arr));
                    } catch (e) {
                        console.warn(`${label} ${master} falló:`, e);
                        cache.set(master, []);
                        aplicar(master, 0);
                    }
                }
            }
            await Promise.all(Array.from({ length: 6 }, worker));
            scheduleKpiRecalcFromCurrentState();
        }

        function fillProduccionRealForMasters(masters) {
            return llenarRealesPorMaster(masters, CACHE_PROD_REAL, cargarProduccionRealPorMaster, sumKgReal, (master, totalReal) => {
                const rowObj = MASTER_DATA.find(x => String(x.u_MASTER ?? '').trim() === String(master ?? '').trim());
                if (rowObj) { rowObj.produccionReal = Number(totalReal || 0); rowObj.realTotalMaster = Number(totalReal || 0); }
                if (BASE_MASTER_VIEW.has(master)) BASE_MASTER_VIEW.get(master).produccionReal = Number(totalReal || 0);
                const tr = rowByMaster(master);
                if (tr) {
                    const tds = tr.querySelectorAll('td');
                    if (tds[3]) tds[3].textContent = fmt(totalReal || 0);
                    if (tds[4]) tds[4].innerHTML = renderTrendCellProjectedOnly(Number(totalReal || 0));
                    if (tds[9]) {
                        const disp = Number(tr.getAttribute('data-disponible') ?? rowObj?.disponible ?? 0);
                        tds[9].innerHTML = gapBadge(calcGapProjected(Number(totalReal ?? 0), disp, Number(rowObj?.ventaReal ?? 0)));
                    }
                }
                refrescarDetalleSiAbierto(master);
                scheduleKpiRecalcFromCurrentState();
            }, 'Real');
        }

        function fillVentaRealForMasters(masters) {
            return llenarRealesPorMaster(masters, CACHE_VENTA_REAL, cargarVentaRealPorMaster, sumKgVentaReal, (master, totalVentaReal) => {
                const rowObj = MASTER_DATA.find(x => String(x.u_MASTER ?? '').trim() === String(master ?? '').trim());
                if (rowObj) { rowObj.ventaReal = Number(totalVentaReal || 0); rowObj.ventaRealTotalMaster = Number(totalVentaReal || 0); }
                if (BASE_MASTER_VIEW.has(master)) BASE_MASTER_VIEW.get(master).ventaReal = Number(totalVentaReal || 0);
                const tr = rowByMaster(master);
                if (tr) {
                    const tds = tr.querySelectorAll('td');
                    if (tds[7]) tds[7].textContent = fmt(totalVentaReal || 0);
                    if (tds[8]) tds[8].innerHTML = renderTrendCellProjectedOnly(Number(totalVentaReal || 0));
                    if (tds[9]) {
                        const disp = Number(tr.getAttribute('data-disponible') ?? rowObj?.disponible ?? 0);
                        tds[9].innerHTML = gapBadge(calcGapProjected(Number(rowObj?.produccionReal ?? 0), disp, Number(totalVentaReal ?? 0)));
                    }
                }
                refrescarDetalleSiAbierto(master);
                scheduleKpiRecalcFromCurrentState();
            }, 'VentaReal');
        }

        // ---------- Utilidades de edición en celdas ----------
        const parseMxFloat = (val) => { const n = parseFloat(String(val ?? '').replace(/\s+/g, '').replace(/,/g, '')); return Number.isFinite(n) ? n : NaN; };
        const formatMx = (n) => Number(n || 0).toLocaleString('es-MX');
        function sanitizeEditableNumberCell(el, allowDecimal = true) {
            if (!el) return;
            let t = String(el.textContent ?? '').replace(/[^\d.,]/g, '').replace(/,/g, '');
            if (allowDecimal) { const parts = t.split('.'); if (parts.length > 2) t = parts[0] + '.' + parts.slice(1).join(''); }
            else t = t.replace(/\./g, '');
            el.textContent = t;
        }
        function soloNumerosEnCelda(e) {
            if (e.ctrlKey || e.metaKey || e.altKey) return;
            const k = e.key;
            // CORRECCIÓN: Enter confirma (sale de la celda) en lugar de insertar un salto de línea.
            if (k === 'Enter') { e.preventDefault(); this.blur(); return; }
            if (k === 'Escape') { e.preventDefault(); this.textContent = this.dataset.original || this.textContent; this.blur(); return; }
            if (['Backspace', 'Delete', 'ArrowLeft', 'ArrowRight', 'ArrowUp', 'ArrowDown', 'Home', 'End', 'Tab'].includes(k)) return;
            if (/^\d$/.test(k)) return;
            if (k === '.') { if (String(this.textContent || '').includes('.')) e.preventDefault(); return; }
            e.preventDefault();
        }
        function marcarCelda(td, ok) {
            td.classList.add(ok ? 'is-saved' : 'is-error');
            setTimeout(() => td.classList.remove('is-saved', 'is-error'), 900);
        }

        // ---------- Modal de Presupuesto ----------
        function ensurePresupuestoFooter() {
            const table = document.getElementById('tablaPresupuesto');
            if (!table || table.querySelector('tfoot')) return;
            const tfoot = document.createElement('tfoot');
            tfoot.innerHTML = `<tr><th colspan="4" class="text-end">Total</th><th class="text-end" id="presuTotalCell">0</th></tr>`;
            table.appendChild(tfoot);
        }
        function recalcPresupuestoModalTotal() {
            let total = 0;
            document.querySelectorAll('#tablaPresupuesto tbody tr').forEach(tr => {
                const v = parseFloat(String(tr.lastElementChild?.textContent || '0').replace(/,/g, ''));
                if (!isNaN(v)) total += v;
            });
            const cell = document.getElementById('presuTotalCell');
            if (cell) cell.textContent = Number(total).toLocaleString('es-MX');
        }
        function patchPresupuestoInList(list, id, fuente, nuevo) {
            if (!Array.isArray(list)) return false;
            const f = up(fuente || 'GENERAL');
            let touched = false;
            for (const it of list) {
                if (Number(it?.id ?? it?.Id ?? 0) === Number(id) && up(it?.fuente ?? it?.Fuente ?? 'GENERAL') === f) { it.presupuesto = Number(nuevo); touched = true; }
            }
            return touched;
        }
        function patchPresupuestoCaches({ master, id, fuente, nuevo }) {
            patchPresupuestoInList(PRES_MODAL_RAW, id, fuente, nuevo);
            if (master && CACHE_PRES.has(master)) patchPresupuestoInList(CACHE_PRES.get(master), id, fuente, nuevo);
        }
        function patchMasterRowFromCache(master) {
            if (!master) return;
            const presAll = CACHE_PRES.get(master);
            if (!Array.isArray(presAll)) return;
            const totalPres = presAll.reduce((a, x) => a + Number(x?.presupuesto || 0), 0);
            const mRow = MASTER_DATA.find(x => String(x.u_MASTER ?? '').trim() === String(master ?? '').trim());
            if (!mRow) return;
            const gapNew = calcGapProjected(Number(mRow.produccionReal ?? mRow.realTotalMaster ?? 0), Number(mRow.disponible ?? 0), Number(mRow.ventaReal ?? mRow.ventaRealTotalMaster ?? 0));
            mRow.presupuesto = totalPres;
            mRow.gap = gapNew;
            if (BASE_MASTER_VIEW.has(master)) BASE_MASTER_VIEW.get(master).presupuesto = totalPres;
            const tds = rowByMaster(master)?.querySelectorAll('td');
            if (!tds) return;
            if (tds[6]) tds[6].textContent = fmt(totalPres);
            if (tds[9]) tds[9].innerHTML = gapBadge(gapNew);
        }

        async function openPresupuestoModal(master, sku) {
            CURRENT_MODAL_MASTER = master;
            CURRENT_MODAL_SKU = sku || null;
            $("#pdtPres").text(sku ? `${master} · ${sku}` : master);
            $("#presAyuda").text(permisosBalance?.presupuesto?.puedeEscribir
                ? 'Haz clic en una cantidad para editarla; Enter guarda y Esc cancela. Respeta los filtros activos.'
                : 'Solo lectura: no tienes permiso para editar presupuesto.');
            try {
                const data = CACHE_PRES.has(master) ? CACHE_PRES.get(master) : await cargarPresupuestosPorMaster(master);
                const arr = normalizeArrayResult(data, `PresModal ${master}`);
                CACHE_PRES.set(master, arr);
                PRES_MODAL_RAW = sku ? arr.filter(x => String(x?.productoCodigo ?? '').trim() === String(sku ?? '').trim()) : arr;
                renderPresupuestoTable(filtrarPresupuesto(PRES_MODAL_RAW, getFilterState()));
                bootstrap.Modal.getOrCreateInstance(document.getElementById('presupuestoModal')).show();
            } catch (e) {
                console.error("Error openPresupuestoModal:", e);
                alert("Error al obtener presupuesto: " + (e?.message || e?.statusText || e));
            }
        }

        function renderPresupuestoTable(rows) {
            ensurePresupuestoFooter(); // CORRECCIÓN: el total del modal nunca se mostraba (la fila de total no se creaba)
            const tbody = $("#tablaPresupuesto tbody");
            tbody.empty();
            const puedeEditar = !!permisosBalance?.presupuesto?.puedeEscribir;

            if (!rows || !rows.length) {
                tbody.append('<tr><td colspan="5" class="text-center text-muted">No hay presupuesto con los filtros actuales.</td></tr>');
                recalcPresupuestoModalTotal();
                return;
            }

            rows.forEach(item => {
                const fuente = String(item.fuente || 'GENERAL').trim().toUpperCase();
                const canal = String(item.canalVta || '').trim();
                const estatus = String(item.estatus || '').trim().toUpperCase();
                let razonShow = String(item.razonSocial || '').trim().replace(/\s+/g, ' ');
                const isCedis = fuente === 'CEDIS' || estatus === 'CEDIS' || up(canal).startsWith('CEDIS');
                if (isCedis) { razonShow = razonShow.replace(/^CEDIS\s+/i, '').trim(); if (!razonShow) razonShow = canal || '(CEDIS)'; }
                const valor = Number(item.presupuesto || 0).toLocaleString('es-MX');
                const tdPres = puedeEditar
                    ? `<td class="number editable-pres" contenteditable="true" data-original="${escHtml(valor)}" aria-label="Presupuesto de ${escHtml(item.productoCodigo)}">${escHtml(valor)}</td>`
                    : `<td class="number">${escHtml(valor)}</td>`;
                tbody.append(`
                            <tr data-id="${escHtml(item.id)}" data-fuente="${escHtml(fuente)}">
                                <td>${escHtml(canal)}</td>
                                <td>${escHtml(razonShow)}</td>
                                <td style="font-weight:600">${escHtml(item.productoCodigo ?? '')}</td>
                                <td>${escHtml(item.productoNombre ?? '')}</td>
                                ${tdPres}
                            </tr>`);
            });

            if (puedeEditar) {
                tbody.find(".editable-pres").off("keydown").on("keydown", soloNumerosEnCelda);
                tbody.find(".editable-pres").off("blur").on("blur", async function() {
                    const td = $(this);
                    const tr = td.closest('tr');
                    const id = Number(tr.data('id'));
                    const fuente = String(tr.data('fuente') || 'GENERAL').toUpperCase();
                    sanitizeEditableNumberCell(this, true);
                    const nuevo = parseFloat(td.text().replace(/,/g, '').trim());
                    const original = parseMxFloat(this.dataset.original);
                    if (isNaN(nuevo)) { alert('Ingresa un número.'); td.text(this.dataset.original || '0'); return; }
                    // CORRECCIÓN: si no cambió el valor ya no se manda al servidor (antes cada clic fuera guardaba).
                    if (!isNaN(original) && nuevo === original) { td.text(this.dataset.original); return; }

                    try {
                        const resp = await $.ajax({
                            url: "/Comercial/ActualizarPresupuesto", type: "POST", cache: false, contentType: "application/json", dataType: "json",
                            headers: { 'RequestVerificationToken': getRequestVerificationToken() },
                            data: JSON.stringify({ Id: id, Presupuesto: nuevo, Fuente: fuente })
                        });
                        if (!resp || resp.success !== true) throw new Error(resp?.mensaje || 'Respuesta inválida');
                        const txt = nuevo.toLocaleString('es-MX');
                        td.text(txt); this.dataset.original = txt;
                        marcarCelda(this, true);
                        patchPresupuestoCaches({ master: CURRENT_MODAL_MASTER, id, fuente, nuevo });
                        recalcPresupuestoModalTotal();
                        patchMasterRowFromCache(CURRENT_MODAL_MASTER);
                        refrescarDetalleSiAbierto(CURRENT_MODAL_MASTER);
                        await applyGlobalFiltersAndKpis();
                    } catch (e) {
                        td.text(this.dataset.original || '0');
                        marcarCelda(this, false);
                        alert("No se pudo actualizar el presupuesto. " + (e?.message || ''));
                    }
                });
            }
            recalcPresupuestoModalTotal();
        }

        // ---------- Modal de Plan de producción ----------
        let CURRENT_PLAN_MASTER = null;
        let CURRENT_PLAN_SKU = null;
        let PLAN_MODAL_RAW = [];

        function ensurePlanFooter() {
            const table = document.getElementById('tablaPlanProduccion');
            if (!table || table.querySelector('tfoot')) return;
            const tfoot = document.createElement('tfoot');
            tfoot.innerHTML = `<tr><th colspan="2" class="text-end">Total</th><th class="text-end" id="planTotalCell">0</th></tr>`;
            table.appendChild(tfoot);
        }
        function recalcPlanModalTotal() {
            let total = 0;
            document.querySelectorAll('#tablaPlanProduccion tbody tr').forEach(tr => { const v = parseMxFloat(tr.lastElementChild?.textContent || '0'); if (!isNaN(v)) total += v; });
            const cell = document.getElementById('planTotalCell');
            if (cell) cell.textContent = formatMx(total);
        }

        // CORRECCIÓN DE PERMISOS: había dos versiones de esta función y la segunda (sin revisar
        // permisos) reemplazaba a la primera, así que cualquier usuario podía editar el plan de producción.
        // Ahora solo se puede editar con permiso "produccion.puedeEscribir".
        function renderPlanTable(rows) {
            ensurePlanFooter();
            const tbody = $("#tablaPlanProduccion tbody");
            tbody.empty();
            const puedeEditar = !!permisosBalance?.produccion?.puedeEscribir;

            if (!rows || !rows.length) {
                tbody.append('<tr><td colspan="3" class="text-center text-muted">No hay plan de producción con los filtros actuales.</td></tr>');
                recalcPlanModalTotal();
                return;
            }
            rows.forEach(item => {
                const valor = formatMx(item.plan || 0);
                const tdPlan = puedeEditar
                    ? `<td class="number editable-plan" contenteditable="true" data-original="${escHtml(valor)}" aria-label="Plan de ${escHtml(item.productoCodigo)}">${escHtml(valor)}</td>`
                    : `<td class="number">${escHtml(valor)}</td>`;
                tbody.append(`<tr data-id="${escHtml(item.id)}"><td style="font-weight:600">${escHtml(item.productoCodigo ?? '')}</td><td>${escHtml(item.productoNombre ?? '')}</td>${tdPlan}</tr>`);
            });

            if (puedeEditar) {
                tbody.find(".editable-plan").off("input").on("input", function() { sanitizeEditableNumberCell(this, true); });
                tbody.find(".editable-plan").off("keydown").on("keydown", soloNumerosEnCelda);
                tbody.find(".editable-plan").off("blur").on("blur", async function() {
                    if (!permisosBalance?.produccion?.puedeEscribir) return;
                    const td = $(this);
                    const id = Number(td.closest('tr').data('id'));
                    sanitizeEditableNumberCell(this, true);
                    const nuevo = parseMxFloat(td.text());
                    const original = parseMxFloat(this.dataset.original);
                    if (isNaN(nuevo)) { alert('Ingresa un número.'); td.text(this.dataset.original || '0'); return; }
                    if (nuevo < 0) { alert('No se permiten negativos.'); td.text(this.dataset.original || '0'); return; }
                    if (!isNaN(original) && nuevo === original) { td.text(this.dataset.original); return; }

                    try {
                        const resp = await $.ajax({
                            url: "/Comercial/ActualizarPlanProduccion", type: "POST", cache: false, contentType: "application/json",
                            headers: { 'RequestVerificationToken': getCsrfToken() },
                            data: JSON.stringify({ id, plan: nuevo })
                        });
                        if (resp?.success === false) throw new Error(resp?.mensaje || 'No se pudo actualizar');
                        const txt = formatMx(nuevo);
                        td.text(txt); this.dataset.original = txt;
                        marcarCelda(this, true);
                        recalcPlanModalTotal();
                        CACHE_PROD.delete(CURRENT_PLAN_MASTER);
                        await refreshMainAndDetail();
                    } catch (err) {
                        td.text(this.dataset.original || '0');
                        marcarCelda(this, false);
                        alert("No se pudo actualizar el plan. " + (err?.message || ''));
                    }
                });
            }
            recalcPlanModalTotal();
        }

        function filterPlanByGlobalSku(list) {
            const skus = getFilterState()?.skus || [];
            if (!skus.length) return list || [];
            const setSku = new Set(skus.map(up));
            return (list || []).filter(x => setSku.has(up(String(x.productoCodigo ?? '').trim())));
        }
        function refreshPlanModalIfOpen() {
            if (!document.getElementById('planProduccionModal')?.classList.contains('show')) return;
            renderPlanTable(filterPlanByGlobalSku(PLAN_MODAL_RAW));
        }
        async function openPlanModal(master, sku) {
            CURRENT_PLAN_MASTER = master;
            CURRENT_PLAN_SKU = sku || null;
            $("#pdtPlan").text(sku ? `${master} · ${sku}` : master);
            $("#planAyuda").text(permisosBalance?.produccion?.puedeEscribir
                ? 'Haz clic en una cantidad para editarla; Enter guarda y Esc cancela.'
                : 'Solo lectura: no tienes permiso para editar el plan de producción.');
            try {
                const data = CACHE_PROD.has(master) ? CACHE_PROD.get(master) : await cargarProduccionPorMaster(master);
                const arr = Array.isArray(data) ? data : [];
                CACHE_PROD.set(master, arr);
                PLAN_MODAL_RAW = sku ? arr.filter(x => String(x.productoCodigo).trim() === String(sku).trim()) : arr;
                renderPlanTable(filterPlanByGlobalSku(PLAN_MODAL_RAW));
                bootstrap.Modal.getOrCreateInstance(document.getElementById('planProduccionModal')).show();
            } catch (e) {
                alert("Error al obtener el plan de producción.");
            }
        }

        // ---------- Carga principal ----------
        async function cargarTabla() {
            const [anio, numMes] = MES.split('-');
            MES_CORTO = obtenerMesCorto(numMes);
            ['thProdMes', 'thProdRealMes', 'thVentaMes', 'thVentaRealMes'].forEach(id => { const el = document.getElementById(id); if (el) el.textContent = MES_CORTO; });

            try {
                closeAllDetails();
                estado('Cargando masters…');
                const response = await fetch(`/Comercial/ObtenerInventarioAgrupado?mes=${numMes}&anio=${anio}&año=${anio}&t=${Date.now()}`, noCacheFetchOpts);
                if (!response.ok) throw new Error(`HTTP ${response.status}`);
                const data = await response.json();

                MASTER_DATA = (Array.isArray(data) ? data : []).map(x => ({
                    u_MASTER: String(x?.u_MASTER ?? '').trim() || 'SIN MASTER',
                    rotacion: Number(x.rotacion),
                    planProduccion: Number(x.planProduccion),
                    produccionReal: null, realTotalMaster: null,
                    ventaReal: null, ventaRealTotalMaster: null,
                    inventario: Number(x.inventario),
                    invIdeal: Number(x.invIdeal),
                    disponible: Number(x.disponible),
                    presupuesto: Number(x.presupuesto),
                    gap: Number(x.gap),
                    porcentaje: Number(x.porcentaje)
                }));

                refreshMasterMultiAfterDataLoad();
                pintarTabla(MASTER_DATA);
                setKpis(computeTotalsFromMasterRows(MASTER_DATA));
                snapshotBaseMasterView();
                scheduleApplyFilters();
                refreshPlanModalIfOpen();

                estado('Cargando producción y venta real…');
                const masters = MASTER_DATA.map(x => x.u_MASTER).filter(Boolean);
                Promise.allSettled([fillProduccionRealForMasters(masters), fillVentaRealForMasters(masters)]).then(() => estado(''));
            } catch (err) {
                console.error(err);
                estado('');
                const tb = document.getElementById('tbodyExcedidos');
                if (tb) tb.innerHTML = `<tr class="t-msg is-error"><td colspan="10">No se pudieron cargar los datos (${escHtml(err.message)}). Recarga la página o cambia de mes para reintentar.</td></tr>`;
                MASTER_DATA = [];
                refreshMasterMultiAfterDataLoad();
            }
        }

        // ---------- Excel (exportación completa, sin cambios) ----------
        function normalizaNumero(n) { const v = Number(n ?? 0); return isNaN(v) ? 0 : v; }
        function combinarSumsPorSku3(presBySku, prodBySku, realBySku) {
            const idx = new Map();
            (presBySku || []).forEach(x => idx.set(x.sku, { sku: x.sku, name: x.name, pres: x.sum || 0, prod: 0, real: 0 }));
            (prodBySku || []).forEach(x => { const o = idx.get(x.sku) || { sku: x.sku, name: x.name, pres: 0, prod: 0, real: 0 }; o.prod += (x.sum || 0); if (!o.name) o.name = x.name; idx.set(x.sku, o); });
            (realBySku || []).forEach(x => { const o = idx.get(x.sku) || { sku: x.sku, name: x.name, pres: 0, prod: 0, real: 0 }; o.real += (x.sum || 0); if (!o.name) o.name = x.name; idx.set(x.sku, o); });
            return Array.from(idx.values()).sort((a, b) => String(a.sku).localeCompare(String(b.sku)));
        }
        async function obtenerInventarioAgrupadoSeguro() {
            const [anio, mes] = MES.split('-');
            try {
                const res = await fetch(`/Comercial/ObtenerInventarioAgrupado?mes=${mes}&anio=${anio}&año=${anio}&t=${Date.now()}`, noCacheFetchOpts);
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                if (!(res.headers.get('content-type') || '').includes('application/json')) throw new Error('Respuesta no es JSON');
                const json = await res.json();
                if (!Array.isArray(json)) throw new Error('JSON no es un arreglo');
                return json;
            } catch (err) {
                console.warn('Falló ObtenerInventarioAgrupado, se usan los masters de la pantalla:', err);
                return Array.from(document.querySelectorAll('tr.master-row[data-master]')).map(r => r.getAttribute('data-master')).filter(Boolean)
                    .map(m => ({ u_MASTER: m, rotacion: 0, planProduccion: 0, inventario: 0, invIdeal: 0, disponible: 0, presupuesto: 0, gap: 0, porcentaje: 0 }));
            }
        }
        async function exportExcelCompletoRobusto() {
            const mastersData = await obtenerInventarioAgrupadoSeguro();
            const masters = [...new Set((mastersData || []).map(x => x.u_MASTER).filter(Boolean))];
            if (!masters.length) { alert('No hay masters para exportar.'); return; }
            const detalleSku = [], presupuestoRaw = [], planRaw = [], realRaw = [];
            let n = 0;
            for (const master of masters) {
                estado(`Preparando Excel… ${++n} de ${masters.length}`);
                let pres = [], prod = [], real = [];
                try {
                    const r = await Promise.allSettled([cargarPresupuestosPorMaster(master), cargarProduccionPorMaster(master), cargarProduccionRealPorMaster(master)]);
                    if (r[0].status === 'fulfilled' && Array.isArray(r[0].value)) pres = r[0].value;
                    if (r[1].status === 'fulfilled' && Array.isArray(r[1].value)) prod = r[1].value;
                    if (r[2].status === 'fulfilled' && Array.isArray(r[2].value)) real = r[2].value;
                } catch (e) { console.warn(`Fallo datos ${master}:`, e); }
                pres.forEach(p => presupuestoRaw.push({ master, canalVta: p.canalVta ?? '', estatus: p.estatus ?? '', razonSocial: p.razonSocial ?? '', productoCodigo: p.productoCodigo ?? '', productoNombre: p.productoNombre ?? '', presupuesto: normalizaNumero(p.presupuesto), fuente: (p.fuente || 'GENERAL') }));
                prod.forEach(p => planRaw.push({ master, productoCodigo: p.productoCodigo ?? '', productoNombre: p.productoNombre ?? '', plan: normalizaNumero(p.plan) }));
                real.forEach(rr => realRaw.push({ master, articuloCodigo: realSku(rr), producto: realName(rr), kgProducidos: normalizaNumero(realKg(rr)), dia: rr?.dia ?? rr?.Dia ?? '', mes: rr?.mes ?? rr?.Mes ?? '', anio: rr?.anio ?? rr?.Anio ?? '' }));
                combinarSumsPorSku3(groupSumBySku(pres, 'productoCodigo', 'productoNombre', 'presupuesto'), groupSumBySku(prod, 'productoCodigo', 'productoNombre', 'plan'), groupSumRealBySku(real)).forEach(r => {
                    detalleSku.push({ master, sku: r.sku, producto: r.name ?? '', presupuesto: normalizaNumero(r.pres), produccionPlan: normalizaNumero(r.prod), produccionReal: normalizaNumero(r.real), difPlanVsPres: normalizaNumero(r.prod) - normalizaNumero(r.pres), difRealVsPlan: normalizaNumero(r.real) - normalizaNumero(r.prod) });
                });
            }
            const realTotByMaster = new Map();
            realRaw.forEach(x => { const m = String(x.master || '').trim(); if (m) realTotByMaster.set(m, (realTotByMaster.get(m) || 0) + normalizaNumero(x.kgProducidos)); });
            const hojaMaster = XLSX.utils.json_to_sheet((mastersData || []).map(x => {
                const m = String(x.u_MASTER || '').trim();
                return { MASTER: x.u_MASTER, Rotación: normalizaNumero(x.rotacion), Producción: normalizaNumero(x.planProduccion), 'Producción Real': normalizaNumero(realTotByMaster.get(m) || 0), Inventario: normalizaNumero(x.inventario), 'Inventario ideal': normalizaNumero(x.invIdeal), Disponible: normalizaNumero(x.disponible), Presupuesto: normalizaNumero(x.presupuesto), Gap: normalizaNumero(x.gap), '%': normalizaNumero(x.porcentaje) };
            }));
            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, hojaMaster, 'Master');
            XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(detalleSku), 'Detalle SKU (sumas)');
            XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(presupuestoRaw), 'Presupuesto (raw)');
            XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(planRaw), 'Plan (raw)');
            XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(realRaw), 'Producción Real (raw)');
            XLSX.writeFile(wb, `BalanceMaster_${MES}.xlsx`);
        }

        // ---------- Eventos ----------
        const MULTI_CFGS = [];
        document.addEventListener('DOMContentLoaded', () => {
            initMasterMultiSelectOnce();

            const comunes = (id, label) => ({ wrapId: `${id}MultiWrap`, btnId: `btn${id[0].toUpperCase() + id.slice(1)}Multi`, searchId: `${id}MultiSearch`, listId: `${id}MultiList`, clearId: `${id}MultiClear`, applyId: `${id}MultiApply`, emptyLabel: label });
            MULTI_CFGS.push(
                { ...comunes('cliente', 'Todos'), hiddenId: 'fCliente', loadOptions: loadClientesOptions },
                { ...comunes('vendedor', 'Todos'), hiddenId: 'fVendedor', loadOptions: loadVendedoresOptions },
                { ...comunes('cedis', 'Todos'), hiddenId: 'fCedis', loadOptions: loadCedisOptions },
                { ...comunes('sku', 'Todos'), hiddenId: 'fSku', loadOptions: loadSkuOptions, upperSearch: true, optionFns: { getValue: o => o.sku, getLabel: o => o.name ? `${o.sku} · ${o.name}` : o.sku, getSearch: o => `${o.sku} ${o.name || ''}` } },
                { ...comunes('clasificacion', 'Todas'), hiddenId: 'fClasificacion', loadOptions: loadClasificacionOptions, optionFns: { getValue: o => o.value, getLabel: o => o.label, getSearch: o => o.label } }
            );
            MULTI_CFGS.forEach(initAsyncMultiSelect);

            const btnExport = document.getElementById('btnExportExcel');
            let exportando = false;
            btnExport?.addEventListener('click', async () => {
                if (exportando) return; // CORRECCIÓN: evita exportaciones simultáneas por doble clic
                if (typeof XLSX === 'undefined' || !XLSX.utils) { alert('La biblioteca de Excel no se cargó. Revisa la conexión e inténtalo de nuevo.'); return; }
                exportando = true;
                const original = btnExport.innerHTML;
                btnExport.disabled = true;
                btnExport.innerHTML = '<span class="bm-spin"></span> Exportando…';
                try { await exportExcelCompletoRobusto(); }
                catch (e) { console.error('Export error:', e); alert('Ocurrió un error al generar el Excel.'); }
                finally { exportando = false; btnExport.disabled = false; btnExport.innerHTML = original; estado(''); }
            });

            ['fFuente', 'fCliente', 'fVendedor', 'fCedis', 'fMaster', 'fSku', 'fClasificacion'].map(id => document.getElementById(id)).filter(Boolean).forEach(el => {
                el.addEventListener('change', () => { scheduleApplyFilters(); refreshPlanModalIfOpen(); });
            });

            document.getElementById('btnClearPresFilters')?.addEventListener('click', () => {
                ['fCliente', 'fVendedor', 'fCedis', 'fMaster', 'fSku', 'fClasificacion'].forEach(id => { const el = getEl(id); if (el) el.value = ''; });
                const fu = getEl('fFuente'); if (fu) fu.value = 'TODOS';
                clearMasterMulti(false);
                MULTI_CFGS.forEach(c => c._reset?.());
                document.querySelector('.t-msg-filtro')?.remove();
                scheduleApplyFilters();
                refreshPlanModalIfOpen();
            });

            (async () => { await cargarPermisosBalanceMaster(); await cargarTabla(); })();
        });

        document.getElementById('tbodyExcedidos')?.addEventListener('click', async (e) => {
            const btn = e.target.closest('.expander-btn');
            if (btn) await toggleDetalle(btn.closest('.master-row'));
        });

        document.addEventListener('click', (e) => {
            const p = e.target.closest('.btn-pres-sku');
            const q = e.target.closest('.btn-plan-sku');
            if (p) openPresupuestoModal(p.getAttribute('data-master'), p.getAttribute('data-sku'));
            if (q) openPlanModal(q.getAttribute('data-master'), q.getAttribute('data-sku'));
        });

        // Cambio de mes: limpia caché, detalle y estado de modales
        MES_SELECTOR?.addEventListener('change', async e => {
            if (!e.target.value) return;
            MES = e.target.value;
            MES_CORTO = obtenerMesCorto(MES.split('-')[1] || "01");
            LAST_OPEN_MASTER = null;
            CURRENT_PLAN_MASTER = null; CURRENT_PLAN_SKU = null; PLAN_MODAL_RAW = [];
            CACHE_PRES.clear(); CACHE_PROD.clear(); CACHE_PROD_REAL.clear(); CACHE_VENTA_REAL.clear(); CACHE_INV_SKU.clear();
            INVENTARIO_PROMESA = null;
            await cargarTabla();
        });
    </script>
}
