<script>
    let ultimoHash = "";
    let ultimoMapa = new Map();
    let primeraCarga = true;

    // =========================================================
    // ROTACIÓN DEL TABLERO POR BLOQUES
    // 10 embarques cada 15 segundos
    // =========================================================
    const TAMANO_BLOQUE_TABLERO = 10;
    const INTERVALO_BLOQUE_TABLERO_MS = 15000;

    // Duración real del movimiento. El tablero permanece quieto y después
    // se desliza suavemente durante este tiempo.
    const DURACION_MOVIMIENTO_TABLERO_MS = 1650;

    let bloqueActualTablero = 0;
    let direccionTablero = 1; // 1 = baja, -1 = sube
    let timerBloquesTablero = null;
    let rafMovimientoTablero = null;
    let movimientoTableroActivo = false;

    /* function updateClock() {
        const el = document.getElementById("boardClock");
        const now = new Date();

        el.textContent =
            now.toLocaleDateString("es-MX") +
            " · " +
            now.toLocaleTimeString("es-MX", {
                hour: "2-digit",
                minute: "2-digit",
                second: "2-digit"
            });
    } */

    function safe(v) {
        return v === null || v === undefined || v === "" ? "—" : v;
    }

        function escapeHtml(value) {
        return String(value)
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");
    }

    function airportFlipValue(value) {
        const finalValue = safe(value);
        return `<span class="flip-text" data-final="${escapeHtml(finalValue)}">${escapeHtml(finalValue)}</span>`;
    }

    function airportFlipTemperature(value) {
        if (value === null || value === undefined || value === "") {
            return airportFlipValue("—");
        }

        return airportFlipValue(`${value}°C`);
    }

        function obtenerPedidos(x) {

        if (Array.isArray(x.pedidos) && x.pedidos.length > 0) {

            return x.pedidos
                .filter(p =>
                    p &&
                    p.consecutivo !== null &&
                    p.consecutivo !== undefined &&
                    String(p.consecutivo).trim() !== ""
                )
                .map(p => ({
                    tipo: String(p.tipo || "OV").toUpperCase(),
                    consecutivo: String(p.consecutivo).trim()
                }));
        }


        // Respaldo por si llega información del formato anterior
        if (
            x.pedido !== null &&
            x.pedido !== undefined &&
            String(x.pedido).trim() !== "" &&
            String(x.pedido).trim() !== "N/A"
        ) {

            let tipo = "OV";

            if (x.tipoDocumento === "TR") {
                tipo = "TR";
            }

            return [{
                tipo: tipo,
                consecutivo: String(x.pedido).trim()
            }];
        }


        return [];
    }


    function claseTipoPedido(tipo) {

        return String(tipo).toUpperCase() === "TR"
            ? "pedido-tipo-tr"
            : "pedido-tipo-ov";
    }


    function crearPedidoRotativo(x) {

        const pedidos = obtenerPedidos(x);

        if (pedidos.length === 0) {
            return `
                <div class="pedido-rotator">
                    <span class="pedido-display">
                        <span class="pedido-consecutivo">N/A</span>
                    </span>
                </div>
            `;
        }


        const primero = pedidos[0];

        const datos = escapeHtml(
            JSON.stringify(pedidos)
        );


        const tooltip = escapeHtml(
            pedidos
                .map(p => `${p.tipo} ${p.consecutivo}`)
                .join(" • ")
        );


        const contador = pedidos.length > 1
            ? `
                <span class="pedido-contador">
                    1/${pedidos.length}
                </span>
            `
            : "";


        return `
            <div
                class="pedido-rotator"
                data-pedidos="${datos}"
                data-index="0"
                data-multiple="${pedidos.length > 1 ? "1" : "0"}"
                title="${tooltip}"
            >

                <span class="pedido-display">

                    <span
                        class="pedido-tipo ${claseTipoPedido(primero.tipo)}"
                    >
                        ${escapeHtml(primero.tipo)}
                    </span>

                    <span class="pedido-consecutivo">
                        ${escapeHtml(primero.consecutivo)}
                    </span>

                </span>

                ${contador}

            </div>
        `;
    }

    let rotacionPedidosTimer = null;


    function rotarPedido(elemento) {

        if (!elemento) return;


        let pedidos;

        try {

            pedidos = JSON.parse(
                elemento.dataset.pedidos || "[]"
            );

        } catch {

            return;
        }


        if (!Array.isArray(pedidos) || pedidos.length <= 1) {
            return;
        }


        const display =
            elemento.querySelector(".pedido-display");

        const tipoEl =
            elemento.querySelector(".pedido-tipo");

        const consecutivoEl =
            elemento.querySelector(".pedido-consecutivo");

        const contadorEl =
            elemento.querySelector(".pedido-contador");


        if (!display || !tipoEl || !consecutivoEl) {
            return;
        }


        const indiceActual =
            Number(elemento.dataset.index || 0);


        const siguienteIndice =
            (indiceActual + 1) % pedidos.length;


        const siguiente =
            pedidos[siguienteIndice];


        // =========================================================
        // 1. Sale el pedido actual
        // =========================================================

        display.classList.remove("pedido-in");

        display.classList.add("pedido-out");


        // =========================================================
        // 2. Cuando desaparece, cambiamos el contenido
        // =========================================================

        setTimeout(() => {

            // Si el tablero se actualizó mientras animaba,
            // no hacemos nada sobre un elemento viejo.
            if (!document.body.contains(elemento)) {
                return;
            }


            tipoEl.textContent =
                siguiente.tipo;


            tipoEl.classList.remove(
                "pedido-tipo-ov",
                "pedido-tipo-tr"
            );


            tipoEl.classList.add(
                claseTipoPedido(siguiente.tipo)
            );


            consecutivoEl.textContent =
                siguiente.consecutivo;


            elemento.dataset.index =
                siguienteIndice;


            if (contadorEl) {

                contadorEl.textContent =
                    `${siguienteIndice + 1}/${pedidos.length}`;
            }


            // =====================================================
            // 3. Entra el nuevo pedido
            // =====================================================

            display.classList.remove("pedido-out");


            // Reinicia correctamente la animación CSS
            void display.offsetWidth;


            display.classList.add("pedido-in");


            setTimeout(() => {

                display.classList.remove("pedido-in");

            }, 400);


        }, 220);
    }


    function iniciarRotacionPedidos() {

        if (rotacionPedidosTimer) {
            return;
        }


        rotacionPedidosTimer = setInterval(() => {

            const elementos =
                document.querySelectorAll(
                    '.pedido-rotator[data-multiple="1"]'
                );


            elementos.forEach((elemento, index) => {

                // Pequeño desfase entre filas.
                // Hace que el tablero se vea más vivo y
                // evita que absolutamente todos cambien
                // en el mismo milisegundo.
                setTimeout(() => {

                    if (document.body.contains(elemento)) {
                        rotarPedido(elemento);
                    }

                }, index * 90);

            });


        }, 3200);
    }

    // ============================================================
    // ROTADOR DE CLIENTES
    // ============================================================

    function obtenerClientes(x) {

        if (
            Array.isArray(x.clientes) &&
            x.clientes.length > 0
        ) {

            const vistos = new Set();

            return x.clientes
                .filter(c =>
                    c !== null &&
                    c !== undefined &&
                    String(c).trim() !== ""
                )
                .map(c => String(c).trim())
                .filter(c => {

                    const clave = c.toUpperCase();

                    if (vistos.has(clave)) {
                        return false;
                    }

                    vistos.add(clave);

                    return true;
                });
        }


        // Respaldo por compatibilidad con el formato anterior
        if (
            x.cliente !== null &&
            x.cliente !== undefined &&
            String(x.cliente).trim() !== "" &&
            String(x.cliente).trim() !== "Sin cliente"
        ) {

            return [
                String(x.cliente).trim()
            ];
        }


        return [];
    }


    function crearClienteRotativo(x) {

        const clientes = obtenerClientes(x);


        // ========================================================
        // SIN CLIENTES
        // ========================================================
        if (clientes.length === 0) {

            return `
                <div class="cliente-rotator">

                    <span class="cliente-display">

                        <span class="cliente-icono">
                            CLI
                        </span>

                        <span class="cliente-nombre">
                            N/A
                        </span>

                    </span>

                </div>
            `;
        }


        const primero = clientes[0];


        // Todos los clientes guardados en el propio elemento
        const datos = escapeHtml(
            JSON.stringify(clientes)
        );


        // Tooltip para poder ver todos pasando el mouse
        const tooltip = escapeHtml(
            clientes.join(" • ")
        );


        // Contador únicamente cuando hay más de uno
        const contador =
            clientes.length > 1
                ? `
                    <span class="cliente-contador">
                        1/${clientes.length}
                    </span>
                `
                : "";


        return `
            <div
                class="cliente-rotator"
                data-clientes="${datos}"
                data-index="0"
                data-multiple="${clientes.length > 1 ? "1" : "0"}"
                title="${tooltip}"
            >

                <span class="cliente-display">

                    <span class="cliente-icono">
                        CLI
                    </span>

                    <span class="cliente-nombre">
                        ${escapeHtml(primero)}
                    </span>

                </span>

                ${contador}

            </div>
        `;
    }


    let rotacionClientesTimer = null;


    function rotarCliente(elemento) {

        if (!elemento) {
            return;
        }


        let clientes;


        try {

            clientes = JSON.parse(
                elemento.dataset.clientes || "[]"
            );

        }
        catch {

            return;
        }


        if (
            !Array.isArray(clientes) ||
            clientes.length <= 1
        ) {

            return;
        }


        const display =
            elemento.querySelector(
                ".cliente-display"
            );


        const nombreEl =
            elemento.querySelector(
                ".cliente-nombre"
            );


        const contadorEl =
            elemento.querySelector(
                ".cliente-contador"
            );


        if (
            !display ||
            !nombreEl
        ) {

            return;
        }


        const indiceActual =
            Number(
                elemento.dataset.index || 0
            );


        const siguienteIndice =
            (indiceActual + 1) % clientes.length;


        const siguiente =
            clientes[siguienteIndice];


        // ========================================================
        // 1. SALE EL CLIENTE ACTUAL
        // ========================================================

        display.classList.remove(
            "cliente-in"
        );

        display.classList.add(
            "cliente-out"
        );


        // ========================================================
        // 2. CAMBIAMOS EL CLIENTE
        // ========================================================

        setTimeout(() => {

            // El tablero pudo refrescarse mientras estaba animando
            if (!document.body.contains(elemento)) {
                return;
            }


            nombreEl.textContent =
                siguiente;


            elemento.dataset.index =
                siguienteIndice;


            if (contadorEl) {

                contadorEl.textContent =
                    `${siguienteIndice + 1}/${clientes.length}`;
            }


            // ====================================================
            // 3. ENTRA EL SIGUIENTE CLIENTE
            // ====================================================

            display.classList.remove(
                "cliente-out"
            );


            // Fuerza reinicio de animación
            void display.offsetWidth;


            display.classList.add(
                "cliente-in"
            );


            setTimeout(() => {

                display.classList.remove(
                    "cliente-in"
                );

            }, 400);


        }, 220);
    }


    function iniciarRotacionClientes() {

        if (rotacionClientesTimer) {
            return;
        }


        rotacionClientesTimer =
            setInterval(() => {

                const elementos =
                    document.querySelectorAll(
                        '.cliente-rotator[data-multiple="1"]'
                    );


                elementos.forEach(
                    (elemento, index) => {

                        // Igual que pedidos:
                        // pequeño desfase por cada fila
                        setTimeout(() => {

                            if (
                                document.body.contains(elemento)
                            ) {

                                rotarCliente(elemento);
                            }

                        }, index * 90);

                    }
                );


            }, 3200);
    }

    function animarFlipTextos(scope) {
        const chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-:/ .";
        const elementos = scope.querySelectorAll(".flip-text");

        elementos.forEach((el, index) => {
            const finalText = el.dataset.final || "—";
            const length = Math.max(finalText.length, 1);
            let ciclos = 0;
            const maxCiclos = 8 + Math.min(length, 12);

            el.classList.remove("finalized");
            el.classList.add("flipping");

            const intervalo = setInterval(() => {
                ciclos++;

                let temporal = "";

                for (let i = 0; i < length; i++) {
                    const finalChar = finalText[i] || " ";

                    if (finalChar === " " || finalChar === "—") {
                        temporal += finalChar;
                    } else if (ciclos > maxCiclos - Math.ceil(i / 2)) {
                        temporal += finalChar;
                    } else {
                        temporal += chars[Math.floor(Math.random() * chars.length)];
                    }
                }

                el.textContent = temporal;

                if (ciclos >= maxCiclos) {
                    clearInterval(intervalo);
                    el.textContent = finalText;
                    el.classList.remove("flipping");
                    el.classList.add("finalized");
                }
            }, 42 + (index % 4) * 8);
        });
    }

    function badgeMini(valor) {
        if (valor === "OK") {
            return `<span class="mini-ok">OK</span>`;
        }

        return `<span class="mini-pending">PEND.</span>`;
    }

    function showToast(titulo, mensaje) {
        const toast = document.getElementById("airportToast");
        const title = document.getElementById("airportToastTitle");
        const body = document.getElementById("airportToastBody");

        if (!toast || !title || !body) return;

        title.textContent = titulo;
        body.textContent = mensaje;

        toast.classList.remove("show");
        void toast.offsetWidth;
        toast.classList.add("show");
    }

    function animateNumber(id, newValue) {
        const el = document.getElementById(id);
        if (!el) return;

        const oldValue = Number(el.textContent || 0);

        if (oldValue === newValue) return;

        const duration = 600;
        const start = performance.now();

        const card = el.closest(".stat-card");
        if (card) {
            card.classList.remove("flash");
            void card.offsetWidth;
            card.classList.add("flash");

            setTimeout(() => card.classList.remove("flash"), 900);
        }

        function tick(now) {
            const progress = Math.min((now - start) / duration, 1);
            const value = Math.round(oldValue + (newValue - oldValue) * progress);

            el.textContent = value;

            if (progress < 1) {
                requestAnimationFrame(tick);
            }
        }

        requestAnimationFrame(tick);
    }

    function renderStats(data) {
        animateNumber("stTotal", data.length);
        animateNumber("stPendientes", data.filter(x => x.estatus === 1).length);
        animateNumber("stLiberados", data.filter(x => x.estatus === 7).length);
        animateNumber("stRuta", data.filter(x => x.estatus === 2).length);
        animateNumber("stRetrasados", data.filter(x => x.estatus === 4).length);
        animateNumber("stEntregados", data.filter(x => x.estatus === 5).length);
    }

    function crearFirma(x) {
        return JSON.stringify({
            id: x.id,
            consecutivo: x.consecutivo,
            nombreEmbarque: x.nombreEmbarque,
            cliente: x.cliente,

            clientes:
                Array.isArray(x.clientes)
                    ? x.clientes
                    : [],

            pedido: x.pedido,

            pedidos:
                Array.isArray(x.pedidos)
                    ? x.pedidos
                    : [],

            placa: x.placa,
            temperatura: x.temperatura,

            fechaEstimadaLlegada:
                x.fechaEstimadaLlegada,

            fechaSalida:
                x.fechaSalida,

            fechaDestino:
                x.fechaDestino,

            fechaEntregado:
                x.fechaEntregado,

            calidad:
                x.calidad,

            documentacion:
                x.documentacion,

            estatus:
                x.estatus,

            estatusTexto:
                x.estatusTexto,

            estatusTipo:
                x.estatusTipo
        });
    }

    function renderTabla(data) {
        const tbody = document.getElementById("tbodyTablero");

        if (!data || data.length === 0) {
            tbody.innerHTML = `<tr><td colspan="14" class="empty">No hay embarques para mostrar.</td></tr>`;
            return;
        }

        const categorias = [
            { estatus: 5, titulo: "Entregados Recientes" },
            { estatus: 2, titulo: "En Ruta" },
            { estatus: 3, titulo: "Llegaron a Destino" },
            { estatus: 4, titulo: "Retrasados / Incidencias" },
            { estatus: 7, titulo: "Liberados para QR" },
            { estatus: 1, titulo: "Pendientes de Validación" },
            { estatus: 6, titulo: "Devueltos" }

        ];

        let html = "";

        categorias.forEach(cat => {
            const items = data
                .filter(x => x.estatus === cat.estatus)
                .sort((a, b) => {
                    const fechaA = new Date(a.fechaCreacionOrden);
                    const fechaB = new Date(b.fechaCreacionOrden);

                    // MÁS RECIENTE → MÁS ANTIGUO
                    const comparacionFecha = fechaB - fechaA;

                    // Si fueron creados exactamente al mismo tiempo,
                    // el ID más nuevo va primero
                    if (comparacionFecha !== 0) {
                        return comparacionFecha;
                    }

                    return (b.id ?? 0) - (a.id ?? 0);
                });

            if (items.length === 0) return;

            html += `
                <tr class="board-category-row">
                    <td colspan="14">
                        <div class="board-category">
                            <span>${cat.titulo}</span>
                            <span class="board-category-count">${items.length} embarque(s)</span>
                        </div>
                    </td>
                </tr>
            `;

            html += items.map(x => {
                const firmaActual = crearFirma(x);
                const firmaAnterior = ultimoMapa.get(x.id);

                let claseAnimacion = "";

                if (!primeraCarga) {
                    if (!firmaAnterior) {
                        claseAnimacion = "row-new";
                    } else if (firmaAnterior !== firmaActual) {
                        claseAnimacion = "row-changed";
                    }
                }

                return `
                    <tr data-id="${x.id}" class="${claseAnimacion}">

                        <td>
                            <strong>${safe(x.consecutivo)}</strong>
                        </td>

                        <td>
                            <strong>${safe(x.nombreEmbarque)}</strong>
                        </td>

                        <td class="cliente-cell">
                            ${crearClienteRotativo(x)}
                        </td>

                        <td class="pedido-cell">
                            ${crearPedidoRotativo(x)}
                        </td>

                        <td>${airportFlipValue(x.fechaEstimadaLlegada)}</td>
                        <td>${airportFlipValue(x.fechaSalida)}</td>
                        <td>${airportFlipValue(x.fechaDestino)}</td>
                        <td>${airportFlipValue(x.fechaEntregado)}</td>
                        <td>${badgeMini(x.calidad)}</td>
                        <td>${badgeMini(x.documentacion)}</td>
                        <td>
                            <span class="badge-status badge-animate st-${x.estatusTipo}">
                                ${safe(x.estatusTexto)}
                            </span>
                        </td>
                    </tr>
                `;
            }).join("");
        });

        tbody.innerHTML = html;
    }

    function detectarCambios(data) {
        if (primeraCarga) return;

        let nuevos = 0;
        let modificados = 0;

        data.forEach(x => {
            const firmaActual = crearFirma(x);
            const firmaAnterior = ultimoMapa.get(x.id);

            if (!firmaAnterior) {
                nuevos++;
            } else if (firmaAnterior !== firmaActual) {
                modificados++;
            }
        });

        if (nuevos > 0 || modificados > 0) {
            const partes = [];

            if (nuevos > 0) partes.push(`${nuevos} nuevo(s)`);
            if (modificados > 0) partes.push(`${modificados} actualizado(s)`);

            showToast("Movimiento detectado", `Se detectaron ${partes.join(" y ")} en el tablero.`);
        }
    }

    function actualizarMapa(data) {
        ultimoMapa.clear();

        data.forEach(x => {
            ultimoMapa.set(x.id, crearFirma(x));
        });
    }

    async function cargarDatos() {
        try {
            const resp = await fetch('@Url.Action("TableroAeropuertoData", "Embarques")', {
                cache: "no-store"
            });

            if (!resp.ok) {
                throw new Error("No se pudo cargar la información del tablero.");
            }

            const data = await resp.json();
            const nuevoHash = JSON.stringify(data);

            renderStats(data);

            if (nuevoHash !== ultimoHash) {
                detectarCambios(data);
                renderTabla(data);

                // Si los datos cambiaron mientras el tablero estaba en otro bloque,
                // conservamos el bloque actual siempre que todavía exista.
                reajustarBloqueActual();

                setTimeout(() => {
                    document
                        .querySelectorAll("#tbodyTablero tr.row-new, #tbodyTablero tr.row-changed")
                        .forEach(row => {
                            animarFlipTextos(row);
                        });
                }, 80);

                actualizarMapa(data);

                ultimoHash = nuevoHash;
                primeraCarga = false;
            }
        } catch (err) {
            console.error(err);
            showToast("Error de conexión", "No se pudo actualizar el tablero en este momento.");
        }
    }

    function obtenerFilasEmbarquesTablero() {
        return Array.from(
            document.querySelectorAll("#tbodyTablero tr[data-id]")
        );
    }

    function obtenerCategoriaDeFila(fila) {
        if (!fila) return null;

        let anterior = fila.previousElementSibling;

        while (anterior) {
            if (anterior.classList.contains("board-category-row")) {
                return anterior;
            }

            anterior = anterior.previousElementSibling;
        }

        return null;
    }

    function obtenerDestinoBloque(indiceEmbarque) {
        const container = document.getElementById("boardScroll");
        const table = container?.querySelector("table");
        const thead = table?.querySelector("thead");
        const filas = obtenerFilasEmbarquesTablero();

        if (!container || filas.length === 0) {
            return 0;
        }

        indiceEmbarque = Math.max(
            0,
            Math.min(indiceEmbarque, filas.length - 1)
        );

        const filaObjetivo = filas[indiceEmbarque];
        const categoria = obtenerCategoriaDeFila(filaObjetivo);

        /*
         * Si el primer embarque del bloque pertenece justo al inicio
         * de una sección, enseñamos también el título de la sección.
         */
        let ancla = filaObjetivo;

        if (
            categoria &&
            filaObjetivo.previousElementSibling === categoria
        ) {
            ancla = categoria;
        }

        const altoEncabezado = thead?.offsetHeight ?? 0;

        /*
         * offsetTop es estable aunque el tablero ya esté desplazado,
         * evitando el efecto de "brinco" que producía getBoundingClientRect().
         */
        let destino = Math.max(
            0,
            ancla.offsetTop - altoEncabezado
        );

        const maxScroll = Math.max(
            0,
            container.scrollHeight - container.clientHeight
        );

        return Math.min(destino, maxScroll);
    }

    function easingSuaveTablero(t) {
        /*
         * EaseInOutSine:
         * arranca muy despacio, toma velocidad y vuelve a frenar.
         * Para una pantalla fija se ve mucho más natural que "smooth".
         */
        return -(Math.cos(Math.PI * t) - 1) / 2;
    }

    function animarScrollTablero(destino, duracion = DURACION_MOVIMIENTO_TABLERO_MS) {
        const container = document.getElementById("boardScroll");

        if (!container) {
            return Promise.resolve();
        }

        if (rafMovimientoTablero) {
            cancelAnimationFrame(rafMovimientoTablero);
            rafMovimientoTablero = null;
        }

        const inicio = container.scrollTop;
        const distancia = destino - inicio;

        if (Math.abs(distancia) < 2) {
            container.scrollTop = destino;
            return Promise.resolve();
        }

        movimientoTableroActivo = true;
        container.classList.add("tablero-moving");

        return new Promise(resolve => {
            const tiempoInicio = performance.now();

            function frame(ahora) {
                const progreso = Math.min(
                    (ahora - tiempoInicio) / duracion,
                    1
                );

                const suavizado = easingSuaveTablero(progreso);

                container.scrollTop =
                    inicio + (distancia * suavizado);

                if (progreso < 1) {
                    rafMovimientoTablero =
                        requestAnimationFrame(frame);

                    return;
                }

                container.scrollTop = destino;
                container.classList.remove("tablero-moving");

                movimientoTableroActivo = false;
                rafMovimientoTablero = null;

                resolve();
            }

            rafMovimientoTablero =
                requestAnimationFrame(frame);
        });
    }

    function totalBloquesTablero() {
        const filas = obtenerFilasEmbarquesTablero();

        return Math.max(
            1,
            Math.ceil(filas.length / TAMANO_BLOQUE_TABLERO)
        );
    }

    async function moverTableroABloque(numeroBloque, animado = true) {
        const filas = obtenerFilasEmbarquesTablero();
        const container = document.getElementById("boardScroll");

        if (!container || filas.length === 0) {
            bloqueActualTablero = 0;
            return;
        }

        const bloques = totalBloquesTablero();

        numeroBloque = Math.max(
            0,
            Math.min(numeroBloque, bloques - 1)
        );

        bloqueActualTablero = numeroBloque;

        const indiceEmbarque =
            numeroBloque * TAMANO_BLOQUE_TABLERO;

        const destino =
            obtenerDestinoBloque(indiceEmbarque);

        if (animado) {
            await animarScrollTablero(destino);
        } else {
            container.scrollTop = destino;
        }
    }

    async function avanzarBloqueTablero() {
        if (movimientoTableroActivo) {
            return;
        }

        const filas = obtenerFilasEmbarquesTablero();
        const container = document.getElementById("boardScroll");

        if (!container || filas.length === 0) {
            bloqueActualTablero = 0;
            direccionTablero = 1;
            return;
        }

        const maxScroll = Math.max(
            0,
            container.scrollHeight - container.clientHeight
        );

        const bloques = totalBloquesTablero();

        /*
         * Si todo cabe en la pantalla, no hacemos movimientos innecesarios.
         */
        if (
            maxScroll <= 5 ||
            bloques <= 1
        ) {
            bloqueActualTablero = 0;
            direccionTablero = 1;
            container.scrollTop = 0;
            return;
        }

        let siguienteBloque =
            bloqueActualTablero + direccionTablero;

        /*
         * En vez de brincar del final al principio:
         * al llegar abajo invertimos el sentido.
         */
        if (siguienteBloque >= bloques) {
            direccionTablero = -1;
            siguienteBloque =
                Math.max(0, bloqueActualTablero - 1);
        }
        else if (siguienteBloque < 0) {
            direccionTablero = 1;
            siguienteBloque =
                Math.min(bloques - 1, bloqueActualTablero + 1);
        }

        await moverTableroABloque(
            siguienteBloque,
            true
        );
    }

    function reajustarBloqueActual() {
        /*
         * Cuando llega una actualización del servidor no brincamos
         * artificialmente al inicio del bloque. Conservamos la posición
         * visual que ya tenía la televisión y solamente la limitamos
         * si el contenido ahora es más corto.
         */
        requestAnimationFrame(() => {
            const container =
                document.getElementById("boardScroll");

            if (!container) {
                return;
            }

            const bloques = totalBloquesTablero();

            if (bloqueActualTablero >= bloques) {
                bloqueActualTablero =
                    Math.max(0, bloques - 1);

                direccionTablero = -1;
            }

            const maxScroll = Math.max(
                0,
                container.scrollHeight - container.clientHeight
            );

            if (container.scrollTop > maxScroll) {
                container.scrollTop = maxScroll;
            }
        });
    }

    function iniciarAutoScroll() {
        if (timerBloquesTablero) {
            clearInterval(timerBloquesTablero);
            timerBloquesTablero = null;
        }

        if (rafMovimientoTablero) {
            cancelAnimationFrame(rafMovimientoTablero);
            rafMovimientoTablero = null;
        }

        bloqueActualTablero = 0;
        direccionTablero = 1;
        movimientoTableroActivo = false;

        requestAnimationFrame(() => {
            const container =
                document.getElementById("boardScroll");

            if (container) {
                container.scrollTop = 0;
            }
        });

        timerBloquesTablero = setInterval(() => {
            avanzarBloqueTablero();
        }, INTERVALO_BLOQUE_TABLERO_MS);
    }

    document.addEventListener("DOMContentLoaded", function () {

        //updateClock();
        //setInterval(updateClock, 1000);

        cargarDatos();

        setInterval(
            cargarDatos,
            8000
        );

        iniciarAutoScroll();

        // ROTADORES
        iniciarRotacionPedidos();
        iniciarRotacionClientes();
    });

</script>