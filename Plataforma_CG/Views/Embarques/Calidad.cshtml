    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-sap">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-sap">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        </div>
    }

    @if (!pendientes.Any())
    {
        <div class="empty-state">
            <i class="bi bi-inbox"></i>
            <h4>No hay embarques pendientes de validar</h4>
            <p class="text-muted mb-0">Cuando existan nuevos embarques por revisar, aparecerán aquí.</p>
        </div>
    }
    else
    {
        <div class="quality-list">
            @foreach (var e in pendientes)
            {
                var cardId = $"card_{e.Id}";
                var filesId = $"files_{e.Id}";
                var uploadId = $"upload_{e.Id}";
                var formId = $"form_{e.Id}";

                var docsMap = ViewBag.EmbarquesDocumentos as Dictionary<int, object>;
                dynamic docs = docsMap != null && docsMap.ContainsKey(e.Id) ? docsMap[e.Id] : null;

                IEnumerable<dynamic> ordenes = docs?.OrdenesVenta ?? Enumerable.Empty<dynamic>();
                IEnumerable<dynamic> transferencias = docs?.Transferencias ?? Enumerable.Empty<dynamic>();

                var totalOV = ordenes.Count();
                var totalTR = transferencias.Count();

                var productosTemperatura = productosTemperaturaCalidad.ContainsKey(e.Id)
                ? productosTemperaturaCalidad[e.Id]
                : new List<Plataforma_CG.Models.EmbarqueProductoTemperaturaItemVm>();

                // ============================================================
                // TEMPERATURAS: LA UNIDAD DE CAPTURA ES LA TARIMA, NO EL SKU
                // Si una tarima contiene varios SKUs, se muestra una sola captura.
                // Los registros sin código de tarima se conservan separados.
                // ============================================================
                var gruposTarimaTemperatura = productosTemperatura
                .GroupBy(x => string.IsNullOrWhiteSpace(x.Tarima)
                ? $"__SIN_TARIMA__|{x.TipoDocumento}|{x.DocumentoId}|{x.OrigenDetalleId}"
                : $"{x.TipoDocumento}|{x.DocumentoId}|{x.Tarima.Trim().ToUpperInvariant()}")
                .ToList();

                var totalTarimasTemperatura = gruposTarimaTemperatura.Count;
                var tarimasTemperaturaCapturadas = gruposTarimaTemperatura.Count(g =>
                g.Any(x => x.Temperatura.HasValue));

                var gruposDocumentos = productosTemperatura
                .GroupBy(x => new
                {
                    x.TipoDocumento,
                    x.DocumentoId,
                    x.DocumentoConsecutivo,
                    x.DocumentoCliente
                })
                .Select(g =>
                {
                    var tarimasDocumento = g
                    .GroupBy(x => string.IsNullOrWhiteSpace(x.Tarima)
                    ? $"__SIN_TARIMA__|{x.TipoDocumento}|{x.DocumentoId}|{x.OrigenDetalleId}"
                    : x.Tarima.Trim().ToUpperInvariant())
                    .ToList();

                    return new
                    {
                        TipoDocumento = g.Key.TipoDocumento,
                        DocumentoId = g.Key.DocumentoId,
                        DocumentoConsecutivo = g.Key.DocumentoConsecutivo,
                        DocumentoCliente = g.Key.DocumentoCliente,
                        Items = g.OrderBy(x => x.Tarima).ThenBy(x => x.ProductoCodigo).ToList(),

                        TotalTarimas = tarimasDocumento.Count,
                        TarimasCapturadas = tarimasDocumento.Count(t =>
                        t.Any(x => x.Temperatura.HasValue)),

                        TotalSku = g
                    .Select(x => x.ProductoCodigo)
                    .Where(x => !string.IsNullOrWhiteSpace(x))
                    .Distinct()
                    .Count(),

                        TotalCajas = g.Sum(x => x.Cajas),
                        TotalKilos = g.Sum(x => x.Kilos)
                    };
                })
                .OrderBy(g => g.TipoDocumento == "OV" ? 0 : 1)
                .ThenBy(g => g.DocumentoConsecutivo)
                .ToList();

                <div class="embarque-card" id="@cardId">
                    <div class="embarque-summary" onclick="toggleCard('@cardId')">
                        <div>
                            @{
                                var consecutivoEmbarque = !string.IsNullOrWhiteSpace(e.Consecutivo)
                                ? e.Consecutivo
                                : $"EMB-{e.Id}";

                                var tieneNombreEmbarque = !string.IsNullOrWhiteSpace(e.NombreEmbarque);

                                var nombreEmbarqueTexto = tieneNombreEmbarque
                                ? e.NombreEmbarque.Trim()
                                : "Sin nombre asignado";

                                var nombreEmbarqueClase = tieneNombreEmbarque
                                ? "embarque-name-chip"
                                : "embarque-name-chip empty";
                            }

                            <h4 class="embarque-id embarque-title-with-name">
                                <span class="embarque-title-main">
                                    <i class="bi bi-truck-front"></i>
                                    Embarque #@consecutivoEmbarque
                                </span>

                                <span class="@nombreEmbarqueClase">
                                    <i class="bi bi-tag"></i>
                                    @nombreEmbarqueTexto
                                </span>
                            </h4>

                            <div class="embarque-meta">
                                <span class="meta-pill pending">
                                    <i class="bi bi-hourglass-split"></i>
                                    Pendiente de validación
                                </span>

                                <span class="meta-pill primary">
                                    <i class="bi bi-calendar-event"></i>
                                    @e.FechaCreacion.ToString("yyyy-MM-dd HH:mm")
                                </span>

                                <span class="meta-pill">
                                    <i class="bi bi-hash"></i>
                                    ID: @e.Id
                                </span>
                            </div>
                        </div>

                        <div class="summary-right">
                            <div class="summary-count">
                                <small>Documentos</small>
                                <strong>@totalOV OV / @totalTR TR</strong>
                            </div>

                            <button type="button" class="toggle-btn" onclick="event.stopPropagation(); toggleCard('@cardId')">
                                <i class="bi bi-chevron-down"></i>
                            </button>
                        </div>
                    </div>

                    <div class="embarque-detail">
                        <div class="validation-layout">

                            <aside class="side-panel">
                                <div class="quick-card">
                                    <div class="card-head">
                                        <h5 class="card-title">
                                            <i class="bi bi-info-circle"></i>
                                            Resumen rápido
                                        </h5>
                                        <div class="card-sub">Datos principales del embarque seleccionado</div>
                                    </div>

                                    <div class="card-body">
                                        <div class="quick-row">
                                            <div class="quick-label">Consecutivo</div>
                                            <div class="quick-value">@e.Consecutivo</div>
                                        </div>

                                        <div class="quick-row">
                                            <div class="quick-label">Fecha</div>
                                            <div class="quick-value">@e.FechaCreacion.ToString("yyyy-MM-dd HH:mm")</div>
                                        </div>

                                        <div class="quick-row">
                                            <div class="quick-label">Órdenes</div>
                                            <div class="quick-value">@totalOV</div>
                                        </div>

                                        <div class="quick-row">
                                            <div class="quick-label">Transferencias</div>
                                            <div class="quick-value">@totalTR</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="docs-card">
                                    <div class="card-head">
                                        <h5 class="card-title">
                                            <i class="bi bi-folder2-open"></i>
                                            Documentos
                                        </h5>
                                        <div class="card-sub">Resumen del contenido del embarque</div>
                                    </div>

                                    <div class="card-body">
                                        <div class="doc-buttons">
                                            <div class="doc-mini">
                                                <i class="bi bi-box-seam"></i>
                                                <strong>@totalOV</strong>
                                                <span>OV</span>
                                            </div>

                                            <div class="doc-mini">
                                                <i class="bi bi-arrow-left-right"></i>
                                                <strong>@totalTR</strong>
                                                <span>TR</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </aside>

                            <main>
                                @if (ordenes.Any())
                                {
                                    <div class="form-card mb-3">
                                        <div class="card-head">
                                            <h5 class="card-title">
                                                <i class="bi bi-box-seam"></i>
                                                Órdenes de Venta Incluidas
                                            </h5>
                                            <div class="card-sub">@totalOV registro(s) integrados a este embarque</div>
                                        </div>

                                        <div class="card-body">
                                            <div class="table-wrap">
                                                <table class="tabla-soft">
                                                    <thead>
                                                        <tr>
                                                            <th>Consecutivo</th>
                                                            <th>Cliente</th>
                                                            <th>Ruta</th>
                                                            <th>Fecha Entrega</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>

                                                        @foreach (var ov in ordenes)
                                                        {
                                                            <tr>
                                                                <td data-label="Consecutivo">@ov.Consecutivo</td>
                                                                <td data-label="Cliente">@ov.NombreCliente</td>
                                                                <td data-label="Ruta">@(ov.Ruta ?? "-")</td>
                                                                <td data-label="Fecha Entrega">
                                                                    @(ov.FechaEntrega != null
                                                                                                                        ? Convert.ToDateTime(ov.FechaEntrega).ToString("yyyy-MM-dd")
                                                                                                                        : "-")
                                                </td>
                                            </tr>
                                                                                        }

                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                }

                                @if (transferencias.Any())
                                {
                                    <div class="form-card mb-3">
                                        <div class="card-head">
                                            <h5 class="card-title">
                                                <i class="bi bi-arrow-left-right"></i>
                                                Transferencias Incluidas
                                            </h5>
                                            <div class="card-sub">@totalTR registro(s) relacionados a este embarque</div>
                                        </div>

                                        <div class="card-body">
                                            <div class="table-wrap">
                                                <table class="tabla-soft">
                                                    <thead>
                                                        <tr>
                                                            <th>Consecutivo</th>
                                                            <th>Sucursal</th>
                                                            <th>Fecha Solicitud</th>
                                                            <th>Solicitó</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var tr in transferencias)
                                                        {
                                                            <tr>
                                                                <td data-label="Consecutivo">@tr.Consecutivo</td>
                                                                <td data-label="Sucursal">@(tr.Sucursal ?? "-")</td>
                                                                <td data-label="Fecha Solicitud">
                                                                    @(tr.FechaSolicitud != null
                                                                                                                        ? Convert.ToDateTime(tr.FechaSolicitud).ToString("yyyy-MM-dd")
                                                                                                                        : "-")
                                                </td>
                                                <td data-label="Solicitó">@(tr.UsuarioSolicita ?? "-")</td>
                                            </tr>
                                                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                }

                                <form id="@formId"
                                      asp-action="RegistrarCalidad"
                                      method="post"
                                      enctype="multipart/form-data"
                                      class="form-calidad-validacion"
                                      data-embarque-id="@e.Id"
                                      novalidate>

                                    <input type="hidden" name="id" value="@e.Id" />

                                    <div class="validation-client-box" data-validation-box>
                                        <strong>
                                            <i class="bi bi-exclamation-triangle-fill"></i>
                                            No se puede validar el embarque
                                        </strong>
                                        <ul data-validation-list></ul>
                                    </div>

                                    <div class="accordion-quality">

                                        <section class="quality-step open">
                                            <button type="button" class="step-head" onclick="toggleStep(this)">
                                                <span class="step-head-left">
                                                    <span class="step-number">1</span>
                                                    <span>
                                                        <span class="step-title">Salida</span>
                                                        <span class="step-desc">Tipo de salida del embarque</span>
                                                    </span>
                                                </span>
                                                <i class="bi bi-chevron-down step-chevron"></i>
                                            </button>

                                            <div class="step-body">
                                                <div class="row g-3 mt-1">
                                                    <div class="col-md-4">
                                                        <label class="form-label">Tipo de salida</label>
                                                        <select name="salidaTipo"
                                                                class="form-select"
                                                                data-required-message="Selecciona el tipo de salida.">
                                                            <option value="">Selecciona</option>
                                                            <option value="TIF 776">TIF 776</option>
                                                            <option value="TIF 805">TIF 805</option>
                                                            <option value="NO TIF">NO TIF</option>
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>
                                        </section>

                                        <section class="quality-step">
                                            <button type="button" class="step-head" onclick="toggleStep(this)">
                                                <span class="step-head-left">
                                                    <span class="step-number">2</span>
                                                    <span>
                                                        <span class="step-title">Transporte</span>
                                                        <span class="step-desc">Placa, temperatura programada y condiciones de unidad</span>
                                                    </span>
                                                </span>
                                                <i class="bi bi-chevron-down step-chevron"></i>
                                            </button>

                                            <div class="step-body">
                                                <div class="row g-3 mt-1">
                                                    <div class="col-md-4">
                                                        <label class="form-label">Placa</label>
                                                        <input type="text"
                                                               name="placaTransporte"
                                                               class="form-control"
                                                               placeholder="Ej. 45-AT-9K"
                                                               data-required-message="Captura la placa del transporte." />
                                                    </div>

                                                    <div class="col-md-4">
                                                        <label class="form-label">Temperatura de programación</label>
                                                        <input type="number"
                                                               step="0.1"
                                                               name="temperaturaProgramacion"
                                                               class="form-control"
                                                               placeholder="Ej. 4.0"
                                                               data-required-message="Captura la temperatura de programación." />
                                                        <div class="input-hint">Captura el valor en °C</div>
                                                    </div>

                                                    <div class="col-md-4">
                                                        <label class="form-label">Condiciones de unidad</label>
                                                        <select name="estadoUnidad"
                                                                class="form-select"
                                                                data-required-message="Selecciona las condiciones de la unidad.">
                                                            <option value="">Selecciona</option>
                                                            <option value="BUENO">Bueno</option>
                                                            <option value="REGULAR">Regular</option>
                                                            <option value="MALO">Malo</option>
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>
                                        </section>

                                        <section class="quality-step">
                                            <button type="button" class="step-head" onclick="toggleStep(this)">
                                                <span class="step-head-left">
                                                    <span class="step-number">3</span>
                                                    <span>
                                                        <span class="step-title">Tiempos de embarque</span>
                                                        <span class="step-desc">Inicio y término de carga</span>
                                                    </span>
                                                </span>
                                                <i class="bi bi-chevron-down step-chevron"></i>
                                            </button>

                                            <div class="step-body">
                                                <div class="row g-3 mt-1">
                                                    <div class="col-md-6">
                                                        <label class="form-label">Hora de inicio de embarque</label>
                                                        <input type="datetime-local"
                                                               name="horaInicioEmbarque"
                                                               class="form-control"
                                                               data-required-message="Captura la hora de inicio de embarque." />
                                                    </div>

                                                    <div class="col-md-6">
                                                        <label class="form-label">Hora de término de embarque</label>
                                                        <input type="datetime-local"
                                                               name="horaTerminoEmbarque"
                                                               class="form-control"
                                                               data-required-message="Captura la hora de término de embarque." />
                                                    </div>
                                                </div>
                                            </div>
                                        </section>

                                        <section class="quality-step">
                                            <button type="button" class="step-head" onclick="toggleStep(this)">
                                                <span class="step-head-left">
                                                    <span class="step-number">4</span>
                                                    <span>
                                                        <span class="step-title">Temperaturas</span>
                                                        <span class="step-desc">Temperatura de unidad al inicio y término</span>
                                                    </span>
                                                </span>
                                                <i class="bi bi-chevron-down step-chevron"></i>
                                            </button>

                                            <div class="step-body">
                                                <div class="row g-3 mt-1">
                                                    <div class="col-md-6">
                                                        <label class="form-label">Temperatura de unidad inicio</label>
                                                        <input type="number"
                                                               step="0.1"
                                                               name="temperaturaUnidadInicio"
                                                               class="form-control"
                                                               placeholder="Ej. 3.8"
                                                               data-required-message="Captura la temperatura de unidad al inicio." />
                                                    </div>

                                                    <div class="col-md-6">
                                                        <label class="form-label">Temperatura de unidad término</label>
                                                        <input type="number"
                                                               step="0.1"
                                                               name="temperaturaUnidadTermino"
                                                               class="form-control"
                                                               placeholder="Ej. 4.2"
                                                               data-required-message="Captura la temperatura de unidad al término." />
                                                    </div>
                                                </div>
                                            </div>
                                        </section>

                                        <section class="quality-step">
                                            <button type="button" class="step-head" onclick="toggleStep(this)">
                                                <span class="step-head-left">
                                                    <span class="step-number">5</span>
                                                    <span>
                                                        <span class="step-title">Producto</span>
                                                        <span class="step-desc">Condición del producto que se carga</span>
                                                    </span>
                                                </span>
                                                <i class="bi bi-chevron-down step-chevron"></i>
                                            </button>

                                            <div class="step-body">
                                                <div class="row g-3 mt-1">
                                                    <div class="col-md-6">
                                                        <label class="form-label">Condiciones del producto que se carga</label>
                                                        <select name="estadoProductos"
                                                                class="form-select"
                                                                data-required-message="Selecciona las condiciones del producto.">
                                                            <option value="">Selecciona</option>
                                                            <option value="BUENO">Bueno</option>
                                                            <option value="REGULAR">Regular</option>
                                                            <option value="MALO">Malo</option>
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>
                                        </section>

                                        <section class="quality-step">
                                            <button type="button" class="step-head" onclick="toggleStep(this)">
                                                <span class="step-head-left">
                                                    <span class="step-number">6</span>
                                                    <span>
                                                        <span class="step-title">Equipos de medición</span>
                                                        <span class="step-desc">Termograficador y termómetro utilizado</span>
                                                    </span>
                                                </span>
                                                <i class="bi bi-chevron-down step-chevron"></i>
                                            </button>

                                            <div class="step-body">
                                                <div class="row g-3 mt-1">
                                                    <div class="col-md-6">
                                                        <label class="form-label">Código de termograficador</label>
                                                        <input type="text"
                                                               name="codigoTermograficador"
                                                               class="form-control"
                                                               placeholder="Código"
                                                               data-required-message="Captura el código de termograficador." />
                                                    </div>

                                                    <div class="col-md-6">
                                                        <label class="form-label">N° de termómetro utilizado</label>
                                                        <input type="text"
                                                               name="numeroTermometro"
                                                               class="form-control"
                                                               placeholder="Número"
                                                               data-required-message="Captura el número de termómetro utilizado." />
                                                    </div>
                                                </div>
                                            </div>
                                        </section>

                                        <section class="quality-step">
                                            <button type="button" class="step-head" onclick="toggleStep(this)">
                                                <span class="step-head-left">
                                                    <span class="step-number">7</span>
                                                    <span>
                                                        <span class="step-title">Observaciones y acciones</span>
                                                        <span class="step-desc">Hallazgos, comentarios y acciones correctivas</span>
                                                    </span>
                                                </span>
                                                <i class="bi bi-chevron-down step-chevron"></i>
                                            </button>

                                            <div class="step-body">
                                                <div class="row g-3 mt-1">
                                                    <div class="col-12">
                                                        <label class="form-label">Acciones correctivas</label>
                                                        <textarea name="accionesCorrectivasCalidad"
                                                          class="form-control"
                                                          rows="3"
                                                          placeholder="Acciones correctivas aplicadas..."
                                                          data-required-message="Captura las acciones correctivas. Si no aplica, escribe N/A."></textarea>
                                                    </div>

                                                    <div class="col-12">
                                                        <label class="form-label">Observaciones de calidad</label>
                                                        <textarea name="observacionesCalidad"
                                                          class="form-control"
                                                          rows="4"
                                                          placeholder="Agrega comentarios de la inspección, hallazgos o detalles relevantes..."
                                                          data-required-message="Captura las observaciones de calidad. Si no aplica, escribe N/A."></textarea>
                                                    </div>
                                                </div>
                                            </div>
                                        </section>

                                        <section class="quality-step">
                                            <button type="button" class="step-head" onclick="toggleStep(this)">
                                                <span class="step-head-left">
                                                    <span class="step-number">8</span>
                                                    <span>
                                                        <span class="step-title">Evidencia fotográfica</span>
                                                        <span class="step-desc">Fotografías del embarque o condiciones inspeccionadas</span>
                                                    </span>
                                                </span>
                                                <i class="bi bi-chevron-down step-chevron"></i>
                                            </button>

                                            <div class="step-body">
                                                <div class="row g-3 mt-1">
                                                    <div class="col-12">
                                                        <label class="form-label">Fotografías</label>

                                                        <div class="upload-box" id="@uploadId">
                                                            <input type="file"
                                                                   name="fotosCalidad"
                                                                   class="form-control"
                                                                   accept="image/*"
                                                                   capture="environment"
                                                                   multiple
                                                                   data-required-message="Agrega al menos una fotografía de evidencia."
                                                                   onchange="mostrarArchivos(this, '@filesId', '@uploadId')" />

                                                            <div class="upload-help">
                                                                Puedes subir varias fotografías o tomarlas directamente desde el celular.
                                                            </div>

                                                            <div class="file-list" id="@filesId"></div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </section>

                                        <section class="quality-step" data-temperature-step>
                                            <button type="button" class="step-head" onclick="toggleStep(this)">
                                                <span class="step-head-left">
                                                    <span class="step-number">9</span>
                                                    <span>
                                                        <span class="step-title">Temperatura por tarima</span>
                                                        <span class="step-desc" data-sku-step-progress>
                                                            Una sola captura por código de tarima. Guardado parcial:
                                                            @tarimasTemperaturaCapturadas/@totalTarimasTemperatura tarima(s).
                                                        </span>
                                                    </span>
                                                </span>
                                                <i class="bi bi-chevron-down step-chevron"></i>
                                            </button>

                                            <div class="step-body">
                                                @if (productosTemperatura.Any())
                                                {
                                                    <div class="sku-temp-summary mt-3">
                                                        <div>
                                                            <strong>Avance de captura</strong>
                                                            <div class="input-hint">
                                                                Si una tarima contiene varios SKUs, aquí aparecerán juntos y compartirán una sola temperatura.
                                                            </div>
                                                        </div>

                                                        <span class="sku-temp-badge" data-sku-general-progress>
                                                            @tarimasTemperaturaCapturadas / @totalTarimasTemperatura capturadas
                                                        </span>
                                                    </div>

                                                    <div class="sku-doc-groups mt-3">
                                                        @foreach (var doc in gruposDocumentos)
                                                        {
                                                            var tipoCss = doc.TipoDocumento == "OV" ? "ov" : "tr";
                                                            var tipoTexto = doc.TipoDocumento == "OV" ? "Orden de Venta" : "Transferencia";
                                                            var clienteTexto = string.IsNullOrWhiteSpace(doc.DocumentoCliente)
                                                            ? (doc.TipoDocumento == "OV" ? "Cliente no disponible" : "Sucursal no disponible")
                                                            : doc.DocumentoCliente;

                                                            <div class="sku-doc-card @tipoCss"
                                                                 data-sku-doc
                                                                 data-tipo-documento="@doc.TipoDocumento"
                                                                 data-documento-id="@doc.DocumentoId">
                                                                <div class="sku-doc-head">
                                                                    <div class="sku-doc-head-main">
                                                                        <div class="sku-doc-type-row">
                                                                            <span class="sku-doc-type-badge">@tipoTexto</span>
                                                                            <span class="sku-doc-progress-chip" data-sku-doc-progress>
                                                                                @doc.TarimasCapturadas / @doc.TotalTarimas tarima(s) capturadas
                                                                            </span>
                                                                        </div>

                                                                        <h5 class="sku-doc-title">@doc.DocumentoConsecutivo</h5>

                                                                        <div class="sku-doc-client">
                                                                            <i class="bi bi-building"></i>
                                                                            <span>@clienteTexto</span>
                                                                        </div>
                                                                    </div>

                                                                    <div class="sku-doc-metrics">
                                                                        <div class="sku-doc-metric">
                                                                            <small>Tarimas</small>
                                                                            <strong>@doc.TotalTarimas</strong>
                                                                        </div>
                                                                        <div class="sku-doc-metric">
                                                                            <small>Cajas</small>
                                                                            <strong>@doc.TotalCajas</strong>
                                                                        </div>
                                                                        <div class="sku-doc-metric">
                                                                            <small>Kilos</small>
                                                                            <strong>@doc.TotalKilos.ToString("N2")</strong>
                                                                        </div>
                                                                    </div>
                                                                </div>

                                                                <div class="table-wrap mt-3">
                                                                    <table class="tabla-soft sku-temp-table">
                                                                        <thead>
                                                                            <tr>
                                                                                <th>Tarima</th>
                                                                                <th>SKU</th>
                                                                                <th>Producto</th>
                                                                                <th>Almacén</th>
                                                                                <th>Cajas</th>
                                                                                <th>Kilos</th>
                                                                                <th>Temperatura °C</th>
                                                                                <th>Observaciones</th>
                                                                                <th>Última captura</th>
                                                                            </tr>
                                                                        </thead>
                                                                        <tbody>
                                                                            @{
                                                                                var gruposTarimaDocumento = doc.Items
                                                                                .OrderBy(x => x.Tarima)
                                                                                .ThenBy(x => x.ProductoCodigo)
                                                                                .GroupBy(x => string.IsNullOrWhiteSpace(x.Tarima)
                                                                                ? $"__SIN_TARIMA__|{x.TipoDocumento}|{x.DocumentoId}|{x.OrigenDetalleId}"
                                                                                : x.Tarima.Trim().ToUpperInvariant())
                                                                                .ToList();
                                                                            }

                                                                            @foreach (var tarimaGroup in gruposTarimaDocumento)
                                                                            {
                                                                                var itemsTarima = tarimaGroup.ToList();

                                                                                var codigoTarima = itemsTarima
                                                                                .Select(x => x.Tarima)
                                                                                .FirstOrDefault(x => !string.IsNullOrWhiteSpace(x)) ?? "";

                                                                                var ultimaCapturaTarima = itemsTarima
                                                                                .Where(x => x.Temperatura.HasValue)
                                                                                .OrderByDescending(x => x.FechaUltimaCaptura ?? DateTime.MinValue)
                                                                                .FirstOrDefault();

                                                                                var tempValue = ultimaCapturaTarima?.Temperatura.HasValue == true
                                                                                ? ultimaCapturaTarima.Temperatura.Value.ToString(
                                                                                "0.##",
                                                                                System.Globalization.CultureInfo.InvariantCulture)
                                                                                : "";

                                                                                var observacionTarima = ultimaCapturaTarima?.Observaciones
                                                                                ?? itemsTarima
                                                                                .Select(x => x.Observaciones)
                                                                                .FirstOrDefault(x => !string.IsNullOrWhiteSpace(x))
                                                                                ?? "";

                                                                                var skusTarima = itemsTarima
                                                                                .GroupBy(x => new
                                                                                {
                                                                                    Codigo = (x.ProductoCodigo ?? "").Trim(),
                                                                                    Nombre = (x.ProductoNombre ?? "").Trim()
                                                                                })
                                                                                .Select(g => new
                                                                                {
                                                                                    g.Key.Codigo,
                                                                                    g.Key.Nombre,
                                                                                    Cajas = g.Sum(x => x.Cajas),
                                                                                    Kilos = g.Sum(x => x.Kilos)
                                                                                })
                                                                                .OrderBy(x => x.Codigo)
                                                                                .ToList();

                                                                                var almacenesTarima = itemsTarima
                                                                                .Select(x => (x.Almacen ?? "").Trim())
                                                                                .Where(x => !string.IsNullOrWhiteSpace(x))
                                                                                .Distinct()
                                                                                .OrderBy(x => x)
                                                                                .ToList();

                                                                                var totalCajasTarima = itemsTarima.Sum(x => x.Cajas);
                                                                                var totalKilosTarima = itemsTarima.Sum(x => x.Kilos);

                                                                                var detallesGuardar = itemsTarima.Select(x => new
                                                                                {
                                                                                    tipoDocumento = x.TipoDocumento,
                                                                                    documentoId = x.DocumentoId,
                                                                                    origenDetalleId = x.OrigenDetalleId,
                                                                                    productoCodigo = x.ProductoCodigo,
                                                                                    almacen = x.Almacen
                                                                                });

                                                                                var detallesJson =
                                                                                System.Text.Json.JsonSerializer.Serialize(detallesGuardar);

                                                                                <tr data-sku-row
                                                                                    data-tarima="@codigoTarima"
                                                                                    data-items='@detallesJson'
                                                                                    class="tarima-nueva">

                                                                                    <td data-label="Tarima">
                                                                                        @if (!string.IsNullOrWhiteSpace(codigoTarima))
                                                                                        {
                                                                                            <span class="tarima-chip">@codigoTarima</span>
                                                                                        }
                                                                                        else
                                                                                        {
                                                                                            <span class="text-muted">Sin código</span>
                                                                                        }
                                                                                    </td>

                                                                                    <td data-label="SKU">
                                                                                        <div class="d-flex flex-column gap-1">
                                                                                            @foreach (var sku in skusTarima)
                                                                                            {
                                                                                                <div>
                                                                                                    <strong>@sku.Codigo</strong>
                                                                                                    <small class="text-muted ms-1">
                                                                                                        (@sku.Cajas caja(s))
                                                                                                    </small>
                                                                                                </div>
                                                                                            }
                                                                                        </div>
                                                                                    </td>

                                                                                    <td data-label="Producto">
                                                                                        <div class="d-flex flex-column gap-1">
                                                                                            @foreach (var sku in skusTarima)
                                                                                            {
                                                                                                <div>
                                                                                                    @(string.IsNullOrWhiteSpace(sku.Nombre)
                                                                                                                                                                                ? sku.Codigo
                                                                                                                                                                                : sku.Nombre)
                                                                        </div>
                                                                                                                                                }
                                                                                    </div>
                                                                                </td>

                                                                                <td data-label="Almacén">
                                                                                    @(almacenesTarima.Any()
                                                                                                                                                        ? string.Join(", ", almacenesTarima)
                                                                                                                                                        : "-")
                                                                </td>

                                                                                    <td data-label="Cajas">
                                                                                        <strong>@totalCajasTarima</strong>
                                                                                    </td>

                                                                                    <td data-label="Kilos">
                                                                                        <strong>@totalKilosTarima.ToString("N2")</strong>
                                                                                    </td>

                                                                                    <td data-label="Temperatura °C">
                                                                                        <input type="number"
                                                                                               step="0.1"
                                                                                               class="form-control temp-sku-input"
                                                                                               value="@tempValue"
                                                                                               placeholder="Ej. 4.0"
                                                                                               data-required-message="Captura la temperatura de la tarima @(string.IsNullOrWhiteSpace(codigoTarima) ? "sin código" : codigoTarima)." />
                                                                                    </td>

                                                                                    <td data-label="Observaciones">
                                                                                        <input type="text"
                                                                                               class="form-control temp-sku-obs"
                                                                                               value="@observacionTarima"
                                                                                               placeholder="Opcional" />
                                                                                    </td>

                                                                                    <td data-label="Última captura" data-sku-last-capture>
                                                                    @if (ultimaCapturaTarima?.FechaUltimaCaptura.HasValue == true)
                                                                                        {
                                                                                            <span class="sku-captured">
                                                                                                <i class="bi bi-check-circle-fill"></i>
                                                                                                @ultimaCapturaTarima.FechaUltimaCaptura.Value.ToString("yyyy-MM-dd HH:mm")
                                                                                            </span>
                                                                                            <br />
                                                                                            <small>@(ultimaCapturaTarima.UsuarioUltimaCaptura ?? "Sistema")</small>
                                                                                        }
                                                                                        else
                                                                                        {
                                                                                            <span class="sku-pending">
                                                                                                <i class="bi bi-hourglass-split"></i>
                                                                                                Pendiente
                                                                                            </span>
                                                                                        }
                                                                                    </td>
                                                                                </tr>
                                                                            }
                                                                        </tbody>
                                                                    </table>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="pending-box mt-3">
                                                        No se encontraron SKUs ligados a las órdenes o transferencias de este embarque.
                                                    </div>
                                                }
                                            </div>
                                        </section>

                                        @*                                         <section class="quality-step">
                                            <button type="button" class="step-head" onclick="toggleStep(this)">
                                                <span class="step-head-left">
                                                    <span class="step-number">9</span>
                                                    <span>
                                                        <span class="step-title">Datos pendientes</span>
                                                        <span class="step-desc">Información que aún falta ligar desde BD</span>
                                                    </span>
                                                </span>
                                                <i class="bi bi-chevron-down step-chevron"></i>
                                            </button>

                                            <div class="step-body">
                                                <div class="pending-box mt-3">
                                                    <strong>Falta definir origen en BD para:</strong><br />
                                                    Datos del producto: Hora de liberación, Temperatura °C, SKU, Lote,
                                                    N° de cajas por tarima, Fecha de producción y Fecha de caducidad.
                                                </div>
                                            </div>
                                        </section> *@
                                    </div>

                                    <div class="form-actions-sticky">
                                        <div class="action-note">
                                            <i class="bi bi-info-circle me-1"></i>
                                            Revisa la información antes de liberar este embarque.
                                            <br />
                                            <span class="sku-save-status"
                                                  data-sku-status
                                                  aria-live="polite"></span>
                                        </div>

                                        <div class="d-flex gap-2 flex-wrap">
                                            <button type="button"
                                                    class="btn btn-sap btn-sap-outline"
                                                    data-btn-guardar-temperaturas
                                                    onclick="guardarTemperaturasSku(this.closest('form'), false)">
                                                <i class="bi bi-save me-1"></i>
                                                Guardar temperaturas
                                            </button>

                                            <button type="submit" class="btn btn-sap btn-sap-success">
                                                <i class="bi bi-check2-circle me-1"></i>
                                                Validar Calidad
                                            </button>
                                        </div>
                                    </div>
                                </form>
                            </main>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="quality-history-divider">
        <div class="quality-history-title">
            <i class="bi bi-clock-history"></i>
            Historial de formularios validados
        </div>
    </div>

    <div class="quality-filter-panel">
        <div class="quality-filter-title">
            <i class="bi bi-funnel"></i>
            Filtros de historial
        </div>

        <form method="get" asp-action="Calidad" class="quality-filter-grid">
            <input type="hidden" name="busqueda" value="@busqueda" />
            <input type="hidden" name="fechaInicio" value="@fechaInicio" />
            <input type="hidden" name="fechaFin" value="@fechaFin" />

            <div class="quality-filter-group">
                <label>Buscar formulario</label>
                <input type="text"
                       name="busquedaHistorial"
                       value="@busquedaHistorial"
                       class="quality-filter-input"
                       placeholder="Ej. EMB-0001, 125, nombre..." />
            </div>

            <div class="quality-filter-group">
                <label>Fecha validación inicio</label>
                <input type="date"
                       name="fechaInicioHistorial"
                       value="@fechaInicioHistorial"
                       class="quality-filter-input" />
            </div>

            <div class="quality-filter-group">
                <label>Fecha validación fin</label>
                <input type="date"
                       name="fechaFinHistorial"
                       value="@fechaFinHistorial"
                       class="quality-filter-input" />
            </div>

            <button type="submit" class="quality-filter-btn primary">
                <i class="bi bi-search"></i>
                Buscar historial
            </button>

            <a asp-action="Calidad"
               asp-route-busqueda="@busqueda"
               asp-route-fechaInicio="@fechaInicio"
               asp-route-fechaFin="@fechaFin"
               class="quality-filter-btn secondary">
                <i class="bi bi-arrow-clockwise"></i>
                Limpiar historial
            </a>
        </form>
    </div>

    @if (!buscoHistorialCalidad)
    {
        <div class="empty-state">
            <i class="bi bi-calendar-range"></i>
            <h4>Selecciona un rango de fechas</h4>
            <p class="text-muted mb-0">
                El historial de formularios validados no carga información hasta que indiques fecha inicio y fecha fin.
            </p>
        </div>
    }
    else if (!historialCalidad.Any())
    {
        <div class="empty-state">
            <i class="bi bi-search"></i>
            <h4>No se encontraron formularios validados</h4>
            <p class="text-muted mb-0">
                No existen registros de calidad validados dentro del rango seleccionado.
            </p>
        </div>
    }
    else
    {
        <div class="quality-list">
            @foreach (var h in historialCalidad)
            {
                var cardHistId = $"hist_calidad_{h.Id}";
                var reporteTemperaturasId = $"reporte_temperaturas_{h.Id}";

                var docsMapHist = ViewBag.EmbarquesDocumentos as Dictionary<int, object>;
                dynamic docsHist = docsMapHist != null && docsMapHist.ContainsKey(h.Id) ? docsMapHist[h.Id] : null;

                IEnumerable<dynamic> ordenesHist = docsHist?.OrdenesVenta ?? Enumerable.Empty<dynamic>();
                IEnumerable<dynamic> transferenciasHist = docsHist?.Transferencias ?? Enumerable.Empty<dynamic>();

                var totalOVHist = ordenesHist.Count();
                var totalTRHist = transferenciasHist.Count();

                var fotosHist = fotosCalidadHistorial.ContainsKey(h.Id)
                ? fotosCalidadHistorial[h.Id]
                : new List<Plataforma_CG.Models.Embarque.EmbarqueCalidadFoto>();

                // ============================================================
                // HISTÓRICO: TEMPERATURAS AGRUPADAS POR TARIMA
                // Conservamos la misma regla que en captura:
                // 1 tarima = 1 temperatura visible, aunque tenga varios SKUs.
                // ============================================================
                var productosTemperaturaHist = productosTemperaturaCalidad.ContainsKey(h.Id)
                ? productosTemperaturaCalidad[h.Id]
                : new List<Plataforma_CG.Models.EmbarqueProductoTemperaturaItemVm>();

                var tarimasTemperaturaHist = productosTemperaturaHist
                .GroupBy(x => string.IsNullOrWhiteSpace(x.Tarima)
                ? $"__SIN_TARIMA__|{x.TipoDocumento}|{x.DocumentoId}|{x.OrigenDetalleId}"
                : $"{x.TipoDocumento}|{x.DocumentoId}|{x.Tarima.Trim().ToUpperInvariant()}")
                .Select(g =>
                {
                    var items = g.ToList();

                    var ultimaCaptura = items
                    .Where(x => x.Temperatura.HasValue)
                    .OrderByDescending(x => x.FechaUltimaCaptura ?? DateTime.MinValue)
                    .FirstOrDefault();

                    var productosTarima = items
                    .GroupBy(x => new
                    {
                        Codigo = (x.ProductoCodigo ?? "").Trim(),
                        Nombre = (x.ProductoNombre ?? "").Trim()
                    })
                    .Select(pg => new
                    {
                        pg.Key.Codigo,
                        pg.Key.Nombre,
                        Cajas = pg.Sum(x => x.Cajas),
                        Kilos = pg.Sum(x => x.Kilos)
                    })
                    .OrderBy(x => x.Codigo)
                    .ToList();

                    return new
                    {
                        TipoDocumento = items.First().TipoDocumento,
                        DocumentoId = items.First().DocumentoId,
                        DocumentoConsecutivo = items.First().DocumentoConsecutivo,
                        DocumentoCliente = items.First().DocumentoCliente,
                        Tarima = items.Select(x => x.Tarima)
                    .FirstOrDefault(x => !string.IsNullOrWhiteSpace(x)) ?? "Sin código",
                        Productos = productosTarima,
                        TotalCajas = items.Sum(x => x.Cajas),
                        TotalKilos = items.Sum(x => x.Kilos),
                        Temperatura = ultimaCaptura?.Temperatura,
                        Observaciones = ultimaCaptura?.Observaciones
                    ?? items.Select(x => x.Observaciones)
                    .FirstOrDefault(x => !string.IsNullOrWhiteSpace(x)),
                        FechaCaptura = ultimaCaptura?.FechaUltimaCaptura,
                        UsuarioCaptura = ultimaCaptura?.UsuarioUltimaCaptura
                    ?? items.Select(x => x.UsuarioUltimaCaptura)
                    .FirstOrDefault(x => !string.IsNullOrWhiteSpace(x))
                    };
                })
                .OrderBy(x => x.TipoDocumento == "OV" ? 0 : 1)
                .ThenBy(x => x.DocumentoConsecutivo)
                .ThenBy(x => x.Tarima)
                .ToList();

                var tarimasHistCapturadas = tarimasTemperaturaHist.Count(x => x.Temperatura.HasValue);
                var totalCajasHistTemperatura = tarimasTemperaturaHist.Sum(x => x.TotalCajas);
                var totalKilosHistTemperatura = tarimasTemperaturaHist.Sum(x => x.TotalKilos);

                <div class="embarque-card" id="@cardHistId">
                    <div class="embarque-summary" onclick="toggleCard('@cardHistId')">
                        <div>
                            @{
                                var consecutivoEmbarqueHistorial = !string.IsNullOrWhiteSpace(h.Consecutivo)
                                ? h.Consecutivo
                                : $"EMB-{h.Id}";

                                var tieneNombreEmbarqueHistorial = !string.IsNullOrWhiteSpace(h.NombreEmbarque);

                                var nombreEmbarqueTextoHistorial = tieneNombreEmbarqueHistorial
                                ? h.NombreEmbarque.Trim()
                                : "Sin nombre asignado";

                                var nombreEmbarqueClaseHistorial = tieneNombreEmbarqueHistorial
                                ? "embarque-name-chip"
                                : "embarque-name-chip empty";
                            }

                        <h4 class="embarque-id embarque-title-with-name">
                            <span class="embarque-title-main">
                                <i class="bi bi-clipboard-check"></i>
                                Formulario validado - Embarque #@consecutivoEmbarqueHistorial
                            </span>

                            <span class="@nombreEmbarqueClaseHistorial">
                                <i class="bi bi-tag"></i>
                                @nombreEmbarqueTextoHistorial
                            </span>
                        </h4>

                        <div class="embarque-meta">
                            <span class="meta-pill history-badge-ok">
                                <i class="bi bi-check-circle-fill"></i>
                                Validado
                            </span>

                            <span class="meta-pill primary">
                                <i class="bi bi-calendar-check"></i>
                                Validado:
                                @(h.FechaValidacionCalidad != null
                                                            ? Convert.ToDateTime(h.FechaValidacionCalidad).ToString("yyyy-MM-dd HH:mm")
                                                            : "-")
                                                              </span>

                            <span class="meta-pill">
                                <i class="bi bi-person-check"></i>
                                @(h.UsuarioValidaCalidad ?? "Sistema")
                            </span>

                            <span class="meta-pill">
                                <i class="bi bi-hash"></i>
                                ID: @h.Id
                            </span>
                        </div>
                    </div>

                    <div class="summary-right">
                        <div class="summary-count">
                            <small>Documentos</small>
                            <strong>@totalOVHist OV / @totalTRHist TR</strong>
                        </div>

                        <button type="button" class="toggle-btn" onclick="event.stopPropagation(); toggleCard('@cardHistId')">
                            <i class="bi bi-chevron-down"></i>
                        </button>
                    </div>
                </div>

                <div class="embarque-detail">
                    <div class="history-export-actions">
                        <a asp-controller="Embarques"
                           asp-action="DescargarTemperaturasPdf"
                           asp-route-id="@h.Id"
                           class="history-export-btn pdf">
                            <i class="bi bi-file-earmark-pdf"></i>
                            Descargar PDF
                        </a>

                        <button type="button"
                                class="history-export-btn print"
                                onclick="imprimirTemperaturasCalidad('@reporteTemperaturasId')">
                            <i class="bi bi-printer"></i>
                            Imprimir temperaturas
                        </button>
                    </div>

                    <div class="validation-layout">

                        <aside class="side-panel">
                            <div class="quick-card">
                                <div class="card-head">
                                    <h5 class="card-title">
                                        <i class="bi bi-info-circle"></i>
                                        Resumen del formulario
                                    </h5>
                                    <div class="card-sub">Datos generales de la validación de calidad</div>
                                </div>

                                <div class="card-body">
                                    <div class="quick-row">
                                        <div class="quick-label">Consecutivo</div>
                                        <div class="quick-value">@h.Consecutivo</div>
                                    </div>

                                    <div class="quick-row">
                                        <div class="quick-label">Nombre</div>
                                        <div class="quick-value">@(h.NombreEmbarque ?? "-")</div>
                                    </div>

                                    <div class="quick-row">
                                        <div class="quick-label">Fecha creación</div>
                                        <div class="quick-value">@h.FechaCreacion.ToString("yyyy-MM-dd HH:mm")</div>
                                    </div>

                                    <div class="quick-row">
                                        <div class="quick-label">Validó</div>
                                        <div class="quick-value">@(h.UsuarioValidaCalidad ?? "Sistema")</div>
                                    </div>

                                    <div class="quick-row">
                                        <div class="quick-label">Fotos</div>
                                        <div class="quick-value">@fotosHist.Count</div>
                                    </div>
                                </div>
                            </div>

                            <div class="docs-card">
                                <div class="card-head">
                                    <h5 class="card-title">
                                        <i class="bi bi-folder2-open"></i>
                                        Documentos
                                    </h5>
                                    <div class="card-sub">Resumen del embarque validado</div>
                                </div>

                                <div class="card-body">
                                    <div class="doc-buttons">
                                        <div class="doc-mini">
                                            <i class="bi bi-box-seam"></i>
                                            <strong>@totalOVHist</strong>
                                            <span>OV</span>
                                        </div>

                                        <div class="doc-mini">
                                            <i class="bi bi-arrow-left-right"></i>
                                            <strong>@totalTRHist</strong>
                                            <span>TR</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </aside>

                        <main>
                            <div class="form-card mb-3">
                                <div class="card-head">
                                    <h5 class="card-title">
                                        <i class="bi bi-ui-checks"></i>
                                        Datos capturados en calidad
                                    </h5>
                                    <div class="card-sub">Información registrada al momento de validar el formulario</div>
                                </div>

                                <div class="card-body">
                                    <div class="history-detail-grid">
                                        <div class="history-detail-item">
                                            <div class="history-detail-label">Tipo de salida</div>
                                            <div class="history-detail-value">@(h.SalidaTipo ?? "-")</div>
                                        </div>

                                        <div class="history-detail-item">
                                            <div class="history-detail-label">Placa transporte</div>
                                            <div class="history-detail-value">@(h.PlacaTransporte ?? "-")</div>
                                        </div>

                                        <div class="history-detail-item">
                                            <div class="history-detail-label">Temp. programación</div>
                                            <div class="history-detail-value">
                                                @(h.TemperaturaProgramacion.HasValue
                                                                                            ? h.TemperaturaProgramacion.Value.ToString("N2") + " °C"
                                                                                            : "-")
                                                                                              </div>
                                                                                          </div>

                                        <div class="history-detail-item">
                                            <div class="history-detail-label">Estado unidad</div>
                                            <div class="history-detail-value">@(h.EstadoUnidadCalidad ?? "-")</div>
                                        </div>

                                        <div class="history-detail-item">
                                            <div class="history-detail-label">Inicio embarque</div>
                                            <div class="history-detail-value">
                                                @(h.HoraInicioEmbarque != null
                                                                                            ? Convert.ToDateTime(h.HoraInicioEmbarque).ToString("yyyy-MM-dd HH:mm")
                                                                                            : "-")
                                                                                              </div>
                                                                                          </div>

                                        <div class="history-detail-item">
                                            <div class="history-detail-label">Término embarque</div>
                                            <div class="history-detail-value">
                                                @(h.HoraTerminoEmbarque != null
                                                                                            ? Convert.ToDateTime(h.HoraTerminoEmbarque).ToString("yyyy-MM-dd HH:mm")
                                                                                            : "-")
                                                                                              </div>
                                                                                          </div>

                                        <div class="history-detail-item">
                                            <div class="history-detail-label">Temp. unidad inicio</div>
                                            <div class="history-detail-value">
                                                @(h.TemperaturaUnidadInicio.HasValue
                                                                                            ? h.TemperaturaUnidadInicio.Value.ToString("N2") + " °C"
                                                                                            : "-")
                                                                                              </div>
                                                                                          </div>

                                        <div class="history-detail-item">
                                            <div class="history-detail-label">Temp. unidad término</div>
                                            <div class="history-detail-value">
                                                @(h.TemperaturaUnidadTermino.HasValue
                                                                                            ? h.TemperaturaUnidadTermino.Value.ToString("N2") + " °C"
                                                                                            : "-")
                                                                                              </div>
                                                                                          </div>

                                        <div class="history-detail-item">
                                            <div class="history-detail-label">Estado productos</div>
                                            <div class="history-detail-value">@(h.EstadoProductosCalidad ?? "-")</div>
                                        </div>

                                        <div class="history-detail-item">
                                            <div class="history-detail-label">Código termograficador</div>
                                            <div class="history-detail-value">@(h.CodigoTermograficador ?? "-")</div>
                                        </div>

                                        <div class="history-detail-item">
                                            <div class="history-detail-label">Número termómetro</div>
                                            <div class="history-detail-value">@(h.NumeroTermometro ?? "-")</div>
                                        </div>

                                        <div class="history-detail-item">
                                            <div class="history-detail-label">Fecha validación</div>
                                            <div class="history-detail-value">
                                                @(h.FechaValidacionCalidad != null
                                                                                            ? Convert.ToDateTime(h.FechaValidacionCalidad).ToString("yyyy-MM-dd HH:mm")
                                                                                            : "-")
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                                <div class="form-card mb-3">
                                    <div class="card-head">
                                        <h5 class="card-title">
                                            <i class="bi bi-chat-left-text"></i>
                                            Observaciones y acciones correctivas
                                        </h5>
                                    </div>

                                    <div class="card-body">
                                        <div class="history-detail-grid">
                                            <div class="history-detail-item">
                                                <div class="history-detail-label">Acciones correctivas</div>
                                                <div class="history-detail-value">@(h.AccionesCorrectivasCalidad ?? "-")</div>
                                            </div>

                                            <div class="history-detail-item">
                                                <div class="history-detail-label">Observaciones</div>
                                                <div class="history-detail-value">@(h.ObservacionesCalidad ?? "-")</div>
                                            </div>

                                            <div class="history-detail-item">
                                                <div class="history-detail-label">Evidencia fotográfica</div>
                                                <div class="history-detail-value">
                                            @if (fotosHist.Any())
                                                    {
                                                        <div class="quality-photo-grid">
                                                            @{
                                                                var indexFoto = 1;
                                                                var consecutivoHist = !string.IsNullOrWhiteSpace(h.Consecutivo)
                                                                ? h.Consecutivo
                                                                : $"EMB-{h.Id}";
                                                            }

                                                            @foreach (var foto in fotosHist)
                                                            {
                                                                var tituloFoto = $"Foto {indexFoto} - {consecutivoHist}";

                                                                <button type="button"
                                                                        class="quality-photo-card"
                                                                        data-photo-url="@foto.RutaArchivo"
                                                                        data-photo-title="@tituloFoto"
                                                                        onclick="abrirFotoCalidadDesdeBoton(this)">
                                                                    <img src="@foto.RutaArchivo"
                                                                         alt="@tituloFoto"
                                                                         loading="lazy" />

                                                                    <div class="quality-photo-caption">
                                                                        <i class="bi bi-image"></i>
                                                                        Foto @indexFoto
                                                                    </div>

                                                                    <div class="quality-photo-date">
                                                                        @foto.FechaRegistro.ToString("yyyy-MM-dd HH:mm")
                                                                    </div>
                                                                </button>

                                                                indexFoto++;
                                                            }
                                                        </div>
                                                    }
                                                    else
                                                    {
                                                        <span>-</span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-card mb-3">
                                    <div class="card-head">
                                        <h5 class="card-title">
                                            <i class="bi bi-thermometer-half"></i>
                                            Temperaturas registradas por tarima
                                        </h5>
                                        <div class="card-sub">
                                            Una sola temperatura por código de tarima, mostrando todos los SKUs contenidos.
                                        </div>
                                    </div>

                                    <div class="card-body">
                                        @if (tarimasTemperaturaHist.Any())
                                        {
                                            <div class="history-temp-summary">
                                                <div class="history-temp-kpi">
                                                    <small>Tarimas registradas</small>
                                                    <strong>@tarimasHistCapturadas / @tarimasTemperaturaHist.Count</strong>
                                                </div>
                                                <div class="history-temp-kpi">
                                                    <small>Total cajas</small>
                                                    <strong>@totalCajasHistTemperatura</strong>
                                                </div>
                                                <div class="history-temp-kpi">
                                                    <small>Total kilos</small>
                                                    <strong>@totalKilosHistTemperatura.ToString("N2") kg</strong>
                                                </div>
                                            </div>

                                            <div class="table-wrap">
                                                <table class="tabla-soft history-temp-table">
                                                    <thead>
                                                        <tr>
                                                            <th>Documento</th>
                                                            <th>Tarima</th>
                                                            <th>Contenido / SKUs</th>
                                                            <th>Cajas</th>
                                                            <th>Kilos</th>
                                                            <th>Temperatura</th>
                                                            <th>Observaciones</th>
                                                            <th>Captura</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var tarimaHist in tarimasTemperaturaHist)
                                                        {
                                                            var tipoDocumentoHistTexto = tarimaHist.TipoDocumento == "OV"
                                                            ? "Orden de Venta"
                                                            : "Transferencia";

                                                            <tr>
                                                                <td data-label="Documento">
                                                                    <strong>@tipoDocumentoHistTexto</strong>
                                                                    <div class="input-hint">
                                                                        @(string.IsNullOrWhiteSpace(tarimaHist.DocumentoConsecutivo)
                                                                                                                                ? $"ID {tarimaHist.DocumentoId}"
                                                                                                                                : tarimaHist.DocumentoConsecutivo)
                                                    </div>
                                                    @if (!string.IsNullOrWhiteSpace(tarimaHist.DocumentoCliente))
                                                                    {
                                                                        <div class="input-hint">@tarimaHist.DocumentoCliente</div>
                                                                    }
                                                                </td>

                                                                <td data-label="Tarima">
                                                                    <strong class="history-temp-product-code">@tarimaHist.Tarima</strong>
                                                                </td>

                                                                <td data-label="Contenido / SKUs">
                                                                    <div class="history-temp-product-list">
                                                                        @foreach (var productoHist in tarimaHist.Productos)
                                                                        {
                                                                            <div class="history-temp-product">
                                                                                <span class="history-temp-product-code">
                                                                                    @(string.IsNullOrWhiteSpace(productoHist.Codigo) ? "S/SKU" : productoHist.Codigo)
                                                                                </span>
                                                                                <span class="history-temp-product-name">
                                                                                    @(string.IsNullOrWhiteSpace(productoHist.Nombre) ? "Producto sin descripción" : productoHist.Nombre)
                                                                                </span>
                                                                                <span class="history-temp-product-boxes">
                                                                                    @productoHist.Cajas caja(s)
                                                                                </span>
                                                                            </div>
                                                                        }
                                                                    </div>
                                                                </td>

                                                                <td data-label="Cajas">@tarimaHist.TotalCajas</td>
                                                                <td data-label="Kilos">@tarimaHist.TotalKilos.ToString("N2")</td>

                                                                <td data-label="Temperatura">
                                                                    @if (tarimaHist.Temperatura.HasValue)
                                                                    {
                                                                        <span class="history-temp-value">
                                                                            @tarimaHist.Temperatura.Value.ToString("N2") °C
                                                                        </span>
                                                                    }
                                                                    else
                                                                    {
                                                                        <span class="history-temp-value empty">Sin captura</span>
                                                                    }
                                                            </td>

                                                            <td data-label="Observaciones">
                                                                @(string.IsNullOrWhiteSpace(tarimaHist.Observaciones)
                                                                                                                    ? "-"
                                                                                                                    : tarimaHist.Observaciones)
                                                                                                                                           </td>

                                                            <td data-label="Captura">
                                                                <strong>
                                                                    @(tarimaHist.FechaCaptura.HasValue
                                                                                                                            ? tarimaHist.FechaCaptura.Value.ToString("yyyy-MM-dd HH:mm")
                                                                                                                            : "-")
                                                                                                                              </strong>
                                                                                                                              <div class="input-hint">
                                                                    @(string.IsNullOrWhiteSpace(tarimaHist.UsuarioCaptura)
                                                                                                                            ? "-"
                                                                                                                            : tarimaHist.UsuarioCaptura)
                                                    </div>
                                                </td>
                                            </tr>
                                                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="pending-box">
                                                <i class="bi bi-info-circle me-1"></i>
                                                Este formulario histórico no tiene registros de temperatura por tarima.
                                            </div>
                                        }
                                    </div>
                                </div>

                                <!-- ======================================================
                                     REPORTE LIMPIO: SOLO TEMPERATURAS
                                     Este bloque no se muestra en pantalla.
                                     Se utiliza exclusivamente para imprimir.
                                     El PDF se genera en el Controller con QuestPDF.
                                     ====================================================== -->
                                <div id="@reporteTemperaturasId"
                                     class="temperature-export-report"
                                     aria-hidden="true">

                                    <div class="temperature-export-header">
                                        <div>
                                            <div class="temperature-export-eyebrow">
                                                CONTROL DE CALIDAD
                                            </div>
                                            <div class="temperature-export-title">
                                                Reporte de temperaturas por tarima
                                            </div>
                                            <div class="temperature-export-subtitle">
                                                Embarque #@(string.IsNullOrWhiteSpace(h.Consecutivo) ? $"EMB-{h.Id}" : h.Consecutivo)
                                                @if (!string.IsNullOrWhiteSpace(h.NombreEmbarque))
                                                {
                                                    <span> · @h.NombreEmbarque</span>
                                                }
                                        </div>
                                    </div>

                                    <div class="temperature-export-logo">
                                        <i class="bi bi-thermometer-half"></i>
                                    </div>
                                </div>

                                <div class="temperature-export-meta">
                                    <div>
                                        <span>Fecha de validación</span>
                                        <strong>
                                            @(h.FechaValidacionCalidad != null
                                                                                    ? Convert.ToDateTime(h.FechaValidacionCalidad).ToString("dd/MM/yyyy HH:mm")
                                                                                    : "-")
                                    </strong>
                                </div>

                                        <div>
                                            <span>Validó</span>
                                            <strong>@(h.UsuarioValidaCalidad ?? "Sistema")</strong>
                                        </div>

                                        <div>
                                            <span>Tarimas con temperatura</span>
                                            <strong>@tarimasHistCapturadas / @tarimasTemperaturaHist.Count</strong>
                                        </div>

                                        <div>
                                            <span>Total</span>
                                            <strong>@totalCajasHistTemperatura cajas · @totalKilosHistTemperatura.ToString("N2") kg</strong>
                                        </div>
                                    </div>

                            @if (tarimasTemperaturaHist.Any())
                                    {
                                        <div class="temperature-export-list">
                                            @foreach (var tarimaHist in tarimasTemperaturaHist)
                                            {
                                                var tipoDocumentoReporte = tarimaHist.TipoDocumento == "OV"
                                                ? "Orden de Venta"
                                                : "Transferencia";

                                                <section class="temperature-export-pallet">
                                                    <div class="temperature-export-pallet-head">
                                                        <div>
                                                            <div class="temperature-export-pallet-label">Tarima</div>
                                                            <div class="temperature-export-pallet-code">@tarimaHist.Tarima</div>
                                                        </div>

                                                        <div class="temperature-export-reading">
                                                            <span>Temperatura</span>
                                                            <strong>
                                                                @(tarimaHist.Temperatura.HasValue
                                                                                                                ? $"{tarimaHist.Temperatura.Value:N2} °C"
                                                                                                                : "Sin captura")
                                                                                                                            </strong>
                                                                                                                        </div>
                                                                                                                    </div>

                                                    <div class="temperature-export-pallet-meta">
                                                        <div>
                                                            <span>Documento</span>
                                                            <strong>
                                                                @tipoDocumentoReporte ·
                                                                @(string.IsNullOrWhiteSpace(tarimaHist.DocumentoConsecutivo)
                                                                                                                ? $"ID {tarimaHist.DocumentoId}"
                                                                                                                : tarimaHist.DocumentoConsecutivo)
                                                                                                                                              </strong>
                                                                                                                                          </div>

                                                        <div>
                                                            <span>Cliente / Sucursal</span>
                                                            <strong>
                                                                @(string.IsNullOrWhiteSpace(tarimaHist.DocumentoCliente)
                                                                                                                ? "-"
                                                                                                                : tarimaHist.DocumentoCliente)
                                            </strong>
                                        </div>

                                                        <div>
                                                            <span>Cajas</span>
                                                            <strong>@tarimaHist.TotalCajas</strong>
                                                        </div>

                                                        <div>
                                                            <span>Kilos</span>
                                                            <strong>@tarimaHist.TotalKilos.ToString("N2") kg</strong>
                                                        </div>
                                                    </div>

                                                    <table class="temperature-export-products">
                                                        <thead>
                                                            <tr>
                                                                <th>SKU</th>
                                                                <th>Producto</th>
                                                                <th class="number">Cajas</th>
                                                                <th class="number">Kilos</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                            @foreach (var productoHist in tarimaHist.Productos)
                                                            {
                                                                <tr>
                                                                    <td>
                                                                        @(string.IsNullOrWhiteSpace(productoHist.Codigo)
                                                                                                                            ? "S/SKU"
                                                                                                                            : productoHist.Codigo)
                                                                                                                                              </td>
                                                                                                                                              <td>
                                                                        @(string.IsNullOrWhiteSpace(productoHist.Nombre)
                                                                                                                            ? "Producto sin descripción"
                                                                                                                            : productoHist.Nombre)
                                                </td>
                                                <td class="number">@productoHist.Cajas</td>
                                                <td class="number">@productoHist.Kilos.ToString("N2")</td>
                                            </tr>
                                                                                        }
                                                    </tbody>
                                                </table>

                                                <div class="temperature-export-footer-grid">
                                                    <div>
                                                        <span>Observaciones</span>
                                                        <strong>
                                                            @(string.IsNullOrWhiteSpace(tarimaHist.Observaciones)
                                                                                                            ? "Sin observaciones"
                                                                                                            : tarimaHist.Observaciones)
                                                                                                                                   </strong>
                                                                                                                               </div>

                                                    <div>
                                                        <span>Captura</span>
                                                        <strong>
                                                            @(tarimaHist.FechaCaptura.HasValue
                                                                                                            ? tarimaHist.FechaCaptura.Value.ToString("dd/MM/yyyy HH:mm")
                                                                                                            : "-")
                                                                                                                  ·
                                                            @(string.IsNullOrWhiteSpace(tarimaHist.UsuarioCaptura)
                                                                                                            ? "-"
                                                                                                            : tarimaHist.UsuarioCaptura)
                                            </strong>
                                        </div>
                                    </div>
                                </section>
                                                                }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="temperature-export-empty">
                                            Este embarque no tiene temperaturas registradas.
                                        </div>
                                    }

                                    <div class="temperature-export-document-footer">
                                        Reporte de temperaturas · Embarque #@(string.IsNullOrWhiteSpace(h.Consecutivo) ? $"EMB-{h.Id}" : h.Consecutivo)
                                    </div>
                                </div>

                                @if (ordenesHist.Any())
                                {
                                    <div class="form-card mb-3">
                                        <div class="card-head">
                                            <h5 class="card-title">
                                                <i class="bi bi-box-seam"></i>
                                                Órdenes de Venta Incluidas
                                            </h5>
                                            <div class="card-sub">@totalOVHist registro(s) integrados a este embarque</div>
                                        </div>

                                        <div class="card-body">
                                            <div class="table-wrap">
                                                <table class="tabla-soft">
                                                    <thead>
                                                        <tr>
                                                            <th>Consecutivo</th>
                                                            <th>Cliente</th>
                                                            <th>Ruta</th>
                                                            <th>Fecha Entrega</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var ov in ordenesHist)
                                                        {
                                                            <tr>
                                                                <td data-label="Consecutivo">@ov.Consecutivo</td>
                                                                <td data-label="Cliente">@ov.NombreCliente</td>
                                                                <td data-label="Ruta">@(ov.Ruta ?? "-")</td>
                                                                <td data-label="Fecha Entrega">
                                                                    @(ov.FechaEntrega != null
                                                                                                                        ? Convert.ToDateTime(ov.FechaEntrega).ToString("yyyy-MM-dd")
                                                                                                                        : "-")
                                                </td>
                                            </tr>
                                                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                }

                                @if (transferenciasHist.Any())
                                {
                                    <div class="form-card mb-3">
                                        <div class="card-head">
                                            <h5 class="card-title">
                                                <i class="bi bi-arrow-left-right"></i>
                                                Transferencias Incluidas
                                            </h5>
                                            <div class="card-sub">@totalTRHist registro(s) relacionados a este embarque</div>
                                        </div>

                                        <div class="card-body">
                                            <div class="table-wrap">
                                                <table class="tabla-soft">
                                                    <thead>
                                                        <tr>
                                                            <th>Consecutivo</th>
                                                            <th>Sucursal</th>
                                                            <th>Fecha Solicitud</th>
                                                            <th>Solicitó</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var tr in transferenciasHist)
                                                        {
                                                            <tr>
                                                                <td data-label="Consecutivo">@tr.Consecutivo</td>
                                                                <td data-label="Sucursal">@(tr.Sucursal ?? "-")</td>
                                                                <td data-label="Fecha Solicitud">
                                                                    @(tr.FechaSolicitud != null
                                                                                                                        ? Convert.ToDateTime(tr.FechaSolicitud).ToString("yyyy-MM-dd")
                                                                                                                        : "-")
                                                </td>
                                                <td data-label="Solicitó">@(tr.UsuarioSolicita ?? "-")</td>
                                            </tr>
                                                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </main>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    <div class="modal fade" id="modalFotoCalidad" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold" id="modalFotoCalidadTitulo">
                        Evidencia fotográfica
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>

                <div class="modal-body text-center">
                    <img id="modalFotoCalidadImg"
                         class="photo-preview-img"
                         src=""
                         alt="Evidencia fotográfica" />
                </div>

                <div class="modal-footer">
                    <a id="modalFotoCalidadAbrir"
                       href="#"
                       target="_blank"
                       class="btn btn-outline-secondary">
                        <i class="bi bi-box-arrow-up-right"></i>
                        Abrir original
                    </a>

                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Cerrar
                    </button>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        function toggleCard(cardId) {
            const card = document.getElementById(cardId);

            if (!card) return;

            card.classList.toggle("active");
        }

        function toggleStep(button) {
            const step = button.closest(".quality-step");

            if (!step) return;

            step.classList.toggle("open");
        }


        function imprimirTemperaturasCalidad(reporteId) {
            const reporte = document.getElementById(reporteId);

            if (!reporte) {
                alert("No se encontró el reporte de temperaturas.");
                return;
            }

            document.body.classList.add("temperature-report-printing");
            reporte.classList.add("temperature-report-target");

            const limpiar = () => {
                document.body.classList.remove("temperature-report-printing");
                reporte.classList.remove("temperature-report-target");
            };

            window.addEventListener("afterprint", limpiar, { once: true });

            try {
                window.print();
            } catch (error) {
                console.error("Error al abrir impresión de temperaturas:", error);
                limpiar();
                alert("No fue posible abrir la ventana de impresión.");
            }
        }

        function normalizarCodigoTarima(valor) {
            let texto = (valor || "").toString().trim();

            if (!texto) return "";

            /*
             * También acepta QR que contengan JSON:
             * {"tarima":"ABC-123"}
             */
            if (texto.startsWith("{") && texto.endsWith("}")) {
                try {
                    const objeto = JSON.parse(texto);

                    texto =
                        objeto.tarima ||
                        objeto.codigoTarima ||
                        objeto.codigo ||
                        objeto.code ||
                        texto;
                } catch {
                    // Si no es JSON válido, continúa como texto normal.
                }
            }

            /*
             * También acepta una URL con parámetros:
             * ?tarima=ABC-123
             * ?codigoTarima=ABC-123
             * ?codigo=ABC-123
             * ?code=ABC-123
             */
            if (
                texto.includes("?") ||
                /^https?:\/\//i.test(texto)
            ) {
                try {
                    const url = new URL(
                        texto,
                        window.location.origin
                    );

                    texto =
                        url.searchParams.get("tarima") ||
                        url.searchParams.get("codigoTarima") ||
                        url.searchParams.get("codigo") ||
                        url.searchParams.get("code") ||
                        url.pathname.split("/").filter(Boolean).pop() ||
                        texto;
                } catch {
                    // Si no es URL válida, continúa como texto normal.
                }
            }

            try {
                texto = decodeURIComponent(texto);
            } catch {
                // El texto no estaba codificado como URL.
            }

            texto = texto.replace(
                /^(TARIMA|PALLET|CODIGO|CÓDIGO)\s*[:=#-]?\s*/i,
                ""
            );

            /*
             * Comparamos únicamente letras y números.
             * Así ABC-001, ABC 001 y abc001 se consideran iguales.
             */
            return texto
                .normalize("NFD")
                .replace(/[\u0300-\u036f]/g, "")
                .toUpperCase()
                .replace(/[^A-Z0-9]/g, "");
        }

        function cambiarEstadoEscaneo(tipo, mensaje) {
            const status =
                document.getElementById("tarimaScanStatus");

            if (!status) return;

            status.classList.remove(
                "is-success",
                "is-error",
                "is-searching"
            );

            if (tipo) {
                status.classList.add(`is-${tipo}`);
            }

            status.textContent = mensaje;
        }

        function limpiarResultadoEscaneoAnterior() {
            document
                .querySelectorAll(
                    "[data-sku-row].tarima-scan-hit"
                )
                .forEach(row => {
                    row.classList.remove("tarima-scan-hit");
                });
        }

        function hayFiltrosPendientesActivos() {
            const parametros =
                new URLSearchParams(window.location.search);

            return [
                "busqueda",
                "fechaInicio",
                "fechaFin"
            ].some(nombre => {
                return Boolean(parametros.get(nombre));
            });
        }

        function recargarCalidadParaBuscarTarima(valorOriginal) {
            const url = new URL(
                window.location.href
            );

            /*
             * Quitamos los filtros de pendientes para que la segunda
             * búsqueda contemple todos los embarques pendientes.
             */
            url.searchParams.delete("busqueda");
            url.searchParams.delete("fechaInicio");
            url.searchParams.delete("fechaFin");

            url.searchParams.set(
                "tarima",
                valorOriginal
            );

            window.location.assign(url.toString());
        }

        function buscarTarimaEscaneada(
            valorOriginal,
            permitirRecarga = true
        ) {
            const codigoBuscado =
                normalizarCodigoTarima(valorOriginal);

            limpiarResultadoEscaneoAnterior();

            if (!codigoBuscado) {
                cambiarEstadoEscaneo(
                    "error",
                    "Escanea o escribe un código de tarima válido."
                );

                return false;
            }

            cambiarEstadoEscaneo(
                "searching",
                "Buscando la tarima..."
            );

            const filas = Array.from(
                document.querySelectorAll(
                    "[data-sku-row][data-tarima]"
                )
            );

            const coincidencias = filas.filter(row => {
                return normalizarCodigoTarima(
                    row.dataset.tarima
                ) === codigoBuscado;
            });

            if (coincidencias.length === 0) {
                const parametros =
                    new URLSearchParams(window.location.search);

                const yaEsBusquedaGeneral =
                    Boolean(parametros.get("tarima"));

                /*
                 * Si la pantalla estaba filtrada, hacemos una sola
                 * recarga sin filtros y volvemos a intentar.
                 */
                if (
                    permitirRecarga &&
                    !yaEsBusquedaGeneral &&
                    hayFiltrosPendientesActivos()
                ) {
                    cambiarEstadoEscaneo(
                        "searching",
                        "No aparece con los filtros actuales. Buscando en todos los pendientes..."
                    );

                    recargarCalidadParaBuscarTarima(
                        valorOriginal
                    );

                    return false;
                }

                cambiarEstadoEscaneo(
                    "error",
                    `No se encontró la tarima "${valorOriginal}" ` +
                    "en los embarques pendientes de Calidad."
                );

                const input =
                    document.getElementById("tarimaScanInput");

                if (input) {
                    input.focus();
                    input.select();
                }

                return false;
            }

            const embarquesEncontrados = new Set();

            coincidencias.forEach(row => {
                const card =
                    row.closest(".embarque-card");

                const step =
                    row.closest("[data-temperature-step]");

                if (card) {
                    card.classList.add("active");
                    embarquesEncontrados.add(card.id);
                }

                if (step) {
                    step.classList.add("open");
                }

                row.classList.add("tarima-scan-hit");
            });

            const primeraFila =
                coincidencias[0];

            const primerCard =
                primeraFila.closest(".embarque-card");

            const tituloEmbarque =
                primerCard
                    ?.querySelector(".embarque-id")
                    ?.innerText
                    ?.replace(/\s+/g, " ")
                    ?.trim() ||
                "embarque localizado";

            const inputTemperatura =
                primeraFila.querySelector(".temp-sku-input");

            window.setTimeout(() => {
                primeraFila.scrollIntoView({
                    behavior: "smooth",
                    block: "center"
                });

                window.setTimeout(() => {
                    if (inputTemperatura) {
                        inputTemperatura.focus({
                            preventScroll: true
                        });

                        inputTemperatura.select();
                    }
                }, 450);
            }, 80);

            const textoCoincidencias =
                coincidencias.length === 1
                    ? "1 tarima localizada"
                    : `${coincidencias.length} tarimas localizadas`;

            const textoEmbarques =
                embarquesEncontrados.size === 1
                    ? tituloEmbarque
                    : `${embarquesEncontrados.size} embarques`;

            cambiarEstadoEscaneo(
                "success",
                `Tarima encontrada: ${textoCoincidencias} en ${textoEmbarques}.`
            );

            return true;
        }

        function esVistaMovilEscaner() {
            return window.matchMedia(
                "(max-width: 768px)"
            ).matches;
        }

        function abrirEscanerMovil() {
            const panel =
                document.getElementById("tarimaScanPanel");

            const backdrop =
                document.getElementById("tarimaScanBackdrop");

            const fab =
                document.getElementById("tarimaScanFab");

            const input =
                document.getElementById("tarimaScanInput");

            if (!panel || !input) return;

            panel.classList.add("is-mobile-open");
            backdrop?.classList.add("is-visible");
            fab?.classList.add("is-hidden");

            fab?.setAttribute(
                "aria-expanded",
                "true"
            );

            window.setTimeout(() => {
                input.focus();
                input.select();
            }, 180);
        }

        function cerrarEscanerMovil(
            devolverFoco = true
        ) {
            const panel =
                document.getElementById("tarimaScanPanel");

            const backdrop =
                document.getElementById("tarimaScanBackdrop");

            const fab =
                document.getElementById("tarimaScanFab");

            panel?.classList.remove("is-mobile-open");
            backdrop?.classList.remove("is-visible");
            fab?.classList.remove("is-hidden");

            fab?.setAttribute(
                "aria-expanded",
                "false"
            );

            if (devolverFoco) {
                window.setTimeout(() => {
                    fab?.focus();
                }, 180);
            }
        }

        document.addEventListener(
            "DOMContentLoaded",
            function () {
                const form =
                    document.getElementById("tarimaScanForm");

                const input =
                    document.getElementById("tarimaScanInput");

                const fab =
                    document.getElementById("tarimaScanFab");

                const close =
                    document.getElementById("tarimaScanClose");

                const backdrop =
                    document.getElementById("tarimaScanBackdrop");

                if (!form || !input) return;

                fab?.addEventListener(
                    "click",
                    abrirEscanerMovil
                );

                close?.addEventListener(
                    "click",
                    function () {
                        cerrarEscanerMovil(true);
                    }
                );

                backdrop?.addEventListener(
                    "click",
                    function () {
                        cerrarEscanerMovil(true);
                    }
                );

                document.addEventListener(
                    "keydown",
                    function (event) {
                        if (
                            event.key === "Escape" &&
                            document
                                .getElementById("tarimaScanPanel")
                                ?.classList
                                .contains("is-mobile-open")
                        ) {
                            cerrarEscanerMovil(true);
                        }
                    }
                );

                form.addEventListener(
                    "submit",
                    function (event) {
                        event.preventDefault();

                        const localizada =
                            buscarTarimaEscaneada(
                                input.value,
                                true
                            );

                        /*
                         * Al localizarla en HandHeld cerramos la
                         * bandeja para dejar visible la temperatura.
                         */
                        if (
                            localizada &&
                            esVistaMovilEscaner()
                        ) {
                            window.setTimeout(() => {
                                cerrarEscanerMovil(false);
                            }, 260);
                        }
                    }
                );

                input.addEventListener(
                    "focus",
                    function () {
                        input.select();
                    }
                );

                /*
                 * Si llegamos desde la recarga automática con ?tarima=,
                 * abrimos la ubicación encontrada al terminar de renderizar.
                 */
                const tarimaDesdeUrl =
                    new URLSearchParams(
                        window.location.search
                    ).get("tarima");

                if (tarimaDesdeUrl) {
                    input.value = tarimaDesdeUrl;

                    window.setTimeout(() => {
                        buscarTarimaEscaneada(
                            tarimaDesdeUrl,
                            false
                        );
                    }, 250);
                }

                /*
                 * Si el usuario cambia la orientación y pasa a escritorio,
                 * restauramos el panel a su estado normal.
                 */
                window.addEventListener(
                    "resize",
                    function () {
                        if (!esVistaMovilEscaner()) {
                            cerrarEscanerMovil(false);
                        }
                    }
                );
            }
        );

        function mostrarArchivos(input, targetId, uploadId) {
            const contenedor = document.getElementById(targetId);
            const uploadBox = document.getElementById(uploadId);

            if (!contenedor || !uploadBox) return;

            contenedor.innerHTML = "";

            if (input.files && input.files.length > 0) {
                uploadBox.classList.add("has-files");
                uploadBox.classList.remove("is-invalid");
                input.classList.remove("is-invalid");

                Array.from(input.files).forEach(file => {
                    const item = document.createElement("div");
                    item.className = "file-item";
                    item.innerHTML = `<i class="bi bi-check-circle-fill"></i> ${file.name}`;
                    contenedor.appendChild(item);
                });
            } else {
                uploadBox.classList.remove("has-files");
            }
        }

        function limpiarErroresFormulario(form) {
            form.querySelectorAll(".is-invalid").forEach(el => {
                el.classList.remove("is-invalid");
            });

            form.querySelectorAll(".quality-step.step-error").forEach(step => {
                step.classList.remove("step-error");
            });

            const box = form.querySelector("[data-validation-box]");
            const list = form.querySelector("[data-validation-list]");

            if (box) box.classList.remove("show");
            if (list) list.innerHTML = "";
        }

        function abrirSeccionConError(campo) {
            const step = campo.closest(".quality-step");

            if (!step) return;

            step.classList.add("open");
            step.classList.add("step-error");
        }

        function marcarCampoInvalido(campo) {
            campo.classList.add("is-invalid");

            const uploadBox = campo.closest(".upload-box");

            if (uploadBox) {
                uploadBox.classList.add("is-invalid");
            }

            abrirSeccionConError(campo);
        }

        function obtenerValorCampo(campo) {
            if (!campo) return "";

            if (campo.type === "file") {
                return campo.files && campo.files.length > 0 ? "OK" : "";
            }

            return (campo.value || "").trim();
        }

        function validarFormularioCalidad(form) {
            limpiarErroresFormulario(form);

            const errores = [];
            const campos = form.querySelectorAll("[data-required-message]");

            campos.forEach(campo => {
                const valor = obtenerValorCampo(campo);

                if (!valor) {
                    const mensaje = campo.getAttribute("data-required-message") || "Completa este campo.";
                    errores.push(mensaje);
                    marcarCampoInvalido(campo);
                }
            });

            const horaInicio = form.querySelector("[name='horaInicioEmbarque']");
            const horaTermino = form.querySelector("[name='horaTerminoEmbarque']");

            if (horaInicio && horaTermino && horaInicio.value && horaTermino.value) {
                const inicio = new Date(horaInicio.value);
                const termino = new Date(horaTermino.value);

                if (termino < inicio) {
                    errores.push("La hora de término de embarque no puede ser menor que la hora de inicio.");
                    marcarCampoInvalido(horaInicio);
                    marcarCampoInvalido(horaTermino);
                }
            }

            if (errores.length > 0) {
                const box = form.querySelector("[data-validation-box]");
                const list = form.querySelector("[data-validation-list]");

                if (list) {
                    list.innerHTML = "";

                    errores.forEach(error => {
                        const li = document.createElement("li");
                        li.textContent = error;
                        list.appendChild(li);
                    });
                }

                if (box) {
                    box.classList.add("show");
                    box.scrollIntoView({
                        behavior: "smooth",
                        block: "center"
                    });
                }

                const primerCampoInvalido = form.querySelector(".is-invalid");

                if (primerCampoInvalido) {
                    setTimeout(() => primerCampoInvalido.focus(), 250);
                }

                return false;
            }

            return true;
        }

        function parseNullableDecimal(value) {
            value = (value || "")
                .toString()
                .trim()
                .replace(",", ".");

            if (!value) {
                return null;
            }

            const number = Number(value);

            return Number.isFinite(number)
                ? number
                : null;
        }

        function cambiarEstadoTemperaturas(form, tipo, mensaje) {
            if (!form) return;

            const status = form.querySelector("[data-sku-status]");

            if (!status) return;

            const iconos = {
                saving: "bi-hourglass-split",
                success: "bi-check-circle-fill",
                error: "bi-exclamation-triangle-fill",
                dirty: "bi-pencil-square"
            };

            status.className = `sku-save-status is-${tipo}`;
            status.replaceChildren();

            const icono = document.createElement("i");
            icono.className = `bi ${iconos[tipo] || "bi-info-circle"}`;

            status.append(
                icono,
                document.createTextNode(mensaje || "")
            );
        }

        function pintarUltimaCaptura(row, capturada, fecha, usuario) {
            const celda = row.querySelector("[data-sku-last-capture]");

            if (!celda) return;

            celda.replaceChildren();

            if (capturada) {
                const estado = document.createElement("span");
                estado.className = "sku-captured";

                const icono = document.createElement("i");
                icono.className = "bi bi-check-circle-fill";

                estado.append(
                    icono,
                    document.createTextNode(` ${fecha || "Guardado ahora"}`)
                );

                const salto = document.createElement("br");

                const usuarioElemento = document.createElement("small");
                usuarioElemento.textContent = usuario || "Sistema";

                celda.append(
                    estado,
                    salto,
                    usuarioElemento
                );
            } else {
                const estado = document.createElement("span");
                estado.className = "sku-pending";

                const icono = document.createElement("i");
                icono.className = "bi bi-hourglass-split";

                estado.append(
                    icono,
                    document.createTextNode(" Pendiente")
                );

                celda.appendChild(estado);
            }
        }

        function recolectarTemperaturasSku(form) {
            const filas = form.querySelectorAll("[data-sku-row]");
            const items = [];

            filas.forEach(row => {
                const inputTemp = row.querySelector(".temp-sku-input");
                const inputObs = row.querySelector(".temp-sku-obs");

                if (!inputTemp) return;

                const temperatura =
                    parseNullableDecimal(inputTemp.value);

                const observaciones =
                    inputObs ? inputObs.value : "";

                /*
                 * Cada fila visible ahora representa UNA TARIMA.
                 * En data-items vienen todos los detalles/SKUs que
                 * pertenecen a esa tarima.
                 *
                 * Replicamos la misma temperatura a esos detalles
                 * para conservar 100% compatible el backend actual.
                 */
                let detalles = [];

                try {
                    detalles = JSON.parse(
                        row.dataset.items || "[]"
                    );
                } catch (error) {
                    console.error(
                        "No se pudieron leer los detalles de la tarima:",
                        error
                    );
                }

                detalles.forEach(detalle => {
                    items.push({
                        tipoDocumento:
                            detalle.tipoDocumento || "",

                        documentoId:
                            Number(detalle.documentoId || 0),

                        origenDetalleId:
                            Number(detalle.origenDetalleId || 0),

                        productoCodigo:
                            detalle.productoCodigo || "",

                        almacen:
                            detalle.almacen || "",

                        temperatura,
                        observaciones
                    });
                });
            });

            return items;
        }

        function actualizarInterfazTemperaturas(form, result) {
            if (!form) return;

            const fechaGuardado =
                result.fechaGuardado || "Guardado ahora";

            const usuario =
                result.usuario || "Sistema";

            const filas = Array.from(
                form.querySelectorAll("[data-sku-row]")
            );

            let totalDom = 0;
            let capturadasDom = 0;

            filas.forEach(row => {
                const inputTemp =
                    row.querySelector(".temp-sku-input");

                if (!inputTemp) return;

                totalDom++;

                const tieneTemperatura =
                    parseNullableDecimal(inputTemp.value) !== null;

                if (tieneTemperatura) {
                    capturadasDom++;
                }

                row.classList.toggle(
                    "sku-row-saved",
                    tieneTemperatura
                );

                row.classList.remove("sku-row-dirty");

                pintarUltimaCaptura(
                    row,
                    tieneTemperatura,
                    fechaGuardado,
                    usuario
                );

                /*
                 * Pequeña animación para que el operador
                 * vea claramente cuáles filas se procesaron.
                 */
                row.classList.remove("sku-save-flash");

                void row.offsetWidth;

                row.classList.add("sku-save-flash");

                window.setTimeout(() => {
                    row.classList.remove("sku-save-flash");
                }, 900);
            });

            /*
             * El servidor sigue contando detalles/SKUs porque el modelo
             * persistente actual trabaja a ese nivel. La pantalla, en cambio,
             * debe mostrar avance por TARIMA.
             */
            const total = totalDom;
            const capturadas = capturadasDom;

            /*
             * Actualizar contador general.
             */
            const progresoGeneral =
                form.querySelector("[data-sku-general-progress]");

            if (progresoGeneral) {
                progresoGeneral.textContent =
                    `${capturadas} / ${total} capturadas`;
            }

            /*
             * Actualizar texto del encabezado del acordeón.
             */
            const progresoEncabezado =
                form.querySelector("[data-sku-step-progress]");

            if (progresoEncabezado) {
                progresoEncabezado.textContent =
                    `Una sola captura por código de tarima. ` +
                    `Guardado parcial: ${capturadas}/${total} tarima(s).`;
            }

            /*
             * Actualizar el progreso de cada OV o transferencia.
             */
            form.querySelectorAll("[data-sku-doc]")
                .forEach(documento => {
                    const filasDocumento = Array.from(
                        documento.querySelectorAll("[data-sku-row]")
                    );

                    const totalDocumento =
                        filasDocumento.length;

                    const capturadasDocumento =
                        filasDocumento.filter(row => {
                            const input =
                                row.querySelector(".temp-sku-input");

                            return input &&
                                parseNullableDecimal(input.value) !== null;
                        }).length;

                    const progresoDocumento =
                        documento.querySelector("[data-sku-doc-progress]");

                    if (progresoDocumento) {
                        progresoDocumento.textContent =
                            `${capturadasDocumento} / ` +
                            `${totalDocumento} tarima(s) capturadas`;
                    }
                });

            return {
                total,
                capturadas
            };
        }

        async function guardarTemperaturasSku(form, desdeSubmit) {
            if (!form) return false;

            /*
             * Evita que el operador mande dos o más
             * guardados mientras el primero sigue procesándose.
             */
            if (form.dataset.guardandoTemperaturas === "1") {
                return false;
            }

            const embarqueId =
                Number(form.dataset.embarqueId || 0);

            const btnGuardar =
                form.querySelector("[data-btn-guardar-temperaturas]");

            const items =
                recolectarTemperaturasSku(form);

            /*
             * Recordamos el último campo donde trabajó el operador.
             * Al terminar el guardado regresaremos el foco ahí.
             */
            const campoFocoAnterior =
                form._ultimoCampoTemperatura || null;

            const posicionAnterior =
                window.scrollY;

            let guardadoExitoso = false;

            if (!embarqueId) {
                cambiarEstadoTemperaturas(
                    form,
                    "error",
                    "No se encontró el ID del embarque."
                );

                return false;
            }

            form.dataset.guardandoTemperaturas = "1";

            if (btnGuardar) {
                if (!btnGuardar.dataset.htmlOriginal) {
                    btnGuardar.dataset.htmlOriginal =
                        btnGuardar.innerHTML;
                }

                btnGuardar.disabled = true;
                btnGuardar.innerHTML =
                    '<i class="bi bi-hourglass-split me-1"></i>' +
                    'Guardando...';
            }

            cambiarEstadoTemperaturas(
                form,
                "saving",
                "Guardando temperaturas..."
            );

            try {
                const response = await fetch(
                    "/Embarques/GuardarTemperaturasSku",
                    {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify({
                            embarqueId,
                            items
                        })
                    }
                );

                if (!response.ok) {
                    throw new Error(
                        `Error HTTP ${response.status}`
                    );
                }

                const result = await response.json();

                if (!result.success) {
                    cambiarEstadoTemperaturas(
                        form,
                        "error",
                        result.message ||
                        "No se pudieron guardar las temperaturas."
                    );

                    return false;
                }

                guardadoExitoso = true;

                /*
                 * Aquí está el cambio importante:
                 * actualizamos la página sin recargarla.
                 */
                const progresoTarimas =
                    actualizarInterfazTemperaturas(
                        form,
                        result
                    );

                cambiarEstadoTemperaturas(
                    form,
                    "success",
                    `Temperaturas guardadas: ` +
                    `${progresoTarimas.capturadas}/` +
                    `${progresoTarimas.total} tarima(s).`
                );

                return true;
            } catch (error) {
                console.error(
                    "Error al guardar temperaturas:",
                    error
                );

                cambiarEstadoTemperaturas(
                    form,
                    "error",
                    "No fue posible guardar las temperaturas. " +
                    "Intenta nuevamente."
                );

                return false;
            } finally {
                form.dataset.guardandoTemperaturas = "0";

                if (btnGuardar) {
                    btnGuardar.disabled = false;

                    if (guardadoExitoso) {
                        btnGuardar.innerHTML =
                            '<i class="bi bi-check2-circle me-1"></i>' +
                            'Temperaturas guardadas';

                        window.setTimeout(() => {
                            if (btnGuardar.isConnected) {
                                btnGuardar.innerHTML =
                                    btnGuardar.dataset.htmlOriginal ||
                                    '<i class="bi bi-save me-1"></i>' +
                                    'Guardar temperaturas';
                            }
                        }, 1600);
                    } else {
                        btnGuardar.innerHTML =
                            btnGuardar.dataset.htmlOriginal ||
                            '<i class="bi bi-save me-1"></i>' +
                            'Guardar temperaturas';
                    }
                }

                /*
                 * Cuando solamente se están guardando temperaturas,
                 * mantenemos exactamente la posición y el foco.
                 *
                 * Cuando viene desde "Validar Calidad", el formulario
                 * continuará con su envío normal.
                 */
                if (!desdeSubmit) {
                    window.requestAnimationFrame(() => {
                        window.scrollTo({
                            top: posicionAnterior,
                            left: 0,
                            behavior: "auto"
                        });

                        if (
                            campoFocoAnterior &&
                            campoFocoAnterior.isConnected
                        ) {
                            campoFocoAnterior.focus({
                                preventScroll: true
                            });
                        }
                    });
                }
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".form-calidad-validacion").forEach(form => {

                form.addEventListener("focusin", function (event) {
                    const campo = event.target;

                    if (
                        campo.matches(".temp-sku-input") ||
                        campo.matches(".temp-sku-obs")
                    ) {
                        form._ultimoCampoTemperatura = campo;
                    }
                });

                form.querySelectorAll(
                    ".temp-sku-input, .temp-sku-obs"
                ).forEach(campo => {
                    campo.addEventListener("input", function () {
                        const row = campo.closest("[data-sku-row]");

                        if (row) {
                            row.classList.add("sku-row-dirty");
                        }

                        cambiarEstadoTemperaturas(
                            form,
                            "dirty",
                            "Existen cambios pendientes por guardar."
                        );
                    });
                });

                form.addEventListener("submit", async function (event) {
                    if (form.dataset.enviandoDespuesDeGuardar === "1") {
                        return;
                    }

                    const esValido = validarFormularioCalidad(form);

                    if (!esValido) {
                        event.preventDefault();
                        event.stopPropagation();
                        return false;
                    }

                    event.preventDefault();
                    event.stopPropagation();

                    const guardadoOk = await guardarTemperaturasSku(form, true);

                    if (!guardadoOk) {
                        return false;
                    }

                    form.dataset.enviandoDespuesDeGuardar = "1";
                    form.submit();
                });

                form.querySelectorAll("[data-required-message]").forEach(campo => {
                    campo.addEventListener("input", function () {
                        if (obtenerValorCampo(campo)) {
                            campo.classList.remove("is-invalid");

                            const uploadBox = campo.closest(".upload-box");

                            if (uploadBox) {
                                uploadBox.classList.remove("is-invalid");
                            }
                        }
                    });

                    campo.addEventListener("change", function () {
                        if (obtenerValorCampo(campo)) {
                            campo.classList.remove("is-invalid");

                            const uploadBox = campo.closest(".upload-box");

                            if (uploadBox) {
                                uploadBox.classList.remove("is-invalid");
                            }
                        }
                    });
                });
            });
        });

        function abrirFotoCalidadDesdeBoton(btn) {
            const url = btn.dataset.photoUrl;
            const title = btn.dataset.photoTitle || "Evidencia fotográfica";

            const modalEl = document.getElementById("modalFotoCalidad");
            const img = document.getElementById("modalFotoCalidadImg");
            const titulo = document.getElementById("modalFotoCalidadTitulo");
            const abrirOriginal = document.getElementById("modalFotoCalidadAbrir");

            if (!url || !modalEl || !img || !titulo || !abrirOriginal) return;

            img.src = url;
            titulo.textContent = title;
            abrirOriginal.href = url;

            const modal = new bootstrap.Modal(modalEl);
            modal.show();
        }

    </script>
}