    /* =========================================================
                           LAYOUT FINAL - RESUMEN Y DOCUMENTOS ARRIBA
                           Libera espacio lateral para Temperatura por SKU
                           ========================================================= */

    /* Antes era: 330px + contenido.
                           Ahora todo queda en una sola columna. */
    .validation-layout {
        display: grid !important;
        grid-template-columns: 1fr !important;
        gap: 1rem !important;
        align-items: start !important;
    }

    /* El side-panel deja de ser lateral y se vuelve bloque superior */
    .side-panel {
        position: static !important;
        display: grid !important;
        grid-template-columns: minmax(0, 1.25fr) minmax(280px, .75fr) !important;
        gap: 1rem !important;
        width: 100% !important;
        align-items: stretch !important;
    }

    /* Main ocupa todo el ancho */
    .validation-layout > main {
        width: 100% !important;
        min-width: 0 !important;
    }

    /* Las dos tarjetas de arriba quedan parejas */
    .side-panel .quick-card,
    .side-panel .docs-card {
        width: 100% !important;
        height: 100% !important;
        border-radius: 18px !important;
    }

        /* Resumen rápido más compacto cuando está arriba */
        .side-panel .quick-card .card-body {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: .75rem;
        }

        .side-panel .quick-card .quick-row {
            border-bottom: 0 !important;
            padding: .75rem !important;
            background: #f8fafc;
            border: 1px solid #edf1f5;
            border-radius: 15px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            gap: .25rem;
        }

        .side-panel .quick-card .quick-label {
            font-size: .72rem;
