                class="quality-scan-close"
                aria-label="Cerrar escáner">
            <i class="bi bi-x-lg"></i>
        </button>

        <div>
            <div class="quality-scan-title" id="tarimaScanTitle">
                <span class="quality-scan-icon">
                    <i class="bi bi-upc-scan"></i>
                </span>
                <span>Escaneo de tarima</span>
            </div>

            <div class="quality-scan-help">
                Coloca el cursor en el campo y escanea con el HandHeld.
                Al recibir Enter se abrirá el embarque y el campo de temperatura correspondiente.
            </div>
        </div>

        <form id="tarimaScanForm"
              class="quality-scan-form"
              autocomplete="off">
            <label for="tarimaScanInput">Código o QR de tarima</label>

            <div class="quality-scan-control">
                <input type="text"
                       id="tarimaScanInput"
                       class="quality-scan-input"
                       value="@tarimaEscaneada"
                       placeholder="Escanea aquí..."
                       enterkeyhint="search"
                       spellcheck="false"
                       autocapitalize="characters"
                       autocomplete="off" />

                <button type="submit"
                        class="quality-scan-button"
                        title="Localizar tarima"
                        aria-label="Localizar tarima">
                    <i class="bi bi-search me-1"></i>
                    <span class="quality-scan-button-text">Localizar</span>
                </button>
            </div>

            <div id="tarimaScanStatus"
                 class="quality-scan-status"
                 role="status"
                 aria-live="polite">
                Escáner listo.
            </div>
        </form>
    </div>

    <div id="tarimaScanBackdrop"
         class="quality-scan-backdrop"
         aria-hidden="true"></div>

    <button type="button"
            id="tarimaScanFab"
            class="quality-scan-mobile-fab"
            title="Escanear tarima"
            aria-label="Escanear tarima"
            aria-controls="tarimaScanPanel"
            aria-expanded="false">
        <span class="scan-fab-icon">
            <i class="bi bi-upc-scan"></i>
        </span>
        <span class="scan-fab-text">Escanear</span>
    </button>

    <div class="quality-filter-panel">
        <div class="quality-filter-title">
            <i class="bi bi-funnel"></i>
            Filtros de búsqueda
        </div>

        <form method="get" asp-action="Calidad" class="quality-filter-grid">
            <div class="quality-filter-group">
                <label>Buscar embarque</label>
                <input type="text"
                       name="busqueda"
                       value="@busqueda"
                       class="quality-filter-input"
                       placeholder="Ej. EMB-0001, 125, consecutivo..." />
            </div>

            <div class="quality-filter-group">
                <label>Fecha inicio</label>
                <input type="date"
                       name="fechaInicio"
                       value="@fechaInicio"
                       class="quality-filter-input" />
            </div>

            <div class="quality-filter-group">
                <label>Fecha fin</label>
                <input type="date"
                       name="fechaFin"
                       value="@fechaFin"
                       class="quality-filter-input" />
            </div>

            <input type="hidden" name="busquedaHistorial" value="@busquedaHistorial" />
            <input type="hidden" name="fechaInicioHistorial" value="@fechaInicioHistorial" />
            <input type="hidden" name="fechaFinHistorial" value="@fechaFinHistorial" />

            <button type="submit" class="quality-filter-btn primary">
                <i class="bi bi-search"></i>
                Buscar
            </button>

            <a asp-action="Calidad" class="quality-filter-btn secondary">
                <i class="bi bi-arrow-clockwise"></i>
                Limpiar
            </a>
