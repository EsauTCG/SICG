        }

        .side-panel .quick-card .quick-value {
            text-align: left !important;
            font-size: .94rem;
            line-height: 1.25;
            word-break: break-word;
        }

        /* Documentos más limpio al lado derecho */
        .side-panel .docs-card .card-body {
            height: calc(100% - 68px);
            display: flex;
            align-items: center;
        }

        .side-panel .docs-card .doc-buttons {
            width: 100%;
            grid-template-columns: 1fr 1fr !important;
            gap: .75rem !important;
        }

        .side-panel .docs-card .doc-mini {
            min-height: 86px;
            display: grid;
            place-items: center;
            align-content: center;
            border-radius: 16px;
        }

