            .sku-temp-table td[data-label="Cajas"],
            .sku-temp-table td[data-label="Kilos"] {
                grid-template-columns: 95px minmax(0, 1fr) !important;
            }
            /* Temperatura más grande porque es el campo importante */
            .sku-temp-table td[data-label="Temperatura °C"] {
                display: block !important;
                padding-top: .75rem !important;
            }

                .sku-temp-table td[data-label="Temperatura °C"]::before {
                    display: block;
                    margin-bottom: .4rem;
                }

            .sku-temp-table .temp-sku-input {
                min-height: 52px !important;
