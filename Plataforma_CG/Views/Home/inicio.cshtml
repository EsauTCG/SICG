@{
    Layout = "_Layout2";
    ViewData["Title"] = "Inicio";
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/inicio-sigo-layout2-home.css"
          asp-append-version="true" />
    <link rel="stylesheet" href="~/css/inicio-sigo-layout2-home-fit.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/inicio-sigo-layout2-home-up.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/inicio-sigo-layout2-home-final-ajuste.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/inicio-sigo-layout2-home-final-v2.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/inicio-sigo-layout2-home-final-v3.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/inicio-sigo-layout2-home-final-v4.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/inicio-sigo-layout2-home-final-v5.css" asp-append-version="true" />
}

<div class="inicio-home-root">

    <div class="inicio-carousel">
        <div class="carousel-track" id="carouselTrack"></div>

        <button type="button"
                class="carousel-btn prev"
                aria-label="Anterior">
            &#10094;
        </button>

        <button type="button"
                class="carousel-btn next"
                aria-label="Siguiente">
            &#10095;
        </button>

        <div class="carousel-dots"></div>
    </div>

    <section class="inicio-cut-panel" id="cutPanel">
        <div class="cutmap-stage"
             id="cutmapStage"
             aria-label="Mapa interactivo de canal de res">

            <svg id="cutmapSvg"
                 viewBox="0 0 1000 600"
                 class="cutmap-svg"
                 role="img"
                 aria-label="Mapa de cortes"
                 preserveAspectRatio="xMidYMid meet">

                <image href="/images/vinil sigo 2 canales.jpeg"
                       x="-20"
                       y="0"
                       width="1000"
                       height="600"
                       preserveAspectRatio="xMidYMid meet"></image>

                <polygon class="cut-zone"
                         points="270,160 460,120 560,170 520,250 310,260"
                         data-part="Costillar C/Faldón"
                         data-cuts='[
                            {"name":"Suaderito","img":"/images/suaderito.jpg"},
                            {"name":"Conchita","img":"/images/conchita.jpeg"},
                            {"name":"Costilla","img":"/images/Costilla.jpeg"}
                         ]'>
                </polygon>

                <polygon class="cut-zone"
                         points="320,280 540,270 585,330 520,380 350,370"
                         data-part="Lomo"
                         data-cuts='[
                            {"name":"Top Sirloin","img":"/images/Top Sirlon.png"},
                            {"name":"Sirloin","img":"/images/sirlon.png"},
                            {"name":"Strip loin","img":"/images/strip loin.png"},
                            {"name":"Filete","img":"/images/filete.jpg"},
                            {"name":"Riñon","img":"/images/riñon.png"},
                            {"name":"Arrachera a Gallo","img":"/images/arrachera gallo.png"},
                            {"name":"T-bone","img":"/images/tbone.jpg"},
                            {"name":"Rib-Eye","img":"/images/ribeye.jpg"},
                            {"name":"Chuleton","img":"/images/Chuleton.png"},
                            {"name":"Costilla Rib","img":"/images/Costilla Cargada.jpg"},
                            {"name":"Falda","img":"/images/Falda.jpg"}
                         ]'>
                </polygon>

                <polygon class="cut-zone"
                         points="180,300 390,285 360,380 260,430 170,390"
                         data-part="Costillar C/Faldón"
                         data-cuts='[
                            {"name":"Suadero","img":"/images/suadero.jpeg"},
                            {"name":"Costilla S/F","img":"/images/Costilla.jpeg"},
                            {"name":"Arrachera","img":"/images/arrachera.png"}
                         ]'>
                </polygon>

                <polygon class="cut-zone"
                         points="560,190 650,151 720,220 690,280 585,265"
                         data-part="Piña"
                         data-cuts='[
                            {"name":"Chambarete","img":"/images/Chamberete.png"},
                            {"name":"Pulpa Blanca","img":"/images/Pulpa Blanca.jpeg"},
                            {"name":"Pulpa Bola","img":"/images/Pulpa Bola.jpg"},
                            {"name":"Pulpa Negra","img":"/images/Pulpa Negra.jpeg"},
                            {"name":"Cola","img":"/images/Cola.png"}
                         ]'>
                </polygon>

                <polygon class="cut-zone"
                         points="540,330 740,310 820,380 760,520 560,540 500,450"
                         data-part="Cuarto"
                         data-cuts='[
                            {"name":"Pecho","img":"/images/Pecho.png"},
                            {"name":"Short Rib","img":"/images/short-rib.png"},
                            {"name":"Cuña o Juil","img":"/images/Cuña.jpeg"},
                            {"name":"Giba","img":"/images/giba.png"},
                            {"name":"Tapa de pescuezo","img":"/images/Tapapescue.png"},
                            {"name":"Paleta","img":"/images/Paleta.jpeg"},
                            {"name":"Diezmillo","img":"/images/Diezmillo.jpg"},
                            {"name":"Pescuezo","img":"/images/Pescuezo.jpg"}
                         ]'>
                </polygon>
            </svg>

            <div id="cutHoverCard"
                 class="cut-hover-card"
                 aria-hidden="true">
                <div id="cutHoverTitle" class="cut-hover-title"></div>
                <div id="cutHoverGrid" class="cut-hover-grid"></div>
            </div>
        </div>
    </section>
</div>

<div class="modal fade"
     id="cutModal"
     tabindex="-1"
     aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content shadow">
            <div class="modal-header inicio-cut-modal-head">
                <h5 class="modal-title text-white" id="cutModalTitle">Cortes</h5>
                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">
                <div id="cutModalGrid" class="row g-3"></div>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-outline-secondary"
                        data-bs-dismiss="modal">
                    Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    function safeParseCuts(raw) {
        try { return JSON.parse(raw || "[]"); }
        catch { return []; }
    }

    // ==========================================================
    // MODAL DE CORTES — DOBLE CLIC
    // ==========================================================
    (function initCutMapModal() {
        const svg = document.getElementById("cutmapSvg");
        const modalEl = document.getElementById("cutModal");
        const modalTitle = document.getElementById("cutModalTitle");
        const grid = document.getElementById("cutModalGrid");

        if (!svg || !modalEl || !modalTitle || !grid) return;

        const bsModal = new bootstrap.Modal(modalEl);

        function renderCuts(cuts) {
            grid.innerHTML = "";

            if (!cuts.length) {
                grid.innerHTML =
                    '<div class="col-12">' +
                    '<div class="alert alert-light border mb-0">' +
                    'No hay cortes configurados.' +
                    '</div></div>';
                return;
            }

            cuts.forEach(c => {
                const col = document.createElement("div");
                col.className = "col-12 col-sm-6 col-lg-4";

                col.innerHTML = `
                    <div class="card h-100 shadow-sm">
                        <div class="ratio ratio-4x3 bg-light">
                            ${
                                c.img
                                ? `<img src="${c.img}"
                                         class="card-img-top"
                                         style="object-fit:cover;"
                                         alt="${c.name || ""}"
                                         onerror="this.onerror=null;this.src='/images/cortes/no-image.png';">`
                                : `<div class="d-flex align-items-center justify-content-center text-muted small">
                                       Sin imagen
                                   </div>`
                            }
                        </div>
                        <div class="card-body py-2">
                            <div class="fw-bold">${c.name || ""}</div>
                        </div>
                    </div>`;

                grid.appendChild(col);
            });
        }

        svg.querySelectorAll(".cut-zone").forEach(zone => {
            zone.addEventListener("dblclick", () => {
                modalTitle.textContent = zone.dataset.part || "Cortes";
                renderCuts(safeParseCuts(zone.dataset.cuts));
                bsModal.show();
            });
        });
    })();

    // ==========================================================
    // TARJETA HOVER
    // ==========================================================
    (function initCutMapHoverCard() {
        const stage = document.getElementById("cutmapStage");
        const svg = document.getElementById("cutmapSvg");
        const card = document.getElementById("cutHoverCard");
        const title = document.getElementById("cutHoverTitle");
        const grid = document.getElementById("cutHoverGrid");

        if (!stage || !svg || !card || !title || !grid) return;

        const isCoarse = window.matchMedia("(pointer: coarse)").matches;
        let pinned = false;

        function renderCuts(cuts) {
            grid.innerHTML = "";
            const list = (cuts || []).slice(0, 6);

            if (!list.length) {
                grid.innerHTML =
                    '<div class="text-muted small">No hay cortes configurados.</div>';
                return;
            }

            list.forEach(c => {
                const div = document.createElement("div");
                div.className = "cut-hover-item";

                div.innerHTML = `
                    ${
                        c.img
                        ? `<img src="${c.img}"
                                 alt="${c.name || ""}"
                                 onerror="this.onerror=null;this.src='/images/cortes/no-image.png';">`
                        : `<div class="cut-hover-no-image">Sin imagen</div>`
                    }
                    <div class="name">${c.name || ""}</div>`;

                grid.appendChild(div);
            });
        }

        function placeCard(clientX, clientY) {
            const rect = stage.getBoundingClientRect();

            let x = clientX - rect.left + 14;
            let y = clientY - rect.top + 14;

            card.classList.add("show");
            card.setAttribute("aria-hidden", "false");

            const cardRect = card.getBoundingClientRect();

            if (x > rect.width - cardRect.width - 10) {
                x = Math.max(10, rect.width - cardRect.width - 10);
            }

            if (y > rect.height - cardRect.height - 10) {
                y = Math.max(10, rect.height - cardRect.height - 10);
            }

            card.style.left = x + "px";
            card.style.top = y + "px";
        }

        function showForZone(zone, evt) {
            title.textContent = zone.dataset.part || "Cortes";
            renderCuts(safeParseCuts(zone.dataset.cuts));

            if (evt && evt.clientX) {
                placeCard(evt.clientX, evt.clientY);
            } else {
                const rect = stage.getBoundingClientRect();
                placeCard(
                    rect.left + rect.width * 0.5,
                    rect.top + rect.height * 0.35
                );
            }
        }

        function hideCard(force = false) {
            if (pinned && !force) return;

            card.classList.remove("show");
            card.setAttribute("aria-hidden", "true");
        }

        svg.querySelectorAll(".cut-zone").forEach(zone => {
            zone.addEventListener("pointerenter", e => {
                if (!isCoarse && !pinned) showForZone(zone, e);
            });

            zone.addEventListener("pointermove", e => {
                if (!isCoarse &&
                    !pinned &&
                    card.classList.contains("show")) {
                    placeCard(e.clientX, e.clientY);
                }
            });

            zone.addEventListener("pointerleave", () => {
                if (!isCoarse) hideCard();
            });

            zone.addEventListener("click", e => {
                if (!isCoarse) return;

                e.preventDefault();
                pinned = true;
                showForZone(zone, e);
            });
        });

        document.addEventListener("click", e => {
            if (!card.classList.contains("show")) return;
            if (stage.contains(e.target) && e.target.closest(".cut-zone")) return;
            if (card.contains(e.target)) return;

            pinned = false;
            hideCard(true);
        });

        document.addEventListener("keydown", e => {
            if (e.key === "Escape") {
                pinned = false;
                hideCard(true);
            }
        });
    })();

    // ==========================================================
    // CARRUSEL
    // ==========================================================
    document.addEventListener("DOMContentLoaded", async () => {
        const track = document.getElementById("carouselTrack");
        const dotsContainer = document.querySelector(".carousel-dots");

        if (!track || !dotsContainer) return;

        function renderFallback() {
            track.innerHTML = "";
            dotsContainer.innerHTML = "";

            const slide = document.createElement("div");
            slide.className = "carousel-slide";
            slide.innerHTML = '<img src="/images/3G CALIDAD.png" alt="Banner">';

            track.appendChild(slide);
            initCarousel();
        }

        try {
            const res = await fetch("/Home/ObtenerCarouselInicio", {
                method: "GET",
                headers: {
                    "X-Requested-With": "XMLHttpRequest",
                    "Accept": "application/json"
                },
                cache: "no-store"
            });

            if (res.redirected || !res.ok) {
                renderFallback();
                return;
            }

            const ct = (res.headers.get("content-type") || "").toLowerCase();

            if (!ct.includes("application/json")) {
                renderFallback();
                return;
            }

            const banners = await res.json();
            const lista = Array.isArray(banners) ? banners : [];

            track.innerHTML = "";
            dotsContainer.innerHTML = "";

            if (!lista.length) {
                lista.push({ imagen: "/images/default-banner.jpg" });
            }

            lista.forEach((b, i) => {
                const slide = document.createElement("div");
                slide.className = "carousel-slide";

                slide.innerHTML = `
                    <img src="${b && b.imagen ? b.imagen : "/images/3G CALIDAD.png"}"
                         alt="Banner ${i + 1}"
                         onerror="this.onerror=null;this.src='/images/3G CALIDAD.png';">`;

                track.appendChild(slide);
            });

            initCarousel();
        }
        catch {
            renderFallback();
        }
    });

    function initCarousel() {
        const track = document.querySelector(".carousel-track");
        if (!track) return;

        const slides = Array.from(track.children);
        const nextBtn = document.querySelector(".carousel-btn.next");
        const prevBtn = document.querySelector(".carousel-btn.prev");
        const dotsContainer = document.querySelector(".carousel-dots");

        if (!slides.length || !nextBtn || !prevBtn || !dotsContainer) return;

        let index = 0;
        let interval = null;

        dotsContainer.innerHTML = "";

        slides.forEach((_, i) => {
            const dot = document.createElement("button");
            dot.type = "button";
            dot.setAttribute("aria-label", `Ir al banner ${i + 1}`);

            if (i === 0) dot.classList.add("active");

            dot.addEventListener("click", () => {
                index = i;
                update();
                resetAuto();
            });

            dotsContainer.appendChild(dot);
        });

        const dots = Array.from(dotsContainer.children);

        function update() {
            track.style.transform = `translateX(-${index * 100}%)`;

            dots.forEach(dot => dot.classList.remove("active"));

            if (dots[index]) {
                dots[index].classList.add("active");
            }
        }

        function next() {
            index = (index + 1) % slides.length;
            update();
        }

        function prev() {
            index = (index - 1 + slides.length) % slides.length;
            update();
        }

        function startAuto() {
            interval = setInterval(next, 4000);
        }

        function resetAuto() {
            clearInterval(interval);
            startAuto();
        }

        nextBtn.addEventListener("click", () => {
            next();
            resetAuto();
        });

        prevBtn.addEventListener("click", () => {
            prev();
            resetAuto();
        });

        let startX = 0;

        track.addEventListener("touchstart", e => {
            startX = e.touches[0].clientX;
        }, { passive: true });

        track.addEventListener("touchend", e => {
            const endX = e.changedTouches[0].clientX;

            if (startX - endX > 50) next();
            if (endX - startX > 50) prev();

            resetAuto();
        }, { passive: true });

        startAuto();
    }
})();
</script>
}
