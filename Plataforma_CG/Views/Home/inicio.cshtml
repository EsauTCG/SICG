@using Microsoft.EntityFrameworkCore;

@{
    Layout = null;
}

@inject Plataforma_CG.Data.AppDbContextUsuarios _db

@{
    var perfilId = int.Parse(User.Claims.FirstOrDefault(c => c.Type == "PerfilId")?.Value ?? "0");
    var vistasPermitidas = _db.Permisos
        .Include(p => p.Vista)
        .Where(p => p.PerfilId == perfilId)
        .Select(p => p.Vista.Nombre)
        .ToList();
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>SIGO | Sistema Integral De Gestión Operativa</title>
    <link rel="icon" type="image/png" href="~/images/ico_sigo.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/fonts/fonts.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/fonts/bootstrap-icons.css" />

    <!-- Tipografía Poppins para el sidebar -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@100;200;300;400;500;600;700;800;900&amp;display=swap" rel="stylesheet" />
    @* <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" /> *@

    <link rel="stylesheet" href="~/css/inicio-sigo-grid.css" asp-append-version="true" />
</head>

<body>

    <!-- APP BAR -->
