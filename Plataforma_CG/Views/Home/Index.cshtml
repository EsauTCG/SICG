@model Plataforma_CG.Models.LoginViewModel
@{
    ViewData["Title"] = "";
    Layout = null;
}
<!doctype html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>@ViewData["Title"] SIGO</title>
    <link rel="icon" type="image/png" href="~/images/ico_sigo.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/fonts/fonts.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/fonts/bootstrap-icons.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@100;200;300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

<link rel="stylesheet" href="~/css/acceso-sigo-grid.css" asp-append-version="true" />

<style>
    /* ============================================================
       AJUSTE RESPONSIVE FINAL — PORTADA SIGO
       Escala texto, indicadores y botones según tamaño de pantalla.
       No modifica login, rutas, eventos ni lógica JavaScript.
       ============================================================ */

    /* ----- Contenido principal izquierdo ----- */
    #view-home .cg-copy {
        padding-left: clamp(42px, 4.2vw, 84px) !important;
        padding-right: clamp(34px, 3.4vw, 68px) !important;
        gap: clamp(12px, 1.6vh, 20px) !important;
    }

    #view-home .cg-tagline-sub {
        font-size: clamp(.88rem, .72vw, 1.08rem) !important;
        line-height: 1.25 !important;
        letter-spacing: .045em !important;
    }

    #view-home .cg-hero-title {
        font-size: clamp(3rem, 3.8vw, 5.1rem) !important;
        line-height: .96 !important;
        letter-spacing: .005em !important;
        margin: 0 !important;
    }

    #view-home .cg-divider {
        width: clamp(48px, 3.2vw, 68px) !important;
        height: 2px !important;
    }

    #view-home .cg-hero-desc {
        max-width: 54ch !important;
        font-size: clamp(.92rem, .76vw, 1.08rem) !important;
        line-height: 1.55 !important;
    }

    /* ----- Indicadores ----- */
    #view-home .cg-features {
        gap: clamp(18px, 2.15vw, 40px) !important;
        margin-top: clamp(2px, .5vh, 8px) !important;
    }

    #view-home .cg-feature {
        gap: clamp(5px, .55vh, 8px) !important;
    }

    #view-home .cg-feature-icon {
        width: clamp(46px, 3.15vw, 62px) !important;
        height: clamp(46px, 3.15vw, 62px) !important;
        font-size: clamp(1rem, 1.05vw, 1.35rem) !important;
    }

    #view-home .cg-feature-label {
        font-size: clamp(.66rem, .58vw, .84rem) !important;
        line-height: 1.15 !important;
        letter-spacing: .055em !important;
    }

    #view-home .cg-feature-sub {
        font-size: clamp(.58rem, .51vw, .74rem) !important;
        line-height: 1.2 !important;
    }

    /* ----- Botones principales ----- */

    #view-home .cg-cta-area {
    margin-top: clamp(80px, 7.6vh, 108px) !important;
    transform: none !important;
    position: relative !important;
    z-index: 20 !important;
}

    #view-home .cg-btn-row {
        display: flex !important;
        align-items: center !important;
        gap: clamp(12px, 1vw, 20px) !important;
        flex-wrap: nowrap !important;
    }

    #view-home .cg-btn {
        min-height: clamp(44px, 4.4vh, 58px) !important;
        padding: clamp(11px, 1vh, 15px) clamp(22px, 1.8vw, 34px) !important;
        font-size: clamp(.80rem, .68vw, 1rem) !important;
        line-height: 1.1 !important;
        letter-spacing: .07em !important;
        border-radius: clamp(6px, .48vw, 10px) !important;
        white-space: nowrap !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        gap: clamp(7px, .55vw, 11px) !important;
    }

    #view-home .cg-btn i {
        font-size: 1em !important;
    }

    /* ============================================================
       MONITORES GRANDES — 1600 px en adelante
       ============================================================ */
    @@media (min-width: 1600px) and (min-height: 850px) {
        #view-home .cg-copy {
            padding-left: clamp(62px, 4.4vw, 92px) !important;
            padding-right: clamp(44px, 3.6vw, 76px) !important;
        }

        #view-home .cg-tagline-sub {
            font-size: clamp(1rem, .72vw, 1.15rem) !important;
        }

        #view-home .cg-hero-title {
            font-size: clamp(4rem, 3.9vw, 5.35rem) !important;
        }

        #view-home .cg-hero-desc {
            font-size: clamp(1rem, .76vw, 1.14rem) !important;
            line-height: 1.58 !important;
        }

        #view-home .cg-feature-icon {
            width: clamp(54px, 3vw, 66px) !important;
            height: clamp(54px, 3vw, 66px) !important;
        }

        #view-home .cg-feature-label {
            font-size: clamp(.76rem, .56vw, .88rem) !important;
        }

        #view-home .cg-feature-sub {
            font-size: clamp(.67rem, .48vw, .78rem) !important;
        }

        #view-home .cg-cta-area {
            margin-top: clamp(56px, 7vh, 100px) !important;
        }

        #view-home .cg-btn {
            min-height: clamp(48px, 4.6vh, 60px) !important;
            padding: 13px clamp(28px, 1.75vw, 38px) !important;
            font-size: clamp(.90rem, .66vw, 1.02rem) !important;
        }
    }

    /* ============================================================
       PANTALLAS DE POCA ALTURA / LAPTOP
       Reduce el espacio vertical para evitar cortes.
       ============================================================ */
    @@media (min-width: 901px) and (max-height: 760px) {
        #view-home .cg-copy {
            gap: 10px !important;
        }

        #view-home .cg-hero-title {
            font-size: clamp(2.65rem, 3.4vw, 3.8rem) !important;
        }

        #view-home .cg-hero-desc {
            font-size: clamp(.82rem, .68vw, .94rem) !important;
            line-height: 1.42 !important;
        }

        #view-home .cg-feature-icon {
            width: 42px !important;
            height: 42px !important;
            font-size: 1rem !important;
        }

        #view-home .cg-feature-label {
            font-size: .68rem !important;
        }

        #view-home .cg-feature-sub {
            font-size: .60rem !important;
        }

        #view-home .cg-cta-area {
            margin-top: 34px !important;
        }

        #view-home .cg-btn {
            min-height: 42px !important;
            padding: 10px 20px !important;
            font-size: .78rem !important;
        }
    }

    /* ============================================================
       TABLET
       ============================================================ */
    @@media (min-width: 581px) and (max-width: 900px) {
        #view-home .cg-copy {
            padding-left: 24px !important;
            padding-right: 24px !important;
            gap: 13px !important;
        }

        #view-home .cg-hero-title {
            font-size: clamp(2.7rem, 8vw, 3.7rem) !important;
        }

        #view-home .cg-hero-desc {
            font-size: .92rem !important;
        }

        #view-home .cg-features {
            gap: 18px !important;
        }

        #view-home .cg-cta-area {
            margin-top: 38px !important;
        }

        #view-home .cg-btn-row {
            flex-wrap: wrap !important;
            justify-content: center !important;
        }

        #view-home .cg-btn {
            min-height: 46px !important;
            padding: 12px 22px !important;
            font-size: .84rem !important;
        }
    }

    /* ============================================================
       MÓVIL
       ============================================================ */
    @@media (max-width: 580px) {
        #view-home .cg-copy {
            padding-left: 16px !important;
            padding-right: 16px !important;
            gap: 12px !important;
        }

        #view-home .cg-tagline-sub {
            font-size: .82rem !important;
        }

        #view-home .cg-hero-title {
            font-size: clamp(2.25rem, 12vw, 2.9rem) !important;
            line-height: .98 !important;
        }

        #view-home .cg-hero-desc {
            font-size: .86rem !important;
            line-height: 1.48 !important;
        }

        #view-home .cg-features {
            display: grid !important;
            grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
            width: 100% !important;
            gap: 14px !important;
        }

        #view-home .cg-feature-icon {
            width: 44px !important;
            height: 44px !important;
            font-size: 1rem !important;
        }

        #view-home .cg-cta-area {
            width: 100% !important;
            margin-top: 28px !important;
        }

        #view-home .cg-btn-row {
            width: 100% !important;
            flex-direction: column !important;
            gap: 10px !important;
        }

        #view-home .cg-btn {
            width: 100% !important;
            min-height: 46px !important;
            padding: 12px 16px !important;
            font-size: .82rem !important;
            white-space: normal !important;
            text-align: center !important;
        }
    }

/* ============================================================
   AJUSTE LOGIN MODAL — BAJAR UN POCO EL BOTÓN Y LAS ACCIONES
   Mueve ligeramente el bloque de acciones hacia abajo para
   aprovechar el espacio vacío de la parte inferior.
   ============================================================ */

#loginModal .cg-login-right {
    display: flex !important;
    flex-direction: column !important;
    justify-content: center !important;
    padding-top: 22px !important;
    padding-bottom: 24px !important;
}

#loginModal #loginModalLabel {
    margin-bottom: 18px !important;
}

#loginModal #loginForm {
    margin-top: 6px !important;
}

#loginModal .cg-login-btn {
    margin-top: 16px !important;
    min-height: 50px !important;
}

#loginModal .cg-login-right .small.text-center {
    margin-top: 14px !important;
}

#loginModal #loginError,
#loginModal #offlineAccessBox {
    margin-top: 10px !important;
    margin-bottom: 10px !important;
}

/* Ajuste fino para que el bloque quede un poco más abajo
   sin romper la vista en pantallas medianas */
@@media (min-width: 768px) {
    #loginModal .cg-login-right {
        padding-top: 28px !important;
        padding-bottom: 28px !important;
    }

    #loginModal #loginForm {
        margin-top: 10px !important;
    }

    #loginModal .cg-login-btn {
        margin-top: 18px !important;
    }

    #loginModal .cg-login-right .small.text-center {
        margin-top: 16px !important;
    }
}

/* En móvil no exagerar el desplazamiento */
@@media (max-width: 767.98px) {
    #loginModal .cg-login-right {
        padding-top: 16px !important;
        padding-bottom: 18px !important;
    }

    #loginModal #loginModalLabel {
        margin-bottom: 14px !important;
    }

    #loginModal .cg-login-btn {
        margin-top: 12px !important;
        min-height: 46px !important;
    }

    #loginModal .cg-login-right .small.text-center {
        margin-top: 10px !important;
    }
}


</style>

<link rel="stylesheet" href="~/css/acceso-sigo-tinto-poppins.css" asp-append-version="true" />

</head>

<body>

<!-- ========== VISTA HOME ========== -->
<section id="view-home" class="cg-view-section active-view" style="display:flex;">

    <!-- TOP BAR -->
    <header class="cg-topbar">
            <div class="cg-logo-hero">
                <img src="images/logoCubo.png" alt="Carnes G">
            </div>

       @*  <nav style="display:flex;gap:32px;align-items:center;position:absolute;left:50%;transform:translateX(-50%);">
            <a href="#" id="linkHome" class="active" onclick="switchView('home'); return false;"
               style="font-family:'Poppins',sans-serif;font-weight:800;font-size:1rem;letter-spacing:.06em;text-transform:uppercase;color:rgba(255,255,255,.82);text-decoration:none;transition:color .18s;">Inicio</a>
            <a href="#" id="linkAbout" onclick="switchView('about'); return false;"
               style="font-family:'Poppins',sans-serif;font-weight:800;font-size:1rem;letter-spacing:.06em;text-transform:uppercase;color:rgba(255,255,255,.82);text-decoration:none;transition:color .18s;">Nosotros</a>
        </nav> *@
@* 
        <div class="cg-quote">
            Comprometidos con la calidad,<br>la seguridad alimentaria y la<br>mejora continua en cada proceso.
        </div> *@
    </header>

    <!-- STAGE -->
    <div class="cg-stage">

        <!-- LEFT COPY -->
        <div class="cg-copy">
            <div class="cg-tagline-sub">Bienvenido a</div>
            <h1 class="cg-hero-title">Plataforma <span>SIGO</span></h1>
            <div class="cg-divider"></div>
            <p class="cg-hero-desc">
                Sistema integral para la gestión y control de la cadena productiva:
                sacrificio, deshuese, empaque, inventarios, ventas y trazabilidad.
            </p>

            <div class="cg-features">
                <div class="cg-feature">
                    <div class="cg-feature-icon"><i class="fas fa-shield-halved"></i></div>
                    <span class="cg-feature-label">Inocuidad</span>
                    <span class="cg-feature-sub">Garantizada</span>
                </div>
                <div class="cg-feature">
                    <div class="cg-feature-icon"><i class="fas fa-award"></i></div>
                    <span class="cg-feature-label">Calidad</span>
                    <span class="cg-feature-sub">Premium</span>
                </div>
                <div class="cg-feature">
                    <div class="cg-feature-icon"><i class="fas fa-truck-fast"></i></div>
                    <span class="cg-feature-label">Trazabilidad</span>
                    <span class="cg-feature-sub">Completa</span>
                </div>
                <div class="cg-feature">
                    <div class="cg-feature-icon"><i class="fas fa-chart-line"></i></div>
                    <span class="cg-feature-label">Control</span>
                    <span class="cg-feature-sub">Total</span>
                </div>
            </div>

            <div class="cg-cta-area">
                <div class="cg-btn-row">
                    <button class="cg-btn cg-btn-primary" type="button" id="btnOpenLogin">
                        <i class="fas fa-sign-in-alt"></i> Ingresar al sistema
                    </button>
                        <button class="cg-btn cg-btn-outline" type="button" onclick="switchView('about');">
                            <i class="fas fa-circle-info"></i> Conoce más
                        </button>
                </div>
            </div>

            <!-- hidden elements kept for JS slideshow compatibility -->
            <div id="kicker" style="display:none;"></div>
            <h1 class="cg-title" id="title" style="display:none;"></h1>
            <div class="cg-price" id="price" style="display:none;"></div>
            <p class="cg-desc" id="desc" style="display:none;"></p>
            <div class="cg-badges" style="display:none;"></div>
            <div class="cg-stats" style="display:none;">
                <div class="cg-stat"><span class="cg-stat-num"></span><span class="cg-stat-label"></span></div>
                <div class="cg-stat"><span class="cg-stat-num"></span><span class="cg-stat-label"></span></div>
                <div class="cg-stat"><span class="cg-stat-num"></span><span class="cg-stat-label"></span></div>
            </div>
            <div class="cg-cats" style="display:none;"></div>
            <a id="ctaLink" style="display:none;"></a>
        </div>

        <!-- RIGHT VISUAL -->
        <div class="cg-visual-col">
            <div class="cg-visual">
                <div class="cg-product-wrap">
                        <img id="imgMain" class="cg-img-main" src="images/logoinicio.png" alt="Producto principal" />
                    <img id="imgNext" class="cg-img-next" src="images/banner-cow.jpg" alt="" style="display:none;" />
                </div>
                <div class="cg-visual-tag" id="visualTag" style="display:none;"></div>
                <div class="cg-caption" id="caption" style="display:none;"></div>

                <!-- Live clock -->
                <div class="cg-clock-card">
                    <div class="cg-clock-date">
                        <i class="fas fa-calendar-days"></i>
                        <span id="clockDate">—</span>
                    </div>
                    <div>
                        <span class="cg-clock-time" id="clockTime">00:00</span><span class="cg-clock-ampm" id="clockAmpm">a. m.</span>
                    </div>
                </div>
            </div>

            <!-- Thumbs hidden but DOM kept for JS -->
            <div class="cg-thumbs" id="thumbsContainer" style="display:none;">
                <div class="cg-thumb active" data-slide="0" onclick="go(0)">
                    <span class="cg-thumb-icon"><i class="fas fa-drumstick-bite"></i></span>
                    <span class="cg-thumb-name">Cortes premium</span>
                </div>
                <div class="cg-thumb" data-slide="1" onclick="go(1)">
                    <span class="cg-thumb-icon"><i class="fas fa-industry"></i></span>
                    <span class="cg-thumb-name">Proceso riguroso</span>
                </div>
                <div class="cg-thumb" data-slide="2" onclick="go(2)">
                    <span class="cg-thumb-icon"><i class="fas fa-truck-fast"></i></span>
                    <span class="cg-thumb-name">Logística nacional</span>
                </div>
            </div>
        </div>

    </div>

    <!-- TRUST BAR -->
    <div class="cg-trust-bar">
        <div class="cg-trust-items">
            <div class="cg-trust-item"><i class="fas fa-shield-halved"></i> Inocuidad certificada</div>
            <div class="cg-trust-item"><i class="fas fa-location-dot"></i> San Juan de los Lagos, Jal.</div>
            <div class="cg-trust-item"><i class="fas fa-box"></i> Embalaje controlado</div>
            <div class="cg-trust-item"><i class="fas fa-route"></i> Trazabilidad completa</div>
        </div>
        <span class="cg-trust-copyright">© @DateTime.Now.Year Carnes G. Todos los derechos reservados.</span>
        <div class="cg-nav-dots" id="navDots"></div>
    </div>

    <!-- hidden controls kept for JS -->
    <div class="cg-controls" style="display:none!important;">
        <button id="btnPrev" type="button">‹</button>
        <div id="dots"></div>
        <button id="btnNext" type="button">›</button>
    </div>

</section>

<!-- ========== VISTA ABOUT ========== -->
<section id="view-about" class="cg-view-section">

    

    <button class="cg-about-back" type="button" onclick="switchView('home');">
        <i class="fas fa-arrow-left"></i>
        Volver al inicio
    </button>

    <div class="container-fluid h-100">
        <div class="row w-100 h-100 align-items-center justify-content-center m-0">

            <div class="col-lg-5 h-100 d-flex align-items-center justify-content-center p-0">
                <div class="carousel-wrap">
                    <div id="heroCarousel" class="carousel slide carousel-fade"
                         data-bs-ride="carousel" data-bs-interval="3000">
                        <div class="carousel-inner">
                            <div class="carousel-item active">
                                <img src="images/logoCubo.png" alt="Vaca">
                            </div>
                            <div class="carousel-item">
                                <img src="images/proceso2.png" alt="Producción">
                            </div>
                            <div class="carousel-item">
                                <img src="images/Muu.jpeg" alt="Carne">
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-7 h-100 d-flex align-items-center">
                <div class="about-content-wrap">
                    <span class="cg-kicker-red">NOSOTROS</span>
                    <h1 class="cg-title-about">CARNES G</h1>
                    <p class="cg-desc-about">
                        Somos una empresa mexicana originaria de San Juan de los Lagos Jal. dedicada a la producción,
                        procesamiento y comercialización de productos cárnicos, que a lo largo del tiempo ha logrado un
                        crecimiento sólido y sostenido gracias a su firme compromiso con la calidad, la innovación y la
                        satisfacción de nuestros clientes.
                        <br><br>
                        Nuestro principal objetivo es ofrecer productos de la más alta calidad, garantizando frescura,
                        sabor e inocuidad en cada etapa del proceso productivo. Desde la cuidadosa selección de nuestras
                        materias primas, pasando por estrictos controles de calidad, hasta la distribución y entrega final,
                        trabajamos bajo altos estándares que aseguran productos confiables y seguros.
                    </p>

                    <div class="cards-row">
                        <div class="mini-card">
                            <div class="mini-card-icon"><i class="fas fa-award"></i></div>
                            <h4>Misión</h4>
                            <p>Llevar a tu mesa la mejor carne con inocuidad y frescura garantizada.</p>
                        </div>
                        <div class="mini-card">
                            <div class="mini-card-icon"><i class="fas fa-computer"></i></div>
                            <h4>Plataforma SIGO</h4>
                            <p>Integramos tecnología con nuestra plataforma SIGO para monitorear cada etapa.</p>
                        </div>
                        <div class="mini-card">
                            <div class="mini-card-icon"><i class="fas fa-truck-fast"></i></div>
                            <h4>Cobertura</h4>
                            <p>Red logística eficiente para mantener una cadena de distribución nacional.</p>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- ========== MODAL LOGIN ========== -->
<div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content cg-modal">
            <div class="modal-body p-0">
                <div class="cg-login">

                    <div class="cg-login-left">
                        <div class="cg-social">
                            <a href="https://www.youtube.com/watch?v=VTn435mJVw8" target="_blank" aria-label="YouTube">
                                <i class="fab fa-youtube"></i>
                            </a>
                            <a href="https://www.instagram.com/carnesg.mx/" target="_blank" aria-label="Instagram">
                                <i class="fab fa-instagram"></i>
                            </a>
                            <a href="https://www.facebook.com/Carnesg.mx" target="_blank" aria-label="Facebook">
                                <i class="fab fa-facebook-f"></i>
                            </a>
                        </div>
                    </div>

                    <div class="cg-login-right">
                        <img src="~/images/Usr.png" alt="Logo" class="cg-login-logo" />
                            <h3 class="text-center mb-3" id="loginModalLabel">Acceso al sistema</h3>

                        <form id="loginForm">
                            <input type="hidden" name="ReturnUrl" value="@(ViewBag.ReturnUrl ?? "")" />

                            <div class="mb-3 input-group">
                                <span class="input-group-text"><i class="fas fa-user"></i></span>
                                <input type="text" name="Usuario" class="form-control"
                                       placeholder="Usuario o correo electrónico"
                                       autocomplete="username" required />
                            </div>

                            <div class="mb-3 input-group">
                                <span class="input-group-text"><i class="fas fa-lock"></i></span>
                                <input type="password" name="Password" class="form-control"
                                       placeholder="Contraseña"
                                       autocomplete="current-password" required />
                            </div>

                                @if (ViewBag.SesionExpirada == true)
                                {
                                    <div class="alert alert-warning">
                                        <i class="fas fa-clock me-2"></i>
                                        Tu sesión expiró por inactividad. Inicia sesión nuevamente para continuar.
                                    </div>
                                }

                            <div id="loginError" class="alert alert-danger d-none"></div>

                            <div id="offlineAccessBox" class="alert alert-warning d-none">
                                <div style="font-weight:800;margin-bottom:6px;">
                                    Modo offline disponible
