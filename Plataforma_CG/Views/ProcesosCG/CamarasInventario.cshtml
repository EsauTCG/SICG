        <div class="rack3d-body">
            <div id="rack3d-canvas"></div>
            <div class="rack-info">
                <h4>Ubicación seleccionada</h4>
                <div id="rack-info-content">Haz clic en una tarima.</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
    @* CORRECCIÓN: la biblioteca de Excel se fija a una versión (antes cargaba "la más reciente", que puede cambiar sin aviso). *@
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>

    <script>
        /* ================= Divisores para cambiar anchos (sin cambios de fondo) ================= */
        (() => {
            const ROOT_ID = 'inventarioPlantaApp';
            const SETTINGS = {
                camera: { containerSelector: '.inv-layout', leftSelector: ':scope > .sidebar', handleSelector: '.inv-resize-overlay-camera', storageKey: 'inv-planta-v6-camera-width', minLeft: 130, minRight: 650, rightTemplate: 'minmax(0, 1fr)' },
                tables: { containerSelector: '.traz-panel', leftSelector: ':scope > .traz-left', handleSelector: '.inv-resize-overlay-tables', storageKey: 'inv-planta-v6-tables-width', minLeft: 300, minRight: 460, rightTemplate: 'minmax(460px, 1fr)' }
            };
            const root = () => document.getElementById(ROOT_ID);
            const visible = el => el && el.offsetParent !== null && getComputedStyle(el).display !== 'none';
            function getParts(s) {
                const r = root(); if (!r) return {};
                const container = r.querySelector(s.containerSelector);
                return { container, left: container?.querySelector(s.leftSelector), handle: r.querySelector(s.handleSelector) };
            }
            const gapPx = c => { const v = parseFloat(getComputedStyle(c).columnGap || '0'); return Number.isFinite(v) ? v : 0; };
            function syncOne(s) {
                const { container, left, handle } = getParts(s);
                if (!container || !left || !visible(handle)) return;
                handle.style.left = `${left.getBoundingClientRect().right - container.getBoundingClientRect().left + gapPx(container) / 2}px`;
            }
            const syncHandles = () => Object.values(SETTINGS).forEach(syncOne);
            function applyWidth(s, px, save) {
                const { container, left } = getParts(s);
                if (!container || !left) return;
                const v = Math.round(px);
                container.style.setProperty('grid-template-columns', `${v}px ${s.rightTemplate}`, 'important');
                if (save) { try { localStorage.setItem(s.storageKey, String(v)); } catch { } }
                requestAnimationFrame(syncHandles);
            }
            function reset(s) {
                const { container } = getParts(s);
                if (!container) return;
                try { localStorage.removeItem(s.storageKey); } catch { }
                container.style.removeProperty('grid-template-columns');
                requestAnimationFrame(syncHandles);
            }
            function maxLeft(s) {
                const { container } = getParts(s);
                return Math.max(s.minLeft, container.getBoundingClientRect().width - s.minRight - gapPx(container));
            }
            function startResize(s, ev) {
                const { left, handle } = getParts(s);
                if (!left || !handle) return;
                ev.preventDefault();
                const startX = ev.clientX, startW = left.getBoundingClientRect().width, max = maxLeft(s);
                handle.classList.add('is-resizing');
                document.body.classList.add('inv-v6-resizing');
                const onMove = e => applyWidth(s, Math.min(max, Math.max(s.minLeft, startW + e.clientX - startX)), false);
                const onUp = () => {
                    handle.classList.remove('is-resizing');
                    document.body.classList.remove('inv-v6-resizing');
                    applyWidth(s, left.getBoundingClientRect().width, true);
                    document.removeEventListener('pointermove', onMove);
                    document.removeEventListener('pointerup', onUp);
                };
                document.addEventListener('pointermove', onMove);
                document.addEventListener('pointerup', onUp);
            }
            function wire(s) {
                const { handle, left } = getParts(s);
                if (!handle) return;
                handle.addEventListener('pointerdown', e => startResize(s, e));
                handle.addEventListener('dblclick', e => { e.preventDefault(); reset(s); });
                handle.addEventListener('keydown', e => {
                    if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
                    e.preventDefault();
                    const cur = getParts(s).left.getBoundingClientRect().width;
                    applyWidth(s, Math.min(maxLeft(s), Math.max(s.minLeft, cur + (e.key === 'ArrowLeft' ? -20 : 20))), true);
                });
            }
            function init() {
                wire(SETTINGS.camera); wire(SETTINGS.tables);
                Object.values(SETTINGS).forEach(s => {
                    let saved = NaN; try { saved = Number(localStorage.getItem(s.storageKey)); } catch { }
                    if (Number.isFinite(saved) && saved >= s.minLeft && window.matchMedia('(min-width: 1001px)').matches) applyWidth(s, saved, false);
                });
                requestAnimationFrame(syncHandles);
                window.addEventListener('resize', syncHandles);
                if (window.ResizeObserver) {
                    const ro = new ResizeObserver(syncHandles);
                    root()?.querySelectorAll('.inv-layout, .traz-panel').forEach(el => ro.observe(el));
                }
            }
            if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, { once: true }); else init();
        })();
    </script>

    <script>
        /* ================= Inventario por planta ================= */
        const nf = new Intl.NumberFormat('es-MX', { maximumFractionDigits: 0 });
        const nfK = new Intl.NumberFormat('es-MX', { minimumFractionDigits: 3, maximumFractionDigits: 3 });
        const nfP = new Intl.NumberFormat('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

        let plantaActual = "P1";
        let camaraActual = null;
        let camarasSeleccionadas = new Set();
        let datosInv = [];
        let datosTraz = [];
        let datosTrazOriginal = [];

        let rackScene = null, rackCamera = null, rackRenderer = null, rackControls = null, rackRaycaster = null, rackMouse = null;
        let rackIndexMap = {}, rackObjects = [], rackAnimationId = null, rackItemsIndex = [], rackCamaraActualVista = "";

        let sortCol = "", sortDir = "asc", sortTrazCol = "", sortTrazDir = "asc";

        const PLANTAS = { P1: { label: 'PLANTA 1', camaras: [] }, TIF: { label: 'TIF 776', camaras: [] } };

        // Reglas del semáforo de días (se conservan tal cual; ver notas para el consejo)
        const DIAS_TABLA = { amarillo: 15, rojo: 50 };   // tabla de detalle
        const DIAS_RACK = { verde: 15, amarillo: 30 };    // colores del rack 3D
        const DIAS_CRITICO = 30;                          // KPI "Críticos"

        let inventarioLoadingCount = 0;
        function mostrarCargaInventario(texto = "Cargando información…") {
            inventarioLoadingCount++;
            const overlay = document.getElementById("inventario-loading");
            document.getElementById("inventario-loading-text").textContent = texto;
            overlay?.classList.add("show");
            overlay?.setAttribute("aria-hidden", "false");
        }
        function ocultarCargaInventario() {
            inventarioLoadingCount = Math.max(0, inventarioLoadingCount - 1);
            if (inventarioLoadingCount > 0) return;
            const overlay = document.getElementById("inventario-loading");
            overlay?.classList.remove("show");
            overlay?.setAttribute("aria-hidden", "true");
        }

        function esc(v) { return String(v ?? "").replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;").replaceAll('"', "&quot;").replaceAll("'", "&#039;"); }
        function getVal(obj, ...keys) { for (const k of keys) { if (obj && obj[k] !== undefined && obj[k] !== null) return obj[k]; } return ""; }
        function formatDate(v) { if (!v) return "-"; const s = String(v); return s.includes("T") ? s.substring(0, 10) : (s.length >= 10 ? s.substring(0, 10) : s); }
        function formatDateTime(v) { if (!v) return "-"; const s = String(v); return s.includes("T") ? s.substring(0, 16).replace("T", " ") : (s.length >= 16 ? s.substring(0, 16) : s); }
        const esActivo = e => String(e || "").trim().toUpperCase() === "ACTIVO";
        const msgFila = (cols, texto) => `<tr class="t-msg"><td colspan="${cols}">${esc(texto)}</td></tr>`;

        async function leerJson(resp) {
            const ct = (resp.headers.get('content-type') || '').toLowerCase();
            if (!ct.includes('json')) throw new Error(`El servidor respondió ${resp.status} sin datos.`);
            return resp.json();
        }

        // ---------- Cámaras ----------
        async function cargarCamarasPorPlanta() {
            const list = document.getElementById('sidebar-list');
            list.innerHTML = '<div class="cam-item is-msg">Cargando…</div>';
            mostrarCargaInventario("Cargando cámaras…");
            try {
                const resp = await fetch(`/ProcesosCG/ObtenerCamaras?planta=${encodeURIComponent(plantaActual)}`);
                const data = await leerJson(resp);
                if (!data.ok) { alert(data.mensaje || 'Error cargando cámaras'); PLANTAS[plantaActual].camaras = []; }
                else PLANTAS[plantaActual].camaras = data.camaras || [];
            } catch (err) {
                console.error(err);
                alert('No se pudieron cargar las cámaras.');
                PLANTAS[plantaActual].camaras = [];
            } finally {
                renderSidebar();
                ocultarCargaInventario();
            }
        }

        function renderSidebar() {
            const planta = PLANTAS[plantaActual];
            const list = document.getElementById("sidebar-list");
            document.getElementById("sidebar-count").textContent = planta.camaras.length ? `${camarasSeleccionadas.size}/${planta.camaras.length}` : '';
            if (!planta.camaras.length) { list.innerHTML = '<div class="cam-item is-msg">Sin cámaras</div>'; return; }
            list.innerHTML = planta.camaras.map(c => {
                const sel = camarasSeleccionadas.has(c);
                return `<div class="cam-item${sel ? " active" : ""}" data-cam="${esc(c)}" role="option" aria-selected="${sel}" tabindex="0">${esc(c)}</div>`;
            }).join("");
        }

        // ---------- Etiquetación (selector con búsqueda) ----------
        let etiquetacionesFiltroCache = [];
        let etqIndiceActivo = -1;
        const normEtq = v => String(v || "").normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim();
        function obtenerNombreEtiquetacionSeleccionada() {
            const ddl = document.getElementById("ddl-etiquetacion");
            return ddl?.options[ddl.selectedIndex]?.textContent?.trim() || "Todas las etiquetaciones";
        }
        function cerrarComboEtiquetacion() { document.getElementById("cmb-etiquetacion")?.classList.remove("open"); document.getElementById("txt-etiquetacion-buscar")?.setAttribute('aria-expanded', 'false'); etqIndiceActivo = -1; }
        function abrirComboEtiquetacion(seleccionarTexto = false) {
            const combo = document.getElementById("cmb-etiquetacion"), input = document.getElementById("txt-etiquetacion-buscar");
            if (!combo || !input) return;
            combo.classList.add("open");
            input.setAttribute('aria-expanded', 'true');
            if (seleccionarTexto) { input.focus(); input.select(); }
            renderListaEtiquetaciones(input.value);
        }
        function renderListaEtiquetaciones(texto = "") {
            const lista = document.getElementById("lst-etiquetacion"), ddl = document.getElementById("ddl-etiquetacion");
            if (!lista || !ddl) return;
            let q = normEtq(texto);
            if (q === normEtq(obtenerNombreEtiquetacionSeleccionada())) q = "";
            const opciones = [{ id: "", nombre: "Todas las etiquetaciones" }, ...etiquetacionesFiltroCache].filter(x => !q || normEtq(x.nombre).includes(q) || normEtq(x.id).includes(q));
            etqIndiceActivo = -1;
            if (!opciones.length) { lista.innerHTML = '<div class="etq-combo-empty">No se encontraron etiquetaciones.</div>'; return; }
            lista.innerHTML = opciones.map((x, i) => {
                const sel = String(ddl.value || "") === String(x.id || "");
                return `<button type="button" class="etq-combo-item${sel ? " seleccionado" : ""}" data-etq-id="${esc(x.id)}" data-etq-index="${i}" role="option" aria-selected="${sel}"><span>${esc(x.nombre)}</span>${sel ? '<i class="bi bi-check-lg etq-check"></i>' : ''}</button>`;
            }).join("");
        }
        function seleccionarEtiquetacion(id, nombre, ejecutarBusqueda = true) {
            const ddl = document.getElementById("ddl-etiquetacion"), input = document.getElementById("txt-etiquetacion-buscar");
            if (!ddl || !input) return;
            const valor = String(id || "").trim();
            ddl.value = [...ddl.options].some(o => String(o.value) === valor) ? valor : "";
            input.value = nombre || obtenerNombreEtiquetacionSeleccionada();
            cerrarComboEtiquetacion();
            if (ejecutarBusqueda) ddl.dispatchEvent(new Event("change", { bubbles: true }));
        }
        function moverActivoEtiquetacion(dir) {
            const items = [...document.querySelectorAll("#lst-etiquetacion .etq-combo-item")];
            if (!items.length) return;
            items.forEach(x => x.classList.remove("activo-busqueda"));
            etqIndiceActivo = (etqIndiceActivo + dir + items.length) % items.length;
            items[etqIndiceActivo].classList.add("activo-busqueda");
            items[etqIndiceActivo].scrollIntoView({ block: "nearest" });
        }
        async function cargarEtiquetacionesFiltro() {
            const ddl = document.getElementById("ddl-etiquetacion"), input = document.getElementById("txt-etiquetacion-buscar");
            if (!ddl) return;
            mostrarCargaInventario("Cargando etiquetaciones…");
            const valorAnterior = String(ddl.value || "").trim();
            ddl.innerHTML = '<option value="">Todas las etiquetaciones</option>';
            etiquetacionesFiltroCache = [];
            try {
                // Planta 1 usa el catálogo de origen TIF; TIF usa el suyo.
                const source = plantaActual === "P1" ? "TIF" : plantaActual;
                const resp = await fetch(`/ProcesosCG/Etiquetaciones?source=${encodeURIComponent(source)}`);
                const data = await leerJson(resp);
                if (!resp.ok || !data || data.ok === false) { console.warn(data?.msg || data?.mensaje || "No se pudieron cargar las etiquetaciones."); return; }
                (data.rows || []).forEach(r => {
                    const id = String(getVal(r, "ColectorId", "colectorId") || "").trim();
                    const nombre = String(getVal(r, "Etiquetacion", "etiquetacion", "Nombre", "nombre") || "").trim();
                    if (!id || !nombre) return;
                    etiquetacionesFiltroCache.push({ id, nombre });
                    const opt = document.createElement("option");
                    opt.value = id; opt.textContent = nombre;
                    ddl.appendChild(opt);
                });
                etiquetacionesFiltroCache.sort((a, b) => a.nombre.localeCompare(b.nombre, "es", { sensitivity: "base" }));
                ddl.value = (valorAnterior && [...ddl.options].some(o => o.value === valorAnterior)) ? valorAnterior : "";
            } catch (err) {
                console.error("Error cargando etiquetaciones:", err);
            } finally {
                if (input) input.value = obtenerNombreEtiquetacionSeleccionada();
                renderListaEtiquetaciones("");
                ocultarCargaInventario();
            }
        }

        function filtrarDetallePorEtiquetacion(rows, etiquetacionId) {
            const id = String(etiquetacionId ?? document.getElementById("ddl-etiquetacion")?.value ?? "").trim();
            const arr = Array.isArray(rows) ? rows : [];
            return id ? arr.filter(r => String(getVal(r, "EtiquetacionId", "etiquetacionId", "ColectorId", "colectorId") || "").trim() === id) : arr;
        }

        function consolidarInventarioPrincipal(rows) {
            const mapa = new Map();
            (Array.isArray(rows) ? rows : []).forEach(r => {
                const almacen = String(r.almacen || "").trim(), sku = String(r.sku || "").trim(), nombre = String(r.nombre || "").trim();
                const lineaId = String(r.lineaId || "").trim(), estatus = String(r.estatus || "").trim(), ubic = String(r.ubic || "-").trim();
                const key = [almacen, sku, nombre, lineaId, estatus].join("||").toUpperCase();
                if (!mapa.has(key)) mapa.set(key, { fecha: r.fecha || "-", almacen, sku, nombre, cajas: 0, kg: 0, prom: 0, lineaId, estatus, ubic });
                const item = mapa.get(key);
                item.cajas += Number(r.cajas || 0);
                item.kg += Number(r.kg || 0);
            });
            const out = [...mapa.values()];
            out.forEach(r => r.prom = r.cajas > 0 ? r.kg / r.cajas : 0);
            return out;
        }

        // ---------- Inventario ----------
        let _invSeq = 0;
        async function cargarInventario() {
            const seq = ++_invSeq; // CORRECCIÓN: si cambias de cámara rápido, solo se pinta la consulta más reciente
            const skuFiltro = document.getElementById("txt-sku").value.trim().toLowerCase();
            const productoFiltro = document.getElementById("txt-producto").value.trim().toLowerCase();
            const etqId = String(document.getElementById("ddl-etiquetacion")?.value || "").trim();
            const camaras = [...camarasSeleccionadas];

            // Sin cámara y sin etiquetación no se consulta todo (consulta pesada).
            // Sin cámara pero con etiquetación, el servidor busca en todas las cámaras.
            if (!camaras.length && !etqId) {
                datosInv = []; datosTraz = []; datosTrazOriginal = [];
                renderInventario([]); renderTrazabilidad([]);
                return;
            }

            mostrarCargaInventario(!camaras.length ? "Buscando la etiquetación en todas las cámaras…" : `Cargando inventario de ${camaras.length} cámara(s)…`);
            try {
                const lista = camaras.length ? camaras : [""];
                let todas = [], fallidas = 0, idx = 0, hechas = 0;
                // CORRECCIÓN: varias cámaras se consultan 4 a la vez (antes una por una)
                async function worker() {
                    while (idx < lista.length) {
                        const cam = lista[idx++];
                        try {
                            const url = `/ProcesosCG/InventarioCamaras?planta=${encodeURIComponent(plantaActual)}&camara=${encodeURIComponent(cam)}&etiquetacionId=${encodeURIComponent(etqId)}`;
                            const resp = await fetch(url);
                            const data = await leerJson(resp);
                            if (!resp.ok || !data.ok) { console.warn(data?.mensaje || data?.error || "Error cargando inventario", cam); fallidas++; continue; }
                            todas = todas.concat((data.rows || []).map(r => ({
                                fecha: getVal(r, "Fecha", "fecha") || "-",
                                almacen: getVal(r, "Almacen", "almacen") || cam || "",
                                sku: getVal(r, "Sku", "sku") || "",
                                nombre: getVal(r, "Nombre", "nombre", "Producto", "producto") || "",
                                etiquetacionId: String(getVal(r, "EtiquetacionId", "etiquetacionId", "ColectorId", "colectorId") || "").trim(),
                                etiquetacion: getVal(r, "Etiquetacion", "etiquetacion") || "",
                                cajas: Number(getVal(r, "Cajas", "cajas") || 0),
                                kg: Number(getVal(r, "Kg", "kg") || 0),
                                prom: Number(getVal(r, "Prom", "prom") || 0),
                                lineaId: getVal(r, "LineaId", "lineaId") || "",
                                estatus: getVal(r, "Estatus", "estatus") || "",
                                ubic: getVal(r, "Ubic", "ubic") || "-"
                            })));
                        } catch (e) { console.warn(e); fallidas++; }
                        if (lista.length > 1) document.getElementById("inventario-loading-text").textContent = `Cargando inventario… ${++hechas} de ${lista.length} cámaras`;
                    }
                }
                await Promise.all(Array.from({ length: Math.min(4, lista.length) }, worker));
                if (seq !== _invSeq) return;

                if (skuFiltro) todas = todas.filter(r => String(r.sku).toLowerCase().includes(skuFiltro));
                if (productoFiltro) todas = todas.filter(r => String(r.nombre).toLowerCase().includes(productoFiltro));
                if (etqId) todas = todas.filter(r => String(r.etiquetacionId || "").trim() === etqId);

                datosInv = consolidarInventarioPrincipal(todas);
                datosTraz = []; datosTrazOriginal = [];
                if (sortCol) aplicarOrdenInventario();
                renderInventario(datosInv);
                renderTrazabilidad([]);
                if (fallidas) alert(`${fallidas} cámara(s) no respondieron; el inventario mostrado puede estar incompleto.`);
            } catch (err) {
                console.error(err);
                if (seq !== _invSeq) return;
                alert("No se pudo cargar el inventario.");
                datosInv = []; datosTraz = []; datosTrazOriginal = [];
                renderInventario([]); renderTrazabilidad([]);
            } finally {
                ocultarCargaInventario();
            }
        }

        function actualizarKpisInventario(rows) {
            rows = Array.isArray(rows) ? rows : [];
            const totalCajas = rows.reduce((s, r) => s + Number(r.cajas || 0), 0);
            const totalKg = rows.reduce((s, r) => s + Number(r.kg || 0), 0);
            const skus = new Set(rows.map(r => String(r.sku || "").trim()).filter(Boolean));
            const almacenes = new Set(rows.map(r => String(r.almacen || "").trim()).filter(Boolean));
            const inactivos = rows.filter(r => !esActivo(r.estatus)).length;
            const totalCamaras = Number(PLANTAS[plantaActual]?.camaras?.length || 0);
            const sel = camarasSeleccionadas.size;
            const etq = String(document.getElementById("ddl-etiquetacion")?.value || "").trim();
            const set = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };
            set("kpi-main-camaras", nf.format(sel > 0 ? sel : etq ? almacenes.size : totalCamaras));
            set("kpi-main-camaras-sub", sel ? `de ${totalCamaras} seleccionadas` : etq ? "Con coincidencias" : `${totalCamaras} en la planta`);
            set("kpi-main-skus", nf.format(skus.size));
            set("kpi-main-cajas", nf.format(totalCajas));
            set("kpi-main-kg", nfK.format(totalKg));
            set("kpi-main-prom", nfP.format(totalCajas > 0 ? totalKg / totalCajas : 0));
            set("kpi-main-alertas", nf.format(inactivos));
            set("kpi-main-alertas-sub", inactivos > 0 ? "Renglones con estatus no activo" : "Sin alertas");
            const card = document.getElementById("kpi-main-alertas-card");
            card?.classList.toggle("con-alerta", inactivos > 0);
            card?.classList.toggle("sin-alerta", inactivos <= 0);
        }

        function textoCamaraActiva() {
            const cams = [...camarasSeleccionadas], total = PLANTAS[plantaActual].camaras.length;
            const etq = String(document.getElementById("ddl-etiquetacion")?.value || "").trim();
            if (!cams.length && etq) return "Todas las cámaras · " + obtenerNombreEtiquetacionSeleccionada();
            if (!cams.length) return "Cámara: selecciona una cámara";
            if (cams.length === total) return "Cámaras: todas (" + PLANTAS[plantaActual].label + ")";
            if (cams.length === 1) return "Cámara: " + cams[0];
            if (cams.length <= 3) return "Cámaras: " + cams.join(", ");
            return "Cámaras seleccionadas: " + cams.length;
        }

        function renderInventario(rows) {
            const tbody = document.getElementById("tbody-inv");
            actualizarKpisInventario(rows);
            document.getElementById("tot-cajas").textContent = nf.format(rows.reduce((s, r) => s + Number(r.cajas || 0), 0));
            document.getElementById("tot-kg").textContent = nfK.format(rows.reduce((s, r) => s + Number(r.kg || 0), 0));
            document.getElementById("sb-registros").textContent = "Registros: " + nf.format(rows.length);
            document.getElementById("lbl-camara-activa").textContent = textoCamaraActiva();

            if (!rows.length) {
                const hayFiltro = camarasSeleccionadas.size || document.getElementById("ddl-etiquetacion")?.value;
                tbody.innerHTML = msgFila(9, hayFiltro ? "Sin inventario con estos filtros." : "Selecciona una cámara (o una etiquetación para buscar en todas).");
                return;
            }
            tbody.innerHTML = rows.map((r, i) => `
                        <tr data-idx="${i}" tabindex="0">
                            <td class="text-center">${i + 1}</td>
                            <td>${esc(r.almacen)}</td>
                            <td>${esc(r.sku)}</td>
                            <td style="max-width:260px;overflow:hidden;text-overflow:ellipsis;" title="${esc(r.nombre)}">${esc(r.nombre)}</td>
                            <td class="text-end">${nf.format(r.cajas)}</td>
                            <td class="text-end">${nfK.format(r.kg)}</td>
                            <td class="text-end">${nfP.format(r.prom)}</td>
                            <td>${esc(r.lineaId)}</td>
                            <td><span class="${esActivo(r.estatus) ? "badge-activo" : "badge-inactivo"}">${esc(r.estatus || "-")}</span></td>
                        </tr>`).join("");
        }

        // ---------- Detalle (trazabilidad) ----------
        let _trazSeq = 0;
        async function cargarTrazabilidad(row) {
            if (!row || !row.sku) return;
            const camaraDetalle = row.almacen || camaraActual || [...camarasSeleccionadas][0] || "";
            if (!camaraDetalle) { alert("No se pudo determinar la cámara de la fila."); return; }
            const seq = ++_trazSeq;
            mostrarCargaInventario("Cargando detalle de cajas…");
            try {
                const resp = await fetch(`/ProcesosCG/TrazabilidadCamara?planta=${encodeURIComponent(plantaActual)}&sku=${encodeURIComponent(row.sku)}&camara=${encodeURIComponent(camaraDetalle)}`);
                const data = await leerJson(resp);
                if (seq !== _trazSeq) return;
                if (!resp.ok || !data.ok) { alert(data?.mensaje || data?.error || "Error cargando el detalle"); datosTraz = []; renderTrazabilidad([]); return; }
                datosTraz = filtrarDetallePorEtiquetacion(data.rows || [], row.etiquetacionId || document.getElementById("ddl-etiquetacion")?.value || "");
                sortTrazCol = ""; limpiarIndicadores('#tbl-traz');
                renderTrazabilidad(datosTraz, `${row.sku} · ${camaraDetalle}`);
            } catch (err) {
                console.error(err);
                if (seq !== _trazSeq) return;
                alert("No se pudo cargar el detalle.");
                datosTraz = []; renderTrazabilidad([]);
            } finally {
                ocultarCargaInventario();
            }
        }

        function renderTrazabilidad(rows, contexto) {
            const tbody = document.getElementById("tbody-traz");
            if (!rows.length) { tbody.innerHTML = msgFila(18, "Selecciona un renglón del inventario o presiona “Total cámara”."); return; }
            const totalKg = rows.reduce((s, t) => s + Number(getVal(t, "Kg", "kg") || 0), 0);
            document.getElementById("lbl-camara-activa").textContent = `Detalle${contexto ? ' ' + contexto : ''}: ${nf.format(rows.length)} cajas · ${nfK.format(totalKg)} kg`;
            tbody.innerHTML = rows.map((r, i) => {
                const fecha = getVal(r, "Fecha", "fecha");
                const dias = diasInventario(fecha);
                return `<tr>
                            <td class="text-center">${i + 1}</td>
                            <td>${esc(formatDate(fecha))}</td>
                            <td>${esc(formatDateTime(getVal(r, "FechaIngresoCamara", "fechaIngresoCamara")))}</td>
                            <td>${esc(getVal(r, "CodigoEtiqueta", "codigoEtiqueta"))}</td>
                            <td>${esc(getVal(r, "Sku", "sku"))}</td>
                            <td>${esc(getVal(r, "Producto", "producto"))}</td>
                            <td>${esc(getVal(r, "Etiquetacion", "etiquetacion") || "-")}</td>
                            <td class="text-end">${nfK.format(Number(getVal(r, "Kg", "kg") || 0))}</td>
                            <td>${esc(getVal(r, "Nombre", "nombre"))}</td>
                            <td>${esc(getVal(r, "Lote", "lote"))}</td>
                            <td>${esc(getVal(r, "Empaque", "empaque"))}</td>
                            <td>${esc(getVal(r, "Cantidad", "cantidad"))}</td>
                            <td>${esc(getVal(r, "Tar", "tar"))}</td>
                            <td>${esc(getVal(r, "ActTar", "actTar"))}</td>
                            <td>${esc(getVal(r, "Ubic", "ubic"))}</td>
                            <td class="text-center ${claseDiasInventario(dias)}">${nf.format(dias)}</td>
                            <td>${esc(getVal(r, "Reclasificacion", "reclasificacion"))}</td>
                            <td>${esc(formatDate(getVal(r, "Fechas_Caducidad", "Caducidad", "caducidad")))}</td>
                        </tr>`;
            }).join("");
        }

        function diasInventario(fecha) {
            if (!fecha) return 0;
            const f = new Date(String(fecha).substring(0, 10) + "T00:00:00");
            const hoy = new Date(); hoy.setHours(0, 0, 0, 0);
            return isNaN(f.getTime()) ? 0 : Math.floor((hoy - f) / 86400000);
        }
        function claseDiasInventario(d) { d = Number(d || 0); return d >= DIAS_TABLA.rojo ? "dias-rojo" : d >= DIAS_TABLA.amarillo ? "dias-amarillo" : "dias-verde"; }
        function colorSemaforoPorDias(d) { return d <= DIAS_RACK.verde ? 0x22c55e : d <= DIAS_RACK.amarillo ? 0xfacc15 : 0xef4444; }

        // ---------- Total de la cámara ----------
        async function obtenerCamaraCompleta(texto) {
            const camara = camaraActual || [...camarasSeleccionadas][0] || "";
            if (!camara) { alert("Selecciona una cámara primero."); return null; }
            if (camarasSeleccionadas.size > 1 && !camaraActual) { if (!confirm(`Tienes ${camarasSeleccionadas.size} cámaras seleccionadas; se mostrará solo ${camara}. ¿Continuar?`)) return null; }
            mostrarCargaInventario(texto);
            try {
                const resp = await fetch(`/ProcesosCG/DetalleCamaraCompleta?planta=${encodeURIComponent(plantaActual)}&camara=${encodeURIComponent(camara)}`);
                const data = await leerJson(resp);
                if (!resp.ok || !data.ok) { alert(data?.mensaje || data?.error || "Error cargando la cámara"); return null; }
                return { camara, rows: filtrarDetallePorEtiquetacion(data.rows || [], document.getElementById("ddl-etiquetacion")?.value || "") };
            } catch (err) {
                console.error(err);
                alert("No se pudo cargar la cámara completa.");
                return null;
            } finally {
                ocultarCargaInventario();
            }
        }

        async function cargarTotalCamara() {
            const res = await obtenerCamaraCompleta("Cargando total de la cámara…");
            if (!res) return;
            datosTrazOriginal = res.rows;
            datosTraz = datosTrazOriginal;
            sortTrazCol = ""; limpiarIndicadores('#tbl-traz');
            document.querySelectorAll("#tbody-inv tr").forEach(x => x.classList.remove("row-sel"));
            renderTrazabilidad(datosTraz, `de ${res.camara}`);
        }

        // ---------- Ordenar ----------
        function limpiarIndicadores(tabla) { document.querySelectorAll(`${tabla} th`).forEach(x => { x.classList.remove("asc", "desc"); x.removeAttribute('aria-sort'); }); }
        function comparar(v1, v2, dir) {
            const n1 = Number(v1), n2 = Number(v2);
            if (v1 !== "" && v2 !== "" && !isNaN(n1) && !isNaN(n2)) { v1 = n1; v2 = n2; }
            else { v1 = String(v1 ?? "").toLowerCase(); v2 = String(v2 ?? "").toLowerCase(); }
            return v1 > v2 ? (dir === "asc" ? 1 : -1) : v1 < v2 ? (dir === "asc" ? -1 : 1) : 0;
        }
        function aplicarOrdenInventario() { datosInv.sort((a, b) => comparar(a[sortCol], b[sortCol], sortDir)); }
        function ordenarInventario(col) {
            if (sortCol === col) sortDir = sortDir === "asc" ? "desc" : "asc"; else { sortCol = col; sortDir = "asc"; }
            aplicarOrdenInventario();
            limpiarIndicadores('#tbl-inv');
            const th = document.querySelector(`#tbl-inv th[data-col='${col}']`);
            if (th) { th.classList.add(sortDir); th.setAttribute('aria-sort', sortDir === 'asc' ? 'ascending' : 'descending'); }
            renderInventario(datosInv);
        }
        // CORRECCIÓN: ordenar por fecha de producción no funcionaba si el servidor manda "Fecha" con mayúscula.
        const valorTraz = (r, col) => col === "diasInv" ? diasInventario(getVal(r, "Fecha", "fecha"))
            : getVal(r, col, col.charAt(0).toLowerCase() + col.slice(1), col.charAt(0).toUpperCase() + col.slice(1));
        function ordenarTrazabilidad(col) {
            if (!datosTraz || !datosTraz.length) return;
            if (sortTrazCol === col) sortTrazDir = sortTrazDir === "asc" ? "desc" : "asc"; else { sortTrazCol = col; sortTrazDir = "asc"; }
            datosTraz.sort((a, b) => comparar(valorTraz(a, col), valorTraz(b, col), sortTrazDir));
            limpiarIndicadores('#tbl-traz');
            const th = document.querySelector(`#tbl-traz th[data-col-traz='${col}']`);
            if (th) { th.classList.add(sortTrazDir); th.setAttribute('aria-sort', sortTrazDir === 'asc' ? 'ascending' : 'descending'); }
            renderTrazabilidad(datosTraz);
        }

        // ---------- Excel ----------
        // Mismo contenido que antes (inventario y detalle), con encabezados legibles.
        function exportarExcel() {
            if (!datosInv || !datosInv.length) { alert("No hay inventario para exportar."); return; }
            if (typeof XLSX === 'undefined') { alert("La biblioteca de Excel no se cargó."); return; }
            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet(datosInv.map(r => ({
                Almacén: r.almacen, SKU: r.sku, Nombre: r.nombre, Cajas: r.cajas, Kg: Number(r.kg.toFixed(3)), 'Kg por caja': Number(r.prom.toFixed(2)), Línea: r.lineaId, Estatus: r.estatus
            }))), "Inventario");
            XLSX.utils.book_append_sheet(wb, XLSX.utils.json_to_sheet((datosTraz || []).map(r => ({
                'Fecha producción': formatDate(getVal(r, "Fecha", "fecha")),
                'Ingreso cámara': formatDateTime(getVal(r, "FechaIngresoCamara", "fechaIngresoCamara")),
                'Código etiqueta': getVal(r, "CodigoEtiqueta", "codigoEtiqueta"), SKU: getVal(r, "Sku", "sku"), Producto: getVal(r, "Producto", "producto"),
                Etiquetación: getVal(r, "Etiquetacion", "etiquetacion"), Kg: Number(getVal(r, "Kg", "kg") || 0), Nombre: getVal(r, "Nombre", "nombre"),
                Lote: getVal(r, "Lote", "lote"), Empaque: getVal(r, "Empaque", "empaque"), Cantidad: getVal(r, "Cantidad", "cantidad"), Tarima: getVal(r, "Tar", "tar"),
                ActTar: getVal(r, "ActTar", "actTar"), Ubicación: getVal(r, "Ubic", "ubic"), 'Días inventario': diasInventario(getVal(r, "Fecha", "fecha")),
                Reclasificación: getVal(r, "Reclasificacion", "reclasificacion"), Caducidad: formatDate(getVal(r, "Fechas_Caducidad", "Caducidad", "caducidad"))
            }))), "Detalle");
            const f = new Date();
            XLSX.writeFile(wb, `Inventario_${plantaActual}_${f.getFullYear()}${String(f.getMonth() + 1).padStart(2, '0')}${String(f.getDate()).padStart(2, '0')}.xlsx`);
        }

        /* ======================= RACK 3D (misma lógica) ======================= */
        function parseUbicacionRack(ubic) {
            const m = String(ubic || "").trim().toUpperCase().match(/^R(\d+)-(\d+)([A-Z])$/);
            return m ? { rack: Number(m[1]), posicion: Number(m[2]), altura: m[3], raw: m[0] } : null;
        }
        function alturaToIndex(a) { const i = "ABCDEFG".indexOf(String(a || "").toUpperCase()); return i >= 0 ? i : 0; }

        async function abrirRack3D() {
            const res = await obtenerCamaraCompleta("Cargando cámara y rack 3D…");
            if (!res) return;
            rackCamaraActualVista = res.camara;
            datosTrazOriginal = res.rows;
            datosTraz = datosTrazOriginal;
            calcularKpisCamara(datosTraz);
            if (!datosTraz.length) { alert("La cámara no tiene productos para la etiquetación o filtro actual."); return; }
            document.getElementById("modal-rack3d").classList.add("show");
            document.getElementById("rack-title-camara").textContent = "Vista de cámara · " + res.camara;
            document.getElementById("rack-almacen-actual").textContent = res.camara;
            document.getElementById("txt-buscar-rack").value = "";
            document.getElementById("rack-search-result").textContent = "Sin búsqueda";
            setTimeout(() => {
                try {
                    if (typeof THREE === "undefined" || typeof THREE.OrbitControls === "undefined") { alert("No se pudo cargar la vista 3D (revisa la conexión a internet)."); return; }
                    iniciarRackThree();
                    renderRackThree();
                    document.getElementById("txt-buscar-rack").focus();
                } catch (err) { console.error(err); alert("Error iniciando la vista 3D: " + err.message); }
            }, 80);
        }

        function liberarObjeto(obj) {
            if (obj.geometry) obj.geometry.dispose();
            const mats = Array.isArray(obj.material) ? obj.material : (obj.material ? [obj.material] : []);
            mats.forEach(m => { if (m.map) m.map.dispose(); m.dispose && m.dispose(); });
        }

        function cerrarRack3D() {
            document.getElementById("modal-rack3d").classList.remove("show");
            if (rackAnimationId) { cancelAnimationFrame(rackAnimationId); rackAnimationId = null; }
            // CORRECCIÓN: se libera la memoria de la escena (antes cada apertura dejaba geometrías y texturas vivas)
            if (rackScene) { rackScene.traverse(liberarObjeto); rackScene = null; }
            rackControls?.dispose?.(); rackControls = null;
            if (rackRenderer) { rackRenderer.dispose(); rackRenderer = null; }
            rackObjects = []; rackItemsIndex = [];
            window.removeEventListener("resize", resizeRackThree);
            const cont = document.getElementById("rack3d-canvas");
            if (cont) cont.innerHTML = "";
            document.getElementById("btn-rack3d")?.focus();
        }

        function agregarPisoYGrid() {
            rackScene.add(new THREE.GridHelper(90, 90, 0x888888, 0xb5b5b5));
            const floor = new THREE.Mesh(new THREE.BoxGeometry(80, 0.2, 55), new THREE.MeshStandardMaterial({ color: 0xbfbfbf }));
            floor.position.set(18, -0.12, 12);
            floor.receiveShadow = true;
            rackScene.add(floor);
        }

        function iniciarRackThree() {
            const cont = document.getElementById("rack3d-canvas");
            cont.innerHTML = "";
            rackScene = new THREE.Scene();
            rackScene.background = new THREE.Color(0xd9d9d9);
            rackCamera = new THREE.PerspectiveCamera(45, cont.clientWidth / cont.clientHeight, 0.1, 2000);
            rackCamera.position.set(28, 24, 34);
            rackRenderer = new THREE.WebGLRenderer({ antialias: true });
            rackRenderer.setSize(cont.clientWidth, cont.clientHeight);
            rackRenderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
            rackRenderer.shadowMap.enabled = true;
            cont.appendChild(rackRenderer.domElement);
            cont.insertAdjacentHTML('beforeend', `<div class="rack-leyenda"><span><i style="background:#22c55e"></i>≤ ${DIAS_RACK.verde} días</span><span><i style="background:#facc15"></i>≤ ${DIAS_RACK.amarillo}</span><span><i style="background:#ef4444"></i>más de ${DIAS_RACK.amarillo}</span><span><i style="background:#ffeb3b;outline:1px solid #b8a400"></i>seleccionada</span></div>`);
            rackControls = new THREE.OrbitControls(rackCamera, rackRenderer.domElement);
            rackControls.enableDamping = true;
            rackControls.dampingFactor = 0.08;
            rackControls.target.set(10, 3, 8);
            rackRaycaster = new THREE.Raycaster();
            rackMouse = new THREE.Vector2();
            rackScene.add(new THREE.AmbientLight(0xffffff, 0.7));
            const dir = new THREE.DirectionalLight(0xffffff, 1.1);
            dir.position.set(20, 40, 30);
            dir.castShadow = true;
            rackScene.add(dir);
            agregarPisoYGrid();
            rackRenderer.domElement.addEventListener("click", onRackClick);
            window.removeEventListener("resize", resizeRackThree);
            window.addEventListener("resize", resizeRackThree);
            animateRackThree();
        }

        function limpiarEscenaRack() {
            if (!rackScene) return;
            rackScene.children.slice().forEach(obj => {
                if (obj.type === "AmbientLight" || obj.type === "DirectionalLight") return;
                rackScene.remove(obj);
                liberarObjeto(obj);
            });
            rackObjects = []; rackItemsIndex = [];
            agregarPisoYGrid();
        }

        function renderRackThree() {
            rackObjects = [];
            const subtitle = document.getElementById("rack-subtitle");
            const items = (datosTraz || []).map(x => {
                const ubic = getVal(x, "Ubic", "ubic");
                return {
                    raw: x, parsed: parseUbicacionRack(ubic), ubic,
                    sku: getVal(x, "Sku", "sku"), producto: getVal(x, "Producto", "producto"),
                    etiquetacion: getVal(x, "Etiquetacion", "etiquetacion") || "-",
                    kg: Number(getVal(x, "Kg", "kg") || 0), fecha: getVal(x, "Fecha", "fecha"),
                    diasInv: diasInventario(getVal(x, "Fecha", "fecha")),
                    cajas: Number(getVal(x, "Cantidad", "cantidad") || 1),
                    lote: getVal(x, "Lote", "lote"), tarima: getVal(x, "Tar", "tar"), codigo: getVal(x, "CodigoEtiqueta", "codigoEtiqueta")
                };
            });
            const validos = items.filter(x => x.parsed);
            const sinUbic = items.length - validos.length;
            if (!validos.length) {
                subtitle.textContent = "No hay ubicaciones con formato de rack (ej. R2-02A).";
                document.getElementById("rack-info-content").innerHTML = "Formato esperado de ubicación: <b>R2-02A</b> (rack 2, posición 02, altura A).";
                return;
            }
            const agrupado = {};
            validos.forEach(item => {
                const key = `${item.parsed.rack}-${item.parsed.posicion}-${item.parsed.altura}`;
                if (!agrupado[key]) agrupado[key] = { ...item, cajasTotal: 0, kgTotal: 0, productos: [], diasMax: 0 };
                agrupado[key].cajasTotal += item.cajas || 1;
                agrupado[key].kgTotal += item.kg || 0;
                agrupado[key].productos.push(item);
                agrupado[key].diasMax = Math.max(agrupado[key].diasMax, item.diasInv || 0);
            });
            const ubicaciones = Object.values(agrupado);
            rackItemsIndex = ubicaciones;
            // Se informa cuántas cajas no se pueden dibujar por no tener ubicación de rack
            subtitle.textContent = `${ubicaciones.length} posiciones · ${validos.length} etiquetas${sinUbic ? ` · ${sinUbic} sin ubicación de rack (no se dibujan)` : ''}`;
            const racks = [...new Set(ubicaciones.map(x => x.parsed.rack))].sort((a, b) => a - b);
            rackIndexMap = {};
            racks.forEach((r, i) => rackIndexMap[r] = i);
            const maxPos = Math.max(8, ...ubicaciones.map(x => x.parsed.posicion));
            const maxAltura = Math.max(4, ...ubicaciones.map(x => alturaToIndex(x.parsed.altura) + 1));
            racks.forEach((rack, i) => crearRackFisico(rack, i, maxPos, maxAltura));
            ubicaciones.forEach(crearTarima);
            if (rackObjects[0]) seleccionarRackObject(rackObjects[0]);
        }

        function crearRackFisico(rack, rackIndex, maxPos, maxAltura) {
            const rackGap = 7, posGap = 2.1, levelGap = 1.7, zBase = rackIndex * rackGap;
            const blueMat = new THREE.MeshStandardMaterial({ color: 0x003399, metalness: 0.2, roughness: 0.45 });
            const beamMat = new THREE.MeshStandardMaterial({ color: 0xd71920, metalness: 0.25, roughness: 0.4 });
            for (let p = 1; p <= maxPos + 1; p++) {
                const x = p * posGap;
                const postGeo = new THREE.BoxGeometry(0.12, maxAltura * levelGap + 0.8, 0.12);
                [zBase, zBase + 1.7].forEach(z => { const post = new THREE.Mesh(postGeo, blueMat); post.position.set(x, (maxAltura * levelGap) / 2, z); post.castShadow = true; rackScene.add(post); });
            }
            for (let h = 0; h <= maxAltura; h++) {
                for (let p = 1; p <= maxPos; p++) {
                    const beamGeo = new THREE.BoxGeometry(posGap, 0.12, 0.12);
                    [zBase, zBase + 1.7].forEach(z => { const b = new THREE.Mesh(beamGeo, beamMat); b.position.set(p * posGap + posGap / 2, h * levelGap, z); b.castShadow = true; rackScene.add(b); });
                }
            }
            for (let p = 1; p <= maxPos; p++) crearTextoPosicion(String(p).padStart(2, "0"), p * posGap + posGap / 2, -0.45, zBase + 0.85);
            for (let h = 0; h < maxAltura; h++) crearTextoAltura("ABCDEFG"[h] || String(h + 1), 0.45, h * levelGap + 0.55, zBase - 0.35);
            crearLetreroRack(`RACK ${rack}`, 0.5, maxAltura * levelGap + 1.3, zBase + 0.85);
        }

        function crearTarima(item) {
            const rackGap = 7, posGap = 2.1, levelGap = 1.7;
            const x = item.parsed.posicion * posGap + posGap / 2;
            const y = alturaToIndex(item.parsed.altura) * levelGap + 0.45;
            const z = (rackIndexMap[item.parsed.rack] ?? 0) * rackGap + 0.85;
            const pallet = new THREE.Mesh(new THREE.BoxGeometry(1.45, 0.18, 1.2), new THREE.MeshStandardMaterial({ color: 0x8b5a1f, roughness: 0.6 }));
            pallet.position.set(x, y - 0.25, z);
            pallet.castShadow = true; pallet.receiveShadow = true;
            rackScene.add(pallet);
            const boxMat = new THREE.MeshStandardMaterial({ color: colorSemaforoPorDias(item.diasMax || 0), roughness: 0.55 });
            const cajasVisuales = Math.max(1, Math.min(8, item.cajasTotal || 1));
            const cols = cajasVisuales >= 4 ? 2 : 1, rows = Math.ceil(cajasVisuales / cols);
            let count = 0;
            for (let r = 0; r < rows; r++) for (let c = 0; c < cols; c++) {
                if (count >= cajasVisuales) break;
                const box = new THREE.Mesh(new THREE.BoxGeometry(0.58, 0.45, 0.48), boxMat);
                box.position.set(x + (c - (cols - 1) / 2) * 0.62, y + r * 0.47, z);
                box.castShadow = true; box.receiveShadow = true;
                box.userData.item = item;
                rackScene.add(box);
                rackObjects.push(box);
                count++;
            }
            crearTextoSprite(item.sku, x, y + rows * 0.55, z, 1.5, 0.38, item);
        }

        function spriteDeCanvas(w, h, dibujar, opciones = {}) {
            const canvas = document.createElement("canvas");
            canvas.width = w; canvas.height = h;
            dibujar(canvas.getContext("2d"));
            const sprite = new THREE.Sprite(new THREE.SpriteMaterial({ map: new THREE.CanvasTexture(canvas), transparent: true, depthTest: opciones.depthTest !== false }));
            if (opciones.renderOrder) sprite.renderOrder = opciones.renderOrder;
            return sprite;
        }
        function crearTextoSprite(texto, x, y, z, sx, sy, item = null) {
            const s = spriteDeCanvas(256, 64, ctx => {
                ctx.fillStyle = "rgba(255,255,255,0.92)"; ctx.fillRect(0, 0, 256, 64);
                ctx.fillStyle = "#000"; ctx.font = "bold 28px Arial"; ctx.textAlign = "center"; ctx.textBaseline = "middle";
                ctx.fillText(String(texto || "-"), 128, 32);
            });
            s.position.set(x, y + 0.5, z); s.scale.set(sx, sy, 1);
            if (item) s.userData.item = item;
            rackScene.add(s);
        }
        function crearLetreroRack(texto, x, y, z) {
            const s = spriteDeCanvas(512, 160, ctx => {
                ctx.fillStyle = "rgba(255,255,255,0.95)"; ctx.fillRect(0, 0, 512, 160);
                ctx.strokeStyle = "#003399"; ctx.lineWidth = 10; ctx.strokeRect(5, 5, 502, 150);
                ctx.fillStyle = "#003399"; ctx.font = "bold 72px Arial"; ctx.textAlign = "center"; ctx.textBaseline = "middle";
                ctx.fillText(String(texto || "-"), 256, 80);
            }, { depthTest: false, renderOrder: 999 });
            s.position.set(x, y, z); s.scale.set(4.5, 1.4, 1);
            rackScene.add(s);
        }
        function crearTextoPosicion(texto, x, y, z) {
            const s = spriteDeCanvas(160, 80, ctx => {
                ctx.fillStyle = "rgba(255,255,255,0.95)"; ctx.fillRect(0, 0, 160, 80);
                ctx.strokeStyle = "#333"; ctx.lineWidth = 5; ctx.strokeRect(4, 4, 152, 72);
                ctx.fillStyle = "#111"; ctx.font = "bold 44px Arial"; ctx.textAlign = "center"; ctx.textBaseline = "middle";
                ctx.fillText(String(texto), 80, 40);
            }, { depthTest: false, renderOrder: 1000 });
            s.position.set(x, y, z); s.scale.set(0.85, 0.42, 1);
            rackScene.add(s);
        }
        function crearTextoAltura(texto, x, y, z) {
            const s = spriteDeCanvas(120, 120, ctx => {
                ctx.fillStyle = "rgba(255,255,255,0.95)"; ctx.fillRect(0, 0, 120, 120);
                ctx.strokeStyle = "#003399"; ctx.lineWidth = 6; ctx.strokeRect(4, 4, 112, 112);
                ctx.fillStyle = "#003399"; ctx.font = "bold 64px Arial"; ctx.textAlign = "center"; ctx.textBaseline = "middle";
                ctx.fillText(String(texto), 60, 60);
            }, { depthTest: false, renderOrder: 1000 });
            s.position.set(x, y, z); s.scale.set(0.65, 0.65, 1);
            rackScene.add(s);
        }

        function onRackClick(event) {
            const rect = rackRenderer.domElement.getBoundingClientRect();
            rackMouse.x = ((event.clientX - rect.left) / rect.width) * 2 - 1;
            rackMouse.y = -((event.clientY - rect.top) / rect.height) * 2 + 1;
            rackRaycaster.setFromCamera(rackMouse, rackCamera);
            const hits = rackRaycaster.intersectObjects(rackObjects, false);
            if (hits.length) seleccionarRackObject(hits[0].object);
        }
        function seleccionarRackObject(obj) {
            // Las cajas de una tarima comparten material; se restaura el color de todas antes de marcar.
            rackObjects.forEach(o => o.material.color.set(colorSemaforoPorDias(o.userData.item?.diasMax || 0)));
            obj.material.color.set(0xffeb3b);
            if (obj.userData.item) mostrarInfoRackAgrupado(obj.userData.item);
        }

        function buscarEnRack3D() {
            const q = document.getElementById("txt-buscar-rack").value.trim().toUpperCase();
            if (!q) { document.getElementById("rack-search-result").textContent = "Escribe un SKU, código, tarima o ubicación"; return; }
            const filtrados = datosTrazOriginal.filter(x => [getVal(x, "Sku", "sku"), getVal(x, "CodigoEtiqueta", "codigoEtiqueta"), getVal(x, "Tar", "tar"), getVal(x, "Ubic", "ubic")].some(v => String(v || "").toUpperCase() === q));
            if (!filtrados.length) { document.getElementById("rack-search-result").textContent = `“${q}” no está en esta cámara`; return; }
            datosTraz = filtrados;
            limpiarEscenaRack();
            renderRackThree();
            calcularKpisCamara(datosTraz);
            const primerObjeto = rackObjects[0];
            if (primerObjeto) { primerObjeto.material.color.set(0xff00ff); enfocarCajaBuscada(primerObjeto); }
            const primero = filtrados[0];
            const skuBuscado = String(getVal(primero, "Sku", "sku") || "").toUpperCase();
            const codigoBuscado = String(getVal(primero, "CodigoEtiqueta", "codigoEtiqueta") || "").toUpperCase();
            if (q === skuBuscado && q !== codigoBuscado) mostrarResumenFiltroSku(filtrados, q);
            else if (rackItemsIndex[0]) mostrarInfoRackDetalle(rackItemsIndex[0], rackItemsIndex[0].productos[0], q);
            document.getElementById("rack-search-result").textContent = `${filtrados.length} etiqueta(s) · ${getVal(primero, "Sku", "sku")} · ${getVal(primero, "Ubic", "ubic") || 'sin ubicación'}`;
        }

        const fila = (t, v) => `<div class="rack-info-row"><b>${t}</b>${v}</div>`;
        function mostrarResumenFiltroSku(rows, filtro) {
            const kg = rows.reduce((s, r) => s + Number(getVal(r, "Kg", "kg") || 0), 0);
            const dias = rows.map(r => diasInventario(getVal(r, "Fecha", "fecha")));
            const uniq = k => [...new Set(rows.map(r => getVal(r, k, k.toLowerCase())).filter(Boolean))];
            document.getElementById("rack-info-content").innerHTML =
                fila("Filtro SKU", esc(filtro)) + fila("Producto", esc(getVal(rows[0], "Producto", "producto") || "-")) +
                fila("Etiquetación", esc(uniq("Etiquetacion").join(" / ") || "-")) + fila("Cajas / etiquetas", nf.format(rows.length)) +
                fila("Kg totales", nfK.format(kg) + " kg") + fila("Días promedio en inventario", nf.format(dias.length ? Math.round(dias.reduce((s, d) => s + d, 0) / dias.length) : 0) + " días") +
                fila("Ubicaciones", nf.format(uniq("Ubic").length)) + fila("Tarimas", nf.format(uniq("Tar").length)) + fila("Lotes", esc(uniq("Lote").join(" / ") || "-"));
        }
        function mostrarInfoRackDetalle(item, d, filtro) {
            const p = item.parsed;
            document.getElementById("rack-info-content").innerHTML =
                fila("Buscado", esc(filtro)) + fila("Ubicación", `${esc(item.ubic)} · rack ${p.rack}, posición ${p.posicion}, altura ${p.altura}`) +
                fila("Código etiqueta", esc(d.codigo || "-")) + fila("SKU", esc(d.sku || "-")) + fila("Producto", esc(d.producto || "-")) +
                fila("Etiquetación", esc(d.etiquetacion || "-")) + fila("Kg de la etiqueta", nfK.format(Number(d.kg || 0)) + " kg") +
                fila("Días en inventario", nf.format(d.diasInv || 0) + " días") + fila("Tarima", esc(d.tarima || "-")) + fila("Lote", esc(d.lote || "-"));
        }
        function mostrarInfoRackAgrupado(item) {
            const p = item.parsed;
            const u = k => [...new Set(item.productos.map(x => x[k]).filter(Boolean))].join(" / ") || "-";
            document.getElementById("rack-info-content").innerHTML =
                fila("Ubicación", `${esc(item.ubic)} · rack ${p.rack}, posición ${p.posicion}, altura ${p.altura}`) +
                fila("SKU", esc(u("sku"))) + fila("Producto", esc(u("producto"))) + fila("Cajas en la ubicación", nf.format(item.cajasTotal)) +
                fila("Kg en la ubicación", nfK.format(item.kgTotal) + " kg") + fila("Días en inventario (máx.)", nf.format(item.diasMax || 0) + " días") +
                fila("Tarima", esc(u("tarima"))) + fila("Lote", esc(u("lote"))) + fila("Etiquetas", nf.format(item.productos.length));
        }
        function enfocarCajaBuscada(obj) {
            if (!obj || !rackCamera || !rackControls) return;
            const pos = obj.position.clone();
            rackControls.target.set(pos.x, pos.y + 0.6, pos.z);
            rackCamera.position.set(pos.x + 10, pos.y + 4, pos.z + 10);
            rackCamera.far = 3000;
            rackCamera.updateProjectionMatrix();
            rackControls.update();
        }

        // KPIs del rack: mismas fórmulas; los estimados quedan marcados "EST." en pantalla.
        function calcularKpisCamara(rows) {
            rows = rows || [];
            const totalKg = rows.reduce((s, r) => s + Number(getVal(r, "Kg", "kg") || 0), 0);
            const posiciones = new Set(rows.map(r => String(getVal(r, "Ubic", "ubic") || "").trim()).filter(x => x && x !== "-")).size;
            const CAPACIDAD_POSICIONES = 160; // supuesto fijo (5 racks × 8 posiciones × 4 alturas)
            const COSTO_KG_SUPUESTO = 80;     // supuesto fijo, no viene del sistema
            const dias = rows.map(r => getVal(r, "Fecha", "fecha")).filter(Boolean).map(diasInventario);
            const diasProm = dias.length ? Math.round(dias.reduce((s, d) => s + d, 0) / dias.length) : 0;
            const porSku = {};
            rows.forEach(r => { const s = getVal(r, "Sku", "sku") || "-"; porSku[s] = (porSku[s] || 0) + 1; });
            const set = (id, v) => document.getElementById(id).textContent = v;
            set("kpi-capacidad", nf.format(Math.round(posiciones / CAPACIDAD_POSICIONES * 100)) + "%");
            set("kpi-valor", "$" + nf.format(totalKg * COSTO_KG_SUPUESTO));
            set("kpi-rotacion", nfP.format(diasProm > 0 ? 365 / diasProm : 0));
            set("kpi-dos", nf.format(diasProm));
            set("kpi-reorden", nf.format(Object.keys(porSku).filter(s => porSku[s] <= 10).length));
            set("kpi-criticos", nf.format(rows.filter(r => diasInventario(getVal(r, "Fecha", "fecha")) >= DIAS_CRITICO).length));
        }

        function resizeRackThree() {
            const cont = document.getElementById("rack3d-canvas");
            if (!rackRenderer || !rackCamera || !cont) return;
            rackCamera.aspect = cont.clientWidth / cont.clientHeight;
            rackCamera.updateProjectionMatrix();
            rackRenderer.setSize(cont.clientWidth, cont.clientHeight);
        }
        function animateRackThree() {
            rackAnimationId = requestAnimationFrame(animateRackThree);
            rackControls?.update();
            if (rackRenderer && rackScene && rackCamera) rackRenderer.render(rackScene, rackCamera);
        }

        /* ======================= Eventos ======================= */
        function elegirCamara(cam, multiple) {
            if (multiple) { camarasSeleccionadas.has(cam) ? camarasSeleccionadas.delete(cam) : camarasSeleccionadas.add(cam); }
            else { camarasSeleccionadas.clear(); camarasSeleccionadas.add(cam); }
            camaraActual = camarasSeleccionadas.size === 1 ? [...camarasSeleccionadas][0] : null;
            renderSidebar();
            cargarInventario();
        }
        document.getElementById("sidebar-list").addEventListener("click", e => {
            const item = e.target.closest(".cam-item[data-cam]");
            if (item) elegirCamara(item.dataset.cam, e.ctrlKey || e.metaKey);
        });
        document.getElementById("sidebar-list").addEventListener("keydown", e => {
            const item = e.target.closest(".cam-item[data-cam]");
            if (item && (e.key === "Enter" || e.key === " ")) { e.preventDefault(); elegirCamara(item.dataset.cam, e.ctrlKey || e.metaKey); }
        });

        function seleccionarFilaInv(tr) {
            if (!tr || !tr.dataset.idx) return;
            document.querySelectorAll("#tbody-inv tr").forEach(x => x.classList.remove("row-sel"));
            tr.classList.add("row-sel");
            cargarTrazabilidad(datosInv[Number(tr.dataset.idx)]);
        }
        document.getElementById("tbody-inv").addEventListener("click", e => seleccionarFilaInv(e.target.closest("tr")));
        document.getElementById("tbody-inv").addEventListener("keydown", e => { if (e.key === "Enter") seleccionarFilaInv(e.target.closest("tr")); });

        document.querySelectorAll(".btn-planta").forEach(btn => {
            btn.addEventListener("click", async () => {
                if (btn.classList.contains("active")) return;
                document.querySelectorAll(".btn-planta").forEach(x => { x.classList.remove("active"); x.setAttribute('aria-pressed', 'false'); });
                btn.classList.add("active"); btn.setAttribute('aria-pressed', 'true');
                plantaActual = btn.dataset.planta;
                camaraActual = null;
                camarasSeleccionadas.clear();
                datosInv = []; datosTraz = []; datosTrazOriginal = [];
                _invSeq++; _trazSeq++;
                await Promise.all([cargarCamarasPorPlanta(), cargarEtiquetacionesFiltro()]);
                renderInventario([]); renderTrazabilidad([]);
            });
        });

        document.getElementById("btn-buscar").addEventListener("click", cargarInventario);
        document.getElementById("ddl-etiquetacion")?.addEventListener("change", cargarInventario);
        ["txt-sku", "txt-producto"].forEach(id => document.getElementById(id)?.addEventListener("keydown", e => { if (e.key === "Enter") cargarInventario(); }));

        const inpEtq = document.getElementById("txt-etiquetacion-buscar");
        inpEtq?.addEventListener("focus", () => abrirComboEtiquetacion(true));
        inpEtq?.addEventListener("click", () => abrirComboEtiquetacion(false));
        inpEtq?.addEventListener("input", function() { document.getElementById("cmb-etiquetacion")?.classList.add("open"); renderListaEtiquetaciones(this.value); });
        inpEtq?.addEventListener("keydown", function(e) {
            if (e.key === "ArrowDown" || e.key === "ArrowUp") { e.preventDefault(); document.getElementById("cmb-etiquetacion")?.classList.add("open"); moverActivoEtiquetacion(e.key === "ArrowDown" ? 1 : -1); return; }
            if (e.key === "Enter") { e.preventDefault(); (document.querySelector("#lst-etiquetacion .etq-combo-item.activo-busqueda") || document.querySelector("#lst-etiquetacion .etq-combo-item"))?.click(); return; }
            if (e.key === "Escape") { cerrarComboEtiquetacion(); this.value = obtenerNombreEtiquetacionSeleccionada(); }
        });
        document.getElementById("btn-etiquetacion-abrir")?.addEventListener("click", e => {
            e.preventDefault();
            document.getElementById("cmb-etiquetacion")?.classList.contains("open") ? cerrarComboEtiquetacion() : abrirComboEtiquetacion(true);
        });
        document.getElementById("lst-etiquetacion")?.addEventListener("click", e => {
            const item = e.target.closest(".etq-combo-item");
            if (!item) return;
            const id = String(item.dataset.etqId || "").trim();
            seleccionarEtiquetacion(id, id ? (etiquetacionesFiltroCache.find(x => String(x.id) === id)?.nombre || item.innerText.trim()) : "Todas las etiquetaciones", true);
        });
        document.addEventListener("click", e => {
            const combo = document.getElementById("cmb-etiquetacion");
            if (combo && combo.classList.contains("open") && !combo.contains(e.target)) {
                cerrarComboEtiquetacion();
                if (inpEtq) inpEtq.value = obtenerNombreEtiquetacionSeleccionada();
            }
        });

        document.getElementById("btn-excel").addEventListener("click", exportarExcel);
        document.getElementById("btn-total-camara").addEventListener("click", cargarTotalCamara);
        document.getElementById("btn-rack3d").addEventListener("click", abrirRack3D);
        document.getElementById("btn-close-rack").addEventListener("click", cerrarRack3D);
        document.getElementById("btn-buscar-rack").addEventListener("click", buscarEnRack3D);
        document.getElementById("txt-buscar-rack").addEventListener("keydown", e => { if (e.key === "Enter") buscarEnRack3D(); });
        document.getElementById("btn-limpiar-rack").addEventListener("click", () => {
            datosTraz = datosTrazOriginal;
            document.getElementById("txt-buscar-rack").value = "";
            document.getElementById("rack-search-result").textContent = "Sin búsqueda";
            limpiarEscenaRack(); renderRackThree(); calcularKpisCamara(datosTraz);
        });
        document.getElementById("modal-rack3d").addEventListener("click", e => { if (e.target.id === "modal-rack3d") cerrarRack3D(); });
        // CORRECCIÓN: Esc cierra la vista 3D
        document.addEventListener("keydown", e => { if (e.key === "Escape" && document.getElementById("modal-rack3d").classList.contains("show")) cerrarRack3D(); });

        document.querySelectorAll("#tbl-inv th[data-col]").forEach(th => th.addEventListener("click", function() { ordenarInventario(this.dataset.col); }));
        document.querySelectorAll("#tbl-traz th[data-col-traz]").forEach(th => th.addEventListener("click", function() { ordenarTrazabilidad(this.dataset.colTraz); }));

        // Antes estaban en onclick="" del HTML; se conservan los nombres globales por compatibilidad.
        window.seleccionarTodas = function() {
            if (!PLANTAS[plantaActual].camaras.length) return;
            camarasSeleccionadas = new Set(PLANTAS[plantaActual].camaras);
            camaraActual = null;
            renderSidebar();
            cargarInventario();
        };
        window.limpiarSeleccion = function() {
            camarasSeleccionadas.clear();
            camaraActual = null;
            datosInv = []; datosTraz = []; datosTrazOriginal = [];
            _invSeq++; _trazSeq++;
            renderSidebar(); renderInventario([]); renderTrazabilidad([]);
        };
        document.getElementById("btn-cam-todas").addEventListener("click", window.seleccionarTodas);
        document.getElementById("btn-cam-limpiar").addEventListener("click", window.limpiarSeleccion);

        // Al abrir solo se cargan catálogos; el inventario se consulta al elegir cámara o etiquetación.
        Promise.all([cargarCamarasPorPlanta(), cargarEtiquetacionesFiltro()]).then(() => {
            datosInv = []; datosTraz = []; datosTrazOriginal = [];
            renderInventario([]); renderTrazabilidad([]);
        });

        /* ======================= Copiar tablas con clic derecho ======================= */
        // Clic derecho sobre el inventario o el detalle: copia la tabla, el renglón o la celda
        // en un formato que Excel pega directo en celdas (columnas separadas por tabulador).
        // Los números se copian sin separador de miles para que Excel los tome como número.
        (function() {
            const menu = document.getElementById("ipCtxMenu");
            const toast = document.getElementById("ipToast");
            let ctx = null; // { tabla, fila, celda }

            const textoCelda = td => {
                let t = (td.innerText || "").replace(/\s+/g, " ").trim();
                if (td.classList.contains("text-end") || /^-?[\d,]+(\.\d+)?$/.test(t)) {
                    const n = t.replace(/,/g, "");
                    if (n !== "" && !isNaN(Number(n))) t = n;
                }
                return t === "-" ? "" : t;
            };
            const encabezados = tabla => [...tabla.querySelectorAll("thead th")].map(th => (th.innerText || "").replace(/\s+/g, " ").trim());
            const filasDatos = tabla => [...tabla.querySelectorAll("tbody tr")].filter(tr => !tr.classList.contains("t-msg") && tr.offsetParent !== null);
            const filaTexto = tr => [...tr.children].map(textoCelda);
            const aTsv = filas => filas.map(f => f.map(v => /[\t\n"]/.test(v) ? `"${v.replace(/"/g, '""')}"` : v).join("\t")).join("\r\n");
            const escH = v => String(v ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
            const aHtml = (filas, conEncabezado) => `<table>${filas.map((f, i) => `<tr>${f.map(v => (conEncabezado && i === 0) ? `<th>${escH(v)}</th>` : `<td>${escH(v)}</td>`).join("")}</tr>`).join("")}</table>`;

            function avisar(msg) {
                toast.textContent = msg;
                toast.classList.add("show");
                clearTimeout(avisar._t);
                avisar._t = setTimeout(() => toast.classList.remove("show"), 2200);
            }

            async function copiar(filas, conEncabezado, mensaje) {
                const tsv = aTsv(filas);
                try {
                    if (window.ClipboardItem && navigator.clipboard?.write) {
                        await navigator.clipboard.write([new ClipboardItem({
                            "text/plain": new Blob([tsv], { type: "text/plain" }),
                            "text/html": new Blob([aHtml(filas, conEncabezado)], { type: "text/html" })
                        })]);
                    } else if (navigator.clipboard?.writeText) {
                        await navigator.clipboard.writeText(tsv);
                    } else throw new Error("sin portapapeles");
                    avisar(mensaje);
                } catch {
                    // Respaldo para navegadores o conexiones sin permiso de portapapeles (http)
                    const ta = document.createElement("textarea");
                    ta.value = tsv;
                    ta.style.cssText = "position:fixed;left:-9999px;top:0";
                    document.body.appendChild(ta);
                    ta.select();
                    const ok = document.execCommand("copy");
                    ta.remove();
                    avisar(ok ? mensaje : "No se pudo copiar; usa Descargar en Excel.");
                }
            }

            function cerrar() {
                menu.classList.remove("show");
                document.querySelectorAll(".ctx-cell").forEach(x => x.classList.remove("ctx-cell"));
                ctx = null;
            }

            ["tbl-inv", "tbl-traz"].forEach(id => {
                const tabla = document.getElementById(id);
                tabla.addEventListener("contextmenu", e => {
                    const n = filasDatos(tabla).length;
                    if (!n) return; // sin datos: menú normal del navegador
                    e.preventDefault();
                    cerrar();
                    const td = e.target.closest("tbody td");
                    const tr = td?.closest("tr");
                    const valida = tr && !tr.classList.contains("t-msg");
                    ctx = { tabla, fila: valida ? tr : null, celda: valida ? td : null };
                    if (ctx.celda) ctx.celda.classList.add("ctx-cell");
                    menu.querySelector('[data-copiar="fila"]').hidden = !ctx.fila;
                    menu.querySelector('[data-copiar="celda"]').hidden = !ctx.celda;
                    document.getElementById("ipCtxFilas").textContent = `${n} renglón${n === 1 ? "" : "es"}`;
                    menu.classList.add("show");
                    const r = menu.getBoundingClientRect();
                    menu.style.left = Math.min(e.clientX, window.innerWidth - r.width - 8) + "px";
                    menu.style.top = Math.min(e.clientY, window.innerHeight - r.height - 8) + "px";
                    menu.querySelector("button:not([hidden])")?.focus();
                });
            });

            menu.addEventListener("click", async e => {
                const b = e.target.closest("button[data-copiar]");
                if (!b || !ctx) return;
                const { tabla, fila, celda } = ctx;
                const accion = b.dataset.copiar;
                cerrar();
                if (accion === "tabla") {
                    const filas = filasDatos(tabla).map(filaTexto);
                    await copiar([encabezados(tabla), ...filas], true, `Tabla copiada (${filas.length} renglones). Pégala en Excel con Ctrl+V.`);
                } else if (accion === "fila" && fila) {
                    await copiar([encabezados(tabla), filaTexto(fila)], true, "Renglón copiado con encabezados.");
                } else if (accion === "celda" && celda) {
                    await copiar([[textoCelda(celda)]], false, "Celda copiada.");
                } else if (accion === "excel") {
                    exportarExcel();
                }
            });

            document.addEventListener("click", e => { if (menu.classList.contains("show") && !menu.contains(e.target)) cerrar(); });
            document.addEventListener("keydown", e => {
                if (!menu.classList.contains("show")) return;
                if (e.key === "Escape") { e.preventDefault(); cerrar(); return; }
                if (e.key === "ArrowDown" || e.key === "ArrowUp") {
                    e.preventDefault();
                    const bs = [...menu.querySelectorAll("button:not([hidden])")];
                    const i = bs.indexOf(document.activeElement);
                    bs[(i + (e.key === "ArrowDown" ? 1 : -1) + bs.length) % bs.length]?.focus();
                }
            });
            ["scroll", "resize", "blur"].forEach(ev => window.addEventListener(ev, () => { if (menu.classList.contains("show")) cerrar(); }, true));
        })();
    </script>
}
