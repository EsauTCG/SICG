@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewBag.Title = "Inventario por Planta";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    /* =====================================================================
           INVENTARIO POR PLANTA · SIGO — hoja de estilos única
           Mismo sistema visual que el resto de módulos. Sustituye las capas
           anteriores y la hoja externa inventario-planta-erp-compacto-v6.css.
           ===================================================================== */
    :root {
        --es-tinto: #8d3e46;
        --es-tinto-deep: #5c2229;
        --es-tinto-soft: #f7eced;
        --es-tinto-line: #e8d3d6;
        --es-paper: #f6f4f4;
        --es-surface: #ffffff;
        --es-field: #ffffff;
        --es-head: #faf7f7;
        --es-hover: #fcf9f9;
        --es-row-line: #f0eaeb;
        --es-ink: #231a1c;
        --es-muted: #76686b;
        --es-line: #e6dfe0;
        --es-line-strong: #cfc4c6;
        --es-ok: #2f7a55;
        --es-ok-bg: #e7f3ec;
        --es-warn: #9a6410;
        --es-warn-bg: #fbf1de;
        --es-bad: #b42d2d;
        --es-bad-bg: #fbe9e8;
        --es-info: #2f5d86;
        --es-info-bg: #e9f0f7;
        --es-teal: #2b7a72;
        --es-neutral-bg: #efecec;
        --es-sel: #fff4c2;
        --es-sel-line: #d9b740;
        --es-accent-col: #fbf6ea;
        --es-font: "Poppins", "Segoe UI", system-ui, -apple-system, Arial, sans-serif;
    }

    body[data-theme="dark"] {
        --es-tinto: #c56b74;
        --es-tinto-deep: #7a2d36;
        --es-tinto-soft: #3a2427;
        --es-tinto-line: #5a3439;
        --es-paper: #16181c;
        --es-surface: #202328;
        --es-field: #181a1e;
        --es-head: #262a30;
        --es-hover: #2a2e34;
        --es-row-line: #30343b;
        --es-ink: #edf0f3;
        --es-muted: #a9b0b9;
        --es-line: #363b43;
        --es-line-strong: #4a5059;
        --es-ok: #6cc596;
        --es-ok-bg: #1d3328;
        --es-warn: #e0b061;
        --es-warn-bg: #3a2f1b;
        --es-bad: #f08a83;
        --es-bad-bg: #3d2223;
        --es-info: #8bb8e0;
        --es-info-bg: #1e2b38;
        --es-teal: #6cc5ba;
        --es-neutral-bg: #2c3036;
        --es-sel: #4a3f18;
        --es-sel-line: #a68a2a;
        --es-accent-col: #2a2a22;
    }

    .ipx, .ipx-modal {
        font-family: var(--es-font) !important;
        color: var(--es-ink);
        font-size: 13px;
        line-height: 1.4;
    }

        .ipx *, .ipx-modal * {
            box-sizing: border-box;
        }

        .ipx .bi, .ipx-modal .bi {
            font-family: "bootstrap-icons" !important;
        }

    .text-end {
        text-align: right !important;
        font-variant-numeric: tabular-nums;
    }

    .text-center {
        text-align: center !important;
    }

    /* Pantalla de trabajo de altura fija: las tablas se desplazan por dentro */
    .ipx {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 10px;
        height: calc(100dvh - 92px);
        min-height: 620px;
        padding: 14px 16px 8px;
        background: var(--es-paper);
        overflow: hidden;
        min-width: 0;
    }

    /* ---------- Encabezado ---------- */
    .ip-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        flex-wrap: wrap;
        flex: none;
    }

    .ip-header__title {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .ip-header__icon {
        width: 40px;
        height: 40px;
        flex: none;
        border-radius: 10px;
        display: grid;
        place-items: center;
        background: var(--es-tinto);
        color: #fff;
        font-size: 19px;
    }

    .ip-header h1 {
        margin: 0;
        font-size: 20px;
        font-weight: 700;
        letter-spacing: -.01em;
        line-height: 1.15;
        color: var(--es-ink);
    }

    .ip-header p {
        margin: 2px 0 0;
        font-size: 12px;
        color: var(--es-muted);
    }

    .planta-bar-inline {
        display: inline-flex;
        gap: 2px;
        padding: 3px;
        border-radius: 9px;
        background: var(--es-neutral-bg);
    }

    .btn-planta {
        height: 32px;
        padding: 0 16px;
        border: 0;
        border-radius: 7px;
        background: transparent;
        color: var(--es-muted);
        font: 600 12.5px/1 var(--es-font);
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .btn-planta:hover {
            color: var(--es-ink);
        }

        .btn-planta.active {
            background: var(--es-surface);
            color: var(--es-ink);
            box-shadow: 0 1px 3px rgba(0,0,0,.12);
        }

        .btn-planta:focus-visible {
            outline: 2px solid var(--es-tinto);
            outline-offset: 1px;
        }

    /* ---------- Botones ---------- */
    .btn-main, .btn-excel, .ip-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        height: 36px;
        padding: 0 14px;
        border: 1px solid var(--es-line-strong);
        border-radius: 7px;
        background: var(--es-field);
        color: var(--es-ink);
        font: 600 12.5px/1 var(--es-font);
        white-space: nowrap;
        cursor: pointer;
        transition: background .12s, border-color .12s, color .12s;
    }

        .btn-excel:hover, .ip-btn:hover {
            background: var(--es-tinto-soft);
            border-color: var(--es-tinto-line);
        }

    .btn-main {
        background: var(--es-tinto);
        border-color: var(--es-tinto);
        color: #fff;
    }

        .btn-main:hover {
            background: var(--es-tinto-deep);
            border-color: var(--es-tinto-deep);
        }

        .btn-main:focus-visible, .btn-excel:focus-visible, .ip-btn:focus-visible {
            outline: 2px solid var(--es-tinto);
            outline-offset: 2px;
        }

    .ip-btn-sm {
        height: 30px;
        padding: 0 10px;
        font-size: 12px;
        border-radius: 6px;
    }

    /* ---------- Filtros ---------- */
    .ip-card {
        background: var(--es-surface);
        border: 1px solid var(--es-line);
        border-radius: 10px;
        min-width: 0;
    }

    .ip-filters {
        flex: none;
        padding: 10px 14px;
    }

    .filters-one-line {
        display: grid;
        grid-template-columns: minmax(110px, .7fr) minmax(180px, 1.3fr) minmax(220px, 1.4fr) auto;
        gap: 10px;
        align-items: end;
    }

    .ipx .form-label {
        display: block;
        margin: 0 0 5px;
        font-size: 12px;
        font-weight: 600;
        color: var(--es-muted);
    }

    .ipx .form-control, #txt-etiquetacion-buscar, #txt-buscar-rack {
        width: 100%;
        height: 36px;
        padding: 0 10px;
        border: 1px solid var(--es-line-strong);
        border-radius: 7px;
        background: var(--es-field);
        color: var(--es-ink);
        font: 500 13px/1.2 var(--es-font);
        box-shadow: none;
        outline: none;
    }

        .ipx .form-control:focus, #txt-etiquetacion-buscar:focus, #txt-buscar-rack:focus {
            border-color: var(--es-tinto);
            box-shadow: 0 0 0 3px rgba(141,62,70,.16);
        }

    .filter-actions {
        display: flex;
        gap: 8px;
    }

    /* Selector de etiquetación con búsqueda */
    .etq-combo {
        position: relative;
        min-width: 0;
    }

    .etq-combo-row {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 36px;
    }

    #txt-etiquetacion-buscar {
        border-radius: 7px 0 0 7px;
        border-right: 0;
    }

    #btn-etiquetacion-abrir {
        height: 36px;
        border: 1px solid var(--es-line-strong);
        border-radius: 0 7px 7px 0;
        background: var(--es-field);
        color: var(--es-muted);
        cursor: pointer;
        display: grid;
        place-items: center;
    }

        #btn-etiquetacion-abrir:hover {
            background: var(--es-tinto-soft);
            color: var(--es-ink);
        }

    .etq-combo-list {
        display: none;
        position: absolute;
        left: 0;
        right: 0;
        top: calc(100% + 4px);
        z-index: 1050;
        max-height: 300px;
        overflow-y: auto;
        padding: 4px;
        border: 1px solid var(--es-line-strong);
        border-radius: 10px;
        background: var(--es-surface);
        box-shadow: 0 12px 30px rgba(0,0,0,.16);
    }

    .etq-combo.open .etq-combo-list {
        display: block;
    }

    .etq-combo-item {
        width: 100%;
        min-height: 32px;
        padding: 6px 9px;
        border: 0;
        border-radius: 6px;
        background: transparent;
        color: var(--es-ink);
        text-align: left;
        font: 500 12.5px/1.3 var(--es-font);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
    }

        .etq-combo-item:hover, .etq-combo-item.activo-busqueda {
            background: var(--es-tinto-soft);
        }

        .etq-combo-item.seleccionado {
            font-weight: 700;
        }

        .etq-combo-item .etq-check {
            color: var(--es-ok);
        }

    .etq-combo-empty {
        padding: 12px;
        color: var(--es-muted);
        font-size: 12px;
        text-align: center;
    }

    #ddl-etiquetacion {
        display: none !important;
    }

    /* ---------- KPIs ---------- */
    .main-kpi-grid {
        flex: none;
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 10px;
    }

    .main-kpi-card {
        padding: 10px 14px;
        border-radius: 10px;
        background: var(--es-surface);
        border: 1px solid var(--es-line);
        border-top: 3px solid var(--k, var(--es-line-strong));
        min-width: 0;
    }

    .main-kpi-title {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 11.5px;
        font-weight: 600;
        color: var(--es-muted);
        letter-spacing: .02em;
    }

        .main-kpi-title i {
            color: var(--k);
        }

    .main-kpi-value {
        margin-top: 2px;
        font-size: clamp(17px, 1.4vw, 22px);
        font-weight: 700;
        color: var(--es-ink);
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .main-kpi-sub {
        font-size: 11px;
        color: var(--es-muted);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .kpi-main-camaras {
        --k: var(--es-tinto);
    }

    .kpi-main-skus {
        --k: var(--es-info);
    }

    .kpi-main-cajas {
        --k: var(--es-warn);
    }

    .kpi-main-kg {
        --k: var(--es-ok);
    }

    .kpi-main-prom {
        --k: var(--es-teal);
    }

    .kpi-main-alertas {
        --k: var(--es-muted);
    }

        .kpi-main-alertas.con-alerta {
            --k: var(--es-bad);
            background: var(--es-bad-bg);
        }

            .kpi-main-alertas.con-alerta .main-kpi-value {
                color: var(--es-bad);
            }

    /* ---------- Área de trabajo ---------- */
    .inv-layout {
        position: relative;
        flex: 1 1 auto;
        min-height: 0;
        display: grid;
        grid-template-columns: 180px minmax(0, 1fr);
        gap: 10px;
    }

    .sidebar {
        display: flex;
        flex-direction: column;
        min-height: 0;
        min-width: 0;
        background: var(--es-surface);
        border: 1px solid var(--es-line);
        border-radius: 10px;
        overflow: hidden;
    }

    .sidebar-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 12px;
        border-bottom: 1px solid var(--es-line);
        font-size: 13px;
        font-weight: 600;
    }

        .sidebar-title small {
            font-size: 11px;
            font-weight: 500;
            color: var(--es-muted);
        }

    .sidebar-list {
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
        padding: 4px;
    }

    .cam-item {
        padding: 7px 10px;
        margin-bottom: 1px;
        border-radius: 6px;
        font-size: 12.5px;
        font-weight: 500;
        color: var(--es-ink);
        cursor: pointer;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        user-select: none;
    }

        .cam-item:hover {
            background: var(--es-tinto-soft);
        }

        .cam-item.active {
            background: var(--es-tinto);
            color: #fff;
            font-weight: 600;
        }

        .cam-item.is-msg {
            color: var(--es-muted);
            cursor: default;
            background: none;
        }

        .cam-item:focus-visible {
            outline: 2px solid var(--es-tinto);
            outline-offset: -2px;
        }

    .sidebar-ayuda {
        padding: 6px 12px;
        font-size: 11px;
        color: var(--es-muted);
        border-top: 1px solid var(--es-line);
    }

    .sidebar-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6px;
        padding: 8px;
        border-top: 1px solid var(--es-line);
        background: var(--es-head);
    }

        .sidebar-actions button {
            height: 30px;
            padding: 0 6px;
            border: 1px solid var(--es-line-strong);
            border-radius: 6px;
            background: var(--es-field);
            color: var(--es-ink);
            font: 600 11.5px/1 var(--es-font);
            cursor: pointer;
        }

            .sidebar-actions button:hover {
                background: var(--es-tinto-soft);
            }

    .inv-right {
        display: flex;
        flex-direction: column;
        gap: 8px;
        min-height: 0;
        min-width: 0;
    }

    .totales-bar {
        flex: none;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        font-size: 12.5px;
        color: var(--es-muted);
    }

    .totales-text span {
        font-weight: 700;
        color: var(--es-ink);
        font-variant-numeric: tabular-nums;
    }

    #lbl-camara-activa {
        font-weight: 600;
        color: var(--es-tinto);
    }

    .traz-panel {
        position: relative;
        flex: 1 1 auto;
        min-height: 0;
        display: grid;
        grid-template-columns: minmax(360px, .8fr) minmax(460px, 1.2fr);
        gap: 10px;
    }

    .traz-left, .traz-right {
        display: flex;
        min-height: 0;
        min-width: 0;
    }

    .table-card {
        flex: 1 1 auto;
        display: flex;
        flex-direction: column;
        min-height: 0;
        min-width: 0;
        background: var(--es-surface);
        border: 1px solid var(--es-line);
        border-radius: 10px;
        overflow: hidden;
    }

    .table-card-head {
        flex: none;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        flex-wrap: wrap;
        padding: 8px 12px;
        border-bottom: 1px solid var(--es-line);
        font-size: 13px;
        font-weight: 600;
    }

        .table-card-head i {
            color: var(--es-tinto);
        }

        .table-card-head .acciones {
            display: flex;
            gap: 6px;
        }

    .table-responsive-sticky {
        flex: 1 1 auto;
        min-height: 0;
        overflow: auto;
    }

    #tbl-inv, #tbl-traz {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        font-size: 12.5px;
        color: var(--es-ink);
    }

    #tbl-inv {
        min-width: 760px;
    }

    #tbl-traz {
        min-width: 1500px;
    }

        #tbl-inv thead th, #tbl-traz thead th {
            position: sticky;
            top: 0;
            z-index: 2;
            padding: 8px 9px;
            background: var(--es-head);
            border-bottom: 1px solid var(--es-line);
            color: var(--es-muted);
            font-size: 11.5px;
            font-weight: 600;
            white-space: nowrap;
            text-align: left;
        }

            #tbl-inv thead th.text-end, #tbl-traz thead th.text-end {
                text-align: right;
            }

            #tbl-inv thead th[data-col], #tbl-traz thead th[data-col-traz] {
                cursor: pointer;
                user-select: none;
            }

                #tbl-inv thead th[data-col]:hover, #tbl-traz thead th[data-col-traz]:hover {
                    color: var(--es-ink);
                }

    .sort-ind {
        display: inline-block;
        width: 10px;
        margin-left: 3px;
        color: var(--es-tinto);
        font-size: 10px;
    }

    th.asc .sort-ind::after {
        content: "▲";
    }

    th.desc .sort-ind::after {
        content: "▼";
    }

    #tbl-inv tbody td, #tbl-traz tbody td {
        padding: 6px 9px;
        border-bottom: 1px solid var(--es-row-line);
        background: var(--es-surface);
        white-space: nowrap;
        vertical-align: middle;
    }

    #tbl-inv tbody tr:hover > td, #tbl-traz tbody tr:hover > td {
        background: var(--es-hover);
    }

    #tbl-inv tbody tr[data-idx] {
        cursor: pointer;
    }

    #tbl-inv tbody tr.row-sel > td {
        background: var(--es-sel) !important;
        box-shadow: inset 0 1px 0 var(--es-sel-line), inset 0 -1px 0 var(--es-sel-line);
    }

    #tbl-inv tbody td:nth-child(3), #tbl-traz tbody td:nth-child(5) {
        font-weight: 600;
    }

    #tbl-traz tbody td:nth-child(2), #tbl-traz tbody td:nth-child(6) {
        background: var(--es-accent-col);
    }

    #tbl-traz tbody td.dias-verde, #tbl-traz tbody td.dias-amarillo, #tbl-traz tbody td.dias-rojo {
        font-weight: 700;
    }

    #tbl-traz tbody td.dias-verde {
        background: var(--es-ok-bg) !important;
        color: var(--es-ok);
    }

    #tbl-traz tbody td.dias-amarillo {
        background: var(--es-warn-bg) !important;
        color: var(--es-warn);
    }

    #tbl-traz tbody td.dias-rojo {
        background: var(--es-bad-bg) !important;
        color: var(--es-bad);
    }

    .t-msg td {
        padding: 40px 12px !important;
        text-align: center;
        color: var(--es-muted);
        white-space: normal !important;
        background: var(--es-surface) !important;
        cursor: default;
    }

    .badge-activo, .badge-inactivo {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 2px 9px;
        border-radius: 999px;
        font-size: 11.5px;
        font-weight: 600;
    }

    .badge-activo {
        background: var(--es-ok-bg);
        color: var(--es-ok);
    }

    .badge-inactivo {
        background: var(--es-bad-bg);
        color: var(--es-bad);
    }

        .badge-activo::before, .badge-inactivo::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: currentColor;
        }

    /* Divisores para cambiar anchos */
    .inv-resize-overlay {
        position: absolute;
        top: 0;
        bottom: 0;
        width: 10px;
        margin-left: -5px;
        z-index: 5;
        cursor: col-resize;
        touch-action: none;
    }

        .inv-resize-overlay::after {
            content: "";
            position: absolute;
            top: 12px;
            bottom: 12px;
            left: 50%;
            width: 2px;
            transform: translateX(-50%);
            border-radius: 2px;
            background: transparent;
            transition: background .12s;
        }

        .inv-resize-overlay:hover::after, .inv-resize-overlay.is-resizing::after, .inv-resize-overlay:focus-visible::after {
            background: var(--es-tinto);
        }

        .inv-resize-overlay:focus-visible {
            outline: none;
        }

    body.inv-v6-resizing, body.inv-v6-resizing * {
        cursor: col-resize !important;
        user-select: none !important;
    }

    .statusbar {
        flex: none;
        display: flex;
        gap: 18px;
        flex-wrap: wrap;
        font-size: 11.5px;
        color: var(--es-muted);
    }

    /* Cargando */
    .inventario-loading-overlay {
        display: none;
        position: absolute;
        inset: 0;
        z-index: 60;
        align-items: center;
        justify-content: center;
        background: rgba(246,244,244,.65);
        cursor: wait;
    }

    body[data-theme="dark"] .inventario-loading-overlay {
        background: rgba(22,24,28,.7);
    }

    .inventario-loading-overlay.show {
        display: flex;
    }

    .inventario-loading-box {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
        padding: 18px 24px;
        border-radius: 12px;
        background: var(--es-surface);
        border: 1px solid var(--es-line);
        box-shadow: 0 12px 34px rgba(0,0,0,.16);
        font-weight: 600;
        font-size: 13px;
        color: var(--es-ink);
    }

    .inventario-spinner {
        width: 34px;
        height: 34px;
        border: 3px solid var(--es-tinto-line);
        border-top-color: var(--es-tinto);
        border-radius: 50%;
        animation: ip-spin .8s linear infinite;
    }

    @@keyframes ip-spin {
        to {
            transform: rotate(360deg);
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .inventario-spinner {
            animation-duration: 2s;
        }
    }

    /* ---------- Modal Rack 3D ---------- */
    .rack-modal {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 1060;
        align-items: center;
        justify-content: center;
        padding: 18px;
        background: rgba(22,24,28,.6);
    }

        .rack-modal.show {
            display: flex;
        }

    .rack-modal-box {
        width: min(1500px, 97vw);
        height: min(880px, 94vh);
        display: flex;
        flex-direction: column;
        border-radius: 12px;
        overflow: hidden;
        background: var(--es-surface);
        box-shadow: 0 24px 70px rgba(0,0,0,.45);
    }

    .rack-modal-head {
        flex: none;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 12px 16px;
        background: var(--es-tinto-deep);
        color: #fff;
    }

        .rack-modal-head strong {
            font-size: 15px;
            font-weight: 600;
        }

        .rack-modal-head span {
            display: block;
            font-size: 12px;
            opacity: .8;
        }

    .rack-close {
        width: 34px;
        height: 34px;
        border: 0;
        border-radius: 8px;
        background: rgba(255,255,255,.14);
        color: #fff;
        font-size: 20px;
        cursor: pointer;
        display: grid;
        place-items: center;
    }

        .rack-close:hover {
            background: rgba(255,255,255,.26);
        }

    .rack-search-bar {
        flex: none;
        display: grid;
        grid-template-columns: auto minmax(280px, 1fr) minmax(200px, auto);
        gap: 12px;
        align-items: center;
        padding: 10px 14px;
        border-bottom: 1px solid var(--es-line);
        font-size: 12.5px;
    }

        .rack-search-bar b {
            color: var(--es-muted);
            font-weight: 600;
        }

    .rack-search-box {
        display: flex;
        gap: 6px;
    }

    #rack-search-result {
        font-weight: 600;
        color: var(--es-tinto);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        text-align: right;
    }

    .rack-kpi-bar {
        flex: none;
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 8px;
        padding: 10px 14px;
        border-bottom: 1px solid var(--es-line);
        background: var(--es-paper);
    }

    .rack-kpi-card {
        padding: 8px 12px;
        border-radius: 8px;
        background: var(--es-surface);
        border: 1px solid var(--es-line);
        border-top: 3px solid var(--k, var(--es-line-strong));
        min-width: 0;
    }

    .rack-kpi-title {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 11px;
        font-weight: 600;
        color: var(--es-muted);
    }

        .rack-kpi-title .est {
            padding: 0 6px;
            border-radius: 999px;
            background: var(--es-warn-bg);
            color: var(--es-warn);
            font-size: 9.5px;
            font-weight: 700;
            letter-spacing: .03em;
        }

    .rack-kpi-value {
        font-size: 18px;
        font-weight: 700;
        color: var(--es-ink);
        font-variant-numeric: tabular-nums;
    }

    .rack-kpi-capacidad {
        --k: var(--es-tinto);
    }

    .rack-kpi-valor {
        --k: var(--es-ok);
    }

    .rack-kpi-rotacion {
        --k: var(--es-info);
    }

    .rack-kpi-dos {
        --k: var(--es-teal);
    }

    .rack-kpi-reorden {
        --k: var(--es-warn);
    }

    .rack-kpi-criticos {
        --k: var(--es-bad);
    }

    .rack3d-body {
        flex: 1 1 auto;
        display: grid;
        grid-template-columns: minmax(0, 1fr) 300px;
        min-height: 0;
    }

    #rack3d-canvas {
        position: relative;
        width: 100%;
        height: 100%;
        overflow: hidden;
        background: #d8d8d8;
    }

    .rack-leyenda {
        position: absolute;
        left: 12px;
        bottom: 12px;
        display: flex;
        gap: 10px;
        padding: 6px 10px;
        border-radius: 8px;
        background: rgba(255,255,255,.92);
        font: 600 11.5px var(--es-font);
        color: #231a1c;
        pointer-events: none;
    }

        .rack-leyenda span {
            display: inline-flex;
            align-items: center;
            gap: 5px;
        }

        .rack-leyenda i {
            width: 10px;
            height: 10px;
            border-radius: 2px;
            display: inline-block;
        }

    .rack-info {
        padding: 14px;
        overflow: auto;
        border-left: 1px solid var(--es-line);
        background: var(--es-surface);
    }

        .rack-info h4 {
            margin: 0 0 10px;
            font-size: 15px;
            font-weight: 600;
            color: var(--es-ink);
        }

    .rack-info-row {
        padding: 7px 0;
        border-bottom: 1px solid var(--es-row-line);
        font-size: 12.5px;
    }

        .rack-info-row b {
            display: block;
            margin-bottom: 1px;
            font-size: 11px;
            font-weight: 600;
            color: var(--es-muted);
        }

    /* ---------- Menú de clic derecho (copiar a Excel) ---------- */
    .ip-ctx {
        position: fixed;
        z-index: 1100;
        min-width: 230px;
        padding: 4px;
        border-radius: 10px;
        background: var(--es-surface);
        border: 1px solid var(--es-line-strong);
        box-shadow: 0 14px 34px rgba(0,0,0,.2);
        font-family: var(--es-font);
        display: none;
    }

        .ip-ctx.show {
            display: block;
        }

        .ip-ctx button {
            width: 100%;
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 8px 10px;
            border: 0;
            border-radius: 6px;
            background: transparent;
            color: var(--es-ink);
            font: 500 12.5px/1.2 var(--es-font);
            text-align: left;
            cursor: pointer;
        }

            .ip-ctx button:hover, .ip-ctx button:focus-visible {
                background: var(--es-tinto-soft);
                outline: none;
            }

            .ip-ctx button i {
                color: var(--es-tinto);
                width: 16px;
            }

            .ip-ctx button small {
                margin-left: auto;
                color: var(--es-muted);
                font-size: 11px;
            }

        .ip-ctx hr {
            margin: 4px 6px;
            border: 0;
            border-top: 1px solid var(--es-line);
        }

    .ip-toast {
        position: fixed;
        left: 50%;
        bottom: 24px;
        z-index: 1110;
        transform: translateX(-50%);
        padding: 9px 16px;
        border-radius: 999px;
        background: var(--es-ink);
        color: var(--es-surface);
        font: 600 12.5px var(--es-font);
        box-shadow: 0 8px 22px rgba(0,0,0,.25);
        opacity: 0;
        pointer-events: none;
        transition: opacity .18s;
    }

        .ip-toast.show {
            opacity: 1;
        }

    #tbl-inv tbody td.ctx-cell, #tbl-traz tbody td.ctx-cell {
        box-shadow: inset 0 0 0 2px var(--es-tinto);
    }

    @@media (max-width: 1400px) {
        .main-kpi-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .traz-panel {
            grid-template-columns: 1fr;
            grid-template-rows: minmax(220px, .9fr) minmax(260px, 1.1fr);
        }

        .inv-resize-overlay-tables {
            display: none;
        }
    }

    @@media (max-width: 1000px) {
        .ipx {
            height: auto;
            overflow: visible;
        }

        .filters-one-line {
            grid-template-columns: 1fr 1fr;
        }

        .inv-layout {
            grid-template-columns: 1fr;
        }

        .sidebar {
            max-height: 240px;
        }

        .traz-panel {
            grid-template-rows: 420px 460px;
        }

        .inv-resize-overlay {
            display: none;
        }

        .rack-search-bar, .rack3d-body {
            grid-template-columns: 1fr;
        }

        .rack-kpi-bar {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .rack-info {
            max-height: 200px;
            border-left: 0;
            border-top: 1px solid var(--es-line);
        }
    }

    @@media (max-width: 620px) {
        .filters-one-line, .main-kpi-grid {
            grid-template-columns: 1fr 1fr;
        }

        .rack-kpi-bar {
            grid-template-columns: 1fr 1fr;
        }
    }
</style>

