@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Planeación de inventario mínimo, ideal y máximo";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    /* =====================================================================
           INVENTARIO MÍNIMO · IDEAL · MÁXIMO · SIGO — hoja de estilos única
           Sustituye inventario-minmax-grid.css, inventario-minmax-erp-compacto-v2.css
           e inventario-minmax-color-fix.css. Ya no se necesita el script que movía
           la pantalla según el menú lateral: el layout se encarga del ancho.
           ===================================================================== */
    :root {
        --es-tinto: #8d3e46;
        --es-tinto-deep: #5c2229;
        --es-tinto-soft: #f7eced;
        --es-tinto-line: #e8d3d6;
        --es-paper: #f6f4f4;
        --es-surface: #ffffff;
        --es-field: #ffffff;
        --es-head: #faf7f7;
        --es-hover: #fcf9f9;
        --es-row-line: #f0eaeb;
        --es-ink: #231a1c;
        --es-muted: #76686b;
        --es-line: #e6dfe0;
        --es-line-strong: #cfc4c6;
        --es-ok: #2f7a55;
        --es-ok-bg: #e7f3ec;
        --es-warn: #9a6410;
        --es-warn-bg: #fbf1de;
        --es-bad: #b42d2d;
        --es-bad-bg: #fbe9e8;
        --es-info: #2f5d86;
        --es-info-bg: #e9f0f7;
        --es-neutral-bg: #efecec;
        --es-dark: #4a4245;
        --es-dark-bg: #e6e2e3;
        --es-font: "Poppins", "Segoe UI", system-ui, -apple-system, Arial, sans-serif;
        --mm-muted: var(--es-muted);
        --mm-brand: var(--es-tinto);
    }

    body[data-theme="dark"] {
        --es-tinto: #c56b74;
        --es-tinto-deep: #7a2d36;
        --es-tinto-soft: #3a2427;
        --es-tinto-line: #5a3439;
        --es-paper: #16181c;
        --es-surface: #202328;
        --es-field: #181a1e;
        --es-head: #262a30;
        --es-hover: #2a2e34;
        --es-row-line: #30343b;
        --es-ink: #edf0f3;
        --es-muted: #a9b0b9;
        --es-line: #363b43;
        --es-line-strong: #4a5059;
        --es-ok: #6cc596;
        --es-ok-bg: #1d3328;
        --es-warn: #e0b061;
        --es-warn-bg: #3a2f1b;
        --es-bad: #f08a83;
        --es-bad-bg: #3d2223;
        --es-info: #8bb8e0;
        --es-info-bg: #1e2b38;
        --es-neutral-bg: #2c3036;
        --es-dark: #c9c2c4;
        --es-dark-bg: #34383f;
    }

    .minmax-root, .mm-modal {
        font-family: var(--es-font) !important;
        color: var(--es-ink);
        font-size: 13px;
        line-height: 1.4;
    }

        .minmax-root *, .mm-modal * {
            box-sizing: border-box;
        }

        .minmax-root .bi, .mm-modal .bi {
            font-family: "bootstrap-icons" !important;
        }

    .num {
        text-align: right !important;
        font-variant-numeric: tabular-nums;
    }

    .minmax-root {
        background: var(--es-paper);
        padding: 14px 16px 10px;
        min-width: 0;
    }

    .minmax-shell {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    /* Encabezado */
    .minmax-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        flex-wrap: wrap;
    }

    .minmax-heading {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .minmax-heading-icon {
        width: 40px;
        height: 40px;
        flex: none;
        border-radius: 10px;
        display: grid;
        place-items: center;
        background: var(--es-tinto);
        color: #fff;
        font-size: 19px;
    }

    .minmax-title h1 {
        margin: 0;
        font-size: 20px;
        font-weight: 700;
        letter-spacing: -.01em;
        line-height: 1.15;
        color: var(--es-ink);
    }

    .minmax-title small {
        display: block;
        margin-top: 2px;
        font-size: 12px;
        color: var(--es-muted);
    }

    .minmax-live {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-size: 11.5px;
        color: var(--es-muted);
    }

    .minmax-live-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--es-ok);
    }

    /* Tarjetas */
    .mm-card {
        background: var(--es-surface);
        border: 1px solid var(--es-line);
        border-radius: 10px;
        padding: 12px 14px;
        min-width: 0;
    }

    .mm-card-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 10px;
        font-size: 14px;
        font-weight: 600;
    }

        .mm-card-title i {
            color: var(--es-tinto);
        }

        .mm-card-title .meta {
            font-size: 11.5px;
            font-weight: 500;
            color: var(--es-muted);
        }

    /* Botones */
    .mm-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        height: 36px;
        padding: 0 14px;
        border: 1px solid var(--es-line-strong);
        border-radius: 7px;
        background: var(--es-field);
        color: var(--es-ink);
        font: 600 12.5px/1 var(--es-font);
        white-space: nowrap;
        cursor: pointer;
        transition: background .12s, border-color .12s;
    }

        .mm-btn:hover {
            background: var(--es-tinto-soft);
            border-color: var(--es-tinto-line);
        }

        .mm-btn.primary {
            background: var(--es-tinto);
            border-color: var(--es-tinto);
            color: #fff;
        }

            .mm-btn.primary:hover {
                background: var(--es-tinto-deep);
                border-color: var(--es-tinto-deep);
            }

        .mm-btn.success i {
            color: var(--es-ok);
        }

        .mm-btn.dark {
            color: var(--es-bad);
        }

            .mm-btn.dark:hover {
                background: var(--es-bad-bg);
                border-color: var(--es-bad);
            }

        .mm-btn.sm {
            height: 30px;
            padding: 0 10px;
            font-size: 12px;
            border-radius: 6px;
        }

        .mm-btn:disabled {
            opacity: .55;
            cursor: progress;
        }

        .mm-btn:focus-visible {
            outline: 2px solid var(--es-tinto);
            outline-offset: 2px;
        }

    .mm-spin {
        display: inline-block;
        width: 13px;
        height: 13px;
        border: 2px solid currentColor;
        border-right-color: transparent;
        border-radius: 50%;
        animation: mm-spin .8s linear infinite;
        vertical-align: -2px;
    }

    @@keyframes mm-spin {
        to {
            transform: rotate(360deg);
        }
    }

    /* Filtros */
    .mm-filters {
        display: grid;
        grid-template-columns: minmax(200px, 1.6fr) 150px minmax(140px, 1fr) minmax(140px, 1fr) minmax(170px, 1fr) auto;
        gap: 10px;
        align-items: end;
    }

    .mm-field label {
        display: block;
        margin: 0 0 5px;
        font-size: 12px;
        font-weight: 600;
        color: var(--es-muted);
    }

    .mm-field input, .mm-field select, .mm-modal input, .mm-modal select {
        width: 100%;
        height: 36px;
        padding: 0 10px;
        border: 1px solid var(--es-line-strong);
        border-radius: 7px;
        background-color: var(--es-field);
        color: var(--es-ink);
        font: 500 13px/1.2 var(--es-font);
        outline: none;
    }

        .mm-field input:focus, .mm-field select:focus, .mm-modal input:focus, .mm-modal select:focus {
            border-color: var(--es-tinto);
            box-shadow: 0 0 0 3px rgba(141,62,70,.16);
        }

    body[data-theme="dark"] .mm-field input, body[data-theme="dark"] .mm-field select, body[data-theme="dark"] .mm-modal input, body[data-theme="dark"] .mm-modal select {
        color-scheme: dark;
    }

    .mm-actions {
        display: flex;
        gap: 8px;
    }

    .mm-opcion {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-top: 10px;
        font-size: 12px;
        color: var(--es-muted);
        cursor: pointer;
    }

        .mm-opcion input {
            width: 16px;
            height: 16px;
            accent-color: var(--es-tinto);
        }

    /* KPIs (clic = filtrar por indicador) */
    .mm-kpis {
        display: grid;
        grid-template-columns: repeat(7, minmax(0, 1fr));
        gap: 10px;
    }

    .mm-kpi {
        text-align: left;
        padding: 10px 12px;
        border-radius: 10px;
        background: var(--es-surface);
        border: 1px solid var(--es-line);
        border-top: 3px solid var(--k, var(--es-line-strong));
        min-width: 0;
        font-family: var(--es-font);
        color: var(--es-ink);
    }

    button.mm-kpi {
        cursor: pointer;
        transition: box-shadow .12s, border-color .12s;
    }

        button.mm-kpi:hover {
            box-shadow: 0 4px 14px rgba(35,26,28,.08);
        }

        button.mm-kpi.is-on {
            border-color: var(--k);
            box-shadow: inset 0 0 0 1px var(--k);
        }

    .mm-kpi span {
        display: block;
        font-size: 11.5px;
        font-weight: 600;
        color: var(--es-muted);
    }

    .mm-kpi strong {
        display: block;
        margin-top: 2px;
        font-size: clamp(17px, 1.4vw, 22px);
        font-weight: 700;
        font-variant-numeric: tabular-nums;
        color: var(--k-txt, var(--es-ink));
    }

    .mm-kpi em {
        display: block;
        font-style: normal;
        font-size: 11px;
        color: var(--es-muted);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .mm-kpi.general {
        --k: var(--es-tinto);
    }

    .mm-kpi.bajo {
        --k: var(--es-bad);
        --k-txt: var(--es-bad);
    }

    .mm-kpi.alerta {
        --k: var(--es-warn);
        --k-txt: var(--es-warn);
    }

    .mm-kpi.ok {
        --k: var(--es-ok);
        --k-txt: var(--es-ok);
    }

    .mm-kpi.sobre {
        --k: var(--es-info);
        --k-txt: var(--es-info);
    }

    .mm-kpi.sin {
        --k: var(--es-muted);
    }

    .mm-kpi.kg {
        --k: var(--es-dark);
    }

    /* Resumen gráfico */
    .mm-summary-grid {
        display: grid;
        grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
        gap: 12px;
    }

    .mm-chart-heading {
        margin: 0 0 10px;
        font-size: 14px;
        font-weight: 600;
    }

    .mm-status-list {
        display: grid;
        gap: 8px;
    }

    .mm-status-row {
        display: grid;
        grid-template-columns: 170px minmax(0, 1fr) 50px;
        gap: 10px;
        align-items: center;
        cursor: pointer;
        padding: 2px 4px;
        border-radius: 6px;
    }

        .mm-status-row:hover {
            background: var(--es-hover);
        }

        .mm-status-row.is-on {
            background: var(--es-tinto-soft);
        }

    .mm-top-list {
        display: grid;
        gap: 4px;
        max-height: 330px;
        overflow-y: auto;
    }

    .mm-top-row {
        display: grid;
        grid-template-columns: 72px minmax(0, 1fr) 90px;
        gap: 10px;
        align-items: center;
        padding: 5px 6px;
        border-radius: 6px;
    }

    .mm-top-clickable {
        cursor: pointer;
    }

        .mm-top-clickable:hover, .mm-top-clickable:focus-visible {
            background: var(--es-tinto-soft);
            outline: none;
        }

        .mm-top-clickable.is-on {
            background: var(--es-tinto-soft);
            box-shadow: inset 3px 0 0 var(--es-tinto);
        }

    .mm-top-name {
        font-size: 12px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .mm-bar {
        height: 8px;
        border-radius: 999px;
        background: var(--es-neutral-bg);
        overflow: hidden;
    }

    .mm-bar-fill {
        height: 100%;
        border-radius: 999px;
        background: var(--es-muted);
    }

    .fill-BAJO {
        background: var(--es-bad);
    }

    .fill-MIN {
        background: var(--es-warn);
    }

    .fill-OK {
        background: var(--es-ok);
    }

    .fill-SOBRE {
        background: var(--es-info);
    }

    .fill-NOPROD {
        background: var(--es-dark);
    }

    .fill-SIN {
        background: var(--es-line-strong);
    }

    .mm-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 3px 9px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 600;
        line-height: 1.25;
        background: var(--es-neutral-bg);
        color: var(--es-muted);
    }

        .mm-badge::before {
            content: "";
            width: 6px;
            height: 6px;
            flex: none;
            border-radius: 50%;
            background: currentColor;
        }

    .status-BAJO {
        background: var(--es-bad-bg);
        color: var(--es-bad);
    }

    .status-MIN {
        background: var(--es-warn-bg);
        color: var(--es-warn);
    }

    .status-OK {
        background: var(--es-ok-bg);
        color: var(--es-ok);
    }

    .status-SOBRE {
        background: var(--es-info-bg);
        color: var(--es-info);
    }

    .status-NOPROD {
        background: var(--es-dark-bg);
        color: var(--es-dark);
    }

    .status-SIN {
        background: var(--es-neutral-bg);
        color: var(--es-muted);
    }

    .mm-gap-negative {
        color: var(--es-bad) !important;
        font-weight: 700;
    }

    .mm-gap-positive {
        color: var(--es-info) !important;
        font-weight: 700;
    }

    /* ---------- Tabla de detalle: sin desplazamiento horizontal ----------
           Columnas por porcentaje (colgroup); SKU+producto y clasificación+master van
           en dos líneas dentro de la misma celda; los encabezados pueden partirse. */
    .mm-table-wrap {
        max-height: calc(100dvh - 210px);
        min-height: 320px;
        overflow-y: auto;
        overflow-x: hidden;
        border: 1px solid var(--es-line);
        border-radius: 8px;
    }

    .mm-table {
        width: 100%;
        table-layout: fixed;
        border-collapse: separate;
        border-spacing: 0;
        font-size: 12px;
        color: var(--es-ink);
    }

        .mm-table thead th {
            position: sticky;
            top: 0;
            z-index: 2;
            padding: 8px 6px;
            background: var(--es-head);
            border-bottom: 1px solid var(--es-line);
            color: var(--es-muted);
            font-size: 11px;
            font-weight: 600;
            line-height: 1.2;
            text-align: left;
            vertical-align: bottom;
            white-space: normal;
        }

            .mm-table thead th.num {
                text-align: right;
            }

            .mm-table thead th.col-real {
                background: #f7f1e1;
            }

    body[data-theme="dark"] .mm-table thead th.col-real {
        background: #2e2c22;
    }

    .mm-sortable {
        cursor: pointer;
        user-select: none;
    }

        .mm-sortable:hover, .mm-sort-link:hover {
            color: var(--es-ink);
        }

    .mm-sort-active, .mm-sort-link.mm-sort-active {
        color: var(--es-tinto) !important;
    }

    .mm-sort-indicator {
        font-size: 9px;
        margin-left: 2px;
        opacity: .55;
    }

    .mm-sort-active .mm-sort-indicator {
        opacity: 1;
    }

    .mm-sort-link {
        cursor: pointer;
    }

        .mm-sort-link + .mm-sort-sep {
            margin: 0 3px;
            opacity: .5;
        }

    .mm-table tbody td {
        padding: 6px 6px;
        border-bottom: 1px solid var(--es-row-line);
        background: var(--es-surface);
        vertical-align: middle;
        overflow-wrap: anywhere;
    }

        .mm-table tbody td.num {
            white-space: nowrap;
            overflow-wrap: normal;
        }

    .mm-table tbody tr:hover td {
        background: var(--es-hover);
    }

    .mm-table tbody td.col-real {
        background: #fdfaf2;
        font-weight: 600;
    }

    body[data-theme="dark"] .mm-table tbody td.col-real {
        background: #24231d;
    }

    .mm-celda2 strong {
        display: block;
        font-size: 12px;
        line-height: 1.25;
    }

    .mm-celda2 small {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
        font-size: 11px;
        line-height: 1.25;
        color: var(--es-muted);
    }

    .mm-celda2.prod small {
        color: var(--es-ink);
        font-size: 11.5px;
    }

    .mm-table .mm-badge {
        font-size: 10.5px;
        padding: 3px 7px;
    }

    .mm-pct .mm-bar {
        height: 6px;
    }

    .mm-pct div:last-child {
        margin-top: 2px;
        font-size: 11px;
    }

    .mm-loading {
        padding: 40px 12px !important;
        text-align: center !important;
        color: var(--es-muted);
        white-space: normal !important;
    }

    .mm-pedidos-link {
        appearance: none;
        border: 0;
        background: transparent;
        padding: 0;
        color: var(--es-tinto);
        font: inherit;
        font-weight: 700;
        cursor: pointer;
        text-decoration: underline dotted;
        text-underline-offset: 3px;
        white-space: nowrap;
    }

        .mm-pedidos-link:hover, .mm-pedidos-link:focus-visible {
            text-decoration-style: solid;
            outline: none;
        }

        .mm-pedidos-link i {
            margin-left: 2px;
            font-size: 10px;
        }

    @@media (max-width: 1280px) {
        .mm-table-wrap {
            overflow-x: auto;
        }

        .mm-table {
            min-width: 1120px;
        }
    }

    .mm-footer {
        display: flex;
        justify-content: space-between;
        gap: 18px;
        flex-wrap: wrap;
        font-size: 11.5px;
        color: var(--es-muted);
    }

    /* ---------- Modales ---------- */
    .mm-modal {
        position: fixed;
        inset: 0;
        z-index: 1060;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 16px;
        background: rgba(22,24,28,.5);
    }

        .mm-modal.show {
            display: flex;
        }

    .mm-modal-shell {
        width: min(96vw, 1500px);
        height: min(92vh, 900px);
        display: flex;
        flex-direction: column;
        border-radius: 12px;
        overflow: hidden;
        background: var(--es-surface);
        box-shadow: 0 24px 70px rgba(0,0,0,.35);
    }

    .mm-modal-header {
        flex: none;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 13px 18px;
        background: var(--es-tinto-deep);
        color: #fff;
    }

        .mm-modal-header strong {
            font-size: 15px;
            font-weight: 600;
        }

        .mm-modal-header .sub {
            margin-top: 2px;
            font-size: 12px;
            opacity: .8;
        }

        .mm-modal-header .mm-btn {
            background: rgba(255,255,255,.14);
            border-color: transparent;
            color: #fff;
        }

            .mm-modal-header .mm-btn:hover {
                background: rgba(255,255,255,.26);
            }

    .mm-modal-body {
        flex: 1 1 auto;
        min-height: 0;
        padding: 14px 16px;
        background: var(--es-paper);
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    .mm-catalog-grid {
        flex: 1 1 auto;
        min-height: 0;
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
        gap: 12px;
    }

    .mm-catalog-card {
        display: flex;
        flex-direction: column;
        min-height: 0;
        padding: 12px;
        border-radius: 10px;
        background: var(--es-surface);
        border: 1px solid var(--es-line);
    }

        .mm-catalog-card h3 {
            margin: 0 0 4px;
            font-size: 14px;
            font-weight: 600;
        }

        .mm-catalog-card .ayuda {
            margin: 0 0 10px;
            font-size: 11.5px;
            color: var(--es-muted);
        }

    .mm-nueva {
        display: grid;
        grid-template-columns: minmax(140px, 1.6fr) repeat(3, minmax(64px, .6fr)) auto;
        gap: 6px;
        align-items: end;
        margin-bottom: 10px;
        padding: 10px;
        border-radius: 8px;
        background: var(--es-head);
        border: 1px dashed var(--es-line-strong);
    }

        .mm-nueva label {
            display: block;
            margin-bottom: 3px;
            font-size: 11px;
            font-weight: 600;
            color: var(--es-muted);
        }

    .mm-catalog-search {
        margin-bottom: 8px;
    }

    .mm-catalog-scroll {
        flex: 1 1 auto;
        min-height: 0;
        overflow: auto;
        border: 1px solid var(--es-line);
        border-radius: 8px;
    }

    .mm-catalog-table {
        width: 100%;
        border-collapse: separate;
