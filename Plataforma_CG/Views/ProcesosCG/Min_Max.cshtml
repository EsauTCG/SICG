@section Scripts {
    @* CORRECCIÓN: se quitaron los dos scripts que buscaban el menú lateral y movían la pantalla
       cada 70 ms; el layout ya ajusta el ancho del contenido al abrir o cerrar el menú. *@
    <script>
        (() => {
            "use strict";

            const URLS = {
                datos: '@Url.Action("InventarioMinMaxDatos", "ProcesosCg")',
                catalogo: '@Url.Action("InventarioMinMaxCatalogo", "ProcesosCg")',
                guardarClasificacion: '@Url.Action("GuardarInventarioMinMaxClasificacion", "ProcesosCg")',
                crearClasificacion: '@Url.Action("CrearInventarioMinMaxClasificacion", "ProcesosCg")',
                eliminarClasificacion: '@Url.Action("EliminarInventarioMinMaxClasificacion", "ProcesosCg")',
                guardarSku: '@Url.Action("GuardarInventarioMinMaxSkuClasificacion", "ProcesosCg")',
                pedidosDetalle: '@Url.Action("InventarioMinMaxPedidosDetalle", "ProcesosCg")'
            };

            const LABELS = { BAJO: "Bajo mínimo", MIN: "Entre mínimo e ideal", OK: "Dentro de rango", SOBRE: "Sobre máximo", NOPROD: "No producir", SIN: "Sin configuración/base" };
            const STATUS_ORDER = ["BAJO", "MIN", "OK", "SOBRE", "NOPROD", "SIN"];

            let datosTodos = [];   // todo lo que regresa el servidor
            let datos = [];        // con o sin SKU sin producción, según la casilla
            let clasificaciones = [], catalogoSkus = [], cargando = false;
            let ordenTabla = { campo: "clasificacion", direccion: "asc" };

            const el = id => document.getElementById(id);
            const tablaBody = el("tablaBody"), buscarInput = el("buscarInput"), mesInput = el("mesInput");
            const clasificacionSelect = el("clasificacionSelect"), masterSelect = el("masterSelect"), estatusSelect = el("estatusSelect");
            const btnActualizar = el("btnActualizar"), catalogoModal = el("catalogoModal"), pedidosModal = el("pedidosModal"), pedidosDetalleBody = el("pedidosDetalleBody");

            // Opción interna para el indicador "Sin parámetro / no producir" (agrupa SIN y NOPROD)
            estatusSelect.insertAdjacentHTML('beforeend', '<option value="SIN_NOPROD">Sin configuración o no producir</option>');

            const normalizarNumero = v => { const n = Number(v); return Number.isFinite(n) ? n : 0; };
            const normalizarTexto = v => String(v ?? "").trim();
            const getVal = (obj, ...keys) => { for (const k of keys) if (obj && obj[k] !== undefined && obj[k] !== null) return obj[k]; return null; };
            const esc = v => normalizarTexto(v).replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;").replaceAll('"', "&quot;").replaceAll("'", "&#039;");
            const formatoNumero = (v, d = 0) => normalizarNumero(v).toLocaleString("es-MX", { minimumFractionDigits: d, maximumFractionDigits: d });
            function formatoFecha(v) {
                if (!v) return "N/D";
                const d = new Date(v);
                return Number.isNaN(d.getTime()) ? normalizarTexto(v) : d.toLocaleString("es-MX", { dateStyle: "medium", timeStyle: "short" });
            }
            // CORRECCIÓN: fechas sin hora se muestran tal cual (antes la fecha de entrega podía salir un día antes)
            function formatoFechaSoloDia(v) {
                if (!v) return "-";
                const m = String(v).match(/^(\d{4})-(\d{2})-(\d{2})/);
                if (m) return `${m[3]}/${m[2]}/${m[1]}`;
                const d = new Date(v);
                return Number.isNaN(d.getTime()) ? (normalizarTexto(v) || "-") : d.toLocaleDateString("es-MX");
            }
            const mesActual = () => { const n = new Date(); return `${n.getFullYear()}-${String(n.getMonth() + 1).padStart(2, "0")}`; };
            const token = () => document.querySelector('input[name="__RequestVerificationToken"]')?.value || "";

            function normalizarFila(row) {
                const n = (...k) => normalizarNumero(getVal(row, ...k));
                return {
                    clasificacion: normalizarTexto(getVal(row, "clasificacion", "Clasificacion")).toUpperCase(),
                    clasificacionOrden: n("clasificacionOrden", "ClasificacionOrden"),
                    master: normalizarTexto(getVal(row, "master", "Master", "masterProducto", "MasterProducto")) || "SIN MASTER",
                    sku: normalizarTexto(getVal(row, "sku", "Sku", "SKU")).toUpperCase(),
                    producto: normalizarTexto(getVal(row, "producto", "Producto")),
                    kgProduccionMes: n("kgProduccionMes", "KgProduccionMes"),
                    kgProducidoReal: n("kgProducidoReal", "KgProducidoReal"),
                    kgFaltaProducir: n("kgFaltaProducir", "KgFaltaProducir"),
                    kgFaltaMasInventario: n("kgFaltaMasInventario", "KgFaltaMasInventario"),
                    kgPedidosMes: n("kgPedidosMes", "KgPedidosMes"),
                    kgInventarioInicial: n("kgInventarioInicial", "KgInventarioInicial"),
                    kgBaseCalculo: n("kgBaseCalculo", "KgBaseCalculo"),
                    kgActual: n("kgActual", "KgActual"),
                    cajasActuales: n("cajasActuales", "CajasActuales"),
                    lotes: n("lotes", "Lotes"),
                    diasMinimo: n("diasMinimo", "DiasMinimo"), diasIdeal: n("diasIdeal", "DiasIdeal"), diasMaximo: n("diasMaximo", "DiasMaximo"),
                    minimo: n("minimo", "Minimo"), ideal: n("ideal", "Ideal"), maximo: n("maximo", "Maximo"),
                    gapIdeal: n("gapIdeal", "GapIdeal"),
                    consumoDiario: n("consumoDiario", "ConsumoDiario"),
                    diasActual: n("diasActual", "DiasActual"),
                    porcentajeMaximo: n("porcentajeMaximo", "PorcentajeMaximo"),
                    estatus: normalizarTexto(getVal(row, "estatus", "Estatus")).toUpperCase() || "SIN",
                    fechaActualizacion: getVal(row, "fechaActualizacion", "FechaActualizacion"),
                    fechaInventarioInicial: getVal(row, "fechaInventarioInicial", "FechaInventarioInicial")
                };
            }

            async function leerJson(response) {
                const raw = await response.text();
                let data = null;
                try { data = raw ? JSON.parse(raw) : null; } catch { data = null; }
                if (!response.ok) {
                    const base = data?.msg || data?.message || `HTTP ${response.status}`;
                    const det = [data?.error, data?.inner].filter(Boolean).join(" | ");
                    throw new Error(det ? `${base} Detalle: ${det}` : base);
                }
                return data;
            }
            // CORRECCIÓN: los guardados ahora mandan el token antifalsificación (antes iban sin él)
            async function postJson(url, payload) {
                const response = await fetch(url, {
                    method: "POST", cache: "no-store",
                    headers: { "Content-Type": "application/json", "Accept": "application/json", "RequestVerificationToken": token() },
                    body: JSON.stringify(payload)
                });
                const data = await leerJson(response);
                if (data?.ok === false) throw new Error(data.msg || data.error || "La operación no se completó.");
                return data;
            }

            function setCargando(v) {
                cargando = v;
                btnActualizar.disabled = v;
                btnActualizar.innerHTML = v ? `<span class="mm-spin"></span> Consultando` : `<i class="bi bi-arrow-repeat"></i> Actualizar`;
            }
            const filaMsg = (texto, color) => `<tr><td colspan="14" class="mm-loading" ${color ? `style="color:${color} !important"` : ''}>${texto}</td></tr>`;

            // ---------- Datos ----------
            function aplicarFiltroProduccion() {
                const incluir = el("incluirSinProduccion").checked;
                datos = datosTodos.filter(x => x.sku && (incluir || x.kgProduccionMes > 0));
                const sinProd = datosTodos.filter(x => x.sku && !(x.kgProduccionMes > 0)).length;
                el("sinProdConteo").textContent = sinProd ? `(${formatoNumero(sinProd)} SKU)` : '';
            }

            async function cargarDatos() {
                if (cargando) return;
                const mes = mesInput.value || mesActual();
                setCargando(true);
                tablaBody.innerHTML = filaMsg(`<span class="mm-spin"></span> Consultando planeación, inventario inicial y existencias…`);
                el("fuenteDatos").textContent = "Consultando fuentes de información…";
                try {
                    const response = await fetch(`${URLS.datos}?mes=${encodeURIComponent(mes + "-01")}&_=${Date.now()}`, { cache: "no-store", headers: { "Accept": "application/json" } });
                    const data = await leerJson(response);
                    if (data?.ok === false) throw new Error(data.msg || data.error || "No se pudo consultar.");
                    datosTodos = (Array.isArray(data?.data) ? data.data : []).map(normalizarFila);
                    aplicarFiltroProduccion();
                    llenarFiltros();
                    renderizar();
                    el("mmUpdatedText").textContent = `Inventario SIGO: ${formatoFecha(data?.fechaActualizacion)} · Inv. inicial: ${formatoFecha(data?.fechaInventarioInicial)}`;
                    el("fuenteDatos").textContent = `${data?.criterio || "Base mensual dinámica."} Registros: ${formatoNumero(datos.length)}.`;
                } catch (error) {
                    console.error(error);
                    datosTodos = []; datos = [];
                    renderizar();
                    tablaBody.innerHTML = filaMsg(`<i class="bi bi-exclamation-triangle"></i> ${esc(error?.message || "No se pudo cargar la información.")}`, 'var(--es-bad)');
                    el("mmUpdatedText").textContent = "Error de consulta";
                    el("fuenteDatos").textContent = "No se muestran valores simulados. Revisa el endpoint InventarioMinMaxDatos.";
                } finally { setCargando(false); }
            }

            function llenarFiltros() {
                const clasActual = clasificacionSelect.value, masterActual = masterSelect.value;
                const clas = [...new Set(datos.map(x => x.clasificacion).filter(Boolean))].sort();
                const masters = [...new Set(datos.map(x => x.master).filter(Boolean))].sort();
                clasificacionSelect.innerHTML = `<option value="">Todas</option>` + clas.map(x => `<option value="${esc(x)}">${esc(x)}</option>`).join("");
                masterSelect.innerHTML = `<option value="">Todos</option>` + masters.map(x => `<option value="${esc(x)}">${esc(x)}</option>`).join("");
                if (clas.includes(clasActual)) clasificacionSelect.value = clasActual;
                if (masters.includes(masterActual)) masterSelect.value = masterActual;
            }

            function obtenerFiltrados() {
                const buscar = buscarInput.value.trim().toLowerCase();
                const clas = clasificacionSelect.value, master = masterSelect.value, est = estatusSelect.value;
                return datos.filter(it => {
                    if (buscar && !`${it.clasificacion} ${it.master} ${it.sku} ${it.producto}`.toLowerCase().includes(buscar)) return false;
                    if (clas && it.clasificacion !== clas) return false;
                    if (master && it.master !== master) return false;
                    if (est === "SIN_NOPROD") { if (it.estatus !== "SIN" && it.estatus !== "NOPROD") return false; }
                    else if (est && it.estatus !== est) return false;
                    return true;
                });
            }

            const CAMPOS_NUM = new Set(["kgProduccionMes", "kgProducidoReal", "kgFaltaProducir", "kgInventarioInicial", "kgBaseCalculo", "kgActual", "kgFaltaMasInventario", "kgPedidosMes", "minimo", "ideal", "maximo", "gapIdeal", "diasActual", "porcentajeMaximo"]);
            function ordenarLista(lista) {
                const campo = ordenTabla.campo, factor = ordenTabla.direccion === "desc" ? -1 : 1;
                const cmpTxt = (a, b) => normalizarTexto(a).localeCompare(normalizarTexto(b), "es-MX", { numeric: true, sensitivity: "base" });
                return [...lista].sort((a, b) => {
                    let r = CAMPOS_NUM.has(campo) ? normalizarNumero(a[campo]) - normalizarNumero(b[campo])
                        : campo === "estatus" ? STATUS_ORDER.indexOf(a.estatus) - STATUS_ORDER.indexOf(b.estatus)
                            : cmpTxt(a[campo], b[campo]);
                    if (r === 0 && campo !== "sku") r = cmpTxt(a.sku, b.sku);
                    return r * factor;
                });
            }
            function actualizarIndicadoresOrden() {
                document.querySelectorAll("#mmTableHeader th").forEach(th => th.setAttribute("aria-sort", "none"));
                document.querySelectorAll("#mmTableHeader [data-sort]").forEach(n => {
                    const activo = n.dataset.sort === ordenTabla.campo;
                    n.classList.toggle("mm-sort-active", activo);
                    if (activo) n.closest('th').setAttribute("aria-sort", ordenTabla.direccion === "asc" ? "ascending" : "descending");
                    const ind = n.querySelector(".mm-sort-indicator");
                    if (ind) ind.textContent = activo ? (ordenTabla.direccion === "asc" ? "▲" : "▼") : "◇";
                });
            }
            function cambiarOrden(campo) {
                if (!campo) return;
                if (ordenTabla.campo === campo) ordenTabla.direccion = ordenTabla.direccion === "asc" ? "desc" : "asc";
                else { ordenTabla.campo = campo; ordenTabla.direccion = CAMPOS_NUM.has(campo) ? "desc" : "asc"; }
                renderizar();
            }

            function renderizar() {
                const lista = ordenarLista(obtenerFiltrados());
                actualizarIndicadoresOrden();
                renderTabla(lista);
                renderKpis(lista);
                renderSemaforo(lista);
                renderTop(lista);
                el("mmResultCount").textContent = `${formatoNumero(lista.length)} registro${lista.length === 1 ? "" : "s"}`;
                document.querySelectorAll('.mm-kpi[data-kpi]').forEach(b => b.classList.toggle('is-on', b.dataset.kpi === (estatusSelect.value === 'SIN_NOPROD' ? 'SIN' : estatusSelect.value) && !!estatusSelect.value));
            }

            function renderTabla(lista) {
                if (!lista.length) { tablaBody.innerHTML = filaMsg(datos.length ? "No hay registros con los filtros seleccionados." : "Sin datos para el mes."); return; }
                tablaBody.innerHTML = lista.map(it => {
                    const pct = Math.min(Math.max(it.porcentajeMaximo, 0), 120);
                    const gapClass = it.gapIdeal < 0 ? "mm-gap-negative" : it.gapIdeal > 0 ? "mm-gap-positive" : "";
                    const clas = it.clasificacion || "SIN ASIGNAR";
                    const tip = `Días: ${formatoNumero(it.diasMinimo, 2)} / ${formatoNumero(it.diasIdeal, 2)} / ${formatoNumero(it.diasMaximo, 2)} · Cajas: ${formatoNumero(it.cajasActuales)} · Lotes: ${formatoNumero(it.lotes)}`;
                    const nc = v => `data-copy="${Math.round(normalizarNumero(v))}"`;
                    return `<tr>
                                <td class="mm-celda2" title="${esc(tip)}" data-copy="${esc(clas)} / ${esc(it.master)}"><strong>${esc(clas)}</strong><small>${esc(it.master)}</small></td>
                                <td class="mm-celda2 prod" title="${esc(it.producto)}" data-copy="${esc(it.sku)} - ${esc(it.producto)}"><strong>${esc(it.sku)}</strong><small>${esc(it.producto || "Sin descripción")}</small></td>
                                <td class="num" ${nc(it.kgProduccionMes)}>${formatoNumero(it.kgProduccionMes)}</td>
                                <td class="num" ${nc(it.kgInventarioInicial)}>${formatoNumero(it.kgInventarioInicial)}</td>
                                <td class="num" ${nc(it.kgBaseCalculo)}>${formatoNumero(it.kgBaseCalculo)}</td>
                                <td class="num col-real" ${nc(it.kgActual)}>${formatoNumero(it.kgActual)}</td>
                                <td class="num" ${nc(it.minimo)}>${formatoNumero(it.minimo)}</td>
                                <td class="num" ${nc(it.ideal)}>${formatoNumero(it.ideal)}</td>
                                <td class="num" ${nc(it.maximo)}>${formatoNumero(it.maximo)}</td>
                                <td class="num ${gapClass}" ${nc(it.gapIdeal)}>${it.gapIdeal > 0 ? '+' : ''}${formatoNumero(it.gapIdeal)}</td>
                                <td class="num" ${nc(it.kgFaltaMasInventario)} title="Falta producir: ${formatoNumero(it.kgFaltaProducir)} kg · Producido real: ${formatoNumero(it.kgProducidoReal)} kg · Inventario actual: ${formatoNumero(it.kgActual)} kg"><strong>${formatoNumero(it.kgFaltaMasInventario)}</strong></td>
                                <td class="num" ${nc(it.kgPedidosMes)}>${it.kgPedidosMes > 0
                            ? `<button type="button" class="mm-pedidos-link" data-pedidos-sku="${esc(it.sku)}" data-pedidos-producto="${esc(it.producto)}" title="Ver pedidos pendientes de ${esc(it.sku)}">${formatoNumero(it.kgPedidosMes)}<i class="bi bi-search"></i></button>`
                            : `<span style="color:var(--es-muted)">0</span>`}</td>
                                <td class="num mm-pct" data-copy="${formatoNumero(it.porcentajeMaximo, 1).replace(/,/g, '')}">
                                    <div class="mm-bar" title="${formatoNumero(it.porcentajeMaximo, 1)}% del máximo"><div class="mm-bar-fill fill-${esc(it.estatus)}" style="width:${pct / 1.2}%"></div></div>
                                    <div>${formatoNumero(it.porcentajeMaximo, 1)}%</div>
                                </td>
                                <td data-copy="${esc(LABELS[it.estatus] || it.estatus)}"><span class="mm-badge status-${esc(it.estatus)}">${esc(LABELS[it.estatus] || it.estatus)}</span></td>
                            </tr>`;
                }).join("");
            }

            function contar(lista) {
                const c = Object.fromEntries(STATUS_ORDER.map(k => [k, 0]));
                lista.forEach(it => c[it.estatus] = (c[it.estatus] || 0) + 1);
                return c;
            }
            function renderKpis(lista) {
                const c = contar(lista);
                el("kpiSkus").textContent = formatoNumero(lista.length);
                el("kpiBajo").textContent = formatoNumero(c.BAJO);
                el("kpiMin").textContent = formatoNumero(c.MIN);
                el("kpiOk").textContent = formatoNumero(c.OK);
                el("kpiSobre").textContent = formatoNumero(c.SOBRE);
                el("kpiSin").textContent = formatoNumero(c.SIN + c.NOPROD);
                el("kpiActual").textContent = `${formatoNumero(lista.reduce((s, it) => s + it.kgActual, 0))} kg`;
            }
            function renderSemaforo(lista) {
                const c = contar(lista), max = Math.max(...Object.values(c), 1);
                el("semaforoChart").innerHTML = STATUS_ORDER.map(k => `
                            <div class="mm-status-row ${estatusSelect.value === k ? 'is-on' : ''}" data-est="${k}" role="button" tabindex="0" title="Clic para filtrar por ${esc(LABELS[k])}">
                                <span class="mm-badge status-${k}">${esc(LABELS[k])}</span>
                                <div class="mm-bar"><div class="mm-bar-fill fill-${k}" style="width:${(c[k] / max) * 100}%"></div></div>
                                <strong class="num">${formatoNumero(c[k])}</strong>
                            </div>`).join("");
            }
            function renderTop(lista) {
                const top = lista.filter(x => x.ideal > 0).sort((a, b) => Math.abs(b.gapIdeal) - Math.abs(a.gapIdeal)).slice(0, 15);
                if (!top.length) { el("topChart").innerHTML = `<div style="color:var(--es-muted);font-size:12px">Sin información.</div>`; return; }
                const max = Math.max(...top.map(x => Math.abs(x.gapIdeal)), 1);
                const filtro = normalizarTexto(buscarInput.value).toUpperCase();
                el("topChart").innerHTML = top.map(it => `
                            <div class="mm-top-row mm-top-clickable ${filtro === it.sku ? 'is-on' : ''}" data-sku="${esc(it.sku)}" role="button" tabindex="0" title="${filtro === it.sku ? 'Clic para quitar el filtro' : 'Clic para ver solo ' + esc(it.sku)}">
                                <strong>${esc(it.sku)}</strong>
                                <div><div class="mm-top-name" title="${esc(it.producto)}">${esc(it.producto)}</div>
                                    <div class="mm-bar" style="margin-top:3px"><div class="mm-bar-fill fill-${esc(it.estatus)}" style="width:${(Math.abs(it.gapIdeal) / max) * 100}%"></div></div></div>
                                <strong class="num ${it.gapIdeal < 0 ? "mm-gap-negative" : "mm-gap-positive"}">${it.gapIdeal > 0 ? "+" : ""}${formatoNumero(it.gapIdeal)} kg</strong>
                            </div>`).join("");
            }

            // Clic en la gráfica: filtra ese SKU; otro clic sobre el mismo lo quita
            function abrirDetalleSku(sku) {
                const s = normalizarTexto(sku).toUpperCase();
                if (!s) return;
                if (normalizarTexto(buscarInput.value).toUpperCase() === s) { buscarInput.value = ""; renderizar(); return; }
                buscarInput.value = s;
                renderizar();
                requestAnimationFrame(() => document.querySelector(".mm-detail-card")?.scrollIntoView({ behavior: "smooth", block: "start" }));
            }

            // ---------- Pedidos pendientes ----------
            function abrirModal(m) { m.classList.add("show"); m.setAttribute("aria-hidden", "false"); document.body.style.overflow = "hidden"; setTimeout(() => m.querySelector('.mm-modal-header .mm-btn')?.focus(), 0); }
            function cerrarModal(m) {
                m.classList.remove("show"); m.setAttribute("aria-hidden", "true");
                document.body.style.overflow = document.querySelector('.mm-modal.show') ? "hidden" : "";
            }
            const cerrarPedidosDetalle = () => cerrarModal(pedidosModal);

            function renderPedidosDetalle(rows) {
                if (!rows.length) { pedidosDetalleBody.innerHTML = `<tr><td colspan="10" class="mm-loading"><i class="bi bi-check-circle"></i> Este SKU no tiene pedidos pendientes de surtir en el mes.</td></tr>`; return; }
                pedidosDetalleBody.innerHTML = rows.map(it => `
                            <tr>
                                <td data-copy="${esc(it.ordenVenta || it.ordenVentaId)}"><strong>${esc(it.ordenVenta || `OV ${it.ordenVentaId}`)}</strong><div style="color:var(--es-muted);font-size:11px">#${formatoNumero(it.ordenVentaId)}</div></td>
                                <td class="mm-pedido-cliente" data-copy="${esc(it.clienteCodigo)} - ${esc(it.clienteNombre)}"><strong>${esc(it.clienteNombre || it.clienteCodigo || "Sin cliente")}</strong><small>${esc(it.clienteCodigo || "-")}</small></td>
                                <td data-copy="${esc(it.vendedor)} / ${esc(it.canal)}"><strong>${esc(it.vendedor || "-")}</strong><div style="color:var(--es-muted);font-size:11px">${esc(it.canal || "SIN CANAL")}</div></td>
                                <td>${esc(it.serie || "-")}</td>
                                <td>${esc(formatoFechaSoloDia(it.fechaEntrega))}</td>
                                <td><span class="mm-badge ${it.estatusId === 1 || it.estatusId === 3 ? "status-MIN" : "status-OK"}">${esc(it.estatus || "Pendiente")}</span></td>
                                <td class="num" data-copy="${Math.round(it.kgPedido)}">${formatoNumero(it.kgPedido)}</td>
                                <td class="num" data-copy="${Math.round(it.kgSurtido)}">${formatoNumero(it.kgSurtido)}</td>
                                <td class="num" data-copy="${Math.round(it.kgCerrado)}">${formatoNumero(it.kgCerrado)}</td>
                                <td class="num mm-gap-negative" data-copy="${Math.round(it.kgPendiente)}">${formatoNumero(it.kgPendiente)}</td>
                            </tr>`).join("");
            }

            let pedidosSeq = 0;
            async function abrirPedidosDetalle(sku, producto) {
                const s = normalizarTexto(sku).toUpperCase();
                if (!s) return;
                const seq = ++pedidosSeq;
                const mes = mesInput.value || mesActual();
                abrirModal(pedidosModal);
                el("pedidosModalSubtitulo").textContent = `${s} · ${normalizarTexto(producto) || "Sin descripción"} · ${mes}`;
                ["pedidosKpiCantidad", "pedidosKpiPedido", "pedidosKpiSurtido", "pedidosKpiPendiente"].forEach(id => el(id).textContent = "…");
                pedidosDetalleBody.innerHTML = `<tr><td colspan="10" class="mm-loading"><span class="mm-spin"></span> Consultando pedidos pendientes…</td></tr>`;
                try {
                    const response = await fetch(`${URLS.pedidosDetalle}?sku=${encodeURIComponent(s)}&mes=${encodeURIComponent(mes + "-01")}&_=${Date.now()}`, { cache: "no-store", headers: { "Accept": "application/json" } });
                    const data = await leerJson(response);
                    if (seq !== pedidosSeq) return;
                    if (data?.ok === false) throw new Error(data.msg || data.error || "No se pudo consultar el detalle.");
                    const t = (x, ...k) => normalizarTexto(getVal(x, ...k)), n = (x, ...k) => normalizarNumero(getVal(x, ...k));
                    const rows = (Array.isArray(data?.data) ? data.data : []).map(x => ({
                        ordenVentaId: n(x, "ordenVentaId", "OrdenVentaId"), ordenVenta: t(x, "ordenVenta", "OrdenVenta"),
                        clienteCodigo: t(x, "clienteCodigo", "ClienteCodigo"), clienteNombre: t(x, "clienteNombre", "ClienteNombre"),
                        vendedor: t(x, "vendedor", "Vendedor"), canal: t(x, "canal", "Canal"), serie: t(x, "serie", "Serie"),
                        fechaEntrega: getVal(x, "fechaEntrega", "FechaEntrega"), estatusId: n(x, "estatusId", "EstatusId"), estatus: t(x, "estatus", "Estatus"),
                        kgPedido: n(x, "kgPedido", "KgPedido"), kgSurtido: n(x, "kgSurtido", "KgSurtido"), kgCerrado: n(x, "kgCerrado", "KgCerrado"), kgPendiente: n(x, "kgPendiente", "KgPendiente")
                    }));
                    el("pedidosKpiCantidad").textContent = formatoNumero(getVal(data, "totalPedidos", "TotalPedidos") ?? rows.length);
                    el("pedidosKpiPedido").textContent = `${formatoNumero(getVal(data, "kgPedido", "KgPedido"))} kg`;
                    el("pedidosKpiSurtido").textContent = `${formatoNumero(getVal(data, "kgSurtido", "KgSurtido"))} kg`;
                    el("pedidosKpiPendiente").textContent = `${formatoNumero(getVal(data, "kgPendiente", "KgPendiente"))} kg`;
                    renderPedidosDetalle(rows);
                } catch (error) {
                    console.error(error);
                    ["pedidosKpiCantidad", "pedidosKpiPedido", "pedidosKpiSurtido", "pedidosKpiPendiente"].forEach(id => el(id).textContent = "—");
                    pedidosDetalleBody.innerHTML = `<tr><td colspan="10" class="mm-loading" style="color:var(--es-bad) !important"><i class="bi bi-exclamation-triangle"></i> ${esc(error?.message || "No se pudo cargar el detalle.")}</td></tr>`;
                }
            }

            // ---------- Catálogo ----------
            async function cargarCatalogo() {
                el("catalogoClasificacionesBody").innerHTML = `<tr><td colspan="5" class="mm-loading">Cargando reglas…</td></tr>`;
                el("catalogoSkuBody").innerHTML = `<tr><td colspan="4" class="mm-loading">Cargando asignaciones…</td></tr>`;
                const data = await leerJson(await fetch(`${URLS.catalogo}?_=${Date.now()}`, { cache: "no-store", headers: { "Accept": "application/json" } }));
                if (data?.ok === false) throw new Error(data.msg || data.error || "No se pudo consultar el catálogo.");
                clasificaciones = (Array.isArray(data?.clasificaciones) ? data.clasificaciones : []).map(x => ({
                    clasificacionId: normalizarNumero(getVal(x, "clasificacionId", "ClasificacionId")),
                    clasificacion: normalizarTexto(getVal(x, "clasificacion", "Clasificacion")).toUpperCase(),
                    diasMinimo: normalizarNumero(getVal(x, "diasMinimo", "DiasMinimo")),
                    diasIdeal: normalizarNumero(getVal(x, "diasIdeal", "DiasIdeal")),
                    diasMaximo: normalizarNumero(getVal(x, "diasMaximo", "DiasMaximo")),
                    orden: normalizarNumero(getVal(x, "orden", "Orden")),
                    activo: Boolean(getVal(x, "activo", "Activo"))
                }));
                catalogoSkus = (Array.isArray(data?.skus) ? data.skus : []).map(x => ({
                    sku: normalizarTexto(getVal(x, "sku", "Sku")).toUpperCase(),
                    producto: normalizarTexto(getVal(x, "producto", "Producto")),
                    master: normalizarTexto(getVal(x, "master", "Master")) || "SIN MASTER",
                    clasificacion: normalizarTexto(getVal(x, "clasificacion", "Clasificacion")).toUpperCase()
                }));
                renderCatalogoClasificaciones();
                renderCatalogoSkus();
            }

            function renderCatalogoClasificaciones() {
                const body = el("catalogoClasificacionesBody");
                if (!clasificaciones.length) { body.innerHTML = `<tr><td colspan="5" class="mm-loading">No hay clasificaciones.</td></tr>`; return; }
                body.innerHTML = clasificaciones.map((it, i) => `
                            <tr data-clas-index="${i}">
                                <td><strong>${esc(it.clasificacion)}</strong></td>
                                <td><input class="num" data-field="diasMinimo" data-original="${it.diasMinimo}" type="number" min="0" step="0.1" value="${it.diasMinimo}" aria-label="Días mínimos ${esc(it.clasificacion)}" /></td>
                                <td><input class="num" data-field="diasIdeal" data-original="${it.diasIdeal}" type="number" min="0" step="0.1" value="${it.diasIdeal}" aria-label="Días ideales ${esc(it.clasificacion)}" /></td>
                                <td><input class="num" data-field="diasMaximo" data-original="${it.diasMaximo}" type="number" min="0" step="0.1" value="${it.diasMaximo}" aria-label="Días máximos ${esc(it.clasificacion)}" /></td>
                                <td><div class="acciones">
                                    <button type="button" class="mm-btn sm" data-save-clas="${i}">Guardar</button>
                                    <button type="button" class="mm-btn sm dark" data-delete-clas="${it.clasificacionId}" data-delete-name="${esc(it.clasificacion)}" title="Eliminar clasificación" aria-label="Eliminar ${esc(it.clasificacion)}"><i class="bi bi-trash"></i></button>
                                </div></td>
                            </tr>`).join("");
            }

            const clasificacionOptions = sel => [`<option value="">Sin asignar</option>`, ...clasificaciones.filter(x => x.activo).map(x => `<option value="${esc(x.clasificacion)}" ${x.clasificacion === sel ? "selected" : ""}>${esc(x.clasificacion)}</option>`)].join("");

            const LIMITE_SKU = 500;
            function renderCatalogoSkus() {
                const buscar = el("catalogoSkuBuscar").value.trim().toLowerCase();
                const coincidencias = catalogoSkus.filter(it => !buscar || `${it.sku} ${it.producto} ${it.master}`.toLowerCase().includes(buscar));
                const rows = coincidencias.slice(0, LIMITE_SKU);
                // CORRECCIÓN: antes se cortaba en 500 sin avisar
                el("catalogoSkuInfo").textContent = coincidencias.length > LIMITE_SKU ? `Mostrando ${LIMITE_SKU} de ${formatoNumero(coincidencias.length)} SKU; usa el buscador para encontrar los demás.` : `${formatoNumero(coincidencias.length)} SKU.`;
                const body = el("catalogoSkuBody");
                if (!rows.length) { body.innerHTML = `<tr><td colspan="4" class="mm-loading">Sin resultados.</td></tr>`; return; }
                body.innerHTML = rows.map(it => `
                            <tr data-sku="${esc(it.sku)}">
                                <td><strong>${esc(it.sku)}</strong></td>
                                <td data-copy="${esc(it.producto)}"><div style="font-weight:600">${esc(it.producto || "Sin descripción")}</div><div style="color:var(--es-muted);font-size:11px">${esc(it.master)}</div></td>
                                <td><select data-sku-select="${esc(it.sku)}" data-original="${esc(it.clasificacion)}" aria-label="Clasificación de ${esc(it.sku)}">${clasificacionOptions(it.clasificacion)}</select></td>
                                <td><button type="button" class="mm-btn sm" data-save-sku="${esc(it.sku)}">Guardar</button></td>
                            </tr>`).join("");
            }

            // Marca en ámbar lo que cambiaste y aún no guardas
            ["catalogoClasificacionesBody", "catalogoSkuBody"].forEach(id => el(id).addEventListener('input', e => {
                const c = e.target.closest('input[data-original], select[data-original]');
                if (!c) return;
                c.classList.toggle('is-changed', String(c.value) !== String(c.dataset.original));
                const btn = c.closest('tr').querySelector('[data-save-clas], [data-save-sku]');
                const cambio = [...c.closest('tr').querySelectorAll('[data-original]')].some(x => String(x.value) !== String(x.dataset.original));
                btn?.classList.toggle('primary', cambio);
            }));

            async function guardarClasificacion(index, button) {
                const it = clasificaciones[index], row = button.closest("tr");
                if (!it || !row) return;
                const v = f => normalizarNumero(row.querySelector(`[data-field="${f}"]`).value);
                const payload = { clasificacion: it.clasificacion, diasMinimo: v("diasMinimo"), diasIdeal: v("diasIdeal"), diasMaximo: v("diasMaximo"), orden: normalizarNumero(it.orden), activo: true };
                if (payload.diasMinimo < 0 || payload.diasIdeal < payload.diasMinimo || payload.diasMaximo < payload.diasIdeal) { alert("La regla debe cumplir mínimo ≤ ideal ≤ máximo."); return; }
                const nSku = catalogoSkus.filter(x => x.clasificacion === it.clasificacion).length;
                if (!confirm(`¿Guardar la regla de ${it.clasificacion}?\n\nDías: ${payload.diasMinimo} / ${payload.diasIdeal} / ${payload.diasMaximo}\nAfecta a ${nSku} SKU.`)) return;
                button.disabled = true; button.textContent = "Guardando…";
                try { await postJson(URLS.guardarClasificacion, payload); await cargarCatalogo(); await cargarDatos(); }
                catch (error) { alert(error?.message || "No se pudo guardar la clasificación."); }
                finally { button.disabled = false; button.textContent = "Guardar"; }
            }

            async function crearClasificacion() {
                const nombre = el("nuevaClasificacionNombre"), min = el("nuevaClasificacionMin"), ideal = el("nuevaClasificacionIdeal"), max = el("nuevaClasificacionMax"), button = el("btnAgregarClasificacion");
                const payload = { clasificacion: normalizarTexto(nombre.value).toUpperCase(), diasMinimo: normalizarNumero(min.value), diasIdeal: normalizarNumero(ideal.value), diasMaximo: normalizarNumero(max.value), orden: 0, activo: true };
                if (!payload.clasificacion) { alert("Escribe el nombre de la nueva clasificación."); nombre.focus(); return; }
                if (clasificaciones.some(x => x.clasificacion === payload.clasificacion)) { alert("Ya existe una clasificación con ese nombre."); nombre.focus(); return; }
                if (payload.diasMinimo < 0 || payload.diasIdeal < payload.diasMinimo || payload.diasMaximo < payload.diasIdeal) { alert("La regla debe cumplir mínimo ≤ ideal ≤ máximo."); return; }
                button.disabled = true; button.innerHTML = `<span class="mm-spin"></span> Agregando`;
                try {
                    await postJson(URLS.crearClasificacion, payload);
                    nombre.value = ""; min.value = ideal.value = max.value = "0";
                    await cargarCatalogo(); await cargarDatos();
                    nombre.focus();
                } catch (error) { alert(error?.message || "No se pudo agregar la clasificación."); }
                finally { button.disabled = false; button.innerHTML = `<i class="bi bi-plus-lg"></i> Agregar`; }
            }

            async function eliminarClasificacion(id, nombre, button) {
                id = normalizarNumero(id);
                if (id <= 0) return;
                if (!confirm(`¿Eliminar la clasificación "${normalizarTexto(nombre) || "esta clasificación"}"?\n\nEl sistema no permitirá eliminarla si todavía tiene SKU asignados.`)) return;
                button.disabled = true;
                const html = button.innerHTML;
                button.innerHTML = `<span class="mm-spin"></span>`;
                try { await postJson(URLS.eliminarClasificacion, { clasificacionId: id }); await cargarCatalogo(); await cargarDatos(); }
                catch (error) { alert(error?.message || "No se pudo eliminar la clasificación."); }
                finally { button.disabled = false; button.innerHTML = html; }
            }

            async function guardarSku(sku, button) {
                const select = button.closest("tr")?.querySelector("[data-sku-select]");
                if (!select) return;
                if (select.value === select.dataset.original) return;
                button.disabled = true; button.textContent = "Guardando…";
                try {
                    await postJson(URLS.guardarSku, { sku, clasificacion: select.value });
                    const it = catalogoSkus.find(x => x.sku === sku);
                    if (it) it.clasificacion = select.value;
                    select.dataset.original = select.value;
                    select.classList.remove('is-changed');
                    button.classList.remove('primary');
                    await cargarDatos();
                } catch (error) { alert(error?.message || "No se pudo guardar el SKU."); }
                finally { button.disabled = false; button.textContent = "Guardar"; }
            }

            function abrirCatalogo() {
                abrirModal(catalogoModal);
                cargarCatalogo().catch(error => { console.error(error); alert(error?.message || "No se pudo abrir el catálogo."); });
            }
            function cerrarCatalogo() {
                const pendientes = catalogoModal.querySelectorAll('.is-changed').length;
                if (pendientes && !confirm(`Tienes ${pendientes} cambio(s) sin guardar en el catálogo. ¿Cerrar de todos modos?`)) return;
                cerrarModal(catalogoModal);
            }

            // ---------- CSV (mismas columnas) ----------
            function exportarCsv() {
                const lista = ordenarLista(obtenerFiltrados());
                const headers = ["CLASIFICACION", "MASTER", "SKU", "PRODUCTO", "PRODUCCION_MES", "INVENTARIO_INICIAL", "BASE_CALCULO", "INVENTARIO_ACTUAL", "DIAS_MINIMO", "DIAS_IDEAL", "DIAS_MAXIMO", "MINIMO", "IDEAL", "MAXIMO", "GAP_IDEAL", "FALTA_PRODUCIR_MAS_INVENTARIO", "PEDIDOS_PENDIENTES", "PORCENTAJE_MAXIMO", "INDICADOR"];
                const rows = lista.map(it => [it.clasificacion, it.master, it.sku, it.producto, it.kgProduccionMes, it.kgInventarioInicial, it.kgBaseCalculo, it.kgActual, it.diasMinimo, it.diasIdeal, it.diasMaximo, it.minimo, it.ideal, it.maximo, it.gapIdeal, it.kgFaltaMasInventario, it.kgPedidosMes, it.porcentajeMaximo, LABELS[it.estatus] || it.estatus]);
                const csv = [headers, ...rows].map(r => r.map(v => `"${String(v ?? "").replaceAll('"', '""')}"`).join(",")).join("\r\n");
                const url = URL.createObjectURL(new Blob(["\uFEFF" + csv], { type: "text/csv;charset=utf-8" }));
                const a = document.createElement("a");
                a.href = url; a.download = `inventario_min_max_${mesInput.value || mesActual()}.csv`;
                document.body.appendChild(a); a.click(); a.remove();
                setTimeout(() => URL.revokeObjectURL(url), 1000);
            }

            // ---------- Eventos ----------
            // CORRECCIÓN: cada buscador tiene su propio temporizador (antes escribir en uno cancelaba el otro)
            let tBuscar = null, tCatalogo = null;
            buscarInput.addEventListener("input", () => { clearTimeout(tBuscar); tBuscar = setTimeout(renderizar, 130); });
            clasificacionSelect.addEventListener("change", renderizar);
            masterSelect.addEventListener("change", renderizar);
            estatusSelect.addEventListener("change", renderizar);
            el("incluirSinProduccion").addEventListener("change", () => { aplicarFiltroProduccion(); llenarFiltros(); renderizar(); });
            mesInput.addEventListener("change", cargarDatos);

            document.querySelectorAll('.mm-kpi[data-kpi]').forEach(b => b.addEventListener('click', () => {
                const v = b.dataset.kpi === 'SIN' ? 'SIN_NOPROD' : b.dataset.kpi;
                estatusSelect.value = (estatusSelect.value === v) ? '' : v;
                renderizar();
            }));
            const filtrarEstatus = e => {
                const r = e.target.closest('.mm-status-row[data-est]');
                if (!r) return;
                estatusSelect.value = estatusSelect.value === r.dataset.est ? '' : r.dataset.est;
                renderizar();
            };
            el("semaforoChart").addEventListener('click', filtrarEstatus);
            el("semaforoChart").addEventListener('keydown', e => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); filtrarEstatus(e); } });

            tablaBody.addEventListener("click", e => {
                const b = e.target.closest("[data-pedidos-sku]");
                if (b) abrirPedidosDetalle(b.dataset.pedidosSku, b.dataset.pedidosProducto);
            });
            el("topChart").addEventListener("click", e => { const r = e.target.closest(".mm-top-clickable[data-sku]"); if (r) abrirDetalleSku(r.dataset.sku); });
            el("topChart").addEventListener("keydown", e => { if (e.key !== "Enter" && e.key !== " ") return; const r = e.target.closest(".mm-top-clickable[data-sku]"); if (r) { e.preventDefault(); abrirDetalleSku(r.dataset.sku); } });

            const head = el("mmTableHeader");
            head.addEventListener("click", e => { const n = e.target.closest("[data-sort]"); if (n) cambiarOrden(n.dataset.sort); });
            head.addEventListener("keydown", e => { if (e.key !== "Enter" && e.key !== " ") return; const n = e.target.closest("[data-sort]"); if (n) { e.preventDefault(); cambiarOrden(n.dataset.sort); } });

            btnActualizar.addEventListener("click", cargarDatos);
            el("btnCatalogo").addEventListener("click", abrirCatalogo);
            el("btnCerrarCatalogo").addEventListener("click", cerrarCatalogo);
            el("btnCerrarPedidos").addEventListener("click", cerrarPedidosDetalle);
            el("btnCsv").addEventListener("click", exportarCsv);
            el("catalogoSkuBuscar").addEventListener("input", () => { clearTimeout(tCatalogo); tCatalogo = setTimeout(renderCatalogoSkus, 130); });
            el("btnAgregarClasificacion").addEventListener("click", crearClasificacion);
            el("nuevaClasificacionNombre").addEventListener("keydown", e => { if (e.key === "Enter") { e.preventDefault(); crearClasificacion(); } });
            el("catalogoClasificacionesBody").addEventListener("click", e => {
                const s = e.target.closest("[data-save-clas]");
                if (s) { guardarClasificacion(Number(s.dataset.saveClas), s); return; }
                const d = e.target.closest("[data-delete-clas]");
                if (d) eliminarClasificacion(d.dataset.deleteClas, d.dataset.deleteName, d);
            });
            el("catalogoSkuBody").addEventListener("click", e => { const b = e.target.closest("[data-save-sku]"); if (b) guardarSku(b.dataset.saveSku, b); });
            catalogoModal.addEventListener("click", e => { if (e.target === catalogoModal) cerrarCatalogo(); });
            pedidosModal.addEventListener("click", e => { if (e.target === pedidosModal) cerrarPedidosDetalle(); });
            document.addEventListener("keydown", e => {
                if (e.key !== "Escape") return;
                if (pedidosModal.classList.contains("show")) { cerrarPedidosDetalle(); return; }
                if (catalogoModal.classList.contains("show")) cerrarCatalogo();
            });

            mesInput.value = mesActual();
            actualizarIndicadoresOrden();
            cargarDatos();
        })();
    </script>
}
