@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Planeación Ejecutiva de Inventario";
}


<link rel="stylesheet" href="~/css/planeacion-ejecutiva-inventario-grid.css" asp-append-version="true" />

<style>
    /*
     * ================================================================
     * AJUSTE RESPONSIVE DE LA VISTA
     * ================================================================
     * Objetivo:
     * - La vista siempre ocupa exactamente el ancho disponible.
     * - Al abrir/cerrar el sidebar se recalcula sin dejar ancho "pegado".
     * - Tabla y gráfica nunca hacen crecer el contenedor principal.
     * - El scroll horizontal, cuando sea necesario, queda dentro de la tabla.
     * ================================================================
     */

    .app#app {
        box-sizing: border-box !important;
        min-width: 0 !important;
        max-width: none !important;
        margin-right: 0 !important;
        overflow-x: hidden !important;
    }

    .app#app *,
    .app#app *::before,
    .app#app *::after {
        box-sizing: border-box;
    }

    /*
     * Evita que los contenedores Bootstrap/host limiten la vista a un
     * max-width fijo. No se usa 100vw porque eso genera overflow cuando
     * existe sidebar.
     */
    .inventario-inicial-host,
    .inventario-inicial-host-clean {
        max-width: none !important;
        min-width: 0 !important;
    }

    .app#app .hero,
    .app#app .view-options,
    .app#app .cards,
    .app#app .panel,
    .app#app .table-panel,
    .app#app .chart-box,
    .app#app .legend {
        width: 100% !important;
        max-width: 100% !important;
        min-width: 0 !important;
    }

    /*
     * La tabla puede ser más ancha por el número de días.
     * Ese excedente se desplaza SOLO dentro del table-wrapper.
     */
    .app#app .table-wrapper {
        display: block !important;
        width: 100% !important;
        max-width: 100% !important;
        min-width: 0 !important;
        overflow-x: auto !important;
        overflow-y: hidden !important;
        -webkit-overflow-scrolling: touch;
    }

    .app#app #tablaPlaneacion {
        max-width: none !important;
    }

    /*
     * La gráfica queda contenida dentro del ancho real de la vista.
     */
    .app#app #graficaDisponible,
    .app#app .bars {
        width: 100% !important;
        max-width: 100% !important;
        min-width: 0 !important;
        overflow-x: auto !important;
    }

    /*
     * Muy importante en CSS Grid/Flex:
     * sin min-width:0 un hijo puede obligar al padre a ser más ancho.
     */
    .app#app .filtros-ejecutivos > *,
    .app#app .kpi-dashboard > *,
    .app#app .panel > * {
        min-width: 0 !important;
    }

    /*
     * En pantallas más angostas los filtros se acomodan sin recortar.
     * No altera el diseño de escritorio amplio.
     */
    @@media (max-width: 1200px) {
        .app#app .filtros-ejecutivos {
            grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        }

        .app#app .kpi-dashboard {
            grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
        }
    }

    @@media (max-width: 760px) {
        .app#app .filtros-ejecutivos {
            grid-template-columns: minmax(0, 1fr) !important;
        }

        .app#app .kpi-dashboard {
            grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        }
    }


    /* =====================================================================
       TEMA TINTO FINAL — PLANEACIÓN EJECUTIVA DE INVENTARIO
       Misma identidad visual del Dashboard de Ventas
       Color principal: #8D3E46

       Se agrega al FINAL del <style> para conservar:
       - responsive / cálculo dinámico con sidebar
       - filtros y multiselect
       - JavaScript y endpoints
       - gráfica
       - colores operativos de las métricas
       - estados negativos / faltantes
       ===================================================================== */

    :root {
        --pei-tinto: #8d3e46;
        --pei-tinto-dark: #78343c;
        --pei-tinto-deep: #5f2930;
        --pei-tinto-light: #984a53;

        --pei-bg: #f2e8ea;
        --pei-panel: #fffafa;
        --pei-panel-2: #f6edef;
        --pei-soft: #f7edef;
        --pei-soft-2: #f1e4e7;

        --pei-line: #d8c0c4;
        --pei-line-dark: #a36d75;
        --pei-text: #382329;
        --pei-muted: #76565d;

        --pei-header:
            linear-gradient(
                180deg,
                #984a53 0%,
                #8d3e46 55%,
                #78343c 100%
            );

        --pei-toolbar:
            linear-gradient(
                180deg,
                #fffafa 0%,
                #f1e4e7 100%
            );

        --pei-shadow:
            0 0 0 1px rgba(255,255,255,.45) inset,
            0 8px 18px rgba(91,44,51,.13);
    }


    /* -----------------------------------------------------------------
       FONDO / CONTENEDOR PRINCIPAL
       ----------------------------------------------------------------- */
    .app#app {
        background: var(--pei-bg) !important;
        color: var(--pei-text) !important;
    }


    /* -----------------------------------------------------------------
       HERO / ENCABEZADO EJECUTIVO
       ----------------------------------------------------------------- */
    .app#app .hero {
        background:
            linear-gradient(
                135deg,
                #fffafa 0%,
                #f6edef 58%,
                #ead7da 100%
            ) !important;

        border: 1px solid var(--pei-line) !important;
        box-shadow: var(--pei-shadow) !important;
    }

    .app#app .planning-title h1 {
        color: #5f2930 !important;
    }

    .app#app .planning-title p {
        color: #76565d !important;
    }

    .app#app .planning-title-icon {
        color: #fff !important;
        border-color: #78343c !important;

        background:
            linear-gradient(
                180deg,
                #984a53 0%,
                #8d3e46 58%,
                #78343c 100%
            ) !important;

        box-shadow: 0 6px 14px rgba(91,44,51,.18) !important;
    }


    /* -----------------------------------------------------------------
       ÚLTIMA CONSULTA
       ----------------------------------------------------------------- */
    .app#app .status-chip {
        border-color: #cfaeb3 !important;

        background:
            linear-gradient(
                180deg,
                #fffafa 0%,
                #f1e4e7 100%
            ) !important;

        color: #663d45 !important;
    }

    .app#app .status-chip strong {
        color: #8d3e46 !important;
    }


    /* -----------------------------------------------------------------
       FILTROS
       ----------------------------------------------------------------- */
    .app#app .filtro-card {
        background: #fffafa !important;
        border-color: #d8c0c4 !important;
        box-shadow: 0 3px 9px rgba(91,44,51,.08) !important;
    }

    .app#app .filtro-card > label {
        color: #704a51 !important;
    }

    .app#app .filtro-card input[type="date"],
    .app#app .multi-trigger,
    .app#app .multi-search input {
        border-color: #c9a8ae !important;
        background: #fff !important;
        color: #382329 !important;
    }

    .app#app .filtro-card input[type="date"]:focus,
    .app#app .multi-trigger:focus,
    .app#app .multi-search input:focus {
        outline: none !important;
        border-color: #8d3e46 !important;
        box-shadow: 0 0 0 3px rgba(141,62,70,.12) !important;
    }

    .app#app .multi-trigger b {
        color: #8d3e46 !important;
    }


    /* -----------------------------------------------------------------
       MULTISELECT
       ----------------------------------------------------------------- */
    .app#app .multi-panel {
        border-color: #c9a8ae !important;
        background: #fffafa !important;
        box-shadow: 0 10px 24px rgba(91,44,51,.18) !important;
    }

    .app#app .multi-search {
        background: #f7edef !important;
        border-bottom-color: #d8c0c4 !important;
    }

    .app#app .multi-option {
        color: #51383d !important;
    }

    .app#app .multi-option:hover {
        background: #f3e5e8 !important;
    }

    .app#app .multi-option.multi-all {
        background: #f7edef !important;
        border-bottom-color: #d8c0c4 !important;
        color: #663d45 !important;
    }

    .app#app .multi-option input[type="checkbox"],
    .app#app .legend-item input[type="checkbox"],
    .app#app .radio-pill input[type="radio"] {
        accent-color: #8d3e46 !important;
    }

    .app#app .multi-help {
        color: #76565d !important;
        background: #f8eff1 !important;
        border-top-color: #d8c0c4 !important;
    }

    .app#app .almacen-badge {
        border-color: #d8c0c4 !important;
        background: #fff !important;
        color: #663d45 !important;
    }

    /*
       La insignia de ráfaga conserva su color operativo definido
       en el CSS original; no la convertimos a tinto.
    */


    /* -----------------------------------------------------------------
       BOTONES
       ----------------------------------------------------------------- */
    .app#app .btn-primary {
        color: #fff !important;
        border-color: #78343c !important;

        background:
            linear-gradient(
                180deg,
                #984a53 0%,
                #8d3e46 55%,
                #78343c 100%
            ) !important;

        box-shadow: 0 4px 10px rgba(91,44,51,.16) !important;
    }

    .app#app .btn-primary:hover {
        color: #fff !important;
        filter: brightness(1.05) !important;
    }

    /*
       "Limpiar" deja de verse negro para formar parte de la identidad
       tinto, pero sigue siendo visualmente secundario.
    */
    .app#app .btn-dark {
        color: #663d45 !important;
        border-color: #c9a8ae !important;

        background:
            linear-gradient(
                180deg,
                #ffffff 0%,
                #f1e4e7 100%
            ) !important;
    }

    .app#app .btn-dark:hover {
        color: #5f2930 !important;
        background: #eadadd !important;
    }


    /* -----------------------------------------------------------------
       SELECTOR COMPLETA / TABLA / GRÁFICA
       ----------------------------------------------------------------- */
    .app#app .view-options {
        background: #fffafa !important;
        border-color: #d8c0c4 !important;
    }

    .app#app .radio-pill {
        border-color: #d8c0c4 !important;
        background: #fff !important;
        color: #663d45 !important;
    }

    .app#app .radio-pill:has(input:checked) {
        border-color: #8d3e46 !important;
        background: #f3e5e8 !important;
        color: #78343c !important;
        box-shadow: inset 0 0 0 1px rgba(141,62,70,.12) !important;
    }


    /* -----------------------------------------------------------------
       KPIs
       ----------------------------------------------------------------- */
    .app#app .card {
        border-color: rgba(255,255,255,.30) !important;
        box-shadow: 0 8px 18px rgba(44,30,33,.12) !important;
    }

    /*
       Alcance es el KPI de identidad general: lo pasamos a tinto.
       Los demás KPI conservan sus colores operativos originales:
       - Disponible
       - Producción
       - Ráfaga
       - Pedidos
       - Faltante
    */
    .app#app .kpi-alcance {
        background:
            linear-gradient(
                135deg,
                #5f2930 0%,
                #8d3e46 58%,
                #3e1b20 100%
            ) !important;

        color: #fff !important;
    }

    .app#app .kpi-alcance span,
    .app#app .kpi-alcance strong,
    .app#app .kpi-alcance em {
        color: #fff !important;
    }


    /* -----------------------------------------------------------------
       PANELES
       ----------------------------------------------------------------- */
    .app#app .panel,
    .app#app .table-panel,
    .app#app .chart-box {
        background: #fffafa !important;
        border-color: #d8c0c4 !important;
        box-shadow: var(--pei-shadow) !important;
    }

    .app#app .panel-title {
        background:
            linear-gradient(
                180deg,
                #984a53 0%,
                #8d3e46 55%,
                #78343c 100%
            ) !important;

        color: #fff !important;
        border-color: #6d3037 !important;
    }

    .app#app .panel-title strong,
    .app#app .panel-title span {
        color: #fff !important;
    }


    /* -----------------------------------------------------------------
       TABLA
       ----------------------------------------------------------------- */
    .app#app .table-wrapper {
        background: #fffafa !important;
        border-color: #d8c0c4 !important;
    }

    .app#app #tablaPlaneacion {
        background: #fffafa !important;
    }

    .app#app #tablaPlaneacion thead th {
        background:
            linear-gradient(
                180deg,
                #984a53 0%,
                #8d3e46 55%,
                #78343c 100%
            ) !important;

        color: #fff !important;
        border-color: #6d3037 !important;
    }

    .app#app #tablaPlaneacion .sticky-alcance,
    .app#app #tablaPlaneacion .sticky-concepto {
        border-color: #d8c0c4 !important;
    }

    /*
       NO se fuerzan fondos de las filas de Inventario, Producción,
       Ráfaga, Pedidos y Disponible: conservan sus colores semánticos.
    */


    /* -----------------------------------------------------------------
       LEYENDA
       ----------------------------------------------------------------- */
    .app#app .legend {
        background: #f7edef !important;
        border-color: #d8c0c4 !important;
    }

    .app#app .legend-item {
        color: #51383d !important;
        border-color: transparent !important;
    }

    .app#app .legend-item:hover {
        background: #f1e4e7 !important;
    }

    /*
       Los puntos de la leyenda (.dot-blue, .dot-green, .dot-purple,
       .dot-orange, .dot-gray) NO se cambian porque identifican cada
       métrica en la gráfica.
    */


    /* -----------------------------------------------------------------
       GRÁFICA
       ----------------------------------------------------------------- */
    .app#app .bars {
        background: #fffafa !important;
    }

    /*
       Las clases de barras de Inventario / Producción / Ráfaga /
       Pedidos / Disponible mantienen sus colores originales.
    */


    /* -----------------------------------------------------------------
       ESTADOS NEGATIVOS / FALTANTES
       ----------------------------------------------------------------- */
    .app#app .valor-negativo {
        color: #b42318 !important;
        font-weight: 800 !important;
    }


    /* -----------------------------------------------------------------
       SCROLLBAR EN TABLA / GRÁFICA / SELECTORES
       ----------------------------------------------------------------- */
    .app#app .table-wrapper::-webkit-scrollbar,
    .app#app .bars::-webkit-scrollbar,
    .app#app .multi-options::-webkit-scrollbar {
        width: 8px;
        height: 8px;
    }

    .app#app .table-wrapper::-webkit-scrollbar-track,
    .app#app .bars::-webkit-scrollbar-track,
    .app#app .multi-options::-webkit-scrollbar-track {
        background: #f1e4e7;
    }

    .app#app .table-wrapper::-webkit-scrollbar-thumb,
    .app#app .bars::-webkit-scrollbar-thumb,
    .app#app .multi-options::-webkit-scrollbar-thumb {
        background: #8d3e46;
    }

    .app#app .table-wrapper::-webkit-scrollbar-thumb:hover,
    .app#app .bars::-webkit-scrollbar-thumb:hover,
    .app#app .multi-options::-webkit-scrollbar-thumb:hover {
        background: #78343c;
    }


    /* =====================================================================
       DARK MODE — IDENTIDAD TINTO
       ===================================================================== */
    :is(
        html[data-theme="dark"],
        body[data-theme="dark"],
        html[data-bs-theme="dark"],
        body[data-bs-theme="dark"],
        html.dark,
        body.dark
    ) .app#app .panel-title,

    :is(
        html[data-theme="dark"],
        body[data-theme="dark"],
        html[data-bs-theme="dark"],
        body[data-bs-theme="dark"],
        html.dark,
        body.dark
    ) .app#app #tablaPlaneacion thead th,

    :is(
        html[data-theme="dark"],
        body[data-theme="dark"],
        html[data-bs-theme="dark"],
        body[data-bs-theme="dark"],
        html.dark,
        body.dark
    ) .app#app .btn-primary {
        background:
            linear-gradient(
                180deg,
                #8d3e46 0%,
                #78343c 58%,
                #51242a 100%
            ) !important;

        color: #fff !important;
        border-color: #51242a !important;
    }


    /* =====================================================================
       FIN TEMA TINTO
       ===================================================================== */

</style>

<link rel="stylesheet" href="~/css/planeacion-ejecutiva-inventario-erp-compacto.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/planeacion-ejecutiva-inventario-filtros-fix.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/planeacion-ejecutiva-inventario-tabla-legible.css" asp-append-version="true" />

<div class="app" id="app" data-modo-vista="completa">

    <section class="hero">
        <div class="planning-title">
            <div class="planning-title-icon">
                <i class="fa-solid fa-chart-column"></i>
            </div>
            <div class="title-block">
                <h1>Planeación Ejecutiva de Inventario, Producción y Pedidos</h1>
                <p>Proyección diaria de inventario, producción, liberaciones, pedidos y disponibilidad.</p>
            </div>
        </div>

        <div class="status-chip">
            <span>Última consulta</span>
            <strong id="ultimaConsulta">Sin cargar</strong>
        </div>

        <div class="filtros-ejecutivos">
            <div class="filtro-card">
                <label>MASTER / Familia</label>
                <div class="multi-select" id="masterSelect">
                    <button type="button" class="multi-trigger" onclick="toggleMultiSelect('masterSelect')">
                        <span id="masterSelectText">Cargando...</span>
                        <b>▾</b>
                    </button>

                    <div class="multi-panel">
                        <div class="multi-search">
                            <input type="text" placeholder="Buscar MASTER..." oninput="filtrarOpciones('masterSelect', this.value)" />
                        </div>

                        <label class="multi-option multi-all">
                            <input id="masterAllCheck" type="checkbox" checked onchange="seleccionarTodos('masterSelect', this.checked)" />
                            <span>Seleccionar todo</span>
                        </label>

                        <div class="multi-options" id="masterOptions"></div>
                    </div>
                </div>
            </div>

            <div class="filtro-card">
                <label>Clasificación</label>
                <div class="multi-select" id="clasificacionSelect">
                    <button type="button" class="multi-trigger" onclick="toggleMultiSelect('clasificacionSelect')">
                        <span id="clasificacionSelectText">Cargando...</span>
                        <b>▾</b>
                    </button>

                    <div class="multi-panel">
                        <div class="multi-search">
                            <input type="text" placeholder="Buscar clasificación..." oninput="filtrarOpciones('clasificacionSelect', this.value)" />
                        </div>

                        <label class="multi-option multi-all">
                            <input id="clasificacionAllCheck" type="checkbox" checked onchange="seleccionarTodos('clasificacionSelect', this.checked)" />
                            <span>Seleccionar todas</span>
                        </label>

                        <div class="multi-options" id="clasificacionOptions"></div>
                    </div>
                </div>
            </div>

            <div class="filtro-card">
                <label>SKU / Producto</label>
                <div class="multi-select" id="skuSelect">
                    <button type="button" class="multi-trigger" onclick="toggleMultiSelect('skuSelect')">
                        <span id="skuSelectText">Cargando...</span>
                        <b>▾</b>
                    </button>

                    <div class="multi-panel">
                        <div class="multi-search">
                            <input type="text" placeholder="Buscar SKU o producto..." oninput="filtrarOpciones('skuSelect', this.value)" />
                        </div>

                        <label class="multi-option multi-all">
                            <input id="skuAllCheck" type="checkbox" checked onchange="seleccionarTodos('skuSelect', this.checked)" />
                            <span>Seleccionar todo</span>
                        </label>

                        <div class="multi-options" id="skuOptions"></div>
                    </div>
                </div>
            </div>

            <div class="filtro-card">
                <label>Almacenes considerados</label>
                <div class="multi-select" id="almacenSelect">
                    <button type="button" class="multi-trigger" onclick="toggleMultiSelect('almacenSelect')">
                        <span id="almacenSelectText">Cargando...</span>
                        <b>▾</b>
                    </button>

                    <div class="multi-panel">
                        <div class="multi-search">
                            <input type="text" placeholder="Buscar almacén..." oninput="filtrarOpciones('almacenSelect', this.value)" />
                        </div>

                        <label class="multi-option multi-all">
                            <input id="almacenAllCheck" type="checkbox" checked onchange="seleccionarTodos('almacenSelect', this.checked)" />
                            <span>Considerar todos</span>
                        </label>

                        <div class="multi-options" id="almacenOptions"></div>

                        <div class="multi-help">
                            0 días = disponible inmediato. Los almacenes con ráfaga se liberan automáticamente en la fecha correspondiente.
                        </div>
                    </div>
                </div>
            </div>

            <div class="filtro-card fechas">
                <label>Desde</label>
                <input id="fechaInicioInput" type="date" onchange="recargarFiltrosYDatos()" />
            </div>

            <div class="filtro-card fechas">
                <label>Hasta</label>
                <input id="fechaFinInput" type="date" onchange="recargarFiltrosYDatos()" />
            </div>

            <div class="filtro-card">
                <label>Acciones</label>
                <div class="actions">
                    <button type="button" class="btn btn-primary" onclick="cargarDatosSql()">Actualizar</button>
                    <button type="button" class="btn btn-dark" onclick="limpiarFiltros()">Limpiar</button>
                </div>
            </div>
        </div>
    </section>

    <div class="view-options" role="radiogroup" aria-label="Modo de visualización">
        <label class="radio-pill">
            <input type="radio" name="modoVista" value="completa" checked onchange="cambiarModoVista(this.value)" />
            Completa
        </label>
        <label class="radio-pill">
            <input type="radio" name="modoVista" value="tabla" onchange="cambiarModoVista(this.value)" />
            Solo tabla
        </label>
        <label class="radio-pill">
            <input type="radio" name="modoVista" value="grafica" onchange="cambiarModoVista(this.value)" />
            Solo gráfica
        </label>
    </div>

    <section class="cards kpi-dashboard">
        <div class="card kpi-card-color kpi-alcance">
            <span>Alcance</span>
            <strong id="kpiAlcance">-</strong>
            <em id="kpiAlcanceDetalle">Sin selección</em>
        </div>

        <div class="card kpi-card-color kpi-disponible">
            <span>Disponible final KG</span>
            <strong id="kpiDisponibleFinal">0</strong>
            <em>Inventario proyectado al cierre</em>
        </div>

        <div class="card kpi-card-color kpi-produccion">
            <span>Producción total KG</span>
            <strong id="kpiProduccionTotal">0</strong>
            <em>Planeación acumulada</em>
        </div>

        <div class="card kpi-card-color kpi-rafaga">
            <span>Liberación ráfaga KG</span>
            <strong id="kpiRafagaTotal">0</strong>
            <em>Inventario liberado en el rango</em>
        </div>

        <div class="card kpi-card-color kpi-pedidos">
            <span>Pedidos totales KG</span>
            <strong id="kpiPedidosTotal">0</strong>
            <em>Compromiso acumulado</em>
        </div>

        <div class="card kpi-card-color kpi-faltante">
            <span>Días con faltante</span>
            <strong id="kpiDiasFaltante">0</strong>
            <em>Disponible negativo</em>
        </div>
    </section>

    <section class="panel table-panel">
        <div class="panel-title">
            <strong>Detalle diario KG</strong>
            <span id="tablaResumen">Inventario disponible + Producción + Liberación de ráfaga - Pedidos = Disponible</span>
        </div>

        <div class="table-wrapper">
