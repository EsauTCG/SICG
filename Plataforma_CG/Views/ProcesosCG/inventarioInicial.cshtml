@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Planeación Ejecutiva de Inventario";
}

<link rel="stylesheet" href="~/css/planeacion-ejecutiva-inventario-grid.css" asp-append-version="true" />

<div class="app" id="app" data-modo-vista="completa">

    <section class="hero">
        <div class="planning-title">
            <div class="planning-title-icon">
                <i class="fa-solid fa-chart-column"></i>
            </div>
            <div class="title-block">
                <h1>Planeación Ejecutiva de Inventario, Producción y Pedidos</h1>
                <p>Proyección diaria de inventario, producción, liberaciones, pedidos y disponibilidad.</p>
            </div>
        </div>

        <div class="status-chip">
            <span>Última consulta</span>
            <strong id="ultimaConsulta">Sin cargar</strong>
        </div>

        <div class="filtros-ejecutivos">
            <div class="filtro-card">
                <label>MASTER / Familia</label>
                <div class="multi-select" id="masterSelect">
                    <button type="button" class="multi-trigger" onclick="toggleMultiSelect('masterSelect')">
                        <span id="masterSelectText">Cargando...</span>
                        <b>▾</b>
                    </button>

                    <div class="multi-panel">
                        <div class="multi-search">
                            <input type="text" placeholder="Buscar MASTER..." oninput="filtrarOpciones('masterSelect', this.value)" />
                        </div>

                        <label class="multi-option multi-all">
                            <input id="masterAllCheck" type="checkbox" checked onchange="seleccionarTodos('masterSelect', this.checked)" />
                            <span>Seleccionar todo</span>
                        </label>

                        <div class="multi-options" id="masterOptions"></div>
                    </div>
                </div>
            </div>

            <div class="filtro-card">
                <label>Clasificación</label>
                <div class="multi-select" id="clasificacionSelect">
                    <button type="button" class="multi-trigger" onclick="toggleMultiSelect('clasificacionSelect')">
                        <span id="clasificacionSelectText">Cargando...</span>
                        <b>▾</b>
                    </button>

                    <div class="multi-panel">
                        <div class="multi-search">
                            <input type="text" placeholder="Buscar clasificación..." oninput="filtrarOpciones('clasificacionSelect', this.value)" />
                        </div>

                        <label class="multi-option multi-all">
                            <input id="clasificacionAllCheck" type="checkbox" checked onchange="seleccionarTodos('clasificacionSelect', this.checked)" />
                            <span>Seleccionar todas</span>
                        </label>

                        <div class="multi-options" id="clasificacionOptions"></div>
                    </div>
                </div>
            </div>

            <div class="filtro-card">
                <label>SKU / Producto</label>
                <div class="multi-select" id="skuSelect">
                    <button type="button" class="multi-trigger" onclick="toggleMultiSelect('skuSelect')">
                        <span id="skuSelectText">Cargando...</span>
                        <b>▾</b>
                    </button>

                    <div class="multi-panel">
                        <div class="multi-search">
                            <input type="text" placeholder="Buscar SKU o producto..." oninput="filtrarOpciones('skuSelect', this.value)" />
                        </div>

                        <label class="multi-option multi-all">
                            <input id="skuAllCheck" type="checkbox" checked onchange="seleccionarTodos('skuSelect', this.checked)" />
                            <span>Seleccionar todo</span>
                        </label>

                        <div class="multi-options" id="skuOptions"></div>
                    </div>
                </div>
            </div>

            <div class="filtro-card">
                <label>Almacenes considerados</label>
                <div class="multi-select" id="almacenSelect">
                    <button type="button" class="multi-trigger" onclick="toggleMultiSelect('almacenSelect')">
                        <span id="almacenSelectText">Cargando...</span>
                        <b>▾</b>
                    </button>

                    <div class="multi-panel">
                        <div class="multi-search">
                            <input type="text" placeholder="Buscar almacén..." oninput="filtrarOpciones('almacenSelect', this.value)" />
                        </div>

                        <label class="multi-option multi-all">
                            <input id="almacenAllCheck" type="checkbox" checked onchange="seleccionarTodos('almacenSelect', this.checked)" />
                            <span>Considerar todos</span>
                        </label>

                        <div class="multi-options" id="almacenOptions"></div>

                        <div class="multi-help">
                            0 días = disponible inmediato. Los almacenes con ráfaga se liberan automáticamente en la fecha correspondiente.
                        </div>
                    </div>
                </div>
            </div>

            <div class="filtro-card fechas">
                <label>Desde</label>
                <input id="fechaInicioInput" type="date" onchange="recargarFiltrosYDatos()" />
            </div>

            <div class="filtro-card fechas">
                <label>Hasta</label>
                <input id="fechaFinInput" type="date" onchange="recargarFiltrosYDatos()" />
            </div>

            <div class="filtro-card">
                <label>Acciones</label>
                <div class="actions">
                    <button type="button" class="btn btn-primary" onclick="cargarDatosSql()">Actualizar</button>
                    <button type="button" class="btn btn-dark" onclick="limpiarFiltros()">Limpiar</button>
                </div>
            </div>
        </div>
    </section>

    <div class="view-options" role="radiogroup" aria-label="Modo de visualización">
        <label class="radio-pill">
            <input type="radio" name="modoVista" value="completa" checked onchange="cambiarModoVista(this.value)" />
            Completa
        </label>
        <label class="radio-pill">
            <input type="radio" name="modoVista" value="tabla" onchange="cambiarModoVista(this.value)" />
            Solo tabla
        </label>
        <label class="radio-pill">
            <input type="radio" name="modoVista" value="grafica" onchange="cambiarModoVista(this.value)" />
            Solo gráfica
        </label>
    </div>

    <section class="cards kpi-dashboard">
        <div class="card kpi-card-color kpi-alcance">
            <span>Alcance</span>
            <strong id="kpiAlcance">-</strong>
            <em id="kpiAlcanceDetalle">Sin selección</em>
        </div>

        <div class="card kpi-card-color kpi-disponible">
            <span>Disponible final KG</span>
            <strong id="kpiDisponibleFinal">0</strong>
            <em>Inventario proyectado al cierre</em>
        </div>

        <div class="card kpi-card-color kpi-produccion">
            <span>Producción total KG</span>
            <strong id="kpiProduccionTotal">0</strong>
            <em>Planeación acumulada</em>
        </div>

        <div class="card kpi-card-color kpi-rafaga">
            <span>Liberación ráfaga KG</span>
            <strong id="kpiRafagaTotal">0</strong>
            <em>Inventario liberado en el rango</em>
        </div>

        <div class="card kpi-card-color kpi-pedidos">
            <span>Pedidos totales KG</span>
            <strong id="kpiPedidosTotal">0</strong>
            <em>Compromiso acumulado</em>
        </div>

        <div class="card kpi-card-color kpi-faltante">
            <span>Días con faltante</span>
            <strong id="kpiDiasFaltante">0</strong>
            <em>Disponible negativo</em>
        </div>
    </section>

    <section class="panel table-panel">
        <div class="panel-title">
            <strong>Detalle diario KG</strong>
            <span id="tablaResumen">Inventario disponible + Producción + Liberación de ráfaga - Pedidos = Disponible</span>
        </div>

        <div class="table-wrapper">
            <table id="tablaPlaneacion">
                <thead>
                    <tr id="filaFechas">
                        <th class="sticky-alcance">Alcance</th>
                        <th class="sticky-concepto">Concepto</th>
                    </tr>
                </thead>

                <tbody>
                    <tr class="row-inventario" id="filaInventario">
                        <td class="sticky-alcance">-</td>
                        <td class="sticky-concepto">Inventario KG</td>
                    </tr>

                    <tr class="row-produccion" id="filaProduccion">
                        <td class="sticky-alcance">-</td>
                        <td class="sticky-concepto">Producción KG</td>
                    </tr>

                    <tr class="row-rafaga" id="filaRafaga">
                        <td class="sticky-alcance">-</td>
                        <td class="sticky-concepto">Liberación ráfaga KG</td>
                    </tr>

                    <tr class="row-pedidos" id="filaPedidos">
                        <td class="sticky-alcance">-</td>
                        <td class="sticky-concepto">Pedidos KG</td>
                    </tr>

                    <tr class="row-disponible" id="filaDisponible">
                        <td class="sticky-alcance">-</td>
                        <td class="sticky-concepto">Disponible KG</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="legend" role="group" aria-label="Filtros de indicadores">
            <label class="legend-item" data-filtro="inventario">
                <input type="checkbox" checked onchange="cambiarFiltroMetrica('inventario', this.checked)" />
                <span class="dot dot-blue"></span> Inventario
            </label>
            <label class="legend-item" data-filtro="produccion">
                <input type="checkbox" checked onchange="cambiarFiltroMetrica('produccion', this.checked)" />
                <span class="dot dot-green"></span> Producción
            </label>
            <label class="legend-item" data-filtro="rafaga">
                <input type="checkbox" checked onchange="cambiarFiltroMetrica('rafaga', this.checked)" />
                <span class="dot dot-purple"></span> Liberación ráfaga
            </label>
            <label class="legend-item" data-filtro="pedidos">
                <input type="checkbox" checked onchange="cambiarFiltroMetrica('pedidos', this.checked)" />
                <span class="dot dot-orange"></span> Pedidos
            </label>
            <label class="legend-item" data-filtro="disponible">
                <input type="checkbox" checked onchange="cambiarFiltroMetrica('disponible', this.checked)" />
                <span class="dot dot-gray"></span> Disponible
            </label>
        </div>
    </section>

    <section class="panel chart-box">
        <div class="panel-title">
            <strong>Comportamiento diario</strong>
            <span>Comparativo de inventario, producción, liberación de ráfaga, pedidos y disponible</span>
        </div>

        <div class="bars" id="graficaDisponible"></div>
    </section>

</div>


<script>
(function () {
    'use strict';

    function prepararContenedorInventarioInicial() {
        const root = document.querySelector('.app#app');
        if (!root) return;

        let parent = root.parentElement;

        while (parent && parent !== document.body) {
            if (
                parent.matches('.container, .container-fluid, .pb-3') ||
                parent.matches('main[role="main"]')
            ) {
                parent.classList.add(
                    'inventario-inicial-host',
                    'inventario-inicial-host-clean'
                );
            }

            parent = parent.parentElement;
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener(
            'DOMContentLoaded',
            prepararContenedorInventarioInicial,
            { once: true }
        );
    } else {
        prepararContenedorInventarioInicial();
    }
})();
</script>

<script>
(function () {
    'use strict';

    /*
     * AJUSTE LIGERO DE ANCHO
     * Antes esta vista hacía búsquedas geométricas, intervalos cada 70 ms,
     * ResizeObserver y MutationObserver sobre varios elementos.
     * Eso fuerza lecturas/escrituras de layout repetidas mientras la página
     * todavía está construyendo filtros, tabla y gráfica.
     *
     * Ahora se mide una sola vez por frame y únicamente cuando realmente
     * cambia el tamaño de ventana o la clase/estilo del sidebar.
     */
    const ROOT_SELECTOR = '.app#app';
    const SIDEBAR_SELECTOR = '#sidebar, .sidebar, .layout-sidebar';

    let root = null;
    let sidebar = null;
    let rafId = 0;
    let lastLeft = -1;
    let lastWidth = -1;

    function obtenerSidebar() {
        if (sidebar && document.documentElement.contains(sidebar)) {
            return sidebar;
        }

        sidebar = document.querySelector(SIDEBAR_SELECTOR);
        return sidebar;
    }

    function solicitarAjuste() {
        if (rafId) {
            cancelAnimationFrame(rafId);
        }

        rafId = requestAnimationFrame(aplicarAjuste);
    }

    function aplicarAjuste() {
        rafId = 0;

        root ??= document.querySelector(ROOT_SELECTOR);
        if (!root || !root.parentElement) return;

        const parentRect = root.parentElement.getBoundingClientRect();
        const sb = obtenerSidebar();

        let sidebarRight = 0;

        if (sb) {
            const style = getComputedStyle(sb);

            if (
                style.display !== 'none' &&
                style.visibility !== 'hidden' &&
                Number.parseFloat(style.opacity || '1') > 0.05
            ) {
                const rect = sb.getBoundingClientRect();

                if (rect.width >= 120 && rect.right > 0) {
                    sidebarRight = Math.max(0, Math.round(rect.right));
                }
            }
        }

        const targetLeft = Math.max(parentRect.left, sidebarRight);
        const leftOffset = Math.max(0, Math.round(targetLeft - parentRect.left));
        const availableWidth = Math.max(320, Math.floor(parentRect.right - targetLeft));

        if (
            Math.abs(availableWidth - lastWidth) < 2 &&
            Math.abs(leftOffset - lastLeft) < 2
        ) {
            return;
        }

        lastWidth = availableWidth;
        lastLeft = leftOffset;

        root.style.setProperty('position', 'relative', 'important');
        root.style.setProperty('left', leftOffset + 'px', 'important');
        root.style.setProperty('width', availableWidth + 'px', 'important');
        root.style.setProperty('max-width', availableWidth + 'px', 'important');
        root.style.setProperty('margin-left', '0', 'important');
        root.style.setProperty('margin-right', '0', 'important');
    }

    function iniciar() {
        root = document.querySelector(ROOT_SELECTOR);
        if (!root) return;

        sidebar = obtenerSidebar();
        solicitarAjuste();

        window.addEventListener('resize', solicitarAjuste, { passive: true });
        window.addEventListener('orientationchange', solicitarAjuste, { passive: true });

        if (sidebar && 'MutationObserver' in window) {
            const observer = new MutationObserver(solicitarAjuste);

            observer.observe(sidebar, {
                attributes: true,
                attributeFilter: ['class', 'style', 'aria-hidden']
            });
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', iniciar, { once: true });
    } else {
        iniciar();
    }
})();
</script>

<script>
    let datos = [];
    let modoVista = "completa";
    const DIAS_ADELANTE = 23;
    const SOLO_SKU_CON_INVENTARIO_O_PRODUCCION = true;
    let catalogoDepuradoPorMovimiento = false;
    let consultaDatosEnCurso = false;
    let controladorConsultaDatos = null;
    let secuenciaConsultaDatos = 0;
    let temporizadorCargaDatos = null;

    // Evita recrear Intl.NumberFormat cientos de veces durante cada render.
    const FORMATEADOR_NUMERO = new Intl.NumberFormat("es-MX", {
        minimumFractionDigits: 0,
        maximumFractionDigits: 3
    });

    // El catálogo SKU puede tener cientos/miles de registros.
    // No construimos ese DOM hasta que el usuario abra el selector.
    let skuOptionsDirty = true;
    let skuOptionsRendered = false;

    let filtrosCatalogo = {
        masters: [],
        clasificaciones: [],
        skus: [],
        almacenes: []
    };

    let seleccion = {
        masters: [],
        clasificaciones: [],
        skus: [],
        almacenes: []
    };

    let filtrosMetricas = {
        inventario: true,
        produccion: true,
        rafaga: true,
        pedidos: true,
        disponible: true
    };

    const metricasGrafica = [
        { key: "inventario", nombre: "Inventario", clase: "inventario" },
        { key: "produccion", nombre: "Producción", clase: "produccion" },
        { key: "rafaga", nombre: "Liberación ráfaga", clase: "rafaga" },
        { key: "pedidos", nombre: "Pedidos", clase: "pedidos" },
        { key: "disponible", nombre: "Disponible", clase: "disponible" }
    ];

    function escapeHtml(value) {
        return String(value ?? "")
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");
    }

    function normalizarTexto(value) {
        return String(value ?? "").trim().toUpperCase();
    }

    function formatoNumero(valor) {
        return FORMATEADOR_NUMERO.format(Number(valor || 0));
    }

    function normalizarNumero(valor) {
        const numero = Number(valor);
        return isNaN(numero) ? 0 : numero;
    }

    function claseNegativo(valor) {
        return normalizarNumero(valor) < 0 ? "valor-negativo" : "";
    }

    function obtenerCampo(row, camelCase, pascalCase, defaultValue = 0) {
        if (!row) return defaultValue;
        return row[camelCase] ?? row[pascalCase] ?? defaultValue;
    }

    function obtenerTextoCampo(row, nombres, defaultValue = "") {
        if (!row) return defaultValue;

        for (const nombre of nombres) {
            if (row[nombre] !== undefined && row[nombre] !== null) {
                return String(row[nombre]);
            }
        }

        return defaultValue;
    }

    function obtenerSkuRow(row) {
        return normalizarTexto(obtenerTextoCampo(row, [
            "sku", "Sku", "SKU",
            "articulo", "Articulo",
            "itemCode", "ItemCode",
            "productoCodigo", "ProductoCodigo",
            "codigoProducto", "CodigoProducto"
        ], ""));
    }

    function filaTieneInventarioOProduccion(row) {
        const inventario = normalizarNumero(obtenerCampo(row, "kgInventario", "KgInventario", 0));
        const produccion = normalizarNumero(obtenerCampo(row, "kgProduccion", "KgProduccion", 0));
        const rafaga = normalizarNumero(obtenerCampo(row, "kgLiberacionRafaga", "KgLiberacionRafaga", 0));

        return inventario > 0 || produccion > 0 || rafaga > 0;
    }

    function obtenerSkusConInventarioOProduccion(rows) {
        const skus = new Set();

        (rows || []).forEach(row => {
            const sku = obtenerSkuRow(row);

            if (sku && filaTieneInventarioOProduccion(row)) {
                skus.add(sku);
            }
        });

        return skus;
    }

    function aplicarCatalogoSkusConMovimiento(rows, consultaSinFiltros) {
        /*
           No depurar el catálogo desde el resultado de InventarioInicialDatos.
           Ese endpoint puede regresar filas consolidadas como "TODOS" o "123 SKU".
           Si se usa eso para filtrar el catálogo, se borran MASTER/SKU y el combo queda vacío.
           Los filtros deben venir de /ProcesosCG/InventarioInicialFiltros.
        */
        return;
    }

    function fechaDesdeValor(valor) {
        if (!valor) return null;

        if (valor instanceof Date && !isNaN(valor.getTime())) {
            const f = new Date(valor);
            f.setHours(0, 0, 0, 0);
            return f;
        }

        const texto = String(valor).trim();
        const iso = texto.substring(0, 10);
        const mIso = iso.match(/^(\d{4})-(\d{2})-(\d{2})$/);

        if (mIso) {
            const f = new Date(Number(mIso[1]), Number(mIso[2]) - 1, Number(mIso[3]));
            f.setHours(0, 0, 0, 0);
            return f;
        }

        const mMx = texto.match(/^(\d{2})\/(\d{2})\/(\d{2}|\d{4})$/);
        if (mMx) {
            const year = mMx[3].length === 2 ? 2000 + Number(mMx[3]) : Number(mMx[3]);
            const f = new Date(year, Number(mMx[2]) - 1, Number(mMx[1]));
            f.setHours(0, 0, 0, 0);
            return f;
        }

        const fecha = new Date(texto);
        if (isNaN(fecha.getTime())) return null;

        fecha.setHours(0, 0, 0, 0);
        return fecha;
    }

    function fechaKey(fecha) {
        const f = fechaDesdeValor(fecha);
        if (!f) return "";

        const year = f.getFullYear();
        const month = String(f.getMonth() + 1).padStart(2, "0");
        const day = String(f.getDate()).padStart(2, "0");

        return `${year}-${month}-${day}`;
    }

    function fechaCorta(valor) {
        const fecha = fechaDesdeValor(valor);
        if (!fecha) return "Actual";

        return fecha.toLocaleDateString("es-MX", {
            day: "2-digit",
            month: "2-digit",
            year: "2-digit"
        });
    }

    function formatoInputFecha(fecha) {
        const f = fechaDesdeValor(fecha);
        if (!f) return "";
        return fechaKey(f);
    }

    function sumarDiasInput(fechaIso, dias) {
        const f = fechaDesdeValor(fechaIso);
        if (!f) return "";
        f.setDate(f.getDate() + Number(dias || 0));
        return formatoInputFecha(f);
    }

    function inicializarRangoFechas() {
        const inicio = document.getElementById("fechaInicioInput");
        const fin = document.getElementById("fechaFinInput");

        const hoy = new Date();
        hoy.setHours(0, 0, 0, 0);

        const fechaFin = new Date(hoy);
        fechaFin.setDate(hoy.getDate() + DIAS_ADELANTE);

        if (inicio && !inicio.value) {
            inicio.value = formatoInputFecha(hoy);
        }

        if (fin && !fin.value) {
            fin.value = formatoInputFecha(fechaFin);
        }
    }

    function obtenerRangoFechas() {
        const inicioInput = document.getElementById("fechaInicioInput")?.value || "";
        const finInput = document.getElementById("fechaFinInput")?.value || "";

        let inicio = fechaDesdeValor(inicioInput);
        let fin = fechaDesdeValor(finInput);

        if (!inicio) {
            inicio = new Date();
            inicio.setHours(0, 0, 0, 0);
        }

        if (!fin) {
            fin = new Date(inicio);
            fin.setDate(inicio.getDate() + DIAS_ADELANTE);
        }

        if (fin < inicio) {
            const temp = inicio;
            inicio = fin;
            fin = temp;
        }

        return { inicio, fin };
    }

    function crearCalendarioRango(fechaInicio, fechaFin) {
        const inicio = fechaDesdeValor(fechaInicio);
        const fin = fechaDesdeValor(fechaFin);
        const calendario = [];

        if (!inicio || !fin) return calendario;

        const actual = new Date(inicio);
        actual.setHours(0, 0, 0, 0);

        const limite = new Date(fin);
        limite.setHours(0, 0, 0, 0);

        while (actual <= limite) {
            calendario.push({
                fecha: fechaCorta(actual),
                fechaKey: fechaKey(actual),
                inventario: 0,
                produccion: 0,
                rafaga: 0,
                pedidos: 0,
                disponible: 0
            });

            actual.setDate(actual.getDate() + 1);
        }

        return calendario;
    }

    function actualizarEstadoConsulta(texto) {
        const ultima = document.getElementById("ultimaConsulta");
        if (ultima) ultima.textContent = texto || "Sin cargar";
    }

    function setCargando(activo) {
        const app = document.getElementById("app");
        if (app) app.classList.toggle("loading", Boolean(activo));
    }

    async function cargarFiltrosIniciales(preservarSeleccion = false) {
        const seleccionAnterior = {
            masters: [...seleccion.masters],
            clasificaciones: [...seleccion.clasificaciones],
            skus: [...seleccion.skus],
            almacenes: [...seleccion.almacenes]
        };

        try {
            setCargando(true);

            const rango = obtenerRangoFechas();
            const fechaInicio = formatoInputFecha(rango.inicio);
            const fechaFin = formatoInputFecha(rango.fin);
            const fechaInventarioInicial = sumarDiasInput(fechaInicio, -1);

            const params = new URLSearchParams({
                fechaInicio: fechaInicio,
                fechaFin: fechaFin,
                fechaInventarioInicial: fechaInventarioInicial,
                // Los combos se cargan del catálogo activo.
                // La depuración por movimiento se aplica en la consulta de datos.
                soloSkuMovimiento: "false"
            });

            const tFiltros = performance.now();

            const response = await fetch(`/ProcesosCG/InventarioInicialFiltros?${params.toString()}`, {
                method: "GET",
                headers: { "Accept": "application/json" }
            });

            const json = await response.json();

            console.debug(
                `[Planeación] Filtros: ${Math.round(performance.now() - tFiltros)} ms`
            );

            if (!response.ok || !json.ok) {
                throw new Error([json.msg, json.error, json.inner].filter(Boolean).join("\n") || "No se pudieron cargar los filtros.");
            }

            filtrosCatalogo.masters = (json.masters || json.Masters || []).map(x => ({
                value: normalizarTexto(x.value ?? x.Value),
                text: String(x.text ?? x.Text ?? x.value ?? x.Value ?? ""),
                totalSkus: Number(x.totalSkus ?? x.TotalSkus ?? 0)
            })).filter(x => x.value);

            filtrosCatalogo.clasificaciones = (json.clasificaciones || json.Clasificaciones || []).map(x => ({
                value: normalizarTexto(x.value ?? x.Value ?? x.clasificacion ?? x.Clasificacion),
                text: String(x.text ?? x.Text ?? x.value ?? x.Value ?? x.clasificacion ?? x.Clasificacion ?? ""),
                totalSkus: Number(x.totalSkus ?? x.TotalSkus ?? 0)
            })).filter(x => x.value);

            filtrosCatalogo.skus = (json.skus || json.Skus || []).map(x => ({
                value: normalizarTexto(x.value ?? x.Value),
                text: String(x.text ?? x.Text ?? x.value ?? x.Value ?? ""),
                articulo: String(x.articulo ?? x.Articulo ?? ""),
                master: normalizarTexto(x.master ?? x.Master ?? x.masterProducto ?? x.MasterProducto),
                clasificacion: normalizarTexto(
                    x.clasificacion ?? x.Clasificacion ?? "SIN CLASIFICACIÓN"
                ) || "SIN CLASIFICACIÓN"
            })).filter(x => x.value);

            filtrosCatalogo.almacenes = (json.almacenes || json.Almacenes || []).map(x => ({
                value: normalizarTexto(x.value ?? x.Value ?? x.almacen ?? x.Almacen),
                text: String(x.text ?? x.Text ?? x.almacen ?? x.Almacen ?? ""),
                diasRafaga: Number(x.diasRafaga ?? x.DiasRafaga ?? 0),
                esRafaga: Boolean(x.esRafaga ?? x.EsRafaga ?? false),
                activo: Boolean(x.activo ?? x.Activo ?? true),
                seleccionadoPredeterminado: Boolean(
                    x.seleccionadoPredeterminado ??
                    x.SeleccionadoPredeterminado ??
                    true
                ),
                totalCajas: normalizarNumero(x.totalCajas ?? x.TotalCajas ?? 0),
                totalKg: normalizarNumero(x.totalKg ?? x.TotalKg ?? 0)
            })).filter(x => x.value && x.activo);

            if (preservarSeleccion) {
                const mastersPermitidos = new Set(filtrosCatalogo.masters.map(x => x.value));
                const clasificacionesPermitidas = new Set(filtrosCatalogo.clasificaciones.map(x => x.value));
                const skusPermitidos = new Set(filtrosCatalogo.skus.map(x => x.value));
                const almacenesPermitidos = new Set(filtrosCatalogo.almacenes.map(x => x.value));

                seleccion.masters = seleccionAnterior.masters.filter(x => mastersPermitidos.has(x));
                seleccion.clasificaciones = seleccionAnterior.clasificaciones.filter(x => clasificacionesPermitidas.has(x));
                seleccion.skus = seleccionAnterior.skus.filter(x => skusPermitidos.has(x));
                seleccion.almacenes = seleccionAnterior.almacenes.filter(x => almacenesPermitidos.has(x));

                if (!seleccion.masters.length && filtrosCatalogo.masters.length) {
                    seleccion.masters = filtrosCatalogo.masters.map(x => x.value);
                }

                if (!seleccion.clasificaciones.length && filtrosCatalogo.clasificaciones.length) {
                    seleccion.clasificaciones = filtrosCatalogo.clasificaciones.map(x => x.value);
                }

                const skusVisiblesPermitidos = new Set(obtenerValoresSkusVisibles());
                seleccion.skus = seleccion.skus.filter(x => skusVisiblesPermitidos.has(x));

                if (!seleccion.skus.length && skusVisiblesPermitidos.size) {
                    seleccion.skus = Array.from(skusVisiblesPermitidos);
                }

                if (!seleccion.almacenes.length && filtrosCatalogo.almacenes.length) {
                    seleccion.almacenes = filtrosCatalogo.almacenes
                        .filter(x => x.seleccionadoPredeterminado)
                        .map(x => x.value);

                    if (!seleccion.almacenes.length) {
                        seleccion.almacenes = filtrosCatalogo.almacenes.map(x => x.value);
                    }
                }
            } else {
                seleccion.masters = filtrosCatalogo.masters.map(x => x.value);
                seleccion.clasificaciones = filtrosCatalogo.clasificaciones.map(x => x.value);
                seleccion.skus = filtrosCatalogo.skus.map(x => x.value);
                seleccion.almacenes = filtrosCatalogo.almacenes
                    .filter(x => x.seleccionadoPredeterminado)
                    .map(x => x.value);

                if (!seleccion.almacenes.length) {
                    seleccion.almacenes = filtrosCatalogo.almacenes.map(x => x.value);
                }
            }

            renderizarOpcionesMaster();
            renderizarOpcionesClasificacion();
            marcarSkuRenderPendiente();
            renderizarOpcionesAlmacen();
            actualizarChecksTodo();
            actualizarTextosFiltros();
            return true;
        } catch (error) {
            console.error(error);
            actualizarEstadoConsulta("Error en filtros");
            alert("Error al cargar filtros: " + error.message);
            return false;
        } finally {
            setCargando(false);
        }
    }

    async function recargarFiltrosYDatos() {
        const filtrosOk = await cargarFiltrosIniciales(true);
        if (filtrosOk) {
            await cargarDatosSql();
        }
    }

    function toggleMultiSelect(id) {
        document.querySelectorAll(".multi-select").forEach(x => {
            if (x.id !== id) x.classList.remove("open");
        });

        const el = document.getElementById(id);
        if (!el) return;

        const abrir = !el.classList.contains("open");
        el.classList.toggle("open", abrir);

        // El SKU es normalmente el catálogo más grande.
        // Se materializa en DOM sólo cuando el usuario realmente lo abre.
        if (abrir && id === "skuSelect") {
            asegurarOpcionesSkuRenderizadas();
        }
    }

function renderizarOpcionesMaster() {
    const cont = document.getElementById("masterOptions");
    if (!cont) return;

    const seleccionados = new Set(seleccion.masters);

    cont.innerHTML = filtrosCatalogo.masters.map(item => {
        const checked = seleccionados.has(item.value);
        const textoBusqueda = [item.value, item.text].join(" ").toUpperCase();

        return `
            <label class="multi-option" data-text="${escapeHtml(textoBusqueda)}">
                <input
                    type="checkbox"
                    value="${escapeHtml(item.value)}"
