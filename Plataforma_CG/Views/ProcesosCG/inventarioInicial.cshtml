            ].join(" ").toUpperCase();

            const valueEncoded = encodeURIComponent(item.value);

            return `
                <label class="multi-option" data-text="${escapeHtml(textoBusqueda)}">
                    <input
                        type="checkbox"
                        value="${escapeHtml(item.value)}"
                        ${checked ? "checked" : ""}
                        onchange="toggleOpcion('almacenes', decodeURIComponent('${valueEncoded}'), this.checked)"
                    />
                    <span>
                        ${escapeHtml(item.text)}
                        <span class="almacen-meta">
                            <small class="almacen-badge ${item.diasRafaga > 0 ? "rafaga" : ""}">
                                ${escapeHtml(diasTexto)}
                            </small>
                            <small class="almacen-badge">${formatoNumero(item.totalKg)} kg</small>
                        </span>
                    </span>
                </label>
            `;
