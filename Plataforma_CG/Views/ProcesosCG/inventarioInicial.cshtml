<script>
(function () {
    'use strict';

    /*
     * ================================================================
     * LAYOUT RESPONSIVE / SIDEBAR
     * ================================================================
     *
     * El problema anterior era que la vista guardaba un width calculado
     * cuando el sidebar estaba abierto. Si el cierre del sidebar ocurría
     * modificando una clase en un contenedor distinto, ese cambio no siempre
     * llegaba al MutationObserver y el ancho quedaba "pegado".
     *
     * Esta versión:
     * 1) libera los límites Bootstrap del host;
     * 2) calcula el ancho desde el padre REAL;
     * 3) detecta sidebar abierto/cerrado por geometría visible;
     * 4) observa cambios de tamaño del padre;
     * 5) escucha clases/estilos que cambien en cualquier elemento del layout;
     * 6) escucha el final de transiciones;
     * 7) nunca usa intervalos ni polling.
     */

    const ROOT_SELECTOR = '.app#app';

    const SIDEBAR_SELECTORS = [
        '#sidebar',
        '.sidebar',
        '.layout-sidebar',
        '.sidebar-wrapper',
        '.sidenav',
        '.side-nav',
        '.side-menu',
        '[data-sidebar]'
    ].join(',');

    let root = null;
    let parent = null;
    let rafId = 0;
    let resizeObserver = null;
    let mutationObserver = null;

    let ultimoLeft = null;
    let ultimoWidth = null;

    function prepararHosts() {
        if (!root) return;

        let nodo = root.parentElement;

        while (nodo && nodo !== document.body) {
            if (
                nodo.matches('.container, .container-fluid, .pb-3') ||
                nodo.matches('main[role="main"]')
            ) {
                nodo.classList.add(
                    'inventario-inicial-host',
                    'inventario-inicial-host-clean'
                );
            }

            nodo = nodo.parentElement;
        }
    }

    function sidebarVisible() {
        const candidatos = Array.from(
            document.querySelectorAll(SIDEBAR_SELECTORS)
        );

        let mejor = null;

        for (const sb of candidatos) {
            if (!sb || !document.documentElement.contains(sb)) continue;

            const style = getComputedStyle(sb);

            if (
                style.display === 'none' ||
                style.visibility === 'hidden' ||
                Number.parseFloat(style.opacity || '1') <= 0.05
            ) {
                continue;
            }

            const rect = sb.getBoundingClientRect();

            /*
             * Un sidebar válido debe ocupar una franja visible del lado
             * izquierdo. Si está trasladado fuera de pantalla, rect.right
             * será <= 0 y no se descuenta.
             */
            if (
                rect.width < 40 ||
                rect.right <= 0 ||
                rect.left >= window.innerWidth
            ) {
                continue;
            }

            const rightVisible = Math.min(
                window.innerWidth,
                Math.max(0, rect.right)
            );

            if (!mejor || rightVisible > mejor.rightVisible) {
                mejor = {
                    elemento: sb,
                    rect,
                    rightVisible
                };
            }
        }

        return mejor;
    }

    function solicitarAjuste() {
        if (rafId) return;

        rafId = requestAnimationFrame(() => {
            rafId = 0;
            aplicarAjuste();
        });
    }

    function aplicarAjuste() {
        if (!root || !parent || !document.documentElement.contains(root)) {
            root = document.querySelector(ROOT_SELECTOR);
            parent = root?.parentElement || null;
        }

        if (!root || !parent) return;

        /*
         * Quitamos temporalmente la geometría anterior para medir el padre
         * sin que un width viejo contamine la siguiente medición.
         */
        root.style.removeProperty('left');
        root.style.removeProperty('width');
        root.style.removeProperty('max-width');
        root.style.removeProperty('margin-left');
        root.style.removeProperty('margin-right');

        const parentRect = parent.getBoundingClientRect();

        if (parentRect.width <= 0) return;

        let leftOffset = 0;
        let availableWidth = Math.floor(parentRect.width);

        const sb = sidebarVisible();

        if (sb) {
            /*
             * Si el padre YA comienza después del sidebar, el layout general
             * ya hizo el ajuste y NO debemos descontarlo otra vez.
             */
            const parentYaAcomodado =
                parentRect.left >= (sb.rightVisible - 2);

            /*
             * Si el sidebar se superpone al área del padre, descontamos solo
             * la parte realmente ocupada.
             */
            const sidebarSuperpuesto =
                !parentYaAcomodado &&
                sb.rightVisible > parentRect.left &&
                sb.rightVisible < parentRect.right;

            if (sidebarSuperpuesto) {
                leftOffset = Math.max(
                    0,
                    Math.round(sb.rightVisible - parentRect.left)
                );

                availableWidth = Math.max(
                    320,
                    Math.floor(parentRect.width - leftOffset)
                );
            }
        }

        /*
         * Protección adicional contra decimales/subpíxeles que generan
         * pequeñas barras horizontales en el documento.
         */
        availableWidth = Math.max(
            320,
            Math.min(
                availableWidth,
                Math.floor(window.innerWidth - parentRect.left - leftOffset)
            )
        );

        const cambioReal =
            ultimoLeft === null ||
            ultimoWidth === null ||
            Math.abs(ultimoLeft - leftOffset) >= 1 ||
            Math.abs(ultimoWidth - availableWidth) >= 1;

        /*
         * position relative + left se conserva para el caso en que el sidebar
         * sea overlay. Cuando está cerrado, left vuelve explícitamente a 0.
         */
        root.style.setProperty('position', 'relative', 'important');
        root.style.setProperty('left', `${leftOffset}px`, 'important');
        root.style.setProperty('width', `${availableWidth}px`, 'important');
        root.style.setProperty('max-width', `${availableWidth}px`, 'important');
        root.style.setProperty('min-width', '0', 'important');
        root.style.setProperty('margin-left', '0', 'important');
        root.style.setProperty('margin-right', '0', 'important');

        ultimoLeft = leftOffset;
        ultimoWidth = availableWidth;

        if (cambioReal) {
            /*
             * La gráfica usa clientHeight y CSS flex/grid. Un resize nativo
             * permite que cualquier componente dependiente del ancho se
             * recalcule sin reconstruir los datos.
             */
            root.dispatchEvent(new CustomEvent(
                'planeacion:layout-resized',
                {
                    detail: {
                        left: leftOffset,
                        width: availableWidth
                    }
                }
            ));
        }
    }

    function iniciarObservadores() {
        if (!root || !parent) return;

        /*
         * Detecta cambios reales del área disponible del contenido.
         */
        if ('ResizeObserver' in window) {
            resizeObserver = new ResizeObserver(() => {
                solicitarAjuste();
            });

            resizeObserver.observe(parent);

            const sidebar = sidebarVisible()?.elemento;
            if (sidebar) {
                resizeObserver.observe(sidebar);
            }
        }

        /*
         * Muchos sidebars abren/cierra cambiando una clase en BODY, NAV,
         * un wrapper o un elemento padre, no necesariamente en #sidebar.
         *
         * Solo observamos atributos; NO observamos childList, por lo que
         * renderizar la tabla o la gráfica no dispara miles de ajustes.
         */
        if ('MutationObserver' in window) {
            mutationObserver = new MutationObserver(() => {
                solicitarAjuste();
            });

            mutationObserver.observe(document.body, {
                subtree: true,
                attributes: true,
                attributeFilter: [
                    'class',
                    'style',
                    'aria-hidden',
                    'aria-expanded'
                ]
            });
        }

        /*
         * Captura el final de animaciones CSS del sidebar aunque la propiedad
         * modificada esté en un wrapper que no conocemos.
         */
        document.addEventListener(
            'transitionend',
            solicitarAjuste,
            true
        );

        window.addEventListener(
            'resize',
            solicitarAjuste,
            { passive: true }
        );

        window.addEventListener(
            'orientationchange',
            solicitarAjuste,
            { passive: true }
        );

        /*
         * Los botones de menú suelen cambiar clases después del click.
         * Hacemos una segunda medición al terminar el siguiente frame y otra
         * al concluir una transición corta. No es polling permanente.
         */
        document.addEventListener(
            'click',
            () => {
                solicitarAjuste();

                window.setTimeout(
                    solicitarAjuste,
                    260
                );
            },
            true
        );
    }

    function iniciar() {
        root = document.querySelector(ROOT_SELECTOR);

        if (!root) return;

        parent = root.parentElement;

        prepararHosts();
        aplicarAjuste();
        iniciarObservadores();

        /*
         * Segunda medición después de que Bootstrap/Layout haya terminado
         * de aplicar sus medidas iniciales.
         */
        requestAnimationFrame(() => {
            solicitarAjuste();
        });

        window.setTimeout(
            solicitarAjuste,
            350
        );
    }

    if (document.readyState === 'loading') {
        document.addEventListener(
            'DOMContentLoaded',
            iniciar,
            { once: true }
        );
    } else {
        iniciar();
    }
})();
</script>

<script>
    let datos = [];
    let modoVista = "completa";
    const DIAS_ADELANTE = 23;
    const SOLO_SKU_CON_INVENTARIO_O_PRODUCCION = true;
    let catalogoDepuradoPorMovimiento = false;
    let consultaDatosEnCurso = false;
    let controladorConsultaDatos = null;
    let secuenciaConsultaDatos = 0;
    let temporizadorCargaDatos = null;

    // Evita recrear Intl.NumberFormat cientos de veces durante cada render.
    const FORMATEADOR_NUMERO = new Intl.NumberFormat("es-MX", {
        minimumFractionDigits: 0,
        maximumFractionDigits: 3
    });

    // El catálogo SKU puede tener cientos/miles de registros.
    // No construimos ese DOM hasta que el usuario abra el selector.
    let skuOptionsDirty = true;
    let skuOptionsRendered = false;

    let filtrosCatalogo = {
        masters: [],
        clasificaciones: [],
        skus: [],
        almacenes: []
    };

    let seleccion = {
        masters: [],
        clasificaciones: [],
        skus: [],
        almacenes: []
    };

    let filtrosMetricas = {
        inventario: true,
        produccion: true,
        rafaga: true,
        pedidos: true,
        disponible: true
    };

    const metricasGrafica = [
        { key: "inventario", nombre: "Inventario", clase: "inventario" },
        { key: "produccion", nombre: "Producción", clase: "produccion" },
        { key: "rafaga", nombre: "Liberación ráfaga", clase: "rafaga" },
        { key: "pedidos", nombre: "Pedidos", clase: "pedidos" },
        { key: "disponible", nombre: "Disponible", clase: "disponible" }
    ];

    function escapeHtml(value) {
        return String(value ?? "")
            .replaceAll("&", "&amp;")
            .replaceAll("<", "&lt;")
            .replaceAll(">", "&gt;")
            .replaceAll('"', "&quot;")
            .replaceAll("'", "&#039;");
    }

    function normalizarTexto(value) {
        return String(value ?? "").trim().toUpperCase();
    }

    function formatoNumero(valor) {
        return FORMATEADOR_NUMERO.format(Number(valor || 0));
    }

    function normalizarNumero(valor) {
        const numero = Number(valor);
        return isNaN(numero) ? 0 : numero;
    }

    function claseNegativo(valor) {
        return normalizarNumero(valor) < 0 ? "valor-negativo" : "";
    }

    function obtenerCampo(row, camelCase, pascalCase, defaultValue = 0) {
        if (!row) return defaultValue;
        return row[camelCase] ?? row[pascalCase] ?? defaultValue;
    }

    function obtenerTextoCampo(row, nombres, defaultValue = "") {
        if (!row) return defaultValue;

        for (const nombre of nombres) {
            if (row[nombre] !== undefined && row[nombre] !== null) {
                return String(row[nombre]);
            }
        }

        return defaultValue;
    }

    function obtenerSkuRow(row) {
        return normalizarTexto(obtenerTextoCampo(row, [
            "sku", "Sku", "SKU",
            "articulo", "Articulo",
            "itemCode", "ItemCode",
            "productoCodigo", "ProductoCodigo",
            "codigoProducto", "CodigoProducto"
        ], ""));
    }

    function filaTieneInventarioOProduccion(row) {
        const inventario = normalizarNumero(
            obtenerCampo(row, "kgInventario", "KgInventario", 0)
        );

        const produccion = normalizarNumero(
            obtenerCampo(row, "kgProduccion", "KgProduccion", 0)
        );

        /*
         * Un SKU se considera útil únicamente cuando tiene información real
         * de INVENTARIO o PRODUCCIÓN.
         *
         * La liberación de ráfaga por sí sola ya NO hace visible al SKU.
         */
        return inventario > 0 || produccion > 0;
    }

    function obtenerSkusConInventarioOProduccion(rows) {
        const skus = new Set();

        (rows || []).forEach(row => {
            const sku = obtenerSkuRow(row);

            if (sku && filaTieneInventarioOProduccion(row)) {
                skus.add(sku);
            }
        });

        return skus;
    }

    function aplicarCatalogoSkusConMovimiento(rows, consultaSinFiltros) {
        /*
           No depurar el catálogo desde el resultado de InventarioInicialDatos.
           Ese endpoint puede regresar filas consolidadas como "TODOS" o "123 SKU".
           Si se usa eso para filtrar el catálogo, se borran MASTER/SKU y el combo queda vacío.
           Los filtros deben venir de /ProcesosCG/InventarioInicialFiltros.
        */
        return;
    }

    function fechaDesdeValor(valor) {
        if (!valor) return null;

        if (valor instanceof Date && !isNaN(valor.getTime())) {
            const f = new Date(valor);
            f.setHours(0, 0, 0, 0);
            return f;
        }

        const texto = String(valor).trim();
        const iso = texto.substring(0, 10);
        const mIso = iso.match(/^(\d{4})-(\d{2})-(\d{2})$/);

        if (mIso) {
            const f = new Date(Number(mIso[1]), Number(mIso[2]) - 1, Number(mIso[3]));
            f.setHours(0, 0, 0, 0);
            return f;
        }

        const mMx = texto.match(/^(\d{2})\/(\d{2})\/(\d{2}|\d{4})$/);
        if (mMx) {
            const year = mMx[3].length === 2 ? 2000 + Number(mMx[3]) : Number(mMx[3]);
            const f = new Date(year, Number(mMx[2]) - 1, Number(mMx[1]));
            f.setHours(0, 0, 0, 0);
            return f;
        }

        const fecha = new Date(texto);
        if (isNaN(fecha.getTime())) return null;

        fecha.setHours(0, 0, 0, 0);
        return fecha;
    }

    function fechaKey(fecha) {
        const f = fechaDesdeValor(fecha);
        if (!f) return "";

        const year = f.getFullYear();
        const month = String(f.getMonth() + 1).padStart(2, "0");
        const day = String(f.getDate()).padStart(2, "0");

        return `${year}-${month}-${day}`;
    }

    function fechaCorta(valor) {
        const fecha = fechaDesdeValor(valor);
        if (!fecha) return "Actual";

        return fecha.toLocaleDateString("es-MX", {
            day: "2-digit",
            month: "2-digit",
            year: "2-digit"
        });
    }

    function formatoInputFecha(fecha) {
        const f = fechaDesdeValor(fecha);
        if (!f) return "";
        return fechaKey(f);
    }

    function sumarDiasInput(fechaIso, dias) {
        const f = fechaDesdeValor(fechaIso);
        if (!f) return "";
        f.setDate(f.getDate() + Number(dias || 0));
        return formatoInputFecha(f);
    }

    function inicializarRangoFechas() {
        const inicio = document.getElementById("fechaInicioInput");
        const fin = document.getElementById("fechaFinInput");

        const hoy = new Date();
        hoy.setHours(0, 0, 0, 0);

        const fechaFin = new Date(hoy);
        fechaFin.setDate(hoy.getDate() + DIAS_ADELANTE);

        if (inicio && !inicio.value) {
            inicio.value = formatoInputFecha(hoy);
        }

        if (fin && !fin.value) {
            fin.value = formatoInputFecha(fechaFin);
        }
    }

    function obtenerRangoFechas() {
        const inicioInput = document.getElementById("fechaInicioInput")?.value || "";
        const finInput = document.getElementById("fechaFinInput")?.value || "";

        let inicio = fechaDesdeValor(inicioInput);
        let fin = fechaDesdeValor(finInput);

        if (!inicio) {
            inicio = new Date();
            inicio.setHours(0, 0, 0, 0);
        }

        if (!fin) {
            fin = new Date(inicio);
            fin.setDate(inicio.getDate() + DIAS_ADELANTE);
        }

        if (fin < inicio) {
            const temp = inicio;
            inicio = fin;
            fin = temp;
        }

        return { inicio, fin };
    }

    function crearCalendarioRango(fechaInicio, fechaFin) {
        const inicio = fechaDesdeValor(fechaInicio);
        const fin = fechaDesdeValor(fechaFin);
        const calendario = [];

        if (!inicio || !fin) return calendario;

        const actual = new Date(inicio);
        actual.setHours(0, 0, 0, 0);

        const limite = new Date(fin);
        limite.setHours(0, 0, 0, 0);

        while (actual <= limite) {
            calendario.push({
                fecha: fechaCorta(actual),
                fechaKey: fechaKey(actual),
                inventario: 0,
                produccion: 0,
                rafaga: 0,
                pedidos: 0,
                disponible: 0
            });

            actual.setDate(actual.getDate() + 1);
        }

        return calendario;
    }

    function actualizarEstadoConsulta(texto) {
        const ultima = document.getElementById("ultimaConsulta");
        if (ultima) ultima.textContent = texto || "Sin cargar";
    }

    function setCargando(activo) {
        const app = document.getElementById("app");
        if (app) app.classList.toggle("loading", Boolean(activo));
    }

    async function cargarFiltrosIniciales(preservarSeleccion = false) {
        const seleccionAnterior = {
            masters: [...seleccion.masters],
            clasificaciones: [...seleccion.clasificaciones],
            skus: [...seleccion.skus],
            almacenes: [...seleccion.almacenes]
        };

        try {
            setCargando(true);

            const rango = obtenerRangoFechas();
            const fechaInicio = formatoInputFecha(rango.inicio);
            const fechaFin = formatoInputFecha(rango.fin);
            const fechaInventarioInicial = sumarDiasInput(fechaInicio, -1);

            const params = new URLSearchParams({
                fechaInicio: fechaInicio,
                fechaFin: fechaFin,
                fechaInventarioInicial: fechaInventarioInicial,
                /*
                 * Mostrar en el selector SKU únicamente artículos que tengan:
                 *   Inventario > 0  O  Producción > 0
                 *
                 * De esta forma no se carga el catálogo completo con SKU
                 * que no aportan información al análisis.
                 */
                soloSkuMovimiento: "true"
            });

            const tFiltros = performance.now();

            const response = await fetch(`/ProcesosCG/InventarioInicialFiltros?${params.toString()}`, {
                method: "GET",
                headers: { "Accept": "application/json" }
            });

            const json = await response.json();

            console.debug(
                `[Planeación] Filtros: ${Math.round(performance.now() - tFiltros)} ms`
            );

            if (!response.ok || !json.ok) {
                throw new Error([json.msg, json.error, json.inner].filter(Boolean).join("\n") || "No se pudieron cargar los filtros.");
            }

            filtrosCatalogo.masters = (json.masters || json.Masters || []).map(x => ({
                value: normalizarTexto(x.value ?? x.Value),
                text: String(x.text ?? x.Text ?? x.value ?? x.Value ?? ""),
                totalSkus: Number(x.totalSkus ?? x.TotalSkus ?? 0)
            })).filter(x => x.value);

            filtrosCatalogo.clasificaciones = (json.clasificaciones || json.Clasificaciones || []).map(x => ({
                value: normalizarTexto(x.value ?? x.Value ?? x.clasificacion ?? x.Clasificacion),
                text: String(x.text ?? x.Text ?? x.value ?? x.Value ?? x.clasificacion ?? x.Clasificacion ?? ""),
                totalSkus: Number(x.totalSkus ?? x.TotalSkus ?? 0)
            })).filter(x => x.value);

            filtrosCatalogo.skus = (json.skus || json.Skus || []).map(x => ({
                value: normalizarTexto(x.value ?? x.Value),
                text: String(x.text ?? x.Text ?? x.value ?? x.Value ?? ""),
                articulo: String(x.articulo ?? x.Articulo ?? ""),
                master: normalizarTexto(x.master ?? x.Master ?? x.masterProducto ?? x.MasterProducto),
                clasificacion: normalizarTexto(
                    x.clasificacion ?? x.Clasificacion ?? "SIN CLASIFICACIÓN"
                ) || "SIN CLASIFICACIÓN"
            })).filter(x => x.value);

            filtrosCatalogo.almacenes = (json.almacenes || json.Almacenes || []).map(x => ({
                value: normalizarTexto(x.value ?? x.Value ?? x.almacen ?? x.Almacen),
                text: String(x.text ?? x.Text ?? x.almacen ?? x.Almacen ?? ""),
                diasRafaga: Number(x.diasRafaga ?? x.DiasRafaga ?? 0),
                esRafaga: Boolean(x.esRafaga ?? x.EsRafaga ?? false),
                activo: Boolean(x.activo ?? x.Activo ?? true),
                seleccionadoPredeterminado: Boolean(
                    x.seleccionadoPredeterminado ??
                    x.SeleccionadoPredeterminado ??
                    true
                ),
                totalCajas: normalizarNumero(x.totalCajas ?? x.TotalCajas ?? 0),
                totalKg: normalizarNumero(x.totalKg ?? x.TotalKg ?? 0)
            })).filter(x => x.value && x.activo);

            if (preservarSeleccion) {
                const mastersPermitidos = new Set(filtrosCatalogo.masters.map(x => x.value));
                const clasificacionesPermitidas = new Set(filtrosCatalogo.clasificaciones.map(x => x.value));
                const skusPermitidos = new Set(filtrosCatalogo.skus.map(x => x.value));
                const almacenesPermitidos = new Set(filtrosCatalogo.almacenes.map(x => x.value));

                seleccion.masters = seleccionAnterior.masters.filter(x => mastersPermitidos.has(x));
                seleccion.clasificaciones = seleccionAnterior.clasificaciones.filter(x => clasificacionesPermitidas.has(x));
                seleccion.skus = seleccionAnterior.skus.filter(x => skusPermitidos.has(x));
                seleccion.almacenes = seleccionAnterior.almacenes.filter(x => almacenesPermitidos.has(x));

                if (!seleccion.masters.length && filtrosCatalogo.masters.length) {
                    seleccion.masters = filtrosCatalogo.masters.map(x => x.value);
                }

                if (!seleccion.clasificaciones.length && filtrosCatalogo.clasificaciones.length) {
                    seleccion.clasificaciones = filtrosCatalogo.clasificaciones.map(x => x.value);
                }

                const skusVisiblesPermitidos = new Set(obtenerValoresSkusVisibles());
                seleccion.skus = seleccion.skus.filter(x => skusVisiblesPermitidos.has(x));

                if (!seleccion.skus.length && skusVisiblesPermitidos.size) {
                    seleccion.skus = Array.from(skusVisiblesPermitidos);
                }

                if (!seleccion.almacenes.length && filtrosCatalogo.almacenes.length) {
                    seleccion.almacenes = filtrosCatalogo.almacenes
                        .filter(x => x.seleccionadoPredeterminado)
                        .map(x => x.value);

                    if (!seleccion.almacenes.length) {
                        seleccion.almacenes = filtrosCatalogo.almacenes.map(x => x.value);
                    }
                }
            } else {
                seleccion.masters = filtrosCatalogo.masters.map(x => x.value);
                seleccion.clasificaciones = filtrosCatalogo.clasificaciones.map(x => x.value);
                seleccion.skus = filtrosCatalogo.skus.map(x => x.value);
                seleccion.almacenes = filtrosCatalogo.almacenes
                    .filter(x => x.seleccionadoPredeterminado)
                    .map(x => x.value);

                if (!seleccion.almacenes.length) {
                    seleccion.almacenes = filtrosCatalogo.almacenes.map(x => x.value);
                }
            }

            renderizarOpcionesMaster();
            renderizarOpcionesClasificacion();
            marcarSkuRenderPendiente();
            renderizarOpcionesAlmacen();
            actualizarChecksTodo();
            actualizarTextosFiltros();
            return true;
        } catch (error) {
            console.error(error);
            actualizarEstadoConsulta("Error en filtros");
            alert("Error al cargar filtros: " + error.message);
            return false;
        } finally {
            setCargando(false);
        }
    }

    async function recargarFiltrosYDatos() {
        const filtrosOk = await cargarFiltrosIniciales(true);
        if (filtrosOk) {
            await cargarDatosSql();
        }
    }

    function toggleMultiSelect(id) {
        document.querySelectorAll(".multi-select").forEach(x => {
            if (x.id !== id) x.classList.remove("open");
        });

        const el = document.getElementById(id);
        if (!el) return;

        const abrir = !el.classList.contains("open");
        el.classList.toggle("open", abrir);

        // El SKU es normalmente el catálogo más grande.
        // Se materializa en DOM sólo cuando el usuario realmente lo abre.
        if (abrir && id === "skuSelect") {
            asegurarOpcionesSkuRenderizadas();
        }
    }

function renderizarOpcionesMaster() {
    const cont = document.getElementById("masterOptions");
    if (!cont) return;

    const seleccionados = new Set(seleccion.masters);

    cont.innerHTML = filtrosCatalogo.masters.map(item => {
        const checked = seleccionados.has(item.value);
        const textoBusqueda = [item.value, item.text].join(" ").toUpperCase();

        return `
            <label class="multi-option" data-text="${escapeHtml(textoBusqueda)}">
                <input
                    type="checkbox"
                    value="${escapeHtml(item.value)}"
                    ${checked ? "checked" : ""}
                    onchange="toggleOpcion('masters', decodeURIComponent('${encodeURIComponent(item.value)}'), this.checked)"
                />
                <span>${escapeHtml(item.text)} <small>(${formatoNumero(item.totalSkus)})</small></span>
            </label>
        `;
    }).join("");
}

function renderizarOpcionesClasificacion() {
    const cont = document.getElementById("clasificacionOptions");
    if (!cont) return;

    const seleccionados = new Set(seleccion.clasificaciones);

    cont.innerHTML = filtrosCatalogo.clasificaciones.map(item => {
        const checked = seleccionados.has(item.value);
        const textoBusqueda = [item.value, item.text].join(" ").toUpperCase();

        return `
            <label class="multi-option" data-text="${escapeHtml(textoBusqueda)}">
                <input
                    type="checkbox"
                    value="${escapeHtml(item.value)}"
                    ${checked ? "checked" : ""}
                    onchange="toggleOpcion('clasificaciones', decodeURIComponent('${encodeURIComponent(item.value)}'), this.checked)"
                />
                <span>${escapeHtml(item.text)} <small>(${formatoNumero(item.totalSkus)})</small></span>
            </label>
        `;
    }).join("");
}

function obtenerSkusVisibles() {
    const mastersActivos = new Set(seleccion.masters);
    const clasificacionesActivas = new Set(seleccion.clasificaciones);

    if (!mastersActivos.size || !clasificacionesActivas.size) {
        return [];
    }

    return filtrosCatalogo.skus.filter(item =>
        mastersActivos.has(item.master) &&
        clasificacionesActivas.has(item.clasificacion)
    );
}

function obtenerValoresSkusVisibles() {
    return obtenerSkusVisibles().map(x => x.value);
}

function todosLosSkusVisiblesEstanSeleccionados() {
    const visibles = obtenerValoresSkusVisibles();
    if (!visibles.length) return false;

    const seleccionados = new Set(seleccion.skus);
    return visibles.every(sku => seleccionados.has(sku));
}

function sincronizarSkusConAlcance(seleccionarTodosVisibles = true) {
    const visibles = obtenerValoresSkusVisibles();

    if (!visibles.length) {
        seleccion.skus = [];
        return;
    }

    if (seleccionarTodosVisibles) {
        seleccion.skus = [...visibles];
        return;
    }

    const permitidos = new Set(visibles);
    seleccion.skus = seleccion.skus.filter(sku => permitidos.has(sku));
}

function marcarSkuRenderPendiente() {
    skuOptionsDirty = true;

    const cont = document.getElementById("skuOptions");
    if (cont && !document.getElementById("skuSelect")?.classList.contains("open")) {
        cont.innerHTML = "";
        skuOptionsRendered = false;
    }
}

function asegurarOpcionesSkuRenderizadas() {
    if (!skuOptionsRendered || skuOptionsDirty) {
        renderizarOpcionesSku();
    }
}

function renderizarOpcionesSku() {
    const cont = document.getElementById("skuOptions");
    if (!cont) return;

    const skusFiltrados = obtenerSkusVisibles();
    const seleccionados = new Set(seleccion.skus);

    cont.innerHTML = skusFiltrados.map(item => {
        const checked = seleccionados.has(item.value);
        const textoBusqueda = [
            item.value,
            item.text,
            item.articulo,
            item.master,
            item.clasificacion
        ].join(" ").toUpperCase();

        return `
            <label class="multi-option" data-text="${escapeHtml(textoBusqueda)}">
                <input
                    type="checkbox"
                    value="${escapeHtml(item.value)}"
                    ${checked ? "checked" : ""}
                    onchange="toggleOpcion('skus', decodeURIComponent('${encodeURIComponent(item.value)}'), this.checked)"
                />
                <span>${escapeHtml(item.text)} <small>${escapeHtml(item.clasificacion)}</small></span>
            </label>
        `;
    }).join("");

    skuOptionsDirty = false;
    skuOptionsRendered = true;
}

    function renderizarOpcionesAlmacen() {
        const cont = document.getElementById("almacenOptions");
        if (!cont) return;

        const seleccionados = new Set(seleccion.almacenes);

        cont.innerHTML = filtrosCatalogo.almacenes.map(item => {
            const checked = seleccionados.has(item.value);
            const diasTexto = item.diasRafaga === 0
                ? "Disponible inmediato"
                : `${item.diasRafaga} día${item.diasRafaga === 1 ? "" : "s"} de ráfaga`;

            const textoBusqueda = [
                item.value,
                item.text,
