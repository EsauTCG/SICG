                    onchange="toggleOpcion('masters', decodeURIComponent('${encodeURIComponent(item.value)}'), this.checked)"
                />
                <span>${escapeHtml(item.text)} <small>(${formatoNumero(item.totalSkus)})</small></span>
            </label>
        `;
    }).join("");
}

function renderizarOpcionesClasificacion() {
    const cont = document.getElementById("clasificacionOptions");
    if (!cont) return;

    const seleccionados = new Set(seleccion.clasificaciones);

    cont.innerHTML = filtrosCatalogo.clasificaciones.map(item => {
        const checked = seleccionados.has(item.value);
        const textoBusqueda = [item.value, item.text].join(" ").toUpperCase();

        return `
            <label class="multi-option" data-text="${escapeHtml(textoBusqueda)}">
                <input
                    type="checkbox"
                    value="${escapeHtml(item.value)}"
                    ${checked ? "checked" : ""}
                    onchange="toggleOpcion('clasificaciones', decodeURIComponent('${encodeURIComponent(item.value)}'), this.checked)"
                />
                <span>${escapeHtml(item.text)} <small>(${formatoNumero(item.totalSkus)})</small></span>
            </label>
        `;
    }).join("");
}

function obtenerSkusVisibles() {
    const mastersActivos = new Set(seleccion.masters);
    const clasificacionesActivas = new Set(seleccion.clasificaciones);

    if (!mastersActivos.size || !clasificacionesActivas.size) {
        return [];
    }

    return filtrosCatalogo.skus.filter(item =>
        mastersActivos.has(item.master) &&
        clasificacionesActivas.has(item.clasificacion)
    );
}

function obtenerValoresSkusVisibles() {
    return obtenerSkusVisibles().map(x => x.value);
}

function todosLosSkusVisiblesEstanSeleccionados() {
    const visibles = obtenerValoresSkusVisibles();
    if (!visibles.length) return false;

    const seleccionados = new Set(seleccion.skus);
    return visibles.every(sku => seleccionados.has(sku));
}

function sincronizarSkusConAlcance(seleccionarTodosVisibles = true) {
    const visibles = obtenerValoresSkusVisibles();

    if (!visibles.length) {
        seleccion.skus = [];
        return;
    }

    if (seleccionarTodosVisibles) {
        seleccion.skus = [...visibles];
        return;
    }

    const permitidos = new Set(visibles);
    seleccion.skus = seleccion.skus.filter(sku => permitidos.has(sku));
}

function marcarSkuRenderPendiente() {
    skuOptionsDirty = true;

    const cont = document.getElementById("skuOptions");
    if (cont && !document.getElementById("skuSelect")?.classList.contains("open")) {
        cont.innerHTML = "";
        skuOptionsRendered = false;
    }
}

function asegurarOpcionesSkuRenderizadas() {
    if (!skuOptionsRendered || skuOptionsDirty) {
        renderizarOpcionesSku();
    }
}

function renderizarOpcionesSku() {
    const cont = document.getElementById("skuOptions");
    if (!cont) return;

    const skusFiltrados = obtenerSkusVisibles();
    const seleccionados = new Set(seleccion.skus);

    cont.innerHTML = skusFiltrados.map(item => {
        const checked = seleccionados.has(item.value);
        const textoBusqueda = [
            item.value,
            item.text,
            item.articulo,
            item.master,
            item.clasificacion
        ].join(" ").toUpperCase();

        return `
            <label class="multi-option" data-text="${escapeHtml(textoBusqueda)}">
                <input
                    type="checkbox"
                    value="${escapeHtml(item.value)}"
                    ${checked ? "checked" : ""}
                    onchange="toggleOpcion('skus', decodeURIComponent('${encodeURIComponent(item.value)}'), this.checked)"
                />
                <span>${escapeHtml(item.text)} <small>${escapeHtml(item.clasificacion)}</small></span>
            </label>
        `;
    }).join("");

    skuOptionsDirty = false;
    skuOptionsRendered = true;
}

    function renderizarOpcionesAlmacen() {
        const cont = document.getElementById("almacenOptions");
        if (!cont) return;

        const seleccionados = new Set(seleccion.almacenes);

        cont.innerHTML = filtrosCatalogo.almacenes.map(item => {
            const checked = seleccionados.has(item.value);
            const diasTexto = item.diasRafaga === 0
                ? "Disponible inmediato"
                : `${item.diasRafaga} día${item.diasRafaga === 1 ? "" : "s"} de ráfaga`;

            const textoBusqueda = [
                item.value,
                item.text,
                diasTexto,
                item.totalKg
            ].join(" ").toUpperCase();

            const valueEncoded = encodeURIComponent(item.value);

            return `
                <label class="multi-option" data-text="${escapeHtml(textoBusqueda)}">
                    <input
                        type="checkbox"
                        value="${escapeHtml(item.value)}"
                        ${checked ? "checked" : ""}
                        onchange="toggleOpcion('almacenes', decodeURIComponent('${valueEncoded}'), this.checked)"
                    />
                    <span>
                        ${escapeHtml(item.text)}
                        <span class="almacen-meta">
                            <small class="almacen-badge ${item.diasRafaga > 0 ? "rafaga" : ""}">
                                ${escapeHtml(diasTexto)}
                            </small>
                            <small class="almacen-badge">${formatoNumero(item.totalKg)} kg</small>
                        </span>
                    </span>
                </label>
            `;
        }).join("");
    }

    function programarCargaDatos(delay = 180) {
        if (temporizadorCargaDatos) {
            clearTimeout(temporizadorCargaDatos);
        }

        temporizadorCargaDatos = setTimeout(() => {
            temporizadorCargaDatos = null;
            cargarDatosSql();
        }, delay);
    }

    function toggleOpcion(tipo, value, checked) {
        value = normalizarTexto(value);

        if (checked) {
            if (!seleccion[tipo].includes(value)) {
                seleccion[tipo].push(value);
            }
        } else {
            seleccion[tipo] = seleccion[tipo].filter(x => x !== value);
        }

        if (tipo === "masters" || tipo === "clasificaciones") {
            sincronizarSkusConAlcance(true);
            marcarSkuRenderPendiente();

            if (document.getElementById("skuSelect")?.classList.contains("open")) {
                asegurarOpcionesSkuRenderizadas();
            }
        }

        actualizarChecksTodo();
        actualizarTextosFiltros();
        programarCargaDatos();
    }

    function seleccionarTodos(selectId, checked) {
        if (selectId === "masterSelect") {
            seleccion.masters = checked
                ? filtrosCatalogo.masters.map(x => x.value)
                : [];

            sincronizarSkusConAlcance(true);
            renderizarOpcionesMaster();
            marcarSkuRenderPendiente();

            if (document.getElementById("skuSelect")?.classList.contains("open")) {
                asegurarOpcionesSkuRenderizadas();
            }
        }

        if (selectId === "clasificacionSelect") {
            seleccion.clasificaciones = checked
                ? filtrosCatalogo.clasificaciones.map(x => x.value)
                : [];

            sincronizarSkusConAlcance(true);
            renderizarOpcionesClasificacion();
            marcarSkuRenderPendiente();

            if (document.getElementById("skuSelect")?.classList.contains("open")) {
                asegurarOpcionesSkuRenderizadas();
            }
        }

        if (selectId === "skuSelect") {
            const skusVisibles = obtenerValoresSkusVisibles();

            if (checked) {
                seleccion.skus = Array.from(new Set([...seleccion.skus, ...skusVisibles]));
            } else {
                seleccion.skus = seleccion.skus.filter(x => !skusVisibles.includes(x));
            }

            marcarSkuRenderPendiente();

            if (document.getElementById("skuSelect")?.classList.contains("open")) {
                asegurarOpcionesSkuRenderizadas();
            }
        }

        if (selectId === "almacenSelect") {
            seleccion.almacenes = checked
                ? filtrosCatalogo.almacenes.map(x => x.value)
                : [];

            renderizarOpcionesAlmacen();
        }

        actualizarChecksTodo();
        actualizarTextosFiltros();
        programarCargaDatos();
    }

    function limpiarFiltros() {
        seleccion.masters = filtrosCatalogo.masters.map(x => x.value);
        seleccion.clasificaciones = filtrosCatalogo.clasificaciones.map(x => x.value);
        seleccion.skus = filtrosCatalogo.skus.map(x => x.value);
        seleccion.almacenes = filtrosCatalogo.almacenes
            .filter(x => x.seleccionadoPredeterminado)
            .map(x => x.value);

        if (!seleccion.almacenes.length) {
            seleccion.almacenes = filtrosCatalogo.almacenes.map(x => x.value);
        }

        renderizarOpcionesMaster();
        renderizarOpcionesClasificacion();
        marcarSkuRenderPendiente();

        if (document.getElementById("skuSelect")?.classList.contains("open")) {
            asegurarOpcionesSkuRenderizadas();
        }

        renderizarOpcionesAlmacen();
        actualizarChecksTodo();
        actualizarTextosFiltros();
        cargarDatosSql();
    }

function filtrarOpciones(selectId, texto) {
    const root = document.getElementById(selectId);
    if (!root) return;

    const filtro = normalizarTexto(texto);

    root.querySelectorAll(".multi-options .multi-option").forEach(op => {
        const txt = normalizarTexto(
            (op.dataset.text || "") + " " + (op.textContent || "")
        );

        const mostrar = !filtro || txt.includes(filtro);
        op.classList.toggle("opcion-oculta", !mostrar);
    });
}

    function actualizarChecksTodo() {
        const masterAll = document.getElementById("masterAllCheck");
        const clasificacionAll = document.getElementById("clasificacionAllCheck");
        const skuAll = document.getElementById("skuAllCheck");
        const almacenAll = document.getElementById("almacenAllCheck");

        if (masterAll) {
            masterAll.checked =
                filtrosCatalogo.masters.length > 0 &&
                seleccion.masters.length === filtrosCatalogo.masters.length;
        }

        if (clasificacionAll) {
            clasificacionAll.checked =
                filtrosCatalogo.clasificaciones.length > 0 &&
                seleccion.clasificaciones.length === filtrosCatalogo.clasificaciones.length;
        }

        if (skuAll) {
            skuAll.checked = todosLosSkusVisiblesEstanSeleccionados();
        }

        if (almacenAll) {
            almacenAll.checked =
                filtrosCatalogo.almacenes.length > 0 &&
                seleccion.almacenes.length === filtrosCatalogo.almacenes.length;
        }
    }

    function actualizarTextosFiltros() {
        const masterText = document.getElementById("masterSelectText");
        const clasificacionText = document.getElementById("clasificacionSelectText");
        const skuText = document.getElementById("skuSelectText");
        const almacenText = document.getElementById("almacenSelectText");

        if (masterText) {
            if (seleccion.masters.length === 0) {
                masterText.textContent = "Sin MASTER seleccionado";
            } else if (seleccion.masters.length === filtrosCatalogo.masters.length) {
                masterText.textContent = "Todos los MASTER";
            } else if (seleccion.masters.length === 1) {
                masterText.textContent = seleccion.masters[0];
            } else {
                masterText.textContent = `${seleccion.masters.length} MASTER seleccionados`;
            }
        }

        if (clasificacionText) {
            if (seleccion.clasificaciones.length === 0) {
                clasificacionText.textContent = "Sin clasificación seleccionada";
            } else if (seleccion.clasificaciones.length === filtrosCatalogo.clasificaciones.length) {
                clasificacionText.textContent = "Todas las clasificaciones";
            } else if (seleccion.clasificaciones.length === 1) {
                clasificacionText.textContent = seleccion.clasificaciones[0];
            } else {
                clasificacionText.textContent = `${seleccion.clasificaciones.length} clasificaciones`;
            }
        }

        if (skuText) {
            const skusVisibles = obtenerValoresSkusVisibles();
            const visiblesSet = new Set(skusVisibles);
            const seleccionadosVisibles = seleccion.skus.filter(sku => visiblesSet.has(sku));

            if (seleccion.masters.length === 0) {
                skuText.textContent = "Seleccione primero un MASTER";
            } else if (seleccion.clasificaciones.length === 0) {
                skuText.textContent = "Seleccione una clasificación";
            } else if (skusVisibles.length === 0) {
                skuText.textContent = "Sin SKU para el alcance seleccionado";
            } else if (seleccionadosVisibles.length === 0) {
                skuText.textContent = "Sin SKU seleccionado";
            } else if (seleccionadosVisibles.length === skusVisibles.length) {
                skuText.textContent = `Todos los SKU (${skusVisibles.length})`;
            } else if (seleccionadosVisibles.length === 1) {
                skuText.textContent = seleccionadosVisibles[0];
            } else {
                skuText.textContent = `${seleccionadosVisibles.length} SKU seleccionados`;
            }
        }

        if (almacenText) {
            if (seleccion.almacenes.length === 0) {
                almacenText.textContent = "Sin almacenes considerados";
            } else if (seleccion.almacenes.length === filtrosCatalogo.almacenes.length) {
                almacenText.textContent = "Todos los almacenes";
            } else if (seleccion.almacenes.length === 1) {
                const almacen = filtrosCatalogo.almacenes.find(x => x.value === seleccion.almacenes[0]);
                almacenText.textContent = almacen
                    ? `${almacen.text} · ${almacen.diasRafaga} día(s)`
                    : seleccion.almacenes[0];
            } else {
                almacenText.textContent = `${seleccion.almacenes.length} almacenes considerados`;
            }
        }
    }

    function metricaVisible(key) {
        return filtrosMetricas[key] !== false;
    }

    function cambiarFiltroMetrica(key, activo) {
        filtrosMetricas[key] = Boolean(activo);

        const item = document.querySelector(`.legend-item[data-filtro="${key}"]`);
        if (item) {
            item.classList.toggle("inactivo", !activo);
        }

        // Cambiar una métrica no requiere reconstruir toda la tabla ni los KPI.
        aplicarFiltrosTabla();

        if (modoVista !== "tabla") {
            renderizarGrafica();
        }
    }

    function aplicarFiltrosTabla() {
        const filas = {
            inventario: document.getElementById("filaInventario"),
            produccion: document.getElementById("filaProduccion"),
            rafaga: document.getElementById("filaRafaga"),
            pedidos: document.getElementById("filaPedidos"),
            disponible: document.getElementById("filaDisponible")
        };

        Object.keys(filas).forEach(key => {
            if (filas[key]) {
                filas[key].style.display = metricaVisible(key) ? "" : "none";
            }
        });
    }

    function cambiarModoVista(modo) {
        modoVista = modo || "completa";

        const app = document.getElementById("app");
        if (app) {
            app.dataset.modoVista = modoVista;
        }

        const radio = document.querySelector(`input[name="modoVista"][value="${modoVista}"]`);
        if (radio) {
            radio.checked = true;
        }

        renderizarGrafica();
    }

    async function cargarDatosSql() {
        if (temporizadorCargaDatos) {
            clearTimeout(temporizadorCargaDatos);
            temporizadorCargaDatos = null;
        }

        /*
         * Siempre gana la selección más reciente.
         * Si el usuario cambia MASTER/SKU mientras una consulta sigue activa,
         * se cancela la anterior para evitar que se pinte información obsoleta.
         */
        if (controladorConsultaDatos) {
            controladorConsultaDatos.abort();
        }

        const consultaId = ++secuenciaConsultaDatos;
        const controladorActual = new AbortController();

        controladorConsultaDatos = controladorActual;
        consultaDatosEnCurso = true;
        actualizarEstadoConsulta("Consultando...");

        const rango = obtenerRangoFechas();
        const fechaInicio = formatoInputFecha(rango.inicio);
        const fechaFin = formatoInputFecha(rango.fin);
        const calendario = crearCalendarioRango(rango.inicio, rango.fin);

        const todosMasters =
            filtrosCatalogo.masters.length > 0 &&
            seleccion.masters.length === filtrosCatalogo.masters.length;

        const todasClasificaciones =
            filtrosCatalogo.clasificaciones.length > 0 &&
            seleccion.clasificaciones.length === filtrosCatalogo.clasificaciones.length;

        const skusVisibles = obtenerValoresSkusVisibles();
        const todosSkusDelAlcance =
            skusVisibles.length > 0 &&
            skusVisibles.every(sku => seleccion.skus.includes(sku));

        const todosAlmacenes =
            filtrosCatalogo.almacenes.length > 0 &&
            seleccion.almacenes.length === filtrosCatalogo.almacenes.length;

        // La cadena especial evita que "sin selección" se interprete como "todos".
        const mastersCsv = seleccion.masters.length === 0
            ? "__NINGUNO__"
            : (todosMasters ? "" : seleccion.masters.join(","));

        const clasificacionesCsv = seleccion.clasificaciones.length === 0
            ? "__NINGUNO__"
            : (todasClasificaciones ? "" : seleccion.clasificaciones.join(","));

        /*
         * Cuando están elegidos todos los SKU visibles del alcance MASTER + clasificación,
         * se manda vacío para que SQL filtre directamente por MASTER.
         * Esto evita enviar listas largas y hace que el filtro MASTER sea real.
         */
        const skusCsv = seleccion.skus.length === 0
            ? "__NINGUNO__"
            : (todosSkusDelAlcance ? "" : seleccion.skus.join(","));

        const almacenesCsv = seleccion.almacenes.length === 0
            ? "__NINGUNO__"
            : (todosAlmacenes ? "" : seleccion.almacenes.join(","));

        try {
            setCargando(true);

            let url = "/ProcesosCG/InventarioInicialDatos?";
            url += `skusCsv=${encodeURIComponent(skusCsv)}`;
            url += `&mastersCsv=${encodeURIComponent(mastersCsv)}`;
            url += `&clasificacionesCsv=${encodeURIComponent(clasificacionesCsv)}`;
            url += `&almacenesCsv=${encodeURIComponent(almacenesCsv)}`;
            url += `&fechaInicio=${encodeURIComponent(fechaInicio)}`;
            url += `&fechaFin=${encodeURIComponent(fechaFin)}`;

            const fechaInventarioInicial = sumarDiasInput(fechaInicio, -1);
            url += `&fechaInventarioInicial=${encodeURIComponent(fechaInventarioInicial)}`;
            url += `&dias=${DIAS_ADELANTE}`;
            url += `&soloSkuMovimiento=${SOLO_SKU_CON_INVENTARIO_O_PRODUCCION ? "true" : "false"}`;

            const tDatos = performance.now();

            const response = await fetch(url, {
                method: "GET",
                headers: { "Accept": "application/json" },
                signal: controladorActual.signal
            });

            const json = await response.json();

            console.debug(
                `[Planeación] Datos: ${Math.round(performance.now() - tDatos)} ms`
            );

            if (!response.ok || !json.ok) {
                throw new Error(
                    [json.msg, json.error, json.inner]
                        .filter(Boolean)
                        .join("\n") ||
                    "No se pudo consultar la información."
                );
            }

            if (consultaId !== secuenciaConsultaDatos) {
                return;
            }

            const rows = json.data || json.Data || [];

            aplicarCatalogoSkusConMovimiento(
                rows,
                todosMasters && todosSkusDelAlcance
            );

            const skusConMovimiento = obtenerSkusConInventarioOProduccion(rows);
            const rowsProcesar =
                SOLO_SKU_CON_INVENTARIO_O_PRODUCCION &&
                skusConMovimiento.size
                    ? rows.filter(row => {
                        const sku = obtenerSkuRow(row);
                        return !sku || skusConMovimiento.has(sku);
                    })
                    : rows;

            const inventarioPorFecha = {};
            const pedidosPorFecha = {};
            const produccionPorFecha = {};
            const rafagaPorFecha = {};

            rowsProcesar.forEach(row => {
                const fechaValor = obtenerCampo(row, "fecha", "Fecha", null);
                const key = fechaKey(fechaValor);
                if (!key) return;

                const inventario = normalizarNumero(
                    obtenerCampo(row, "kgInventario", "KgInventario", 0)
                );

                const pedidos = normalizarNumero(
                    obtenerCampo(
                        row,
                        "kgPedido",
                        "KgPedido",
                        obtenerCampo(
                            row,
                            "kgPedidoEstimado",
                            "KgPedidoEstimado",
                            0
                        )
                    )
                );

                const produccion = normalizarNumero(
                    obtenerCampo(row, "kgProduccion", "KgProduccion", 0)
                );

                const rafaga = normalizarNumero(
                    obtenerCampo(
                        row,
                        "kgLiberacionRafaga",
                        "KgLiberacionRafaga",
                        0
                    )
                );

                inventarioPorFecha[key] =
                    normalizarNumero(inventarioPorFecha[key]) + inventario;

                pedidosPorFecha[key] =
                    normalizarNumero(pedidosPorFecha[key]) + pedidos;

                produccionPorFecha[key] =
                    normalizarNumero(produccionPorFecha[key]) + produccion;

                rafagaPorFecha[key] =
                    normalizarNumero(rafagaPorFecha[key]) + rafaga;
            });

            let inventarioArrastre = 0;

            datos = calendario.map((dia, index) => {
                const produccion =
                    normalizarNumero(produccionPorFecha[dia.fechaKey]);

                const rafaga =
                    normalizarNumero(rafagaPorFecha[dia.fechaKey]);

                const pedidos =
                    normalizarNumero(pedidosPorFecha[dia.fechaKey]);

                /*
                 * Primer día: inventario ya disponible.
                 * Días posteriores: disponible del día anterior.
                 * La ráfaga se agrega una sola vez en su fecha de liberación.
                 */
                const inventario = index === 0
                    ? normalizarNumero(inventarioPorFecha[dia.fechaKey])
                    : inventarioArrastre;

                const disponible =
                    inventario + produccion + rafaga - pedidos;

                inventarioArrastre = disponible;

                return {
                    fecha: dia.fecha,
                    fechaKey: dia.fechaKey,
                    inventario,
                    produccion,
                    rafaga,
                    pedidos,
                    disponible
                };
            });

            actualizarEstadoConsulta(
                new Date().toLocaleString("es-MX", {
                    day: "2-digit",
                    month: "2-digit",
                    year: "numeric",
                    hour: "2-digit",
                    minute: "2-digit"
                })
            );

            renderizar();
        } catch (error) {
            if (error?.name === "AbortError") {
                return;
            }

            if (consultaId === secuenciaConsultaDatos) {
                console.error(error);
                actualizarEstadoConsulta("Error de consulta");
                alert(
                    "Error al cargar Inventario Inicial: " +
                    error.message
                );
            }
        } finally {
            if (consultaId === secuenciaConsultaDatos) {
                consultaDatosEnCurso = false;
                controladorConsultaDatos = null;
                setCargando(false);
            }
        }
    }

    function textoAlcance() {
        if (seleccion.masters.length === 0 || seleccion.clasificaciones.length === 0) {
            return "Sin alcance";
        }

        const skusVisibles = obtenerValoresSkusVisibles();
        const todosSkusVisibles =
            skusVisibles.length > 0 &&
            skusVisibles.every(sku => seleccion.skus.includes(sku));

        if (seleccion.skus.length === 0) {
            return seleccion.masters.length === 1
                ? seleccion.masters[0]
                : `${seleccion.masters.length} MASTER`;
        }

        if (seleccion.skus.length === 1) {
            return seleccion.skus[0];
        }

        if (todosSkusVisibles) {
            if (seleccion.masters.length === 1) {
                return seleccion.masters[0];
            }

            if (seleccion.masters.length === filtrosCatalogo.masters.length) {
                return "Todos";
            }

            return `${seleccion.masters.length} MASTER`;
        }

        return `${seleccion.skus.length} SKU`;
    }

    function textoDetalleAlcance() {
        if (seleccion.masters.length === 0) {
            return "Selecciona al menos un MASTER";
        }

        if (seleccion.clasificaciones.length === 0) {
            return "Selecciona al menos una clasificación";
        }

        const masters =
            seleccion.masters.length === filtrosCatalogo.masters.length
                ? "Todos los MASTER"
                : (
                    seleccion.masters.length === 1
                        ? seleccion.masters[0]
                        : `${seleccion.masters.length} MASTER`
                );

        const clasificaciones =
            seleccion.clasificaciones.length === filtrosCatalogo.clasificaciones.length
                ? "Todas las clasificaciones"
                : (
                    seleccion.clasificaciones.length === 1
                        ? seleccion.clasificaciones[0]
                        : `${seleccion.clasificaciones.length} clasificaciones`
                );

        const skusVisibles = obtenerValoresSkusVisibles();
        const seleccionadosVisibles = seleccion.skus.filter(sku => skusVisibles.includes(sku));

        let skus;
        if (skusVisibles.length === 0) {
            skus = "Sin SKU disponibles";
        } else if (seleccionadosVisibles.length === 0) {
            skus = "Sin SKU seleccionados";
        } else if (seleccionadosVisibles.length === skusVisibles.length) {
            skus = `Todos los SKU (${skusVisibles.length})`;
        } else {
            skus = `${seleccionadosVisibles.length} SKU`;
        }

        const almacenes = seleccion.almacenes.length === 0
            ? "Sin almacenes"
            : (
                seleccion.almacenes.length === filtrosCatalogo.almacenes.length
                    ? "Todos los almacenes"
                    : (
                        seleccion.almacenes.length === 1
                            ? seleccion.almacenes[0]
                            : `${seleccion.almacenes.length} almacenes`
                    )
            );

        return `${masters} / ${clasificaciones} / ${skus} / ${almacenes}`;
    }

    function renderizar() {
        const filaFechas = document.getElementById("filaFechas");
        const filaInventario = document.getElementById("filaInventario");
        const filaProduccion = document.getElementById("filaProduccion");
        const filaRafaga = document.getElementById("filaRafaga");
        const filaPedidos = document.getElementById("filaPedidos");
        const filaDisponible = document.getElementById("filaDisponible");

        const alcance = textoAlcance();
        const alcanceDetalle = textoDetalleAlcance();

        const fechasHtml = [
            '<th class="sticky-alcance">Alcance</th>',
            '<th class="sticky-concepto">Concepto</th>'
        ];

        const inventarioHtml = [
            `<td class="sticky-alcance">${escapeHtml(alcance)}</td>`,
            '<td class="sticky-concepto">Inventario KG</td>'
        ];

        const produccionHtml = [
            `<td class="sticky-alcance">${escapeHtml(alcance)}</td>`,
            '<td class="sticky-concepto">Producción KG</td>'
        ];

        const rafagaHtml = [
            `<td class="sticky-alcance">${escapeHtml(alcance)}</td>`,
            '<td class="sticky-concepto">Liberación ráfaga KG</td>'
        ];

        const pedidosHtml = [
            `<td class="sticky-alcance">${escapeHtml(alcance)}</td>`,
            '<td class="sticky-concepto">Pedidos KG</td>'
        ];

        const disponibleHtml = [
            `<td class="sticky-alcance">${escapeHtml(alcance)}</td>`,
            '<td class="sticky-concepto">Disponible KG</td>'
        ];

        for (const dia of datos) {
            fechasHtml.push(`<th>${escapeHtml(dia.fecha)}</th>`);
            inventarioHtml.push(
                `<td class="${claseNegativo(dia.inventario)}">${formatoNumero(dia.inventario)}</td>`
            );
            produccionHtml.push(
                `<td class="${claseNegativo(dia.produccion)}">${formatoNumero(dia.produccion)}</td>`
            );
            rafagaHtml.push(
                `<td class="${claseNegativo(dia.rafaga)}">${formatoNumero(dia.rafaga)}</td>`
            );
            pedidosHtml.push(
                `<td class="${claseNegativo(dia.pedidos)}">${formatoNumero(dia.pedidos)}</td>`
            );

            let claseDisponible = "disponible-ok";

            if (dia.disponible < 0) {
                claseDisponible = "disponible-negativo";
            } else if (dia.disponible <= 10) {
                claseDisponible = "disponible-alerta";
            }

            disponibleHtml.push(
                `<td class="${claseDisponible} ${claseNegativo(dia.disponible)}">${formatoNumero(dia.disponible)}</td>`
            );
        }

        // Una sola escritura por fila. Evita reparsar y reconstruir el DOM
        // en cada día con innerHTML +=.
        filaFechas.innerHTML = fechasHtml.join("");
        filaInventario.innerHTML = inventarioHtml.join("");
        filaProduccion.innerHTML = produccionHtml.join("");
        filaRafaga.innerHTML = rafagaHtml.join("");
        filaPedidos.innerHTML = pedidosHtml.join("");
        filaDisponible.innerHTML = disponibleHtml.join("");

        aplicarFiltrosTabla();
        actualizarKPIs(alcance, alcanceDetalle);

        if (modoVista !== "tabla") {
            renderizarGrafica();
        }
    }

    function actualizarKPIs(alcance, alcanceDetalle) {
        const disponibleFinal = datos.length ? datos[datos.length - 1].disponible : 0;

        let produccionTotal = 0;
        let rafagaTotal = 0;
        let pedidosTotal = 0;
        let diasFaltante = 0;

        for (const dia of datos) {
            produccionTotal += normalizarNumero(dia.produccion);
            rafagaTotal += normalizarNumero(dia.rafaga);
            pedidosTotal += normalizarNumero(dia.pedidos);

            if (dia.disponible < 0) {
                diasFaltante++;
            }
        }

        document.getElementById("kpiAlcance").textContent = alcance;
        document.getElementById("kpiAlcanceDetalle").textContent = alcanceDetalle;
        document.getElementById("kpiDisponibleFinal").textContent = formatoNumero(disponibleFinal);
        document.getElementById("kpiProduccionTotal").textContent = formatoNumero(produccionTotal);
        document.getElementById("kpiRafagaTotal").textContent = formatoNumero(rafagaTotal);
        document.getElementById("kpiPedidosTotal").textContent = formatoNumero(pedidosTotal);
        document.getElementById("kpiDiasFaltante").textContent = formatoNumero(diasFaltante);

        const cardDisponible = document.getElementById("kpiDisponibleFinal")?.closest(".card");
        const cardFaltante = document.getElementById("kpiDiasFaltante")?.closest(".card");

        if (cardDisponible) {
            cardDisponible.classList.toggle("kpi-negativo", disponibleFinal < 0);
            cardDisponible.classList.toggle("kpi-alerta", disponibleFinal >= 0 && disponibleFinal <= 10);
        }

        if (cardFaltante) {
            cardFaltante.classList.toggle("kpi-alerta-activa", diasFaltante > 0);
        }

        const tablaResumen = document.getElementById("tablaResumen");
        if (tablaResumen) {
            tablaResumen.textContent =
                `${alcanceDetalle} | Inventario disponible del cierre anterior + liberaciones por ráfaga`;
        }
    }

    function renderizarGrafica() {
        const contenedor = document.getElementById("graficaDisponible");
        if (!contenedor) return;

        // Si la gráfica está oculta, no gastamos CPU construyéndola.
        if (modoVista === "tabla") {
            contenedor.innerHTML = "";
            return;
        }

        const metricasVisibles = metricasGrafica.filter(m => metricaVisible(m.key));

        if (!metricasVisibles.length) {
            contenedor.innerHTML = `
                <div class="sin-datos">
                    Selecciona al menos un indicador para mostrar información.
                </div>
            `;
            return;
        }

        if (!datos.length) {
            contenedor.innerHTML = `
                <div class="sin-datos">
                    No hay información para el rango seleccionado.
                </div>
            `;
            return;
        }

        let maximo = 1;

        for (const dia of datos) {
            for (const metrica of metricasVisibles) {
                maximo = Math.max(
                    maximo,
                    Math.abs(normalizarNumero(dia[metrica.key]))
                );
            }
        }

        const altoDisponible = Math.max(contenedor.clientHeight - 62, 90);
        const html = [];

        for (const dia of datos) {
            const barras = metricasVisibles.map(metrica => {
                const valor = normalizarNumero(dia[metrica.key]);
                const altura = Math.max((Math.abs(valor) / maximo) * altoDisponible, 4);

                return `
                    <div
                        class="bar ${metrica.clase} ${valor < 0 ? "negative" : ""}"
                        style="height: ${altura}px;"
                        title="${metrica.nombre}: ${formatoNumero(valor)} KG | ${dia.fecha}"
                    ></div>
                `;
            }).join("");

            const resumen = metricasVisibles.length === 1
                ? `<div>${formatoNumero(dia[metricasVisibles[0].key])}</div>`
                : `<div>${metricasVisibles.length} datos</div>`;

            html.push(`
                <div class="bar-item">
                    <div class="bar-stack">
                        ${barras}
                    </div>
                    ${resumen}
                    <div class="bar-label">${escapeHtml(dia.fecha)}</div>
                </div>
            `);
        }

        // Una sola reconstrucción del contenedor.
        contenedor.innerHTML = html.join("");
    }

    document.addEventListener("click", function (e) {
        if (!e.target.closest(".multi-select")) {
            document.querySelectorAll(".multi-select").forEach(x => x.classList.remove("open"));
        }
    });

    inicializarRangoFechas();
    cambiarModoVista("completa");

    const tInicioVista = performance.now();

    cargarFiltrosIniciales().then(async (filtrosOk) => {
        if (filtrosOk) {
            await cargarDatosSql();
        }

        console.debug(
            `[Planeación] Carga inicial completa: ${Math.round(performance.now() - tInicioVista)} ms`
        );
    });
</script>
