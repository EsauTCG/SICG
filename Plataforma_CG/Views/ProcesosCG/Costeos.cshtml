    function obtenerTamanoPaginaComparativa() {
        const valor = Number(
            document.getElementById('cmpTamanoPagina')?.value || 200
        );

        if (!Number.isFinite(valor)) return 200;

        return Math.min(1000, Math.max(50, Math.trunc(valor)));
    }

    function renderPaginacionComparativa(resultado) {
        const contenedor = document.getElementById('paginacionComparativa');
        const info = document.getElementById('cmpInfoPagina');
        const numeroPagina = document.getElementById('cmpNumeroPagina');
        const anterior = document.getElementById('btnPaginaAnterior');
        const siguiente = document.getElementById('btnPaginaSiguiente');
        const selectorTamano = document.getElementById('cmpTamanoPagina');

        if (!contenedor || !info || !numeroPagina || !anterior || !siguiente) {
            return;
        }

        const pagina = Math.max(0, Number(resultado?.pagina) || 0);
        const totalPaginas = Math.max(
            0,
            Number(resultado?.totalPaginas) || 0
        );
        const tamanoPagina = Math.max(
            1,
            Number(resultado?.tamanoPagina) ||
            obtenerTamanoPaginaComparativa()
        );
        const total = Math.max(
            0,
            Number(resultado?.total ?? resultado?.resumen?.totalFiltrado) || 0
        );
        const cantidadVisible = Array.isArray(resultado?.datos)
            ? resultado.datos.length
            : 0;

        if (selectorTamano) {
            selectorTamano.value = String(tamanoPagina);
        }

        if (!comparativaConsultada && total === 0) {
            contenedor.classList.add('d-none');
            info.textContent = 'Sin resultados.';
            numeroPagina.textContent = 'Página 0 de 0';
            anterior.disabled = true;
            siguiente.disabled = true;
            return;
        }

        contenedor.classList.remove('d-none');

        const inicio = total > 0
            ? ((Math.max(1, pagina) - 1) * tamanoPagina) + 1
            : 0;
        const fin = total > 0
            ? Math.min(total, inicio + cantidadVisible - 1)
            : 0;

        info.textContent =
            `Mostrando ${inicio.toLocaleString('es-MX')}–${fin.toLocaleString('es-MX')} ` +
            `de ${total.toLocaleString('es-MX')} registro(s) filtrado(s).`;

        numeroPagina.textContent =
            `Página ${pagina.toLocaleString('es-MX')} de ${totalPaginas.toLocaleString('es-MX')}`;

        anterior.disabled = pagina <= 1;
        siguiente.disabled = totalPaginas === 0 || pagina >= totalPaginas;
    }

    function cambiarPaginaComparativa(direccion) {
        const nuevaPagina = paginaComparativaActual + Number(direccion || 0);

        if (
            nuevaPagina < 1 ||
            nuevaPagina > totalPaginasComparativa ||
            nuevaPagina === paginaComparativaActual
        ) {
            return;
        }

        consultarComparativa(nuevaPagina);
    }

    function cambiarTamanoPaginaComparativa() {
        paginaComparativaActual = 1;

        if (comparativaConsultada) {
            consultarComparativa(1);
        }
    }


    function getComparativaFiltro(pagina = paginaComparativaActual) {
        return {
            tipoPeriodo: document.getElementById("cmpPeriodo")?.value || 'MES',
            fechaBase: document.getElementById("cmpFecha")?.value || null,
            tolerancia: parseFloat(document.getElementById("cmpTolerancia")?.value || '0'),
            estadoCosto: document.getElementById("cmpEstado")?.value || 'PENDIENTES',
            pagina: Math.max(1, Number(pagina) || 1),
            tamanoPagina: obtenerTamanoPaginaComparativa()
        };
    }

    function obtenerNombreArchivo(disposition) {
        if (!disposition) return null;

        const utf8 = disposition.match(/filename\*=UTF-8''([^;]+)/i);
        if (utf8?.[1]) return decodeURIComponent(utf8[1].replace(/["']/g, ''));

        const normal = disposition.match(/filename="?([^";]+)"?/i);
        return normal?.[1] || null;
    }

    async function exportarComparativaExcel() {
        const btn = document.getElementById('btnExportarComparativa');
        const filtro = getComparativaFiltro();

        if (!filtro.fechaBase) {
            alert('Captura la fecha de la comparativa.');
            return;
        }

        if (!Number.isFinite(filtro.tolerancia) || filtro.tolerancia < 0) {
            alert('La tolerancia debe ser un número mayor o igual a cero.');
            return;
        }

        try {
            if (btn) {
                btn.disabled = true;
                btn.textContent = 'Generando Excel...';
            }

            const response = await fetch('@Url.Action("ExportarComparativaCosteoExcel", "ProcesosCG")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'same-origin',
                body: JSON.stringify(filtro)
            });

            if (!response.ok) {
                let mensaje = 'No se pudo generar el archivo de Excel.';
                try {
                    const error = await response.json();
                    mensaje = error?.mensaje || error?.msg || mensaje;
                } catch { }
                throw new Error(mensaje);
            }

            const blob = await response.blob();
            const nombre = obtenerNombreArchivo(response.headers.get('Content-Disposition'))
                || `Comparativa_Costeo_${filtro.tipoPeriodo}_${String(filtro.fechaBase).replaceAll('-', '')}.xlsx`;

            const url = URL.createObjectURL(blob);
            const enlace = document.createElement('a');
            enlace.href = url;
            enlace.download = nombre;
            document.body.appendChild(enlace);
            enlace.click();
            enlace.remove();
            URL.revokeObjectURL(url);
        } catch (e) {
            alert(e?.message || 'No se pudo descargar la comparativa.');
        } finally {
            if (btn) {
                btn.disabled = false;
                btn.textContent = 'Descargar Excel';
            }
        }
    }

    async function consultarComparativa(paginaSolicitada = 1) {
        cancelarRenderActivo();

        const pagina = Math.max(1, Number(paginaSolicitada) || 1);
        paginaComparativaActual = pagina;

        document.getElementById("theadComparativa").innerHTML = "";
        document.getElementById("tbodyComparativaCosteo").innerHTML = "";

        const consultaActual = TokenActivo;

        mostrarLoading(
            "Consultando información...",
            "SQL está calculando la comparativa y devolverá solamente la página solicitada."
        );

        bloquearConsulta();

        try {
            const filtro = getComparativaFiltro(pagina);

            if (!filtro.fechaBase) {
                throw new Error('Captura la fecha de la comparativa.');
            }

            if (!Number.isFinite(filtro.tolerancia) || filtro.tolerancia < 0) {
                throw new Error('La tolerancia debe ser un número mayor o igual a cero.');
            }

            const response = await fetch(
                '@Url.Action("ConsultarComparativaCosteo", "ProcesosCG")',
                {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    credentials: 'same-origin',
                    body: JSON.stringify(filtro)
                }
            );

            const textoRespuesta = await response.text();
            let resultado = {};

            try {
                resultado = textoRespuesta ? JSON.parse(textoRespuesta) : {};
            } catch {
                resultado = {
                    ok: false,
                    mensaje: 'El servidor devolvió una respuesta no válida.',
                    detalle: textoRespuesta
                };
            }

            if (!response.ok || !resultado?.ok) {
                const mensaje =
                    resultado?.mensaje ||
                    resultado?.msg ||
                    'No se pudo consultar la comparativa.';

                const detalle =
                    resultado?.detalle ||
                    resultado?.error ||
                    '';

                throw new Error(
                    detalle
                        ? `${mensaje}\n\nDetalle técnico:\n${detalle}`
                        : mensaje
                );
            }

            if (consultaActual !== TokenActivo) return;

            const datos = Array.isArray(resultado.datos)
                ? resultado.datos
                : [];

            datosComparativaActuales = datos;
            paginaComparativaActual = Math.max(1, Number(resultado.pagina) || pagina);
            totalPaginasComparativa = Math.max(0, Number(resultado.totalPaginas) || 0);
            totalFiltradoComparativa = Math.max(0, Number(resultado.total) || 0);
            resumenComparativaActual = resultado.resumen || {};
            codigosAjustablesComparativa = Array.isArray(resultado.codigosAjustables)
                ? resultado.codigosAjustables
                    .map(x => String(x || '').trim())
                    .filter(Boolean)
                : [];
            limiteAjustablesComparativaExcedido =
                resultado.limiteAjustablesExcedido === true;
            comparativaConsultada = true;

            actualizarLoading(
                "Mostrando resultados...",
                `Preparando ${datos.length.toLocaleString("es-MX")} registro(s) de la página ${paginaComparativaActual.toLocaleString("es-MX")}.`,
                100
            );

            renderResumen(resultado);
            renderEncabezado(datos);
            renderFilas(datos);
            renderPaginacionComparativa(resultado);
            actualizarEstadoCuadreComparativa();

            ocultarLoading();
        }
        catch (e) {
            if (consultaActual === TokenActivo) {
                ocultarLoading();
                alert(e?.message || 'Error al consultar la comparativa.');
            }
        }
        finally {
            if (consultaActual === TokenActivo) {
                desbloquearConsulta();
            }
        }
    }

    
    

    

    /*
        El procedimiento dbo.meat_CostoTIF copia costos desde TIF hacia Meat P1.
        Por seguridad solamente se envían etiquetas cuando TIF tiene un costo
        positivo. Si TIF está en cero, el procedimiento no puede inventar el
        costo y la incidencia debe permanecer visible.
    */
    

    

    function obtenerProgresoAjuste(job) {
        const solicitados = Math.max(0, Number(job?.codigosSolicitados) || 0);
        const procesados = Math.min(
            solicitados,
            Math.max(0, Number(job?.codigosProcesados) || 0)
        );
        const tamanoLote = Math.max(
            1,
            Number(job?.tamanoLote) || TAMANO_LOTE_AJUSTE_COMPARATIVA
        );
        const totalLotes = Math.max(
            0,
            Number(job?.totalLotes) ||
            (solicitados > 0 ? Math.ceil(solicitados / tamanoLote) : 0)
        );
        const loteActual = Math.min(
            totalLotes,
            Math.max(0, Number(job?.loteActual) || 0)
        );
        const porcentaje = solicitados > 0
            ? Math.min(100, Math.round((procesados * 10000) / solicitados) / 100)
            : 0;

        return { solicitados, procesados, tamanoLote, totalLotes, loteActual, porcentaje };
    }

    function actualizarEstadoCuadreComparativa() {
        const btn = document.getElementById('btnCuadrarComparativa');
        const texto = document.getElementById('txtPendientesComparativa');

        if (!btn || !texto) {
            console.error('No se encontró la barra de Cuadrar comparativa en el DOM.');
            return;
        }

        const totalAjustables = Math.max(
            0,
            Number(resumenComparativaActual?.totalAjustables) || 0
        );
        const totalSinCostoTif = Math.max(
            0,
            Number(resumenComparativaActual?.totalSinCostoTIF) || 0
        );
        const codigosDisponibles = codigosAjustablesComparativa.length;
        const respuestaIncompleta =
            limiteAjustablesComparativaExcedido ||
            codigosDisponibles < totalAjustables;
        const trabajoActivo = window.CosteoAjusteMonitor?.getActive?.();

        if (trabajoActivo?.jobId) {
            const progreso = obtenerProgresoAjuste(trabajoActivo);

            btn.disabled = true;
            btn.textContent = progreso.solicitados > 0
                ? `Ajustando ${progreso.procesados.toLocaleString('es-MX')}/${progreso.solicitados.toLocaleString('es-MX')}`
                : 'Ajuste en segundo plano';

            texto.textContent =
                trabajoActivo.mensaje ||
                (
                    progreso.totalLotes > 0
                        ? `Procesando lote ${progreso.loteActual.toLocaleString('es-MX')} de ${progreso.totalLotes.toLocaleString('es-MX')} · ${progreso.porcentaje.toLocaleString('es-MX')}%.`
                        : 'El procedimiento dbo.meat_CostoTIF se está ejecutando en segundo plano.'
                );
            return;
        }

        btn.textContent =
            `Cuadrar comparativa (${totalAjustables.toLocaleString('es-MX')})`;

        btn.disabled =
            !comparativaConsultada ||
            totalAjustables === 0 ||
            respuestaIncompleta;

        if (!comparativaConsultada) {
            texto.textContent =
                'Consulta la comparativa para identificar diferencias o registros sin costo.';
            return;
        }

        const partes = [];

        if (totalAjustables > 0) {
            const totalLotes = Math.ceil(
                totalAjustables / TAMANO_LOTE_AJUSTE_COMPARATIVA
            );

            partes.push(
                `${totalAjustables.toLocaleString('es-MX')} etiqueta(s) ajustable(s) en P1`
            );
            partes.push(
                `${totalLotes.toLocaleString('es-MX')} lote(s) secuencial(es) de hasta ${TAMANO_LOTE_AJUSTE_COMPARATIVA.toLocaleString('es-MX')}`
            );
        } else {
            partes.push('No hay etiquetas ajustables en P1');
        }

        if (totalSinCostoTif > 0) {
            partes.push(
                `${totalSinCostoTif.toLocaleString('es-MX')} etiqueta(s) sin costo válido en TIF; primero deben costearse en TIF`
            );
        }

        if (respuestaIncompleta) {
            partes.push(
                `el servidor devolvió ${codigosDisponibles.toLocaleString('es-MX')} de ${totalAjustables.toLocaleString('es-MX')} códigos; instala también el controlador ajustado`
            );
        }

        texto.textContent = partes.join(' · ') + '.';
    }

    async function cuadrarComparativa() {
        const btn = document.getElementById('btnCuadrarComparativa');
        const totalAjustables = Math.max(
            0,
            Number(resumenComparativaActual?.totalAjustables) || 0
        );
        const totalSinCostoTif = Math.max(
            0,
            Number(resumenComparativaActual?.totalSinCostoTIF) || 0
        );
        const codigos = [...codigosAjustablesComparativa];
        const totalLotes = Math.ceil(
            codigos.length / TAMANO_LOTE_AJUSTE_COMPARATIVA
        );

        if (!btn) {
            alert('No se encontró el botón para cuadrar la comparativa.');
            return;
        }

        const trabajoActivo = window.CosteoAjusteMonitor?.getActive?.();
        if (trabajoActivo?.jobId) {
            window.CosteoAjusteMonitor.toast(
                'info',
                'Ajuste en proceso',
                'Ya existe un ajuste ejecutándose en segundo plano.',
                8000
            );
            return;
        }

        if (
            limiteAjustablesComparativaExcedido ||
            codigos.length < totalAjustables
        ) {
            alert(
                'La vista recibió una lista incompleta de códigos ajustables.\n\n' +
                `Servidor: ${codigos.length.toLocaleString('es-MX')} código(s).\n` +
                `Resumen: ${totalAjustables.toLocaleString('es-MX')} etiqueta(s).\n\n` +
                'Reemplaza también ProcesosCgController.cs por la versión ajustada para procesamiento por lotes.'
            );
            return;
        }

        if (totalAjustables === 0 || codigos.length === 0) {
            const mensaje = totalSinCostoTif > 0
                ? `No hay etiquetas ajustables desde P1.\n\n` +
                  `${totalSinCostoTif.toLocaleString('es-MX')} etiqueta(s) no tienen costo válido en TIF. ` +
                  'Primero deben costearse en TIF; dbo.meat_CostoTIF no puede inventar ese costo.'
                : 'No hay diferencias ajustables en P1.';

            alert(mensaje);
            actualizarEstadoCuadreComparativa();
            return;
        }

        const muestra = codigos.slice(0, 8).join(', ');
        const adicionales = codigos.length > 8
            ? `\n... y ${codigos.length - 8} etiqueta(s) adicional(es).`
            : '';

        const confirmado = window.confirm(
            'ATENCIÓN: esta operación modificará costos en la base Meat de P1.\n\n' +
            `Se ajustarán ${codigos.length.toLocaleString('es-MX')} etiqueta(s) con costo positivo en TIF.\n\n` +
            `El servidor las procesará secuencialmente en ${totalLotes.toLocaleString('es-MX')} lote(s) de hasta ${TAMANO_LOTE_AJUSTE_COMPARATIVA.toLocaleString('es-MX')} etiqueta(s).\n` +
            'Nunca se ejecutarán dos lotes al mismo tiempo.\n\n' +
            'Los códigos corresponden a todo el filtro consultado, no solamente a la página visible.\n\n' +
            `Ejemplos: ${muestra}${adicionales}\n\n` +
            'El proceso continuará en el servidor aunque cierres el modal o cambies de pestaña.\n\n' +
            '¿Confirmas que deseas cuadrar la comparativa?'
        );

        if (!confirmado) return;

        try {
            btn.disabled = true;
            btn.textContent = 'Iniciando ajuste por lotes...';

            await window.CosteoAjusteMonitor?.requestNotificationPermission?.();

            const response = await fetch(
                '@Url.Action("IniciarAjusteComparativaCosteo", "ProcesosCG")',
                {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify({
                        CodigosEtiqueta: codigos,
                        TamanoLote: TAMANO_LOTE_AJUSTE_COMPARATIVA
                    })
                }
            );

            const textoRespuesta = await response.text();
            let resultado = {};

            try {
                resultado = textoRespuesta ? JSON.parse(textoRespuesta) : {};
            } catch {
                resultado = {
                    ok: false,
                    mensaje: 'El servidor devolvió una respuesta no válida.',
                    detalle: textoRespuesta
                };
            }

            const puedeAdjuntarTrabajo =
                response.status === 409 &&
                resultado?.yaExiste === true &&
                resultado?.jobId;

            if ((!response.ok || !resultado?.ok) && !puedeAdjuntarTrabajo) {
                const mensaje =
                    resultado?.mensaje ||
                    resultado?.msg ||
                    'No se pudo iniciar el ajuste de la comparativa.';

                const detalle = resultado?.detalle || resultado?.error || '';

                throw new Error(
                    detalle
                        ? `${mensaje}\n\nDetalle técnico:\n${detalle}`
                        : mensaje
                );
            }

            const jobId = resultado.jobId;

            if (!jobId) {
                throw new Error(
                    'El servidor no devolvió el identificador del trabajo.'
                );
            }

            if (!window.CosteoAjusteMonitor?.track) {
                throw new Error(
                    'No se cargó el monitor de ajustes de costeo. Recarga la página con Ctrl+F5 e inténtalo nuevamente.'
                );
            }

            await window.CosteoAjusteMonitor.track(jobId, {
                codigosSolicitados:
                    resultado?.codigosSolicitados ?? codigos.length,
                codigosProcesados:
                    resultado?.codigosProcesados ?? 0,
                tamanoLote:
                    resultado?.tamanoLote ?? TAMANO_LOTE_AJUSTE_COMPARATIVA,
                loteActual:
                    resultado?.loteActual ?? 0,
                totalLotes:
                    resultado?.totalLotes ?? totalLotes,
                mensaje:
                    resultado?.mensaje ||
                    'Ajuste por lotes iniciado en segundo plano.'
            });

            btn.disabled = true;
            btn.textContent =
                `Ajustando 0/${(resultado?.codigosSolicitados ?? codigos.length).toLocaleString('es-MX')}`;

            window.CosteoAjusteMonitor.toast(
                'info',
                puedeAdjuntarTrabajo
                    ? 'Ajuste ya en proceso'
                    : 'Ajuste por lotes iniciado',
                `Se procesarán ${(resultado?.totalLotes ?? totalLotes).toLocaleString('es-MX')} lote(s) secuenciales de hasta ${(resultado?.tamanoLote ?? TAMANO_LOTE_AJUSTE_COMPARATIVA).toLocaleString('es-MX')} etiquetas. Puedes navegar por la aplicación.`,
                14000
            );
        }
        catch (e) {
            actualizarEstadoCuadreComparativa();
            alert(
                e?.message ||
                'Ocurrió un error al iniciar el ajuste de la comparativa.'
            );
        }
    }

    window.addEventListener('costeo-ajuste-estado', function (event) {
        const job = event?.detail || {};
        const btn = document.getElementById('btnCuadrarComparativa');
        const texto = document.getElementById('txtPendientesComparativa');
        if (!btn) return;

        if (job.estado === 'PENDIENTE' || job.estado === 'EJECUTANDO') {
            const progreso = obtenerProgresoAjuste(job);

            btn.disabled = true;
            btn.textContent = progreso.solicitados > 0
                ? `Ajustando ${progreso.procesados.toLocaleString('es-MX')}/${progreso.solicitados.toLocaleString('es-MX')}`
                : 'Ajuste en segundo plano';

            if (texto) {
                texto.textContent =
                    job.mensaje ||
                    (
                        progreso.totalLotes > 0
                            ? `Lote ${progreso.loteActual.toLocaleString('es-MX')} de ${progreso.totalLotes.toLocaleString('es-MX')} · ${progreso.porcentaje.toLocaleString('es-MX')}%.`
                            : 'El procedimiento dbo.meat_CostoTIF se está ejecutando en segundo plano.'
                    );
            }
        }
    });

    window.addEventListener('costeo-ajuste-finalizado', async function (event) {
        const job = event?.detail || {};
        const btn = document.getElementById('btnCuadrarComparativa');

        if (btn) {
            btn.disabled = false;
            btn.textContent = 'Cuadrar comparativa';
        }

        // Solo actualiza automáticamente la tabla cuando la comparativa está abierta.
        const modal = document.getElementById('modalComparativa');
        if (job.exito === true && modal?.classList.contains('show')) {
            try {
                await consultarComparativa(1);
            } catch (e) {
                console.warn('No se pudo refrescar automáticamente la comparativa:', e);
            }
        } else {
            actualizarEstadoCuadreComparativa();
        }
    });

    function renderEncabezado(datos) {

       
        
        const thead = document.getElementById("theadComparativa");

        thead.innerHTML = "";

        if (!datos || datos.length === 0)
            return;
        
        const columnas = Object.keys(datos[0]);

        let html = "<tr>";

        for (const columna of columnas) {
            html += `<th class="${obtenerClaseColumna(columna)}">${columna}</th>`;
        }

        html += "</tr>";

        thead.innerHTML = html;

        
    }


    function renderFilas(datos) {
        const tbody = document.getElementById("tbodyComparativaCosteo");

        if (!tbody) return;

        if (!Array.isArray(datos) || datos.length === 0) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="17" class="text-center" style="padding:18px !important;">
                        No hay registros para el filtro seleccionado.
                    </td>
                </tr>
            `;
            return;
        }

        const columnas = Object.keys(datos[0]);

        tbody.innerHTML = datos.map(fila => {
            const celdas = columnas.map(columna => `
                <td class="${obtenerClaseColumna(columna)}">
                    ${formatearCelda(columna, fila[columna])}
                </td>
            `).join('');

            return `<tr>${celdas}</tr>`;
        }).join('');
    }




    function formatearCelda(columna, valor){

        if (columna === "estadoCosto" || columna === "EstadoCosto"){
            switch (valor) {
                 case "100% MISMO COSTO":
            return `<span class="badge bg-success">${valor}</span>`;

        case "COSTO DIFERENTE":
            return `<span class="badge bg-danger">${valor}</span>`;

        case "SIN COSTO EN TIF":
            return `<span class="badge bg-warning text-dark">${valor}</span>`;

        case "SIN COSTO EN P1":
            return `<span class="badge text-white"
                        style="background:#fd7e14;">
                        ${valor}
                    </span>`;

        case "SIN COSTO EN TIF Y P1":
            return `<span class="badge bg-secondary">${valor}</span>`;
            }
        }

        if (typeof valor === "string" && valor.includes("T")){
            const fecha = new Date(valor);

            if (!isNaN(fecha)) {
                return fecha.toLocaleDateString("es-MX");
            }
        }

        return valor;
    }

    function obtenerClaseColumna(nombre){

        if(nombre.includes("Producto"))
            return "col-producto";

        if(nombre.includes("Costo"))
            return "col-costo";

        if(nombre.includes("Peso"))
            return "col-peso";

        if(nombre.includes("Estado"))
            return "col-estado";

        if(nombre.includes("Id"))
            return "col-id";

        return "";
    }

    function renderResumen(resultado) {
        const contenedor = document.getElementById("resumenComparativa");

        if (!contenedor) return;

        const resumen = resultado?.resumen || {};
        const totalGeneral = Number(resumen.totalGeneral || 0);
        const totalFiltrado = Number(resumen.totalFiltrado ?? resultado?.total ?? 0);
        const mismoCosto = Number(resumen.mismoCosto || 0);
        const costoDiferente = Number(resumen.costoDiferente || 0);
        const sinCostoTIF = Number(resumen.sinCostoTIF || 0);
        const sinCostoP1 = Number(resumen.sinCostoP1 || 0);
        const sinCostoAmbos = Number(resumen.sinCostoAmbos || 0);

        contenedor.innerHTML = `
            <div class="comparativa-resumen">
                <span class="resumen-chip">
                    <strong>Total periodo:</strong>
                    ${totalGeneral.toLocaleString("es-MX")}
                </span>

                <span class="resumen-chip">
                    <strong>Según filtro:</strong>
                    ${totalFiltrado.toLocaleString("es-MX")}
                </span>

                <span class="resumen-chip">
                    <strong>Mismo costo:</strong>
                    ${mismoCosto.toLocaleString("es-MX")}
                </span>

                <span class="resumen-chip alerta">
                    <strong>Diferente:</strong>
                    ${costoDiferente.toLocaleString("es-MX")}
                </span>

                <span class="resumen-chip alerta">
                    <strong>Sin costo TIF:</strong>
                    ${sinCostoTIF.toLocaleString("es-MX")}
                </span>

                <span class="resumen-chip alerta">
                    <strong>Sin costo P1:</strong>
                    ${sinCostoP1.toLocaleString("es-MX")}
                </span>

                <span class="resumen-chip alerta">
                    <strong>Sin costo en ambas:</strong>
                    ${sinCostoAmbos.toLocaleString("es-MX")}
                </span>
            </div>
        `;
    }

        const ajusteActivoAlCargar = window.CosteoAjusteMonitor?.getActive?.();
        if (ajusteActivoAlCargar?.jobId) {
            window.dispatchEvent(new CustomEvent('costeo-ajuste-estado', {
                detail: ajusteActivoAlCargar
            }));
        }

        const modalComparativa = document.getElementById("modalComparativa");

        modalComparativa.addEventListener("hidden.bs.modal", () => {
            limpiarComparativa();
        })
   
</script>