    /* ============================================================
       RESPUESTA AL ANCHO REAL QUE DEJA EL SIDEBAR
       ============================================================ */
    @@container costeo-grid (max-width: 1250px) {
        .costeo-app .filters {
            grid-template-columns: repeat(10, minmax(0, 1fr)) !important;
        }

        .costeo-app .filters > .filter-group {
            grid-column: span 2 !important;
        }

        .costeo-app .filters > .filter-group:last-child {
            grid-column: span 4 !important;
        }

        .costeo-app .checks-row {
            grid-template-columns: repeat(3, max-content) minmax(140px, 1fr) !important;
        }
    }

    @@container costeo-grid (max-width: 900px) {
        .costeo-app .filters {
            grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        }

        .costeo-app .filters > .filter-group {
            grid-column: span 1 !important;
        }

        .costeo-app .filters > .filter-group:last-child {
            grid-column: 1 / -1 !important;
        }

        .costeo-app .checks-row {
            grid-template-columns: repeat(3, max-content) !important;
        }

        .costeo-app .checks-row > span.check-inline {
            grid-column: 1 / -1 !important;
            justify-self: start !important;
            text-align: left !important;
        }
    }

    @@container costeo-grid (max-width: 620px) {
        .costeo-app .content {
            padding: 0 !important;
        }

        .costeo-app .tabs {
            grid-template-columns: 1fr 1fr !important;
        }

        .costeo-app .tabs .pm-btn {
            width: 100% !important;
        }

        .costeo-app .filters {
            grid-template-columns: 1fr !important;
        }

        .costeo-app .filters > .filter-group,
        .costeo-app .filters > .filter-group:last-child {
            grid-column: auto !important;
        }

        .costeo-app .checks-row {
            grid-template-columns: 1fr !important;
        }

        .costeo-app .checks-row > span.check-inline {
            grid-column: auto !important;
        }
    }

    @@media (max-width: 900px) {
        #modalHistorico .filters-historico,
        #modalComparativa .filters {
            grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        }

        #modalHistorico .filters-historico > .filter-group:last-child,
        #modalComparativa .filters > .mt-3.text-end {
            grid-column: 1 / -1 !important;
        }

        #modalComparativa .ajuste-comparativa-bar,
        #modalComparativa .comparativa-paginacion {
            grid-template-columns: 1fr !important;
        }

        #modalComparativa .comparativa-paginacion-controles {
            grid-template-columns: auto 58px 1fr 65px 65px !important;
        }
    }

    @@media (max-width: 560px) {
        #modalHistorico .filters-historico,
        #modalComparativa .filters {
            grid-template-columns: 1fr !important;
        }

        #modalHistorico .filters-historico > .filter-group:last-child,
        #modalComparativa .filters > .mt-3.text-end {
            grid-column: auto !important;
        }

        #modalHistorico .filters-historico .pm-actions,
        #modalComparativa .filters > .mt-3.text-end {
            grid-template-columns: 1fr !important;
        }

        #modalComparativa .comparativa-paginacion-controles {
            grid-template-columns: 1fr 1fr !important;
        }

        #modalComparativa #cmpNumeroPagina {
            min-width: 0 !important;
            text-align: left !important;
        }
    }


    /* ============================================================
       AJUSTE FINAL — COSTEO
       POPPINS + UN SOLO SCROLL VERTICAL + FOOTER COMPACTO
       Solo aplica mientras esta vista está cargada.
       ============================================================ */

    :root {
        --costeo-font-final: "Poppins", system-ui, -apple-system, "Segoe UI", Arial, sans-serif;
    }

    /* ============================================================
       1. TIPOGRAFÍA POPPINS
       ============================================================ */

    .costeo-app,
    .costeo-app *,
    #modalHistorico,
    #modalHistorico *,
    #modalComparativa,
    #modalComparativa * {
        font-family: var(--costeo-font-final) !important;
    }

    .costeo-app {
        font-size: 11px !important;
        line-height: 1.22 !important;
        font-weight: 400 !important;
    }

    .costeo-app .section-title {
        font-size: 10px !important;
        font-weight: 600 !important;
        line-height: 1.05 !important;
    }

    .costeo-app .filter-group label {
        font-size: 9px !important;
        font-weight: 600 !important;
        line-height: 1.05 !important;
        margin-bottom: 2px !important;
    }

    .costeo-app input,
    .costeo-app select,
    .costeo-app textarea,
    .costeo-app .form-control,
    .costeo-app .form-select {
        font-family: var(--costeo-font-final) !important;
        font-size: 10px !important;
        font-weight: 400 !important;
        line-height: 1.1 !important;
    }

    .costeo-app .pm-btn,
    .costeo-app .btn,
    .costeo-app button {
        font-family: var(--costeo-font-final) !important;
        font-size: 9px !important;
        font-weight: 600 !important;
        line-height: 1 !important;
    }

    .costeo-app .check-inline,
    .costeo-app .auto-status-panel,
    .costeo-app .auto-status-item {
        font-family: var(--costeo-font-final) !important;
    }

    .costeo-app .check-inline {
        font-size: 8.5px !important;
        font-weight: 500 !important;
    }

    .costeo-app .auto-status-title {
        font-size: 9px !important;
        font-weight: 600 !important;
    }

    .costeo-app .auto-status-item {
        font-size: 8.5px !important;
        font-weight: 500 !important;
    }

    .costeo-app .log-inner {
        font-family: var(--costeo-font-final) !important;
        font-size: 9px !important;
        line-height: 1.15 !important;
    }

    .costeo-app .statusbar,
    .statusbar {
        font-family: var(--costeo-font-final) !important;
        font-size: 9px !important;
        line-height: 1.1 !important;
    }

    /* ============================================================
       2. UN SOLO SCROLL VERTICAL EN LA PÁGINA
       ============================================================ */

    html {
        width: 100% !important;
        min-height: 100% !important;
        height: auto !important;
        margin: 0 !important;
        padding: 0 !important;
        overflow-x: hidden !important;
        overflow-y: auto !important;
    }

    body.layout-body,
    body {
        width: 100% !important;
        min-height: 100dvh !important;
        height: auto !important;

        margin: 0 !important;
        padding: 0 !important;

        display: flex !important;
        flex-direction: column !important;

        overflow-x: hidden !important;
        overflow-y: visible !important;
    }

    /*
       _Layout2 usa min-height:100vh en el main.
       Al sumarle footer puede generar altura extra.
       Aquí se anula únicamente para Costeo.
    */
    .layout-main-content {
        /*
           El sidebar de _Layout2 conserva su margin-left.
           width:auto hace que esta vista use solamente el espacio
           restante y se comprima, en lugar de desplazarse a la derecha.
        */
        flex: 1 1 auto !important;
        width: auto !important;
        max-width: 100% !important;
        min-width: 0 !important;

        min-height: 0 !important;
        height: auto !important;
        max-height: none !important;

        overflow-x: hidden !important;
        overflow-y: visible !important;

        padding-bottom: 5px !important;
        box-sizing: border-box !important;
    }

    .layout-main-content > .layout-container-fluid,
    .layout-main-content .layout-container-fluid {
        width: 100% !important;
        max-width: 100% !important;
        min-width: 0 !important;

        min-height: 0 !important;
        height: auto !important;
        max-height: none !important;

        overflow-x: hidden !important;
        overflow-y: visible !important;

        box-sizing: border-box !important;
    }

    .costeo-app {
        width: 100% !important;
        max-width: 100% !important;

        min-height: 0 !important;
        height: auto !important;
        max-height: none !important;

        margin-bottom: 0 !important;
        padding-bottom: 3px !important;

        overflow-x: hidden !important;
        overflow-y: visible !important;

        box-sizing: border-box !important;
    }

    .costeo-app .content,
    .costeo-app .workspace,
    .costeo-app .section {
        min-height: 0 !important;
        height: auto !important;
        max-height: none !important;
    }


    /* ============================================================
       3. TABLAS PRINCIPALES DE COSTEO
       QUITAMOS EL SEGUNDO SCROLL VERTICAL.
       La tabla crece y el BODY controla el desplazamiento vertical.
       Se conserva scroll horizontal.
       ============================================================ */

    .costeo-app .table-wrap {
        width: 100% !important;
        max-width: 100% !important;

        min-height: 0 !important;
        height: auto !important;
        max-height: none !important;

        overflow-x: auto !important;
        overflow-y: visible !important;

        scrollbar-gutter: auto !important;
        -webkit-overflow-scrolling: touch !important;
    }


    /* ============================================================
       4. FOOTER DEL LAYOUT
       ============================================================ */

    .layout-footer {
        flex: 0 0 auto !important;

        position: static !important;
        left: auto !important;
        right: auto !important;
        bottom: auto !important;

        width: 100% !important;
        height: auto !important;
        min-height: 29px !important;

        margin: 0 !important;
        padding: 4px 0 !important;

        font-family: var(--costeo-font-final) !important;
        font-size: 11px !important;
        font-weight: 400 !important;
        line-height: 1.15 !important;

        text-align: center !important;
        box-sizing: border-box !important;
    }

    .layout-footer .container,
    .layout-footer .container-fluid {
        width: 100% !important;
        min-height: 20px !important;
        height: auto !important;

        margin: 0 auto !important;
