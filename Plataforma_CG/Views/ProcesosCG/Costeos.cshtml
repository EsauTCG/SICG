<script src="@Url.Content("~/js/costeo-ajuste-monitor.js?v=20260806-2")"></script>

<!-- Respaldo integrado: evita que el ajuste falle si el archivo JS externo no fue publicado o quedó en caché. -->
<script>
(function () {
    'use strict';

    if (window.CosteoAjusteMonitor) return;

    const ACTIVE_KEY = 'cg.costeo.ajusteComparativa.activo';
    const LAST_KEY = 'cg.costeo.ajusteComparativa.ultimoResultado';
    const POLL_MS = 3000;
    const channel = ('BroadcastChannel' in window)
        ? new BroadcastChannel('cg-costeo-ajuste-comparativa')
        : null;

    let timer = null;
    let consultando = false;

    function getConfig() {
        return window.CosteoAjusteConfig || {};
    }

    function leerJson(key) {
        try {
            const raw = localStorage.getItem(key);
            return raw ? JSON.parse(raw) : null;
        } catch {
            return null;
        }
    }

    function guardarJson(key, value) {
        try {
            localStorage.setItem(key, JSON.stringify(value));
        } catch { }
    }

    function eliminar(key) {
        try { localStorage.removeItem(key); } catch { }
    }

    function getActive() {
        return leerJson(ACTIVE_KEY);
    }

    function ensureToastHost() {
        let host = document.getElementById('cgCosteoToastHost');
        if (host) return host;

        host = document.createElement('div');
        host.id = 'cgCosteoToastHost';
        host.style.cssText = [
            'position:fixed',
            'top:18px',
            'right:18px',
            'z-index:2147483647',
            'display:flex',
            'flex-direction:column',
            'gap:10px',
            'width:min(420px,calc(100vw - 36px))',
            'pointer-events:none'
        ].join(';');

        document.body.appendChild(host);
        return host;
    }

    function toast(tipo, titulo, mensaje, duracionMs) {
        if (!document.body) return;

        const host = ensureToastHost();
        const item = document.createElement('div');
        const paleta = {
            success: { bg: '#e3f5e9', border: '#198754', text: '#124d31' },
            danger:  { bg: '#fde8e8', border: '#b02a37', text: '#721c24' },
            warning: { bg: '#fff4d6', border: '#c87800', text: '#604000' },
            info:    { bg: '#e8f2ff', border: '#0d6efd', text: '#083b80' }
        };
        const p = paleta[tipo] || paleta.info;

        item.style.cssText = [
            'pointer-events:auto',
            'background:' + p.bg,
            'border:1px solid ' + p.border,
            'border-left:6px solid ' + p.border,
            'color:' + p.text,
            'box-shadow:0 8px 24px rgba(0,0,0,.22)',
            'padding:12px 42px 12px 14px',
            'font-family:Tahoma,Verdana,Arial,sans-serif',
            'font-size:13px',
            'line-height:1.45',
            'position:relative',
            'opacity:0',
            'transform:translateY(-8px)',
            'transition:opacity .2s ease,transform .2s ease'
        ].join(';');

        const title = document.createElement('div');
        title.style.cssText = 'font-weight:700;margin-bottom:4px;';
        title.textContent = titulo || 'Costeo';

        const body = document.createElement('div');
        body.textContent = mensaje || '';

        const close = document.createElement('button');
        close.type = 'button';
        close.setAttribute('aria-label', 'Cerrar');
        close.textContent = '×';
        close.style.cssText = [
            'position:absolute',
            'right:10px',
            'top:7px',
            'border:0',
            'background:transparent',
            'font-size:24px',
            'line-height:1',
            'cursor:pointer',
            'color:inherit'
        ].join(';');

        const remove = function () {
            item.style.opacity = '0';
            item.style.transform = 'translateY(-8px)';
            setTimeout(function () { item.remove(); }, 220);
        };

        close.addEventListener('click', remove);
        item.append(title, body, close);
        host.appendChild(item);

        requestAnimationFrame(function () {
            item.style.opacity = '1';
            item.style.transform = 'translateY(0)';
        });

        const tiempo = Number.isFinite(duracionMs) ? duracionMs : 12000;
        if (tiempo > 0) setTimeout(remove, tiempo);
    }

    async function requestNotificationPermission() {
        if (!('Notification' in window)) return 'unsupported';
        if (Notification.permission !== 'default') return Notification.permission;

        try {
            return await Notification.requestPermission();
        } catch {
            return Notification.permission;
        }
    }

    function systemNotification(job) {
        if (!('Notification' in window) || Notification.permission !== 'granted') return;

        const marker = 'cg.costeo.ajusteComparativa.notificado.' + job.jobId;
        if (localStorage.getItem(marker)) return;

        localStorage.setItem(marker, new Date().toISOString());

        try {
            const titulo = job.exito
                ? 'Comparativa de costeo terminada'
                : 'Error al cuadrar la comparativa';

            const n = new Notification(titulo, {
                body: job.exito
                    ? `${job.codigosSolicitados || 0} etiqueta(s) procesada(s) correctamente.`
                    : (job.mensaje || 'El ajuste terminó con error.'),
                tag: 'cg-costeo-ajuste-' + job.jobId,
                requireInteraction: !job.exito
            });

            n.onclick = function () {
                window.focus();
                const url = getConfig().costeoUrl;
                if (url && !String(location.pathname).toLowerCase().includes('/procesoscg/costeo')) {
                    location.href = url;
                }
                n.close();
            };
        } catch { }
    }

    function dispatch(nombre, detail) {
        try {
            window.dispatchEvent(new CustomEvent(nombre, { detail: detail }));
        } catch { }
    }

    function showCompletion(job) {
        const sessionKey = 'cg.costeo.ajusteComparativa.mostrado.' + job.jobId;
        if (!sessionStorage.getItem(sessionKey)) {
            sessionStorage.setItem(sessionKey, '1');

            if (job.exito) {
                toast(
                    'success',
                    'Comparativa cuadrada',
                    `${job.mensaje || 'El procedimiento terminó correctamente.'} Etiquetas: ${Number(job.codigosSolicitados || 0).toLocaleString('es-MX')}.`,
                    18000
                );
            } else {
                toast(
                    'danger',
                    'No se pudo cuadrar la comparativa',
                    [job.mensaje, job.detalle].filter(Boolean).join(' Detalle: '),
                    0
                );
            }
        }

        systemNotification(job);
        dispatch('costeo-ajuste-finalizado', job);
    }

    function stopTimer() {
        if (timer) clearInterval(timer);
        timer = null;
    }

    function startTimer() {
        stopTimer();
        timer = setInterval(pollNow, POLL_MS);
    }

    async function pollNow() {
        if (consultando) return;

        const active = getActive();
        if (!active || !active.jobId) {
            stopTimer();
            return;
        }

        const estadoUrl = getConfig().estadoUrl;
        if (!estadoUrl) return;

        consultando = true;

        try {
            const sep = estadoUrl.includes('?') ? '&' : '?';
            const response = await fetch(
                estadoUrl + sep + 'jobId=' + encodeURIComponent(active.jobId),
                {
                    credentials: 'same-origin',
                    cache: 'no-store',
                    headers: { 'Accept': 'application/json' }
                }
            );

            const text = await response.text();
            let data = {};

            try { data = text ? JSON.parse(text) : {}; }
            catch { data = { ok: false, mensaje: text || 'Respuesta no válida.' }; }

            if (!response.ok || !data?.ok) {
                if (response.status === 404) {
                    eliminar(ACTIVE_KEY);
                    stopTimer();
                    toast(
                        'warning',
                        'No se pudo recuperar el ajuste',
                        data?.mensaje || 'La aplicación pudo haberse reiniciado.',
                        0
                    );
                    dispatch('costeo-ajuste-finalizado', {
                        jobId: active.jobId,
                        exito: false,
                        estado: 'DESCONOCIDO',
                        mensaje: data?.mensaje || 'No se encontró el trabajo.'
                    });
                }
                return;
            }

            const job = Object.assign({}, active, data);
            guardarJson(ACTIVE_KEY, job);
            dispatch('costeo-ajuste-estado', job);

            if (data.terminado === true) {
                eliminar(ACTIVE_KEY);
                guardarJson(LAST_KEY, job);
                stopTimer();
                showCompletion(job);
                if (channel) channel.postMessage({ type: 'completed', job: job });
            }
        } catch (error) {
            dispatch('costeo-ajuste-conexion', {
                jobId: active.jobId,
                mensaje: error?.message || String(error)
            });
        } finally {
            consultando = false;
        }
    }

    async function track(jobId, meta) {
        const active = Object.assign({
            jobId: jobId,
            estado: 'PENDIENTE',
            iniciadoCliente: new Date().toISOString()
        }, meta || {});

        guardarJson(ACTIVE_KEY, active);
        dispatch('costeo-ajuste-estado', active);
        startTimer();
        await pollNow();
    }

    function resume() {
        const active = getActive();
        if (!active?.jobId) return;
        dispatch('costeo-ajuste-estado', active);
        startTimer();
        pollNow();
    }

    if (channel) {
        channel.onmessage = function (event) {
            const msg = event?.data;
            if (msg?.type === 'completed' && msg.job) {
                eliminar(ACTIVE_KEY);
                stopTimer();
                showCompletion(msg.job);
            }
        };
    }

    window.addEventListener('storage', function (event) {
        if (event.key === ACTIVE_KEY) resume();
    });

    window.CosteoAjusteMonitor = {
        track: track,
        resume: resume,
        pollNow: pollNow,
        getActive: getActive,
        toast: toast,
        requestNotificationPermission: requestNotificationPermission
    };

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', resume, { once: true });
    } else {
        resume();
    }
})();
</script>

<script>
    function showLog(type, text) {
        const box = document.getElementById('logBox');
        const log = document.getElementById('log');
        if (!box || !log) return;

        box.style.display = 'block';
        log.className = 'log-inner log-' + (type || 'secondary');
        log.textContent = text || '';
    }

    function getPayload() {
        const modo = (document.getElementById('Modo')?.value || 'DIA').toUpperCase();

        return {
            Source: document.getElementById('Source')?.value || 'P1',
            TipoProceso: document.getElementById('TipoProceso')?.value || 'CAJAS',
            Modo: modo,
            FechaInicial: document.getElementById('FechaInicial')?.value || null,
            FechaFinal: (modo === 'DIA' || modo === 'MES'
                ? (document.getElementById('FechaInicial')?.value || null)
                : (document.getElementById('FechaFinal')?.value || null)),
            TipoCosteoId: parseInt(document.getElementById('TipoCosteoId')?.value || '1'),
            LoteId: (modo === 'LOTE' && document.getElementById('LoteId')?.value)
                ? parseInt(document.getElementById('LoteId').value)
                : null,
            BrincarSinCosto: document.getElementById('BrincarSinCosto')?.checked === true,
            ContinuarConError: document.getElementById('ContinuarConError')?.checked === true,
            Automatico: document.getElementById('Automatico')?.checked === true,
            HoraProgramada: document.getElementById('HoraProgramada')?.value || '18:00'
        };
    }

    function getFechaLocalISO(fecha = new Date()) {
        const yyyy = fecha.getFullYear();
        const mm = String(fecha.getMonth() + 1).padStart(2, '0');
        const dd = String(fecha.getDate()).padStart(2, '0');
        return `${yyyy}-${mm}-${dd}`;
    }

    function formatearFechaISO(fechaIso) {
        if (!fechaIso) return '-';

        const partes = fechaIso.split('-');
        if (partes.length !== 3) return fechaIso;

        return `${partes[2]}/${partes[1]}/${partes[0]}`;
    }

    function formatearMesISO(fechaIso) {
        if (!fechaIso) return '-';

        const partes = fechaIso.split('-').map(Number);
        if (partes.length < 2 || !partes[0] || !partes[1]) return fechaIso;

        const fecha = new Date(partes[0], partes[1] - 1, 1);
        return new Intl.DateTimeFormat('es-MX', {
            month: 'long',
            year: 'numeric'
        }).format(fecha);
    }

    function confirmarPeriodoCosteo(payload) {
        // En costeo por lote la fecha visible no controla el periodo de ejecución.
        if (!payload || payload.Modo === 'LOTE') return true;

        const hoy = getFechaLocalISO();
        const mesActual = hoy.substring(0, 7);
        const fechaInicial = payload.FechaInicial;
        const fechaFinal = payload.Modo === 'RANGO'
            ? payload.FechaFinal
            : payload.FechaInicial;

        if (!fechaInicial) return true;

        const fueraDelMesActual = [fechaInicial, fechaFinal]
            .filter(Boolean)
            .some(fecha => fecha.substring(0, 7) !== mesActual);

        let requiereConfirmacion = false;
        let nivel = 'PRECAUCIÓN';
        let motivo = '';
        let periodo = '';

        if (payload.Modo === 'MES') {
            // En modo MES solamente importa el mes elegido, no el día del selector.
            requiereConfirmacion = fechaInicial.substring(0, 7) !== mesActual;
            nivel = 'ADVERTENCIA CRÍTICA';
            motivo = 'El mes seleccionado no corresponde al mes actual.';
            periodo = `Mes seleccionado: ${formatearMesISO(fechaInicial)}`;
        } else if (payload.Modo === 'RANGO') {
            requiereConfirmacion = fechaInicial !== hoy || fechaFinal !== hoy;
            nivel = fueraDelMesActual ? 'ADVERTENCIA CRÍTICA' : 'PRECAUCIÓN';
            motivo = fueraDelMesActual
                ? 'El rango incluye fechas fuera del mes actual.'
                : 'El rango seleccionado no corresponde únicamente al día de hoy.';
            periodo = `Rango seleccionado: ${formatearFechaISO(fechaInicial)} al ${formatearFechaISO(fechaFinal)}`;
        } else {
            requiereConfirmacion = fechaInicial !== hoy;
            nivel = fueraDelMesActual ? 'ADVERTENCIA CRÍTICA' : 'PRECAUCIÓN';
            motivo = fueraDelMesActual
                ? 'La fecha seleccionada pertenece a un mes distinto del actual.'
                : 'La fecha seleccionada no corresponde al día de hoy.';
            periodo = `Fecha seleccionada: ${formatearFechaISO(fechaInicial)}`;
        }

        if (!requiereConfirmacion) return true;

        const mensaje =
`${nivel} DE COSTEO

${motivo}

Fecha actual: ${formatearFechaISO(hoy)}
${periodo}
Origen: ${payload.Source}
Proceso: ${payload.TipoProceso}
Programación automática: ${payload.Automatico ? `ACTIVA a las ${payload.HoraProgramada || '--:--'}` : `INACTIVA · hora configurada ${payload.HoraProgramada || '--:--'}`}

Ejecutar este proceso puede recalcular y afectar costos previamente registrados.

¿Está seguro de que desea continuar con el costeo?`;

        const confirmado = window.confirm(mensaje);

        if (!confirmado) {
            showLog(
                'warning',
                'Ejecución cancelada. No se realizó ningún costeo porque el periodo seleccionado requiere confirmación.'
            );
        }

        return confirmado;
    }

    function getHistoricoPayload() {
        return {
            source: document.getElementById('HistSource')?.value || 'ALL',
            tipoProceso: document.getElementById('HistTipoProceso')?.value || 'AMBOS',
            fechaDesde: document.getElementById('HistFechaDesde')?.value || null,
            fechaHasta: document.getElementById('HistFechaHasta')?.value || null,
            soloErrores: document.getElementById('HistSoloErrores')?.checked === true,
            soloAutomatico: document.getElementById('HistSoloAutomatico')?.checked === true
        };
    }

    function syncModeUI() {
        const panel = document.getElementById('filterPanel');
        if (!panel) return;

        const modo = (document.getElementById('Modo')?.value || 'DIA').toUpperCase();

        panel.classList.remove('mode-dia', 'mode-rango', 'mode-mes', 'mode-lote');

        if (modo === 'RANGO') panel.classList.add('mode-rango');
        else if (modo === 'MES') panel.classList.add('mode-mes');
        else if (modo === 'LOTE') panel.classList.add('mode-lote');
        else panel.classList.add('mode-dia');

        const lblFecha = document.getElementById('lblFechaInicial');
        if (lblFecha) {
            lblFecha.textContent = modo === 'MES'
                ? 'Mes a costear (elige cualquier fecha)'
                : 'Fecha inicial';
        }
    }

    function autoValue(row, camelName, pascalName) {
        return row?.[camelName] ?? row?.[pascalName];
    }

    function nombreOrigenAuto(source) {
        const valor = (source || '').toUpperCase();
        if (valor === 'P1') return 'Planta 1';
        if (valor === 'TIF') return 'Planta TIF';
        return valor || '-';
    }

    function renderAutoStatus(rows) {
        const content = document.getElementById('autoStatusContent');
        if (!content) return;

        if (!Array.isArray(rows) || rows.length === 0) {
            content.innerHTML = '<span class="auto-status-item inactive">No existe una programación guardada para esta selección.</span>';
            return;
        }

        content.innerHTML = rows.map(row => {
            const source = autoValue(row, 'source', 'Source') || '-';
            const proceso = autoValue(row, 'tipoProceso', 'TipoProceso') || '-';
            const hora = autoValue(row, 'horaProgramada', 'HoraProgramada') || '--:--';
            const activo = autoValue(row, 'activo', 'Activo') === true;
            const clase = activo ? 'active' : 'inactive';
            const estado = activo ? 'ACTIVO' : 'INACTIVO';

            return `<span class="auto-status-item ${clase}">
                ${activo ? '●' : '○'} ${safe(nombreOrigenAuto(source))} · ${safe(proceso)} · ${safe(hora)} · ${estado}
            </span>`;
        }).join('');
    }

    async function loadAutoStatus() {
        try {
            const res = await fetch('@Url.Action("CosteoAutoStatus", "ProcesosCG")', {
                credentials: 'same-origin'
            });

            const data = await res.json();
            if (!res.ok || !data?.ok || !Array.isArray(data.rows)) {
                renderAutoStatus([]);
                return;
            }

            const source = (document.getElementById('Source')?.value || 'P1').toUpperCase();
            const tipoProceso = (document.getElementById('TipoProceso')?.value || 'CAJAS').toUpperCase();
            const procesosPermitidos = tipoProceso === 'AMBOS'
                ? ['CAJAS', 'RETRABAJO']
                : [tipoProceso];

            const candidatas = data.rows.filter(row => {
                const rowSource = String(autoValue(row, 'source', 'Source') || '').toUpperCase();
                const rowProceso = String(autoValue(row, 'tipoProceso', 'TipoProceso') || '').toUpperCase();
                const sourceCoincide = source === 'ALL' || rowSource === source;
                return sourceCoincide && procesosPermitidos.includes(rowProceso);
            });

            // La consulta viene ordenada por fecha descendente; conserva solamente
            // la configuración más reciente por planta y proceso.
            const vistas = [];
            const vistos = new Set();

            for (const row of candidatas) {
                const key = `${String(autoValue(row, 'source', 'Source') || '').toUpperCase()}|${String(autoValue(row, 'tipoProceso', 'TipoProceso') || '').toUpperCase()}`;
                if (vistos.has(key)) continue;
                vistos.add(key);
                vistas.push(row);
            }

            renderAutoStatus(vistas);

            // Solo se cargan controles cuando la selección representa una configuración única.
            if (source !== 'ALL' && tipoProceso !== 'AMBOS') {
                if (vistas.length > 0) {
                    const row = vistas[0];
                    document.getElementById('HoraProgramada').value = autoValue(row, 'horaProgramada', 'HoraProgramada') || '18:00';
                    document.getElementById('Automatico').checked = autoValue(row, 'activo', 'Activo') === true;
                    document.getElementById('BrincarSinCosto').checked = autoValue(row, 'brincarSinCosto', 'BrincarSinCosto') === true;
                    document.getElementById('ContinuarConError').checked = autoValue(row, 'continuarConError', 'ContinuarConError') === true;
                } else {
                    document.getElementById('HoraProgramada').value = '18:00';
                    document.getElementById('Automatico').checked = false;
                    document.getElementById('BrincarSinCosto').checked = false;
                    document.getElementById('ContinuarConError').checked = false;
                }
            }
        } catch (e) {
            renderAutoStatus([]);
            console.warn('CosteoAutoStatus error:', e);
        }
    }

  async function guardarAuto(silent = false) {
    const payload = getPayload();

    try {
        if (!silent) showLog('info', 'Guardando configuración automática...');

        const procesos = payload.TipoProceso === 'AMBOS'
            ? ['CAJAS', 'RETRABAJO']
            : [payload.TipoProceso];

        for (const proc of procesos) {
            const form = new URLSearchParams();
            form.append('source', payload.Source);
            form.append('tipoProceso', proc);
            form.append('tipoCosteoId', payload.TipoCosteoId);
            form.append('horaProgramada', payload.HoraProgramada || '18:00');
            form.append('brincarSinCosto', payload.BrincarSinCosto);
            form.append('continuarConError', payload.ContinuarConError);
            form.append('activo', document.getElementById('Automatico')?.checked === true);

            const res = await fetch('@Url.Action("CosteoAutoSet", "ProcesosCG")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                credentials: 'same-origin',
                body: form.toString()
            });

            const data = await res.json();

            if (!res.ok || !data?.ok) {
                showLog('danger', data?.msg || `No se pudo guardar la configuración para ${proc}.`);
                return;
            }
        }

        if (!silent) showLog('success', 'Configuración guardada.');
        await loadAutoStatus();
    } catch (e) {
        showLog('danger', 'Error de red: ' + (e?.message || e));
    }
}

    async function recargarBitacora() {
    try {
        const h = getHistoricoPayload();
        const qs = new URLSearchParams();
        qs.append('top', '300');

        if (h.source && h.source !== 'ALL') qs.append('source', h.source);
        if (h.tipoProceso && h.tipoProceso !== 'AMBOS') qs.append('tipoProceso', h.tipoProceso);
        if (h.fechaDesde) qs.append('fechaDesde', h.fechaDesde);
        if (h.fechaHasta) qs.append('fechaHasta', h.fechaHasta);
        if (h.soloErrores) qs.append('soloErrores', 'true');
        if (h.soloAutomatico) qs.append('soloAutomatico', 'true');

        const res = await fetch('@Url.Action("CosteoBitacora", "ProcesosCG")?' + qs.toString(), {
            credentials: 'same-origin'
        });

        const data = await res.json();
        if (!res.ok || !data?.ok) {
            showLog('danger', data?.msg || 'No se pudo consultar la bitácora.');
            return;
        }

        const tbody = document.getElementById('tbodyBitacora');
        if (!tbody) return;

        const rows = data.rows || [];

        if (!rows.length) {
            tbody.innerHTML = '<tr><td colspan="15" class="text-center text-muted">Sin resultados.</td></tr>';
            return;
        }

        tbody.innerHTML = rows.map(x => {
            const icon = x.Ok ? '✅' : '❌';
            const sinCosto = x.BrincarSinCosto ? 'Sí' : 'No';
            const continuar = x.ContinuarConError ? 'Sí' : 'No';
            const auto = x.EsAutomatico ? 'Sí' : 'No';

            const mensajeCombo = [
                x.Mensaje || '',
                x.Parametros || ''
            ].filter(Boolean).join(' | ');

            return `
                <tr>
                    <td class="text-center">${x.Id ?? ''}</td>
                    <td title="${x.FechaEjecucion ?? ''}">${formatDateTime(x.FechaEjecucion)}</td>
                    <td>${safe(x.Source)}</td>
                    <td>${safe(x.TipoProceso)}</td>
                    <td title="${safeAttr(x.SpEjecutado)}">${safe(x.SpEjecutado)}</td>
                    <td>${formatDate(x.FechaInicial)}</td>
                    <td>${formatDate(x.FechaFinal)}</td>
                    <td class="text-center">${x.LoteId ?? '-'}</td>
                    <td class="text-center">${sinCosto}</td>
                    <td class="text-center">${continuar}</td>
                    <td class="text-center"><span class="sap-est">${icon}</span></td>
                    <td class="text-center">${auto}</td>
                    <td>${safe(x.Usuario)}</td>
                    <td>${safe(x.HoraProgramada)}</td>
                    <td title="${safeAttr(mensajeCombo)}">${safe(mensajeCombo)}</td>
                </tr>
            `;
        }).join('');
    } catch (e) {
        showLog('danger', 'Error al actualizar bitácora: ' + (e?.message || e));
    }
}

    async function ejecutarCosteo() {
        const payload = getPayload();

        if (!payload.FechaInicial) {
            showLog('warning', 'Captura fecha inicial.');
            return;
        }

        if (payload.Modo === 'RANGO' && !payload.FechaFinal) {
            showLog('warning', 'Captura fecha final.');
            return;
        }

        if (payload.Modo === 'RANGO' && payload.FechaFinal < payload.FechaInicial) {
            showLog('warning', 'La fecha final no puede ser menor que la fecha inicial.');
            return;
        }

        if (payload.Modo === 'LOTE' && !payload.LoteId) {
            showLog('warning', 'Captura el lote.');
            return;
        }

        if (!confirmarPeriodoCosteo(payload)) {
            return;
        }

        const descripcion = payload.Modo === 'MES'
            ? 'Ejecutando el mes por bloques diarios: Canales → Cajas → Retrabajo...'
            : payload.Modo === 'LOTE'
                ? 'Ejecutando costeo por lote. En este modo no se ejecuta canales...'
                : 'Ejecutando costeo: Canales → Cajas → Retrabajo...';

        try {
            showLog('info', descripcion);

            const res = await fetch('@Url.Action("EjecutarCosteo", "ProcesosCG")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                credentials: 'same-origin',
                body: JSON.stringify(payload)
            });

            const data = await res.json();
            const resultados = Array.isArray(data?.results) ? data.results : [];
            const errores = resultados.filter(x => (x?.ok ?? x?.Ok) === false);
            const correctos = resultados.length - errores.length;

            if (res.ok && resultados.length > 0) {
                if (errores.length === 0) {
                    showLog(
                        'success',
                        `Proceso terminado correctamente. ${correctos} bloque(s)/etapa(s) ejecutados.`
                    );
                } else {
                    const primerError = errores[0]?.msg ?? errores[0]?.Msg ?? 'Consulta la bitácora.';
                    showLog(
                        payload.ContinuarConError ? 'warning' : 'danger',
                        `Proceso terminado con ${errores.length} error(es) y ${correctos} ejecución(es) correctas. ` +
                        `Primer error: ${primerError}`
                    );
                }

                await recargarBitacora();

                const modalEl = document.getElementById('modalHistorico');
                if (modalEl && window.bootstrap) {
                    const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                    modal.show();
                }
                return;
            }

            if (res.ok && resultados.length === 0) {
                showLog('warning', 'La ejecución no generó etapas de costeo. Revisa los filtros.');
                return;
            }

            showLog('danger', data?.msg || 'No se pudo ejecutar el costeo.');
        } catch (e) {
            showLog('danger', 'Error de red: ' + (e?.message || e));
        }
    }

    function safe(v) {
        if (v === null || v === undefined || v === '') return '-';
        return String(v)
            .replaceAll('&', '&amp;')
            .replaceAll('<', '&lt;')
            .replaceAll('>', '&gt;')
            .replaceAll('"', '&quot;')
            .replaceAll("'", '&#39;');
    }

    function safeAttr(v) {
        return safe(v ?? '');
    }

    function formatDate(v) {
        if (!v) return '-';
        const d = new Date(v);
        if (isNaN(d.getTime())) return v;
        return d.toISOString().slice(0, 10);
    }

    function formatDateTime(v) {
        if (!v) return '-';
        const d = new Date(v);
        if (isNaN(d.getTime())) return v;

        const dd = String(d.getDate()).padStart(2, '0');
        const mm = String(d.getMonth() + 1).padStart(2, '0');
        const yyyy = d.getFullYear();
        const hh = String(d.getHours()).padStart(2, '0');
        const mi = String(d.getMinutes()).padStart(2, '0');
        const ss = String(d.getSeconds()).padStart(2, '0');

        return `${dd}/${mm}/${yyyy} ${hh}:${mi}:${ss}`;
    }

