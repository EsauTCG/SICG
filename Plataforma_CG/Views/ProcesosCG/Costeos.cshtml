<script>
    // También se carga aquí como respaldo. Para recibir el aviso al navegar por
    // cualquier módulo, incluye _CosteoAjusteMonitor.cshtml en _Layout2.cshtml.
    window.CosteoAjusteConfig = {
        estadoUrl: '@Url.Action("EstadoAjusteComparativaCosteo", "ProcesosCG")',
        costeoUrl: '@Url.Action("Costeo", "ProcesosCG")'
    };
</script>
<script src="@Url.Content("~/js/costeo-ajuste-monitor.js?v=20260806-2")"></script>

<!-- Respaldo integrado del monitor: evita que el ajuste falle si el JS externo no se publicó o quedó en caché. -->
<script>
    (function() {
        'use strict';
        if (window.CosteoAjusteMonitor) return;

        const ACTIVE_KEY = 'cg.costeo.ajusteComparativa.activo';
        const LAST_KEY = 'cg.costeo.ajusteComparativa.ultimoResultado';
        const POLL_MS = 3000;
        const channel = ('BroadcastChannel' in window) ? new BroadcastChannel('cg-costeo-ajuste-comparativa') : null;

        let timer = null;
        let consultando = false;

        const getConfig = () => window.CosteoAjusteConfig || {};
        function leerJson(key) { try { const raw = localStorage.getItem(key); return raw ? JSON.parse(raw) : null; } catch { return null; } }
        function guardarJson(key, value) { try { localStorage.setItem(key, JSON.stringify(value)); } catch { } }
        function eliminar(key) { try { localStorage.removeItem(key); } catch { } }
        const getActive = () => leerJson(ACTIVE_KEY);

        function ensureToastHost() {
            let host = document.getElementById('cgCosteoToastHost');
            if (host) return host;
            host = document.createElement('div');
            host.id = 'cgCosteoToastHost';
            host.style.cssText = 'position:fixed;top:18px;right:18px;z-index:2147483647;display:flex;flex-direction:column;gap:10px;width:min(420px,calc(100vw - 36px));pointer-events:none';
            document.body.appendChild(host);
            return host;
        }

        function toast(tipo, titulo, mensaje, duracionMs) {
            if (!document.body) return;
            const host = ensureToastHost();
            const item = document.createElement('div');
            const paleta = {
                success: { bg: '#e7f3ec', border: '#2f7a55', text: '#245e42' },
                danger: { bg: '#fbe9e8', border: '#b42d2d', text: '#8e2222' },
                warning: { bg: '#fbf1de', border: '#c88a1e', text: '#6d470b' },
                info: { bg: '#e9f0f7', border: '#2f5d86', text: '#24496b' }
            };
            const p = paleta[tipo] || paleta.info;
            item.style.cssText = [
                'pointer-events:auto', 'background:' + p.bg, 'border:1px solid ' + p.border, 'border-left:5px solid ' + p.border,
                'color:' + p.text, 'border-radius:10px', 'box-shadow:0 10px 28px rgba(35,26,28,.22)', 'padding:12px 42px 12px 14px',
                'font-family:Poppins,Segoe UI,Arial,sans-serif', 'font-size:13px', 'line-height:1.45', 'position:relative',
                'opacity:0', 'transform:translateY(-8px)', 'transition:opacity .2s ease,transform .2s ease'
            ].join(';');

            const title = document.createElement('div');
            title.style.cssText = 'font-weight:600;margin-bottom:4px;';
            title.textContent = titulo || 'Costeo';
            const body = document.createElement('div');
            body.textContent = mensaje || '';
            const close = document.createElement('button');
            close.type = 'button';
            close.setAttribute('aria-label', 'Cerrar');
            close.textContent = '×';
            close.style.cssText = 'position:absolute;right:10px;top:7px;border:0;background:transparent;font-size:24px;line-height:1;cursor:pointer;color:inherit';

            const remove = function() {
                item.style.opacity = '0';
                item.style.transform = 'translateY(-8px)';
                setTimeout(function() { item.remove(); }, 220);
            };
            close.addEventListener('click', remove);
            item.append(title, body, close);
            host.appendChild(item);
            requestAnimationFrame(function() { item.style.opacity = '1'; item.style.transform = 'translateY(0)'; });

            const tiempo = Number.isFinite(duracionMs) ? duracionMs : 12000;
            if (tiempo > 0) setTimeout(remove, tiempo);
        }

        async function requestNotificationPermission() {
            if (!('Notification' in window)) return 'unsupported';
            if (Notification.permission !== 'default') return Notification.permission;
            try { return await Notification.requestPermission(); } catch { return Notification.permission; }
        }

        function systemNotification(job) {
            if (!('Notification' in window) || Notification.permission !== 'granted') return;
            const marker = 'cg.costeo.ajusteComparativa.notificado.' + job.jobId;
            try { if (localStorage.getItem(marker)) return; localStorage.setItem(marker, new Date().toISOString()); } catch { }
            try {
                const n = new Notification(job.exito ? 'Comparativa de costeo terminada' : 'Error al cuadrar la comparativa', {
                    body: job.exito
                        ? `${job.codigosSolicitados || 0} etiqueta(s) procesada(s) correctamente.`
                        : (job.mensaje || 'El ajuste terminó con error.'),
                    tag: 'cg-costeo-ajuste-' + job.jobId,
                    requireInteraction: !job.exito
                });
                n.onclick = function() {
                    window.focus();
                    const url = getConfig().costeoUrl;
                    if (url && !String(location.pathname).toLowerCase().includes('/procesoscg/costeo')) location.href = url;
                    n.close();
                };
            } catch { }
        }

        function dispatch(nombre, detail) { try { window.dispatchEvent(new CustomEvent(nombre, { detail: detail })); } catch { } }

        function showCompletion(job) {
            const sessionKey = 'cg.costeo.ajusteComparativa.mostrado.' + job.jobId;
            if (!sessionStorage.getItem(sessionKey)) {
                sessionStorage.setItem(sessionKey, '1');
                if (job.exito) {
                    toast('success', 'Comparativa cuadrada',
                        `${job.mensaje || 'El procedimiento terminó correctamente.'} Etiquetas: ${Number(job.codigosSolicitados || 0).toLocaleString('es-MX')}.`, 18000);
                } else {
                    toast('danger', 'No se pudo cuadrar la comparativa', [job.mensaje, job.detalle].filter(Boolean).join(' Detalle: '), 0);
                }
            }
            systemNotification(job);
            dispatch('costeo-ajuste-finalizado', job);
        }

        function stopTimer() { if (timer) clearInterval(timer); timer = null; }
        function startTimer() { stopTimer(); timer = setInterval(pollNow, POLL_MS); }

        async function pollNow() {
            if (consultando) return;
            const active = getActive();
            if (!active || !active.jobId) { stopTimer(); return; }
            const estadoUrl = getConfig().estadoUrl;
            if (!estadoUrl) return;

            consultando = true;
            try {
                const sep = estadoUrl.includes('?') ? '&' : '?';
                const response = await fetch(estadoUrl + sep + 'jobId=' + encodeURIComponent(active.jobId), {
                    credentials: 'same-origin', cache: 'no-store', headers: { 'Accept': 'application/json' }
                });
                const text = await response.text();
                let data = {};
                try { data = text ? JSON.parse(text) : {}; } catch { data = { ok: false, mensaje: text || 'Respuesta no válida.' }; }

                if (!response.ok || !data?.ok) {
                    if (response.status === 404) {
                        eliminar(ACTIVE_KEY);
                        stopTimer();
                        toast('warning', 'No se pudo recuperar el ajuste', data?.mensaje || 'La aplicación pudo haberse reiniciado.', 0);
                        dispatch('costeo-ajuste-finalizado', {
                            jobId: active.jobId, exito: false, estado: 'DESCONOCIDO',
                            mensaje: data?.mensaje || 'No se encontró el trabajo.'
                        });
                    }
                    return;
                }

                const job = Object.assign({}, active, data);
                guardarJson(ACTIVE_KEY, job);
                dispatch('costeo-ajuste-estado', job);

                if (data.terminado === true) {
                    eliminar(ACTIVE_KEY);
                    guardarJson(LAST_KEY, job);
                    stopTimer();
                    showCompletion(job);
                    if (channel) channel.postMessage({ type: 'completed', job: job });
                }
            } catch (error) {
                dispatch('costeo-ajuste-conexion', { jobId: active.jobId, mensaje: error?.message || String(error) });
            } finally {
                consultando = false;
            }
        }

        async function track(jobId, meta) {
            const active = Object.assign({ jobId: jobId, estado: 'PENDIENTE', iniciadoCliente: new Date().toISOString() }, meta || {});
            guardarJson(ACTIVE_KEY, active);
            dispatch('costeo-ajuste-estado', active);
            startTimer();
            await pollNow();
        }

        function resume() {
            const active = getActive();
            if (!active?.jobId) return;
            dispatch('costeo-ajuste-estado', active);
            startTimer();
            pollNow();
        }

        if (channel) {
            channel.onmessage = function(event) {
                const msg = event?.data;
                if (msg?.type === 'completed' && msg.job) { eliminar(ACTIVE_KEY); stopTimer(); showCompletion(msg.job); }
            };
        }
        window.addEventListener('storage', function(event) { if (event.key === ACTIVE_KEY) resume(); });

        window.CosteoAjusteMonitor = { track, resume, pollNow, getActive, toast, requestNotificationPermission };

        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', resume, { once: true });
        else resume();
    })();
</script>

<script>
    /* =====================================================================
       COSTEO · lógica de la vista
       ===================================================================== */
    const URLS = {
        autoStatus: '@Url.Action("CosteoAutoStatus", "ProcesosCG")',
        autoSet: '@Url.Action("CosteoAutoSet", "ProcesosCG")',
        bitacora: '@Url.Action("CosteoBitacora", "ProcesosCG")',
        ejecutar: '@Url.Action("EjecutarCosteo", "ProcesosCG")',
        comparativa: '@Url.Action("ConsultarComparativaCosteo", "ProcesosCG")',
        comparativaExcel: '@Url.Action("ExportarComparativaCosteoExcel", "ProcesosCG")',
        iniciarAjuste: '@Url.Action("IniciarAjusteComparativaCosteo", "ProcesosCG")'
    };

    const $ = id => document.getElementById(id);
    const fmtInt = v => Number(v || 0).toLocaleString('es-MX');

    /* ---------------- Utilidades ---------------- */
    function safe(v) {
        if (v === null || v === undefined || v === '') return '-';
        return String(v)
            .replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;')
            .replaceAll('"', '&quot;').replaceAll("'", '&#39;');
    }
    function safeAttr(v) { return safe(v ?? ''); }
    // Lee una propiedad venga en PascalCase o camelCase.
    function val(obj, pascal) {
        if (!obj) return undefined;
        const camel = pascal.charAt(0).toLowerCase() + pascal.slice(1);
        return obj[pascal] ?? obj[camel];
    }

    async function leerJsonRespuesta(response) {
        const texto = await response.text();
        try { return texto ? JSON.parse(texto) : {}; }
        catch { return { ok: false, mensaje: 'El servidor devolvió una respuesta no válida (posible sesión vencida).', detalle: texto.substring(0, 500) }; }
    }

    // Fechas sin desfase de zona horaria: se toma la parte yyyy-MM-dd tal cual.
    function formatDate(v) {
        if (!v) return '-';
        const m = String(v).match(/^(\d{4})-(\d{2})-(\d{2})/);
        if (m) return `${m[3]}/${m[2]}/${m[1]}`;
        const d = new Date(v);
        return isNaN(d.getTime()) ? String(v) : d.toLocaleDateString('es-MX');
    }
    function formatDateTime(v) {
        if (!v) return '-';
        const d = new Date(v);
        if (isNaN(d.getTime())) return String(v);
        const p = n => String(n).padStart(2, '0');
        return `${p(d.getDate())}/${p(d.getMonth() + 1)}/${d.getFullYear()} ${p(d.getHours())}:${p(d.getMinutes())}:${p(d.getSeconds())}`;
    }
    function getFechaLocalISO(fecha = new Date()) {
        return `${fecha.getFullYear()}-${String(fecha.getMonth() + 1).padStart(2, '0')}-${String(fecha.getDate()).padStart(2, '0')}`;
    }
    function formatearFechaISO(fechaIso) {
        if (!fechaIso) return '-';
        const p = fechaIso.split('-');
        return p.length === 3 ? `${p[2]}/${p[1]}/${p[0]}` : fechaIso;
    }
    function formatearMesISO(fechaIso) {
        if (!fechaIso) return '-';
        const p = fechaIso.split('-').map(Number);
        if (p.length < 2 || !p[0] || !p[1]) return fechaIso;
        return new Intl.DateTimeFormat('es-MX', { month: 'long', year: 'numeric' }).format(new Date(p[0], p[1] - 1, 1));
    }

    /* ---------------- Bitácora de la sesión ---------------- */
    const LOG_MAX = 40;
    function showLog(type, text) {
        const list = $('esLogList');
        if (!list) return;
        list.querySelector('.es-log__empty')?.remove();
        const li = document.createElement('li');
        li.className = 'es-log__item es-log__item--' + (type || 'secondary');
        const hora = new Date().toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
        li.innerHTML = `<span class="es-log__time">${hora}</span><span class="es-log__msg"></span>`;
        li.querySelector('.es-log__msg').textContent = text || '';
        list.prepend(li);
        while (list.children.length > LOG_MAX) list.lastElementChild.remove();
        const st = $('esStatusMsg');
        if (st) st.textContent = String(text || '').split('\n')[0];
    }

    /* ---------------- Parámetros ---------------- */
    function getPayload() {
        const modo = ($('Modo')?.value || 'DIA').toUpperCase();
        return {
            Source: $('Source')?.value || 'P1',
            TipoProceso: $('TipoProceso')?.value || 'CAJAS',
            Modo: modo,
            FechaInicial: $('FechaInicial')?.value || null,
            FechaFinal: (modo === 'DIA' || modo === 'MES') ? ($('FechaInicial')?.value || null) : ($('FechaFinal')?.value || null),
            TipoCosteoId: parseInt($('TipoCosteoId')?.value || '1'),
            LoteId: (modo === 'LOTE' && $('LoteId')?.value) ? parseInt($('LoteId').value) : null,
            BrincarSinCosto: $('BrincarSinCosto')?.checked === true,
            ContinuarConError: $('ContinuarConError')?.checked === true,
            Automatico: $('Automatico')?.checked === true,
            HoraProgramada: $('HoraProgramada')?.value || '18:00'
        };
    }

    function syncModeUI() {
        const panel = $('filterPanel');
        if (!panel) return;
        const modo = ($('Modo')?.value || 'DIA').toUpperCase();
        panel.classList.remove('mode-dia', 'mode-rango', 'mode-mes', 'mode-lote');
        panel.classList.add({ RANGO: 'mode-rango', MES: 'mode-mes', LOTE: 'mode-lote' }[modo] || 'mode-dia');
        const lbl = $('lblFechaInicial');
        if (lbl) lbl.textContent = modo === 'MES' ? 'Mes a costear (cualquier día)' : 'Fecha inicial';
    }

    function confirmarPeriodoCosteo(payload) {
        // En costeo por lote la fecha visible no controla el periodo de ejecución.
        if (!payload || payload.Modo === 'LOTE') return true;

        const hoy = getFechaLocalISO();
        const mesActual = hoy.substring(0, 7);
        const fechaInicial = payload.FechaInicial;
        const fechaFinal = payload.Modo === 'RANGO' ? payload.FechaFinal : payload.FechaInicial;
        if (!fechaInicial) return true;

        const fueraDelMesActual = [fechaInicial, fechaFinal].filter(Boolean).some(f => f.substring(0, 7) !== mesActual);
        let requiere = false, nivel = 'PRECAUCIÓN', motivo = '', periodo = '';

        if (payload.Modo === 'MES') {
            requiere = fechaInicial.substring(0, 7) !== mesActual;
            nivel = 'ADVERTENCIA CRÍTICA';
            motivo = 'El mes seleccionado no corresponde al mes actual.';
            periodo = `Mes seleccionado: ${formatearMesISO(fechaInicial)}`;
        } else if (payload.Modo === 'RANGO') {
            requiere = fechaInicial !== hoy || fechaFinal !== hoy;
            nivel = fueraDelMesActual ? 'ADVERTENCIA CRÍTICA' : 'PRECAUCIÓN';
            motivo = fueraDelMesActual ? 'El rango incluye fechas fuera del mes actual.' : 'El rango seleccionado no corresponde únicamente al día de hoy.';
            periodo = `Rango seleccionado: ${formatearFechaISO(fechaInicial)} al ${formatearFechaISO(fechaFinal)}`;
        } else {
            requiere = fechaInicial !== hoy;
            nivel = fueraDelMesActual ? 'ADVERTENCIA CRÍTICA' : 'PRECAUCIÓN';
            motivo = fueraDelMesActual ? 'La fecha seleccionada pertenece a un mes distinto del actual.' : 'La fecha seleccionada no corresponde al día de hoy.';
            periodo = `Fecha seleccionada: ${formatearFechaISO(fechaInicial)}`;
        }
        if (!requiere) return true;

        const mensaje =
            `${nivel} DE COSTEO

    ${motivo}

    Fecha actual: ${formatearFechaISO(hoy)}
    ${periodo}
    Origen: ${payload.Source}
    Proceso: ${payload.TipoProceso}
    Programación automática: ${payload.Automatico ? `ACTIVA a las ${payload.HoraProgramada || '--:--'}` : `INACTIVA · hora configurada ${payload.HoraProgramada || '--:--'}`}

    Ejecutar este proceso puede recalcular y afectar costos previamente registrados.

    ¿Está seguro de que desea continuar con el costeo?`;

        const ok = window.confirm(mensaje);
        if (!ok) showLog('warning', 'Ejecución cancelada. No se realizó ningún costeo.');
        return ok;
    }

    /* ---------------- Programación automática ---------------- */
    function nombreOrigenAuto(s) {
        const v = (s || '').toUpperCase();
        return v === 'P1' ? 'Planta 1' : (v === 'TIF' ? 'Planta TIF' : (v || '-'));
    }
    function nombreProceso(p) {
        const v = (p || '').toUpperCase();
        return { CANALES: 'Canales', CAJAS: 'Cajas', RETRABAJO: 'Retrabajo' }[v] || (v || '-');
    }

    function renderAutoStatus(rows) {
        const content = $('autoStatusContent');
        if (!content) return;
        if (!Array.isArray(rows) || rows.length === 0) {
            content.innerHTML = '<div class="es-auto-empty">No hay programación guardada para esta selección. Elige la hora, activa la programación y guárdala.</div>';
            return;
        }
        content.innerHTML = rows.map(row => {
            const activo = val(row, 'Activo') === true;
            return `
                    <div class="es-auto-item">
                        <span class="es-pill ${activo ? 'es-pill--ok' : ''}">${activo ? 'Activa' : 'Inactiva'}</span>
                        <span class="es-auto-item__name">${safe(nombreOrigenAuto(val(row, 'Source')))} · ${safe(nombreProceso(val(row, 'TipoProceso')))}</span>
                        <span class="es-auto-item__time"><i class="bi bi-clock"></i> ${safe(val(row, 'HoraProgramada') || '--:--')}</span>
                    </div>`;
        }).join('');
    }

    let autoStatusSeq = 0;
    async function loadAutoStatus() {
        const seq = ++autoStatusSeq;
        try {
            const res = await fetch(URLS.autoStatus, { credentials: 'same-origin', cache: 'no-store' });
            const data = await leerJsonRespuesta(res);
            if (seq !== autoStatusSeq) return; // llegó una consulta más reciente
            if (!res.ok || !data?.ok || !Array.isArray(data.rows)) { renderAutoStatus([]); return; }

            const source = ($('Source')?.value || 'P1').toUpperCase();
            const tipoProceso = ($('TipoProceso')?.value || 'CAJAS').toUpperCase();
            const permitidos = tipoProceso === 'AMBOS' ? ['CAJAS', 'RETRABAJO'] : [tipoProceso];

            const candidatas = data.rows.filter(row => {
                const s = String(val(row, 'Source') || '').toUpperCase();
                const p = String(val(row, 'TipoProceso') || '').toUpperCase();
                return (source === 'ALL' || s === source) && permitidos.includes(p);
            });

            // La consulta viene ordenada por fecha descendente: se conserva la más reciente por planta y proceso.
            const vistas = [];
            const vistos = new Set();
            for (const row of candidatas) {
                const key = `${String(val(row, 'Source') || '').toUpperCase()}|${String(val(row, 'TipoProceso') || '').toUpperCase()}`;
                if (vistos.has(key)) continue;
                vistos.add(key);
                vistas.push(row);
            }
            renderAutoStatus(vistas);

            // Solo se cargan controles cuando la selección representa una configuración única.
            if (source !== 'ALL' && tipoProceso !== 'AMBOS') {
                const row = vistas[0];
                $('HoraProgramada').value = row ? (val(row, 'HoraProgramada') || '18:00') : '18:00';
                $('Automatico').checked = row ? val(row, 'Activo') === true : false;
                $('BrincarSinCosto').checked = row ? val(row, 'BrincarSinCosto') === true : false;
                $('ContinuarConError').checked = row ? val(row, 'ContinuarConError') === true : false;
            }
        } catch (e) {
            if (seq === autoStatusSeq) renderAutoStatus([]);
            console.warn('CosteoAutoStatus error:', e);
        }
    }

    // Los guardados se encadenan para que dos cambios rápidos no se pisen en el servidor.
    let guardarAutoCola = Promise.resolve();
    function guardarAuto(silent = false) {
        guardarAutoCola = guardarAutoCola.then(() => guardarAutoInterno(silent)).catch(() => { });
        return guardarAutoCola;
    }

    async function guardarAutoInterno(silent) {
        const payload = getPayload();
        const btn = $('btnGuardarAuto');
        try {
            if (btn) btn.disabled = true;
            if (!silent) showLog('info', 'Guardando programación automática…');
            const procesos = payload.TipoProceso === 'AMBOS' ? ['CAJAS', 'RETRABAJO'] : [payload.TipoProceso];

            for (const proc of procesos) {
                const form = new URLSearchParams();
                form.append('source', payload.Source);
                form.append('tipoProceso', proc);
                form.append('tipoCosteoId', payload.TipoCosteoId);
                form.append('horaProgramada', payload.HoraProgramada || '18:00');
                form.append('brincarSinCosto', payload.BrincarSinCosto);
                form.append('continuarConError', payload.ContinuarConError);
                form.append('activo', payload.Automatico);

                const res = await fetch(URLS.autoSet, {
                    method: 'POST', credentials: 'same-origin',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: form.toString()
                });
                const data = await leerJsonRespuesta(res);
                if (!res.ok || !data?.ok) {
                    showLog('danger', data?.msg || data?.mensaje || `No se pudo guardar la programación de ${nombreProceso(proc)}.`);
                    return;
                }
            }
            // Antes el guardado automático era invisible; ahora deja constancia en la actividad.
            showLog('success', silent
                ? `Programación actualizada: ${nombreOrigenAuto(payload.Source)} · ${procesos.map(nombreProceso).join(' y ')}.`
                : 'Programación guardada.');
            await loadAutoStatus();
        } catch (e) {
            showLog('danger', 'Error de red al guardar la programación: ' + (e?.message || e));
        } finally {
            if (btn) btn.disabled = false;
        }
    }

    /* ---------------- Histórico ---------------- */
    function getHistoricoPayload() {
        return {
            source: $('HistSource')?.value || 'ALL',
            tipoProceso: $('HistTipoProceso')?.value || 'AMBOS',
            fechaDesde: $('HistFechaDesde')?.value || null,
            fechaHasta: $('HistFechaHasta')?.value || null,
            soloErrores: $('HistSoloErrores')?.checked === true,
            soloAutomatico: $('HistSoloAutomatico')?.checked === true
        };
    }

    async function recargarBitacora() {
        const tbody = $('tbodyBitacora');
        const btn = $('btnConsultarBitacora');
        if (!tbody) return;
        try {
            if (btn) btn.disabled = true;
            tbody.innerHTML = '<tr><td colspan="15" class="es-empty-cell"><span class="es-spinner"></span> Consultando ejecuciones…</td></tr>';

            const h = getHistoricoPayload();
            const qs = new URLSearchParams({ top: '300' });
            if (h.source && h.source !== 'ALL') qs.append('source', h.source);
            if (h.tipoProceso && h.tipoProceso !== 'AMBOS') qs.append('tipoProceso', h.tipoProceso);
            if (h.fechaDesde) qs.append('fechaDesde', h.fechaDesde);
            if (h.fechaHasta) qs.append('fechaHasta', h.fechaHasta);
            if (h.soloErrores) qs.append('soloErrores', 'true');
            if (h.soloAutomatico) qs.append('soloAutomatico', 'true');

            const res = await fetch(URLS.bitacora + '?' + qs.toString(), { credentials: 'same-origin', cache: 'no-store' });
            const data = await leerJsonRespuesta(res);
            if (!res.ok || !data?.ok) {
                tbody.innerHTML = `<tr><td colspan="15" class="es-empty-cell">${safe(data?.msg || data?.mensaje || 'No se pudo consultar el histórico.')}</td></tr>`;
                showLog('danger', data?.msg || data?.mensaje || 'No se pudo consultar el histórico.');
                return;
            }

            const rows = data.rows || [];
            const errores = rows.filter(x => val(x, 'Ok') !== true).length;
            $('histResumen').textContent = rows.length
                ? `${fmtInt(rows.length)} ejecución(es) · ${fmtInt(errores)} con error${rows.length >= 300 ? ' · se muestran las 300 más recientes' : ''}`
                : 'Sin ejecuciones para este filtro.';

            if (!rows.length) {
                tbody.innerHTML = '<tr><td colspan="15" class="es-empty-cell">No hay ejecuciones con estos filtros. Amplía el periodo o quita "Solo errores".</td></tr>';
                return;
            }

            const siNo = b => b ? 'Sí' : 'No';
            tbody.innerHTML = rows.map(x => {
                const ok = val(x, 'Ok') === true;
                const mensajeCombo = [val(x, 'Mensaje') || '', val(x, 'Parametros') || ''].filter(Boolean).join(' | ');
                return `
                        <tr class="${ok ? '' : 'is-error'}">
                            <td class="text-center es-num">${safe(val(x, 'Id'))}</td>
                            <td class="es-num" title="${safeAttr(val(x, 'FechaEjecucion'))}">${formatDateTime(val(x, 'FechaEjecucion'))}</td>
                            <td>${safe(nombreOrigenAuto(val(x, 'Source')))}</td>
                            <td>${safe(nombreProceso(val(x, 'TipoProceso')))}</td>
                            <td title="${safeAttr(val(x, 'SpEjecutado'))}">${safe(val(x, 'SpEjecutado'))}</td>
                            <td class="es-num">${formatDate(val(x, 'FechaInicial'))}</td>
                            <td class="es-num">${formatDate(val(x, 'FechaFinal'))}</td>
                            <td class="text-center">${safe(val(x, 'LoteId'))}</td>
                            <td class="text-center">${siNo(val(x, 'BrincarSinCosto'))}</td>
                            <td class="text-center">${siNo(val(x, 'ContinuarConError'))}</td>
                            <td class="text-center"><span class="es-pill ${ok ? 'es-pill--ok' : 'es-pill--bad'}">${ok ? 'Correcto' : 'Error'}</span></td>
                            <td class="text-center">${siNo(val(x, 'EsAutomatico'))}</td>
                            <td>${safe(val(x, 'Usuario'))}</td>
                            <td class="es-num">${safe(val(x, 'HoraProgramada'))}</td>
                            <td class="col-msg" title="${safeAttr(mensajeCombo)}">${safe(mensajeCombo)}</td>
                        </tr>`;
            }).join('');
        } catch (e) {
            tbody.innerHTML = '<tr><td colspan="15" class="es-empty-cell">Error de red al consultar el histórico.</td></tr>';
            showLog('danger', 'Error al actualizar el histórico: ' + (e?.message || e));
        } finally {
            if (btn) btn.disabled = false;
        }
    }

    /* ---------------- Ejecución ---------------- */
    let costeoEnCurso = false;

    async function ejecutarCosteo() {
        // Evita doble ejecución por doble clic (antes podía lanzar dos costeos).
        if (costeoEnCurso) { showLog('warning', 'Ya hay un costeo en ejecución. Espera a que termine.'); return; }

        const payload = getPayload();
        if (!payload.FechaInicial) { showLog('warning', 'Captura la fecha inicial.'); return; }
        if (payload.Modo === 'RANGO' && !payload.FechaFinal) { showLog('warning', 'Captura la fecha final.'); return; }
        if (payload.Modo === 'RANGO' && payload.FechaFinal < payload.FechaInicial) { showLog('warning', 'La fecha final no puede ser menor que la inicial.'); return; }
        if (payload.Modo === 'LOTE' && !payload.LoteId) { showLog('warning', 'Captura el número de lote.'); return; }
        if (!confirmarPeriodoCosteo(payload)) return;

        const descripcion = payload.Modo === 'MES'
            ? 'Ejecutando el mes por bloques diarios: Canales → Cajas → Retrabajo…'
            : payload.Modo === 'LOTE'
                ? 'Ejecutando costeo por lote (en este modo no se ejecuta Canales)…'
                : 'Ejecutando costeo: Canales → Cajas → Retrabajo…';

        const btn = $('btnEjecutarCosteo');
        const textoBtn = btn?.innerHTML;
        costeoEnCurso = true;
        if (btn) { btn.disabled = true; btn.innerHTML = '<span class="es-spinner es-spinner--light"></span> Ejecutando…'; }

        try {
            showLog('info', descripcion);
            const res = await fetch(URLS.ejecutar, {
                method: 'POST', credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const data = await leerJsonRespuesta(res);
            const resultados = Array.isArray(data?.results) ? data.results : [];
            const errores = resultados.filter(x => (x?.ok ?? x?.Ok) === false);
            const correctos = resultados.length - errores.length;

            if (res.ok && resultados.length > 0) {
                if (errores.length === 0) {
                    showLog('success', `Costeo terminado correctamente: ${correctos} bloque(s)/etapa(s) ejecutados.`);
                } else {
                    const primerError = errores[0]?.msg ?? errores[0]?.Msg ?? 'Consulta el histórico.';
                    showLog(payload.ContinuarConError ? 'warning' : 'danger',
                        `Costeo terminado con ${errores.length} error(es) y ${correctos} ejecución(es) correctas. Primer error: ${primerError}`);
                }
                if ($('modalHistorico') && window.bootstrap) bootstrap.Modal.getOrCreateInstance($('modalHistorico')).show();
                return;
            }
            if (res.ok && resultados.length === 0) { showLog('warning', 'La ejecución no generó etapas de costeo. Revisa los parámetros.'); return; }
            showLog('danger', data?.msg || data?.mensaje || 'No se pudo ejecutar el costeo.');
        } catch (e) {
            showLog('danger', 'Error de red: ' + (e?.message || e) + '\nConsulta el histórico antes de volver a ejecutar.');
        } finally {
            costeoEnCurso = false;
            if (btn) { btn.disabled = false; btn.innerHTML = textoBtn; }
        }
    }

    /* =====================================================================
       COMPARATIVA P1 vs TIF
       ===================================================================== */
    let TokenActivo = 0;
    let datosComparativaActuales = [];
    let paginaComparativaActual = 1;
    let totalPaginasComparativa = 0;
    let totalFiltradoComparativa = 0;
    let comparativaConsultada = false;
    let resumenComparativaActual = {};
    let codigosAjustablesComparativa = [];
    let limiteAjustablesComparativaExcedido = false;

    const TAMANO_LOTE_AJUSTE_COMPARATIVA = 2000;

    function cancelarRenderActivo() {
        TokenActivo++;
        $('tbodyComparativaCosteo').innerHTML = '';
    }

    function limpiarComparativa() {
        cancelarRenderActivo();
        ocultarLoading();
        $('theadComparativa').innerHTML = '';
        $('tbodyComparativaCosteo').innerHTML = '<tr><td class="es-empty-cell">Elige el periodo y presiona Consultar.</td></tr>';
        $('resumenComparativa').innerHTML = '';
        datosComparativaActuales = [];
        paginaComparativaActual = 1;
        totalPaginasComparativa = 0;
        totalFiltradoComparativa = 0;
        comparativaConsultada = false;
        resumenComparativaActual = {};
        codigosAjustablesComparativa = [];
        limiteAjustablesComparativaExcedido = false;
        actualizarEstadoCuadreComparativa();
        renderPaginacionComparativa({ pagina: 0, totalPaginas: 0, tamanoPagina: obtenerTamanoPaginaComparativa(), total: 0, datos: [] });
        desbloquearConsulta();
    }

    function mostrarLoading(titulo, mensaje) {
        $('resultadoComparativa').classList.add('d-none');
        $('loadingComparativa').classList.remove('d-none');
        $('loadingTitulo').textContent = titulo;
        $('loadingMensaje').textContent = mensaje;
    }
    function actualizarLoading(titulo, mensaje) {
        $('loadingTitulo').textContent = titulo;
        $('loadingMensaje').textContent = mensaje;
    }
    function ocultarLoading() {
        $('loadingComparativa').classList.add('d-none');
        $('resultadoComparativa').classList.remove('d-none');
    }
    function bloquearConsulta() {
        const b = $('btnConsultarComparativa');
        b.disabled = true;
        b.innerHTML = '<span class="es-spinner es-spinner--light"></span> Consultando…';
    }
    function desbloquearConsulta() {
        const b = $('btnConsultarComparativa');
        b.disabled = false;
        b.innerHTML = '<i class="bi bi-search"></i> Consultar';
    }

    function obtenerTamanoPaginaComparativa() {
        const v = Number($('cmpTamanoPagina')?.value || 200);
        return Number.isFinite(v) ? Math.min(1000, Math.max(50, Math.trunc(v))) : 200;
    }

    function renderPaginacionComparativa(resultado) {
        const cont = $('paginacionComparativa'), info = $('cmpInfoPagina'), num = $('cmpNumeroPagina');
        const ant = $('btnPaginaAnterior'), sig = $('btnPaginaSiguiente'), sel = $('cmpTamanoPagina');
        if (!cont || !info || !num || !ant || !sig) return;

        const pagina = Math.max(0, Number(resultado?.pagina) || 0);
        const totalPaginas = Math.max(0, Number(resultado?.totalPaginas) || 0);
        const tamanoPagina = Math.max(1, Number(resultado?.tamanoPagina) || obtenerTamanoPaginaComparativa());
        const total = Math.max(0, Number(resultado?.total ?? resultado?.resumen?.totalFiltrado) || 0);
        const visibles = Array.isArray(resultado?.datos) ? resultado.datos.length : 0;
        if (sel) sel.value = String(tamanoPagina);

        if (!comparativaConsultada && total === 0) {
            cont.classList.add('d-none');
            info.textContent = 'Sin resultados.';
            num.textContent = 'Página 0 de 0';
            ant.disabled = true; sig.disabled = true;
            return;
        }
        cont.classList.remove('d-none');
        const inicio = total > 0 ? ((Math.max(1, pagina) - 1) * tamanoPagina) + 1 : 0;
        const fin = total > 0 ? Math.min(total, inicio + visibles - 1) : 0;
        info.textContent = `Mostrando ${fmtInt(inicio)}–${fmtInt(fin)} de ${fmtInt(total)} registro(s) filtrado(s).`;
        num.textContent = `Página ${fmtInt(pagina)} de ${fmtInt(totalPaginas)}`;
        ant.disabled = pagina <= 1;
        sig.disabled = totalPaginas === 0 || pagina >= totalPaginas;
    }

    function cambiarPaginaComparativa(direccion) {
        const nueva = paginaComparativaActual + Number(direccion || 0);
        if (nueva < 1 || nueva > totalPaginasComparativa || nueva === paginaComparativaActual) return;
        consultarComparativa(nueva);
    }
    function cambiarTamanoPaginaComparativa() {
        paginaComparativaActual = 1;
        if (comparativaConsultada) consultarComparativa(1);
    }

    function getComparativaFiltro(pagina = paginaComparativaActual) {
        return {
            tipoPeriodo: $('cmpPeriodo')?.value || 'MES',
            fechaBase: $('cmpFecha')?.value || null,
            tolerancia: parseFloat($('cmpTolerancia')?.value || '0'),
            estadoCosto: $('cmpEstado')?.value ?? 'PENDIENTES',
            pagina: Math.max(1, Number(pagina) || 1),
            tamanoPagina: obtenerTamanoPaginaComparativa()
        };
    }

    function obtenerNombreArchivo(disposition) {
        if (!disposition) return null;
        const utf8 = disposition.match(/filename\*=UTF-8''([^;]+)/i);
        if (utf8?.[1]) return decodeURIComponent(utf8[1].replace(/["']/g, ''));
        return disposition.match(/filename="?([^";]+)"?/i)?.[1] || null;
    }

    function validarFiltroComparativa(filtro) {
        if (!filtro.fechaBase) return 'Captura la fecha de la comparativa.';
        if (!Number.isFinite(filtro.tolerancia) || filtro.tolerancia < 0) return 'La tolerancia debe ser un número mayor o igual a cero.';
        return null;
    }

    async function exportarComparativaExcel() {
        const btn = $('btnExportarComparativa');
        const filtro = getComparativaFiltro();
        const error = validarFiltroComparativa(filtro);
        if (error) { alert(error); return; }

        const original = btn?.innerHTML;
        try {
            if (btn) { btn.disabled = true; btn.innerHTML = '<span class="es-spinner"></span> Generando Excel…'; }
            const response = await fetch(URLS.comparativaExcel, {
                method: 'POST', credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(filtro)
            });
            if (!response.ok) {
                let mensaje = 'No se pudo generar el archivo de Excel.';
                try { const err = await response.json(); mensaje = err?.mensaje || err?.msg || mensaje; } catch { }
                throw new Error(mensaje);
            }
            const blob = await response.blob();
            const nombre = obtenerNombreArchivo(response.headers.get('Content-Disposition'))
                || `Comparativa_Costeo_${filtro.tipoPeriodo}_${String(filtro.fechaBase).replaceAll('-', '')}.xlsx`;
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url; a.download = nombre;
            document.body.appendChild(a); a.click(); a.remove();
            URL.revokeObjectURL(url);
            showLog('success', `Comparativa descargada: ${nombre}`);
        } catch (e) {
            alert(e?.message || 'No se pudo descargar la comparativa.');
        } finally {
            if (btn) { btn.disabled = false; btn.innerHTML = original; }
        }
    }

    async function consultarComparativa(paginaSolicitada = 1) {
        cancelarRenderActivo();
        const pagina = Math.max(1, Number(paginaSolicitada) || 1);
        paginaComparativaActual = pagina;
        $('theadComparativa').innerHTML = '';
        const consultaActual = TokenActivo;

        mostrarLoading('Consultando información…', 'SQL está calculando la comparativa y devolverá solamente la página solicitada.');
        bloquearConsulta();

        try {
            const filtro = getComparativaFiltro(pagina);
            const error = validarFiltroComparativa(filtro);
            if (error) throw new Error(error);

            const response = await fetch(URLS.comparativa, {
                method: 'POST', credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(filtro)
            });
            const resultado = await leerJsonRespuesta(response);

            if (!response.ok || !resultado?.ok) {
                const mensaje = resultado?.mensaje || resultado?.msg || 'No se pudo consultar la comparativa.';
                const detalle = resultado?.detalle || resultado?.error || '';
                throw new Error(detalle ? `${mensaje}\n\nDetalle técnico:\n${detalle}` : mensaje);
            }
            if (consultaActual !== TokenActivo) return;

            const datos = Array.isArray(resultado.datos) ? resultado.datos : [];
            datosComparativaActuales = datos;
            paginaComparativaActual = Math.max(1, Number(resultado.pagina) || pagina);
            totalPaginasComparativa = Math.max(0, Number(resultado.totalPaginas) || 0);
            totalFiltradoComparativa = Math.max(0, Number(resultado.total) || 0);
            resumenComparativaActual = resultado.resumen || {};
            codigosAjustablesComparativa = Array.isArray(resultado.codigosAjustables)
                ? resultado.codigosAjustables.map(x => String(x || '').trim()).filter(Boolean)
                : [];
            limiteAjustablesComparativaExcedido = resultado.limiteAjustablesExcedido === true;
            comparativaConsultada = true;

            actualizarLoading('Mostrando resultados…', `Preparando ${fmtInt(datos.length)} registro(s) de la página ${fmtInt(paginaComparativaActual)}.`);
            renderResumen(resultado);
            renderEncabezado(datos);
            renderFilas(datos);
            renderPaginacionComparativa(resultado);
            actualizarEstadoCuadreComparativa();
            ocultarLoading();
        } catch (e) {
            if (consultaActual === TokenActivo) {
                ocultarLoading();
                $('tbodyComparativaCosteo').innerHTML = '<tr><td class="es-empty-cell">No se pudo consultar. Revisa los filtros e inténtalo de nuevo.</td></tr>';
                alert(e?.message || 'Error al consultar la comparativa.');
            }
        } finally {
            if (consultaActual === TokenActivo) desbloquearConsulta();
        }
    }

    /*
        El procedimiento dbo.meat_CostoTIF copia costos desde TIF hacia Meat P1.
        Por seguridad solamente se envían etiquetas cuando TIF tiene un costo
        positivo. Si TIF está en cero, el procedimiento no puede inventar el
        costo y la incidencia debe permanecer visible.
    */
    function obtenerProgresoAjuste(job) {
        const solicitados = Math.max(0, Number(job?.codigosSolicitados) || 0);
        const procesados = Math.min(solicitados, Math.max(0, Number(job?.codigosProcesados) || 0));
        const tamanoLote = Math.max(1, Number(job?.tamanoLote) || TAMANO_LOTE_AJUSTE_COMPARATIVA);
        const totalLotes = Math.max(0, Number(job?.totalLotes) || (solicitados > 0 ? Math.ceil(solicitados / tamanoLote) : 0));
        const loteActual = Math.min(totalLotes, Math.max(0, Number(job?.loteActual) || 0));
        const porcentaje = solicitados > 0 ? Math.min(100, Math.round((procesados * 10000) / solicitados) / 100) : 0;
        return { solicitados, procesados, tamanoLote, totalLotes, loteActual, porcentaje };
    }

    function pintarAjusteEnCurso(job) {
        const btn = $('btnCuadrarComparativa'), texto = $('txtPendientesComparativa');
        const p = obtenerProgresoAjuste(job);
        btn.disabled = true;
        btn.innerHTML = '<span class="es-spinner"></span> ' + (p.solicitados > 0 ? `Ajustando ${fmtInt(p.procesados)}/${fmtInt(p.solicitados)}` : 'Ajuste en segundo plano');
        if (texto) {
            texto.textContent = job.mensaje || (p.totalLotes > 0
                ? `Procesando lote ${fmtInt(p.loteActual)} de ${fmtInt(p.totalLotes)} · ${p.porcentaje.toLocaleString('es-MX')}%.`
                : 'El procedimiento dbo.meat_CostoTIF se está ejecutando en segundo plano.');
        }
    }

    function actualizarEstadoCuadreComparativa() {
        const btn = $('btnCuadrarComparativa'), texto = $('txtPendientesComparativa');
        if (!btn || !texto) return;

        const totalAjustables = Math.max(0, Number(resumenComparativaActual?.totalAjustables) || 0);
        const totalSinCostoTif = Math.max(0, Number(resumenComparativaActual?.totalSinCostoTIF) || 0);
        const disponibles = codigosAjustablesComparativa.length;
        const incompleta = limiteAjustablesComparativaExcedido || disponibles < totalAjustables;

        const activo = window.CosteoAjusteMonitor?.getActive?.();
        if (activo?.jobId) { pintarAjusteEnCurso(activo); return; }

        btn.textContent = `Cuadrar comparativa (${fmtInt(totalAjustables)})`;
        btn.disabled = !comparativaConsultada || totalAjustables === 0 || incompleta;

        if (!comparativaConsultada) {
            texto.textContent = 'Consulta la comparativa para identificar diferencias o registros sin costo.';
            return;
        }
        const partes = [];
        if (totalAjustables > 0) {
            partes.push(`${fmtInt(totalAjustables)} etiqueta(s) ajustable(s) en P1`);
            partes.push(`${fmtInt(Math.ceil(totalAjustables / TAMANO_LOTE_AJUSTE_COMPARATIVA))} lote(s) secuencial(es) de hasta ${fmtInt(TAMANO_LOTE_AJUSTE_COMPARATIVA)}`);
        } else {
            partes.push('No hay etiquetas ajustables en P1');
        }
        if (totalSinCostoTif > 0) partes.push(`${fmtInt(totalSinCostoTif)} etiqueta(s) sin costo válido en TIF; primero deben costearse en TIF`);
        if (incompleta) partes.push(`el servidor devolvió ${fmtInt(disponibles)} de ${fmtInt(totalAjustables)} códigos; instala también el controlador ajustado`);
        texto.textContent = partes.join(' · ') + '.';
    }

    async function cuadrarComparativa() {
        const btn = $('btnCuadrarComparativa');
        const totalAjustables = Math.max(0, Number(resumenComparativaActual?.totalAjustables) || 0);
        const totalSinCostoTif = Math.max(0, Number(resumenComparativaActual?.totalSinCostoTIF) || 0);
        const codigos = [...codigosAjustablesComparativa];
        const totalLotes = Math.ceil(codigos.length / TAMANO_LOTE_AJUSTE_COMPARATIVA);
        if (!btn) return;

        if (window.CosteoAjusteMonitor?.getActive?.()?.jobId) {
            window.CosteoAjusteMonitor.toast('info', 'Ajuste en proceso', 'Ya existe un ajuste ejecutándose en segundo plano.', 8000);
            return;
        }
        if (limiteAjustablesComparativaExcedido || codigos.length < totalAjustables) {
            alert('La vista recibió una lista incompleta de códigos ajustables.\n\n' +
                `Servidor: ${fmtInt(codigos.length)} código(s).\nResumen: ${fmtInt(totalAjustables)} etiqueta(s).\n\n` +
                'Reemplaza también ProcesosCgController.cs por la versión ajustada para procesamiento por lotes.');
            return;
        }
        if (totalAjustables === 0 || codigos.length === 0) {
            alert(totalSinCostoTif > 0
                ? `No hay etiquetas ajustables desde P1.\n\n${fmtInt(totalSinCostoTif)} etiqueta(s) no tienen costo válido en TIF. Primero deben costearse en TIF; dbo.meat_CostoTIF no puede inventar ese costo.`
                : 'No hay diferencias ajustables en P1.');
            actualizarEstadoCuadreComparativa();
            return;
        }

        const muestra = codigos.slice(0, 8).join(', ');
        const adicionales = codigos.length > 8 ? `\n… y ${codigos.length - 8} etiqueta(s) adicional(es).` : '';
        const confirmado = window.confirm(
            'ATENCIÓN: esta operación modificará costos en la base Meat de P1.\n\n' +
            `Se ajustarán ${fmtInt(codigos.length)} etiqueta(s) con costo positivo en TIF.\n\n` +
            `El servidor las procesará secuencialmente en ${fmtInt(totalLotes)} lote(s) de hasta ${fmtInt(TAMANO_LOTE_AJUSTE_COMPARATIVA)} etiqueta(s).\n` +
            'Nunca se ejecutarán dos lotes al mismo tiempo.\n\n' +
            'Los códigos corresponden a todo el filtro consultado, no solamente a la página visible.\n\n' +
            `Ejemplos: ${muestra}${adicionales}\n\n` +
            'El proceso continuará en el servidor aunque cierres el modal o cambies de pestaña.\n\n' +
            '¿Confirmas que deseas cuadrar la comparativa?');
        if (!confirmado) return;

        try {
            btn.disabled = true;
            btn.innerHTML = '<span class="es-spinner"></span> Iniciando ajuste…';
            await window.CosteoAjusteMonitor?.requestNotificationPermission?.();

            const response = await fetch(URLS.iniciarAjuste, {
                method: 'POST', credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ CodigosEtiqueta: codigos, TamanoLote: TAMANO_LOTE_AJUSTE_COMPARATIVA })
            });
            const resultado = await leerJsonRespuesta(response);
            const puedeAdjuntar = response.status === 409 && resultado?.yaExiste === true && resultado?.jobId;

            if ((!response.ok || !resultado?.ok) && !puedeAdjuntar) {
                const mensaje = resultado?.mensaje || resultado?.msg || 'No se pudo iniciar el ajuste de la comparativa.';
                const detalle = resultado?.detalle || resultado?.error || '';
                throw new Error(detalle ? `${mensaje}\n\nDetalle técnico:\n${detalle}` : mensaje);
            }
            const jobId = resultado.jobId;
            if (!jobId) throw new Error('El servidor no devolvió el identificador del trabajo.');
            if (!window.CosteoAjusteMonitor?.track) throw new Error('No se cargó el monitor de ajustes de costeo. Recarga con Ctrl+F5 e inténtalo de nuevo.');

            await window.CosteoAjusteMonitor.track(jobId, {
                codigosSolicitados: resultado?.codigosSolicitados ?? codigos.length,
                codigosProcesados: resultado?.codigosProcesados ?? 0,
                tamanoLote: resultado?.tamanoLote ?? TAMANO_LOTE_AJUSTE_COMPARATIVA,
                loteActual: resultado?.loteActual ?? 0,
                totalLotes: resultado?.totalLotes ?? totalLotes,
                mensaje: resultado?.mensaje || 'Ajuste por lotes iniciado en segundo plano.'
            });

            showLog('info', `Ajuste de comparativa iniciado: ${fmtInt(codigos.length)} etiqueta(s) en ${fmtInt(resultado?.totalLotes ?? totalLotes)} lote(s).`);
            window.CosteoAjusteMonitor.toast('info', puedeAdjuntar ? 'Ajuste ya en proceso' : 'Ajuste por lotes iniciado',
                `Se procesarán ${fmtInt(resultado?.totalLotes ?? totalLotes)} lote(s) secuenciales de hasta ${fmtInt(resultado?.tamanoLote ?? TAMANO_LOTE_AJUSTE_COMPARATIVA)} etiquetas. Puedes navegar por la aplicación.`, 14000);
        } catch (e) {
            actualizarEstadoCuadreComparativa();
            alert(e?.message || 'Ocurrió un error al iniciar el ajuste de la comparativa.');
        }
    }

    window.addEventListener('costeo-ajuste-estado', function(event) {
        const job = event?.detail || {};
        if (!$('btnCuadrarComparativa')) return;
        if (job.estado === 'PENDIENTE' || job.estado === 'EJECUTANDO') pintarAjusteEnCurso(job);
    });

    window.addEventListener('costeo-ajuste-finalizado', async function(event) {
        const job = event?.detail || {};
        showLog(job.exito ? 'success' : 'danger', job.exito
            ? `Ajuste de comparativa terminado: ${fmtInt(job.codigosSolicitados)} etiqueta(s).`
            : `El ajuste de comparativa terminó con error: ${job.mensaje || 'sin detalle'}.`);

        const modal = $('modalComparativa');
        if (job.exito === true && modal?.classList.contains('show')) {
            try { await consultarComparativa(1); }
            catch (e) { console.warn('No se pudo refrescar automáticamente la comparativa:', e); }
            return;
        }
        // Si la comparativa no está abierta, los códigos que tenía ya no son vigentes:
        // se limpian para que nadie vuelva a cuadrar sobre datos viejos.
        if (job.exito === true) {
            comparativaConsultada = false;
            codigosAjustablesComparativa = [];
            resumenComparativaActual = {};
        }
        actualizarEstadoCuadreComparativa();
    });

    /* ---------------- Render de la tabla comparativa ---------------- */
    function etiquetaColumna(clave) {
        return String(clave)
            .replace(/_/g, ' ')
            .replace(/([a-záéíóúñ0-9])([A-Z])/g, '$1 $2')
            .replace(/^./, c => c.toUpperCase());
    }

    function obtenerClaseColumna(nombre) {
        const n = String(nombre).toLowerCase();
        if (n.includes('producto')) return 'col-producto';
        if (n.includes('estado')) return 'col-estado';
        if (n.includes('costo') || n.includes('dif')) return 'col-costo';
        if (n.includes('peso') || n.includes('kg')) return 'col-peso';
        if (/(^id|id$)/.test(n)) return 'col-id';
        return '';
    }

    const ESTADO_PILL = {
        '100% MISMO COSTO': 'es-pill--ok',
        'COSTO DIFERENTE': 'es-pill--bad',
        'SIN COSTO EN TIF': 'es-pill--warn',
        'SIN COSTO EN P1': 'es-pill--orange',
        'SIN COSTO EN TIF Y P1': ''
    };

    function formatearCelda(columna, valor) {
        if (valor === null || valor === undefined || valor === '') return '<span class="es-muted">-</span>';
        if (/^estadocosto$/i.test(columna) && Object.prototype.hasOwnProperty.call(ESTADO_PILL, valor)) {
            return `<span class="es-pill ${ESTADO_PILL[valor]}">${safe(valor)}</span>`;
        }
        // Solo cadenas con formato ISO de fecha (antes cualquier texto con "T" se intentaba leer como fecha).
        if (typeof valor === 'string' && /^\d{4}-\d{2}-\d{2}T/.test(valor)) return formatDate(valor);
        if (typeof valor === 'number' && /costo|peso|dif|kg|precio|importe/i.test(columna)) {
            return valor.toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 4 });
        }
        return safe(valor);
    }

    function renderEncabezado(datos) {
        const thead = $('theadComparativa');
        thead.innerHTML = '';
        if (!datos || !datos.length) return;
        thead.innerHTML = '<tr>' + Object.keys(datos[0]).map(c =>
            `<th class="${obtenerClaseColumna(c)}" title="${safeAttr(c)}">${safe(etiquetaColumna(c))}</th>`).join('') + '</tr>';
    }

    function renderFilas(datos) {
        const tbody = $('tbodyComparativaCosteo');
        if (!tbody) return;
        if (!Array.isArray(datos) || !datos.length) {
            tbody.innerHTML = '<tr><td colspan="20" class="es-empty-cell">No hay registros para este filtro. Si buscabas diferencias, la comparativa está cuadrada.</td></tr>';
            return;
        }
        const columnas = Object.keys(datos[0]);
        tbody.innerHTML = datos.map(fila =>
            '<tr>' + columnas.map(c => `<td class="${obtenerClaseColumna(c)}">${formatearCelda(c, fila[c])}</td>`).join('') + '</tr>'
        ).join('');
    }

    function renderResumen(resultado) {
        const cont = $('resumenComparativa');
        if (!cont) return;
        const r = resultado?.resumen || {};
        const item = (cls, label, v) => `<div class="es-sum ${cls}"><span>${label}</span><strong>${fmtInt(v)}</strong></div>`;
        cont.innerHTML = `
                <div class="es-summary">
                    ${item('es-sum--ink', 'Total del periodo', r.totalGeneral)}
                    ${item('es-sum--neutral', 'Según filtro', r.totalFiltrado ?? resultado?.total)}
                    ${item('es-sum--ok', 'Mismo costo', r.mismoCosto)}
                    ${item('es-sum--bad', 'Costo diferente', r.costoDiferente)}
                    ${item('es-sum--warn', 'Sin costo en TIF', r.sinCostoTIF)}
                    ${item('es-sum--orange', 'Sin costo en P1', r.sinCostoP1)}
                    ${item('es-sum--neutral', 'Sin costo en ambas', r.sinCostoAmbos)}
                </div>`;
    }

    /* =====================================================================
       EVENTOS E INICIO
       ===================================================================== */
    function initCosteo() {
        $('Modo')?.addEventListener('change', syncModeUI);
        $('Source')?.addEventListener('change', loadAutoStatus);
        $('TipoProceso')?.addEventListener('change', loadAutoStatus);
        $('HoraProgramada')?.addEventListener('change', () => guardarAuto(true));
        $('BrincarSinCosto')?.addEventListener('change', () => guardarAuto(true));
        $('ContinuarConError')?.addEventListener('change', () => guardarAuto(true));
        $('Automatico')?.addEventListener('change', () => guardarAuto());
        $('btnGuardarAuto')?.addEventListener('click', () => guardarAuto());
        $('btnEjecutarCosteo')?.addEventListener('click', ejecutarCosteo);

        $('btnConsultarBitacora')?.addEventListener('click', recargarBitacora);
        $('modalHistorico')?.addEventListener('show.bs.modal', recargarBitacora);

        $('btnConsultarComparativa')?.addEventListener('click', () => consultarComparativa(1));
        $('btnExportarComparativa')?.addEventListener('click', exportarComparativaExcel);
        $('btnCuadrarComparativa')?.addEventListener('click', cuadrarComparativa);
        $('btnPaginaAnterior')?.addEventListener('click', () => cambiarPaginaComparativa(-1));
        $('btnPaginaSiguiente')?.addEventListener('click', () => cambiarPaginaComparativa(1));
        $('cmpTamanoPagina')?.addEventListener('change', cambiarTamanoPaginaComparativa);
        $('modalComparativa')?.addEventListener('hidden.bs.modal', limpiarComparativa);

        $('btnLimpiarLog')?.addEventListener('click', () => {
            $('esLogList').innerHTML = '<li class="es-log__empty">Sin actividad todavía.</li>';
        });

        syncModeUI();
        loadAutoStatus();
        actualizarEstadoCuadreComparativa();

        const ajusteActivo = window.CosteoAjusteMonitor?.getActive?.();
        if (ajusteActivo?.jobId) {
            window.dispatchEvent(new CustomEvent('costeo-ajuste-estado', { detail: ajusteActivo }));
        }
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initCosteo);
    else initCosteo();
</script>
