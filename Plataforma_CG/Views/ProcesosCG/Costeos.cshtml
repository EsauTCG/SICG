@using Plataforma_CG.ViewModels
@model Plataforma_CG.ViewModels.CosteoFiltroVM
@removeTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Costeo";

    var source = string.IsNullOrWhiteSpace(Model?.Source) ? "P1" : Model.Source;
    var tipoProceso = string.IsNullOrWhiteSpace(Model?.TipoProceso) ? "CAJAS" : Model.TipoProceso;
    var modo = string.IsNullOrWhiteSpace(Model?.Modo) ? "DIA" : Model.Modo;

    var fechaInicial = Model == null || Model.FechaInicial == default ? DateTime.Today : Model.FechaInicial;
    var fechaFinal = Model == null || Model.FechaFinal == default ? DateTime.Today : Model.FechaFinal;
    var horaProgramada = string.IsNullOrWhiteSpace(Model?.HoraProgramada) ? "18:00" : Model.HoraProgramada;
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap');

    /* =====================================================================
           COSTEO · SIGO  —  hoja de estilos única (mismo sistema visual que
           Entregas SAP). Sustituye las capas anteriores y costeo-erp-final.css.
           ===================================================================== */
    :root {
        --es-tinto: #8d3e46;
        --es-tinto-deep: #5c2229;
        --es-tinto-soft: #f7eced;
        --es-tinto-line: #e8d3d6;
        --es-paper: #f6f4f4;
        --es-surface: #ffffff;
        --es-ink: #231a1c;
        --es-muted: #76686b;
        --es-line: #e6dfe0;
        --es-line-strong: #cfc4c6;
        --es-ok: #2f7a55;
        --es-ok-bg: #e7f3ec;
        --es-warn: #9a6410;
        --es-warn-bg: #fbf1de;
        --es-bad: #b42d2d;
        --es-bad-bg: #fbe9e8;
        --es-orange: #b4531a;
        --es-orange-bg: #fdeee3;
        --es-info: #2f5d86;
        --es-info-bg: #e9f0f7;
        --es-neutral: #6b6466;
        --es-neutral-bg: #efecec;
        --es-font: "Poppins", "Segoe UI", system-ui, -apple-system, Arial, sans-serif;
    }

    /* ---------- Ajustes de layout heredados (solo mientras Costeo está cargado):
           un solo scroll vertical y footer compacto. ---------- */
    body {
        display: flex !important;
        flex-direction: column !important;
        min-height: 100dvh !important;
        overflow-x: hidden !important;
    }

    .layout-main-content {
        flex: 1 1 auto !important;
        width: auto !important;
        max-width: 100% !important;
        min-width: 0 !important;
        min-height: 0 !important;
        height: auto !important;
        overflow-x: hidden !important;
    }

        .layout-main-content .layout-container-fluid {
            max-width: 100% !important;
            min-width: 0 !important;
            min-height: 0 !important;
            height: auto !important;
        }

    .layout-footer {
        position: static !important;
        min-height: 29px !important;
        padding: 4px 0 !important;
        font-family: var(--es-font) !important;
        font-size: 11px !important;
    }

        .layout-footer p {
            margin: 0 !important;
            line-height: 20px !important;
        }

    .esap, .es-modal {
        font-family: var(--es-font);
        color: var(--es-ink);
        font-size: 13px;
        line-height: 1.4;
    }

        .esap *, .es-modal * {
            box-sizing: border-box;
        }

    .esap {
        background: var(--es-paper);
        padding: 16px 18px 10px;
    }

    .es-muted {
        color: var(--es-muted);
    }

    .es-num {
        font-variant-numeric: tabular-nums;
    }

    .d-none {
        display: none !important;
    }

    /* ---------- Encabezado ---------- */
    .es-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 14px;
    }

    .es-header__title {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .es-header__icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: grid;
        place-items: center;
        background: var(--es-tinto);
        color: #fff;
        font-size: 19px;
    }

    .es-header h1 {
        margin: 0;
        font-size: 20px;
        font-weight: 700;
        letter-spacing: -.01em;
        line-height: 1.15;
    }

    .es-header p {
        margin: 2px 0 0;
        font-size: 12px;
        color: var(--es-muted);
    }

    .es-header__actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    /* ---------- Tarjetas ---------- */
    .es-card {
        background: var(--es-surface);
        border: 1px solid var(--es-line);
        border-radius: 10px;
        margin-bottom: 12px;
    }

    .es-card__head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        flex-wrap: wrap;
        padding: 10px 14px;
        border-bottom: 1px solid var(--es-line);
        font-weight: 600;
        font-size: 13px;
    }

        .es-card__head i {
            color: var(--es-tinto);
            margin-right: 6px;
        }

    .es-card__body {
        padding: 12px 14px;
    }

    .es-grid-2 {
        display: grid;
        grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
        gap: 12px;
        align-items: start;
    }

    /* ---------- Controles ---------- */
    .es-label {
        display: block;
        margin: 0 0 5px;
        font-size: 12px;
        font-weight: 600;
        color: var(--es-muted);
        white-space: nowrap;
    }

    .es-input {
        display: block;
        width: 100%;
        height: 36px;
        padding: 0 10px;
        border: 1px solid var(--es-line-strong);
        border-radius: 7px;
        background: #fff;
        color: var(--es-ink);
        font: 500 13px/1 var(--es-font);
        transition: border-color .12s, box-shadow .12s;
    }

        .es-input:focus {
            outline: none;
            border-color: var(--es-tinto);
            box-shadow: 0 0 0 3px rgba(141,62,70,.16);
        }

    .es-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        height: 36px;
        padding: 0 14px;
        border: 1px solid var(--es-line-strong);
        border-radius: 7px;
        background: #fff;
        color: var(--es-ink);
        font: 600 12.5px/1 var(--es-font);
        white-space: nowrap;
        cursor: pointer;
        text-decoration: none;
        transition: background .12s, border-color .12s, color .12s;
    }

        .es-btn:hover {
            background: var(--es-tinto-soft);
            border-color: var(--es-tinto-line);
            color: var(--es-tinto-deep);
        }

        .es-btn:focus-visible {
            outline: 2px solid var(--es-tinto);
            outline-offset: 2px;
        }

        .es-btn:disabled {
            opacity: .5;
            cursor: not-allowed;
        }

    .es-btn--primary {
        background: var(--es-tinto);
        border-color: var(--es-tinto);
        color: #fff;
    }

        .es-btn--primary:hover {
            background: var(--es-tinto-deep);
            border-color: var(--es-tinto-deep);
            color: #fff;
        }

    .es-btn--soft {
        background: var(--es-tinto-soft);
        border-color: var(--es-tinto-line);
        color: var(--es-tinto-deep);
    }

    .es-btn--warn {
        background: var(--es-warn-bg);
        border-color: #ecd3a5;
        color: var(--es-warn);
    }

        .es-btn--warn:hover {
            background: #f6e5c4;
            border-color: #e2c084;
            color: #7a4f0c;
        }

    .es-btn--ghost {
        background: transparent;
        border-color: transparent;
    }

    .es-btn--sm {
        height: 28px;
        padding: 0 10px;
        font-size: 11.5px;
    }

    .es-check {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin: 0;
        font-size: 12.5px;
        font-weight: 500;
        cursor: pointer;
        white-space: nowrap;
    }

        .es-check input {
            width: 16px;
            height: 16px;
            margin: 0;
            accent-color: var(--es-tinto);
            cursor: pointer;
        }

    /* ---------- Parámetros ---------- */
    .es-filters {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 10px 12px;
        align-items: end;
    }
    /* Visibilidad de campos según el modo seleccionado */
    .mode-dia .mode-rango-only, .mode-dia .mode-lote-only,
    .mode-mes .mode-rango-only, .mode-mes .mode-lote-only,
    .mode-rango .mode-lote-only,
    .mode-lote .mode-date-only, .mode-lote .mode-rango-only {
        display: none;
    }

    .es-options {
        display: flex;
        align-items: center;
        gap: 18px;
        flex-wrap: wrap;
        margin-top: 12px;
        padding-top: 12px;
        border-top: 1px dashed var(--es-line);
    }

    .es-run {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 12px;
    }

    .es-steps {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
        font-size: 12px;
        color: var(--es-muted);
    }

    .es-step {
        display: inline-flex;
        align-items: center;
        height: 24px;
        padding: 0 10px;
        border-radius: 999px;
        background: var(--es-neutral-bg);
        color: var(--es-ink);
        font-weight: 500;
    }

    .es-steps i {
        color: var(--es-line-strong);
    }

    .es-run__actions {
        display: flex;
        gap: 8px;
    }

    /* ---------- Programación automática ---------- */
    .es-sched__row {
        display: flex;
        align-items: end;
        gap: 10px;
        flex-wrap: wrap;
    }

        .es-sched__row > div:first-child {
            width: 140px;
        }

    .es-hint {
        margin: 10px 0 0;
        font-size: 11.5px;
        color: var(--es-muted);
    }

    .es-auto-list {
        display: grid;
        gap: 6px;
        margin-top: 12px;
    }

    .es-auto-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding: 8px 10px;
        border: 1px solid var(--es-line);
        border-radius: 8px;
        font-size: 12.5px;
    }

    .es-auto-item__name {
        font-weight: 500;
    }

    .es-auto-item__time {
        font-variant-numeric: tabular-nums;
        color: var(--es-muted);
        margin-left: auto;
    }

    .es-auto-empty {
        padding: 10px;
        border: 1px dashed var(--es-line-strong);
        border-radius: 8px;
        color: var(--es-muted);
        font-size: 12px;
    }

    /* ---------- Pastillas ---------- */
    .es-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        height: 22px;
        padding: 0 9px;
        border-radius: 999px;
        font-size: 11.5px;
        font-weight: 600;
        white-space: nowrap;
        background: var(--es-neutral-bg);
        color: var(--es-neutral);
    }

        .es-pill::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: currentColor;
            flex: none;
        }

    .es-pill--ok {
        background: var(--es-ok-bg);
        color: var(--es-ok);
    }

    .es-pill--bad {
        background: var(--es-bad-bg);
        color: var(--es-bad);
    }

    .es-pill--warn {
        background: var(--es-warn-bg);
        color: var(--es-warn);
    }

    .es-pill--orange {
        background: var(--es-orange-bg);
        color: var(--es-orange);
    }

    .es-pill--info {
        background: var(--es-info-bg);
        color: var(--es-info);
    }

    /* ---------- Tablas ---------- */
    .es-table-wrap {
        overflow: auto;
        border: 1px solid var(--es-line);
        border-radius: 8px;
        background: #fff;
    }

    .es-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        font-size: 12.5px;
    }

        .es-table thead th {
            position: sticky;
            top: 0;
            z-index: 2;
            padding: 9px 10px;
            background: #faf7f7;
            border-bottom: 1px solid var(--es-line);
            color: var(--es-muted);
            font-size: 11.5px;
            font-weight: 600;
            text-align: left;
            white-space: nowrap;
        }

        .es-table tbody td {
            padding: 7px 10px;
            border-bottom: 1px solid #f0eaeb;
            vertical-align: middle;
            white-space: nowrap;
        }

        .es-table tbody tr:hover td {
            background: #fcf9f9;
        }

        .es-table .text-end, .es-table .col-costo, .es-table .col-peso {
            text-align: right;
            font-variant-numeric: tabular-nums;
        }

        .es-table .text-center, .es-table .col-id, .es-table .col-estado {
            text-align: center;
        }

        .es-table .col-producto {
            min-width: 240px;
        }

        .es-table .col-msg {
            max-width: 420px;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .es-table tr.is-error td:first-child {
            box-shadow: inset 3px 0 0 var(--es-bad);
        }

    .es-empty-cell {
        padding: 26px 10px !important;
        text-align: center;
        color: var(--es-muted);
        white-space: normal !important;
    }

    /* ---------- Bitácora de sesión ---------- */
    .es-log__list {
        list-style: none;
        margin: 0;
        padding: 0;
        max-height: 170px;
        overflow: auto;
    }

    .es-log__item {
        display: flex;
        gap: 10px;
        padding: 7px 14px;
        border-bottom: 1px solid #f2eded;
        font-size: 12px;
        border-left: 3px solid var(--lc, var(--es-line-strong));
    }

        .es-log__item:last-child {
            border-bottom: 0;
        }

    .es-log__time {
        flex: none;
        color: var(--es-muted);
        font-variant-numeric: tabular-nums;
    }

    .es-log__msg {
        white-space: pre-wrap;
        word-break: break-word;
    }

    .es-log__item--success {
        --lc: var(--es-ok);
    }

    .es-log__item--warning {
        --lc: #d9a24a;
    }

    .es-log__item--danger {
        --lc: var(--es-bad);
    }

    .es-log__item--info {
        --lc: var(--es-info);
    }

    .es-log__empty {
        padding: 12px 14px;
        color: var(--es-muted);
        font-size: 12px;
    }

    .es-statusbar {
        display: flex;
        gap: 18px;
        flex-wrap: wrap;
        padding: 4px 2px;
        font-size: 11.5px;
        color: var(--es-muted);
    }

        .es-statusbar #esStatusMsg {
            color: var(--es-ink);
            font-weight: 500;
            margin-right: auto;
            max-width: 60%;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

    /* ---------- Modales ---------- */
    .es-modal {
        border: 0;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 18px 50px rgba(35,26,28,.25);
    }

    .es-modal__head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 14px 18px;
        background: var(--es-tinto-deep);
        color: #fff;
    }

    .es-modal__title {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0;
        font-size: 15px;
        font-weight: 600;
    }

    .es-modal__close {
        width: 30px;
        height: 30px;
        border: 0;
        border-radius: 7px;
        background: rgba(255,255,255,.12);
        color: #fff;
        cursor: pointer;
        display: grid;
        place-items: center;
    }

        .es-modal__close:hover {
            background: rgba(255,255,255,.22);
        }

    .es-modal__body {
        padding: 14px 18px;
        background: #fff;
    }

    .es-modal__foot {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        padding: 12px 18px;
        border-top: 1px solid var(--es-line);
        background: #faf7f7;
    }

    .es-modal-filters {
        display: grid;
        grid-template-columns: repeat(4, minmax(130px, 1fr)) auto;
        gap: 10px 12px;
        align-items: end;
        margin-bottom: 12px;
    }

    .es-modal-filters__actions {
        display: flex;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
    }

    .es-modal .modal-dialog-wide {
        width: min(1500px, 96vw);
        max-width: min(1500px, 96vw);
    }

    /* Comparativa */
    .es-ajuste {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
        padding: 10px 12px;
        margin-bottom: 12px;
        border: 1px solid #ecd3a5;
        border-radius: 8px;
        background: var(--es-warn-bg);
        color: #6d470b;
        font-size: 12.5px;
    }

        .es-ajuste strong {
            color: var(--es-ink);
        }

    .es-summary {
        display: grid;
        grid-template-columns: repeat(7, minmax(0, 1fr));
        gap: 8px;
        margin-bottom: 12px;
    }

    .es-sum {
        padding: 8px 10px;
        border: 1px solid var(--es-line);
        border-radius: 8px;
        border-top: 3px solid var(--k, var(--es-line-strong));
    }

        .es-sum span {
            display: block;
            font-size: 11.5px;
            color: var(--es-muted);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .es-sum strong {
            font-size: 18px;
            font-weight: 700;
            font-variant-numeric: tabular-nums;
        }

    .es-sum--ok {
        --k: var(--es-ok);
    }

    .es-sum--bad {
        --k: var(--es-bad);
    }

    .es-sum--warn {
        --k: #d9a24a;
    }

    .es-sum--orange {
        --k: var(--es-orange);
    }

    .es-sum--neutral {
        --k: #b9adb0;
    }

    .es-sum--ink {
        --k: var(--es-ink);
    }

    #tablaComparativa {
        max-height: 58vh;
    }

    .es-pager {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
        padding: 10px 0 0;
        font-size: 12.5px;
    }

    .es-pager__controls {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

        .es-pager__controls .es-input {
            width: 92px;
            height: 32px;
        }

        .es-pager__controls .es-btn {
            height: 32px;
        }

    #cmpNumeroPagina {
        min-width: 120px;
        text-align: center;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
    }

    .es-loading {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
        min-height: 260px;
        text-align: center;
    }

        .es-loading h5 {
            margin: 0;
            font-size: 15px;
            font-weight: 600;
        }

        .es-loading p {
            margin: 0;
            color: var(--es-muted);
            font-size: 12.5px;
            max-width: 420px;
        }

    .es-progress {
        width: min(360px, 80%);
        height: 6px;
        border-radius: 999px;
        background: var(--es-tinto-soft);
        overflow: hidden;
    }

        .es-progress span {
            display: block;
            height: 100%;
            width: 35%;
            border-radius: 999px;
            background: var(--es-tinto);
            animation: es-indet 1.2s ease-in-out infinite;
        }

    .es-spinner {
        display: inline-block;
        width: 15px;
        height: 15px;
        border: 2px solid var(--es-tinto-line);
        border-top-color: var(--es-tinto);
        border-radius: 50%;
        animation: es-spin .8s linear infinite;
        vertical-align: middle;
    }

    .es-spinner--light {
        border-color: rgba(255,255,255,.35);
        border-top-color: #fff;
    }

    .es-spinner--lg {
        width: 30px;
        height: 30px;
        border-width: 3px;
    }

    @@keyframes es-spin {
        to {
            transform: rotate(360deg);
        }
    }

    @@keyframes es-indet {
        0% {
            transform: translateX(-110%);
        }

        100% {
            transform: translateX(310%);
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .es-progress span {
            animation: none;
            width: 100%;
            opacity: .5;
        }
    }

    /* ---------- Responsive ---------- */
    @@media (max-width: 1200px) {
        .es-grid-2 {
            grid-template-columns: 1fr;
        }

        .es-summary {
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }

        .es-modal-filters {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .es-modal-filters__actions {
            grid-column: 1 / -1;
        }
    }

    @@media (max-width: 640px) {
        .esap {
            padding: 10px;
        }

        .es-summary {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .es-modal-filters {
            grid-template-columns: 1fr;
        }

        .es-statusbar #esStatusMsg {
            max-width: 100%;
        }
    }
</style>

<div class="esap costeo-app" id="costeoApp">

    <header class="es-header">
        <div class="es-header__title">
            <span class="es-header__icon"><i class="bi bi-calculator"></i></span>
            <div>
                <h1>Costeo</h1>
                <p>Ejecución manual y programada del costeo de Canales, Cajas y Retrabajo</p>
            </div>
