@model List<Plataforma_CG.ViewModels.EntregaSapRowVM>
@removeTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "";

    var source = (string)(ViewBag.Source ?? "P1");
    DateTime desde = ViewBag.Desde != null ? (DateTime)ViewBag.Desde : DateTime.Today;
    DateTime hasta = ViewBag.Hasta != null ? (DateTime)ViewBag.Hasta : DateTime.Today;
    var cliente = (string)(ViewBag.Cliente ?? "");

    // Se conserva la vista elegida al recargar (antes se perdía).
    var estatusSap = (Context.Request.Query["estatusSap"].ToString() ?? "").Trim().ToLowerInvariant();
    var estatusValidos = new[] { "todos", "enviados", "noenviados", "pendientes", "fallidas", "devrevisar" };
    if (!estatusValidos.Contains(estatusSap)) { estatusSap = "todos"; }

    var filas = Model ?? new List<Plataforma_CG.ViewModels.EntregaSapRowVM>();
    var totalEntregasSap = filas.Count;
    var totalEnviadasSap = filas.Count(x => x.EnviadoSap == true);
    var totalFallidasSap = filas.Count(x => x.EnviadoSap == false);
    var totalPendientesSap = totalEntregasSap - totalEnviadasSap - totalFallidasSap;
    var totalClientesSap = filas
        .Where(x => !string.IsNullOrWhiteSpace(x.Cliente))
        .Select(x => x.Cliente.Trim())
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Count();
    var periodoSap = desde.Date == hasta.Date
        ? desde.ToString("dd/MM/yyyy")
        : $"{desde:dd/MM/yyyy} – {hasta:dd/MM/yyyy}";
    var origenNombre = source == "TIF" ? "Planta TIF" : "Planta 1";
}

<style>
    /* =====================================================================
           ENTREGAS SAP · SIGO — hoja de estilos única y autocontenida
           ===================================================================== */
    :root {
        --es-tinto: #8d3e46;
        --es-tinto-deep: #5c2229;
        --es-tinto-soft: #f7eced;
        --es-tinto-line: #e8d3d6;
        --es-paper: #f6f4f4;
        --es-surface: #ffffff;
        --es-ink: #231a1c;
        --es-muted: #76686b;
        --es-line: #e6dfe0;
        --es-line-strong: #cfc4c6;
        --es-ok: #2f7a55;
        --es-ok-bg: #e7f3ec;
        --es-warn: #9a6410;
        --es-warn-bg: #fbf1de;
        --es-bad: #b42d2d;
        --es-bad-bg: #fbe9e8;
        --es-info: #2f5d86;
        --es-info-bg: #e9f0f7;
        --es-neutral: #6b6466;
        --es-neutral-bg: #efecec;
        --es-font: "Poppins", "Segoe UI", system-ui, -apple-system, Arial, sans-serif;
        --es-mono: ui-monospace, "Cascadia Mono", Consolas, monospace;
    }

    .esap, .es-modal {
        font-family: var(--es-font);
        color: var(--es-ink);
        font-size: 13px;
        line-height: 1.4;
    }

        .esap *, .es-modal * {
            box-sizing: border-box;
        }

    .esap {
        background: var(--es-paper);
        padding: 16px 18px 10px;
        min-height: 100%;
    }

    .es-muted {
        color: var(--es-muted);
    }

    .es-num {
        font-variant-numeric: tabular-nums;
    }

    /* ---------- Encabezado ---------- */
    .es-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 14px;
    }

    .es-header__title {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .es-header__icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: grid;
        place-items: center;
        background: var(--es-tinto);
        color: #fff;
        font-size: 19px;
    }

    .es-header h1 {
        margin: 0;
        font-size: 20px;
        font-weight: 700;
        letter-spacing: -.01em;
        line-height: 1.15;
    }

    .es-header p {
        margin: 2px 0 0;
        font-size: 12px;
        color: var(--es-muted);
    }

    .es-chips {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }

    .es-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        height: 28px;
        padding: 0 11px;
        border: 1px solid var(--es-line);
        border-radius: 999px;
        background: var(--es-surface);
        font-size: 12px;
        font-weight: 500;
        white-space: nowrap;
    }

        .es-chip i {
            color: var(--es-tinto);
        }

    /* ---------- Tarjetas ---------- */
    .es-card {
        background: var(--es-surface);
        border: 1px solid var(--es-line);
        border-radius: 10px;
        margin-bottom: 12px;
    }

    .es-card__head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        padding: 10px 14px;
        border-bottom: 1px solid var(--es-line);
        font-weight: 600;
        font-size: 13px;
    }

        .es-card__head i {
            color: var(--es-tinto);
            margin-right: 6px;
        }

    /* ---------- Controles ---------- */
    .es-label {
        display: block;
        margin: 0 0 5px;
        font-size: 12px;
        font-weight: 600;
        color: var(--es-muted);
        white-space: nowrap;
    }

    .es-input {
        display: block;
        width: 100%;
        height: 36px;
        padding: 0 10px;
        border: 1px solid var(--es-line-strong);
        border-radius: 7px;
        background: #fff;
        color: var(--es-ink);
        font: 500 13px/1 var(--es-font);
        transition: border-color .12s, box-shadow .12s;
    }

    select.es-input {
        padding-right: 28px;
    }

    .es-input:focus {
        outline: none;
        border-color: var(--es-tinto);
        box-shadow: 0 0 0 3px rgba(141,62,70,.16);
    }

    .es-textarea {
        height: auto;
        padding: 9px 10px;
        line-height: 1.45;
        resize: vertical;
    }

    .es-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        height: 36px;
        padding: 0 14px;
        border: 1px solid var(--es-line-strong);
        border-radius: 7px;
        background: #fff;
        color: var(--es-ink);
        font: 600 12.5px/1 var(--es-font);
        white-space: nowrap;
        cursor: pointer;
        text-decoration: none;
        transition: background .12s, border-color .12s, color .12s;
    }

        .es-btn:hover {
            background: var(--es-tinto-soft);
            border-color: var(--es-tinto-line);
            color: var(--es-tinto-deep);
        }

        .es-btn:focus-visible {
            outline: 2px solid var(--es-tinto);
            outline-offset: 2px;
        }

        .es-btn:disabled, .es-btn[aria-disabled="true"] {
            opacity: .5;
            cursor: not-allowed;
            pointer-events: none;
        }

    .es-btn--primary {
        background: var(--es-tinto);
        border-color: var(--es-tinto);
        color: #fff;
    }

        .es-btn--primary:hover {
            background: var(--es-tinto-deep);
            border-color: var(--es-tinto-deep);
            color: #fff;
        }

    .es-btn--soft {
        background: var(--es-tinto-soft);
        border-color: var(--es-tinto-line);
        color: var(--es-tinto-deep);
    }

        .es-btn--soft:hover {
            background: #f0dfe1;
        }

    .es-btn--warn {
        background: var(--es-warn-bg);
        border-color: #ecd3a5;
        color: var(--es-warn);
    }

    .es-btn--ghost {
        background: transparent;
        border-color: transparent;
    }

    .es-btn--sm {
        height: 28px;
        padding: 0 9px;
        font-size: 11.5px;
        gap: 5px;
        border-radius: 6px;
    }

    .es-btn i {
        font-size: 1.05em;
    }

    .es-count {
        min-width: 20px;
        height: 20px;
        padding: 0 6px;
        border-radius: 999px;
        display: inline-grid;
        place-items: center;
        background: var(--es-tinto);
        color: #fff;
        font-size: 11px;
        font-variant-numeric: tabular-nums;
    }

        .es-count[data-zero="1"] {
            background: var(--es-line-strong);
        }

    .es-toggle .es-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #bdb2b4;
        flex: none;
    }

    .es-toggle.is-on {
        background: var(--es-ok-bg);
        border-color: #b9dcc7;
        color: var(--es-ok);
    }

        .es-toggle.is-on .es-dot {
            background: var(--es-ok);
            box-shadow: 0 0 0 3px rgba(47,122,85,.2);
            animation: es-pulse 2s ease-in-out infinite;
        }

    /* ---------- Filtros ---------- */
    .es-filters {
        display: grid;
        grid-template-columns: 150px minmax(220px, 2fr) 180px 150px 150px auto;
        gap: 10px 12px;
        align-items: end;
        padding: 12px 14px;
        margin: 0;
    }

    /* ---------- Barra de estado SAP ---------- */
    .es-status {
        padding: 14px;
    }

    .es-status__bar {
        display: flex;
        height: 10px;
        border-radius: 999px;
        overflow: hidden;
        background: var(--es-neutral-bg);
        margin-bottom: 12px;
    }

        .es-status__bar span {
            display: block;
            height: 100%;
            transition: width .35s ease;
        }

        .es-status__bar .s-ok {
            background: var(--es-ok);
        }

        .es-status__bar .s-none {
            background: #c9bfc1;
        }

        .es-status__bar .s-fail {
            background: var(--es-bad);
        }

    .es-kpis {
        display: grid;
        grid-template-columns: repeat(6, minmax(0, 1fr));
        gap: 8px;
    }

    .es-kpi {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 2px;
        padding: 10px 12px;
        border: 1px solid var(--es-line);
        border-radius: 8px;
        background: #fff;
        text-align: left;
        font-family: var(--es-font);
        color: var(--es-ink);
    }

    button.es-kpi {
        cursor: pointer;
        transition: border-color .12s, background .12s;
    }

        button.es-kpi:hover {
            border-color: var(--es-tinto-line);
            background: #fdfafa;
        }

        button.es-kpi:focus-visible {
            outline: 2px solid var(--es-tinto);
            outline-offset: 2px;
        }

    .es-kpi.is-active {
        border-color: var(--es-tinto);
        box-shadow: inset 0 0 0 1px var(--es-tinto);
        background: var(--es-tinto-soft);
    }

    .es-kpi__label {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 12px;
        font-weight: 600;
        color: var(--es-muted);
    }

        .es-kpi__label::before {
            content: "";
            width: 8px;
            height: 8px;
            border-radius: 2px;
            background: var(--k, var(--es-neutral));
        }

    .es-kpi strong {
        font-size: 24px;
        font-weight: 700;
        line-height: 1.1;
        font-variant-numeric: tabular-nums;
        letter-spacing: -.01em;
    }

    .es-kpi small {
        font-size: 11px;
        color: var(--es-muted);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .es-kpi--total {
        --k: var(--es-ink);
    }

    .es-kpi--ok {
        --k: var(--es-ok);
    }

    .es-kpi--none {
        --k: #b9adb0;
    }

    .es-kpi--fail {
        --k: var(--es-bad);
    }

    .es-kpi--sel {
        --k: var(--es-tinto);
    }

    .es-kpi--dev {
        --k: var(--es-warn);
    }

        .es-kpi--dev.bad strong {
            color: var(--es-bad);
        }

        .es-kpi--dev.ok strong {
            color: var(--es-ok);
        }

    /* ---------- Barra de herramientas de la tabla ---------- */
    .es-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
        padding: 10px 14px;
        border-bottom: 1px solid var(--es-line);
    }

    .es-toolbar__left, .es-toolbar__right {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .es-search {
        position: relative;
        width: 340px;
        max-width: 100%;
    }

        .es-search i {
            position: absolute;
            left: 10px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--es-muted);
            font-size: 13px;
            pointer-events: none;
        }

        .es-search .es-input {
            padding-left: 31px;
        }

    .es-divider {
        width: 1px;
        height: 22px;
        background: var(--es-line);
        margin: 0 2px;
    }

    /* ---------- Tablas ---------- */
    .es-table-wrap {
        overflow: auto;
    }

    .es-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        font-size: 12.5px;
    }

        .es-table thead th {
            position: sticky;
            top: 0;
            z-index: 2;
            padding: 9px 10px;
            background: #faf7f7;
            border-bottom: 1px solid var(--es-line);
            color: var(--es-muted);
            font-size: 11.5px;
            font-weight: 600;
            text-align: left;
            white-space: nowrap;
        }

        .es-table tbody td {
            padding: 8px 10px;
            border-bottom: 1px solid #f0eaeb;
            vertical-align: middle;
            white-space: nowrap;
        }

        .es-table tbody tr:hover td {
            background: #fcf9f9;
        }

        .es-table tr[hidden] {
            display: none;
        }

        .es-table .text-end {
            text-align: right;
        }

        .es-table .text-center {
            text-align: center;
        }

        .es-table tbody tr.is-selected td {
            background: var(--es-tinto-soft);
        }

            .es-table tbody tr.is-selected td:first-child {
                box-shadow: inset 3px 0 0 var(--es-tinto);
            }

        .es-table tbody tr.sap-error:not(.is-selected) td:first-child {
            box-shadow: inset 3px 0 0 var(--es-bad);
        }

    /* ---------- Tabla principal: una sola vista, SIN scroll horizontal ----------
           Antes medía mínimo 1,120 px y cada celda iba en una sola línea, por eso
           aparecía la barra horizontal. Ahora el ancho se reparte con el <colgroup>
           (porcentajes) y los textos largos usan dos líneas. */
    .es-table-wrap--main {
        max-height: calc(100vh - 380px);
        min-height: 220px;
        overflow-x: hidden;
        overflow-y: auto;
    }

    .es-table--main {
        table-layout: fixed;
    }

        .es-table--main thead th {
            padding: 9px 6px;
            white-space: normal;
            line-height: 1.2;
            vertical-align: bottom;
        }

        .es-table--main tbody td {
            padding: 7px 6px;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .es-table--main .es-td-fecha {
            white-space: normal;
            line-height: 1.25;
        }

            .es-table--main .es-td-fecha .es-muted {
                display: block;
                font-size: 11px;
            }

        .es-table--main .es-col-cliente {
            white-space: normal;
            line-height: 1.25;
            overflow-wrap: anywhere;
            font-weight: 500;
        }
        /* Pedido y remisión: el código completo, partido en los puntos si no cabe en una línea (antes se cortaba con "…") */
        /* Pedido: siempre en una sola línea */
        .es-table--main .es-td-pedido {
            white-space: nowrap;
            letter-spacing: -.01em;
        }

        .es-table--main .es-td-codigo {
            white-space: normal;
            text-overflow: clip;
            line-height: 1.3;
        }

        .es-table--main .es-mono {
            display: inline-block;
            max-width: 100%;
            vertical-align: middle;
            padding: 2px 6px;
            font-size: 12px;
            white-space: normal;
            overflow-wrap: anywhere;
            line-height: 1.3;
        }

        .es-table--main .es-pill {
            height: auto;
            min-height: 22px;
            padding: 2px 8px;
            white-space: normal;
            line-height: 1.2;
            max-width: 100%;
        }

        .es-table--main .es-btn-label {
            display: none;
        }
        /* acciones solo con ícono; el nombre está en el tooltip */
        .es-table--main .es-row-actions {
            flex-wrap: wrap;
            gap: 3px;
        }

            .es-table--main .es-row-actions .es-btn--sm {
                width: 28px;
                padding: 0;
            }

    .es-check {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin: 0;
        cursor: pointer;
    }

        .es-check input, #ckAll {
            width: 15px;
            height: 15px;
            accent-color: var(--es-tinto);
            cursor: pointer;
            margin: 0;
        }

    .es-rownum {
        font-size: 11px;
        color: var(--es-muted);
        font-variant-numeric: tabular-nums;
        min-width: 18px;
    }

    .es-mono {
        font-family: var(--es-mono);
        font-size: 11.5px;
        padding: 2px 6px;
        border-radius: 4px;
        background: #f4f0f1;
        color: var(--es-ink);
    }

    .es-row-actions {
        display: flex;
        justify-content: flex-end;
        gap: 4px;
    }

    .es-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        padding: 40px 10px;
        color: var(--es-muted);
        white-space: normal;
    }

        .es-empty i {
            font-size: 26px;
            color: var(--es-line-strong);
        }

    .es-nomatch {
        padding: 18px 14px;
        color: var(--es-muted);
        text-align: center;
        border-top: 1px solid var(--es-line);
    }

    .es-loading-row td {
        padding: 26px 10px !important;
        text-align: center;
        color: var(--es-muted);
        white-space: normal !important;
    }

    /* ---------- Pastillas de estatus ---------- */
    .es-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        height: 22px;
        padding: 0 9px;
        border-radius: 999px;
        font-size: 11.5px;
        font-weight: 600;
        white-space: nowrap;
        background: var(--es-neutral-bg);
        color: var(--es-neutral);
    }

        .es-pill::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: currentColor;
            flex: none;
        }

    .es-pill--ok, .dev-ok {
        background: var(--es-ok-bg);
        color: var(--es-ok);
    }

    .es-pill--bad, .dev-pending {
        background: var(--es-bad-bg);
        color: var(--es-bad);
    }

    .es-pill--warn, .dev-diff {
        background: var(--es-warn-bg);
        color: var(--es-warn);
    }

    .es-pill--info, .dev-unknown {
        background: var(--es-info-bg);
        color: var(--es-info);
    }

    .es-pill--neutral, .dev-none {
        background: var(--es-neutral-bg);
        color: var(--es-neutral);
    }

    .trz-fecha-hoy {
        display: inline-flex;
        flex-direction: column;
        color: var(--es-bad);
        font-weight: 600;
        line-height: 1.15;
    }

        .trz-fecha-hoy small {
            font-size: 10px;
            font-weight: 500;
        }

    .trz-row-produccion-hoy td {
        background: #fff6f5 !important;
    }

    /* ---------- Bitácora ---------- */
    .es-log__list {
        list-style: none;
        margin: 0;
        padding: 0;
        max-height: 170px;
        overflow: auto;
    }

    .es-log__item {
        display: flex;
        gap: 10px;
        padding: 7px 14px;
        border-bottom: 1px solid #f2eded;
        font-size: 12px;
        border-left: 3px solid var(--lc, var(--es-line-strong));
    }

        .es-log__item:last-child {
            border-bottom: 0;
        }

    .es-log__time {
        flex: none;
        color: var(--es-muted);
        font-variant-numeric: tabular-nums;
    }

    .es-log__msg {
        white-space: pre-wrap;
        word-break: break-word;
    }

    .es-log__item--success {
        --lc: var(--es-ok);
    }

    .es-log__item--warning {
        --lc: #d9a24a;
    }

    .es-log__item--danger {
        --lc: var(--es-bad);
    }

    .es-log__item--info {
        --lc: var(--es-info);
    }

    .es-log__empty {
        padding: 12px 14px;
        color: var(--es-muted);
        font-size: 12px;
    }

    .es-statusbar {
        display: flex;
        gap: 18px;
        flex-wrap: wrap;
        padding: 4px 2px;
        font-size: 11.5px;
        color: var(--es-muted);
    }

        .es-statusbar #esStatusMsg {
            color: var(--es-ink);
            font-weight: 500;
            margin-right: auto;
            max-width: 60%;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

    /* ---------- Permisos: ocultar acciones de escritura hasta confirmarlos ---------- */
    .esap.no-write .js-write {
        display: none !important;
    }

    /* ---------- Modales ---------- */
    .es-modal {
        border: 0;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 18px 50px rgba(35,26,28,.25);
    }

    .es-modal__head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 14px 18px;
        background: var(--es-tinto-deep);
        color: #fff;
    }

    .es-modal__title {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 15px;
        font-weight: 600;
    }

    .es-modal__close {
        width: 30px;
        height: 30px;
        border: 0;
        border-radius: 7px;
        background: rgba(255,255,255,.12);
        color: #fff;
        cursor: pointer;
        display: grid;
        place-items: center;
    }

        .es-modal__close:hover {
            background: rgba(255,255,255,.22);
        }

    .es-modal__body {
        padding: 16px 18px;
        max-height: calc(100vh - 190px);
        overflow: auto;
        background: #fff;
    }

    .es-modal__foot {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        flex-wrap: wrap;
        padding: 12px 18px;
        border-top: 1px solid var(--es-line);
        background: #faf7f7;
    }

    .es-modal .es-table-wrap {
        border: 1px solid var(--es-line);
        border-radius: 8px;
    }

    .es-subtitle {
        display: flex;
        align-items: baseline;
        gap: 8px;
        margin: 18px 0 8px;
        font-size: 14px;
        font-weight: 600;
    }

        .es-subtitle span {
            font-size: 12px;
            font-weight: 400;
            color: var(--es-muted);
        }

    .es-context {
        padding: 9px 12px;
        border-radius: 8px;
        background: #faf7f7;
        border: 1px solid var(--es-line);
        font-size: 12.5px;
        margin-bottom: 12px;
    }

    .es-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
        gap: 8px;
        margin: 10px 0;
    }

    .es-stat {
        padding: 9px 11px;
        border: 1px solid var(--es-line);
        border-radius: 8px;
    }

        .es-stat .label {
            font-size: 11.5px;
            color: var(--es-muted);
            font-weight: 500;
        }

        .es-stat .value {
            font-size: 18px;
            font-weight: 700;
            font-variant-numeric: tabular-nums;
        }

    .es-alert {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 10px 12px;
        border-radius: 8px;
        border: 1px solid;
        font-size: 12.5px;
        margin-bottom: 10px;
    }

        .es-alert > i {
            font-size: 17px;
            line-height: 1.2;
        }

    .es-alert--info {
        background: var(--es-info-bg);
        border-color: #cddcea;
        color: #24496b;
    }

    .es-alert--ok {
        background: var(--es-ok-bg);
        border-color: #bfdccb;
        color: #245e42;
    }

    .es-alert--warn {
        background: var(--es-warn-bg);
        border-color: #ecd3a5;
        color: #7a4f0c;
    }

    .es-alert--bad {
        background: var(--es-bad-bg);
        border-color: #efc4c1;
        color: #8e2222;
    }

    .es-options {
        display: grid;
        gap: 8px;
        margin-bottom: 8px;
    }

    .es-option {
        display: flex;
        gap: 10px;
        align-items: flex-start;
        padding: 10px 12px;
        border: 1px solid var(--es-line-strong);
        border-radius: 8px;
        cursor: pointer;
        margin: 0;
    }

        .es-option:has(input:checked) {
            border-color: var(--es-tinto);
            background: var(--es-tinto-soft);
        }

        .es-option input {
            accent-color: var(--es-tinto);
            margin-top: 3px;
        }

        .es-option strong {
            display: block;
            font-size: 13px;
        }

        .es-option small {
            display: block;
            color: var(--es-muted);
            font-size: 12px;
        }

    .es-note {
        font-size: 12px;
        color: var(--es-muted);
        margin: 0 0 12px;
    }

    .es-counter {
        text-align: right;
        font-size: 11px;
        color: var(--es-muted);
        margin: 3px 0 10px;
    }

    .es-inv-filters {
        display: grid;
        grid-template-columns: 160px 1fr 1fr 170px auto auto;
        gap: 8px;
        align-items: end;
        margin: 6px 0 10px;
    }

    .es-spinner {
        display: inline-block;
        width: 15px;
        height: 15px;
        border: 2px solid var(--es-tinto-line);
        border-top-color: var(--es-tinto);
        border-radius: 50%;
        animation: es-spin .8s linear infinite;
        vertical-align: middle;
        margin-right: 6px;
    }

    .es-spinner--light {
        border-color: rgba(255,255,255,.35);
        border-top-color: #fff;
        margin-right: 0;
    }

    @@keyframes es-spin {
        to {
            transform: rotate(360deg);
        }
    }

    @@keyframes es-pulse {
        50% {
            box-shadow: 0 0 0 5px rgba(47,122,85,.08);
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .es-toggle.is-on .es-dot {
            animation: none;
        }

        .es-status__bar span {
            transition: none;
        }
    }

    /* ---------- Responsive ---------- */
    @@media (max-width: 1280px) {
        .es-filters {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }

        .es-kpis {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }
    /* Solo en pantallas muy angostas (tableta vertical, celular) vuelve el desplazamiento horizontal */
    @@media (max-width: 1000px) {
        .es-table-wrap--main {
            overflow-x: auto;
        }

        .es-table--main {
            min-width: 980px;
        }
    }

    @@media (max-width: 760px) {
        .esap {
            padding: 10px;
        }

        .es-filters, .es-inv-filters {
            grid-template-columns: 1fr 1fr;
        }

        .es-kpis {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .es-search {
            width: 100%;
        }

        .es-statusbar #esStatusMsg {
            max-width: 100%;
        }
    }
</style>

<div class="esap no-write" id="esApp">

    <header class="es-header">
        <div class="es-header__title">
            <span class="es-header__icon"><i class="bi bi-cloud-arrow-up"></i></span>
            <div>
                <h1>Entregas SAP</h1>
                <p>Envío, trazabilidad y conciliación de entregas de SIGO contra SAP Business One</p>
            </div>
        </div>
        <div class="es-chips">
            <span class="es-chip"><i class="bi bi-building"></i> @origenNombre</span>
            <span class="es-chip"><i class="bi bi-calendar3"></i> @periodoSap</span>
            <span class="es-chip"><i class="bi bi-people"></i> @totalClientesSap.ToString("N0") clientes</span>
        </div>
    </header>

    <!-- Filtros de consulta -->
    <section class="es-card">
        <form id="frmFiltros" method="get" class="es-filters">
            <div>
                <label class="es-label" for="fSource">Origen</label>
                <select id="fSource" name="source" class="es-input">
                    <option value="P1" selected="@(source == "P1")">Planta 1</option>
                    <option value="TIF" selected="@(source == "TIF")">Planta TIF</option>
                </select>
            </div>
            <div>
                <label class="es-label" for="fCliente">Cliente</label>
                <input id="fCliente" type="text" class="es-input" name="cliente" value="@cliente" placeholder="Nombre del cliente" />
            </div>
            <div>
                <label class="es-label" for="selEstatus">Mostrar</label>
                <select id="selEstatus" name="estatusSap" class="es-input">
                    <option value="todos" selected="@(estatusSap == "todos")">Todas las entregas</option>
                    <option value="enviados" selected="@(estatusSap == "enviados")">Enviadas a SAP</option>
                    <option value="noenviados" selected="@(estatusSap == "noenviados")">No enviadas</option>
                    <option value="pendientes" selected="@(estatusSap == "pendientes")">Pendientes de envío</option>
                    <option value="fallidas" selected="@(estatusSap == "fallidas")">Fallidas</option>
                    <option value="devrevisar" selected="@(estatusSap == "devrevisar")">Devoluciones por revisar</option>
                </select>
            </div>
            <div>
                <label class="es-label" for="fDesde">Desde</label>
                <input id="fDesde" type="date" class="es-input" name="desde" value="@desde.ToString("yyyy-MM-dd")" />
            </div>
            <div>
                <label class="es-label" for="fHasta">Hasta</label>
                <input id="fHasta" type="date" class="es-input" name="hasta" value="@hasta.ToString("yyyy-MM-dd")" />
            </div>
            <div>
                <button class="es-btn es-btn--primary" type="submit"><i class="bi bi-search"></i> Consultar</button>
            </div>
        </form>
    </section>

    <!-- Estado SAP: barra proporcional + indicadores (clic = filtrar) -->
    <section class="es-card es-status" aria-label="Resumen de entregas">
        <div class="es-status__bar" id="esStatusBar" title="Proporción de entregas por estatus SAP">
            <span class="s-ok" id="barOk" style="width:0"></span>
            <span class="s-none" id="barNone" style="width:0"></span>
            <span class="s-fail" id="barFail" style="width:0"></span>
        </div>
        <div class="es-kpis">
            <button type="button" class="es-kpi es-kpi--total" data-filter="todos">
                <span class="es-kpi__label">Total entregas</span>
                <strong id="kpiSapTotal">@totalEntregasSap.ToString("N0")</strong>
                <small>En la consulta actual</small>
            </button>
            <button type="button" class="es-kpi es-kpi--ok" data-filter="enviados">
                <span class="es-kpi__label">Enviadas a SAP</span>
                <strong id="kpiSapEnviadas">@totalEnviadasSap.ToString("N0")</strong>
                <small id="kpiSapEnviadasPct">Confirmadas por SAP</small>
            </button>
            <button type="button" class="es-kpi es-kpi--none" data-filter="pendientes">
                <span class="es-kpi__label">Pendientes</span>
                <strong id="kpiSapPendientes">@totalPendientesSap.ToString("N0")</strong>
                <small>Sin intento de envío</small>
            </button>
            <button type="button" class="es-kpi es-kpi--fail" data-filter="fallidas">
                <span class="es-kpi__label">Fallidas</span>
                <strong id="kpiSapFallidas">@totalFallidasSap.ToString("N0")</strong>
                <small>Requieren revisión</small>
            </button>
            <div class="es-kpi es-kpi--sel">
                <span class="es-kpi__label">Seleccionadas</span>
                <strong id="kpiSapSeleccionadas">0</strong>
                <small>Para PDF o acciones masivas</small>
            </div>
            <button type="button" class="es-kpi es-kpi--dev" id="kpiSapDevCard" data-filter="devrevisar">
                <span class="es-kpi__label">Devoluciones por revisar</span>
                <strong id="kpiSapDevRevisar">0</strong>
                <small id="kpiSapDevTexto">Validando…</small>
            </button>
        </div>
    </section>

    <!-- Listado -->
    <section class="es-card">
        <div class="es-toolbar">
            <div class="es-toolbar__left">
                <div class="es-search">
                    <i class="bi bi-funnel"></i>
                    <input id="txtBuscarTabla" type="search" class="es-input" placeholder="Filtrar por cliente, solicitud, pedido o remisión" autocomplete="off" />
                </div>
                <span class="es-muted">Mostrando <strong class="es-num" id="esVisibleCount">0 de 0</strong></span>
            </div>
            <div class="es-toolbar__right">
                <button type="button" class="es-btn es-btn--soft" id="btnCartaPorteSeleccionadas" title="Carta porte operativa no fiscal de las remisiones seleccionadas"><i class="bi bi-truck"></i> Carta porte seleccionadas</button>
                <button type="button" class="es-btn es-btn--soft" id="btnPdfSeleccionados"
                        title="Genera un solo PDF con los registros seleccionados del mismo cliente">
                    <i class="bi bi-file-earmark-pdf"></i> PDF de seleccionadas
                    <span class="es-count" id="pdfSelCount" data-zero="1">0</span>
                </button>
                <span class="es-divider"></span>
                <button type="button" class="es-btn es-toggle js-write" id="btnAuto" title="Auto envío: apagado">
                    <span class="es-dot"></span> Auto envío
                </button>
                <button type="button" class="es-btn es-toggle" id="btnAutoDev" title="Validación automática de devoluciones: apagada">
                    <span class="es-dot"></span> Auto devoluciones
                </button>
                <button type="button" class="es-btn" id="btnInventario">
                    <i class="bi bi-box-seam"></i> Conciliar inventario
                </button>
            </div>
        </div>

        <div class="es-table-wrap es-table-wrap--main" id="esMainWrap">
            <table class="es-table es-table--main" id="tblEntregas">
                <colgroup>
                    <col style="width:4%">   @* # / selección *@
                    <col style="width:7%">   @* Fecha *@
                    <col style="width:6%">   @* Solicitud *@
                    <col style="width:20%">  @* Cliente *@
                    <col style="width:17%">  @* Pedido *@
                    <col style="width:15%">  @* Remisión *@
                    <col style="width:8%">   @* SAP *@
                    <col style="width:10%">  @* Devolución *@
                    <col style="width:13%">  @* Acciones *@
                </colgroup>
                <thead>
                    <tr>
                        <th class="es-col-check">
                            <label class="es-check" title="Seleccionar / quitar las visibles">
                                <input type="checkbox" id="ckAll" aria-label="Seleccionar todas las visibles" />
                                <span>#</span>
                            </label>
                        </th>
                        <th>Fecha</th>
                        <th>Solicitud</th>
                        <th>Cliente</th>
                        <th>Pedido</th>
                        <th>Remisión</th>
                        <th>SAP</th>
                        <th>Devolución</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody id="tblEntregasBody">
                    @if (filas.Any())
                    {
                        var n = 0;
                        foreach (var x in filas)
                        {
                            n++;
                            var sapState = x.EnviadoSap == true ? "ok" : (x.EnviadoSap == false ? "fail" : "none");
                            var sapLabel = sapState == "ok" ? "Enviada" : (sapState == "fail" ? "Fallida" : "Pendiente");
                            var sapCls = sapState == "ok" ? "es-pill--ok" : (sapState == "fail" ? "es-pill--bad" : "es-pill--neutral");
                            var fechaEnvio = x.FechaEnvioSap != null ? " (" + x.FechaEnvioSap.Value.ToString("dd/MM/yyyy HH:mm") + ")" : "";
                            var sapTitle = sapState == "ok"
                                ? "Enviado" + fechaEnvio
                                : (sapState == "fail"
                                    ? "Falló" + fechaEnvio + (!string.IsNullOrWhiteSpace(x.MsgSap) ? " - " + x.MsgSap : "")
                                    : "Sin intento");
                            var fechaTxt = x.FechaDocumento?.ToString("dd/MM/yyyy") ?? "-";
                            var horaTxt = x.FechaDocumento?.ToString("HH:mm") ?? "";
                            var clienteTxt = string.IsNullOrWhiteSpace(x.Cliente) ? "-" : x.Cliente;

                            <tr class="@(sapState == "fail" ? "sap-error" : null)"
                                data-ref="@x.ReferenciaDocMeat"
                                data-solicitud="@x.SolicitudSurtidoId"
                                data-cliente="@x.Cliente"
                                data-remision="@x.Remision"
                                data-fecha="@(x.FechaDocumento?.ToString("o") ?? "")"
                                data-sap="@sapState">
                                <td class="es-col-check">
                                    <label class="es-check">
                                        <input type="checkbox" class="ck" value="@x.ReferenciaDocMeat" aria-label="Seleccionar @x.ReferenciaDocMeat" />
                                        <span class="es-rownum">@n</span>
                                    </label>
                                </td>
                                <td title="@fechaTxt @horaTxt" class="es-num es-td-fecha">@fechaTxt <span class="es-muted">@horaTxt</span></td>
                                <td class="es-num">@x.SolicitudSurtidoId</td>
                                <td class="es-col-cliente" title="@clienteTxt">@clienteTxt</td>
                                <td class="es-num es-td-pedido" title="@x.Remision">@x.Remision</td>
                                <td class="es-td-codigo" title="@x.ReferenciaDocMeat"><code class="es-mono">@Html.Raw(System.Net.WebUtility.HtmlEncode(x.ReferenciaDocMeat ?? "").Replace(".", ".<wbr>"))</code></td>
                                <td><span class="es-pill js-est @sapCls" title="@sapTitle">@sapLabel</span></td>
                                <td><span class="es-pill dev-est js-dev-est dev-unknown" title="Devolución sin validar">Sin validar</span></td>
                                <td>
                                    <div class="es-row-actions">
                                        <a class="es-btn es-btn--sm" target="_blank" rel="noopener"
                                           href="@Url.Action("EntregaJson", "ProcesosCG", new { referencia = x.ReferenciaDocMeat, source = source })"
                                           title="Ver JSON de la entrega" aria-label="Ver JSON de la entrega">
                                            <i class="bi bi-filetype-json"></i><span class="es-btn-label">JSON</span>
                                        </a>
                                        <button type="button" class="es-btn es-btn--sm js-write js-traza" data-action="traza" title="Validar trazabilidad y devoluciones" aria-label="Validar trazabilidad y devoluciones">
                                            <i class="bi bi-diagram-3"></i><span class="es-btn-label">Trazabilidad</span>
                                        </button>
                                        <button type="button" class="es-btn es-btn--sm" data-action="carta-porte" title="Carta porte operativa (no fiscal)" aria-label="Carta porte operativa"><i class="bi bi-truck"></i><span class="es-btn-label">Carta porte</span></button>
                                        <button type="button" class="es-btn es-btn--sm" data-action="pdf" title="Generar PDF" aria-label="Generar PDF">
                                            <i class="bi bi-file-earmark-pdf"></i><span class="es-btn-label">PDF</span>
                                        </button>
                                        <button type="button" class="es-btn es-btn--sm es-btn--primary js-write js-send-one" data-action="send" title="Enviar entrega a SAP" aria-label="Enviar entrega a SAP">
                                            <i class="bi bi-send"></i><span class="es-btn-label">Enviar</span>
                                        </button>
                                        @* Reserva deshabilitada en la versión anterior. Para reactivarla, agrega aquí botones con
                                           data-action="reserva-entrega" y data-action="reserva-manual" y la clase js-write js-reserve. *@
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9">
                                <div class="es-empty">
                                    <i class="bi bi-inbox"></i>
                                    <div>No hay entregas para estos filtros. Ajusta el periodo o el cliente y consulta de nuevo.</div>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="es-nomatch" id="esNoMatch" hidden>Ninguna entrega coincide con el filtro. Cambia la vista o limpia la búsqueda.</div>
    </section>

    <!-- Bitácora -->
    <section class="es-card" id="logBox">
        <div class="es-card__head">
            <span><i class="bi bi-journal-text"></i>Actividad de la sesión</span>
            <button type="button" class="es-btn es-btn--ghost es-btn--sm" id="btnLimpiarLog">Limpiar</button>
        </div>
        <ul class="es-log__list" id="esLogList">
            <li class="es-log__empty">Sin actividad todavía.</li>
        </ul>
    </section>

    <footer class="es-statusbar">
        <span id="esStatusMsg">Registro listo</span>
        <span>Usuario: @(User?.Identity?.Name ?? "")</span>
        <span>Carnes G SA de CV</span>
        <span>Módulo: Entregas SAP</span>
    </footer>
</div>

<!-- ===================== MODAL: PDF ===================== -->
<div class="modal fade" id="pdfComentariosModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width:560px;">
        <div class="modal-content es-modal">
            <div class="es-modal__head">
                <div class="es-modal__title"><i class="bi bi-file-earmark-pdf"></i> Generar PDF</div>
                <button type="button" class="es-modal__close" data-bs-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="es-modal__body">
                <div class="es-context">
                    Solicitud: <strong id="pdfSolicitudLabel">-</strong><br />
                    Remisión / JSON: <strong id="pdfReferenciaLabel">-</strong>
                </div>

                <span class="es-label">Origen de los datos</span>
                <div class="es-options">
                    <label class="es-option" for="pdfOrigenRemision">
                        <input type="radio" id="pdfOrigenRemision" name="pdfOrigenDatos" value="remision" checked />
                        <span>
                            <strong>Remisión / surtido real</strong>
                            <small>Usa lo que realmente se cargó y viene en el Meat de la entrega.</small>
                        </span>
                    </label>
                    <label class="es-option" for="pdfOrigenOrden">
                        <input type="radio" id="pdfOrigenOrden" name="pdfOrigenDatos" value="orden" />
                        <span>
                            <strong>Orden de venta / pedido</strong>
                            <small>Usa los datos originales de la solicitud que genera el pedido.</small>
                        </span>
                    </label>
                </div>
                <p class="es-note" id="pdfOrigenNota"></p>

                <label class="es-label" for="pdfComentarios">Comentarios (opcional)</label>
                <textarea id="pdfComentarios" class="es-input es-textarea" maxlength="1000" rows="4"
                          placeholder="Se incluirán en la sección de comentarios del PDF"></textarea>
                <div class="es-counter" id="pdfComentariosCount">0/1000</div>

                <div class="es-alert es-alert--info">
                    <i class="bi bi-info-circle"></i>
                    <div>Si lo dejas vacío, el PDF muestra el comentario registrado en el sistema, si existe.</div>
                </div>

                <div id="pdfBatchProgress" class="es-alert es-alert--info" hidden>
                    <span class="es-spinner"></span><span id="pdfBatchProgressText">Preparando PDF…</span>
                </div>
            </div>
            <div class="es-modal__foot">
                <button type="button" class="es-btn" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="es-btn es-btn--primary" id="btnPdfGenerar">
                    <i class="bi bi-file-earmark-pdf"></i> Generar PDF
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ===================== MODAL: TRAZABILIDAD ===================== -->
<div class="modal fade" id="trazabilidadModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content es-modal">
            <div class="es-modal__head">
                <div class="es-modal__title"><i class="bi bi-diagram-3"></i> Trazabilidad y devoluciones</div>
                <button type="button" class="es-modal__close" data-bs-dismiss="modal" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="es-modal__body">
                <div class="es-alert es-alert--info" id="trzAlertBox">
                    <i id="trzAlertIcon" class="bi bi-hourglass-split"></i>
                    <div>
                        <strong id="trzAlertTitle">Validación de trazabilidad y devoluciones.</strong><br />
                        <span id="trzAlertText">Revisa los lotes, kilos solicitados, disponibilidad en SAP y devoluciones aplicadas.</span>
                    </div>
                </div>

                <div class="es-context">Entrega / referencia: <strong id="trzRef">-</strong></div>

