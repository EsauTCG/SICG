                                    <select id="invEstatus" class="form-select">
                                        <option value="">Todos</option>
                                        <option value="OK">OK</option>
                                        <option value="DIFERENCIA KG">DIFERENCIA KG</option>
                                        <option value="FALTA SAP">FALTA SAP</option>
                                        <option value="FALTA LOCAL">FALTA MEAT</option>
                                    </select>
                                </div>

                                <div class="filter-group">
                                    <label>&nbsp;</label>
                                    <button class="pm-btn pm-btn-primary" type="button" onclick="cargarInventarioModal()">
                                        🔎 Validar
                                    </button>
                                </div>

                                <div class="filter-group">
                                    <label>&nbsp;</label>
                                    <button class="pm-btn pm-btn-success" type="button" onclick="descargarInventarioExcel()">
                                        📥 Excel
                                    </button>
                                </div>

                            </div>

                            <div class="trz-table-wrap" style="max-height:460px;">
                                <table class="trz-table" style="min-width:1180px;">
                                    <thead>
                                        <tr>
                                            <th>Almacén</th>
                                            <th>Artículo</th>
                                            <th>Descripción SAP</th>
                                            <th>Lote</th>
                                            <th>Fecha producción</th>
                                            <th class="text-end">Kg Meat</th>
                                            <th class="text-end">Cantidad SAP</th>
                                            <th class="text-end">Comprometido</th>
                                            <th class="text-end">Disponible</th>
                                            <th class="text-end">Dif.</th>
                                            <th>Estatus</th>
                                        </tr>
                                    </thead>
                                    <tbody id="inventarioBody">
                                        <tr>
                                            <td colspan="11" class="text-center">Sin información.</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                        </div>

                        <div class="trz-footer">
                            <button type="button"
                                    class="trz-btn-close"
                                    data-bs-dismiss="modal">
                                Cerrar
                            </button>
                        </div>

                    </div>
                </div>
            </div>


            <div class="modal fade" id="loadingModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
                <div class="modal-dialog modal-dialog-centered" style="max-width:360px;">
                    <div class="modal-content trz-modal">
                        <div class="trz-body" style="text-align:center; padding:32px 20px;">
                            <div class="pm-spinner"></div>
                            <div class="loading-text" id="loadingModalText">
                                Cargando información...
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal Reserva Manual -->
            <div class="modal fade" id="reserveKgModal" tabindex="-1">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">Factura de Reserva Manual</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <p style="font-size:12px; color:#6a3a3a; margin-bottom:8px;">Captura los KG por ItemCode.</p>
                            <div class="table-responsive">
                                <table>
                                    <thead>
                                        <tr>
                                            <th>ItemCode</th>
                                            <th class="text-end">KG</th>
                                        </tr>
                                    </thead>
                                    <tbody id="reserveLinesBody"></tbody>
                                </table>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button class="pm-btn pm-btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button class="pm-btn pm-btn-warning" onclick="sendReserveKg()">Enviar Reserva</button>
                        </div>
                    </div>
                </div>
            </div>

            <script>
                            const SOURCE = '@source';
                            const TODAY_ISO = '@DateTime.Today.ToString("yyyy-MM-dd")';
                            const RESERVE_AFTER_MINUTES = 20;
                            let trazabilidadRequestSeq = 0;

                            let trazabilidadActualRef = '';
                            let trazabilidadActualDetalle = [];
                            let trazabilidadActualDevolucionesOk = false;
                            let autocompletarSapBusy = false;
                            let permisosAutocompletarSap = {
                                puedeLeer: false,
                                puedeEscribir: false,
                                puedeEliminar: false
                            };

                            // =========================================================
                            // AJUSTE TEMPORAL DE ENVÍO SAP
                            // =========================================================
                            // false = permite enviar la entrega a SAP sin validar primero trazabilidad/devoluciones.
                            // true  = obliga a validar trazabilidad/devoluciones antes de enviar.
                            // Cuando ya tengas estable la comunicación con SAP/trazabilidad, cámbialo a true.
                            const VALIDAR_TRAZABILIDAD_ANTES_DE_ENVIAR = false;

                            // Evita doble clic / envíos simultáneos en botones individuales, masivos y auto.
                            let isSending = false;

                            async function validarPrevioEnvioSap(ref) {
                                if (!ref) {
                                    showLog('warning', 'Referencia vacía. No se puede enviar a SAP.');
                                    return false;
                                }

                                if (!VALIDAR_TRAZABILIDAD_ANTES_DE_ENVIAR) {
                                    showLog('warning', 'Modo prueba: se omitió validación previa de trazabilidad/devoluciones para ' + ref + '.');
                                    return true;
                                }

                                try {
                                    return await validarTrazabilidad(ref, false);
                                } catch (e) {
                                    showLog('danger', 'No se pudo validar trazabilidad/devoluciones para ' + ref + ': ' + (e?.message || e));
                                    return false;
                                }
                            }

                            function setSendButtonsDisabled(disabled) {
                                document.querySelectorAll('.btn-enviar, .js-send-one, #btnAuto, #btnAutocompletarSap, #btnVerJsonAutocompletarSap')
                                    .forEach(btn => {
                                        if (!btn) return;
                                        btn.disabled = !!disabled;
                                        btn.style.opacity = disabled ? '.65' : '';
                                        btn.style.pointerEvents = disabled ? 'none' : '';
                                    });
                            }

                            async function postEnviarEntregaSap(ref) {
                                const res = await fetch('@Url.Action("EnviarEntrega", "ProcesosCG")', {
                                    method: 'POST',
                                    credentials: 'same-origin',
                                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                                    body: 'referencia=' + encodeURIComponent(ref) + '&source=' + encodeURIComponent(SOURCE)
                                });

                                const data = await readResponse(res);
                                return { res, data };
                            }

                            function showLog(type, text) {
                                const box = document.getElementById('logBox');
                                const log = document.getElementById('log');
                                box.style.display = 'block';
                                log.className = 'log-inner log-' + (type || 'secondary');
                                log.textContent = text || '';
                            }

                            function selectAll(on) {
                                document
                                    .querySelectorAll('.ck')
                                    .forEach(x => {
                                        x.checked = !!on;
                                    });

                                if (typeof actualizarKpisEntregasSap === 'function') {
                                    actualizarKpisEntregasSap();
                                }

                                actualizarCheckboxTodos();
                            }

                            function actualizarCheckboxTodos() {
                                const all = document.getElementById('ckAll');
                                if (!all) return;

                                const checks =
                                    Array.from(
                                        document.querySelectorAll('.ck')
                                    );

                                const marcados =
                                    checks.filter(x => x.checked).length;

                                all.checked =
                                    checks.length > 0 &&
                                    marcados === checks.length;

                                all.indeterminate =
                                    marcados > 0 &&
                                    marcados < checks.length;
                            }

                            function buildMsg(data, fallback) {
                                if (!data) return fallback || '';
                                let msg = data.msg || fallback || '';
                                const extras = [];
                                if (data.referencia) extras.push('Ref: ' + data.referencia);
                                if (data.docNum)     extras.push('DocNum: ' + data.docNum);
                                if (data.docEntry)   extras.push('DocEntry: ' + data.docEntry);
                                if (extras.length)   msg += ' (' + extras.join(' | ') + ')';
                                return msg;
                            }

                          async function readResponse(res) {
                        const ct = (res.headers.get('content-type') || '').toLowerCase();
                        const t = await res.text();

                        if (ct.includes('application/json')) {
                            try {
                                return JSON.parse(t);
                            } catch (e) {
                                return {
                                    ok: false,
                                    msg: 'La respuesta dice ser JSON, pero no se pudo leer.',
                                    detalle: t
                                };
                            }
                        }

                        try {
                            return JSON.parse(t);
                        } catch {
                            return {
                                ok: false,
                                msg: ct.includes('text/html')
                                    ? 'El servidor regresó HTML en lugar de JSON. Posible sesión vencida, error MVC o redirección a login.'
                                    : 'El servidor no regresó JSON.',
                                detalle: t.substring(0, 500)
                            };
                        }
                    }

                            function getStatusSymbolFromRow(row) {
                                const est = row?.querySelector('.js-est');
                                return (est?.textContent || '').trim();
                            }

                            function parseRowDateIso(row) {
                                const iso = row?.getAttribute('data-fecha');
                                if (!iso) return null;
                                const d = new Date(iso);
                                return isNaN(d.getTime()) ? null : d;
                            }

                            function isReserveCandidateStatus(sym) {
                                return sym === '—' || sym === '❌' || sym === '';
                            }

                            function canEnableReserve(row) {
                                const sym = getStatusSymbolFromRow(row);
                                if (!isReserveCandidateStatus(sym)) return false;
                                const d = parseRowDateIso(row);
                                if (!d) return false;
                                return (Date.now() - d.getTime()) / 60000 >= RESERVE_AFTER_MINUTES;
                            }

                            function updateReserveButtons() {
                                document.querySelectorAll('tr[data-ref]').forEach(row => {
                                    const btn = row.querySelector('.js-reserve');
                                    if (!btn) return;
                                    const enabled = canEnableReserve(row);
                                    if (enabled) {
                            btn.style.opacity = '';
                            btn.style.pointerEvents = '';
                            btn.removeAttribute('aria-disabled');
                        } else {
                            btn.style.opacity = '.5';
                            btn.style.pointerEvents = 'none';
                            btn.setAttribute('aria-disabled', 'true');
                        }
                                    if (enabled) {
                                        btn.title = 'Generar y enviar Factura de Reserva';
                                    } else {
                                        const d = parseRowDateIso(row);
                                        if (!d) { btn.title = 'Sin fecha'; return; }
                                        const minutes = (Date.now() - d.getTime()) / 60000;
                                        const faltan = Math.ceil(RESERVE_AFTER_MINUTES - minutes);
                                        const sym = getStatusSymbolFromRow(row);
                                        btn.title = !isReserveCandidateStatus(sym)
                                            ? 'No disponible: entrega ya enviada'
                                            : (faltan > 0 ? `Disponible en ~${faltan} min` : 'No disponible');
                                    }
                                });
                            }

                            function setRowStatus(ref, ok, msg) {
                                const row = document.querySelector(`tr[data-ref="${CSS.escape(ref)}"]`);
                                if (!row) return;

                                    row.classList.toggle('sap-error', ok === false);
                                row.querySelectorAll('.js-est').forEach(est => {
                                    if (ok === true)       { est.textContent = '✅'; est.title = msg || 'Enviado'; }
                                    else if (ok === false) { est.textContent = '❌'; est.title = msg || 'Falló'; }
                                    else                   { est.textContent = '—';  est.title = msg || 'Sin intento'; }
                                });
                                updateReserveButtons();
                            }

                        function escapeHtml(value) {
                            return String(value ?? '')
                                .replaceAll('&', '&amp;')
                                .replaceAll('<', '&lt;')
                                .replaceAll('>', '&gt;')
                                .replaceAll('"', '&quot;')
                                .replaceAll("'", '&#039;');
                        }

                        function toNumber(value) {
                            const n = Number(value);
                            return isNaN(n) ? 0 : n;
                        }

                        function formatKg(value) {
                            const n = toNumber(value);
                            return n.toLocaleString('es-MX', {
                                minimumFractionDigits: 2,
                                maximumFractionDigits: 2
                            });
                        }

                        function getFechaProduccion(obj) {
                            return getPropValue(obj, 'fechaProduccion', 'FechaProduccion', null)
                                ?? getPropValue(obj, 'fechaProduccionLote', 'FechaProduccionLote', null)
                                ?? getPropValue(obj, 'productionDate', 'ProductionDate', null);
                        }

                        function formatFecha(value) {
                            if (value === undefined || value === null || String(value).trim() === '') {
                                return '-';
                            }

                            const raw = String(value).trim();

                            // ISO: 2026-07-07 o 2026-07-07T10:30:00
                            const iso = raw.match(/^(\d{4})-(\d{2})-(\d{2})/);
                            if (iso) {
                                return `${iso[3]}/${iso[2]}/${iso[1]}`;
                            }

                            // Formato antiguo de ASP.NET: /Date(1783396800000)/
                            const aspNet = raw.match(/\/Date\(([-+]?\d+)/);
                            if (aspNet) {
                                const fechaAsp = new Date(Number(aspNet[1]));
                                if (!Number.isNaN(fechaAsp.getTime())) {
                                    return fechaAsp.toLocaleDateString('es-MX');
                                }
                            }

                            const fecha = new Date(raw);
                            return Number.isNaN(fecha.getTime())
                                ? raw
                                : fecha.toLocaleDateString('es-MX');
                        }


                        function getFechaIsoKey(value) {
                            if (value === undefined || value === null || String(value).trim() === '') {
                                return '';
                            }

                            const raw = String(value).trim();
                            const iso = raw.match(/^(\d{4})-(\d{2})-(\d{2})/);

                            if (iso) {
                                return `${iso[1]}-${iso[2]}-${iso[3]}`;
                            }

                            const aspNet = raw.match(/\/Date\(([-+]?\d+)/);

                            if (aspNet) {
                                const d = new Date(Number(aspNet[1]));

                                if (!Number.isNaN(d.getTime())) {
                                    return [
                                        d.getFullYear(),
                                        String(d.getMonth() + 1).padStart(2, '0'),
                                        String(d.getDate()).padStart(2, '0')
                                    ].join('-');
                                }
                            }

                            const d = new Date(raw);

                            if (Number.isNaN(d.getTime())) {
                                return '';
                            }

                            return [
                                d.getFullYear(),
                                String(d.getMonth() + 1).padStart(2, '0'),
                                String(d.getDate()).padStart(2, '0')
                            ].join('-');
                        }

                        function esProduccionHoy(obj) {
                            const flag = getPropValue(
                                obj,
                                'esProduccionHoy',
                                'EsProduccionHoy',
                                null
                            );

                            if (flag === true || String(flag).toLowerCase() === 'true') {
                                return true;
                            }

                            return getFechaIsoKey(getFechaProduccion(obj)) === TODAY_ISO;
                        }

                        function htmlFechaProduccion(obj) {
                            const texto = formatFecha(getFechaProduccion(obj));

                            if (texto === '-') {
                                return '<span class="trz-fecha-normal">-</span>';
                            }

                            if (esProduccionHoy(obj)) {
                                return `
                                    <span class="trz-fecha-hoy"
                                          title="Este lote corresponde a producción de hoy">
                                        🔴 ${escapeHtml(texto)}
                                        <small>Producción de hoy</small>
                                    </span>`;
                            }

                            return `<span class="trz-fecha-normal">${escapeHtml(texto)}</span>`;
                        }


                        function getArrayProp(obj, camelName, pascalName) {
                            const v = obj?.[camelName];
                            if (Array.isArray(v)) return v;

                            const p = obj?.[pascalName];
                            if (Array.isArray(p)) return p;

                            return [];
                        }

                        function getPropValue(obj, camelName, pascalName, fallback = '') {
                            if (obj && obj[camelName] !== undefined && obj[camelName] !== null) return obj[camelName];
                            if (obj && obj[pascalName] !== undefined && obj[pascalName] !== null) return obj[pascalName];
                            return fallback;
                        }

                        function getDevResumenFromData(data) {
                            const devoluciones = getArrayProp(data, 'devoluciones', 'Devoluciones');
                            const devolucionError = getPropValue(data, 'devolucionError', 'DevolucionError', '');

                            if (devoluciones.length === 0) {
                                if (devolucionError) {
                                    return {
                                        cls: 'dev-diff',
                                        icon: '⚠️',
                                        title: 'Error al consultar devoluciones: ' + devolucionError,
                                        texto: 'Error'
                                    };
                                }

                                return {
                                    cls: 'dev-none',
                                    icon: '—',
                                    title: 'Sin devolución Meat para comparar',
                                    texto: 'Sin devolución'
                                };
                            }

                            const estatus = devoluciones.map(x =>
                                String(getPropValue(x, 'estatus', 'Estatus', '')).toUpperCase()
                            ).join('|');

                            const totalKgMeat = devoluciones.reduce((s, x) =>
                                s + toNumber(getPropValue(x, 'kgDevueltosMeat', 'KgDevueltosMeat', 0)), 0);

                            const totalKgSap = devoluciones.reduce((s, x) =>
                                s + toNumber(getPropValue(x, 'kgDevueltosSap', 'KgDevueltosSap', 0)), 0);

                            const totalDif = devoluciones.reduce((s, x) =>
                                s + toNumber(getPropValue(x, 'diferenciaKg', 'DiferenciaKg', 0)), 0);

                            const titleBase = `Meat: ${formatKg(totalKgMeat)} kg | SAP: ${formatKg(totalKgSap)} kg | Dif: ${formatKg(totalDif)} kg`;

                            if (estatus.includes('PENDIENTE')) {
                                return {
                                    cls: 'dev-pending',
                                    icon: '❌',
                                    title: 'Devolución pendiente en SAP. ' + titleBase,
                                    texto: 'Pendiente'
                                };
                            }

                            if (estatus.includes('DIFERENCIA') || estatus.includes('FALTA') || estatus.includes('SOBRANTE')) {
                                return {
                                    cls: 'dev-diff',
                                    icon: '⚠️',
                                    title: 'Devolución con diferencia. ' + titleBase,
                                    texto: 'Diferencia'
                                };
                            }

                            if (estatus.includes('APLICADA')) {
                                return {
                                    cls: 'dev-ok',
                                    icon: '✅',
                                    title: 'Devolución aplicada en SAP. ' + titleBase,
                                    texto: 'Aplicada'
                                };
                            }

                            return {
                                cls: 'dev-diff',
                                icon: '⚠️',
                                title: 'Devolución requiere revisión. ' + titleBase,
                                texto: 'Revisar'
                            };
                        }

                        function actualizarEstatusDevolucionFila(ref, data) {
                            const row = document.querySelector(`tr[data-ref="${CSS.escape(ref)}"]`);
                            if (!row) return;

                            const info = getDevResumenFromData(data);

                            row.querySelectorAll('.js-dev-est').forEach(el => {
                                el.className = 'dev-est js-dev-est ' + info.cls;
                                el.textContent = info.icon;
                                el.title = info.title;
                                el.setAttribute('data-dev-status', info.texto);
                            });
                        }

                        async function validarDevolucionFila(ref) {
                            try {
                                const res = await fetch('@Url.Action("ValidarDevolucionesEntrega", "ProcesosCG")'
                                    + '?referencia=' + encodeURIComponent(ref)
                                    + '&source=' + encodeURIComponent(SOURCE), {
                                    credentials: 'same-origin'
                                });

                                const data = await readResponse(res);
                                actualizarEstatusDevolucionFila(ref, data);
                                return data;
                            } catch (e) {
                                const row = document.querySelector(`tr[data-ref="${CSS.escape(ref)}"]`);
                                if (row) {
                                    row.querySelectorAll('.js-dev-est').forEach(el => {
                                        el.className = 'dev-est js-dev-est dev-diff';
                                        el.textContent = '⚠️';
                                        el.title = 'Error al validar devolución: ' + (e?.message || e);
                                        el.setAttribute('data-dev-status', 'Error');
                                    });
                                }
                                return null;
                            }
                        }

                        async function validarDevolucionesVisibles() {
                            const refs = Array.from(document.querySelectorAll('tr[data-ref]'))
                                .map(row => row.getAttribute('data-ref'))
                                .filter(Boolean);

                            if (!refs.length) {
                                showLog('warning', 'No hay entregas visibles para validar.');
                                return;
                            }

                            showLog('info', `Validando devoluciones de ${refs.length} entregas visibles...`);

                            for (const ref of refs) {
                                const row = document.querySelector(`tr[data-ref="${CSS.escape(ref)}"]`);
                                if (row) {
                                    row.querySelectorAll('.js-dev-est').forEach(el => {
                                        el.className = 'dev-est js-dev-est dev-unknown';
                                        el.textContent = '⏳';
                                        el.title = 'Validando devolución...';
                                    });
                                }

                                await validarDevolucionFila(ref);
                                await new Promise(resolve => setTimeout(resolve, 80));
                            }

                            showLog('success', 'Validación de devoluciones visibles terminada.');
                        }


                        function badgeInfo(estatus) {
                            const e = String(estatus || '').toUpperCase();

                            if (e.includes('APLICADA') ||
                                e.includes('OK EXACTO') ||
                                e.includes('OK CON SOBRANTE')) {
                                return { cls: 'trz-badge-success', icon: '✅' };
                            }

                            if (e.includes('PENDIENTE') ||
                                e.includes('DIFERENCIA') ||
                                e.includes('FALTA') ||
                                e.includes('NO EXISTE') ||
                                e.includes('SIN DISPONIBLE') ||
                                e.includes('SOBRANTE SAP')) {
                                return { cls: 'trz-badge-danger', icon: '⛔' };
                            }

                            return { cls: 'trz-badge-warning', icon: '⚠️' };
                        }

                        function prepararModalTrazabilidad(ref) {
                            trazabilidadActualRef = ref || '';
                            trazabilidadActualDetalle = [];
                            trazabilidadActualDevolucionesOk = false;
                            actualizarBotonAutocompletarSap();

                            document.getElementById('trzRef').textContent = ref || '-';

                            document.getElementById('trzTotalPartidas').textContent = '…';
                            document.getElementById('trzKgSolicitados').textContent = '…';
                            document.getElementById('trzKgFaltantes').textContent = '…';

                            document.getElementById('devTotalPartidas').textContent = '…';
                            document.getElementById('devKgMeat').textContent = '…';
                            document.getElementById('devKgSap').textContent = '…';
                            document.getElementById('devKgDif').textContent = '…';
                            document.getElementById('devTotalAplicadas').textContent = '…';
                            document.getElementById('devTotalPendientes').textContent = '…';

                            document.getElementById('trzAlertIcon').textContent = '⏳';
                            document.getElementById('trzAlertTitle').textContent =
                                'Abriendo detalle de trazabilidad…';
                            document.getElementById('trzAlertText').textContent =
                                'Primero se cargarán los lotes y después las devoluciones, sin bloquear el modal.';

                            document.getElementById('trzDetalleBody').innerHTML = `
                                <tr>
                                    <td colspan="8" class="loading-row">
                                        <div class="trz-carga-progresiva">
                                            <span class="trz-mini-spinner"></span>
                                            Consultando lotes, fechas de producción y disponibilidad SAP…
                                        </div>
                                    </td>
                                </tr>`;

                            document.getElementById('devDetalleBody').innerHTML = `
                                <tr>
                                    <td colspan="9" class="loading-row">
                                        <div class="trz-carga-progresiva">
                                            <span class="trz-mini-spinner"></span>
                                            Las devoluciones se cargarán en segundo plano…
                                        </div>
                                    </td>
                                </tr>`;

                            bootstrap.Modal.getOrCreateInstance(
                                document.getElementById('trazabilidadModal')
                            ).show();
                        }

                        function renderizarTrazabilidadRapida(ref, data) {
                            const detalle = getArrayProp(data, 'detalle', 'Detalle');

                            const totalKgSolicitados = detalle.reduce(
                                (sum, x) => sum + toNumber(
                                    getPropValue(x, 'kgSolicitadosJson', 'KgSolicitadosJson', 0)
                                ),
                                0
                            );

                            const totalKgFaltantes = detalle.reduce(
                                (sum, x) => sum + toNumber(
                                    getPropValue(x, 'kgFaltantes', 'KgFaltantes', 0)
                                ),
                                0
                            );

                            const hayErrorTrazabilidad = detalle.some(x => {
                                const e = String(
                                    getPropValue(x, 'estatus', 'Estatus', '')
                                ).toUpperCase();

                                return e.includes('NO EXISTE') ||
                                       e.includes('SIN DISPONIBLE') ||
                                       e.includes('FALTAN KG') ||
                                       e.includes('JSON SIN LOTES') ||
                                       e.includes('JSON VACÍO');
                            });

                            document.getElementById('trzRef').textContent = ref || '-';
                            document.getElementById('trzTotalPartidas').textContent = detalle.length;
                            document.getElementById('trzKgSolicitados').textContent =
                                formatKg(totalKgSolicitados);
                            document.getElementById('trzKgFaltantes').textContent =
                                formatKg(totalKgFaltantes);

                            const body = document.getElementById('trzDetalleBody');

                            if (!detalle.length) {
                                body.innerHTML = `
                                    <tr>
                                        <td colspan="8" class="text-center">
                                            No se recibió detalle de trazabilidad.
                                        </td>
                                    </tr>`;
                            } else {
                                body.innerHTML = detalle.map(x => {
                                    const estatus = getPropValue(
                                        x,
                                        'estatus',
                                        'Estatus',
                                        ''
                                    );

                                    const b = badgeInfo(estatus);
                                    const hoy = esProduccionHoy(x);

                                    return `
                                        <tr class="${hoy ? 'trz-row-produccion-hoy' : ''}">
                                            <td>${escapeHtml(getPropValue(x, 'articulo', 'Articulo', ''))}</td>
                                            <td>${escapeHtml(getPropValue(x, 'almacen', 'Almacen', ''))}</td>
                                            <td>${escapeHtml(getPropValue(x, 'lote', 'Lote', ''))}</td>
                                            <td>${htmlFechaProduccion(x)}</td>
                                            <td class="text-end">${formatKg(getPropValue(x, 'kgSolicitadosJson', 'KgSolicitadosJson', 0))}</td>
                                            <td class="text-end">${formatKg(getPropValue(x, 'disponibleSap', 'DisponibleSap', 0))}</td>
                                            <td class="text-end">${formatKg(getPropValue(x, 'kgFaltantes', 'KgFaltantes', 0))}</td>
                                            <td>
                                                <span class="${b.cls}">
                                                    ${b.icon}
                                                    ${escapeHtml(estatus)}
                                                </span>
                                            </td>
                                        </tr>`;
                                }).join('');
                            }

                            const alertIcon = document.getElementById('trzAlertIcon');
                            const alertTitle = document.getElementById('trzAlertTitle');
                            const alertText = document.getElementById('trzAlertText');

                            if (hayErrorTrazabilidad) {
                                alertIcon.textContent = '⚠️';
                                alertTitle.textContent =
                                    'Se encontraron diferencias de trazabilidad.';
                                alertText.textContent =
                                    'Los lotes ya están visibles. Las devoluciones continúan cargándose en segundo plano.';
                            } else {
                                alertIcon.textContent = '✅';
                                alertTitle.textContent =
                                    'Trazabilidad cargada correctamente.';
                                alertText.textContent =
                                    'Los lotes están disponibles. Consultando devoluciones Meat vs SAP…';
                            }

                            trazabilidadActualRef = ref || '';
                            trazabilidadActualDetalle = detalle;
                            actualizarBotonAutocompletarSap();

                            return {
                                ok: !hayErrorTrazabilidad,
                                hayError: hayErrorTrazabilidad,
                                detalle
                            };
                        }

                        function renderizarErrorTrazabilidad(error) {
                            trazabilidadActualDetalle = [];
                            trazabilidadActualDevolucionesOk = false;
                            actualizarBotonAutocompletarSap();

                            document.getElementById('trzTotalPartidas').textContent = '0';
                            document.getElementById('trzKgSolicitados').textContent = '0.00';
                            document.getElementById('trzKgFaltantes').textContent = '0.00';

                            document.getElementById('trzDetalleBody').innerHTML = `
                                <tr>
                                    <td colspan="8" class="text-center">
                                        <b>No se pudo cargar la trazabilidad.</b><br>
                                        ${escapeHtml(error?.message || error || 'Error desconocido')}
                                    </td>
                                </tr>`;

                            document.getElementById('trzAlertIcon').textContent = '⛔';
                            document.getElementById('trzAlertTitle').textContent =
                                'Error al consultar trazabilidad.';
                            document.getElementById('trzAlertText').textContent =
                                'Las devoluciones pueden continuar cargándose, pero la entrega requiere revisión.';

                            return {
                                ok: false,
                                hayError: true,
                                detalle: []
                            };
                        }

                        function renderizarDevolucionesTrazabilidad(data, estadoTraza) {
                            const devoluciones = getArrayProp(
                                data,
                                'devoluciones',
                                'Devoluciones'
                            );

                            const devolucionError = getPropValue(
                                data,
                                'devolucionError',
                                'DevolucionError',
                                ''
                            );

                            const totalKgMeat = devoluciones.reduce(
                                (sum, x) => sum + toNumber(
                                    getPropValue(x, 'kgDevueltosMeat', 'KgDevueltosMeat', 0)
                                ),
                                0
                            );

                            const totalKgSap = devoluciones.reduce(
                                (sum, x) => sum + toNumber(
                                    getPropValue(x, 'kgDevueltosSap', 'KgDevueltosSap', 0)
                                ),
                                0
                            );

                            const totalKgDif = devoluciones.reduce(
                                (sum, x) => sum + toNumber(
                                    getPropValue(x, 'diferenciaKg', 'DiferenciaKg', 0)
                                ),
                                0
                            );

                            const devAplicadas = devoluciones.filter(x =>
                                String(
                                    getPropValue(x, 'estatus', 'Estatus', '')
                                ).toUpperCase().includes('APLICADA')
                            ).length;

                            const devPendientes = devoluciones.filter(x => {
                                const e = String(
                                    getPropValue(x, 'estatus', 'Estatus', '')
                                ).toUpperCase();

                                return e.includes('PENDIENTE') ||
                                       e.includes('DIFERENCIA') ||
                                       e.includes('FALTA') ||
                                       e.includes('SOBRANTE');
                            }).length;

                            const hayErrorDevolucion =
                                Boolean(devolucionError) ||
                                devoluciones.some(x => {
                                    const e = String(
                                        getPropValue(x, 'estatus', 'Estatus', '')
                                    ).toUpperCase();

                                    return e.includes('PENDIENTE') ||
                                           e.includes('DIFERENCIA') ||
                                           e.includes('FALTA') ||
                                           e.includes('SOBRANTE');
                                });

                            document.getElementById('devTotalPartidas').textContent =
                                devoluciones.length;
                            document.getElementById('devKgMeat').textContent =
                                formatKg(totalKgMeat);
                            document.getElementById('devKgSap').textContent =
                                formatKg(totalKgSap);
                            document.getElementById('devKgDif').textContent =
                                formatKg(totalKgDif);
                            document.getElementById('devTotalAplicadas').textContent =
                                devAplicadas;
                            document.getElementById('devTotalPendientes').textContent =
                                devPendientes;

                            const devBody = document.getElementById('devDetalleBody');

                            if (devolucionError) {
                                devBody.innerHTML = `
                                    <tr>
                                        <td colspan="9" class="text-center">
                                            <b>No se pudieron consultar las devoluciones.</b><br>
                                            ${escapeHtml(devolucionError)}
                                        </td>
                                    </tr>`;
                            } else if (!devoluciones.length) {
                                devBody.innerHTML = `
                                    <tr>
                                        <td colspan="9" class="text-center">
                                            Sin devoluciones Meat para comparar.
                                        </td>
                                    </tr>`;
                            } else {
                                devBody.innerHTML = devoluciones.map(x => {
                                    const estatus = getPropValue(
                                        x,
                                        'estatus',
                                        'Estatus',
                                        ''
                                    );

                                    const b = badgeInfo(estatus);
                                    const docNum = getPropValue(
                                        x,
                                        'docNumDevolucion',
                                        'DocNumDevolucion',
                                        ''
                                    );

                                    return `
                                        <tr>
                                            <td>${escapeHtml(getPropValue(x, 'pedidoSap', 'PedidoSap', ''))}</td>
                                            <td>${escapeHtml(getPropValue(x, 'articulo', 'Articulo', ''))}</td>
                                            <td>${escapeHtml(getPropValue(x, 'lote', 'Lote', ''))}</td>
                                            <td class="text-end">${formatKg(getPropValue(x, 'kgDevueltosMeat', 'KgDevueltosMeat', 0))}</td>
                                            <td class="text-end">${formatKg(getPropValue(x, 'kgDevueltosSap', 'KgDevueltosSap', 0))}</td>
                                            <td class="text-end">${formatKg(getPropValue(x, 'diferenciaKg', 'DiferenciaKg', 0))}</td>
                                            <td>${escapeHtml(docNum ? String(docNum) : '-')}</td>
                                            <td>${escapeHtml(getPropValue(x, 'tipoAplicacion', 'TipoAplicacion', '-'))}</td>
                                            <td>
                                                <span class="${b.cls}">
                                                    ${b.icon}
                                                    ${escapeHtml(estatus)}
                                                </span>
                                            </td>
                                        </tr>`;
                                }).join('');
                            }

                            const okGeneral =
                                Boolean(estadoTraza?.ok) &&
                                !hayErrorDevolucion;

                            const alertIcon = document.getElementById('trzAlertIcon');
                            const alertTitle = document.getElementById('trzAlertTitle');
                            const alertText = document.getElementById('trzAlertText');

                            if (devolucionError) {
                                alertIcon.textContent = '⚠️';
                                alertTitle.textContent =
                                    estadoTraza?.ok
                                        ? 'Trazabilidad correcta; devoluciones no disponibles.'
                                        : 'Trazabilidad con diferencias y devoluciones no disponibles.';
                                alertText.textContent =
                                    'Se conservaron los lotes cargados. Revisa la conexión o consulta de devoluciones.';
                            } else if (okGeneral) {
                                alertIcon.textContent = '✅';
                                alertTitle.textContent = 'Validación correcta.';
                                alertText.textContent =
                                    'La trazabilidad está correcta y las devoluciones, si existen, están aplicadas en SAP.';
                            } else if (hayErrorDevolucion) {
                                alertIcon.textContent = '⚠️';
                                alertTitle.textContent =
                                    'La entrega tiene devoluciones pendientes o diferencias.';
                                alertText.textContent =
                                    estadoTraza?.ok
                                        ? 'La trazabilidad está correcta. Revisa únicamente las devoluciones Meat vs SAP.'
                                        : 'También existen diferencias de trazabilidad. Revisa ambos apartados.';
                            } else {
                                alertIcon.textContent = '⚠️';
                                alertTitle.textContent =
                                    'La entrega tiene diferencias de trazabilidad.';
                                alertText.textContent =
                                    'Las devoluciones están correctas; revisa lotes, kilos y disponibilidad SAP.';
                            }

                            trazabilidadActualDevolucionesOk = !hayErrorDevolucion;
                            actualizarBotonAutocompletarSap();

                            return {
                                ok: okGeneral,
                                hayError: hayErrorDevolucion,
                                devoluciones,
                                devolucionError
                            };
                        }


                        function obtenerFaltantesAutocompletarSap() {
                            return (trazabilidadActualDetalle || [])
                                .map(x => ({
                                    articulo: String(
                                        getPropValue(x, 'articulo', 'Articulo', '')
                                    ).trim(),
                                    almacen: String(
                                        getPropValue(x, 'almacen', 'Almacen', '')
                                    ).trim(),
                                    lote: String(
                                        getPropValue(x, 'lote', 'Lote', '')
                                    ).trim(),
                                    kg: toNumber(
                                        getPropValue(
                                            x,
                                            'kgFaltantes',
                                            'KgFaltantes',
                                            0
                                        )
                                    )
                                }))
                                .filter(x =>
                                    x.kg > 0.01 &&
                                    x.articulo &&
                                    x.almacen &&
                                    x.lote &&
                                    x.lote !== '-'
                                );
                        }

                        function actualizarBotonAutocompletarSap() {
                            const btn =
                                document.getElementById('btnAutocompletarSap');
                            const icon =
                                document.getElementById('btnAutocompletarSapIcon');
                            const text =
                                document.getElementById('btnAutocompletarSapText');

                            if (!btn || !icon || !text)
                                return;

                            const faltantes =
                                obtenerFaltantesAutocompletarSap();

                            const kgTotal = faltantes.reduce(
                                (sum, x) => sum + x.kg,
                                0
                            );

                            const puedeVer =
                                Boolean(permisosAutocompletarSap?.puedeLeer);

                            const btnJson =
                                document.getElementById(
                                    'btnVerJsonAutocompletarSap'
                                );

                            if (btnJson) {
                                const mostrarJson =
                                    puedeVer &&
                                    kgTotal > 0.01;

                                btnJson.style.display =
                                    mostrarJson
                                        ? 'inline-flex'
                                        : 'none';

                                btnJson.disabled =
                                    !mostrarJson ||
                                    autocompletarSapBusy;

                                btnJson.title =
                                    mostrarJson
                                        ? 'Muestra el JSON exacto que se enviaría a ' +
                                          'PurchaseDeliveryNotes sin crear documentos.'
                                        : 'No existen faltantes válidos para generar JSON.';
                            }

                            if (!puedeVer || kgTotal <= 0.01) {
                                btn.style.display = 'none';
                                btn.disabled = true;
                                return;
                            }

                            btn.style.display = 'inline-flex';

                            if (autocompletarSapBusy) {
                                btn.disabled = true;
                                btn.classList.add('is-busy');
                                icon.textContent = '⏳';
                                text.textContent =
                                    'Autocompletando y enviando...';
                                return;
                            }

                            btn.classList.remove('is-busy');
                            icon.textContent = '⚡';
                            text.textContent =
                                `Autocompletar ${formatKg(kgTotal)} KG y enviar`;

                            if (!permisosAutocompletarSap?.puedeEscribir) {
                                btn.disabled = true;
                                btn.title =
                                    'Tienes permiso de lectura, pero no permiso ' +
                                    'ESCRIBIR en AUTOCOMPLETAR_SAP.';
                                return;
                            }

                            if (!trazabilidadActualDevolucionesOk) {
                                btn.disabled = true;
                                btn.title =
                                    'Espera la validación de devoluciones o corrige ' +
                                    'las diferencias antes de autocompletar.';
                                return;
                            }

                            btn.disabled = false;
                            btn.title =
                                'Genera una entrada PurchaseDeliveryNotes a precio ' +
                                '0.01 únicamente por los SKU, lotes y KG faltantes; ' +
                                'después vuelve a validar y envía la entrega.';
                        }

                        function verJsonAutocompletarSap() {
                            const referencia =
                                trazabilidadActualRef || '';

                            if (!referencia) {
                                alert(
                                    'No se encontró la referencia. ' +
                                    'Abre nuevamente la trazabilidad.'
                                );
                                return;
                            }

                            if (!permisosAutocompletarSap?.puedeLeer) {
                                alert(
                                    'No tienes permiso LEER en ' +
                                    'AUTOCOMPLETAR_SAP.'
                                );
                                return;
                            }

                            const url =
                                '@Url.Action("AutocompletarSapJson", "ProcesosCG")'
                                + '?referencia='
                                + encodeURIComponent(referencia)
                                + '&source='
                                + encodeURIComponent(SOURCE);

                            window.open(
                                url,
                                '_blank',
                                'noopener,noreferrer'
                            );
                        }


                        async function cargarPermisosAutocompletarSap() {
                            try {
                                const response = await fetch(
                                    '@Url.Action("ObtenerPermisosAutocompletarSap", "ProcesosCG")',
                                    {
                                        credentials: 'same-origin',
                                        cache: 'no-store'
                                    }
                                );

                                if (!response.ok) {
                                    permisosAutocompletarSap = {
                                        puedeLeer: false,
                                        puedeEscribir: false,
                                        puedeEliminar: false
                                    };
                                    actualizarBotonAutocompletarSap();
                                    return;
                                }

                                permisosAutocompletarSap =
                                    await response.json();

                                actualizarBotonAutocompletarSap();
                            }
                            catch (error) {
                                console.error(
                                    'Error al consultar AUTOCOMPLETAR_SAP:',
                                    error
                                );

                                permisosAutocompletarSap = {
                                    puedeLeer: false,
                                    puedeEscribir: false,
                                    puedeEliminar: false
                                };

                                actualizarBotonAutocompletarSap();
                            }
                        }

            
                        function getAutocompletarDetalle(data) {
                            const camel = data?.trazabilidadAntesEnvio;
                            if (Array.isArray(camel)) return camel;

                            const pascal = data?.TrazabilidadAntesEnvio;
                            if (Array.isArray(pascal)) return pascal;

                            const detalle = data?.detalle;
                            if (Array.isArray(detalle)) return detalle;

                            const detallePascal = data?.Detalle;
                            return Array.isArray(detallePascal) ? detallePascal : [];
                        }

                        function getAutocompletarDocumentoResumen(data) {
                            return [
                                data?.entradaDocNum
                                    ? `Entrada SAP: ${data.entradaDocNum}`
                                    : '',
                                data?.entregaDocNum
                                    ? `Entrega SAP: ${data.entregaDocNum}`
                                    : ''
                            ].filter(Boolean).join(' | ');
                        }

                        function renderizarResultadoAutocompletarSap(ref, data) {
                            const detalle = getAutocompletarDetalle(data);

                            if (detalle.length) {
                                renderizarTrazabilidadRapida(
                                    ref,
                                    { detalle }
                                );
                            }

                            trazabilidadActualRef = ref || '';
                            trazabilidadActualDetalle = detalle;
                            trazabilidadActualDevolucionesOk = true;

                            const kg = toNumber(
                                data?.kgAutocompletados ??
                                data?.KgAutocompletados ??
                                0
                            );

                            const lineas = toNumber(
                                data?.lineasAutocompletadas ??
                                data?.LineasAutocompletadas ??
                                0
                            );

                            const lotes = toNumber(
                                data?.lotesValidados ??
                                data?.LotesValidados ??
                                detalle.length
                            );

                            const entrada = data?.entradaDocNum
                                ? `Entrada ${data.entradaDocNum}`
                                : data?.entradaYaExistia
                                    ? 'Entrada existente confirmada'
                                    : 'Sin entrada adicional';

                            const entrega = data?.entregaDocNum
                                ? `Entrega ${data.entregaDocNum}`
                                : data?.entregaConfirmadaSap
                                    ? 'Entrega confirmada en SAP'
                                    : 'Entrega sin número devuelto';

                            const recuperado =
                                Boolean(
                                    data?.recuperadoTrasError ??
                                    data?.RecuperadoTrasError
                                );

                            const yaExistia =
                                Boolean(
                                    data?.entregaYaExistia ??
                                    data?.EntregaYaExistia
                                );

                            const alertIcon =
                                document.getElementById('trzAlertIcon');
                            const alertTitle =
                                document.getElementById('trzAlertTitle');
                            const alertText =
                                document.getElementById('trzAlertText');

                            if (alertIcon) alertIcon.textContent =
                                recuperado ? '⚠️' : '✅';

                            if (alertTitle) {
                                alertTitle.textContent = recuperado
                                    ? 'Entrega confirmada en SAP con advertencia.'
                                    : yaExistia
                                        ? 'La entrega ya estaba enviada en SAP.'
                                        : 'Inventario completado y entrega enviada.';
                            }

                            if (alertText) {
                                alertText.textContent =
                                    `SAP confirmó ${lotes} lote(s) con KG suficientes ` +
                                    `antes del envío. ${formatKg(kg)} KG agregados en ` +
                                    `${lineas} partida(s). ${entrada}. ${entrega}.` +
                                    (data?.advertencia
                                        ? ` Advertencia posterior: ${data.advertencia}`
                                        : '');
                            }

                            actualizarBotonAutocompletarSap();
                        }

                        function renderizarFalloAutocompletarSap(ref, data) {
                            const detalle = getAutocompletarDetalle(data);

                            if (detalle.length) {
                                renderizarTrazabilidadRapida(
                                    ref,
                                    { detalle }
                                );
                            }

                            const alertIcon =
                                document.getElementById('trzAlertIcon');
                            const alertTitle =
                                document.getElementById('trzAlertTitle');
                            const alertText =
                                document.getElementById('trzAlertText');

                            const entradaRegistrada =
                                Boolean(
                                    data?.entradaCreada ||
                                    data?.entradaYaExistia ||
                                    data?.entradaDocEntry ||
                                    data?.entradaDocNum
                                );

                            if (alertIcon) alertIcon.textContent =
                                entradaRegistrada ? '⚠️' : '⛔';

                            if (alertTitle) {
                                alertTitle.textContent = entradaRegistrada
                                    ? 'La entrada de KG fue procesada; la entrega requiere revisión.'
                                    : 'No se completó el proceso en SAP.';
                            }

                            if (alertText) {
                                const fase = data?.fase
                                    ? `Fase: ${data.fase}. `
                                    : '';

                                const entrada = data?.entradaDocNum
                                    ? `Entrada SAP: ${data.entradaDocNum}. `
                                    : '';

                                alertText.textContent =
                                    fase +
                                    entrada +
                                    (data?.msg ||
                                     'Revisa el detalle del error antes de volver a intentar.');
                            }

                            actualizarBotonAutocompletarSap();
                        }

                        function buildAutocompletarErrorMessage(data, httpStatus) {
                            const partes = [];

                            partes.push(
                                data?.msg ||
                                'No se pudo completar el inventario y enviar la entrega.'
                            );

                            if (httpStatus)
                                partes.push(`HTTP: ${httpStatus}`);

                            if (data?.fase)
                                partes.push(`Fase: ${data.fase}`);

                            if (data?.entradaDocNum)
                                partes.push(`Entrada SAP: ${data.entradaDocNum}`);

                            if (data?.entregaDocNum)
                                partes.push(`Entrega SAP: ${data.entregaDocNum}`);

                            if (data?.error)
                                partes.push(`Error: ${data.error}`);

                            if (data?.inner &&
                                data.inner !== data.error)
                                partes.push(`Detalle interno: ${data.inner}`);

                            if (data?.detalle) {
                                let detalleTexto = '';

                                try {
                                    detalleTexto =
                                        typeof data.detalle === 'string'
                                            ? data.detalle
                                            : JSON.stringify(
                                                data.detalle,
                                                null,
                                                2
                                            );
                                } catch {
                                    detalleTexto =
                                        String(data.detalle);
                                }

                                if (detalleTexto.length > 3500) {
                                    detalleTexto =
                                        detalleTexto.substring(0, 3500) +
                                        '\n...detalle recortado';
                                }

                                partes.push(detalleTexto);
                            }

                            return partes.filter(Boolean).join('\n');
                        }

                        async function autocompletarYEnviarSap() {
                            const ref = trazabilidadActualRef || '';

                            if (!ref) {
                                alert(
                                    'No se encontró la referencia. ' +
                                    'Abre nuevamente la trazabilidad.'
                                );
                                return;
                            }

                            if (autocompletarSapBusy) {
                                showLog(
                                    'warning',
                                    'El autocompletado ya está en proceso.'
                                );
                                return;
                            }

                            if (!permisosAutocompletarSap?.puedeEscribir) {
                                alert(
                                    'No tienes permiso ESCRIBIR en ' +
                                    'AUTOCOMPLETAR_SAP.'
                                );
                                return;
                            }

                            const faltantes =
                                obtenerFaltantesAutocompletarSap();

                            const kgTotal = faltantes.reduce(
                                (sum, x) => sum + x.kg,
                                0
                            );

                            if (!trazabilidadActualDevolucionesOk) {
                                alert(
                                    'Las devoluciones aún no están correctas o ' +
                                    'continúan validándose.'
                                );
                                return;
                            }

                            if (!faltantes.length || kgTotal <= 0.01) {
                                alert(
                                    'No hay faltantes válidos para autocompletar.'
                                );
                                return;
                            }

                            const resumen = faltantes
                                .map(x =>
                                    `${x.articulo} | ${x.almacen} | ` +
                                    `${x.lote} | ${formatKg(x.kg)} KG`
                                )
                                .join('\n');

                            const confirmar = confirm(
                                'Se generará una entrada de mercancía en SAP ' +
                                'con precio 0.01 por los faltantes exactos.\n\n' +
                                `Referencia: ${ref}\n` +
                                `Partidas: ${faltantes.length}\n` +
                                `KG totales: ${formatKg(kgTotal)}\n\n` +
                                resumen +
                                '\n\nDespués se confirmará que cada lote ya tenga KG ' +
                                'y únicamente entonces se enviará la entrega.\n\n' +
                                '¿Continuar?'
                            );

                            if (!confirmar)
                                return;

                            autocompletarSapBusy = true;
                            actualizarBotonAutocompletarSap();
                            setSendButtonsDisabled(true);

                            showLog(
                                'info',
                                `Autocompletando ${formatKg(kgTotal)} KG en SAP ` +
                                `para ${ref}. Se confirmarán los lotes antes del envío...`
                            );

                            try {
                                const response = await fetch(
                                    '@Url.Action("AutocompletarYEnviarEntregaSap", "ProcesosCG")',
                                    {
                                        method: 'POST',
                                        credentials: 'same-origin',
                                        cache: 'no-store',
                                        headers: {
                                            'Content-Type': 'application/json',
                                            'Accept': 'application/json'
                                        },
                                        body: JSON.stringify({
                                            referencia: ref,
                                            source: SOURCE
                                        })
                                    }
                                );

                                const data = await readResponse(response);

                                // Salvaguarda de UI: si el servidor confirma que SAP sí
                                // contiene la entrega, se muestra como éxito aun cuando
                                // una capa intermedia haya usado un código HTTP incorrecto.
                                const confirmadaEnSap =
                                    Boolean(
                                        data?.entregaConfirmadaSap ??
                                        data?.EntregaConfirmadaSap
                                    );

                                if ((!response.ok || !data?.ok) &&
                                    !confirmadaEnSap) {
                                    const mensaje =
                                        buildAutocompletarErrorMessage(
                                            data,
                                            response.status
                                        );

                                    renderizarFalloAutocompletarSap(
                                        ref,
                                        data || {}
                                    );

                                    const entradaRegistrada =
                                        Boolean(
                                            data?.entradaCreada ||
                                            data?.entradaYaExistia ||
                                            data?.entradaDocNum
                                        );

                                    showLog(
                                        entradaRegistrada
                                            ? 'warning'
                                            : 'danger',
                                        mensaje
                                    );

                                    setRowStatus(
                                        ref,
                                        false,
                                        data?.msg ||
                                        'No se confirmó la entrega en SAP.'
                                    );

                                    if (response.status === 403) {
                                        alert(
                                            'Acceso denegado. Se requiere ' +
                                            'AUTOCOMPLETAR_SAP / ESCRIBIR.'
                                        );
                                    } else {
                                        alert(mensaje);
                                    }

                                    return;
                                }

                                renderizarResultadoAutocompletarSap(
                                    ref,
                                    data || {}
                                );

                                const mensaje =
                                    data?.msg ||
                                    'Inventario autocompletado y entrega confirmada en SAP.';

                                const documentos =
                                    getAutocompletarDocumentoResumen(data);

                                const esAdvertencia =
                                    Boolean(
                                        data?.recuperadoTrasError ??
                                        data?.RecuperadoTrasError
                                    );

                                const mensajeCompleto =
                                    mensaje +
                                    (documentos
                                        ? '\n' + documentos
                                        : '') +
                                    (data?.advertencia
                                        ? '\nAdvertencia: ' + data.advertencia
                                        : '');

                                showLog(
                                    esAdvertencia
                                        ? 'warning'
                                        : 'success',
                                    mensajeCompleto
                                );

                                // Primero refresca la información proveniente del servidor
                                // y después fuerza el estado visual confirmado.
                                try {
                                    await refreshSapTableSilentSafe();
                                } catch (refreshError) {
                                    console.warn(
                                        'No se pudo refrescar la tabla después del envío:',
                                        refreshError
                                    );
                                }

                                setRowStatus(
                                    ref,
                                    true,
                                    mensaje +
                                    (data?.entregaDocNum
                                        ? ` DocNum: ${data.entregaDocNum}`
                                        : '')
                                );

                                alert(
                                    mensajeCompleto +
                                    '\n\nLos lotes mostrados fueron validados con KG ' +
                                    'antes de crear o confirmar la entrega.'
                                );
                            }
                            catch (error) {
                                const mensaje =
                                    'Error de comunicación durante el autocompletado: ' +
                                    (error?.message || error) +
                                    '\n\nNo vuelvas a intentar inmediatamente. ' +
                                    'Consulta primero si la entrega ya aparece en SAP.';

                                showLog('danger', mensaje);
                                alert(mensaje);
                            }
                            finally {
                                autocompletarSapBusy = false;
                                setSendButtonsDisabled(false);
                                actualizarBotonAutocompletarSap();
                            }
                        }


                        async function obtenerTrazabilidadRapida(ref) {
                            const res = await fetch(
                                '@Url.Action("ValidarTrazabilidadRapida", "ProcesosCG")'
                                + '?referencia=' + encodeURIComponent(ref)
                                + '&source=' + encodeURIComponent(SOURCE),
                                {
                                    credentials: 'same-origin'
                                }
                            );

                            const data = await readResponse(res);

                            if (!res.ok) {
                                throw new Error(
                                    data?.msg ||
                                    data?.error ||
                                    'No se pudo consultar la trazabilidad.'
                                );
                            }

                            return {
                                httpOk: res.ok,
                                data
                            };
                        }

                        async function obtenerDevolucionesEntrega(ref) {
                            const res = await fetch(
                                '@Url.Action("ValidarDevolucionesEntrega", "ProcesosCG")'
                                + '?referencia=' + encodeURIComponent(ref)
                                + '&source=' + encodeURIComponent(SOURCE),
                                {
                                    credentials: 'same-origin'
                                }
                            );

                            const data = await readResponse(res);

                            if (!res.ok) {
                                throw new Error(
                                    data?.msg ||
                                    data?.error ||
                                    'No se pudieron consultar las devoluciones.'
                                );
                            }

                            return {
                                httpOk: res.ok,
                                data
                            };
                        }

                        async function validarTrazabilidad(ref, mostrarModal = true) {
                            const requestId = ++trazabilidadRequestSeq;

                            if (mostrarModal) {
                                // Abre el modal inmediatamente. No espera ninguna consulta.
                                prepararModalTrazabilidad(ref);
                            }

                            showLog(
                                'info',
                                'Etapa 1 de 2: cargando lotes, fechas y disponibilidad SAP de ' +
                                ref + '...'
                            );

                            let estadoTraza = {
                                ok: false,
                                hayError: true,
                                detalle: []
                            };

                            // =========================================================
                            // ETAPA 1: TRAZABILIDAD
                            // Primero termina y pinta lotes, fechas, KG y disponibilidad.
                            // Las devoluciones todavía NO se consultan, evitando que ambos
                            // procesos compitan por SQL, conexiones y Service Layer.
                            // =========================================================
                            try {
                                const trazaResponse = await obtenerTrazabilidadRapida(ref);

                                estadoTraza = {
                                    ok: Boolean(
                                        trazaResponse.httpOk &&
                                        trazaResponse.data?.ok
                                    ),
                                    hayError: !Boolean(
                                        trazaResponse.httpOk &&
                                        trazaResponse.data?.ok
                                    ),
                                    detalle: getArrayProp(
                                        trazaResponse.data,
                                        'detalle',
                                        'Detalle'
                                    )
                                };

                                if (
                                    mostrarModal &&
                                    requestId === trazabilidadRequestSeq
                                ) {
                                    estadoTraza = renderizarTrazabilidadRapida(
                                        ref,
                                        trazaResponse.data
                                    );
                                }
                            }
                            catch (error) {
                                estadoTraza = {
                                    ok: false,
                                    hayError: true,
                                    detalle: []
                                };

                                if (
                                    mostrarModal &&
                                    requestId === trazabilidadRequestSeq
                                ) {
                                    estadoTraza = renderizarErrorTrazabilidad(error);
                                }
                            }

                            // Cede el control al navegador para que pinte la primera tabla
                            // antes de iniciar la segunda consulta pesada.
                            await new Promise(resolve =>
                                window.setTimeout(resolve, 180)
                            );

                            if (
                                mostrarModal &&
                                requestId === trazabilidadRequestSeq
                            ) {
                                const devBody = document.getElementById('devDetalleBody');

                                if (devBody) {
                                    devBody.innerHTML = `
                                        <tr>
                                            <td colspan="9" class="loading-row">
                                                <div class="trz-carga-progresiva">
                                                    <span class="trz-mini-spinner"></span>
                                                    Etapa 1 lista. Consultando ahora devoluciones Meat vs SAP…
                                                </div>
                                            </td>
                                        </tr>`;
                                }

                                const alertText = document.getElementById('trzAlertText');

                                if (alertText) {
                                    alertText.textContent =
                                        'Lotes, fechas, kilos y disponibilidad ya cargados. ' +
                                        'Ahora se consultan las devoluciones en segundo plano.';
                                }
                            }

                            showLog(
                                'info',
                                'Etapa 1 lista. Etapa 2 de 2: consultando devoluciones de ' +
                                ref + '...'
                            );

                            // =========================================================
                            // ETAPA 2: DEVOLUCIONES
                            // Comienza únicamente después de mostrar la trazabilidad.
                            // =========================================================
                            let devResponse;

                            try {
                                devResponse = await obtenerDevolucionesEntrega(ref);
                            }
                            catch (error) {
                                devResponse = {
                                    httpOk: false,
                                    data: {
                                        ok: false,
                                        devoluciones: [],
                                        devolucionError:
                                            error?.message || String(error)
                                    }
                                };
                            }

                            const devData = devResponse.data || {
                                ok: false,
                                devoluciones: [],
                                devolucionError:
                                    'No se recibió respuesta de devoluciones.'
                            };

                            actualizarEstatusDevolucionFila(ref, devData);

                            let estadoDev = {
                                ok: Boolean(
                                    devResponse.httpOk &&
                                    devData?.ok
                                ),
                                hayError: !Boolean(
                                    devResponse.httpOk &&
                                    devData?.ok
                                ),
                                devoluciones: getArrayProp(
                                    devData,
                                    'devoluciones',
                                    'Devoluciones'
                                ),
                                devolucionError: getPropValue(
                                    devData,
                                    'devolucionError',
                                    'DevolucionError',
                                    ''
                                )
                            };

                            if (
                                mostrarModal &&
                                requestId === trazabilidadRequestSeq
                            ) {
                                estadoDev = renderizarDevolucionesTrazabilidad(
                                    devData,
                                    estadoTraza
                                );
                            }

                            const esOk = Boolean(
                                estadoTraza?.ok &&
                                estadoDev?.ok
                            );

                            if (esOk) {
                                showLog(
                                    'success',
                                    'Trazabilidad y devoluciones correctas: ' + ref
                                );

                                return true;
                            }

                            showLog(
                                'warning',
                                'La entrega requiere revisión de trazabilidad o devoluciones: ' +
                                ref
                            );

                            return false;
                        }

                        async function sendOne(ref) {
                            if (isSending) {
                                showLog('warning', 'Hay un envío en proceso. Espera a que termine.');
                                return;
                            }

                            isSending = true;
                            setSendButtonsDisabled(true);

                            try {
                                const validacionOk = await validarPrevioEnvioSap(ref);

                                if (!validacionOk) {
                                    setRowStatus(ref, false, 'Pendiente de trazabilidad/devolución SAP');
                                    return;
                                }

                                showLog('info', 'Enviando entrega a SAP: ' + ref + ' ...');

                                const { res, data } = await postEnviarEntregaSap(ref);

                                if (res.ok && data?.ok) {
                                    const m = buildMsg(data, 'Enviado con éxito.');
                                    setRowStatus(ref, true, m);
                                    showLog('success', m);
                                } else {
                                    const err = buildMsg(data, 'No se pudo enviar.');
                                    setRowStatus(ref, false, err);
                                    showLog('danger', err + (data?.detalle ? String.fromCharCode(10) + data.detalle : ''));
                                }
                            } catch (e) {
                                setRowStatus(ref, false, 'Error de red');
                                showLog('danger', 'Error de red al enviar a SAP: ' + (e?.message || e));
                            } finally {
                                isSending = false;
                                setSendButtonsDisabled(false);
                            }
                        }

                            async function sendMany() {
                                if (isSending) {
                                    showLog('warning', 'Hay un envío en proceso.');
                                    return;
                                }

                                const refs = Array.from(document.querySelectorAll('.ck:checked'))
                                    .map(x => x.value)
                                    .filter(Boolean);

                                if (!refs.length) {
                                    showLog('warning', 'Selecciona al menos una entrega.');
                                    return;
                                }

                                isSending = true;
                                setSendButtonsDisabled(true);

                                let okCount = 0;
                                let failCount = 0;
                                let omitidosValidacion = 0;

                                try {
                                    showLog('info', `Enviando ${refs.length} entregas a SAP...`);

                                    for (let i = 0; i < refs.length; i++) {
                                        const ref = refs[i];
                                        showLog('info', `(${i + 1}/${refs.length}) Validando / enviando: ${ref}...`);

                                        const validacionOk = await validarPrevioEnvioSap(ref);

                                        if (!validacionOk) {
                                            failCount++;
                                            omitidosValidacion++;
                                            setRowStatus(ref, false, 'Pendiente de trazabilidad/devolución SAP');
                                            continue;
                                        }

                                        const { res, data } = await postEnviarEntregaSap(ref);

                                        if (res.ok && data?.ok) {
                                            okCount++;
                                            setRowStatus(ref, true, buildMsg(data, 'Enviado.'));
                                        } else {
                                            failCount++;
                                            setRowStatus(ref, false, buildMsg(data, `Falló: ${ref}`));
                                        }
                                    }

                                    let resumen = `Terminado. OK: ${okCount} | Fallidos: ${failCount}`;
                                    if (omitidosValidacion > 0) {
                                        resumen += ` | Bloqueados por validación: ${omitidosValidacion}`;
                                    }

                                    showLog(failCount === 0 ? 'success' : 'warning', resumen);
                                } catch (e) {
                                    showLog('danger', 'Error de red al enviar masivo a SAP: ' + (e?.message || e));
                                } finally {
                                    isSending = false;
                                    setSendButtonsDisabled(false);
                                }
                            }

                            let autoEnabled = false, autoTimer = null, autoRefreshTimer = null;

                            function isAutoCandidateStatus(sym) { return sym === '—' || sym === '❌' || sym === ''; }

                            function getAutoRefsToSend() {
                                return Array.from(document.querySelectorAll('tr[data-ref]'))
                                    .filter(row => isAutoCandidateStatus(getStatusSymbolFromRow(row)))
                                    .map(row => row.getAttribute('data-ref'))
                                    .filter(Boolean);
                            }

                            async function sendManyRefs(refs) {
                                if (isSending || !refs?.length) return;

                                isSending = true;
                                setSendButtonsDisabled(true);

                                try {
                                    showLog('info', `Auto: enviando ${refs.length} entrega(s) a SAP...`);

                                    for (let i = 0; i < refs.length; i++) {
                                        const ref = refs[i];
                                        const row = document.querySelector(`tr[data-ref="${CSS.escape(ref)}"]`);

                                        if (!isAutoCandidateStatus(getStatusSymbolFromRow(row))) continue;

                                        const validacionOk = await validarPrevioEnvioSap(ref);

                                        if (!validacionOk) {
                                            setRowStatus(ref, false, 'Pendiente de trazabilidad/devolución SAP');
                                            continue;
                                        }

                                        const { res, data } = await postEnviarEntregaSap(ref);

                                        if (res.ok && data?.ok) {
                                            setRowStatus(ref, true, buildMsg(data, 'Enviado.'));
                                        } else {
                                            setRowStatus(ref, false, buildMsg(data, `Falló: ${ref}`));
                                        }
                                    }
                                } catch (e) {
                                    showLog('danger', 'Error de red en envío automático SAP: ' + (e?.message || e));
                                } finally {
                                    isSending = false;
                                    setSendButtonsDisabled(false);
                                }
                            }

                            function updateAutoButton() {
                                const b   = document.getElementById('btnAuto');
                                const ico = document.getElementById('autoIco');
                                if (!b || !ico) return;
                                if (autoEnabled) {
                                    b.classList.add('auto-on');
                                    ico.textContent = '▶';
                                    b.title = 'Auto: ON — clic para desactivar';
                                } else {
                                    b.classList.remove('auto-on');
                                    ico.textContent = '⏸';
                                    b.title = 'Auto: OFF — clic para activar';
                                }
                            }

                            async function serverAutoSet(enabled) {
                                const intervalMs = parseInt(document.getElementById('autoInterval')?.value || '5000', 10);
                                const res = await fetch('/ProcesosCG/AutoSapSet', {
                                    method: 'POST', credentials: 'same-origin',
                                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                                    body: 'enabled='+encodeURIComponent(enabled)+'&source=ALL&intervalMs='+encodeURIComponent(intervalMs)
                                });
                                const data = await readResponse(res);
                                if (!res.ok || !data?.ok) throw new Error(data?.msg || 'Error auto servidor');
                                return data;
                            }

                            async function serverAutoStatus() {
                                const res = await fetch('/ProcesosCG/AutoSapStatus?source=ALL', { credentials: 'same-origin' });
                                const data = await readResponse(res);
                                if (!res.ok || !data?.ok) throw new Error(data?.msg || 'Error estado auto');
                                return data;
                            }

                            async function refreshSapTableSilentSafe() {
                                const container = document.querySelector('.table-wrap');
                                const tbody = document.querySelector('tbody');
                                if (!container || !tbody) return;
                                const checked = new Set(Array.from(document.querySelectorAll('.ck:checked')).map(x => x.value));
                                const scrollTop = container.scrollTop;
                                const res = await fetch(window.location.href, { credentials: 'same-origin' });
                                const html = await res.text();
                                const tmp = document.createElement('div');
                                tmp.innerHTML = html;
                                const newTbody = tmp.querySelector('tbody');
                                if (!newTbody) return;
                                tbody.replaceWith(newTbody);
                                document.querySelectorAll('.ck').forEach(x => { if (checked.has(x.value)) x.checked = true; });
                                container.scrollTop = scrollTop;
                                updateReserveButtons();
                            }

                            function startAutoRefresh() {
                                if (autoRefreshTimer) clearInterval(autoRefreshTimer);
                                autoRefreshTimer = setInterval(async () => {
                                    if (!autoEnabled) return;
                                    await refreshSapTableSilentSafe();
                                }, 30000);
                            }

                            function stopAutoRefresh() {
                                if (autoRefreshTimer) clearInterval(autoRefreshTimer);
                                autoRefreshTimer = null;
                            }

                            function stopAuto() {
                                autoEnabled = false;
                                if (autoTimer) clearInterval(autoTimer);
                                autoTimer = null;
                                stopAutoRefresh();
                                updateAutoButton();
                                showLog('secondary', 'Envío automático desactivado.');
                                serverAutoSet(false).catch(e => console.warn(e));
                            }

                            async function startAuto() {
                                autoEnabled = true;
                                updateAutoButton();
                                showLog('info', 'Activando envío automático...');
                                try {
                                    const r = await serverAutoSet(true);
                                    if (r?.msg) showLog('info', r.msg);
                                } catch(e) {
                                    showLog('danger', 'No pude activar auto en servidor: '+(e?.message||e));
                                    autoEnabled = false; updateAutoButton(); return;
                                }
                                const intervalMs = parseInt(document.getElementById('autoInterval')?.value || '5000', 10);
                                const first = getAutoRefsToSend();
                                if (first.length) await sendManyRefs(first);
                                if (autoTimer) clearInterval(autoTimer);
                                autoTimer = setInterval(async () => {
                                    if (!autoEnabled || isSending) return;
                                    const refs = getAutoRefsToSend();
                                    if (refs.length) await sendManyRefs(refs);
                                }, intervalMs);
                                startAutoRefresh();
                            }

                            document.getElementById('btnAuto')?.addEventListener('click', () => {
                                if (autoEnabled) stopAuto(); else startAuto();
                            });

                            document.getElementById('autoInterval')?.addEventListener('change', () => {
                                if (autoEnabled) startAuto();
                            });

                            (async function initAutoState() {
                                try {
                                    const s = await serverAutoStatus();
                                    const anyOn = (s?.all || []).some(x => x.enabled === true || x.Enabled === true);
                                    if (anyOn) {
                                        autoEnabled = true; updateAutoButton();
                                        showLog('info', 'Auto server ya estaba ACTIVADO');
                                        startAutoRefresh();
                                    } else { updateAutoButton(); }
                                } catch(e) { console.warn('AutoSapStatus error:', e); updateAutoButton(); }
                            })();

                            updateReserveButtons();
                            setInterval(updateReserveButtons, 15000);
                            window.addEventListener('beforeunload', () => {
                                if (autoTimer) clearInterval(autoTimer);
                                if (autoRefreshTimer) clearInterval(autoRefreshTimer);
                            });

                            let currentReserveRef = null;

                            async function sendReserveByDelivery(ref) {
                                if (!confirm(`¿Generar Factura de Reserva COMPLETA para la entrega ${ref}?`)) return;
                                showLog('info', 'Generando Reserva por entrega: ' + ref);
                                try {
                                    const res = await fetch('@Url.Action("EnviarFacturaReservaEntrega", "ProcesosCG")', {
                                        method: 'POST',
                                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                                        body: 'referencia=' + encodeURIComponent(ref) + '&source=' + encodeURIComponent(SOURCE)
                                    });
                                    const data = await readResponse(res);
                                    showLog(res.ok && data?.ok ? 'success' : 'danger',
                                        buildMsg(data, res.ok && data?.ok ? 'Reserva enviada.' : 'No se pudo generar la reserva.'));
                                } catch(e) { showLog('danger', 'Error de red: ' + e.message); }
                            }

                            async function openReserveManual(ref) {
                                currentReserveRef = ref;
                                const body = document.getElementById('reserveLinesBody');
                                body.innerHTML = '<tr><td colspan="2" style="padding:8px;color:#6a3a3a;">Cargando...</td></tr>';
                                bootstrap.Modal.getOrCreateInstance(document.getElementById('reserveKgModal')).show();
                                try {
                                    const res = await fetch(`/ProcesosCg/GetEntregaLines?referencia=${encodeURIComponent(ref)}&source=${encodeURIComponent(SOURCE)}`);
                                    const data = await res.json();
                                    body.innerHTML = '';
                                    data.forEach(x => {
                                        const tr = document.createElement('tr');
                                        tr.innerHTML = `
                                            <td>${x.itemCode}</td>
                                            <td class="text-end">
                                                <input type="number" class="form-control reserve-qty"
                                                       data-baseline="${x.baseLine}" max="${x.openQuantity}"
                                                       min="0" step="0.01" placeholder="0.00"
                                                       style="width:100px;display:inline-block;">
                                            </td>`;
                                        body.appendChild(tr);
                                    });
                                } catch(e) {
                                    body.innerHTML = '<tr><td colspan="2">Error al cargar items</td></tr>';
                                }
                            }

                            async function sendReserveKg() {
                                const lines = [];
                                document.querySelectorAll('.reserve-qty').forEach(inp => {
                                    const qty = parseFloat(inp.value);
                                    if (qty > 0) lines.push({ baseLine: parseInt(inp.dataset.baseline), quantity: qty });
                                });
                                if (!lines.length) { alert('Captura al menos un KG.'); return; }
                                if (!confirm('¿Generar reserva MANUAL con los KG capturados?')) return;
                                showLog('info', 'Generando Reserva Manual...');
                                try {
                                    const res = await fetch('@Url.Action("EnviarFacturaReservaManual", "ProcesosCG")', {
                                        method: 'POST',
                                        headers: { 'Content-Type': 'application/json' },
                                        body: JSON.stringify({ referencia: currentReserveRef, source: SOURCE, lines })
                                    });
                                    const data = await readResponse(res);
                                    if (res.ok && data?.ok) {
                                        showLog('success', buildMsg(data, 'Reserva manual enviada.'));
                                        bootstrap.Modal.getInstance(document.getElementById('reserveKgModal'))?.hide();
                                    } else {
                                        showLog('danger', buildMsg(data, 'Error al generar reserva.'));
                                    }
                                } catch(e) { showLog('danger', 'Error de red: ' + e.message); }
                            }

                            let pdfSolicitudId = null;
                            let pdfReferenciaDocMeat = null;

                            // false = PDF individual / true = PDF múltiple unificado
                            let pdfModoMultiple = false;
                            let pdfRegistrosSeleccionados = [];
                            let pdfGenerando = false;

                            function actualizarNotaOrigenPdf() {
                                const origen =
                                    document.querySelector('input[name="pdfOrigenDatos"]:checked')?.value || 'remision';

                                const nota =
                                    document.getElementById('pdfOrigenNota');

                                if (!nota) return;

                                if (pdfModoMultiple) {
                                    const total = pdfRegistrosSeleccionados.length;
                                    const cliente = String(
                                        pdfRegistrosSeleccionados[0]?.cliente || ''
                                    ).trim();

                                    nota.textContent =
                                        origen === 'orden'
                                            ? `Se consolidarán ${total} registros del mismo cliente` +
                                              (cliente ? ` (${cliente})` : '') +
                                              ` en un solo PDF usando datos de la orden de venta.`
                                            : `Se consolidarán ${total} registros del mismo cliente` +
                                              (cliente ? ` (${cliente})` : '') +
                                              ` en un solo PDF usando los datos surtidos de las remisiones.`;

                                    return;
                                }

                                nota.textContent =
                                    origen === 'orden'
                                        ? 'Se generará el PDF con los datos de la orden de venta / pedido original.'
                                        : 'Se generará el PDF con los datos realmente surtidos de la remisión/JSON.';
