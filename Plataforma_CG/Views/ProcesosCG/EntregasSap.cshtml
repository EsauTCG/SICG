@model List<Plataforma_CG.ViewModels.EntregaSapRowVM>
@removeTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "";

    var source = (string)(ViewBag.Source ?? "P1");
    DateTime desde = ViewBag.Desde != null ? (DateTime)ViewBag.Desde : DateTime.Today;
    DateTime hasta = ViewBag.Hasta != null ? (DateTime)ViewBag.Hasta : DateTime.Today;
    var cliente = (string)(ViewBag.Cliente ?? "");

    var totalEntregasSap = Model?.Count ?? 0;
    var totalEnviadasSap = Model?.Count(x => x.EnviadoSap == true) ?? 0;
    var totalFallidasSap = Model?.Count(x => x.EnviadoSap == false) ?? 0;
    var totalPendientesSap = totalEntregasSap - totalEnviadasSap - totalFallidasSap;
    var totalClientesSap = Model?
        .Where(x => !string.IsNullOrWhiteSpace(x.Cliente))
        .Select(x => x.Cliente.Trim())
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .Count() ?? 0;
    var periodoSap = desde.Date == hasta.Date
        ? desde.ToString("dd/MM/yyyy")
        : $"{desde:dd/MM/yyyy} - {hasta:dd/MM/yyyy}";
}


<link rel="stylesheet" href="~/css/entregas-sap-grid.css" asp-append-version="true" />

<style>
    /*
     * ================================================================
     * ACOMODO EJECUTIVO - SOLO FILTROS
     * ================================================================
     * Conserva exactamente el acomodo de filtros de la versión anterior.
     * NO modifica los KPI.
     * ================================================================
     */

    .entregas-sap-app,
    .entregas-sap-app .content,
    .entregas-sap-app .workspace {
        width: 100% !important;
        max-width: none !important;
        min-width: 0 !important;
        box-sizing: border-box !important;
    }

    .entregas-sap-app .content {
        overflow-x: hidden !important;
    }

    .entregas-sap-app .workspace {
        padding: 10px 14px 8px !important;
    }

    .entregas-sap-app .section {
        width: 100% !important;
        max-width: 100% !important;
        min-width: 0 !important;
        margin-bottom: 10px !important;
    }

    /* ================================================================
       FILTROS
       ================================================================ */

    .entregas-sap-app #frmFiltros {
        width: 100% !important;
        margin: 0 !important;
    }

    .entregas-sap-app #frmFiltros .filters {
        width: 100% !important;
        display: grid !important;
        grid-template-columns:
            minmax(150px, 0.85fr)
            minmax(210px, 1.15fr)
            minmax(175px, 0.95fr)
            minmax(150px, 0.80fr)
            minmax(150px, 0.80fr)
            minmax(455px, 2.25fr) !important;
        gap: 10px 12px !important;
        align-items: end !important;
        padding: 10px 12px 12px !important;
        box-sizing: border-box !important;
    }

    .entregas-sap-app #frmFiltros .filter-group {
        min-width: 0 !important;
        width: 100% !important;
        margin: 0 !important;
    }

    .entregas-sap-app #frmFiltros .filter-group label {
        display: block !important;
        margin: 0 0 5px !important;
        font-size: 12px !important;
        line-height: 1.1 !important;
        font-weight: 800 !important;
        white-space: nowrap !important;
    }

    .entregas-sap-app #frmFiltros .filter-group input,
    .entregas-sap-app #frmFiltros .filter-group select,
    .entregas-sap-app #frmFiltros .filter-group .form-control,
    .entregas-sap-app #frmFiltros .filter-group .form-select {
        width: 100% !important;
        min-width: 0 !important;
        height: 36px !important;
        min-height: 36px !important;
        padding: 5px 8px !important;
        font-size: 12px !important;
        box-sizing: border-box !important;
    }

    .entregas-sap-app #frmFiltros .filter-actions-group {
        min-width: 455px !important;
        align-self: end !important;
    }

    .entregas-sap-app #frmFiltros .filter-actions-group > label {
        visibility: hidden !important;
    }

    .entregas-sap-app #frmFiltros .filter-actions-group .pm-actions {
        width: 100% !important;
        display: flex !important;
        justify-content: flex-end !important;
        align-items: center !important;
        flex-wrap: nowrap !important;
        gap: 7px !important;
        margin: 0 !important;
    }

    .entregas-sap-app #frmFiltros .filter-actions-group .pm-btn {
        min-height: 36px !important;
        height: 36px !important;
        padding: 5px 13px !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        gap: 5px !important;
        white-space: nowrap !important;
        font-size: 12px !important;
        line-height: 1 !important;
        font-weight: 800 !important;
        flex: 0 0 auto !important;
    }

    .entregas-sap-app #frmFiltros .filter-actions-group .pm-btn-primary {
        min-width: 100px !important;
    }

    .entregas-sap-app #btnAuto {
        min-width: 82px !important;
    }

    .entregas-sap-app #btnAutoDev {
        min-width: 115px !important;
    }

    .entregas-sap-app #frmFiltros .btn-actualizar {
        min-width: 130px !important;
    }

    /* ================================================================
       RESPONSIVE / SIDEBAR - SOLO FILTROS
       ================================================================ */

    @@media (max-width: 1550px) {
        .entregas-sap-app #frmFiltros .filters {
            grid-template-columns:
                minmax(150px, 1fr)
                minmax(220px, 1.4fr)
                minmax(170px, 1fr)
                minmax(150px, 1fr)
                minmax(150px, 1fr) !important;
        }

        .entregas-sap-app #frmFiltros .filter-actions-group {
            grid-column: 1 / -1 !important;
            min-width: 0 !important;
        }

        .entregas-sap-app #frmFiltros .filter-actions-group > label {
            display: none !important;
        }

        .entregas-sap-app #frmFiltros .filter-actions-group .pm-actions {
            justify-content: flex-end !important;
        }
    }

    @@media (max-width: 1050px) {
        .entregas-sap-app #frmFiltros .filters {
            grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        }

        .entregas-sap-app #frmFiltros .filter-actions-group {
            grid-column: 1 / -1 !important;
        }

        .entregas-sap-app #frmFiltros .filter-actions-group .pm-actions {
            justify-content: flex-start !important;
            flex-wrap: wrap !important;
        }
    }

    @@media (max-width: 680px) {
        .entregas-sap-app .workspace {
            padding-left: 5px !important;
            padding-right: 5px !important;
        }

        .entregas-sap-app #frmFiltros .filters {
            grid-template-columns: 1fr !important;
        }
    }
</style>

<style>
    /*
     * ================================================================
     * AJUSTE FINAL DE FILTROS
     * ================================================================
     * - 5 campos proporcionados en una sola fila cuando hay espacio.
     * - Botones en una segunda fila, centrados y con ancho natural.
     * - Evita que los botones se estiren.
     * ================================================================
     */

    .entregas-sap-app #frmFiltros .filters {
        display: grid !important;
        grid-template-columns:
            minmax(150px, 0.85fr)
            minmax(260px, 1.55fr)
            minmax(170px, 0.95fr)
            minmax(160px, 0.85fr)
            minmax(160px, 0.85fr) !important;
        gap: 8px 10px !important;
        align-items: end !important;
    }

    /* Cada filtro ocupa exactamente una columna. */
    .entregas-sap-app #frmFiltros .filters > .filter-group:nth-child(1),
    .entregas-sap-app #frmFiltros .filters > .filter-group:nth-child(2),
    .entregas-sap-app #frmFiltros .filters > .filter-group:nth-child(3),
    .entregas-sap-app #frmFiltros .filters > .filter-group:nth-child(4),
    .entregas-sap-app #frmFiltros .filters > .filter-group:nth-child(5) {
        grid-column: auto !important;
        width: 100% !important;
        min-width: 0 !important;
    }

    /* Acciones: segunda fila completa y centrada. */
    .entregas-sap-app #frmFiltros .filter-actions-group {
        grid-column: 1 / -1 !important;
        width: 100% !important;
        min-width: 0 !important;
        margin-top: 2px !important;
    }

    .entregas-sap-app #frmFiltros .filter-actions-group > label {
        display: none !important;
    }

    .entregas-sap-app #frmFiltros .filter-actions-group .pm-actions {
        width: 100% !important;
        display: flex !important;
        justify-content: center !important;
        align-items: center !important;
        gap: 8px !important;
        flex-wrap: wrap !important;
    }

    /* Evitar botones estirados. */
    .entregas-sap-app #frmFiltros .filter-actions-group .pm-btn {
        flex: 0 0 auto !important;
        width: auto !important;
        min-width: 108px !important;
        max-width: none !important;
        height: 34px !important;
        min-height: 34px !important;
        padding: 5px 14px !important;
    }

    .entregas-sap-app #frmFiltros .filter-actions-group .pm-btn-primary {
        min-width: 110px !important;
    }

    .entregas-sap-app #btnAuto {
        min-width: 96px !important;
    }

    .entregas-sap-app #btnAutoDev {
        min-width: 118px !important;
    }

    .entregas-sap-app #frmFiltros .btn-actualizar {
        min-width: 126px !important;
    }

    /* Altura uniforme de controles. */
    .entregas-sap-app #frmFiltros .filter-group input,
    .entregas-sap-app #frmFiltros .filter-group select,
    .entregas-sap-app #frmFiltros .filter-group .form-control,
    .entregas-sap-app #frmFiltros .filter-group .form-select {
        height: 34px !important;
        min-height: 34px !important;
    }

    /*
     * En un ancho intermedio pasamos a 3 columnas,
     * manteniendo siempre los botones centrados.
     */
    @@media (max-width: 1250px) {
        .entregas-sap-app #frmFiltros .filters {
            grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
        }

        .entregas-sap-app #frmFiltros .filter-actions-group {
            grid-column: 1 / -1 !important;
        }
    }

    @@media (max-width: 850px) {
        .entregas-sap-app #frmFiltros .filters {
            grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        }

        .entregas-sap-app #frmFiltros .filter-actions-group .pm-actions {
            justify-content: center !important;
        }
    }

    @@media (max-width: 560px) {
        .entregas-sap-app #frmFiltros .filters {
            grid-template-columns: 1fr !important;
        }

        .entregas-sap-app #frmFiltros .filter-actions-group .pm-btn {
            min-width: 120px !important;
        }
    }
</style>


<div class="window entregas-sap-app">

    <div class="titlebar">
        <div></div>
        <div class="actions">
            <div class="win-btn"></div>
            <div class="win-btn"></div>
            <div class="win-btn"></div>
        </div>
    </div>



    <div class="content">



        <div class="workspace">

            <div class="section">
                <div class="section-title">Filtros de búsqueda</div>

                <form id="frmFiltros" method="get">
                    <div class="filters">

                        <div class="filter-group">
                            <label>Origen</label>
                            <select name="source" class="form-select">
                                @if (source == "P1")
                                {
                                    <option value="P1" selected>Planta 1</option>
                                }
                                else
                                {
                                    <option value="P1">Planta 1</option>
                                }

                                @if (source == "TIF")
                                {
                                    <option value="TIF" selected>Planta TIF</option>
                                }
                                else
                                {
                                    <option value="TIF">Planta TIF</option>
                                }
                            </select>
                        </div>

                        <div class="filter-group">
                            <label>Cliente</label>
                            <input type="text"
                                   class="form-control"
                                   name="cliente"
                                   value="@cliente"
                                   placeholder="Buscar cliente..." />
                        </div>

                        
                        <div class="filter-group">
                            <label>Estatus SAP</label>
                            <select name="estatusSap" class="form-select">
                                <option value="todos">Todos</option>
                                <option value="enviados">Enviados ✅</option>
                                <option value="noenviados">No enviados ❌</option>
                            </select>
                        </div>


                        <div class="filter-group">
                            <label>Desde</label>
                            <input type="date"
                                   class="form-control"
                                   name="desde"
                                   value="@desde.ToString("yyyy-MM-dd")" />
                        </div>

                        <div class="filter-group">
                            <label>Hasta</label>
                            <input type="date"
                                   class="form-control"
                                   name="hasta"
                                   value="@hasta.ToString("yyyy-MM-dd")" />
                        </div>

                        <div class="filter-group filter-actions-group">
                            <label>&nbsp;</label>
                            <div class="pm-actions" style="justify-content:flex-end;">
                                <button class="pm-btn pm-btn-primary" type="submit">
                                    <i class="bi bi-search"></i> Buscar
                                </button>

                                @*    <button class="pm-btn btn-enviar" type="button" onclick="sendMany()">
                                    <i class="bi bi-send-fill"></i> Enviar seleccionados
                                </button> *@

                                <button class="pm-btn btn-auto" type="button" id="btnAuto">
                                    <span id="autoIco">⏸</span> Auto
                                </button>

                                @*    <button class="pm-btn pm-btn-warning" type="button" onclick="validarDevolucionesVisibles()" title="Valida devoluciones visibles en la tabla">
                                    <span class="pm-icon">✅</span> Dev.
                                </button> *@

                                <button class="pm-btn btn-auto" type="button" id="btnAutoDev" title="Activar validación automática de devoluciones">
                                    <span id="autoDevIco">⏸</span> Auto Dev
                                </button>

                                <button class="pm-btn btn-actualizar" type="button" onclick="abrirInventarioModal()">
                                    <span class="pm-icon">📦</span> Inventario
                                </button>
                            </div>
                        </div>

                    </div>
                </form>
            </div>


            <div class="section sap-kpi-section">
                <div class="section-title sap-kpi-title">
                    <div>Resumen ejecutivo de entregas SAP</div>
                    <span>Origen: @source | Periodo: @periodoSap | Clientes: @totalClientesSap</span>
                </div>

                <div class="sap-kpi-grid">
                    <div class="sap-kpi sap-kpi-total">
                        <label>Total entregas</label>
                        <strong id="kpiSapTotal">@totalEntregasSap.ToString("N0")</strong>
                        <small>Registros visibles en consulta</small>
                    </div>

                    <div class="sap-kpi sap-kpi-ok">
                        <label>Enviadas SAP</label>
                        <strong id="kpiSapEnviadas">@totalEnviadasSap.ToString("N0")</strong>
                        <small>Confirmadas correctamente</small>
                    </div>

                    <div class="sap-kpi sap-kpi-pending">
                        <label>Pendientes</label>
                        <strong id="kpiSapPendientes">@totalPendientesSap.ToString("N0")</strong>
                        <small>Sin intento / por enviar</small>
                    </div>

                    <div class="sap-kpi sap-kpi-error">
                        <label>Fallidas</label>
                        <strong id="kpiSapFallidas">@totalFallidasSap.ToString("N0")</strong>
                        <small>Requieren revisión</small>
                    </div>

                    <div class="sap-kpi sap-kpi-selected">
                        <label>Seleccionadas</label>
                        <strong id="kpiSapSeleccionadas">0</strong>
                        <small>Marcadas para envío masivo</small>
                    </div>

                    <div class="sap-kpi sap-kpi-dev" id="kpiSapDevCard">
                        <label>Dev. revisar</label>
                        <strong id="kpiSapDevRevisar">0</strong>
                        <small id="kpiSapDevTexto">Pendiente de validar</small>
                    </div>
                </div>
            </div>

            <div class="section">
                @*  <div class="section-title">Listado de entregas</div> *@

                <div class="table-wrap">
                    <table class="tbl-sap">
                        <thead>
                            <tr>
                                <th class="text-center">#</th>
                                <th>Fecha</th>
                                <th>Solicitud</th>
                                <th>Cliente</th>
                                <th>Pedido</th>
                                <th>Remisión</th>
                                <th class="text-center">Est.</th>
                                <th class="text-center">Dev.</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                foreach (var x in Model)
                                {
                                    var icon = x.EnviadoSap == true ? "✅" : (x.EnviadoSap == false ? "❌" : "—");
                                    var title = x.EnviadoSap == true
                                    ? $"Enviado{(x.FechaEnvioSap != null ? " (" + x.FechaEnvioSap.Value.ToString("dd/MM/yyyy HH:mm") + ")" : "")}"
                                    : (x.EnviadoSap == false
                                    ? $"Falló{(x.FechaEnvioSap != null ? " (" + x.FechaEnvioSap.Value.ToString("dd/MM/yyyy HH:mm") + ")" : "")}{(!string.IsNullOrWhiteSpace(x.MsgSap) ? " - " + x.MsgSap : "")}"
                                    : "Sin intento");

                                    <tr class="@(x.EnviadoSap == false ? "sap-error" : "")"
                                        data-ref="@x.ReferenciaDocMeat"
                                        data-fecha="@((x.FechaDocumento?.ToString("o")) ?? "")">

                                        <td class="text-center">
                                            <span style="font-size:11px;color:#9a6a6a;font-weight:700;display:block;margin-bottom:2px;">@(Model.IndexOf(x) + 1)</span>
                                            <input type="checkbox" class="ck" value="@x.ReferenciaDocMeat"
                                                   style="width:14px!important;height:14px!important;min-width:14px!important;" />
                                        </td>
                                        <td title="@((x.FechaDocumento?.ToString("dd/MM/yyyy HH:mm")) ?? "-")">@((x.FechaDocumento?.ToString("dd/MM/yyyy HH:mm")) ?? "-")</td>
                                        <td title="@x.SolicitudSurtidoId">@x.SolicitudSurtidoId</td>
                                        <td title="@((string.IsNullOrWhiteSpace(x.Cliente) ? "-" : x.Cliente))">@((string.IsNullOrWhiteSpace(x.Cliente) ? "-" : x.Cliente))</td>
                                        <td title="@x.Remision">@x.Remision</td>
                                        <td title="@x.ReferenciaDocMeat"><code style="font-size:11px;">@x.ReferenciaDocMeat</code></td>
                                        <td class="text-center">
                                            <span class="sap-est js-est" title="@title">@icon</span>
                                        </td>
                                        <td class="text-center">
                                            <span class="dev-est js-dev-est dev-unknown"
                                                  title="Devolución sin validar">⏳</span>
                                        </td>
                                        <td class="text-end">
                                            <div class="pm-actions" style="justify-content:flex-end;">
                                                <a class="pm-btn pm-btn-outline"
                                                   target="_blank"
                                                   href="@Url.Action("EntregaJson", "ProcesosCg", new { referencia = x.ReferenciaDocMeat, source = source })"
                                                   style="font-size:11px;">
                                                    <span class="pm-icon">📄</span> JSON
                                                </a>

                                                <button class="pm-btn pm-btn-warning js-traza"
                                                        type="button"
                                                        onclick="validarTrazabilidad('@x.ReferenciaDocMeat')"
                                                        style="font-size:11px;">
                                                    <span class="pm-icon">🔎</span> Trazabilidad
                                                </button>

                                                <button class="pm-btn pm-btn-success"
                                                        type="button"
                                                        onclick="abrirPdfConComentarios('@x.SolicitudSurtidoId', '@x.ReferenciaDocMeat')"
                                                        style="font-size:11px;">
                                                    <span class="pm-icon">📕</span> PDF
                                                </button>

                                                <button class="pm-btn pm-btn-primary js-send-one"
                                                        type="button"
                                                        onclick="sendOne('@x.ReferenciaDocMeat')"
                                                        style="font-size:11px;">
                                                    <span class="pm-icon">📤</span> Enviar
                                                </button>
                                                <div class="dropdown">
                                                    @*  <button class="pm-btn pm-btn-warning dropdown-toggle js-reserve"
            type="button"
            data-bs-toggle="dropdown"
            style="font-size:11px; opacity:.5; pointer-events:none;"
            aria-disabled="true">
        Reserva
    </button> *@
                                                    <ul class="dropdown-menu dropdown-menu-end">
                                                        <li>
                                                            <button class="dropdown-item" type="button"
                                                                    onclick="sendReserveByDelivery('@x.ReferenciaDocMeat')">
                                                                📦 Por entrega
                                                            </button>
                                                        </li>
                                                        <li>
                                                            <button class="dropdown-item" type="button"
                                                                    onclick="openReserveManual('@x.ReferenciaDocMeat')">
                                                                ✍️ Manual (KG)
                                                            </button>
                                                        </li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" class="text-center text-muted">Sin resultados.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Log -->
            <div id="logBox">
                <div id="log" class="log-inner log-secondary"></div>
            </div>

        </div>
    </div>

    <div class="statusbar">
        <div>Registro listo</div>
        <div>Usuario: @(User?.Identity?.Name ?? "")</div>
        <div>Empresa: Carnes G SA de CV</div>
        <div>Módulo: Entregas SAP</div>
    </div>

</div>

<div class="modal fade" id="pdfComentariosModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered pdf-modal-width">
        <div class="modal-content pdf-modal">

            <div class="pdf-modal-header">
                <div class="pdf-modal-title">
                    <span class="pdf-title-icon">📄</span>
                    Generar PDF con comentarios
                </div>

                <button type="button"
                        class="pdf-close"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar">
                    ×
                </button>
            </div>

            <div class="pdf-modal-body">

                <div class="pdf-icon-circle">
                    <span>PDF</span>
                </div>

                <h4 class="pdf-heading">Agrega comentarios para el PDF</h4>

                <div class="pdf-line"></div>

                <p class="pdf-subtitle">
                    Los comentarios que escribas se incluirán en el PDF
                    en la sección de Comentarios.
                </p>

                <div class="pdf-source-box">
                    <div class="pdf-source-title">Selecciona de dónde tomar los datos del PDF</div>

                    <div class="pdf-source-options">
                        <label class="pdf-source-option" for="pdfOrigenRemision">
                            <input type="radio"
                                   id="pdfOrigenRemision"
                                   name="pdfOrigenDatos"
                                   value="remision"
                                   checked />
                            <span>
                                <span class="pdf-source-name">Remisión / Surtido real</span>
                                <span class="pdf-source-desc">
                                    Usa lo que realmente se cargó y viene en el Meat de la entrega.
