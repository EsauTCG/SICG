                                        <label>Desde</label>
                                        <input type="date"
                                               class="form-control"
                                               name="desde"
                                               value="@desde.ToString("yyyy-MM-dd")" />
                                    </div>

                                    <div class="filter-group">
                                        <label>Hasta</label>
                                        <input type="date"
                                               class="form-control"
                                               name="hasta"
                                               value="@hasta.ToString("yyyy-MM-dd")" />
