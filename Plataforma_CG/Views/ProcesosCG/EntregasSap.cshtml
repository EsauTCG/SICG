<script>
    /* =====================================================================
       ENTREGAS SAP · lógica de la vista
       ===================================================================== */
    const SOURCE = '@source';
    const TODAY_ISO = '@DateTime.Today.ToString("yyyy-MM-dd")';
    const RESERVE_AFTER_MINUTES = 20;
    const AUTO_INTERVAL_MS = 5000;

    const URLS = {
        enviarEntrega: '@Url.Action("EnviarEntrega", "ProcesosCG")',
        validarDevoluciones: '@Url.Action("ValidarDevolucionesEntrega", "ProcesosCG")',
        trazabilidadRapida: '@Url.Action("ValidarTrazabilidadRapida", "ProcesosCG")',
        autocompletarJson: '@Url.Action("AutocompletarSapJson", "ProcesosCG")',
        autocompletarYEnviar: '@Url.Action("AutocompletarYEnviarEntregaSap", "ProcesosCG")',
        permisosAutocompletar: '@Url.Action("ObtenerPermisosAutocompletarSap", "ProcesosCG")',
        permisosEntregas: '@Url.Action("ObtenerPermisosVistaEntregas", "ProcesosCG")',
        autoSet: '@Url.Action("AutoSapSet", "ProcesosCG")',
        autoStatus: '@Url.Action("AutoSapStatus", "ProcesosCG")',
        reservaEntrega: '@Url.Action("EnviarFacturaReservaEntrega", "ProcesosCG")',
        reservaManual: '@Url.Action("EnviarFacturaReservaManual", "ProcesosCG")',
        entregaLines: '@Url.Action("GetEntregaLines", "ProcesosCG")',
        ordenVentaPdf: '@Url.Action("OrdenVentaPdf", "ProcesosCG")',
        pdfAgrupado: '@Url.Action("OrdenVentaPdfAgrupadoCliente", "ProcesosCG")',
        cartaPorte: '@Url.Action("CartaPorteInterna", "CartaPorteInterna")',
        inventarioJson: '@Url.Action("ConciliacionInventarioJson", "ProcesosCG")',
        inventarioExcel: '@Url.Action("ConciliacionInventarioExcel", "ProcesosCG")'
    };

    // =========================================================
    // AJUSTE TEMPORAL DE ENVÍO SAP
    // false = envía sin validar trazabilidad/devoluciones (modo prueba).
    // true  = obliga a validar antes de enviar. Cambiar a true en cuanto
    //         la comunicación con SAP/trazabilidad esté estable.
    // =========================================================
    const VALIDAR_TRAZABILIDAD_ANTES_DE_ENVIAR = false;

    let isSending = false;
    let trazabilidadRequestSeq = 0;
    let trazabilidadActualRef = '';
    let trazabilidadActualDetalle = [];
    let trazabilidadActualDevolucionesOk = false;
    let autocompletarSapBusy = false;
    let permisosEntregas = { puedeLeer: false, puedeEscribir: false, puedeEliminar: false };
    let permisosAutocompletarSap = { puedeLeer: false, puedeEscribir: false, puedeEliminar: false };
    let filtroVista = (document.getElementById('selEstatus')?.value) || 'todos';
    let filtroTexto = '';

    /* ---------------- Utilidades ---------------- */
    const $ = id => document.getElementById(id);
    const sleep = ms => new Promise(r => setTimeout(r, ms));

    function escapeHtml(value) {
        return String(value ?? '')
            .replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;')
            .replaceAll('"', '&quot;').replaceAll("'", '&#039;');
    }
    function toNumber(v) { const n = Number(v); return isNaN(n) ? 0 : n; }
    function formatKg(v) {
        return toNumber(v).toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
    function fmtInt(v) { return Number(v || 0).toLocaleString('es-MX'); }
    function getPropValue(obj, camel, pascal, fallback = '') {
        if (obj && obj[camel] !== undefined && obj[camel] !== null) return obj[camel];
        if (obj && obj[pascal] !== undefined && obj[pascal] !== null) return obj[pascal];
        return fallback;
    }
    function getArrayProp(obj, camel, pascal) {
        if (Array.isArray(obj?.[camel])) return obj[camel];
        if (Array.isArray(obj?.[pascal])) return obj[pascal];
        return [];
    }
    function loadingRow(colspan, texto) {
        return `<tr class="es-loading-row"><td colspan="${colspan}"><span class="es-spinner"></span>${escapeHtml(texto || 'Cargando…')}</td></tr>`;
    }
    function messageRow(colspan, html) {
        return `<tr><td colspan="${colspan}" class="text-center" style="white-space:normal;padding:18px 10px;">${html}</td></tr>`;
    }

    async function readResponse(res) {
        const ct = (res.headers.get('content-type') || '').toLowerCase();
        const t = await res.text();
        try { return JSON.parse(t); }
        catch {
            if (ct.includes('application/json')) {
                return { ok: false, msg: 'La respuesta dice ser JSON, pero no se pudo leer.', detalle: t };
            }
            return {
                ok: false,
                msg: ct.includes('text/html')
                    ? 'El servidor regresó HTML en lugar de JSON. Posible sesión vencida, error MVC o redirección a login.'
                    : 'El servidor no regresó JSON.',
                detalle: t.substring(0, 500)
            };
        }
    }

    function buildMsg(data, fallback) {
        if (!data) return fallback || '';
        let msg = data.msg || fallback || '';
        const extras = [];
        if (data.referencia) extras.push('Ref: ' + data.referencia);
        if (data.docNum) extras.push('DocNum: ' + data.docNum);
        if (data.docEntry) extras.push('DocEntry: ' + data.docEntry);
        if (extras.length) msg += ' (' + extras.join(' | ') + ')';
        return msg;
    }

    /* ---------------- Fechas de producción ---------------- */
    function getFechaProduccion(obj) {
        return getPropValue(obj, 'fechaProduccion', 'FechaProduccion', null)
            ?? getPropValue(obj, 'fechaProduccionLote', 'FechaProduccionLote', null)
            ?? getPropValue(obj, 'productionDate', 'ProductionDate', null);
    }
    function parseFechaFlexible(value) {
        if (value === undefined || value === null || String(value).trim() === '') return null;
        const raw = String(value).trim();
        const iso = raw.match(/^(\d{4})-(\d{2})-(\d{2})/);
        if (iso) return { y: iso[1], m: iso[2], d: iso[3] };
        const asp = raw.match(/\/Date\(([-+]?\d+)/);
        const dt = asp ? new Date(Number(asp[1])) : new Date(raw);
        if (Number.isNaN(dt.getTime())) return { raw };
        return { y: String(dt.getFullYear()), m: String(dt.getMonth() + 1).padStart(2, '0'), d: String(dt.getDate()).padStart(2, '0') };
    }
    function formatFecha(value) {
        const f = parseFechaFlexible(value);
        if (!f) return '-';
        return f.raw ? f.raw : `${f.d}/${f.m}/${f.y}`;
    }
    function getFechaIsoKey(value) {
        const f = parseFechaFlexible(value);
        return f && !f.raw ? `${f.y}-${f.m}-${f.d}` : '';
    }
    function esProduccionHoy(obj) {
        const flag = getPropValue(obj, 'esProduccionHoy', 'EsProduccionHoy', null);
        if (flag === true || String(flag).toLowerCase() === 'true') return true;
        return getFechaIsoKey(getFechaProduccion(obj)) === TODAY_ISO;
    }
    function htmlFechaProduccion(obj) {
        const texto = formatFecha(getFechaProduccion(obj));
        if (texto === '-') return '<span class="es-muted">-</span>';
        if (esProduccionHoy(obj)) {
            return `<span class="trz-fecha-hoy" title="Este lote corresponde a producción de hoy">${escapeHtml(texto)}<small>Producción de hoy</small></span>`;
        }
        return `<span>${escapeHtml(texto)}</span>`;
    }

    /* ---------------- Bitácora ---------------- */
    const LOG_MAX = 40;
    function showLog(type, text) {
        const list = $('esLogList');
        if (!list) return;
        list.querySelector('.es-log__empty')?.remove();
        const li = document.createElement('li');
        li.className = 'es-log__item es-log__item--' + (type || 'secondary');
        const hora = new Date().toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
        li.innerHTML = `<span class="es-log__time">${hora}</span><span class="es-log__msg"></span>`;
        li.querySelector('.es-log__msg').textContent = text || '';
        list.prepend(li);
        while (list.children.length > LOG_MAX) list.lastElementChild.remove();
        const st = $('esStatusMsg');
        if (st) st.textContent = String(text || '').split('\n')[0];
    }

    /* ---------------- Filas, estatus y filtros ---------------- */
    function getRows() { return Array.from(document.querySelectorAll('#tblEntregasBody tr[data-ref]')); }
    function getRowByRef(ref) { return document.querySelector(`#tblEntregasBody tr[data-ref="${CSS.escape(ref)}"]`); }
    function getSapState(row) { return row?.dataset.sap || 'none'; }

    const SAP_UI = {
        ok: { cls: 'es-pill--ok', label: 'Enviada' },
        fail: { cls: 'es-pill--bad', label: 'Fallida' },
        none: { cls: 'es-pill--neutral', label: 'Pendiente' }
    };

    function setRowStatus(ref, ok, msg) {
        const row = getRowByRef(ref);
        if (!row) return;
        const state = ok === true ? 'ok' : (ok === false ? 'fail' : 'none');
        row.dataset.sap = state;
        row.classList.toggle('sap-error', state === 'fail');
        const el = row.querySelector('.js-est');
        if (el) {
            el.className = 'es-pill js-est ' + SAP_UI[state].cls;
            el.textContent = SAP_UI[state].label;
            el.title = msg || SAP_UI[state].label;
        }
        updateReserveButtons();
        actualizarKpisEntregasSap();
        aplicarFiltros();
    }

    function isDevBad(row) {
        const cls = row.querySelector('.js-dev-est')?.className || '';
        return cls.includes('dev-pending') || cls.includes('dev-diff');
    }
    function isDevResolved(row) {
        const cls = row.querySelector('.js-dev-est')?.className || '';
        return cls.includes('dev-ok') || cls.includes('dev-none');
    }

    function rowMatchesVista(row) {
        const s = getSapState(row);
        switch (filtroVista) {
            case 'enviados': return s === 'ok';
            case 'noenviados': return s !== 'ok';
            case 'pendientes': return s === 'none';
            case 'fallidas': return s === 'fail';
            case 'devrevisar': return isDevBad(row);
            default: return true;
        }
    }

    function aplicarFiltros() {
        const rows = getRows();
        let visibles = 0;
        rows.forEach(r => {
            const texto = [r.dataset.ref, r.dataset.solicitud, r.dataset.cliente, r.dataset.remision].join(' ').toLowerCase();
            const show = (!filtroTexto || texto.includes(filtroTexto)) && rowMatchesVista(r);
            r.hidden = !show;
            if (show) visibles++;
        });
        const cnt = $('esVisibleCount');
        if (cnt) cnt.textContent = `${fmtInt(visibles)} de ${fmtInt(rows.length)}`;
        const noMatch = $('esNoMatch');
        if (noMatch) noMatch.hidden = !(rows.length > 0 && visibles === 0);
        document.querySelectorAll('.es-kpi[data-filter]').forEach(k =>
            k.classList.toggle('is-active', filtroVista !== 'todos' && k.dataset.filter === filtroVista));
        actualizarCheckboxTodos();
    }

    function setFiltroVista(valor) {
        filtroVista = valor || 'todos';
        const sel = $('selEstatus');
        if (sel) sel.value = filtroVista;
        aplicarFiltros();
    }

    /* ---------------- Selección ---------------- */
    function syncRowSelected(ck) {
        ck.closest('tr')?.classList.toggle('is-selected', ck.checked);
    }
    // Selecciona solo las filas visibles (respeta el filtro activo).
    function selectAll(on) {
        getRows().filter(r => !r.hidden).forEach(r => {
            const ck = r.querySelector('.ck');
            if (ck) { ck.checked = !!on; syncRowSelected(ck); }
        });
        actualizarKpisEntregasSap();
        actualizarCheckboxTodos();
    }
    function actualizarCheckboxTodos() {
        const all = $('ckAll');
        if (!all) return;
        const checks = getRows().filter(r => !r.hidden).map(r => r.querySelector('.ck')).filter(Boolean);
        const marcados = checks.filter(x => x.checked).length;
        all.checked = checks.length > 0 && marcados === checks.length;
        all.indeterminate = marcados > 0 && marcados < checks.length;
    }

    /* ---------------- Indicadores ---------------- */
    function actualizarKpisEntregasSap() {
        const rows = getRows();
        const c = { total: rows.length, ok: 0, fail: 0, none: 0, sel: 0, devBad: 0, devOk: 0 };
        rows.forEach(r => {
            c[getSapState(r)]++;
            if (r.querySelector('.ck')?.checked) c.sel++;
            if (isDevBad(r)) c.devBad++;
            else if (isDevResolved(r)) c.devOk++;
        });
        const setText = (id, v) => { const el = $(id); if (el) el.textContent = fmtInt(v); };
        setText('kpiSapTotal', c.total);
        setText('kpiSapEnviadas', c.ok);
        setText('kpiSapPendientes', c.none);
        setText('kpiSapFallidas', c.fail);
        setText('kpiSapSeleccionadas', c.sel);
        setText('kpiSapDevRevisar', c.devBad);

        const pct = v => c.total ? (v / c.total * 100) : 0;
        if ($('barOk')) $('barOk').style.width = pct(c.ok) + '%';
        if ($('barNone')) $('barNone').style.width = pct(c.none) + '%';
        if ($('barFail')) $('barFail').style.width = pct(c.fail) + '%';
        const pctTxt = $('kpiSapEnviadasPct');
        if (pctTxt) pctTxt.textContent = c.total ? `${Math.round(pct(c.ok))}% del total` : 'Confirmadas por SAP';

        const pdfCount = $('pdfSelCount');
        if (pdfCount) { pdfCount.textContent = fmtInt(c.sel); pdfCount.dataset.zero = c.sel ? '0' : '1'; }

        const card = $('kpiSapDevCard');
        const txt = $('kpiSapDevTexto');
        const sinValidar = Math.max(c.total - c.devBad - c.devOk, 0);
        if (card) {
            card.classList.remove('ok', 'warn', 'bad');
            if (c.devBad > 0) { card.classList.add('bad'); if (txt) txt.textContent = 'Con diferencias o pendientes'; }
            else if (sinValidar > 0) { card.classList.add('warn'); if (txt) txt.textContent = `${fmtInt(sinValidar)} sin validar`; }
            else { card.classList.add('ok'); if (txt) txt.textContent = 'Todas correctas'; }
        }
    }

    /* ---------------- Permisos ---------------- */
    // Las acciones de escritura arrancan ocultas y solo aparecen si el servidor confirma el permiso.
    async function cargarPermisosEntregas() {
        try {
            const r = await fetch(URLS.permisosEntregas, { credentials: 'same-origin', cache: 'no-store' });
            if (r.ok) permisosEntregas = await r.json();
        } catch (e) {
            console.error('Error al verificar seguridad:', e);
        }
        $('esApp')?.classList.toggle('no-write', !permisosEntregas?.puedeEscribir);
    }

    async function cargarPermisosAutocompletarSap() {
        try {
            const r = await fetch(URLS.permisosAutocompletar, { credentials: 'same-origin', cache: 'no-store' });
            permisosAutocompletarSap = r.ok ? await r.json() : { puedeLeer: false, puedeEscribir: false, puedeEliminar: false };
        } catch (e) {
            console.error('Error al consultar AUTOCOMPLETAR_SAP:', e);
            permisosAutocompletarSap = { puedeLeer: false, puedeEscribir: false, puedeEliminar: false };
        }
        actualizarBotonAutocompletarSap();
    }

    /* ---------------- Envío a SAP ---------------- */
    function setSendButtonsDisabled(disabled) {
        document.querySelectorAll('.js-send-one, #btnAuto, #btnAutocompletarSap, #btnVerJsonAutocompletarSap')
            .forEach(btn => { btn.disabled = !!disabled; });
    }

    async function validarPrevioEnvioSap(ref) {
        if (!ref) { showLog('warning', 'Referencia vacía. No se puede enviar a SAP.'); return false; }
        if (!VALIDAR_TRAZABILIDAD_ANTES_DE_ENVIAR) {
            showLog('warning', 'Modo prueba: se omitió la validación previa de trazabilidad/devoluciones para ' + ref + '.');
            return true;
        }
        try { return await validarTrazabilidad(ref, false); }
        catch (e) {
            showLog('danger', 'No se pudo validar trazabilidad/devoluciones para ' + ref + ': ' + (e?.message || e));
            return false;
        }
    }

    async function postEnviarEntregaSap(ref) {
        const res = await fetch(URLS.enviarEntrega, {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'referencia=' + encodeURIComponent(ref) + '&source=' + encodeURIComponent(SOURCE)
        });
        return { res, data: await readResponse(res) };
    }

    async function sendOne(ref) {
        if (isSending) { showLog('warning', 'Hay un envío en proceso. Espera a que termine.'); return; }
        isSending = true;
        setSendButtonsDisabled(true);
        try {
            if (!await validarPrevioEnvioSap(ref)) {
                setRowStatus(ref, false, 'Pendiente de trazabilidad/devolución SAP');
                return;
            }
            showLog('info', 'Enviando entrega a SAP: ' + ref + '…');
            const { res, data } = await postEnviarEntregaSap(ref);
            if (res.ok && data?.ok) {
                const m = buildMsg(data, 'Enviada con éxito.');
                setRowStatus(ref, true, m);
                showLog('success', m);
            } else {
                const err = buildMsg(data, 'No se pudo enviar.');
                setRowStatus(ref, false, err);
                showLog('danger', err + (data?.detalle ? '\n' + data.detalle : ''));
            }
        } catch (e) {
            setRowStatus(ref, false, 'Error de red');
            showLog('danger', 'Error de red al enviar a SAP: ' + (e?.message || e));
        } finally {
            isSending = false;
            setSendButtonsDisabled(false);
        }
    }

    async function sendManyRefs(refs, etiqueta) {
        if (isSending || !refs?.length) return;
        isSending = true;
        setSendButtonsDisabled(true);
        let okCount = 0, failCount = 0, bloqueadas = 0;
        try {
            showLog('info', `${etiqueta || 'Envío'}: ${refs.length} entrega(s) a SAP…`);
            for (const ref of refs) {
                if (getSapState(getRowByRef(ref)) === 'ok') continue;
                if (!await validarPrevioEnvioSap(ref)) {
                    failCount++; bloqueadas++;
                    setRowStatus(ref, false, 'Pendiente de trazabilidad/devolución SAP');
                    continue;
                }
                const { res, data } = await postEnviarEntregaSap(ref);
                if (res.ok && data?.ok) { okCount++; setRowStatus(ref, true, buildMsg(data, 'Enviada.')); }
                else { failCount++; setRowStatus(ref, false, buildMsg(data, `Falló: ${ref}`)); }
            }
            let resumen = `${etiqueta || 'Envío'} terminado. OK: ${okCount} | Fallidas: ${failCount}`;
            if (bloqueadas) resumen += ` | Bloqueadas por validación: ${bloqueadas}`;
            showLog(failCount === 0 ? 'success' : 'warning', resumen);
        } catch (e) {
            showLog('danger', 'Error de red en envío a SAP: ' + (e?.message || e));
        } finally {
            isSending = false;
            setSendButtonsDisabled(false);
        }
    }

    // Se conserva por compatibilidad (el botón masivo estaba deshabilitado en la versión anterior).
    async function sendMany() {
        const refs = Array.from(document.querySelectorAll('#tblEntregasBody .ck:checked')).map(x => x.value).filter(Boolean);
        if (!refs.length) { showLog('warning', 'Selecciona al menos una entrega.'); return; }
        await sendManyRefs(refs, 'Envío masivo');
    }

    /* ---------------- Auto envío ---------------- */
    let autoEnabled = false, autoTimer = null, autoRefreshTimer = null;

    function getAutoRefsToSend() {
        return getRows().filter(r => getSapState(r) !== 'ok').map(r => r.dataset.ref).filter(Boolean);
    }

    function updateAutoButton() {
        const b = $('btnAuto');
        if (!b) return;
        b.classList.toggle('is-on', autoEnabled);
        b.title = autoEnabled ? 'Auto envío: encendido. Clic para apagar.' : 'Auto envío: apagado. Clic para encender.';
    }

    async function serverAutoSet(enabled) {
        const res = await fetch(URLS.autoSet, {
            method: 'POST', credentials: 'same-origin',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: 'enabled=' + encodeURIComponent(enabled) + '&source=ALL&intervalMs=' + encodeURIComponent(AUTO_INTERVAL_MS)
        });
        const data = await readResponse(res);
        if (!res.ok || !data?.ok) throw new Error(data?.msg || 'Error auto servidor');
        return data;
    }

    async function serverAutoStatus() {
        const res = await fetch(URLS.autoStatus + '?source=ALL', { credentials: 'same-origin', cache: 'no-store' });
        const data = await readResponse(res);
        if (!res.ok || !data?.ok) throw new Error(data?.msg || 'Error estado auto');
        return data;
    }

    function startAutoRefresh() {
        if (autoRefreshTimer) clearInterval(autoRefreshTimer);
        autoRefreshTimer = setInterval(async () => {
            if (!autoEnabled) return;
            try { await refreshSapTableSilentSafe(); }
            catch (e) { console.warn('Auto refresh:', e); }
        }, 30000);
    }
    function stopAutoRefresh() { if (autoRefreshTimer) clearInterval(autoRefreshTimer); autoRefreshTimer = null; }

    function stopAuto() {
        autoEnabled = false;
        if (autoTimer) clearInterval(autoTimer);
        autoTimer = null;
        stopAutoRefresh();
        updateAutoButton();
        showLog('secondary', 'Auto envío apagado.');
        serverAutoSet(false).catch(e => console.warn(e));
    }

    async function startAuto() {
        autoEnabled = true;
        updateAutoButton();
        showLog('info', 'Encendiendo auto envío…');
        try {
            const r = await serverAutoSet(true);
            if (r?.msg) showLog('info', r.msg);
        } catch (e) {
            showLog('danger', 'No se pudo encender el auto envío en el servidor: ' + (e?.message || e));
            autoEnabled = false; updateAutoButton(); return;
        }
        const first = getAutoRefsToSend();
        if (first.length) await sendManyRefs(first, 'Auto envío');
        if (autoTimer) clearInterval(autoTimer);
        autoTimer = setInterval(async () => {
            if (!autoEnabled || isSending) return;
            const refs = getAutoRefsToSend();
            if (refs.length) await sendManyRefs(refs, 'Auto envío');
        }, AUTO_INTERVAL_MS);
        startAutoRefresh();
    }

    async function initAutoState() {
        try {
            const s = await serverAutoStatus();
            const anyOn = (s?.all || []).some(x => x.enabled === true || x.Enabled === true);
            if (anyOn) {
                autoEnabled = true;
                showLog('info', 'El auto envío ya estaba encendido en el servidor.');
                startAutoRefresh();
            }
        } catch (e) { console.warn('AutoSapStatus error:', e); }
        updateAutoButton();
    }

    /* ---------------- Refresco silencioso de la tabla ---------------- */
    // Conserva selección, estatus de devoluciones ya validados, scroll, filtros e indicadores.
    async function refreshSapTableSilentSafe() {
        const tbody = $('tblEntregasBody');
        const wrap = $('esMainWrap');
        if (!tbody) return;

        const checked = new Set(Array.from(tbody.querySelectorAll('.ck:checked')).map(x => x.value));
        const devPrev = new Map();
        getRows().forEach(r => {
            const d = r.querySelector('.js-dev-est');
            if (d && !d.classList.contains('dev-unknown')) devPrev.set(r.dataset.ref, d.cloneNode(true));
        });
        const scrollTop = wrap?.scrollTop || 0;

        const res = await fetch(window.location.href, { credentials: 'same-origin', cache: 'no-store' });
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const doc = new DOMParser().parseFromString(await res.text(), 'text/html');
        const nuevo = doc.getElementById('tblEntregasBody');
        if (!nuevo) { showLog('warning', 'No se pudo refrescar la tabla. Posible sesión vencida.'); return; }

        tbody.replaceWith(document.importNode(nuevo, true));

        getRows().forEach(r => {
            const ck = r.querySelector('.ck');
            if (ck && checked.has(ck.value)) { ck.checked = true; syncRowSelected(ck); }
            const prev = devPrev.get(r.dataset.ref);
            const cur = r.querySelector('.js-dev-est');
            if (prev && cur) cur.replaceWith(prev);
        });
        if (wrap) wrap.scrollTop = scrollTop;

        updateReserveButtons();
        actualizarKpisEntregasSap();
        aplicarFiltros();
    }

    /* ---------------- Devoluciones por fila ---------------- */
    function getDevResumenFromData(data) {
        const devoluciones = getArrayProp(data, 'devoluciones', 'Devoluciones');
        const devolucionError = getPropValue(data, 'devolucionError', 'DevolucionError', '');

        if (!devoluciones.length) {
            if (devolucionError) return { cls: 'dev-diff', title: 'Error al consultar devoluciones: ' + devolucionError, texto: 'Error' };
            return { cls: 'dev-none', title: 'Sin devolución Meat para comparar', texto: 'Sin devolución' };
        }

        const estatus = devoluciones.map(x => String(getPropValue(x, 'estatus', 'Estatus', '')).toUpperCase()).join('|');
        const kgMeat = devoluciones.reduce((s, x) => s + toNumber(getPropValue(x, 'kgDevueltosMeat', 'KgDevueltosMeat', 0)), 0);
        const kgSap = devoluciones.reduce((s, x) => s + toNumber(getPropValue(x, 'kgDevueltosSap', 'KgDevueltosSap', 0)), 0);
        const dif = devoluciones.reduce((s, x) => s + toNumber(getPropValue(x, 'diferenciaKg', 'DiferenciaKg', 0)), 0);
        const base = `Meat: ${formatKg(kgMeat)} kg | SAP: ${formatKg(kgSap)} kg | Dif: ${formatKg(dif)} kg`;

        if (estatus.includes('PENDIENTE')) return { cls: 'dev-pending', title: 'Devolución pendiente en SAP. ' + base, texto: 'Pendiente' };
        if (estatus.includes('DIFERENCIA') || estatus.includes('FALTA') || estatus.includes('SOBRANTE'))
            return { cls: 'dev-diff', title: 'Devolución con diferencia. ' + base, texto: 'Diferencia' };
        if (estatus.includes('APLICADA')) return { cls: 'dev-ok', title: 'Devolución aplicada en SAP. ' + base, texto: 'Aplicada' };
        return { cls: 'dev-diff', title: 'Devolución requiere revisión. ' + base, texto: 'Revisar' };
    }

    function setDevPill(row, cls, texto, title) {
        row?.querySelectorAll('.js-dev-est').forEach(el => {
            el.className = 'es-pill dev-est js-dev-est ' + cls;
            el.textContent = texto;
            el.title = title;
            el.setAttribute('data-dev-status', texto);
        });
    }

    function actualizarEstatusDevolucionFila(ref, data) {
        const info = getDevResumenFromData(data);
        setDevPill(getRowByRef(ref), info.cls, info.texto, info.title);
        actualizarKpisEntregasSap();
        if (filtroVista === 'devrevisar') aplicarFiltros();
    }

    async function validarDevolucionFila(ref) {
        try {
            const res = await fetch(URLS.validarDevoluciones + '?referencia=' + encodeURIComponent(ref) + '&source=' + encodeURIComponent(SOURCE),
                { credentials: 'same-origin' });
            const data = await readResponse(res);
            actualizarEstatusDevolucionFila(ref, data);
            return data;
        } catch (e) {
            setDevPill(getRowByRef(ref), 'dev-diff', 'Error', 'Error al validar devolución: ' + (e?.message || e));
            actualizarKpisEntregasSap();
            return null;
        }
    }

    /* ---------------- Auto devoluciones ---------------- */
    const DEV_AUTO_KEY = `entregas_dev_auto_${SOURCE}`;
    const DEV_AUTO_INTERVAL_MS = 3 * 60 * 1000;
    let devAutoTimer = null;
    let devAutoBusy = false;

    function storageGet(k) { try { return localStorage.getItem(k); } catch { return null; } }
    function storageSet(k, v) { try { localStorage.setItem(k, v); } catch { } }

    async function validarDevolucionesAutomatico() {
        if (devAutoBusy) return;
        const refs = getRows().filter(r => !r.hidden).map(r => r.dataset.ref).filter(Boolean);
        if (!refs.length) { showLog('secondary', 'Auto devoluciones: no hay entregas visibles para validar.'); return; }

        devAutoBusy = true;
        try {
            showLog('info', `Validando devoluciones de ${refs.length} entrega(s)…`);
            for (const ref of refs) {
                setDevPill(getRowByRef(ref), 'dev-unknown', 'Validando…', 'Validando devolución…');
                await validarDevolucionFila(ref);
                await sleep(120); // pausa para no saturar SQL / Service Layer
            }
            showLog('success', `Validación de devoluciones terminada: ${refs.length} entrega(s) revisadas.`);
        } catch (e) {
            showLog('danger', 'Error al validar devoluciones: ' + (e?.message || e));
        } finally {
            devAutoBusy = false;
        }
    }

    function setAutoDevUi(activo) {
        const btn = $('btnAutoDev');
        if (!btn) return;
        btn.classList.toggle('is-on', activo);
        btn.title = activo
            ? 'Validación automática de devoluciones: encendida (cada 3 min).'
            : 'Validación automática de devoluciones: apagada.';
    }
    function iniciarAutoDev() {
        detenerAutoDev(false);
        storageSet(DEV_AUTO_KEY, '1');
        setAutoDevUi(true);
        validarDevolucionesAutomatico();
        devAutoTimer = setInterval(validarDevolucionesAutomatico, DEV_AUTO_INTERVAL_MS);
    }
    function detenerAutoDev(persistir = true) {
        if (devAutoTimer) { clearInterval(devAutoTimer); devAutoTimer = null; }
        if (persistir) storageSet(DEV_AUTO_KEY, '0');
        setAutoDevUi(false);
    }
    function toggleAutoDev() {
        if (storageGet(DEV_AUTO_KEY) === '1') { detenerAutoDev(); showLog('warning', 'Auto devoluciones apagado.'); }
        else { iniciarAutoDev(); showLog('success', 'Auto devoluciones encendido.'); }
    }

    /* ---------------- Reserva (funciones conservadas) ---------------- */
    let currentReserveRef = null;

    function canEnableReserve(row) {
        if (getSapState(row) === 'ok') return false;
        const d = row?.dataset.fecha ? new Date(row.dataset.fecha) : null;
        if (!d || isNaN(d.getTime())) return false;
        return (Date.now() - d.getTime()) / 60000 >= RESERVE_AFTER_MINUTES;
    }
    function updateReserveButtons() {
        getRows().forEach(row => {
            row.querySelectorAll('.js-reserve').forEach(btn => {
                const enabled = canEnableReserve(row);
                btn.setAttribute('aria-disabled', enabled ? 'false' : 'true');
                btn.title = enabled ? 'Generar y enviar factura de reserva' : 'Disponible 20 min después de la entrega, si no se envió';
            });
        });
    }

    async function sendReserveByDelivery(ref) {
        if (!confirm(`¿Generar factura de reserva COMPLETA para la entrega ${ref}?`)) return;
        showLog('info', 'Generando reserva por entrega: ' + ref);
        try {
            const res = await fetch(URLS.reservaEntrega, {
                method: 'POST', credentials: 'same-origin',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'referencia=' + encodeURIComponent(ref) + '&source=' + encodeURIComponent(SOURCE)
            });
            const data = await readResponse(res);
            const ok = res.ok && data?.ok;
            showLog(ok ? 'success' : 'danger', buildMsg(data, ok ? 'Reserva enviada.' : 'No se pudo generar la reserva.'));
        } catch (e) { showLog('danger', 'Error de red: ' + e.message); }
    }

    async function openReserveManual(ref) {
        currentReserveRef = ref;
        const body = $('reserveLinesBody');
        body.innerHTML = loadingRow(2, 'Cargando artículos…');
        bootstrap.Modal.getOrCreateInstance($('reserveKgModal')).show();
        try {
            const res = await fetch(`${URLS.entregaLines}?referencia=${encodeURIComponent(ref)}&source=${encodeURIComponent(SOURCE)}`, { credentials: 'same-origin' });
            const data = await res.json();
            body.innerHTML = data.map(x => `
                        <tr>
                            <td>${escapeHtml(x.itemCode)}</td>
                            <td class="text-end">
                                <input type="number" class="es-input reserve-qty" style="width:110px;display:inline-block;text-align:right;"
                                       data-baseline="${escapeHtml(x.baseLine)}" max="${escapeHtml(x.openQuantity)}" min="0" step="0.01" placeholder="0.00">
                            </td>
                        </tr>`).join('');
        } catch (e) {
            body.innerHTML = messageRow(2, 'No se pudieron cargar los artículos.');
        }
    }

    async function sendReserveKg() {
        const lines = [];
        document.querySelectorAll('.reserve-qty').forEach(inp => {
            const qty = parseFloat(inp.value);
            if (qty > 0) lines.push({ baseLine: parseInt(inp.dataset.baseline), quantity: qty });
        });
        if (!lines.length) { alert('Captura al menos un kg.'); return; }
        if (!confirm('¿Generar reserva MANUAL con los kg capturados?')) return;
        showLog('info', 'Generando reserva manual…');
        try {
            const res = await fetch(URLS.reservaManual, {
                method: 'POST', credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ referencia: currentReserveRef, source: SOURCE, lines })
            });
            const data = await readResponse(res);
            if (res.ok && data?.ok) {
                showLog('success', buildMsg(data, 'Reserva manual enviada.'));
                bootstrap.Modal.getInstance($('reserveKgModal'))?.hide();
            } else {
                showLog('danger', buildMsg(data, 'Error al generar la reserva.'));
            }
        } catch (e) { showLog('danger', 'Error de red: ' + e.message); }
    }

    /* =====================================================================
       TRAZABILIDAD
       ===================================================================== */
    const TRZ_ICON = { info: 'bi-hourglass-split', ok: 'bi-check-circle-fill', warn: 'bi-exclamation-triangle-fill', bad: 'bi-x-octagon-fill' };
    function setTrzAlert(tipo, titulo, texto) {
        const box = $('trzAlertBox'); if (box) box.className = 'es-alert es-alert--' + tipo;
        const ic = $('trzAlertIcon'); if (ic) ic.className = 'bi ' + TRZ_ICON[tipo];
        if (titulo != null && $('trzAlertTitle')) $('trzAlertTitle').textContent = titulo;
        if (texto != null && $('trzAlertText')) $('trzAlertText').textContent = texto;
    }

    function badgeInfo(estatus) {
        const e = String(estatus || '').toUpperCase();
        if (e.includes('APLICADA') || e.includes('OK EXACTO') || e.includes('OK CON SOBRANTE')) return 'es-pill--ok';
        if (e.includes('PENDIENTE') || e.includes('DIFERENCIA') || e.includes('FALTA') || e.includes('NO EXISTE') ||
            e.includes('SIN DISPONIBLE') || e.includes('SOBRANTE SAP')) return 'es-pill--bad';
        return 'es-pill--warn';
    }
    const pill = (cls, txt) => `<span class="es-pill ${cls}">${escapeHtml(txt)}</span>`;

    function prepararModalTrazabilidad(ref) {
        trazabilidadActualRef = ref || '';
        trazabilidadActualDetalle = [];
        trazabilidadActualDevolucionesOk = false;
        actualizarBotonAutocompletarSap();

        $('trzRef').textContent = ref || '-';
        ['trzTotalPartidas', 'trzKgSolicitados', 'trzKgFaltantes', 'devTotalPartidas', 'devKgMeat', 'devKgSap',
            'devKgDif', 'devTotalAplicadas', 'devTotalPendientes'].forEach(id => { $(id).textContent = '…'; });

        setTrzAlert('info', 'Abriendo detalle de trazabilidad…', 'Primero se cargan los lotes y después las devoluciones.');
        $('trzDetalleBody').innerHTML = loadingRow(8, 'Consultando lotes, fechas de producción y disponibilidad SAP…');
        $('devDetalleBody').innerHTML = loadingRow(9, 'Las devoluciones se consultan al terminar los lotes…');

        bootstrap.Modal.getOrCreateInstance($('trazabilidadModal')).show();
    }

    function renderizarTrazabilidadRapida(ref, data) {
        const detalle = getArrayProp(data, 'detalle', 'Detalle');
        const kgSol = detalle.reduce((s, x) => s + toNumber(getPropValue(x, 'kgSolicitadosJson', 'KgSolicitadosJson', 0)), 0);
        const kgFalt = detalle.reduce((s, x) => s + toNumber(getPropValue(x, 'kgFaltantes', 'KgFaltantes', 0)), 0);
        const hayError = detalle.some(x => {
            const e = String(getPropValue(x, 'estatus', 'Estatus', '')).toUpperCase();
            return e.includes('NO EXISTE') || e.includes('SIN DISPONIBLE') || e.includes('FALTAN KG') ||
                e.includes('JSON SIN LOTES') || e.includes('JSON VACÍO');
        });

        $('trzRef').textContent = ref || '-';
        $('trzTotalPartidas').textContent = fmtInt(detalle.length);
        $('trzKgSolicitados').textContent = formatKg(kgSol);
        $('trzKgFaltantes').textContent = formatKg(kgFalt);

        $('trzDetalleBody').innerHTML = !detalle.length
            ? messageRow(8, 'No se recibió detalle de trazabilidad.')
            : detalle.map(x => {
                const estatus = getPropValue(x, 'estatus', 'Estatus', '');
                return `
                            <tr class="${esProduccionHoy(x) ? 'trz-row-produccion-hoy' : ''}">
                                <td>${escapeHtml(getPropValue(x, 'articulo', 'Articulo', ''))}</td>
                                <td>${escapeHtml(getPropValue(x, 'almacen', 'Almacen', ''))}</td>
                                <td>${escapeHtml(getPropValue(x, 'lote', 'Lote', ''))}</td>
                                <td>${htmlFechaProduccion(x)}</td>
                                <td class="text-end es-num">${formatKg(getPropValue(x, 'kgSolicitadosJson', 'KgSolicitadosJson', 0))}</td>
                                <td class="text-end es-num">${formatKg(getPropValue(x, 'disponibleSap', 'DisponibleSap', 0))}</td>
                                <td class="text-end es-num">${formatKg(getPropValue(x, 'kgFaltantes', 'KgFaltantes', 0))}</td>
                                <td>${pill(badgeInfo(estatus), estatus)}</td>
                            </tr>`;
            }).join('');

        if (hayError) setTrzAlert('warn', 'Se encontraron diferencias de trazabilidad.', 'Los lotes ya están visibles. Las devoluciones se siguen consultando.');
        else setTrzAlert('ok', 'Trazabilidad correcta.', 'Los lotes están disponibles. Consultando devoluciones Meat vs SAP…');

        trazabilidadActualRef = ref || '';
        trazabilidadActualDetalle = detalle;
        actualizarBotonAutocompletarSap();
        return { ok: !hayError, hayError, detalle };
    }

    function renderizarErrorTrazabilidad(error) {
        trazabilidadActualDetalle = [];
        trazabilidadActualDevolucionesOk = false;
        actualizarBotonAutocompletarSap();
        $('trzTotalPartidas').textContent = '0';
        $('trzKgSolicitados').textContent = '0.00';
        $('trzKgFaltantes').textContent = '0.00';
        $('trzDetalleBody').innerHTML = messageRow(8, `<b>No se pudo cargar la trazabilidad.</b><br>${escapeHtml(error?.message || error || 'Error desconocido')}`);
        setTrzAlert('bad', 'Error al consultar trazabilidad.', 'Las devoluciones pueden seguir cargándose, pero la entrega requiere revisión.');
        return { ok: false, hayError: true, detalle: [] };
    }

    function renderizarDevolucionesTrazabilidad(data, estadoTraza) {
        const devoluciones = getArrayProp(data, 'devoluciones', 'Devoluciones');
        const devolucionError = getPropValue(data, 'devolucionError', 'DevolucionError', '');
        const sum = (k, K) => devoluciones.reduce((s, x) => s + toNumber(getPropValue(x, k, K, 0)), 0);
        const estatusDe = x => String(getPropValue(x, 'estatus', 'Estatus', '')).toUpperCase();
        const esProblema = e => e.includes('PENDIENTE') || e.includes('DIFERENCIA') || e.includes('FALTA') || e.includes('SOBRANTE');

        const aplicadas = devoluciones.filter(x => estatusDe(x).includes('APLICADA')).length;
        const pendientes = devoluciones.filter(x => esProblema(estatusDe(x))).length;
        const hayErrorDev = Boolean(devolucionError) || pendientes > 0;

        $('devTotalPartidas').textContent = fmtInt(devoluciones.length);
        $('devKgMeat').textContent = formatKg(sum('kgDevueltosMeat', 'KgDevueltosMeat'));
        $('devKgSap').textContent = formatKg(sum('kgDevueltosSap', 'KgDevueltosSap'));
        $('devKgDif').textContent = formatKg(sum('diferenciaKg', 'DiferenciaKg'));
        $('devTotalAplicadas').textContent = fmtInt(aplicadas);
        $('devTotalPendientes').textContent = fmtInt(pendientes);

        const devBody = $('devDetalleBody');
        if (devolucionError) {
            devBody.innerHTML = messageRow(9, `<b>No se pudieron consultar las devoluciones.</b><br>${escapeHtml(devolucionError)}`);
        } else if (!devoluciones.length) {
            devBody.innerHTML = messageRow(9, 'Sin devoluciones Meat para comparar.');
        } else {
            devBody.innerHTML = devoluciones.map(x => {
                const estatus = getPropValue(x, 'estatus', 'Estatus', '');
                const docNum = getPropValue(x, 'docNumDevolucion', 'DocNumDevolucion', '');
                return `
                            <tr>
                                <td>${escapeHtml(getPropValue(x, 'pedidoSap', 'PedidoSap', ''))}</td>
                                <td>${escapeHtml(getPropValue(x, 'articulo', 'Articulo', ''))}</td>
                                <td>${escapeHtml(getPropValue(x, 'lote', 'Lote', ''))}</td>
                                <td class="text-end es-num">${formatKg(getPropValue(x, 'kgDevueltosMeat', 'KgDevueltosMeat', 0))}</td>
                                <td class="text-end es-num">${formatKg(getPropValue(x, 'kgDevueltosSap', 'KgDevueltosSap', 0))}</td>
                                <td class="text-end es-num">${formatKg(getPropValue(x, 'diferenciaKg', 'DiferenciaKg', 0))}</td>
                                <td>${escapeHtml(docNum ? String(docNum) : '-')}</td>
                                <td>${escapeHtml(getPropValue(x, 'tipoAplicacion', 'TipoAplicacion', '-'))}</td>
                                <td>${pill(badgeInfo(estatus), estatus)}</td>
                            </tr>`;
            }).join('');
        }

        const okGeneral = Boolean(estadoTraza?.ok) && !hayErrorDev;
        if (devolucionError) {
            setTrzAlert('warn',
                estadoTraza?.ok ? 'Trazabilidad correcta; devoluciones no disponibles.' : 'Trazabilidad con diferencias y devoluciones no disponibles.',
                'Se conservaron los lotes cargados. Revisa la conexión o la consulta de devoluciones.');
        } else if (okGeneral) {
            setTrzAlert('ok', 'Validación correcta.', 'La trazabilidad está correcta y las devoluciones, si existen, están aplicadas en SAP.');
        } else if (hayErrorDev) {
            setTrzAlert('warn', 'La entrega tiene devoluciones pendientes o con diferencias.',
                estadoTraza?.ok ? 'La trazabilidad está correcta. Revisa solo las devoluciones Meat vs SAP.'
                    : 'También hay diferencias de trazabilidad. Revisa ambos apartados.');
        } else {
            setTrzAlert('warn', 'La entrega tiene diferencias de trazabilidad.', 'Las devoluciones están correctas; revisa lotes, kilos y disponibilidad SAP.');
        }

        trazabilidadActualDevolucionesOk = !hayErrorDev;
        actualizarBotonAutocompletarSap();
        return { ok: okGeneral, hayError: hayErrorDev, devoluciones, devolucionError };
    }

    async function obtenerJson(url, msgError) {
        const res = await fetch(url, { credentials: 'same-origin' });
        const data = await readResponse(res);
        if (!res.ok) throw new Error(data?.msg || data?.error || msgError);
        return { httpOk: res.ok, data };
    }
    const qsRef = ref => '?referencia=' + encodeURIComponent(ref) + '&source=' + encodeURIComponent(SOURCE);

    async function validarTrazabilidad(ref, mostrarModal = true) {
        const requestId = ++trazabilidadRequestSeq;
        const vigente = () => mostrarModal && requestId === trazabilidadRequestSeq;
        if (mostrarModal) prepararModalTrazabilidad(ref);

        showLog('info', 'Etapa 1 de 2: cargando lotes, fechas y disponibilidad SAP de ' + ref + '…');

        // ETAPA 1: trazabilidad (se pinta antes de consultar devoluciones para no competir por SQL / Service Layer)
        let estadoTraza = { ok: false, hayError: true, detalle: [] };
        try {
            const r = await obtenerJson(URLS.trazabilidadRapida + qsRef(ref), 'No se pudo consultar la trazabilidad.');
            const ok = Boolean(r.httpOk && r.data?.ok);
            estadoTraza = { ok, hayError: !ok, detalle: getArrayProp(r.data, 'detalle', 'Detalle') };
            if (vigente()) estadoTraza = renderizarTrazabilidadRapida(ref, r.data);
        } catch (error) {
            estadoTraza = { ok: false, hayError: true, detalle: [] };
            if (vigente()) estadoTraza = renderizarErrorTrazabilidad(error);
        }

        await sleep(180);
        if (vigente()) {
            $('devDetalleBody').innerHTML = loadingRow(9, 'Lotes listos. Consultando devoluciones Meat vs SAP…');
        }
        showLog('info', 'Etapa 2 de 2: consultando devoluciones de ' + ref + '…');

        // ETAPA 2: devoluciones
        let devResponse;
        try { devResponse = await obtenerJson(URLS.validarDevoluciones + qsRef(ref), 'No se pudieron consultar las devoluciones.'); }
        catch (error) {
            devResponse = { httpOk: false, data: { ok: false, devoluciones: [], devolucionError: error?.message || String(error) } };
        }
        const devData = devResponse.data || { ok: false, devoluciones: [], devolucionError: 'No se recibió respuesta de devoluciones.' };
        actualizarEstatusDevolucionFila(ref, devData);

        let estadoDev = { ok: Boolean(devResponse.httpOk && devData?.ok) };
        if (vigente()) estadoDev = renderizarDevolucionesTrazabilidad(devData, estadoTraza);

        if (estadoTraza?.ok && estadoDev?.ok) {
            showLog('success', 'Trazabilidad y devoluciones correctas: ' + ref);
            return true;
        }
        showLog('warning', 'La entrega requiere revisión de trazabilidad o devoluciones: ' + ref);
        return false;
    }

    /* ---------------- Autocompletar faltantes en SAP ---------------- */
    function obtenerFaltantesAutocompletarSap() {
        return (trazabilidadActualDetalle || [])
            .map(x => ({
                articulo: String(getPropValue(x, 'articulo', 'Articulo', '')).trim(),
                almacen: String(getPropValue(x, 'almacen', 'Almacen', '')).trim(),
                lote: String(getPropValue(x, 'lote', 'Lote', '')).trim(),
                kg: toNumber(getPropValue(x, 'kgFaltantes', 'KgFaltantes', 0))
            }))
            .filter(x => x.kg > 0.01 && x.articulo && x.almacen && x.lote && x.lote !== '-');
    }

    function actualizarBotonAutocompletarSap() {
        const btn = $('btnAutocompletarSap'), icon = $('btnAutocompletarSapIcon'), text = $('btnAutocompletarSapText'), btnJson = $('btnVerJsonAutocompletarSap');
        if (!btn || !icon || !text) return;

        const kgTotal = obtenerFaltantesAutocompletarSap().reduce((s, x) => s + x.kg, 0);
        const puedeVer = Boolean(permisosAutocompletarSap?.puedeLeer);

        if (btnJson) {
            const mostrar = puedeVer && kgTotal > 0.01;
            btnJson.style.display = mostrar ? 'inline-flex' : 'none';
            btnJson.disabled = !mostrar || autocompletarSapBusy;
        }

        if (!puedeVer || kgTotal <= 0.01) { btn.style.display = 'none'; btn.disabled = true; return; }
        btn.style.display = 'inline-flex';

        if (autocompletarSapBusy) {
            btn.disabled = true;
            icon.className = 'es-spinner';
            text.textContent = 'Autocompletando y enviando…';
            return;
        }
        icon.className = 'bi bi-lightning-charge-fill';
        text.textContent = `Autocompletar ${formatKg(kgTotal)} kg y enviar`;

        if (!permisosAutocompletarSap?.puedeEscribir) {
            btn.disabled = true;
            btn.title = 'Tienes permiso de lectura, pero no permiso ESCRIBIR en AUTOCOMPLETAR_SAP.';
            return;
        }
        if (!trazabilidadActualDevolucionesOk) {
            btn.disabled = true;
            btn.title = 'Espera la validación de devoluciones o corrige las diferencias antes de autocompletar.';
            return;
        }
        btn.disabled = false;
        btn.title = 'Genera una entrada PurchaseDeliveryNotes a precio 0.01 solo por los SKU, lotes y kg faltantes; después valida y envía la entrega.';
    }

    function verJsonAutocompletarSap() {
        if (!trazabilidadActualRef) { alert('No se encontró la referencia. Abre nuevamente la trazabilidad.'); return; }
        if (!permisosAutocompletarSap?.puedeLeer) { alert('No tienes permiso LEER en AUTOCOMPLETAR_SAP.'); return; }
        window.open(URLS.autocompletarJson + qsRef(trazabilidadActualRef), '_blank', 'noopener,noreferrer');
    }

    function getAutocompletarDetalle(data) {
        for (const k of ['trazabilidadAntesEnvio', 'TrazabilidadAntesEnvio', 'detalle', 'Detalle']) {
            if (Array.isArray(data?.[k])) return data[k];
        }
        return [];
    }

    function renderizarResultadoAutocompletarSap(ref, data) {
        const detalle = getAutocompletarDetalle(data);
        if (detalle.length) renderizarTrazabilidadRapida(ref, { detalle });
        trazabilidadActualRef = ref || '';
        trazabilidadActualDetalle = detalle;
        trazabilidadActualDevolucionesOk = true;

        const kg = toNumber(data?.kgAutocompletados ?? data?.KgAutocompletados ?? 0);
        const lineas = toNumber(data?.lineasAutocompletadas ?? data?.LineasAutocompletadas ?? 0);
        const lotes = toNumber(data?.lotesValidados ?? data?.LotesValidados ?? detalle.length);
        const entrada = data?.entradaDocNum ? `Entrada ${data.entradaDocNum}` : (data?.entradaYaExistia ? 'Entrada existente confirmada' : 'Sin entrada adicional');
        const entrega = data?.entregaDocNum ? `Entrega ${data.entregaDocNum}` : (data?.entregaConfirmadaSap ? 'Entrega confirmada en SAP' : 'Entrega sin número devuelto');
        const recuperado = Boolean(data?.recuperadoTrasError ?? data?.RecuperadoTrasError);
        const yaExistia = Boolean(data?.entregaYaExistia ?? data?.EntregaYaExistia);

        setTrzAlert(recuperado ? 'warn' : 'ok',
            recuperado ? 'Entrega confirmada en SAP con advertencia.' : (yaExistia ? 'La entrega ya estaba enviada en SAP.' : 'Inventario completado y entrega enviada.'),
            `SAP confirmó ${lotes} lote(s) con kg suficientes antes del envío. ${formatKg(kg)} kg agregados en ${lineas} partida(s). ${entrada}. ${entrega}.` +
            (data?.advertencia ? ` Advertencia posterior: ${data.advertencia}` : ''));
        actualizarBotonAutocompletarSap();
    }

    function renderizarFalloAutocompletarSap(ref, data) {
        const detalle = getAutocompletarDetalle(data);
        if (detalle.length) renderizarTrazabilidadRapida(ref, { detalle });
        const entradaRegistrada = Boolean(data?.entradaCreada || data?.entradaYaExistia || data?.entradaDocEntry || data?.entradaDocNum);
        setTrzAlert(entradaRegistrada ? 'warn' : 'bad',
            entradaRegistrada ? 'La entrada de kg fue procesada; la entrega requiere revisión.' : 'No se completó el proceso en SAP.',
            (data?.fase ? `Fase: ${data.fase}. ` : '') + (data?.entradaDocNum ? `Entrada SAP: ${data.entradaDocNum}. ` : '') +
            (data?.msg || 'Revisa el detalle del error antes de volver a intentar.'));
        actualizarBotonAutocompletarSap();
    }

    function buildAutocompletarErrorMessage(data, httpStatus) {
        const partes = [data?.msg || 'No se pudo completar el inventario y enviar la entrega.'];
        if (httpStatus) partes.push(`HTTP: ${httpStatus}`);
        if (data?.fase) partes.push(`Fase: ${data.fase}`);
        if (data?.entradaDocNum) partes.push(`Entrada SAP: ${data.entradaDocNum}`);
        if (data?.entregaDocNum) partes.push(`Entrega SAP: ${data.entregaDocNum}`);
        if (data?.error) partes.push(`Error: ${data.error}`);
        if (data?.inner && data.inner !== data.error) partes.push(`Detalle interno: ${data.inner}`);
        if (data?.detalle) {
            let t;
            try { t = typeof data.detalle === 'string' ? data.detalle : JSON.stringify(data.detalle, null, 2); }
            catch { t = String(data.detalle); }
            if (t.length > 3500) t = t.substring(0, 3500) + '\n…detalle recortado';
            partes.push(t);
        }
        return partes.filter(Boolean).join('\n');
    }

    async function autocompletarYEnviarSap() {
        const ref = trazabilidadActualRef || '';
        if (!ref) { alert('No se encontró la referencia. Abre nuevamente la trazabilidad.'); return; }
        if (autocompletarSapBusy) { showLog('warning', 'El autocompletado ya está en proceso.'); return; }
        if (!permisosAutocompletarSap?.puedeEscribir) { alert('No tienes permiso ESCRIBIR en AUTOCOMPLETAR_SAP.'); return; }
        if (!trazabilidadActualDevolucionesOk) { alert('Las devoluciones aún no están correctas o se siguen validando.'); return; }

        const faltantes = obtenerFaltantesAutocompletarSap();
        const kgTotal = faltantes.reduce((s, x) => s + x.kg, 0);
        if (!faltantes.length || kgTotal <= 0.01) { alert('No hay faltantes válidos para autocompletar.'); return; }

        const resumen = faltantes.map(x => `${x.articulo} | ${x.almacen} | ${x.lote} | ${formatKg(x.kg)} kg`).join('\n');
        if (!confirm(
            'Se generará una entrada de mercancía en SAP con precio 0.01 por los faltantes exactos.\n\n' +
            `Referencia: ${ref}\nPartidas: ${faltantes.length}\nKg totales: ${formatKg(kgTotal)}\n\n${resumen}\n\n` +
            'Después se confirmará que cada lote tenga kg y solo entonces se enviará la entrega.\n\n¿Continuar?')) return;

        autocompletarSapBusy = true;
        actualizarBotonAutocompletarSap();
        setSendButtonsDisabled(true);
        showLog('info', `Autocompletando ${formatKg(kgTotal)} kg en SAP para ${ref}. Se confirmarán los lotes antes del envío…`);

        try {
            const response = await fetch(URLS.autocompletarYEnviar, {
                method: 'POST', credentials: 'same-origin', cache: 'no-store',
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                body: JSON.stringify({ referencia: ref, source: SOURCE })
            });
            const data = await readResponse(response);
            // Si el servidor confirma que SAP sí tiene la entrega, se trata como éxito aunque el código HTTP sea incorrecto.
            const confirmadaEnSap = Boolean(data?.entregaConfirmadaSap ?? data?.EntregaConfirmadaSap);

            if ((!response.ok || !data?.ok) && !confirmadaEnSap) {
                const mensaje = buildAutocompletarErrorMessage(data, response.status);
                renderizarFalloAutocompletarSap(ref, data || {});
                const entradaRegistrada = Boolean(data?.entradaCreada || data?.entradaYaExistia || data?.entradaDocNum);
                showLog(entradaRegistrada ? 'warning' : 'danger', mensaje);
                setRowStatus(ref, false, data?.msg || 'No se confirmó la entrega en SAP.');
                alert(response.status === 403 ? 'Acceso denegado. Se requiere AUTOCOMPLETAR_SAP / ESCRIBIR.' : mensaje);
                return;
            }

            renderizarResultadoAutocompletarSap(ref, data || {});
            const mensaje = data?.msg || 'Inventario autocompletado y entrega confirmada en SAP.';
            const documentos = [
                data?.entradaDocNum ? `Entrada SAP: ${data.entradaDocNum}` : '',
                data?.entregaDocNum ? `Entrega SAP: ${data.entregaDocNum}` : ''
            ].filter(Boolean).join(' | ');
            const completo = mensaje + (documentos ? '\n' + documentos : '') + (data?.advertencia ? '\nAdvertencia: ' + data.advertencia : '');
            showLog(Boolean(data?.recuperadoTrasError ?? data?.RecuperadoTrasError) ? 'warning' : 'success', completo);

            try { await refreshSapTableSilentSafe(); }
            catch (e) { console.warn('No se pudo refrescar la tabla después del envío:', e); }

            setRowStatus(ref, true, mensaje + (data?.entregaDocNum ? ` DocNum: ${data.entregaDocNum}` : ''));
            alert(completo + '\n\nLos lotes mostrados fueron validados con kg antes de crear o confirmar la entrega.');
        } catch (error) {
            const mensaje = 'Error de comunicación durante el autocompletado: ' + (error?.message || error) +
                '\n\nNo vuelvas a intentar de inmediato. Consulta primero si la entrega ya aparece en SAP.';
            showLog('danger', mensaje);
            alert(mensaje);
        } finally {
            autocompletarSapBusy = false;
            setSendButtonsDisabled(false);
            actualizarBotonAutocompletarSap();
        }
    }

    /* =====================================================================
       PDF
       ===================================================================== */
    let pdfSolicitudId = null;
    let pdfReferenciaDocMeat = null;
    let pdfModoMultiple = false;
    let pdfRegistrosSeleccionados = [];
    let pdfGenerando = false;

    function actualizarNotaOrigenPdf() {
        const origen = document.querySelector('input[name="pdfOrigenDatos"]:checked')?.value || 'remision';
        const nota = $('pdfOrigenNota');
        if (!nota) return;
        if (pdfModoMultiple) {
            const total = pdfRegistrosSeleccionados.length;
            const cli = String(pdfRegistrosSeleccionados[0]?.cliente || '').trim();
            const base = total > 1 ? `Se consolidarán ${total} registros del mismo cliente${cli ? ` (${cli})` : ''} en un solo PDF` : 'Se generará el PDF';
            nota.textContent = base + (origen === 'orden' ? ' con los datos de la orden de venta.' : ' con los datos surtidos de la remisión.');
            return;
        }
        nota.textContent = origen === 'orden'
            ? 'Se generará el PDF con los datos de la orden de venta / pedido original.'
            : 'Se generará el PDF con los datos realmente surtidos de la remisión/JSON.';
    }

    function limpiarModalPdf() {
        if ($('pdfComentarios')) $('pdfComentarios').value = '';
        if ($('pdfComentariosCount')) $('pdfComentariosCount').textContent = '0/1000';
        if ($('pdfOrigenRemision')) $('pdfOrigenRemision').checked = true;
        if ($('pdfBatchProgress')) $('pdfBatchProgress').hidden = true;
    }

    function mostrarModalPdf(registros, labelSolicitud, labelReferencia) {
        pdfModoMultiple = true;
        pdfRegistrosSeleccionados = registros;
        pdfSolicitudId = null;
        pdfReferenciaDocMeat = null;
        limpiarModalPdf();
        $('pdfSolicitudLabel').textContent = labelSolicitud || '-';
        $('pdfReferenciaLabel').textContent = labelReferencia || '-';
        actualizarNotaOrigenPdf();
        bootstrap.Modal.getOrCreateInstance($('pdfComentariosModal')).show();
    }

    // PDF de una fila: usa el mismo endpoint consolidado que "PDF de seleccionadas".
    function abrirPdfConComentarios(solicitudId, referenciaDocMeat) {
        const fila = getRows().find(r =>
            String(r.dataset.solicitud || '') === String(solicitudId || '') && String(r.dataset.ref || '') === String(referenciaDocMeat || ''));
        if (!fila) { alert('No se encontró la remisión en la tabla actual. Actualiza los filtros.'); return; }
        mostrarModalPdf([{ solicitudId: fila.dataset.solicitud || '', referencia: fila.dataset.ref || '', cliente: fila.dataset.cliente || '' }],
            solicitudId, referenciaDocMeat);
    }

    const normalizarClientePdf = v => String(v || '').trim().toUpperCase();
    function validarMismoClientePdf(registros) {
        const clientes = Array.from(new Set(registros.map(x => normalizarClientePdf(x.cliente)).filter(Boolean)));
        return { ok: clientes.length <= 1, clientes };
    }

    function abrirPdfSeleccionados() {
        const sel = getRows().filter(r => r.querySelector('.ck')?.checked)
            .map(r => ({ solicitudId: r.dataset.solicitud || '', referencia: r.dataset.ref || '', cliente: r.dataset.cliente || '' }))
            .filter(x => x.solicitudId && x.referencia);

        if (!sel.length) { alert('Selecciona al menos un registro para generar el PDF.'); return; }
        const v = validarMismoClientePdf(sel);
        if (!v.ok) {
            alert(`Para generar un solo PDF selecciona registros del mismo cliente.\n\nSe detectaron ${v.clientes.length} clientes distintos.`);
            return;
        }
        const cli = String(sel[0]?.cliente || '').trim();
        const refs = sel.slice(0, 3).map(x => x.referencia).join(', ');
        mostrarModalPdf(sel, `${sel.length} registro(s) del mismo cliente`,
            (cli ? cli + ' | ' : '') + (sel.length > 3 ? `${refs} +${sel.length - 3} más` : refs));
    }

    function construirUrlPdf(solicitudId, referencia, origenDatos, comentarios) {
        const p = new URLSearchParams({ id: solicitudId || '', referencia: referencia || '', source: SOURCE || '', origenDatos: origenDatos || 'remision', comentarios: comentarios || '' });
        return URLS.ordenVentaPdf + '?' + p.toString();
    }

    async function generarPdfConComentarios() {
        if (pdfGenerando) return;
        const comentarios = $('pdfComentarios')?.value || '';
        const origenDatos = document.querySelector('input[name="pdfOrigenDatos"]:checked')?.value || 'remision';
        if (!pdfModoMultiple) {
            bootstrap.Modal.getInstance($('pdfComentariosModal'))?.hide();
            window.open(construirUrlPdf(pdfSolicitudId, pdfReferenciaDocMeat, origenDatos, comentarios), '_blank');
            return;
        }
        await generarPdfSeleccionadosUnificado(comentarios, origenDatos);
    }

    async function generarPdfSeleccionadosUnificado(comentarios, origenDatos) {
        const registros = [...pdfRegistrosSeleccionados];
        if (!registros.length) { alert('Ya no hay registros seleccionados.'); return; }
        if (!validarMismoClientePdf(registros).ok) { alert('Los registros seleccionados ya no son del mismo cliente. Vuelve a seleccionarlos.'); return; }

        const btn = $('btnPdfGenerar');
        const progress = $('pdfBatchProgress');
        const textoOriginal = btn?.innerHTML;

        // La ventana se abre antes del await para que el navegador no la bloquee.
        const printWindow = window.open('about:blank', '_blank');
        if (!printWindow || printWindow === window) {
            alert('El navegador bloqueó la ventana del PDF. Permite ventanas emergentes para este sitio.');
            return;
        }
        try {
            printWindow.document.title = 'Preparando PDF…';
            const b = printWindow.document.body;
            if (b) { b.textContent = 'Preparando PDF…'; b.style.cssText = 'font-family:Arial,sans-serif;padding:32px;color:#333;'; }
        } catch { }

        pdfGenerando = true;
        try {
            if (btn) { btn.disabled = true; btn.innerHTML = '<span class="es-spinner es-spinner--light"></span> Generando…'; }
            if (progress) { progress.hidden = false; $('pdfBatchProgressText').textContent = `Preparando PDF de ${registros.length} registro(s)…`; }

            const cli = String(registros[0]?.cliente || '').trim();
            showLog('info', `Preparando PDF de ${registros.length} registro(s)${cli ? ' del cliente ' + cli : ''}…`);

            const inicio = performance.now();
            const response = await fetch(URLS.pdfAgrupado, {
                method: 'POST', credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    source: SOURCE || 'P1',
                    origenDatos: origenDatos || 'remision',
                    comentarios: comentarios || '',
                    registros: registros.map(x => ({ solicitudId: x.solicitudId, referencia: x.referencia, cliente: x.cliente || '' }))
                })
            });
            const html = await response.text();
            console.info('[SIGO PDF] Respuesta de servidor (ms):', Math.round(performance.now() - inicio), 'Registros:', registros.length);

            if (!response.ok) {
                throw new Error(`HTTP ${response.status}. ` + html.replace(/<[^>]*>/g, ' ').replace(/\s+/g, ' ').trim().substring(0, 500));
            }

            const doc = new DOMParser().parseFromString(html, 'text/html');
            if (!doc.querySelector('.page')) {
                throw new Error('El servidor no regresó la vista PDF esperada. ' + (doc.body?.innerText || html).replace(/\s+/g, ' ').trim().substring(0, 400));
            }

            doc.querySelectorAll('script').forEach(el => el.remove());
            doc.querySelectorAll('[src]').forEach(el => { try { el.setAttribute('src', new URL(el.getAttribute('src'), response.url).href); } catch { } });
            doc.querySelectorAll('link[href]').forEach(el => { try { el.setAttribute('href', new URL(el.getAttribute('href'), response.url).href); } catch { } });
            let base = doc.querySelector('base');
            if (!base) { base = doc.createElement('base'); doc.head.prepend(base); }
            base.setAttribute('href', window.location.origin + '/');

            const blobUrl = URL.createObjectURL(new Blob(['<!DOCTYPE html>\n' + doc.documentElement.outerHTML], { type: 'text/html;charset=utf-8' }));
            printWindow.location.replace(blobUrl);
            printWindow.focus();
            setTimeout(() => { try { URL.revokeObjectURL(blobUrl); } catch { } }, 120000);

            bootstrap.Modal.getInstance($('pdfComentariosModal'))?.hide();
            showLog('success', `PDF generado con ${registros.length} registro(s).`);
        } catch (error) {
            console.error('Error al generar PDF consolidado:', error);
            try { if (printWindow && !printWindow.closed) printWindow.close(); } catch { }
            showLog('danger', 'No se pudo generar el PDF: ' + (error?.message || error));
            alert('No se pudo generar el PDF.\n\n' + (error?.message || error));
        } finally {
            pdfGenerando = false;
            if (btn) { btn.disabled = false; btn.innerHTML = textoOriginal; }
            if (progress) progress.hidden = true;
        }
    }

    /* =====================================================================
       INVENTARIO
       ===================================================================== */
    function sapWhsFromSource() { return SOURCE === 'P1' ? 'PLAP1GEN' : (SOURCE === 'TIF' ? 'PLATIFGE' : ''); }

    function abrirInventarioModal() {
        const modalEl = $('inventarioModal');
        if (!modalEl || !window.bootstrap?.Modal) { showLog('danger', 'No se pudo abrir la conciliación de inventario.'); return; }
        if ($('invSucursal')) $('invSucursal').value = sapWhsFromSource();
        bootstrap.Modal.getOrCreateInstance(modalEl).show();
    }

    function badgeInventario(estatus) {
        const e = String(estatus || '').toUpperCase();
        if (e === 'OK') return pill('es-pill--ok', 'OK');
        if (e === 'FALTA SAP') return pill('es-pill--bad', 'Falta en SAP');
        if (e === 'FALTA LOCAL') return pill('es-pill--bad', 'Falta en Meat');
        return pill('es-pill--warn', estatus);
    }

    function filtrosInventarioQS() {
        return '?sucursal=' + encodeURIComponent($('invSucursal')?.value || '')
            + '&articulo=' + encodeURIComponent($('invArticulo')?.value || '')
            + '&lote=' + encodeURIComponent($('invLote')?.value || '')
            + '&estatus=' + encodeURIComponent($('invEstatus')?.value || '');
    }

    async function cargarInventarioModal() {
        const body = $('inventarioBody');
        body.innerHTML = loadingRow(11, 'Cargando conciliación de inventario…');
        const url = URLS.inventarioJson + filtrosInventarioQS();
        try {
            const res = await fetch(url, { credentials: 'same-origin' });
            const data = await readResponse(res);

            if (!res.ok || !data?.ok) {
                const msg = data?.msg || data?.message || data?.detalle || data?.error || data?.inner || 'Error al consultar inventario.';
                console.error('Error inventario:', { status: res.status, url, response: data });
                body.innerHTML = messageRow(11,
                    `<b>Error al consultar inventario.</b><br>HTTP ${res.status} ${escapeHtml(res.statusText)}<br>${escapeHtml(msg)}` +
                    (data?.error ? '<br>Error: ' + escapeHtml(data.error) : '') + (data?.inner ? '<br>Detalle: ' + escapeHtml(data.inner) : ''));
                showLog('danger', `Error al consultar inventario.\nHTTP ${res.status} ${res.statusText}\nMensaje: ${msg}`);
                return;
            }

            const rows = Array.isArray(data.rows) ? data.rows : [];
            const ok = rows.filter(x => String(x.estatus || '').toUpperCase() === 'OK').length;
            const dif = rows.length - ok;
            const kgDif = rows.reduce((s, x) => s + Math.abs(toNumber(getPropValue(x, 'diferenciaKg', 'DiferenciaKg', 0))), 0);

            $('invTotalRegistros').textContent = fmtInt(rows.length);
            $('invTotalOk').textContent = fmtInt(ok);
            $('invTotalDif').textContent = fmtInt(dif);
            $('invKgDif').textContent = formatKg(kgDif);

            if (!rows.length) { body.innerHTML = messageRow(11, 'Sin información para estos filtros.'); return; }

            body.innerHTML = rows.map(x => `
                        <tr class="${esProduccionHoy(x) ? 'trz-row-produccion-hoy' : ''}">
                            <td>${escapeHtml(x.sucursal)}</td>
                            <td>${escapeHtml(x.productoCodigo)}</td>
                            <td title="${escapeHtml(x.descripcionSap)}" style="max-width:260px;overflow:hidden;text-overflow:ellipsis;">${escapeHtml(x.descripcionSap || '-')}</td>
                            <td>${escapeHtml(x.lote)}</td>
                            <td>${htmlFechaProduccion(x)}</td>
                            <td class="text-end es-num">${formatKg(x.kgLocal)}</td>
                            <td class="text-end es-num">${formatKg(x.cantidadSap)}</td>
                            <td class="text-end es-num">${formatKg(x.comprometidoSap)}</td>
                            <td class="text-end es-num">${formatKg(x.disponibleSap)}</td>
                            <td class="text-end es-num">${formatKg(x.diferenciaKg)}</td>
                            <td>${badgeInventario(x.estatus)}</td>
                        </tr>`).join('');

            showLog(dif === 0 ? 'success' : 'warning', dif === 0 ? 'Inventario conciliado: sin diferencias.' : `Inventario con diferencias: ${dif} registro(s).`);
        } catch (e) {
            body.innerHTML = messageRow(11, 'Error de red al consultar inventario.');
            showLog('danger', 'Error al consultar inventario: ' + (e?.message || e));
        }
    }

    function descargarInventarioExcel() {
        window.location.href = URLS.inventarioExcel + filtrosInventarioQS();
    }

    /* =====================================================================
       EVENTOS E INICIO
       ===================================================================== */
    // Carta porte operativa: el backend consulta los mismos datos MEAT que Entregas SAP.
    function abrirCartaPorte(refs) {
        const lista = [...new Set((refs || []).filter(Boolean))];
        if (!lista.length) { alert('Selecciona al menos una remisión.'); return; }
        if (lista.length > 40) { alert('Máximo 40 remisiones por carta porte.'); return; }
        const qs = new URLSearchParams({ source: SOURCE });
        lista.forEach(ref => qs.append('referencias', ref));
        const destino = URLS.cartaPorte + '?' + qs.toString();
        window.open(destino, '_blank', 'noopener');
    }

    function bindEventos() {
        // Acciones por fila (delegación: sobrevive al refresco del tbody y evita inyección en onclick).
        $('tblEntregas')?.addEventListener('click', e => {
            const btn = e.target.closest('[data-action]');
            if (!btn || btn.disabled || btn.getAttribute('aria-disabled') === 'true') return;
            const row = btn.closest('tr[data-ref]');
            const ref = row?.dataset.ref;
            if (!ref) return;
            switch (btn.dataset.action) {
                case 'traza': validarTrazabilidad(ref); break;
                case 'pdf': abrirPdfConComentarios(row.dataset.solicitud, ref); break;
                case 'carta-porte': abrirCartaPorte([ref]); break;
                case 'send': sendOne(ref); break;
                case 'reserva-entrega': sendReserveByDelivery(ref); break;
                case 'reserva-manual': openReserveManual(ref); break;
            }
        });

        document.addEventListener('change', e => {
            const t = e.target;
            if (t?.classList?.contains('ck')) {
                syncRowSelected(t);
                actualizarKpisEntregasSap();
                actualizarCheckboxTodos();
            } else if (t?.id === 'ckAll') {
                selectAll(t.checked);
            } else if (t?.name === 'pdfOrigenDatos') {
                actualizarNotaOrigenPdf();
            }
        });

        $('selEstatus')?.addEventListener('change', function() { setFiltroVista(this.value); });

        document.querySelectorAll('.es-kpi[data-filter]').forEach(k => k.addEventListener('click', () => {
            const f = k.dataset.filter;
            setFiltroVista(filtroVista === f ? 'todos' : f);
        }));

        let tBusqueda = null;
        $('txtBuscarTabla')?.addEventListener('input', function() {
            clearTimeout(tBusqueda);
            tBusqueda = setTimeout(() => { filtroTexto = this.value.trim().toLowerCase(); aplicarFiltros(); }, 150);
        });

        $('frmFiltros')?.addEventListener('submit', e => {
            const d = $('fDesde')?.value, h = $('fHasta')?.value;
            if (d && h && d > h) { e.preventDefault(); alert('La fecha "Desde" no puede ser posterior a "Hasta".'); }
        });

        $('btnPdfSeleccionados')?.addEventListener('click', abrirPdfSeleccionados);
        $('btnCartaPorteSeleccionadas')?.addEventListener('click', () => { const refs = getRows().filter(r => r.querySelector('.ck')?.checked).map(r => r.dataset.ref).filter(Boolean); abrirCartaPorte(refs); });
        $('btnPdfGenerar')?.addEventListener('click', generarPdfConComentarios);
        $('pdfComentarios')?.addEventListener('input', function() { $('pdfComentariosCount').textContent = this.value.length + '/1000'; });

        $('btnAuto')?.addEventListener('click', () => { if (autoEnabled) stopAuto(); else startAuto(); });
        $('btnAutoDev')?.addEventListener('click', toggleAutoDev);
        $('btnInventario')?.addEventListener('click', abrirInventarioModal);
        $('btnInvValidar')?.addEventListener('click', cargarInventarioModal);
        $('btnInvExcel')?.addEventListener('click', descargarInventarioExcel);
        document.querySelectorAll('.js-inv-enter').forEach(i => i.addEventListener('keydown', e => { if (e.key === 'Enter') cargarInventarioModal(); }));

        $('btnVerJsonAutocompletarSap')?.addEventListener('click', verJsonAutocompletarSap);
        $('btnAutocompletarSap')?.addEventListener('click', autocompletarYEnviarSap);
        $('btnEnviarReserva')?.addEventListener('click', sendReserveKg);

        $('btnLimpiarLog')?.addEventListener('click', () => {
            $('esLogList').innerHTML = '<li class="es-log__empty">Sin actividad todavía.</li>';
        });

        document.addEventListener('visibilitychange', () => {
            if (!document.hidden && storageGet(DEV_AUTO_KEY) === '1') validarDevolucionesAutomatico();
        });

        window.addEventListener('beforeunload', () => {
            if (autoTimer) clearInterval(autoTimer);
            if (autoRefreshTimer) clearInterval(autoRefreshTimer);
            if (devAutoTimer) clearInterval(devAutoTimer);
        });
    }

    async function initEntregasSap() {
        bindEventos();
        actualizarKpisEntregasSap();
        aplicarFiltros();
        updateReserveButtons();
        setInterval(updateReserveButtons, 15000);

        await Promise.all([cargarPermisosEntregas(), cargarPermisosAutocompletarSap()]);
        initAutoState();

        if (storageGet(DEV_AUTO_KEY) === '1') iniciarAutoDev();
        else { setAutoDevUi(false); setTimeout(validarDevolucionesAutomatico, 800); }
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initEntregasSap);
    else initEntregasSap();
</script>
