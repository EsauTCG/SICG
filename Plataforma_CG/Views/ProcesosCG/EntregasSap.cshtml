                                pdfReferenciaDocMeat = referenciaDocMeat;

                                limpiarModalPdf();

                                const solicitudLabel = document.getElementById('pdfSolicitudLabel');
                                const referenciaLabel = document.getElementById('pdfReferenciaLabel');

                                if (solicitudLabel) solicitudLabel.textContent = solicitudId || '-';
                                if (referenciaLabel) referenciaLabel.textContent = referenciaDocMeat || '-';

