                        function badgeInventario(estatus) {
                            const e = String(estatus || '').toUpperCase();

                            if (e === 'OK') {
                                return `<span class="trz-badge-warning" style="background:#dff3e2;border-color:#6aa84f;color:#2f6b1f;">✅ OK</span>`;
                            }

                            if (e === 'FALTA SAP') {
                                return `<span class="trz-badge-danger">⛔ FALTA SAP</span>`;
                            }

                            if (e === 'FALTA LOCAL') {
                                return `<span class="trz-badge-danger">⛔ FALTA MEAT</span>`;
                            }

                            return `<span class="trz-badge-warning">⚠️ ${escapeHtml(estatus)}</span>`;
                        }

                        async function cargarInventarioModal() {
                            const body = document.getElementById('inventarioBody');

                            const sucursal = document.getElementById('invSucursal')?.value || '';
                            const articulo = document.getElementById('invArticulo')?.value || '';
                            const lote = document.getElementById('invLote')?.value || '';
                            const estatus = document.getElementById('invEstatus')?.value || '';

                            body.innerHTML = htmlSpinnerTabla(11, 'Cargando conciliación de inventario...');

                            try {
                                const url = '@Url.Action("ConciliacionInventarioJson", "ProcesosCG")'
                                    + '?sucursal=' + encodeURIComponent(sucursal)
                                    + '&articulo=' + encodeURIComponent(articulo)
                                    + '&lote=' + encodeURIComponent(lote)
                                    + '&estatus=' + encodeURIComponent(estatus);

                                const res = await fetch(url, {
                                    credentials: 'same-origin'
                                });

                                const data = await readResponse(res);

                            if (!res.ok || !data?.ok) {
                        const msg = data?.msg || data?.message || data?.detalle || data?.error || data?.inner || 'Error al consultar inventario.';

                        console.error('Error inventario:', {
                            status: res.status,
                            statusText: res.statusText,
                            url: url,
                            response: data
                        });

                        body.innerHTML = `
                            <tr>
                                <td colspan="11" class="text-center">
                                    <b>Error al consultar inventario.</b><br>
                                    HTTP: ${res.status} ${escapeHtml(res.statusText)}<br>
                                    ${escapeHtml(msg)}<br>
                                    ${data?.error ? 'Error: ' + escapeHtml(data.error) + '<br>' : ''}
                                    ${data?.inner ? 'Detalle: ' + escapeHtml(data.inner) : ''}
                                </td>
                            </tr>`;

                        showLog('danger',
                            'Error al consultar inventario.\n' +
                            'HTTP: ' + res.status + ' ' + res.statusText + '\n' +
                            'URL: ' + url + '\n' +
                            'Mensaje: ' + msg
                        );

                        return;
                    }

                                const rows = Array.isArray(data.rows) ? data.rows : [];

                                const total = rows.length;
                                const ok = rows.filter(x => String(x.estatus || '').toUpperCase() === 'OK').length;
                                const dif = rows.filter(x => String(x.estatus || '').toUpperCase() !== 'OK').length;
                                const kgDif = rows.reduce((sum, x) => sum + Math.abs(toNumber(getPropValue(x, 'diferenciaKg', 'DiferenciaKg', 0))), 0);

                                document.getElementById('invTotalRegistros').textContent = total;
                                document.getElementById('invTotalOk').textContent = ok;
                                document.getElementById('invTotalDif').textContent = dif;
                                document.getElementById('invKgDif').textContent = formatKg(kgDif);

                                if (!rows.length) {
                                    body.innerHTML = `
                                        <tr>
                                            <td colspan="11" class="text-center">Sin información.</td>
                                        </tr>`;
                                    return;
                                }

                                body.innerHTML = rows.map(x => `
                                    <tr class="${esProduccionHoy(x) ? 'trz-row-produccion-hoy' : ''}">
                                        <td>${escapeHtml(x.sucursal)}</td>
                                        <td>${escapeHtml(x.productoCodigo)}</td>
                                        <td title="${escapeHtml(x.descripcionSap)}">${escapeHtml(x.descripcionSap || '-')}</td>
                                        <td>${escapeHtml(x.lote)}</td>
                                        <td>${htmlFechaProduccion(x)}</td>
                                        <td class="text-end">${formatKg(x.kgLocal)}</td>
                                        <td class="text-end">${formatKg(x.cantidadSap)}</td>
                                        <td class="text-end">${formatKg(x.comprometidoSap)}</td>
                                        <td class="text-end">${formatKg(x.disponibleSap)}</td>
                                        <td class="text-end">${formatKg(x.diferenciaKg)}</td>
                                        <td>${badgeInventario(x.estatus)}</td>
                                    </tr>
                                `).join('');

                                showLog(dif === 0 ? 'success' : 'warning',
                                    dif === 0
                                        ? 'Inventario conciliado correctamente.'
                                        : `Inventario con diferencias: ${dif} registros.`
                                );

                            } catch (e) {
                                body.innerHTML = `
                                    <tr>
                                        <td colspan="11" class="text-center">Error de red al consultar inventario.</td>
                                    </tr>`;

                                showLog('danger', 'Error al consultar inventario: ' + (e?.message || e));
                            }
                        }

                        function mostrarCargando(texto) {
                            const el = document.getElementById('loadingModalText');
                            if (el) {
                                el.textContent = texto || 'Cargando información...';
                            }

                            bootstrap.Modal.getOrCreateInstance(
                                document.getElementById('loadingModal')
                            ).show();
                        }

                        function ocultarCargando() {
                            const modalEl = document.getElementById('loadingModal');
                            if (!modalEl) return;

                            try {
                                const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                                modal.hide();
                            } catch (e) {
                                // No bloquear la pantalla si Bootstrap no alcanza a cerrar el modal.
                            }

                            // Refuerzo: cuando se abren/cierra modales muy rápido, Bootstrap puede dejar
                            // el loading visible. Forzamos el cierre sin afectar el modal de trazabilidad.
                            setTimeout(() => {
                                modalEl.classList.remove('show');
                                modalEl.style.display = 'none';
                                modalEl.setAttribute('aria-hidden', 'true');
                                modalEl.removeAttribute('aria-modal');
                                modalEl.removeAttribute('role');

                                const modalesAbiertos = Array.from(document.querySelectorAll('.modal.show'))
                                    .filter(x => x.id !== 'loadingModal');

                                if (modalesAbiertos.length === 0) {
                                    document.body.classList.remove('modal-open');
                                    document.body.style.removeProperty('overflow');
                                    document.body.style.removeProperty('padding-right');
                                    document.querySelectorAll('.modal-backdrop').forEach(x => x.remove());
                                } else {
                                    // Deja máximo un backdrop para el modal que sí queda abierto.
                                    const backs = Array.from(document.querySelectorAll('.modal-backdrop'));
                                    backs.slice(1).forEach(x => x.remove());
                                    document.body.classList.add('modal-open');
                                }
                            }, 120);
                        }

                        function htmlSpinnerTabla(colspan, texto) {
                            return `
                                <tr>
                                    <td colspan="${colspan}" class="loading-row">
                                        <div class="pm-spinner"></div>
                                        <div class="loading-text">${escapeHtml(texto || 'Cargando...')}</div>
                                    </td>
                                </tr>`;
                        }

                        function descargarInventarioExcel() {
                            const sucursal = document.getElementById('invSucursal')?.value || '';
                            const articulo = document.getElementById('invArticulo')?.value || '';
                            const lote = document.getElementById('invLote')?.value || '';
                            const estatus = document.getElementById('invEstatus')?.value || '';

                            const url = '@Url.Action("ConciliacionInventarioExcel", "ProcesosCG")'
                                + '?sucursal=' + encodeURIComponent(sucursal)
                                + '&articulo=' + encodeURIComponent(articulo)
                                + '&lote=' + encodeURIComponent(lote)
                                + '&estatus=' + encodeURIComponent(estatus);

                            window.location.href = url;
                        }

                        // ======================================================
                // AUTO VALIDACIÓN DE DEVOLUCIONES
                // ======================================================
                const DEV_AUTO_KEY = `entregas_dev_auto_${SOURCE}`;
                const DEV_AUTO_INTERVAL_MS = 3 * 60 * 1000; // cada 3 minutos
                const DEV_AUTO_VALIDATE_ALL_VISIBLE = true; // true = valida todas las visibles

                let devAutoTimer = null;
                let devAutoBusy = false;

                function sleepDev(ms) {
                    return new Promise(resolve => setTimeout(resolve, ms));
                }

                function getRowsVisiblesDevoluciones() {
                    return Array.from(document.querySelectorAll('tr[data-ref]'))
                        .filter(row => row.offsetParent !== null);
                }

                function getRefsParaValidarDevoluciones() {
                    const rows = getRowsVisiblesDevoluciones();

                    return rows
                        .filter(row => {
                            if (DEV_AUTO_VALIDATE_ALL_VISIBLE) return true;

                            const dev = row.querySelector('.js-dev-est');
                            if (!dev) return false;

                            const status = dev.getAttribute('data-dev-status') || '';
                            const cls = dev.className || '';

                            return (
                                !status ||
                                status === 'Error' ||
                                status === 'Pendiente' ||
                                status === 'Diferencia' ||
                                cls.includes('dev-unknown') ||
                                cls.includes('dev-pending') ||
                                cls.includes('dev-diff')
                            );
                        })
                        .map(row => row.getAttribute('data-ref'))
                        .filter(Boolean);
                }

                async function validarDevolucionesAutomatico() {
                    if (devAutoBusy) return;

                    const refs = getRefsParaValidarDevoluciones();

                    if (!refs.length) {
                        showLog('secondary', 'Auto Dev: no hay entregas visibles para validar.');
                        return;
                    }

                    devAutoBusy = true;

                    try {
                        showLog('info', `Auto Dev: validando devoluciones de ${refs.length} entrega(s)...`);

                        for (let i = 0; i < refs.length; i++) {
                            const ref = refs[i];

                            const row = document.querySelector(`tr[data-ref="${CSS.escape(ref)}"]`);

                            if (row) {
                                row.querySelectorAll('.js-dev-est').forEach(el => {
                                    el.className = 'dev-est js-dev-est dev-unknown';
                                    el.textContent = '⏳';
                                    el.title = 'Validando devolución automáticamente...';
                                });
                            }

                            await validarDevolucionFila(ref);

                            // Pausa pequeña para no saturar el servidor
                            await sleepDev(120);
                        }

                        showLog('success', `Auto Dev: validación terminada. ${refs.length} entrega(s) revisadas.`);
                    } catch (e) {
                        showLog('danger', 'Auto Dev: error al validar devoluciones: ' + (e?.message || e));
                    } finally {
                        devAutoBusy = false;
                    }
                }

                function setAutoDevUi(activo) {
                    const btn = document.getElementById('btnAutoDev');
                    const ico = document.getElementById('autoDevIco');

                    if (!btn || !ico) return;

                    if (activo) {
                        btn.classList.add('pm-btn-auto-on');
                        ico.textContent = '▶';
                        btn.title = 'Auto Dev: ON';
                    } else {
                        btn.classList.remove('pm-btn-auto-on');
                        ico.textContent = '⏸';
                        btn.title = 'Auto Dev: OFF';
                    }
                }

                function iniciarAutoDev() {
                    detenerAutoDev();

                    localStorage.setItem(DEV_AUTO_KEY, '1');
                    setAutoDevUi(true);

                    // Ejecuta una vez inmediatamente
                    validarDevolucionesAutomatico();

                    // Luego ejecuta cada intervalo
                    devAutoTimer = setInterval(() => {
                        validarDevolucionesAutomatico();
                    }, DEV_AUTO_INTERVAL_MS);
                }

                function detenerAutoDev() {
                    if (devAutoTimer) {
                        clearInterval(devAutoTimer);
                        devAutoTimer = null;
                    }

                    localStorage.setItem(DEV_AUTO_KEY, '0');
                    setAutoDevUi(false);
                }

                function toggleAutoDev() {
                    const activo = localStorage.getItem(DEV_AUTO_KEY) === '1';

                    if (activo) {
                        detenerAutoDev();
                        showLog('warning', 'Auto Dev desactivado.');
                    } else {
                        iniciarAutoDev();
                        showLog('success', 'Auto Dev activado.');
                    }
                }

                document.getElementById('btnAutoDev')?.addEventListener('click', function () {
                    toggleAutoDev();
                });

                document.addEventListener('DOMContentLoaded', function () {
                    const activo = localStorage.getItem(DEV_AUTO_KEY) === '1';

                    setAutoDevUi(activo);

                    if (activo) {
                        iniciarAutoDev();
                    } else {
                        // Validación inicial una sola vez al cargar la página
                        setTimeout(() => {
                            validarDevolucionesAutomatico();
                        }, 800);
                    }
                });

                // Si la pestaña vuelve a estar visible, refresca devoluciones
                document.addEventListener('visibilitychange', function () {
                    if (!document.hidden && localStorage.getItem(DEV_AUTO_KEY) === '1') {
                        validarDevolucionesAutomatico();
                    }
                });



                /* =========================
                   KPIS ENTREGAS SAP
                   ========================= */
                function actualizarKpisEntregasSap() {
                    const rows = Array.from(document.querySelectorAll('.tbl-sap tbody tr[data-ref]'));

                    const seleccionadas = rows.filter(row => row.querySelector('.ck')?.checked).length;

                    const devBad = rows.filter(row => {
                        const el = row.querySelector('.js-dev-est');
                        const cls = String(el?.className || '');
                        const txt = String(el?.getAttribute('data-dev-status') || el?.title || '').toUpperCase();

                        return cls.includes('dev-pending') ||
                               cls.includes('dev-diff') ||
                               txt.includes('PENDIENTE') ||
                               txt.includes('DIFERENCIA') ||
                               txt.includes('FALTA') ||
                               txt.includes('SOBRANTE') ||
                               txt.includes('ERROR');
                    }).length;

                    const devOk = rows.filter(row => {
                        const el = row.querySelector('.js-dev-est');
                        const cls = String(el?.className || '');
                        const txt = String(el?.getAttribute('data-dev-status') || el?.title || '').toUpperCase();

                        return cls.includes('dev-ok') ||
                               txt.includes('APLICADA') ||
                               txt.includes('OK');
                    }).length;

                    const devPendientes = Math.max(rows.length - devOk - devBad, 0);

                    const setText = (id, value) => {
                        const el = document.getElementById(id);
                        if (el) el.textContent = Number(value || 0).toLocaleString('es-MX');
                    };

                    setText('kpiSapSeleccionadas', seleccionadas);
                    setText('kpiSapDevRevisar', devBad);

                    const cardDev = document.getElementById('kpiSapDevCard');
                    const txtDev = document.getElementById('kpiSapDevTexto');

                    if (cardDev) {
                        cardDev.classList.remove('ok', 'warn', 'bad');

                        if (devBad > 0) {
                            cardDev.classList.add('bad');
                            if (txtDev) txtDev.textContent = 'Con diferencias / pendientes';
                        } else if (devPendientes > 0) {
                            cardDev.classList.add('warn');
                            if (txtDev) txtDev.textContent = `${devPendientes.toLocaleString('es-MX')} sin validar`;
                        } else {
                            cardDev.classList.add('ok');
                            if (txtDev) txtDev.textContent = 'Devoluciones correctas';
                        }
                    }
                }

                document.addEventListener('DOMContentLoaded', function () {
                    actualizarKpisEntregasSap();

                    document.querySelectorAll('.ck').forEach(chk => {
                        chk.addEventListener('change', actualizarKpisEntregasSap);
                    });

                    const devTargets = document.querySelectorAll('.js-dev-est');
                    if (devTargets.length) {
                        const observer = new MutationObserver(actualizarKpisEntregasSap);
                        devTargets.forEach(el => {
                            observer.observe(el, {
                                attributes: true,
                                childList: true,
                                characterData: true,
                                subtree: true
                            });
                        });
                    }
                });



                /*
                 * Los tbody pueden reemplazarse durante el auto-refresh.
                 * Usamos delegación para que los checkboxes nuevos sigan
                 * actualizando el KPI y el selector general.
                 */
                document.addEventListener(
                    'change',
                    function (e) {
                        if (
                            e.target &&
                            e.target.classList &&
                            e.target.classList.contains('ck')
                        ) {
                            if (typeof actualizarKpisEntregasSap === 'function') {
                                actualizarKpisEntregasSap();
                            }

                            actualizarCheckboxTodos();
                        }
                    }
                );

                document.addEventListener(
                    'DOMContentLoaded',
                    function () {
                        actualizarCheckboxTodos();
                    }
                );

            </script>