                            function obtenerRegistrosPdfSeleccionados() {
                                return Array
                                    .from(document.querySelectorAll('tbody tr[data-ref]'))
                                    .filter(row => row.querySelector('.ck')?.checked)
                                    .map(row => ({
                                        solicitudId: row.getAttribute('data-solicitud') || '',
                                        referencia: row.getAttribute('data-ref') || '',
                                        cliente: row.getAttribute('data-cliente') || ''
                                    }))
                                    .filter(x => x.solicitudId && x.referencia);
                            }

                            function normalizarClientePdf(valor) {
                                return String(valor || '')
                                    .trim()
                                    .toUpperCase();
                            }

                            function validarMismoClientePdf(registros) {
                                const clientes = Array.from(
                                    new Set(
                                        registros
                                            .map(x => normalizarClientePdf(x.cliente))
                                            .filter(Boolean)
                                    )
                                );

                                return {
                                    ok: clientes.length <= 1,
                                    clientes
                                };
                            }

                            function abrirPdfSeleccionados() {
                                const seleccionados = obtenerRegistrosPdfSeleccionados();

                                if (!seleccionados.length) {
                                    alert('Selecciona al menos un registro para generar el PDF.');
                                    return;
                                }

                                const validacion = validarMismoClientePdf(seleccionados);

                                if (!validacion.ok) {
                                    alert(
                                        'Para generar un solo PDF debes seleccionar registros ' +
                                        'del mismo cliente.\n\n' +
                                        'Se detectaron ' + validacion.clientes.length +
                                        ' clientes distintos.'
                                    );
                                    return;
                                }

                                pdfModoMultiple = true;
                                pdfRegistrosSeleccionados = seleccionados;

                                pdfSolicitudId = null;
                                pdfReferenciaDocMeat = null;

                                limpiarModalPdf();

                                const solicitudLabel =
                                    document.getElementById('pdfSolicitudLabel');

                                const referenciaLabel =
                                    document.getElementById('pdfReferenciaLabel');

                                if (solicitudLabel) {
                                    solicitudLabel.textContent =
                                        `${seleccionados.length} registros del mismo cliente`;
                                }

                                if (referenciaLabel) {
                                    const cliente =
                                        String(seleccionados[0]?.cliente || '').trim();

                                    const refs = seleccionados
                                        .slice(0, 3)
                                        .map(x => x.referencia)
                                        .join(', ');

                                    referenciaLabel.textContent =
                                        (cliente ? cliente + ' | ' : '') +
                                        (
                                            seleccionados.length > 3
                                                ? `${refs} +${seleccionados.length - 3} más`
                                                : refs
                                        );
                                }

                                actualizarNotaOrigenPdf();

                                bootstrap.Modal.getOrCreateInstance(
                                    document.getElementById('pdfComentariosModal')
                                ).show();
                            }

                            function construirUrlPdf(
                                solicitudId,
                                referencia,
                                origenDatos,
                                comentarios
                            ) {
                                const params = new URLSearchParams();

                                params.set('id', solicitudId || '');
                                params.set('referencia', referencia || '');
                                params.set('source', SOURCE || '');
                                params.set('origenDatos', origenDatos || 'remision');
                                params.set('comentarios', comentarios || '');

                                return '@Url.Action("OrdenVentaPdf", "ProcesosCG")'
                                    + '?'
                                    + params.toString();
                            }

                            async function generarPdfConComentarios() {
                                if (pdfGenerando) return;

                                const comentarios =
                                    document.getElementById('pdfComentarios')?.value || '';

                                const origenDatos =
                                    document.querySelector('input[name="pdfOrigenDatos"]:checked')?.value || 'remision';

                                // PDF individual: conserva el comportamiento actual.
                                if (!pdfModoMultiple) {
                                    const url = construirUrlPdf(
                                        pdfSolicitudId,
                                        pdfReferenciaDocMeat,
                                        origenDatos,
                                        comentarios
                                    );

                                    bootstrap.Modal.getInstance(
                                        document.getElementById('pdfComentariosModal')
                                    )?.hide();

                                    window.open(url, '_blank');
                                    return;
                                }

                                await generarPdfSeleccionadosUnificado(
                                    comentarios,
                                    origenDatos
                                );
                            }

                            async function generarPdfSeleccionadosUnificado(
                                comentarios,
                                origenDatos
                            ) {
                                const registros = [...pdfRegistrosSeleccionados];

                                if (!registros.length) {
                                    alert('Ya no hay registros seleccionados.');
                                    return;
                                }

                                const validacion = validarMismoClientePdf(registros);

                                if (!validacion.ok) {
                                    alert(
                                        'Los registros seleccionados ya no pertenecen al mismo cliente. ' +
                                        'Vuelve a seleccionarlos.'
                                    );
                                    return;
                                }

                                const btn = document.querySelector(
                                    '#pdfComentariosModal .pdf-btn-generate'
                                );

                                const progress =
                                    document.getElementById('pdfBatchProgress');

                                const textoOriginal =
                                    btn?.innerHTML || '📄 Generar PDF';

                                /*
                                 * Abrimos la ventana antes del await.
                                 * No escribimos HTML con document.write.
                                 */
                                const printWindow =
                                    window.open('about:blank', '_blank');

                                if (!printWindow || printWindow === window) {
                                    alert(
                                        'El navegador bloqueó la ventana del PDF. ' +
                                        'Permite ventanas emergentes para este sitio.'
                                    );
                                    return;
                                }

                                try {
                                    printWindow.document.title =
                                        'Preparando PDF consolidado...';

                                    const body = printWindow.document.body;

                                    if (body) {
                                        body.textContent =
                                            'Preparando PDF consolidado del mismo cliente...';
                                        body.style.fontFamily = 'Arial, sans-serif';
                                        body.style.padding = '32px';
                                        body.style.color = '#333';
                                    }
                                }
                                catch {
                                }

                                pdfGenerando = true;

                                try {
                                    if (btn) {
                                        btn.disabled = true;
                                        btn.innerHTML = '⏳ Consolidando...';
                                    }

                                    if (progress) {
                                        progress.classList.add('show');
                                        progress.textContent =
                                            `Consolidando ${registros.length} registros ` +
                                            `del mismo cliente...`;
                                    }

                                    const cliente =
                                        String(registros[0]?.cliente || '').trim();

                                    showLog(
                                        'info',
                                        `Consolidando ${registros.length} registros ` +
                                        (cliente ? `del cliente ${cliente} ` : '') +
                                        'en un solo PDF...'
                                    );

                                    const payload = {
                                        source: SOURCE || 'P1',
                                        origenDatos: origenDatos || 'remision',
                                        comentarios: comentarios || '',
                                        registros: registros.map(x => ({
                                            solicitudId: x.solicitudId,
                                            referencia: x.referencia,
                                            cliente: x.cliente || ''
                                        }))
                                    };

                                    /*
                                     * UNA SOLA petición:
                                     * el backend consolida todos los registros
                                     * seleccionados del mismo cliente.
                                     */
                                    const response = await fetch(
                                        '@Url.Action("OrdenVentaPdfAgrupadoCliente", "ProcesosCG")',
                                        {
                                            method: 'POST',
                                            credentials: 'same-origin',
                                            headers: {
                                                'Content-Type': 'application/json'
                                            },
                                            body: JSON.stringify(payload)
                                        }
                                    );

                                    const html = await response.text();

                                    if (!response.ok) {
                                        const detalle = html
                                            .replace(/<[^>]*>/g, ' ')
                                            .replace(/\s+/g, ' ')
                                            .trim()
                                            .substring(0, 500);

                                        throw new Error(
                                            `HTTP ${response.status}. ${detalle}`
                                        );
                                    }

                                    const parser = new DOMParser();
                                    const doc = parser.parseFromString(
                                        html,
                                        'text/html'
                                    );

                                    if (!doc.querySelector('.page')) {
                                        const detalle = (
                                            doc.body?.innerText || html
                                        )
                                            .replace(/\s+/g, ' ')
                                            .trim()
                                            .substring(0, 400);

                                        throw new Error(
                                            'El servidor no regresó la vista PDF esperada. ' +
                                            detalle
                                        );
                                    }

                                    /*
                                     * La respuesta queda aislada en la pestaña del PDF.
                                     * Retiramos scripts para que no afecten esta vista.
                                     */
                                    doc.querySelectorAll('script').forEach(
                                        el => el.remove()
                                    );

                                    doc.querySelectorAll('[src]').forEach(el => {
                                        const valor = el.getAttribute('src');
                                        if (!valor) return;

                                        try {
                                            el.setAttribute(
                                                'src',
                                                new URL(valor, response.url).href
                                            );
                                        }
                                        catch {
                                        }
                                    });

                                    doc.querySelectorAll('link[href]').forEach(el => {
                                        const valor = el.getAttribute('href');
                                        if (!valor) return;

                                        try {
                                            el.setAttribute(
                                                'href',
                                                new URL(valor, response.url).href
                                            );
                                        }
                                        catch {
                                        }
                                    });

                                    let base = doc.querySelector('base');

                                    if (!base) {
                                        base = doc.createElement('base');
                                        doc.head.prepend(base);
                                    }

                                    base.setAttribute(
                                        'href',
                                        window.location.origin + '/'
                                    );

                                    const finalHtml =
                                        '<!DOCTYPE html>\n' +
                                        doc.documentElement.outerHTML;

                                    const blob = new Blob(
                                        [finalHtml],
                                        { type: 'text/html;charset=utf-8' }
                                    );

                                    const blobUrl =
                                        URL.createObjectURL(blob);

                                    printWindow.location.replace(blobUrl);
                                    printWindow.focus();

                                    setTimeout(function () {
                                        try {
                                            URL.revokeObjectURL(blobUrl);
                                        }
                                        catch {
                                        }
                                    }, 120000);

                                    bootstrap.Modal
                                        .getInstance(
                                            document.getElementById(
                                                'pdfComentariosModal'
                                            )
                                        )
                                        ?.hide();

                                    showLog(
                                        'success',
                                        `${registros.length} registros consolidados ` +
                                        'en un solo PDF.'
                                    );
                                }
                                catch (error) {
                                    console.error(
                                        'Error al generar PDF consolidado:',
                                        error
                                    );

                                    try {
                                        if (printWindow && !printWindow.closed) {
                                            printWindow.close();
                                        }
                                    }
                                    catch {
                                    }

                                    showLog(
                                        'danger',
                                        'No se pudo generar el PDF consolidado: ' +
                                        (error?.message || error)
                                    );

                                    alert(
                                        'No se pudo generar el PDF consolidado.\n\n' +
                                        (error?.message || error)
                                    );
                                }
                                finally {
                                    pdfGenerando = false;

                                    if (btn) {
                                        btn.disabled = false;
                                        btn.innerHTML = textoOriginal;
                                    }

                                    if (progress) {
                                        progress.classList.remove('show');
                                    }
                                }
                            }

                            document.addEventListener('input', function (e) {
                                if (e.target && e.target.id === 'pdfComentarios') {
                                    document.getElementById('pdfComentariosCount').textContent =
                                        e.target.value.length + '/1000';
                                }
                            });

                            document.addEventListener('change', function (e) {
                                if (e.target && e.target.name === 'pdfOrigenDatos') {
                                    actualizarNotaOrigenPdf();
                                }
                            });
                                // ===== CONTROL DE PERMISOS =====
                        let permisosEntregas = { puedeLeer: false, puedeEscribir: false, puedeEliminar: false };

                        document.addEventListener("DOMContentLoaded", async () => {
