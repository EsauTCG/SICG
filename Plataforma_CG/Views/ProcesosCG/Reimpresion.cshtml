      function reAuditQuery(){
        const p = new URLSearchParams();

        const values = {
          desde: document.getElementById('reAuditDesde').value,
          hasta: document.getElementById('reAuditHasta').value,
          planta: document.getElementById('reAuditPlanta').value,
          usuario: document.getElementById('reAuditUsuario').value.trim(),
          codigo: document.getElementById('reAuditCodigo').value.trim(),
          impresora: document.getElementById('reAuditImpresora').value.trim(),
          resultado: document.getElementById('reAuditResultado').value
        };

        Object.entries(values).forEach(([k,v]) => {
          if(v) p.set(k,v);
        });

        return p.toString();
