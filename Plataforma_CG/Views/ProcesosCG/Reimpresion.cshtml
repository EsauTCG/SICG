      async function loadReAudit(){
        const body = document.getElementById('reAuditBody');
        const btn = document.getElementById('btnReAuditSearch');

        btn.disabled = true;

        body.innerHTML = `
          <tr>
            <td colspan="13">
              <div class="re-audit-empty">Consultando auditoría...</div>
            </td>
          </tr>`;

        try{
          const qs = reAuditQuery();

          const res = await fetch(
            `${URL_AUDIT}?${qs}${qs?'&':''}top=5000&_=${Date.now()}`,
            {
              credentials:'include',
              headers:{'X-Requested-With':'XMLHttpRequest'}
            }
          );

          const r = await safeRead(res);

          if(r.isHtml || !res.ok || !r.okParse || !r.data?.ok){
            throw new Error(
              r.data?.msg ||
              `No se pudo consultar auditoría. HTTP ${res.status}`
            );
          }

          if(!r.data.auditoriaDisponible){
            body.innerHTML = `
              <tr>
                <td colspan="13">
                  <div class="re-audit-empty">
                    Falta instalar dbo.ReimpresionEtiquetaAuditoria.
