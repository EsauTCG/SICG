@model Plataforma_CG.ViewModels.ReimpresionEtiquetaVM
@Html.AntiForgeryToken()
@removeTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Reimpresión de Etiquetas";
}

<style>
    :root {
        --bg: #f0dede;
        --panel: #f8eeee;
        --panel-2: #f1dede;
        --line: #c79d9d;
        --text: #3b1717;
        --muted: #6a3a3a;
        --white: #ffffff;
        --shadow: 0 1px 0 rgba(255,255,255,.55) inset;
        --brand: #8B0000;
        --vino-1: #5c0000;
        --vino-2: #7a0000;
        --vino-3: #980000;
        --vino-4: #b30000;
        --vino-border: #9a5a5a;
        --vino-text-dark: #4a1111;
    }

    * { box-sizing: border-box; }

    body {
        margin: 0 !important;
        padding: 0 !important;
        font-family: Tahoma, Verdana, Arial, sans-serif;
        background: transparent !important;
        color: var(--text);
    }

    .container, .container-fluid {
        max-width: 100% !important;
        width: 100% !important;
        padding: 0 !important;
        margin: 0 !important;
    }

    .window {
        width: 100%;
        max-width: 100%;
        margin: 0 !important;
        border: 1px solid #7e4a4a;
        background: var(--panel);
        box-shadow: 0 0 0 1px rgba(255,255,255,.45) inset, 0 8px 18px rgba(70,12,12,.14);
        overflow: visible !important;
        padding: 0 !important;
    }

    .window > *:first-child, .titlebar { margin-top: 0 !important; }

    .titlebar {
        height: 34px;
       /*  display: flex; */
        display: none !important;
        align-items: center;
        justify-content: space-between;
        padding: 0 10px;
        background: linear-gradient(180deg, #c00000 0%, #8b0000 60%, #5c0000 100%);
        border-bottom: 1px solid #5c0000;
        color: #fff;
        font-size: 13px;
        font-weight: bold;
    }

    .titlebar .actions { display: flex; gap: 6px; }

    .win-btn {
        width: 16px; height: 16px;
        border: 1px solid #7c4848;
        background: linear-gradient(#fff6f6, #ead0d0);
    }

    .toolbar {
        display: flex;
        align-items: center;
        gap: 4px;
        padding: 4px 6px;
        background: linear-gradient(#fff6f6, #ecd8d8);
        border-bottom: 1px solid var(--line);
        font-size: 12px;
        flex-wrap: wrap;
    }

    .tool-btn {
        min-width: 72px;
        text-align: center;
        background: linear-gradient(#fffefe, #ecd7d7);
        border: 1px solid var(--vino-border);
        box-shadow: var(--shadow);
        cursor: pointer;
        color: var(--vino-text-dark);
        height: 28px;
        font-size: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
        padding: 0 8px;
        text-decoration: none;
    }

    .tool-btn:hover { filter: brightness(.98); }

    .content { padding: 8px; background: var(--bg); }

    .tabs { display: flex; gap: 4px; margin-bottom: 6px; flex-wrap: wrap; }

    .tab {
        font-size: 12px;
        background: linear-gradient(#f7e7e7, #ead1d1);
        border: 1px solid #caa0a0;
        border-bottom: none;
        padding: 7px 12px;
        color: #5c1a1a;
        user-select: none;
    }

    .tab.active {
        background: linear-gradient(180deg, #b30000 0%, #8b0000 55%, #5c0000 100%);
        font-weight: bold;
        color: #fff;
        border-color: #7a2d2d;
    }

    .workspace { border: 1px solid var(--line); background: var(--panel); padding: 8px; }

    .section { border: 1px solid var(--line); background: var(--white); margin-bottom: 10px; }

    .section-title {
        padding: 6px 8px;
        font-size: 12px;
        font-weight: bold;
        color: #fff;
        background: linear-gradient(180deg, #b30000 0%, #8b0000 55%, #5c0000 100%);
        border-bottom: 1px solid #6b1f1f;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    /* ── Filtros / Config ── */
    .config-grid {
        display: grid;
        grid-template-columns:
            120px
            minmax(180px, 220px)
            minmax(220px, 1.2fr)
            140px
            140px
            82px
            140px
            auto;
        gap: 6px;
        padding: 8px 10px;
        background: var(--panel-2);
        align-items: end;
    }

    .date-filter-group.is-disabled {
        opacity: .48;
    }

    .date-filter-group input:disabled {
        background: #eee !important;
        color: #777 !important;
        cursor: not-allowed;
    }

    .fecha-help {
        grid-column: 1 / -1;
        margin-top: -1px;
        font-size: 10px;
        color: #6a3a3a;
    }

    .filter-group label {
        display: block;
        color: #5c1a1a;
        font-size: 12px;
        margin-bottom: 4px;
        font-weight: bold;
    }

    input, select, .form-control, .form-select {
        height: 28px !important;
        padding: 3px 6px !important;
        border: 1px solid #b48787 !important;
        background: #fffdfd !important;
        font-family: inherit !important;
        font-size: 12px !important;
        width: 100%;
        border-radius: 0 !important;
        box-shadow: none !important;
        color: #421414 !important;
    }

    input[type="checkbox"] {
        height: 14px !important;
        width: 14px !important;
        min-width: 14px !important;
        max-width: 14px !important;
        padding: 0 !important;
        border-radius: 2px !important;
        cursor: pointer;
        display: inline-block !important;
    }

    input[type="number"].form-control-sm,
    input[type="text"].form-control-sm {
        height: 24px !important;
        padding: 2px 5px !important;
        font-size: 12px !important;
    }

    select.form-select-sm {
        height: 24px !important;
        padding: 2px 5px !important;
        font-size: 12px !important;
    }

    .pm-actions {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
    }

    .pm-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        height: 28px;
        padding: 0 10px;
        border: 1px solid transparent;
        border-radius: 0;
        font-family: Tahoma, Verdana, Arial, sans-serif;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        text-decoration: none;
        box-shadow: var(--shadow);
        white-space: nowrap;
    }

    .pm-btn:hover { filter: brightness(.97); }
    .pm-btn:active { transform: translateY(1px); }
    .pm-btn:disabled { opacity: .6; cursor: not-allowed; }

    .pm-btn-primary {
        color: #fff;
        border-color: #7a2d2d;
        background: linear-gradient(180deg, #b30000 0%, #8b0000 55%, #5c0000 100%);
    }

    .pm-btn-success {
        color: #fff;
        border-color: #157347;
        background: linear-gradient(180deg, #27ae60 0%, #1f9a54 55%, #198754 100%);
    }

    .pm-btn-secondary {
        background: linear-gradient(#fffefe, #ecd7d7);
        border-color: var(--vino-border);
        color: var(--vino-text-dark);
    }

    .pm-btn-outline {
        background: transparent;
        border-color: var(--vino-border);
        color: #5a0000;
    }

    /* ── Estado badge ── */
    .estado-badge {
        display: inline-block;
        padding: 2px 10px;
        font-size: 11px;
        font-weight: 700;
        border: 1px solid transparent;
        border-radius: 2px;
    }

    .est-listo    { background: #f3f3f3; border-color: #ccc; color: #555; }
    .est-info     { background: #e8f4fd; border-color: #7ab8d4; color: #064b6b; }
    .est-success  { background: #dff3e2; border-color: #6aa84f; color: #2f6b1f; }
    .est-warning  { background: #fff4cc; border-color: #d6b656; color: #7a5a00; }
    .est-danger   { background: #fde2e2; border-color: #d9534f; color: #b00000; }

    /* ── Tabla ── */
    .table-wrap {
        overflow: auto;
        max-height: 55vh;
        background: #fffafa;
        width: 100%;
        position: relative;
        border-top: 1px solid #d9b8b8;
    }

    .table-wrap table {
        width: 100%;
        table-layout: fixed;
        border-collapse: separate !important;
        border-spacing: 0 !important;
        font-size: 12px;
        background: #fffafa;
    }

    .table-wrap thead,
    .table-wrap thead tr,
    .table-wrap thead th {
        background: linear-gradient(180deg, #b30000 0%, #8b0000 55%, #5c0000 100%) !important;
        color: #fff !important;
    }

    .table-wrap thead th {
        position: sticky;
        top: -1px;
        z-index: 20;
        border-top: 1px solid #c46a6a !important;
        border-right: 1px solid #8e3b3b !important;
        border-bottom: 1px solid #5c0000 !important;
        padding: 6px 5px !important;
        font-weight: 700 !important;
        font-size: 12px !important;
        white-space: nowrap;
        line-height: 1.2 !important;
        box-shadow: 0 2px 0 #6f1d1d;
    }

    .table-wrap thead th:first-child { border-left: 1px solid #8e3b3b !important; }

    .table-wrap tbody td {
        background: #fffafa !important;
        border-right: 1px solid #d8bcbc !important;
        border-bottom: 1px solid #d8bcbc !important;
        padding: 4px 5px !important;
        white-space: nowrap;
        vertical-align: middle;
        font-size: 12px !important;
        overflow: hidden;
        text-overflow: ellipsis;
        line-height: 1.2 !important;
        color: #401515 !important;
    }

    .table-wrap tbody td:first-child { border-left: 1px solid #d8bcbc !important; }
    .table-wrap tbody tr:nth-child(even) td { background: #f9eded !important; }
    .table-wrap tbody tr:hover td { background: #f4dddd !important; }

    /* anchos tabla etiquetas */
    .tbl-eti th:nth-child(1), .tbl-eti td:nth-child(1) { width: 40px; }   /* estado */
    .tbl-eti th:nth-child(2), .tbl-eti td:nth-child(2) { width: 260px; }  /* código */
    .tbl-eti th:nth-child(3), .tbl-eti td:nth-child(3) { width: 100px; }  /* cantidad */
    .tbl-eti th:nth-child(4), .tbl-eti td:nth-child(4) { width: 220px; }  /* etiquetación */
    .tbl-eti th:nth-child(5), .tbl-eti td:nth-child(5) { width: 80px; }   /* acción */

    .text-end { text-align: right !important; }
    .text-center { text-align: center !important; }

    /* ── Status icono ── */
    .status {
        font-size: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: default;
    }

    /* ── Paste box ── */
    #pasteBox {
        display: none;
        padding: 10px;
        background: var(--panel-2);
        border-top: 1px solid var(--line);
    }

    #pasteArea {
        height: auto !important;
        resize: vertical;
        font-family: Courier New, monospace !important;
        font-size: 11px !important;
    }

    /* ── Progress ── */
    .progress-wrap { display: none; padding: 8px 10px; background: var(--panel-2); border-top: 1px solid var(--line); }

    .progress-bar-wrap {
        height: 8px;
        background: #e4cece;
        border: 1px solid #c79d9d;
        margin-top: 4px;
        overflow: hidden;
    }

    .progress-bar-fill {
        height: 100%;
        background: linear-gradient(90deg, #b30000, #8b0000);
        transition: width .3s ease;
        width: 0%;
    }

    /* ── Log ── */
    #logBox { margin-top: 8px; display: none; }

    .log-inner {
        padding: 6px 10px;
        font-size: 12px;
        border: 1px solid var(--line);
        white-space: pre-wrap;
        font-family: Tahoma, Verdana, Arial, sans-serif;
    }

    .log-info      { background: #e8f4fd; border-color: #7ab8d4; color: #064b6b; }
    .log-success   { background: #dff3e2; border-color: #6aa84f; color: #2f6b1f; }
    .log-danger    { background: #fde2e2; border-color: #d9534f; color: #b00000; }
    .log-warning   { background: #fff4cc; border-color: #d6b656; color: #7a5a00; }
    .log-secondary { background: #f4f4f4; border-color: #ccc; color: #555; }

    /* ── Statusbar ── */
    .statusbar {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 6px 10px;
        font-size: 11px;
        color: #4a1a1a;
        border-top: 1px solid #b88c8c;
        background: linear-gradient(#f6e9e9, #ead5d5);
        flex-wrap: wrap;
    }

    @@media(max-width: 1450px) {
        .config-grid {
            grid-template-columns:
                105px
                minmax(165px, 200px)
                minmax(195px, 1fr)
                125px
                125px
                76px
                125px
                auto;
        }
    }

    @@media(max-width: 1100px) {
        .config-grid { grid-template-columns: 1fr 1fr 1fr 1fr; }
    }

    @@media(max-width: 768px) {
        .config-grid { grid-template-columns: 1fr 1fr; }
    }

    /* Botones superiores a la derecha y con colores */
    .toolbar {
        justify-content: flex-end !important;
        gap: 6px !important;
    }

        .toolbar .tool-btn {
            color: #fff !important;
            font-weight: 800 !important;
            border-radius: 0 !important;
        }

    #btnPrint {
        background: linear-gradient(180deg,#198754 0%,#146c43 100%) !important;
        border-color: #146c43 !important;
    }

    .toolbar .tool-btn:nth-child(2) {
        background: linear-gradient(180deg,#0d6efd 0%,#084298 100%) !important;
        border-color: #084298 !important;
    }

    .toolbar .tool-btn:nth-child(3) {
        background: linear-gradient(180deg,#6f42c1 0%,#4b2a86 100%) !important;
        border-color: #4b2a86 !important;
    }

    .toolbar .tool-btn:nth-child(4) {
        background: linear-gradient(180deg,#dc3545 0%,#a71d2a 100%) !important;
        border-color: #a71d2a !important;
    }

    .toolbar .tool-btn:nth-child(5) {
        background: linear-gradient(180deg,#ffc107 0%,#d39e00 100%) !important;
        border-color: #c99700 !important;
        color: #3b2b00 !important;
    }

    @@media (max-width: 768px) {
        .toolbar {
            display: grid !important;
            grid-template-columns: 1fr 1fr !important;
        }

            .toolbar .tool-btn {
                width: 100% !important;
            }
    }

    .eti-search,
    .lookup-search {
        height: 24px !important;
        margin-bottom: 4px;
        font-size: 12px !important;
    }

    .eti-cell {
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

        .eti-cell .eti-search {
            margin-bottom: 0;
        }

    .lookup-source {
        display: none !important;
    }

    .lookup-picker {
        position: relative;
        width: 100%;
        font-family: Tahoma, Verdana, Arial, sans-serif;
        font-size: 12px;
    }

    .lookup-picker-btn {
        width: 100%;
        height: 28px;
        padding: 3px 6px;
        border: 1px solid #b48787;
        background: #fffdfd;
        color: #421414;
        display: flex;
        align-items: center;
        justify-content: space-between;
        cursor: pointer;
        font-family: inherit;
        font-size: 12px;
        text-align: left;
    }

    .lookup-picker-text {
        overflow: hidden;
        white-space: nowrap;
        text-overflow: ellipsis;
    }

    .lookup-picker-caret {
        margin-left: 8px;
        color: #7a3333;
        font-size: 10px;
    }


    .lookup-picker-menu {
        display: none;
        position: absolute;
        top: 29px;
        left: 0;
        width: 100%;
        min-width: 100%;
        max-width: 100%;
        max-height: 620px;
        z-index: 99999;
        background: #fffdfd;
        border: 1px solid #b48787;
        box-shadow: 0 4px 10px rgba(70, 12, 12, .18);
        padding: 8px;
    }

    .lookup-picker.open .lookup-picker-menu {
        display: block;
    }

    .lookup-picker-search {
        height: 28px !important;
        margin-bottom: 8px;
        font-size: 12px !important;
    }

    .lookup-picker-loading {
        display: none;
        padding: 4px 0 8px;
        margin-bottom: 4px;
        color: #6a3a3a;
        font-size: 11px;
        border-bottom: 1px solid #d8bcbc;
    }

    .lookup-picker-list {
        max-height: 530px;
        overflow-y: auto;
    }

    .lookup-picker-option {
        display: flex;
        align-items: flex-start;
        gap: 6px;
        padding: 4px 2px;
        cursor: pointer;
        color: #421414;
        line-height: 1.25;
    }

        .lookup-picker-option:hover {
            background: #f4dddd;
        }

        .lookup-picker-option input[type="checkbox"] {
            width: 13px !important;
            height: 13px !important;
            min-width: 13px !important;
            margin-top: 1px;
            pointer-events: none;
        }

    .lookup-picker-empty {
        padding: 6px 2px;
        color: #8a5a5a;
        font-size: 11px;
    }

    @@media (max-width: 768px) {
        .lookup-picker-menu {
            width: 100%;
            min-width: 100%;
            max-height: 420px;
        }

        .lookup-picker-list {
            max-height: 330px;
        }
    }

    .tbl-eti .lookup-picker-menu {
        max-height: 360px !important;
    }

    .tbl-eti .lookup-picker-list {
        max-height: 300px !important;
    }

    .tbl-eti .lookup-picker-option span {
        white-space: normal !important;
        line-height: 1.2 !important;
    }


    /* =========================================================
       FIX DESPLEGABLE DE ETIQUETACIONES DENTRO DE LA TABLA
       ========================================================= */
    .tbl-eti tbody td:nth-child(4) {
        overflow: visible !important;
        position: relative;
    }

    .tbl-eti .lookup-picker {
        position: relative;
        z-index: 30;
    }

    .tbl-eti .lookup-picker.open {
        z-index: 1000000;
    }

    .tbl-eti .lookup-picker-menu.lookup-fixed-menu {
        position: fixed !important;
        z-index: 2147483000 !important;
        margin: 0 !important;
        max-width: none !important;
        background: #fff !important;
        border: 1px solid var(--ui-line-strong, #cfd5db) !important;
        box-shadow: 0 14px 34px rgba(30,36,44,.22) !important;
    }

    .tbl-eti .lookup-picker-menu.lookup-fixed-menu .lookup-picker-list {
        overflow-y: auto !important;
        min-height: 36px;
    }

    .toolbar .tool-btn-add {
        background: linear-gradient(180deg,#198754 0%,#146c43 100%) !important;
        border-color: #146c43 !important;
        color: #fff !important;
        font-weight: 800 !important;
    }

        .toolbar .tool-btn-add i {
            color: #fff !important;
        }

    /* =========================================================
       AUDITORÍA DE REIMPRESIONES
       ========================================================= */
    .re-audit-modal {
        position: fixed;
        inset: 0;
        z-index: 99999;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 16px;
        background: rgba(20, 10, 10, .58);
    }

    .re-audit-modal.show {
        display: flex;
    }

    .re-audit-dialog {
        width: min(1700px, 98vw);
        height: min(860px, 94vh);
        min-width: 0;
        display: flex;
        flex-direction: column;
        overflow: hidden;
        border: 1px solid #7a2d2d;
        background: #fffafa;
        box-shadow: 0 24px 70px rgba(0,0,0,.28);
    }

    .re-audit-head {
        flex: 0 0 auto;
        min-height: 44px;
        padding: 7px 10px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        color: #fff;
        background: linear-gradient(180deg, #b30000 0%, #8b0000 55%, #5c0000 100%);
    }

    .re-audit-title {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 0;
    }

    .re-audit-title strong {
        display: block;
        font-size: 13px;
    }

    .re-audit-title small {
        display: block;
        margin-top: 2px;
        color: rgba(255,255,255,.82);
        font-size: 10px;
    }

    .re-audit-close {
        width: 32px;
        height: 28px;
        border: 1px solid rgba(255,255,255,.5);
        color: #fff;
        background: rgba(255,255,255,.08);
        cursor: pointer;
    }

    .re-audit-body {
        flex: 1 1 auto;
        min-height: 0;
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: 9px;
        background: #f2dfdf;
    }

    .re-audit-filters {
        flex: 0 0 auto;
        display: grid;
        grid-template-columns: 125px 125px 105px minmax(150px,1fr) minmax(170px,1fr) minmax(170px,1fr) 115px auto;
        gap: 6px;
        align-items: end;
        padding: 8px;
        border: 1px solid #cfaeae;
        background: #fffafa;
    }

    .re-audit-filters label {
        display: block;
        margin-bottom: 3px;
        font-size: 10px;
        font-weight: 800;
        color: #5c1a1a;
    }

    .re-audit-filters input,
    .re-audit-filters select {
        height: 29px !important;
        font-size: 11px !important;
    }

    .re-audit-actions {
        display: flex;
        gap: 5px;
        white-space: nowrap;
    }

    .re-audit-summary {
        flex: 0 0 auto;
        display: grid;
        grid-template-columns: repeat(5, minmax(120px,1fr));
        gap: 6px;
    }

    .re-audit-kpi {
        padding: 7px 9px;
        border: 1px solid #cfaeae;
        background: #fffafa;
    }

    .re-audit-kpi span {
        display: block;
        color: #7a5555;
        font-size: 9px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .re-audit-kpi strong {
        display: block;
        margin-top: 2px;
        color: #5c0000;
        font-size: 17px;
        line-height: 1;
    }

    .re-audit-grid {
        flex: 1 1 auto;
        min-height: 220px;
        overflow: auto;
        border: 1px solid #cfaeae;
        background: #fff;
    }

    .re-audit-grid table {
        width: 100%;
