                <td class="text-end">${Number(x.cantidadImpresa ?? x.CantidadImpresa ?? 0).toLocaleString('es-MX')}</td>
                <td>${escapeHtml((x.claveReporte ?? x.ClaveReporte ?? '-').toString())}</td>
                <td>${escapeHtml((x.printerName ?? x.PrinterName ?? '-').toString())}</td>
                <td class="${ok?'re-audit-ok':'re-audit-error'}">${ok?'OK':'ERROR'}</td>
                <td class="re-audit-msg"
                    title="${escapeHtml((x.mensaje ?? x.Mensaje ?? '').toString())}">
                    ${escapeHtml((x.mensaje ?? x.Mensaje ?? '-').toString())}
                </td>
                <td>${escapeHtml((x.operacionId ?? x.OperacionId ?? '-').toString())}</td>
                <td>${escapeHtml((x.ip ?? x.Ip ?? '-').toString())}</td>
              </tr>`;
          }).join('');

          if(r.data.truncado){
            showLog(
              'warning',
              `Auditoría: existen ${Number(s.total||0).toLocaleString('es-MX')} registros; ` +
              `se muestran los ${Number(r.data.mostrados||rows.length).toLocaleString('es-MX')} más recientes.`
            );
          }

        }catch(e){
          body.innerHTML = `
            <tr>
              <td colspan="13">
                <div class="re-audit-empty">
                  ${escapeHtml(e?.message || e)}
                </div>
              </td>
            </tr>`;

          showLog('danger','Error auditoría: '+(e?.message || e));
        }finally{
          btn.disabled = false;
        }
      }

      function resetReAudit(){
        document.getElementById('reAuditDesde').value = '';
        document.getElementById('reAuditHasta').value = '';
        document.getElementById('reAuditPlanta').value = '';
        document.getElementById('reAuditUsuario').value = '';
        document.getElementById('reAuditCodigo').value = '';
        document.getElementById('reAuditImpresora').value = '';
        document.getElementById('reAuditResultado').value = '';

        initReAuditDates();
        loadReAudit();
      }

      function downloadReAuditExcel(){
        const qs = reAuditQuery();
        window.location.href =
          `${URL_AUDIT_XL}?${qs}${qs?'&':''}_=${Date.now()}`;
      }

      document.getElementById('btnReAudit')?.addEventListener('click', openReAudit);
      document.getElementById('btnReAuditClose')?.addEventListener('click', closeReAudit);
      document.getElementById('btnReAuditSearch')?.addEventListener('click', loadReAudit);
      document.getElementById('btnReAuditReset')?.addEventListener('click', resetReAudit);
      document.getElementById('btnReAuditExcel')?.addEventListener('click', downloadReAuditExcel);

      document.getElementById('reAuditUsuario')?.addEventListener('keydown', e => {
        if(e.key === 'Enter') loadReAudit();
      });

      document.getElementById('reAuditCodigo')?.addEventListener('keydown', e => {
        if(e.key === 'Enter') loadReAudit();
      });

      document.getElementById('reAuditImpresora')?.addEventListener('keydown', e => {
        if(e.key === 'Enter') loadReAudit();
      });

      document.getElementById('reAuditModal')?.addEventListener('click', e => {
        if(e.target.id === 'reAuditModal') closeReAudit();
      });

      document.addEventListener('keydown', e => {
        if(e.key === 'Escape' &&
           document.getElementById('reAuditModal')?.classList.contains('show')){
          closeReAudit();
        }
      });

      window.printAll = async function(){
        const btn  = document.getElementById('btnPrint');
        const btn2 = document.getElementById('btnPrint2');
        if(btn)  btn.disabled  = true;
        if(btn2) btn2.disabled = true;
        try{
          const cfg = getConfig();
          if(!cfg.printerName){ showLog('warning', 'Selecciona impresora.'); setUiState('Falta impresora', 'text-bg-warning'); return; }

          const errorFechas = validarFechasImpresion(cfg);
          if(errorFechas){
            showLog('warning', errorFechas);
            setUiState('Revisa fechas', 'text-bg-warning');
            return;
          }

          if(cfg.usarFechasManuales){
            showLog(
              'info',
              `Modo fechas manuales: Sacrificio ${cfg.fechaSacrificio}, ` +
              `Producción ${cfg.fechaProduccion}, Caducidad ${cfg.fechaCaducidad}.`
            );
          }else{
            showLog(
              'info',
              'Fechas vacías: se utilizarán las fechas originales de la etiquetación.'
            );
          }

          const items = collectItems();
          if(!items.length){ showLog('warning', 'Agrega al menos una etiqueta.'); setUiState('Sin filas', 'text-bg-warning'); return; }
          const valid = items.filter(it => (it.code||'').trim() && (it.qty||0) > 0 && (it.eti||'').trim());
          if(!valid.length){ showLog('warning', 'No hay filas válidas para imprimir.'); setUiState('Sin filas válidas', 'text-bg-warning'); return; }
          savePrinter(cfg.plant, cfg.printerName);
          const baseReq = {
            source: cfg.plant,
            empresaEysId: cfg.empresaEysId || 'CARNG',
            tipoImpresion: 3,
            printerName: cfg.printerName,
            claveReporte: cfg.claveReporte || '',
            usarFechasManuales: cfg.usarFechasManuales,
            fechaSacrificio: cfg.fechaSacrificio,
            fechaProduccion: cfg.fechaProduccion,
            fechaCaducidad: cfg.fechaCaducidad
          };
          const first = valid[0];
          setUiState(`Imprimiendo prueba (${cfg.plant})...`, 'text-bg-info');
          showLog('info', `Imprimiendo 1 etiqueta de prueba:\n${first.code}`);
          for(const it of items) setRowStatus(it.tr, null, 'Pendiente');
          const testReq = { ...baseReq, items: [{ CodigoEtiqueta: first.code, Cantidad: 1, ClaveReporte: first.eti }] };
          setProgress(true, 0, 1);
          const testRes = await fetchJson(URL_PRINT, testReq);
          const testR = await safeRead(testRes);
          if (testR.isHtml) { showLog('danger', 'Imprimir devolvió HTML:\n' + (testR.raw||'').slice(0,250)); setUiState('Error impresión', 'text-bg-danger'); return; }
          if(!testRes.ok || !testR.okParse || !testR.data?.ok){ showLog('danger', (testR.data?.msg||'No se pudo imprimir prueba.')+'\nHTTP '+testRes.status+'\n'+(testR.raw||'')); setUiState('Error impresión', 'text-bg-danger'); return; }
          const testRow = (testR.data.rows||[])[0];
          if(testRow) setRowStatus(first.tr, testRow.ok, `${testRow.msg} (x${testRow.cantidad})`);
          setProgress(true, 1, 1);
          if(testRow && testRow.ok === false){ showLog('danger', `Falló la etiqueta de prueba:\n${testRow.msg}`); setUiState('Prueba fallida', 'text-bg-danger'); return; }
          const okContinue = confirm(`✅ Se imprimió 1 etiqueta de prueba (${first.code}).\n\n¿La etiqueta salió correcta?\n\nAceptar = continuar con el resto\nCancelar = detener`);
          if(!okContinue){ showLog('warning', 'Cancelado por el usuario después de la prueba.'); setUiState('Cancelado', 'text-bg-warning'); return; }
          const restPayload = [];
          if(first.qty > 1) restPayload.push({ CodigoEtiqueta: first.code, Cantidad: first.qty - 1, ClaveReporte: first.eti });
          for(let i=1; i<valid.length; i++) restPayload.push({ CodigoEtiqueta: valid[i].code, Cantidad: valid[i].qty, ClaveReporte: valid[i].eti });
          if(!restPayload.length){ showLog('success', 'Solo se imprimió la prueba (no había más cantidades).'); setUiState('Completado', 'text-bg-success'); return; }
          setUiState(`Imprimiendo (${cfg.plant})...`, 'text-bg-info');
          showLog('info', `Continuando con el resto...\nTotal filas restantes: ${restPayload.length}`);
          setProgress(true, 0, restPayload.length);
          const res = await fetchJson(URL_PRINT, { ...baseReq, items: restPayload });
          const r = await safeRead(res);
          if (r.isHtml) { showLog('danger', 'Imprimir devolvió HTML:\n' + (r.raw||'').slice(0,250)); setUiState('Error impresión', 'text-bg-danger'); return; }
          if(!res.ok || !r.okParse || !r.data?.ok){ showLog('danger', (r.data?.msg||'No se pudo imprimir.')+'\nHTTP '+res.status+'\n'+(r.raw||'')); setUiState('Error impresión', 'text-bg-danger'); return; }
          const map = new Map();
          for(const row of (r.data.rows||[])) map.set((row.codigoEtiqueta||'').toUpperCase(), row);
          let done = 0, total = (r.data.rows||[]).length;
          for(const it of items){ const key=(it.code||'').trim().toUpperCase(); const row=map.get(key); if(row){ setRowStatus(it.tr, row.ok, `${row.msg} (x${row.cantidad})`); done++; setProgress(true, done, total); } }
          showLog(r.data.failCount===0?'success':'warning', `Terminado.\nOK: ${r.data.okCount}\nFallidas: ${r.data.failCount}`);
          setUiState(r.data.failCount===0?'Completado':'Completado con alertas', r.data.failCount===0?'text-bg-success':'text-bg-warning');
        }catch(e){ showLog('danger', 'Error: '+(e?.message||e)); setUiState('Error', 'text-bg-danger'); }
        finally{ setProgress(false); if(btn) btn.disabled=false; if(btn2) btn2.disabled=false; }
      };

      (async () => {
        try{
          setUiState('Cargando...', 'text-bg-info');
          const plantSel = document.getElementById('PlantaId');
          if (plantSel) plantSel.value = (DEFAULT_SOURCE || 'P1').toUpperCase();
          await Promise.allSettled([loadPrinters(), loadEtiquetaciones()]);

          const fechaProduccion = document.getElementById('FechaProduccion');
          const diasCaducidadManual = document.getElementById('DiasCaducidadManual');
          const fechaCaducidad = document.getElementById('FechaCaducidad');
          const quickCode = document.getElementById('QuickCode');
          const btnQuickAdd = document.getElementById('btnQuickAdd');
          const rowsBody = document.getElementById('rows');
          const printerSel = document.getElementById('PrinterName');

          quickCode?.addEventListener('keydown', async e => {
            if(e.key !== 'Enter') return;
            e.preventDefault();
            await quickAddCode();
          });
          btnQuickAdd?.addEventListener('click', quickAddCode);

          rowsBody?.addEventListener('input', updateLiveSummary);
          rowsBody?.addEventListener('change', updateLiveSummary);
          printerSel?.addEventListener('change', updateLiveSummary);
          document.getElementById('ClaveReporte')?.addEventListener('change', updateLiveSummary);
          document.getElementById('FechaSacrificio')?.addEventListener('change', updateLiveSummary);
          document.getElementById('FechaProduccion')?.addEventListener('change', updateLiveSummary);
          document.getElementById('FechaCaducidad')?.addEventListener('change', updateLiveSummary);

          document.addEventListener('keydown', e => {
            if(e.key === 'F2'){
              e.preventDefault();
              quickCode?.focus();
              quickCode?.select();
              return;
            }
            if(e.ctrlKey && e.key === 'Enter'){
              e.preventDefault();
              window.printAll?.();
            }
          });

          fechaProduccion?.addEventListener('change', () => {
            recalcularCaducidadDesdeProduccion(false);
          });

          diasCaducidadManual?.addEventListener('input', () => {
            if(!fechaProduccion?.value) return;
            recalcularCaducidadDesdeProduccion(true);
          });

          fechaCaducidad?.addEventListener('input', () => {
            fechaCaducidad.dataset.manual = '1';
            fechaCaducidad.dataset.auto = '0';
          });

          if (plantSel){
            plantSel.addEventListener('change', async () => {
              setUiState('Cambiando planta...', 'text-bg-info');
              await Promise.allSettled([loadPrinters(), loadEtiquetaciones()]);
              recalcularCaducidadDesdeProduccion(true);
              updateLiveSummary();
              setUiState('Listo', 'text-bg-light');
            });
          }
          updateLiveSummary();
          setUiState('Listo', 'text-bg-light');
        }catch(e){ showLog('danger', 'Error inicializando: '+(e?.message||e)); setUiState('Error', 'text-bg-danger'); }
      })();

    })();

    window.manualConfig = {
        title: "Manual de Reimpresion",
        sections: [
            { id: "Primeros pasos de uso", title: "Primeros pasos de uso", icon: "fa-home",
              steps: [
                { title: "1.1 Configuracion Inicial", text: "Paso a paso para configurar las Reimpresiones", image: "/images/ReImpresiones/etiquetas1-gif.gif" },
                { title: "1.2 Detalle de uso", text: "Paso a paso para configurar las Etiquetas", image: "/images/ReImpresiones/etiquetas2-gif.gif" }
              ]
            },
            { id: "Tutorial", title: "Tutorial", icon: "fa-file-lines",
              steps: [{ title: "2.1 Video Tutorial", text: "Tutorial como usar el modulo de ReImpresiones", video: "/images/ReImpresiones/etiquetas.mp4" }]
            }
        ]
    };
</script>
