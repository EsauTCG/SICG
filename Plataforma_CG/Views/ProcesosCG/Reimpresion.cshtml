      function getConfig(){
        const fechaSacrificio =
          document.getElementById('FechaSacrificio')?.value || null;

        const fechaProduccion =
          document.getElementById('FechaProduccion')?.value || null;

        const fechaCaducidad =
          document.getElementById('FechaCaducidad')?.value || null;

        /*
         * Si las tres fechas están vacías:
         * UsarFechasManuales = false
         * y el backend imprime la etiquetación ORIGINAL.
         *
         * Si el usuario captura al menos una fecha:
         * entramos al modo manual y validamos las tres.
         */
        const usarFechasManuales =
          !!fechaSacrificio ||
          !!fechaProduccion ||
          !!fechaCaducidad;

        return {
          plant: getPlant(),
          printerName: document.getElementById('PrinterName')?.value || '',
          claveReporte: document.getElementById('ClaveReporte')?.value || '',
          empresaEysId: document.getElementById('EmpresaEysId')?.value || '',

          usarFechasManuales,

          fechaSacrificio,
          fechaProduccion,
          fechaCaducidad
        };
      }

      function isoAddDays(isoDate, days){
        if(!isoDate || !Number.isFinite(days)) return '';

        const parts = isoDate.split('-').map(Number);
        if(parts.length !== 3 || parts.some(x => !Number.isFinite(x))) return '';

        const d = new Date(parts[0], parts[1] - 1, parts[2], 12, 0, 0, 0);
        d.setDate(d.getDate() + days);

        const y = d.getFullYear();
        const m = String(d.getMonth() + 1).padStart(2, '0');
        const day = String(d.getDate()).padStart(2, '0');

        return `${y}-${m}-${day}`;
      }

      function diasVidaEtiquetacionActual(){
        const id = (document.getElementById('ClaveReporte')?.value || '').trim();
        if(!id) return 0;

        const row = ETI_LIST.find(x => x.idRaw === id);
        return Number(row?.diasVida || 0);
      }

      function diasCaducidadManualActual(){
        const raw = document.getElementById('DiasCaducidadManual')?.value;
        if(raw === null || raw === undefined || String(raw).trim() === '') return 0;

        const dias = Number(raw);
        if(!Number.isFinite(dias) || dias <= 0) return 0;

        return Math.trunc(dias);
      }

      function recalcularCaducidadDesdeProduccion(force = false){
        const prod = document.getElementById('FechaProduccion');
        const cad = document.getElementById('FechaCaducidad');

        if(!prod || !cad || !prod.value) return;

        /*
         * Prioridad:
         * 1) Días escritos por el usuario.
         * 2) Días de vida configurados en la etiquetación.
         */
        const diasManual = diasCaducidadManualActual();
        const dias = diasManual > 0
          ? diasManual
          : diasVidaEtiquetacionActual();

        if(!Number.isFinite(dias) || dias <= 0) return;

        if(!force && cad.dataset.manual === '1' && diasManual <= 0) return;

        const calculada = isoAddDays(prod.value, dias);
        if(calculada){
          cad.value = calculada;
          cad.dataset.auto = '1';
          cad.dataset.manual = '0';
        }
      }

      function validarFechasImpresion(cfg){

        /*
         * Ninguna fecha capturada:
         * NO es error. Se imprime exactamente con las fechas originales
         * que ya obtiene el reporte.
         */
        if(!cfg.usarFechasManuales){
          return '';
        }

        /*
         * Si el usuario decidió cambiar fechas, entonces sí exigimos
         * las tres para no imprimir una etiqueta parcialmente modificada.
         */
        if(!cfg.fechaSacrificio)
          return 'Captura la Fecha de sacrificio o deja las tres fechas vacías para imprimir la original.';

        if(!cfg.fechaProduccion)
          return 'Captura la Fecha de producción o deja las tres fechas vacías para imprimir la original.';

        if(!cfg.fechaCaducidad)
          return 'Captura la Fecha de caducidad o deja las tres fechas vacías para imprimir la original.';

        if(cfg.fechaSacrificio > cfg.fechaProduccion){
          return 'La Fecha de sacrificio no puede ser posterior a la Fecha de producción.';
        }

        if(cfg.fechaCaducidad < cfg.fechaProduccion){
          return 'La Fecha de caducidad no puede ser anterior a la Fecha de producción.';
        }

        return '';
      }


