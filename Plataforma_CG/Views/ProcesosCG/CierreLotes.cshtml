@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Cierre de lotes";
    var source = (ViewBag.Source as string ?? "TIF").ToUpperInvariant();
}

<style>
    :root { --vino:#8b0000; --vino2:#5c0000; --line:#d6b4b4; --bg:#f5e7e7; }
    .cl-app{font-family:Tahoma,Verdana,Arial,sans-serif;font-size:12px;background:var(--bg);border:1px solid #8c5b5b;min-height:80vh}
    .cl-head{display:flex;align-items:center;justify-content:space-between;padding:8px 10px;background:linear-gradient(#b30000,#8b0000,#5c0000);color:#fff;font-weight:700}
    .cl-toolbar{display:grid;grid-template-columns:160px 150px 150px 150px 1fr;gap:7px;padding:9px;background:#f9eeee;border-bottom:1px solid var(--line);align-items:end}
    .cl-field label{display:block;font-size:11px;font-weight:700;color:#5c1a1a;margin-bottom:3px}
    .cl-field input,.cl-field select,.cl-modal input,.cl-modal textarea,.cl-modal select{width:100%;border:1px solid #b98d8d;border-radius:0;padding:5px 6px;font-size:12px;background:#fff}
    .cl-actions{display:flex;gap:6px;justify-content:flex-end;flex-wrap:wrap}
    .cl-btn{border:1px solid #7d4b4b;border-radius:0;padding:6px 10px;font-weight:700;font-size:11px;cursor:pointer;background:#fff}
    .cl-btn-primary{background:linear-gradient(#b30000,#8b0000,#5c0000);color:#fff;border-color:#6f1d1d}
    .cl-btn-success{background:#198754;color:#fff;border-color:#146c43}
    .cl-btn-warning{background:#ffc107;color:#3c2700;border-color:#c89500}
    .cl-btn-danger{background:#b02a37;color:#fff;border-color:#842029}
    .cl-btn-info{background:#0d6efd;color:#fff;border-color:#0a58ca}
    .cl-table-wrap{overflow:auto;max-height:68vh;background:#fff}
    .cl-table{width:100%;border-collapse:separate;border-spacing:0;min-width:1250px}
    .cl-table th{position:sticky;top:0;z-index:2;background:linear-gradient(#b30000,#8b0000,#5c0000);color:#fff;padding:7px 6px;border-right:1px solid #743030;white-space:nowrap;font-size:11px}
    .cl-table td{padding:6px;border-right:1px solid #ead2d2;border-bottom:1px solid #ead2d2;white-space:nowrap;background:#fff}
    .cl-table tr:nth-child(even) td{background:#fff8f8}
    .cl-table tr:hover td{background:#f9e2e2}
    .cl-badge{display:inline-block;padding:3px 7px;font-weight:700;border:1px solid;border-radius:10px;font-size:10px}
    .b-ok{background:#e8f6ee;color:#146c43;border-color:#75b798}.b-warn{background:#fff3cd;color:#664d03;border-color:#ffda6a}.b-bad{background:#f8d7da;color:#842029;border-color:#ea868f}.b-info{background:#cff4fc;color:#055160;border-color:#6edff6}
    .cl-summary{display:grid;grid-template-columns:repeat(6,minmax(120px,1fr));gap:7px;margin-bottom:10px}
    .cl-card{border:1px solid var(--line);background:#fff;padding:8px}.cl-card b{display:block;color:#6b1f1f;font-size:10px}.cl-card span{font-size:15px;font-weight:700}
    .cl-modal .modal-content{border-radius:0;border:1px solid #7e4a4a}.cl-modal .modal-header{background:linear-gradient(#b30000,#8b0000,#5c0000);color:#fff;border-radius:0}.cl-modal .modal-body{background:#fffafa}
    .cl-anom{border:1px solid #ddd;padding:8px;margin-bottom:6px;background:#fff}.cl-anom.bloqueo{border-left:5px solid #b02a37}.cl-anom.autorizacion{border-left:5px solid #ffc107}.cl-anom.advertencia{border-left:5px solid #0dcaf0}
    .cl-note{margin:8px;padding:8px;border:1px solid #d7b36b;background:#fff7dc;color:#513c00}
    .cl-tabs{display:flex;gap:5px;padding:7px 9px;background:#f4dddd;border-bottom:1px solid var(--line)}
    .cl-status{padding:7px 10px;background:#fff;border-top:1px solid var(--line);font-size:11px}
    @@media(max-width:900px){.cl-toolbar{grid-template-columns:1fr 1fr}.cl-summary{grid-template-columns:1fr 1fr}.cl-actions{justify-content:flex-start}}
</style>


