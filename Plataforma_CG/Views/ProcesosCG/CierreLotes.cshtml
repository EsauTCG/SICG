        </article>

        <article class="cl-kpi closed">
            <span>Cerrados</span>
            <strong id="clKpiCerrados">0</strong>
        </article>

        <article class="cl-kpi in">
            <span>Kg entrada</span>
            <strong id="clKpiEntrada">0.000 kg</strong>
        </article>

        <article class="cl-kpi out">
            <span>Kg salida</span>
            <strong id="clKpiSalida">0.000 kg</strong>
        </article>

        <article class="cl-kpi yield">
