@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Cierre de lotes";
    var source = (ViewBag.Source as string ?? "TIF").ToUpperInvariant();
}



<style>
    :root{
        --cl-brand:#7b1f29;
        --cl-brand-dark:#53151c;
        --cl-brand-soft:#f7eaec;
        --cl-bg:#eef2f4;
        --cl-card:#ffffff;
        --cl-card-alt:#f8fafb;
        --cl-line:#d4dde3;
        --cl-line-strong:#becbd3;
        --cl-text:#253746;
        --cl-muted:#687b8b;
        --cl-blue:#1769c2;
        --cl-green:#218a54;
        --cl-amber:#c88710;
        --cl-red:#a8343e;
        --cl-purple:#6651a6;
        --cl-shadow:0 5px 16px rgba(27,42,56,.07);
    }

    html,body{
        width:100% !important;
        max-width:100% !important;
        min-width:0 !important;
        overflow-x:hidden !important;
    }

    body:has(.cl-app) .layout-main-content,
    body:has(.cl-app) .layout-container-fluid{
        min-width:0 !important;
        max-width:100% !important;
    }

    .cl-app,
    .cl-app *{
        box-sizing:border-box;
        font-family:"Segoe UI",Arial,sans-serif;
    }

    .cl-app{
        width:100%;
        min-width:0;
        max-width:100%;
        padding:8px;
        color:var(--cl-text);
        background:var(--cl-bg);
    }

    /* ============================================================
       CABECERA
       ============================================================ */
    .cl-hero{
        display:grid;
        grid-template-columns:minmax(0,1fr) auto;
        gap:14px;
        align-items:center;
        padding:13px 16px;
        border:1px solid #58171e;
        border-radius:16px;
        color:#fff;
        background:linear-gradient(135deg,var(--cl-brand-dark),var(--cl-brand));
        box-shadow:0 8px 22px rgba(83,21,28,.16);
    }

    .cl-kicker{
        font-size:10px;
        font-weight:800;
        letter-spacing:.07em;
        text-transform:uppercase;
        opacity:.86;
    }

    .cl-hero h1{
        margin:3px 0 3px;
        font-size:clamp(25px,2.2vw,36px);
        line-height:1;
        font-weight:800;
    }

    .cl-hero p{
        margin:0;
        color:#f3dfe2;
        font-size:12px;
        line-height:1.35;
    }

    .cl-user-box{
        min-width:220px;
        padding:9px 12px;
        border:1px solid rgba(255,255,255,.18);
        border-radius:12px;
        background:rgba(255,255,255,.09);
    }

    .cl-user-box span{
        display:block;
        font-size:8px;
        font-weight:800;
        text-transform:uppercase;
        opacity:.78;
    }

    .cl-user-box strong{
        display:block;
        margin-top:3px;
        max-width:280px;
        overflow:hidden;
        text-overflow:ellipsis;
        white-space:nowrap;
        font-size:11px;
    }

    /* ============================================================
       ACCIONES + FILTROS
       ============================================================ */
    .cl-control-bar{
        margin-top:8px;
        padding:8px;
        display:grid;
        grid-template-columns:auto minmax(0,1fr);
        gap:8px;
        align-items:end;
        border:1px solid var(--cl-line);
        border-radius:14px;
        background:#fff;
        box-shadow:var(--cl-shadow);
    }

    .cl-shortcuts{
        display:flex;
        gap:6px;
        flex-wrap:wrap;
    }

    .cl-filter-grid{
        display:grid;
        grid-template-columns:
            minmax(135px,.65fr)
            minmax(165px,.85fr)
            minmax(125px,.6fr)
            minmax(125px,.6fr)
            minmax(135px,.65fr)
            auto;
        gap:7px;
        align-items:end;
    }

    .cl-field label{
        display:block;
        margin-bottom:3px;
        color:#596e7e;
        font-size:8px;
        font-weight:800;
        text-transform:uppercase;
        letter-spacing:.03em;
    }

    .cl-field input,
    .cl-field select,
    .cl-modal input,
    .cl-modal textarea,
    .cl-modal select{
        width:100%;
        min-height:34px;
        padding:5px 8px;
        border:1px solid var(--cl-line-strong);
        border-radius:9px;
        background:#fff;
        color:var(--cl-text);
        font-size:10px;
    }

    .cl-field input:focus,
    .cl-field select:focus,
    .cl-modal input:focus,
    .cl-modal textarea:focus,
    .cl-modal select:focus{
        outline:none;
        border-color:#9b7176;
        box-shadow:0 0 0 3px rgba(123,31,41,.08);
    }

    .cl-actions{
        display:flex;
        justify-content:flex-end;
        gap:6px;
    }

    .cl-btn{
        min-height:34px;
        padding:0 10px;
        display:inline-flex;
        align-items:center;
        justify-content:center;
        gap:5px;
        border:1px solid var(--cl-line-strong);
        border-radius:9px;
        background:#fff;
        color:var(--cl-text);
        font-size:9px;
        line-height:1;
        font-weight:800;
        white-space:nowrap;
        cursor:pointer;
        transition:transform .12s ease,box-shadow .12s ease;
    }

    .cl-btn:hover{
        transform:translateY(-1px);
        box-shadow:0 5px 12px rgba(26,42,55,.10);
    }

    .cl-btn-primary{
        border-color:var(--cl-brand-dark);
        background:var(--cl-brand);
        color:#fff;
    }

    .cl-btn-review{
        min-height:31px;
        border-color:#145aa5;
        background:var(--cl-blue);
        color:#fff;
    }

    .cl-btn-success{
        border-color:#176b40;
        background:var(--cl-green);
        color:#fff;
    }

    .cl-btn-warning{
        border-color:#d0aa56;
        background:#fff4d5;
        color:#735614;
    }

    .cl-btn-danger{
        border-color:#84272f;
        background:var(--cl-red);
        color:#fff;
    }

    .cl-btn-info{
        border-color:#4e6385;
        background:#61749a;
        color:#fff;
    }

    .cl-btn-auth{
        border-color:#bc8a26;
        background:#fff0c5;
        color:#76530b;
    }

    .cl-btn-compat{
        border-color:#5a4a92;
        background:#6a56a6;
        color:#fff;
    }

    /* ============================================================
       KPIs
       ============================================================ */
    .cl-kpis{
        margin-top:8px;
        display:grid;
        grid-template-columns:repeat(6,minmax(0,1fr));
        gap:6px;
    }

    .cl-kpi{
        min-width:0;
        padding:8px 10px;
        border:1px solid var(--cl-line);
        border-radius:12px;
        background:#fff;
        box-shadow:var(--cl-shadow);
        overflow:hidden;
    }

    .cl-kpi span{
        display:block;
        color:var(--cl-muted);
        font-size:7px;
        font-weight:800;
        text-transform:uppercase;
    }

    .cl-kpi strong{
        display:block;
        margin-top:2px;
        overflow:hidden;
        text-overflow:ellipsis;
        white-space:nowrap;
        color:var(--cl-text);
        font-size:clamp(15px,1.3vw,21px);
        line-height:1.1;
    }

    .cl-kpi.open{border-left:4px solid var(--cl-green)}
    .cl-kpi.closed{border-left:4px solid var(--cl-blue)}
    .cl-kpi.in{border-left:4px solid #6d7990}
    .cl-kpi.out{border-left:4px solid var(--cl-purple)}
    .cl-kpi.yield{border-left:4px solid var(--cl-amber)}

    /* ============================================================
       AYUDA + RESULTADOS
       ============================================================ */
    .cl-help{
        margin-top:8px;
        padding:7px 10px;
        display:flex;
        align-items:center;
        justify-content:space-between;
        gap:10px;
        border:1px solid #e0c98e;
        border-radius:11px;
        background:#fff8df;
        color:#654f17;
        font-size:9px;
        line-height:1.3;
    }

    .cl-help strong{color:#5c4510}

    .cl-results{
        margin-top:8px;
        min-height:0;
        display:grid;
        grid-template-rows:auto minmax(0,1fr);
        border:1px solid var(--cl-line);
        border-radius:14px;
        background:#fff;
        box-shadow:var(--cl-shadow);
        overflow:hidden;
    }

    .cl-results-head{
        min-height:40px;
        padding:7px 10px;
        display:flex;
        justify-content:space-between;
        align-items:center;
        gap:8px;
        border-bottom:1px solid var(--cl-line);
        background:linear-gradient(180deg,#fff,#f4f7f9);
    }

    .cl-results-head h2{
        margin:0;
        font-size:14px;
        font-weight:800;
    }

    .cl-results-head p{
        margin:1px 0 0;
        color:var(--cl-muted);
        font-size:8px;
    }

    #clResultCount{
        padding:4px 8px;
        border:1px solid #dec7cb;
        border-radius:999px;
        background:var(--cl-brand-soft);
        color:var(--cl-brand);
        font-size:8px;
        font-weight:800;
        white-space:nowrap;
    }

    .cl-table-wrap{
        width:100%;
        min-width:0;
        min-height:0;
        overflow:auto;
        background:#fff;
    }

    .cl-table{
        width:100%;
        min-width:1080px;
        border-collapse:separate;
        border-spacing:0;
        background:#fff;
        font-size:9px;
    }

    .cl-table th{
        position:sticky;
        top:0;
        z-index:2;
        height:32px;
        padding:4px 6px;
        border-right:1px solid #c4d0d6;
        border-bottom:1px solid #b5c4cc;
        background:#dce5e9;
        color:#3b4a54;
        white-space:nowrap;
        font-size:8px;
        font-weight:800;
        text-transform:uppercase;
    }

    .cl-table td{
        height:34px;
        padding:4px 6px;
        border-right:1px solid #d9e1e5;
        border-bottom:1px solid #d9e1e5;
        background:#fff;
        color:var(--cl-text);
        white-space:nowrap;
        vertical-align:middle;
    }

    .cl-table tbody tr:nth-child(even) td{
        background:#f8fafb;
    }

    .cl-table tbody tr:hover td{
        background:#f8ecee;
    }

    .cl-table tbody tr.is-closed td{
        color:#657785;
    }

    .cl-lote-name{
        font-weight:700;
    }

    .cl-mobile-label{
        display:none;
    }

    .cl-action-cell{
        text-align:center;
    }

    .cl-empty-row td{
        height:110px !important;
        text-align:center !important;
        color:var(--cl-muted) !important;
        font-size:11px !important;
    }

    /* ============================================================
       BADGES + STATUS
       ============================================================ */
    .cl-badge{
        display:inline-flex;
        align-items:center;
        justify-content:center;
        min-height:20px;
        padding:2px 6px;
        border:1px solid;
        border-radius:999px;
        font-size:7px;
        font-weight:800;
    }

    .b-ok{background:#e8f5ed;color:#236540;border-color:#9dcaae}
    .b-warn{background:#fff4d9;color:#745813;border-color:#e2c578}
    .b-bad{background:#f7e5e7;color:#7c2730;border-color:#d4a0a5}
    .b-info{background:#e8f0f7;color:#355f84;border-color:#9db7cb}

    .cl-status{
        min-height:28px;
        padding:5px 8px;
        border-top:1px solid var(--cl-line);
        background:#edf2f5;
        color:#627481;
        font-size:8px;
    }

    /* ============================================================
       MODALES
       ============================================================ */
    .cl-modal .modal-dialog{
        margin:18px auto;
    }

    .cl-modal .modal-content{
        overflow:hidden;
        border:1px solid var(--cl-line-strong);
        border-radius:14px;
        background:#fff;
        box-shadow:0 18px 42px rgba(0,0,0,.20);
    }

    .cl-modal .modal-header{
        min-height:45px;
        padding:8px 11px;
        border:0;
        border-bottom:1px solid #431118;
        background:linear-gradient(135deg,var(--cl-brand-dark),var(--cl-brand));
        color:#fff;
    }

    .cl-modal .modal-title{
        color:#fff;
        font-size:13px;
        font-weight:800;
    }

    .cl-modal .modal-body{
        padding:10px;
        background:#f5f8fa;
        color:var(--cl-text);
        font-size:9px;
    }

    .cl-modal .modal-footer{
        min-height:46px;
        padding:7px 10px;
        border-top:1px solid var(--cl-line);
        background:#edf2f5;
    }

    .cl-note{
        margin:7px 0;
        padding:8px 10px;
        border:1px solid #dfc98f;
        border-left:4px solid var(--cl-amber);
        border-radius:10px;
        background:#fff8e3;
        color:#644d13;
        font-size:8.5px;
        line-height:1.35;
    }

    .cl-summary{
        display:grid;
        grid-template-columns:repeat(4,minmax(0,1fr));
        gap:6px;
        margin-bottom:8px;
    }

    .cl-card{
        min-width:0;
        padding:8px;
        border:1px solid var(--cl-line);
        border-radius:10px;
        background:#fff;
    }

    .cl-card b{
        display:block;
        color:var(--cl-muted);
        font-size:7px;
        text-transform:uppercase;
    }

    .cl-card span{
        display:block;
        margin-top:3px;
        overflow:hidden;
        text-overflow:ellipsis;
        white-space:nowrap;
        color:var(--cl-text);
        font-size:12px;
        font-weight:800;
    }

    .cl-anom{
        margin-bottom:5px;
        padding:7px 8px;
        border:1px solid var(--cl-line);
        border-radius:9px;
        background:#fff;
        font-size:8.5px;
    }

    .cl-anom.bloqueo{border-left:4px solid var(--cl-red)}
    .cl-anom.autorizacion{border-left:4px solid var(--cl-amber)}
    .cl-anom.advertencia{border-left:4px solid #5b8ba2}

    .cl-modal table.table{
        background:#fff;
        color:var(--cl-text);
        font-size:8.5px;
    }

    .cl-modal table.table thead th{
        background:#dde6ea;
        color:#42515b;
        border-color:#bac7ce;
        font-size:8px;
        font-weight:800;
        white-space:nowrap;
    }

    .cl-modal table.table tbody td{
        border-color:#d3dde2;
        font-size:8.5px;
    }

    /* ============================================================
       LAPTOP / DESKTOP: TODO EL MÓDULO USA LA PANTALLA
       ============================================================ */
    @@media (min-width:901px){
        body:has(.cl-app){
            overflow-y:hidden !important;
        }

        .cl-app{
            height:calc(100dvh - 82px);
            max-height:calc(100dvh - 82px);
            display:grid;
            grid-template-rows:auto auto auto auto minmax(0,1fr) auto;
            gap:0;
            overflow:hidden;
        }

        .cl-results{
            min-height:0;
        }

        .cl-table-wrap{
            height:100%;
            max-height:none;
        }
    }

    /* ============================================================
       TABLET HORIZONTAL / LAPTOP ANGOSTA
       ============================================================ */
    @@media (max-width:1180px){
        .cl-control-bar{
            grid-template-columns:1fr;
        }

        .cl-filter-grid{
            grid-template-columns:repeat(5,minmax(0,1fr));
        }

        .cl-actions{
            grid-column:1/-1;
        }

        .cl-shortcuts{
            order:2;
        }

        .cl-kpis{
            grid-template-columns:repeat(3,minmax(0,1fr));
        }
    }

    /* ============================================================
       TABLET: LA TABLA SE VUELVE TARJETAS
       ============================================================ */
    @@media (max-width:900px){
        body:has(.cl-app){
            overflow-y:auto !important;
        }

        .cl-app{
            padding:6px;
        }

        .cl-hero{
            grid-template-columns:1fr;
        }

        .cl-user-box{
            min-width:0;
        }

        .cl-control-bar{
            grid-template-columns:1fr;
        }

        .cl-filter-grid{
            grid-template-columns:repeat(2,minmax(0,1fr));
        }

        .cl-actions{
            grid-column:1/-1;
        }

        .cl-actions .cl-btn{
            width:100%;
        }

        .cl-kpis{
            grid-template-columns:repeat(3,minmax(0,1fr));
        }

        .cl-help{
            align-items:flex-start;
            flex-direction:column;
        }

        .cl-results{
            overflow:visible;
        }

        .cl-table-wrap{
            overflow:visible;
        }

        .cl-table{
            min-width:0;
            display:block;
        }

        .cl-table thead{
            display:none;
        }

        .cl-table tbody{
            display:grid;
            grid-template-columns:repeat(2,minmax(0,1fr));
            gap:8px;
            padding:8px;
        }

        .cl-table tbody tr{
            min-width:0;
            display:grid;
            grid-template-columns:1fr 1fr;
            gap:0;
            padding:7px;
            border:1px solid var(--cl-line);
            border-radius:12px;
            background:#fff;
            box-shadow:0 4px 12px rgba(25,40,53,.06);
            overflow:hidden;
        }

        .cl-table tbody tr:nth-child(even) td,
        .cl-table tbody tr:hover td{
            background:transparent;
        }

        .cl-table td{
            min-width:0;
            height:auto;
            padding:5px 6px;
            display:grid;
            grid-template-columns:76px minmax(0,1fr);
            gap:5px;
            border:0;
            border-bottom:1px solid #eef2f4;
            background:transparent !important;
            white-space:normal;
            font-size:9px;
        }

        .cl-table td::before{
            content:attr(data-label);
            color:#718491;
            font-size:7px;
            font-weight:800;
            text-transform:uppercase;
        }

        .cl-table .cl-lote-name{
            grid-column:1/-1;
            min-height:34px;
            display:block;
            padding:7px;
            border-radius:8px;
            background:#f4f7f9 !important;
            color:#263a49;
            font-size:11px;
        }

        .cl-table .cl-lote-name::before{
            display:block;
            margin-bottom:2px;
        }

        .cl-table .cl-action-cell{
            grid-column:1/-1;
            display:block;
            padding-top:8px;
            border-bottom:0;
        }

        .cl-table .cl-action-cell::before{
            display:none;
        }

        .cl-table .cl-action-cell .cl-btn{
            width:100%;
            min-height:38px;
            font-size:9px;
        }

        .cl-empty-row{
            display:block !important;
            grid-column:1/-1 !important;
        }

        .cl-empty-row td{
            display:block !important;
            width:100% !important;
        }

        .cl-empty-row td::before{
            display:none !important;
        }

        .cl-status{
            margin-top:6px;
            border:1px solid var(--cl-line);
            border-radius:9px;
        }

        .cl-summary{
            grid-template-columns:repeat(2,minmax(0,1fr));
        }
    }

    @@media (max-width:620px){
        .cl-app{
            padding:4px;
        }

        .cl-hero{
            border-radius:12px;
            padding:11px 12px;
        }

        .cl-hero h1{
            font-size:25px;
        }

        .cl-filter-grid,
        .cl-kpis,
        .cl-summary{
            grid-template-columns:1fr 1fr;
        }

        .cl-shortcuts{
            display:grid;
            grid-template-columns:1fr;
        }

        .cl-shortcuts .cl-btn{
            width:100%;
        }

        .cl-table tbody{
            grid-template-columns:1fr;
        }
    }

    @@media (max-width:430px){
        .cl-filter-grid,
        .cl-kpis,
        .cl-summary{
            grid-template-columns:1fr;
        }
    }

    /* ============================================================
       GRID DE LOTES - LETRA MÁS GRANDE / MEJOR LEGIBILIDAD
       Sólo afecta la tabla principal de lotes.
       ============================================================ */

    .cl-table{
        min-width:1180px;
        font-size:11px;
    }

    .cl-table th{
        height:38px;
        padding:6px 8px;
        font-size:10px;
        line-height:1.2;
    }

    .cl-table td{
        height:40px;
        padding:6px 8px;
        font-size:11px;
        line-height:1.25;
    }

    .cl-table .cl-lote-name{
        font-size:11.5px;
        font-weight:800;
    }

    .cl-table .cl-badge{
        min-height:24px;
        padding:3px 8px;
        font-size:9px;
    }

    .cl-table .cl-btn-review{
        min-height:34px;
        padding:0 12px;
        font-size:10px;
    }

    /* Números y pesos un poco más marcados para facilitar lectura */
    .cl-table td.text-end{
        font-weight:700;
    }

    @@media (max-width:900px){
        .cl-table{
            min-width:0;
            font-size:10.5px;
        }

        .cl-table td{
            padding:7px 8px;
            grid-template-columns:88px minmax(0,1fr);
            gap:7px;
            font-size:10.5px;
            line-height:1.3;
        }

        .cl-table td::before{
            font-size:8.5px;
        }

        .cl-table .cl-lote-name{
            min-height:38px;
            padding:8px;
            font-size:12.5px;
        }

        .cl-table .cl-badge{
            font-size:9px;
        }

        .cl-table .cl-action-cell .cl-btn{
            min-height:42px;
            font-size:10.5px;
        }
    }

    @@media (max-width:430px){
        .cl-table td{
            grid-template-columns:82px minmax(0,1fr);
            font-size:10.5px;
        }

        .cl-table td::before{
            font-size:8px;
        }
    }



    /* ============================================================
       SEMÁFORO DE CUMPLIMIENTO DEL GRID
       Usa Cumplimiento calculado por el servidor con los límites
       reales de meat_CierreLoteTipoConfig.
       ============================================================ */

    .cl-table tbody tr.cl-health-green td{
        background:#edf8f1 !important;
        border-top-color:#b7d9c3 !important;
        border-bottom-color:#b7d9c3 !important;
    }

