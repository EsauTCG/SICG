<script>
let diagActual = null;
let authActual = null;
let permisos = { puedeLeer:false, puedeEscribir:false, puedeAutorizar:false };
const modalDiag = () => bootstrap.Modal.getOrCreateInstance(document.getElementById('modalDiagnostico'));
const modalPend = () => bootstrap.Modal.getOrCreateInstance(document.getElementById('modalPendientes'));
const modalCmp = () => bootstrap.Modal.getOrCreateInstance(document.getElementById('modalCompatibilidad'));

function safe(v){return String(v ?? '').replaceAll('&','&amp;').replaceAll('<','&lt;').replaceAll('>','&gt;').replaceAll('"','&quot;').replaceAll("'",'&#39;')}
function n(v,d=3){return Number(v||0).toLocaleString('es-MX',{minimumFractionDigits:d,maximumFractionDigits:d})}
function fecha(v){if(!v)return '-'; const x=new Date(v); return Number.isNaN(x.getTime())?safe(v):x.toLocaleDateString('es-MX')}

function claseCumplimiento(v){
 const c=String(v||'').trim().toUpperCase();
 if(c==='ROJO') return 'cl-health-red';
 if(c==='AMARILLO') return 'cl-health-yellow';
 return 'cl-health-green';
}

function clasePillCumplimiento(v){
 const c=String(v||'').trim().toUpperCase();
 if(c==='ROJO') return 'cl-diff-red';
 if(c==='AMARILLO') return 'cl-diff-yellow';
 return 'cl-diff-green';
}
function setStatus(m,t='info'){document.getElementById('clStatus').innerHTML=`<span class="cl-badge ${t==='ok'?'b-ok':t==='bad'?'b-bad':t==='warn'?'b-warn':'b-info'}">${safe(m)}</span>`}
function normalizarJsonServidor(v){ return v; }
async function api(url,opt){
 const r=await fetch(url,{credentials:'same-origin',...(opt||{})});
 let d={};
 try{d=await r.json()}catch{}
 if(!r.ok||d?.ok===false) throw new Error(d?.msg||`HTTP ${r.status}`);
 return normalizarJsonServidor(d);
}

async function cargarPermisos(){try{const d=await api('@Url.Action("CierreLotePermisos","ProcesosCG")'); permisos=d;}catch(e){setStatus(e.message,'bad')}}


function actualizarResumenCierre(rows){
    rows = Array.isArray(rows) ? rows : [];

    const total = rows.length;
    const abiertos = rows.filter(x => Number(x.estatusId) !== 3).length;
    const cerrados = rows.filter(x => Number(x.estatusId) === 3).length;
    const kgEntrada = rows.reduce((a,x) => a + Number(x.kgEntrada || 0), 0);
    const kgSalida = rows.reduce((a,x) => a + Number(x.kgSalida || 0), 0);

    const rendimientos = rows
        .map(x => Number(x.rendimientoPct))
        .filter(x => Number.isFinite(x));

    const rendimientoProm = rendimientos.length
        ? rendimientos.reduce((a,b)=>a+b,0) / rendimientos.length
        : 0;

    const set = (id, value) => {
        const el = document.getElementById(id);
        if(el) el.textContent = value;
    };

    set('clKpiTotal', total.toLocaleString('es-MX'));
    set('clKpiAbiertos', abiertos.toLocaleString('es-MX'));
    set('clKpiCerrados', cerrados.toLocaleString('es-MX'));
    set('clKpiEntrada', `${n(kgEntrada)} kg`);
    set('clKpiSalida', `${n(kgSalida)} kg`);
    set('clKpiRendimiento', `${n(rendimientoProm,2)}%`);

    const resultado = document.getElementById('clResultCount');
    if(resultado){
        resultado.textContent = total === 1 ? '1 lote encontrado' : `${total} lotes encontrados`;
    }
}

async function buscarLotes(){
 try{
   setStatus('Consultando...');
   const q=new URLSearchParams({
       source:document.getElementById('clSource').value,
       desde:document.getElementById('clDesde').value,
       hasta:document.getElementById('clHasta').value,
       estado:document.getElementById('clEstado').value
   });

   const d=await api('@Url.Action("CierreLotesBuscar","ProcesosCG")?'+q);
   const tb=document.getElementById('clRows');

   const sourceActual =
       (document.getElementById('clSource').value || '')
           .trim()
           .toUpperCase();

   const rowsOriginales =
       Array.isArray(d.rows)
           ? d.rows
           : [];

   // Protección adicional de interfaz:
   // en P1 nunca mostrar ni contabilizar TipoLoteId 11.
   // En TIF no se modifica el resultado.
   const rowsPlanta =
       sourceActual === 'P1'
           ? rowsOriginales.filter(x =>
               Number(x.tipoLoteId) !== 11
             )
           : rowsOriginales;

   // ============================================================
   // FILTRO POR LOTE
   // Busca por LoteId exacto/parcial o por nombre del lote.
   // Se combina con Planta + Desde + Hasta + Estado.
   // ============================================================
   const filtroLote =
       (document.getElementById('clLote')?.value || '')
           .trim()
           .toLowerCase();

   const rows =
       !filtroLote
           ? rowsPlanta
           : rowsPlanta.filter(x =>
               String(x.loteId ?? '')
                   .toLowerCase()
                   .includes(filtroLote)
               ||
               String(x.nombre ?? '')
                   .toLowerCase()
                   .includes(filtroLote)
             );

   actualizarResumenCierre(rows);

   if(!rows.length){
       tb.innerHTML='<tr class="cl-empty-row"><td colspan="12">No hay lotes para los filtros seleccionados.</td></tr>';
       setStatus(
           filtroLote
               ? `No se encontró el lote "${filtroLote}" dentro de los filtros de fecha/estado seleccionados.`
               : 'Sin resultados.',
           'warn'
       );
       return;
   }

   console.log('CierreLotesBuscar primer registro:', rows[0]);

   tb.innerHTML=rows.map(x=>`<tr class="${x.estatusId===3?'is-closed':'is-open'} ${claseCumplimiento(x.cumplimiento)}" title="${safe(x.cumplimientoTexto||'')}">
    <td data-label="Lote ID"><span class="cl-mobile-label">ID</span>${x.loteId}</td>
    <td data-label="Lote" class="cl-lote-name">${safe(x.nombre)}</td>
    <td data-label="Proceso"><span class="cl-process-name">${safe(x.tipoProceso || 'SIN CONFIG')}</span></td>
    <td data-label="Fecha">${fecha(x.fechaProduccion)}</td>
    <td data-label="Estado"><span class="cl-badge ${x.estatusId===3?'b-info':'b-ok'}">${x.estatusId===3?'CERRADO':'ABIERTO'}</span></td>
    <td data-label="Entradas">${x.entradas}</td>
    <td data-label="Kg entrada" class="text-end">${n(x.kgEntrada)}</td>
    <td data-label="Salidas">${x.salidas}</td>
    <td data-label="Kg salida" class="text-end">${n(x.kgSalida)}</td>
    <td data-label="Diferencia kg" class="text-end"><span class="cl-diff-pill ${clasePillCumplimiento(x.cumplimiento)}" title="${safe(x.cumplimientoTexto||'')}">${n(x.diferenciaKg)} kg</span></td>
    <td data-label="Rendimiento" class="text-end">${n(x.rendimientoPct,2)}%</td>
    <td data-label="Acción" class="cl-action-cell">
        <button class="cl-btn cl-btn-review" type="button" onclick="diagnosticar(${x.loteId})">
            Revisar cierre →
        </button>
    </td>
   </tr>`).join('');

   setStatus(`${rows.length} lote(s) cargado(s).`,'ok');
 }catch(e){
   actualizarResumenCierre([]);
   setStatus(e.message,'bad');
 }
}

async function diagnosticar(loteId){
 loteId = Number(loteId || 0);
 if(!Number.isInteger(loteId) || loteId <= 0){
  setStatus(`LoteId inválido o no recibido. Valor recibido: ${loteId || 'NULL'}`,'bad');
  return;
 }
 try{
  setStatus(`Diagnosticando lote ${loteId}...`);
  const source=document.getElementById('clSource').value;
  const d=await api('@Url.Action("CierreLoteDiagnostico","ProcesosCG")?'+new URLSearchParams({source,loteId}));
  diagActual=d.diagnostico; authActual=d.autorizacion;
  renderDiag(); modalDiag().show(); setStatus('Diagnóstico terminado.','ok');
 }catch(e){setStatus(e.message,'bad')}
}

function renderDiag(){
 const d=diagActual;if(!d)return;

 const proceso=String(d.tipoProceso||'').trim().toUpperCase();
 const sourceDiag=String(d.source||document.getElementById('clSource')?.value||'').trim().toUpperCase();
 const esDeshuese=sourceDiag==='TIF' && (proceso==='CAJAS' || proceso==='DESHUESE');

 document.getElementById('diagResumen').innerHTML=[
  ['Lote',`${safe(d.loteNombre)} (${d.loteId})`],['Proceso',`${safe(d.tipoProceso||'SIN CONFIG')}`],
  ['Tipo peso canal',d.tipoProceso==='CANALES' ? `${d.tipoPesoIdCanal ?? '-'} · ${safe(d.tipoPesoCanal||'')}` : '-'],
  ['Entradas',`${d.entradas} · ${n(d.kgEntrada)} kg`],['Salidas / canales',`${d.salidas} · ${n(d.kgSalida)} kg`],
  ['Variación',d.tipoProceso==='CANALES' ? 'N/A' : `${n(d.variacionPct,2)}%`],['Rendimiento',d.tipoProceso==='CANALES' ? 'N/A' : `${n(d.rendimientoPct,2)}%`]
 ].map(x=>`<div class="cl-card"><b>${x[0]}</b><span>${x[1]}</span></div>`).join('');

 let est='';
 if(d.tieneBloqueos) est='<span class="cl-badge b-bad">BLOQUEADO</span> Hay anomalías técnicas no autorizables.';
 else if(d.requiereAutorizacion){const a=authActual||{}; est=`<span class="cl-badge ${a.aprobada?'b-ok':'b-warn'}">${a.aprobada?'AUTORIZADO':'REQUIERE AUTORIZACIÓN'}</span> Aprobaciones ${a.aprobacionesActuales||0}/${a.aprobacionesRequeridas||d.aprobacionesRequeridas}. ${safe(a.autorizadores||'')}`}
 else est='<span class="cl-badge b-ok">LISTO</span> Puede costearse y cerrarse.';
 document.getElementById('diagEstado').innerHTML=`<div class="cl-note">${est}</div>`;

 const todasAnomalias=Array.isArray(d.anomalias)?d.anomalias:[];

 // Los INFO de reclasificación alimentan la tabla de entradas,
 // pero NO se muestran como "Anomalías".
 const anomaliasVisibles=todasAnomalias.filter(x =>
     String(x?.nivel||'').trim().toUpperCase()!=='INFO'
 );

 const an=document.getElementById('diagAnomalias');
 an.innerHTML=anomaliasVisibles.length
     ? anomaliasVisibles.map(x=>`<div class="cl-anom ${(x.nivel||'').toLowerCase()}"><b>${safe(x.nivel)} · ${safe(x.codigo)} · ${safe(x.titulo)}</b><div>${safe(x.detalle)}</div></div>`).join('')
     : '<div class="cl-anom"><b>Sin anomalías operativas.</b></div>';

 // ============================================================
 // RECLASIFICACIONES DE DESHUESE POR ProduccionId
 // ============================================================
 const reclasMap=new Map();

 if(esDeshuese){
     todasAnomalias
       .filter(x =>
          String(x?.codigo||'').trim().toUpperCase()==='DESHUESE_RECLASIFICACION_INFO'
       )
       .forEach(x=>{
          const m=String(x?.detalle||'').match(/ProduccionId\s*=\s*(\d+)/i);
          if(!m)return;

          // En los INFO del service:
          // articuloEntrada = NombreAntes
          // articuloSalida  = NombreDespues
          // valor = 1 únicamente cuando la clasificación BAJÓ.
          const indicadorBaja=Number(x?.valor);

          reclasMap.set(Number(m[1]),{
             nombreAntes:String(x?.articuloEntrada||'').trim(),
             nombreDespues:String(x?.articuloSalida||'').trim(),
             bajo:indicadorBaja===1
          });
       });
 }

 const head=document.getElementById('diagEntradasHead');

 if(esDeshuese){
     head.innerHTML=`
       <tr>
         <th>ID</th>
         <th>Etiqueta</th>
         <th>SKU</th>
         <th>Producto</th>
         <th>Kg</th>
         <th>Antes (caliente)</th>
         <th>Después (deshuese)</th>
       </tr>`;

     const rowEntrada=x=>{
        const r=reclasMap.get(Number(x.produccionId));

        if(!r){
            return `<tr>
              <td>${x.produccionId}</td>
              <td>${safe(x.codigoEtiqueta)}</td>
              <td>${safe(x.articulo)}</td>
              <td>${safe(x.producto)}</td>
              <td class="text-end">${n(x.pesoNeto)}</td>
              <td><span class="cl-reclas-antes">${safe(x.producto||'—')}</span></td>
              <td><span class="cl-reclas-despues">${safe(x.producto||'—')}</span></td>
            </tr>`;
        }

        const claseFila=r.bajo?'cl-reclas-baja':'';
        const despuesClase=r.bajo?'cl-reclas-despues bajo':'cl-reclas-despues';
        const bajaBadge=r.bajo
            ? '<span class="cl-reclas-baja-badge">↓ BAJÓ</span>'
            : '';

        return `<tr class="${claseFila}">
          <td>${x.produccionId}</td>
          <td>${safe(x.codigoEtiqueta)}</td>
          <td>${safe(x.articulo)}</td>
          <td>${safe(x.producto)}</td>
          <td class="text-end">${n(x.pesoNeto)}</td>
          <td><span class="cl-reclas-antes">${safe(r.nombreAntes||'—')}</span></td>
          <td>
             <span class="${despuesClase}">${safe(r.nombreDespues||'—')}</span>
             ${bajaBadge}
          </td>
        </tr>`;
     };

     document.getElementById('diagEntradas').innerHTML=
        d.movimientosEntrada?.map(rowEntrada).join('')
        ||'<tr><td colspan="7">Sin entradas.</td></tr>';
 }else{
     head.innerHTML='<tr><th>ID</th><th>Etiqueta</th><th>SKU</th><th>Producto</th><th>Kg</th></tr>';

     const rowEntrada=x=>`<tr><td>${x.produccionId}</td><td>${safe(x.codigoEtiqueta)}</td><td>${safe(x.articulo)}</td><td>${safe(x.producto)}</td><td class="text-end">${n(x.pesoNeto)}</td></tr>`;

     document.getElementById('diagEntradas').innerHTML=
        d.movimientosEntrada?.map(rowEntrada).join('')
        ||'<tr><td colspan="5">Sin entradas.</td></tr>';
 }

 const rowSalida=x=>`<tr><td>${x.produccionId}</td><td>${safe(x.codigoEtiqueta)}</td><td>${safe(x.articulo)}</td><td>${safe(x.producto)}</td><td class="text-end">${n(x.pesoNeto)}</td></tr>`;
 document.getElementById('diagSalidas').innerHTML=d.movimientosSalida?.map(rowSalida).join('')||'<tr><td colspan="5">Sin salidas.</td></tr>';

 document.getElementById('solicitudBox').style.display=(!d.tieneBloqueos&&d.requiereAutorizacion&&!authActual?.aprobada&&permisos.puedeEscribir)?'block':'none';
 const btn=document.getElementById('btnCostearCerrar');
 btn.style.display=permisos.puedeEscribir?'inline-block':'none';
 btn.disabled=d.tieneBloqueos || (d.requiereAutorizacion&&!authActual?.aprobada);
}

async function solicitarAutorizacion(){
 if(!diagActual)return;
 const motivo=document.getElementById('solMotivo').value.trim();
 try{
  const d=await api('@Url.Action("CierreLoteSolicitarAutorizacion","ProcesosCG")',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({source:diagActual.source,loteId:diagActual.loteId,motivo})});
  alert(d.msg); await diagnosticar(diagActual.loteId);
 }catch(e){alert(e.message)}
}

async function costearYCerrar(){
 if(!diagActual)return;
 if(!confirm(`Se ejecutará el costeo del lote ${diagActual.loteNombre} y solo si termina correcto se cambiará EstatusId=3. ¿Continuar?`))return;
 try{
  const btn=document.getElementById('btnCostearCerrar');btn.disabled=true;btn.textContent='Costeando y validando...';
  const d=await api('@Url.Action("CierreLoteCerrar","ProcesosCG")',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({source:diagActual.source,loteId:diagActual.loteId})});
  alert(d.msg);modalDiag().hide();await buscarLotes();
 }catch(e){alert(e.message); if(diagActual) await diagnosticar(diagActual.loteId)}finally{const btn=document.getElementById('btnCostearCerrar');btn.disabled=false;btn.textContent='Costear y cerrar lote'}
}

async function cargarPendientes(){
 if(!permisos.puedeAutorizar){alert('Tu perfil no tiene permiso ELIMINAR en CIERRE_LOTES para autorizar excepciones.');return}
 try{
  const source=document.getElementById('clSource').value;
  const d=await api('@Url.Action("CierreLotePendientesAutorizacion","ProcesosCG")?'+new URLSearchParams({source}));
  document.getElementById('pendRows').innerHTML=d.rows?.length?d.rows.map(x=>`<tr>
   <td>#${x.solicitudId}<br><span class="cl-badge ${x.estado==='APROBADA'?'b-ok':'b-warn'}">${safe(x.estado)}</span></td>
   <td>${safe(x.loteNombre)}<br>ID ${x.loteId}</td><td>${safe(x.usuarioSolicita)}<br>${fecha(x.fechaSolicitud)}</td>
   <td style="white-space:normal;min-width:220px">${safe(x.motivoSolicitud)}</td><td style="white-space:normal;min-width:280px">${safe(x.resumenAnomalias)}</td>
   <td>${x.aprobacionesActuales}/${x.aprobacionesRequeridas}</td><td style="white-space:normal;min-width:220px">${safe(x.autorizadores)}</td>
   <td style="min-width:260px"><textarea id="mot_${x.solicitudId}" rows="2" placeholder="Justificación obligatoria"></textarea><div class="mt-1"><button class="cl-btn cl-btn-success" onclick="decidir(${x.solicitudId},'APROBAR')">Autorizar</button> <button class="cl-btn cl-btn-danger" onclick="decidir(${x.solicitudId},'RECHAZAR')">Rechazar</button></div></td></tr>`).join(''):'<tr><td colspan="8">Sin solicitudes pendientes.</td></tr>';
  modalPend().show();
 }catch(e){alert(e.message)}
}
async function decidir(id,decision){
 const motivo=document.getElementById(`mot_${id}`).value.trim();
 const url=decision==='APROBAR'?'@Url.Action("CierreLoteAutorizar","ProcesosCG")':'@Url.Action("CierreLoteRechazar","ProcesosCG")';
 try{const d=await api(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({source:document.getElementById('clSource').value,solicitudId:id,motivo})});alert(d.msg);await cargarPendientes()}catch(e){alert(e.message)}
}

async function abrirCompatibilidad(){
 modalCmp().show(); await cargarCompatibilidad();
}
async function cargarCompatibilidad(){
 try{
  const source=document.getElementById('clSource').value;const texto=document.getElementById('cmpBuscar').value;
  const d=await api('@Url.Action("CierreLoteCompatibilidad","ProcesosCG")?'+new URLSearchParams({source,texto}));
  document.getElementById('cmpRows').innerHTML=d.rows?.length?d.rows.map(x=>`<tr><td>${x.compatibilidadId}</td><td>${safe(x.articuloEntrada)}</td><td>${safe(x.articuloSalida)}</td><td><span class="cl-badge ${x.permitido?'b-ok':'b-bad'}">${x.permitido?'PERMITIDO':'PROHIBIDO'}</span></td><td>${safe(x.motivo)}</td><td>${safe(x.usuario)}</td><td>${fecha(x.fechaHora)}</td><td>${permisos.puedeAutorizar?`<button class="cl-btn cl-btn-danger" onclick="eliminarCompatibilidad(${x.compatibilidadId})">Quitar</button>`:''}</td></tr>`).join(''):'<tr><td colspan="8">Sin reglas configuradas.</td></tr>';
 }catch(e){alert(e.message)}
}
async function guardarCompatibilidad(){
 if(!permisos.puedeAutorizar){alert('Requiere permiso de autorización para modificar el catálogo.');return}
 try{
  const req={source:document.getElementById('clSource').value,articuloEntrada:document.getElementById('cmpEntrada').value,articuloSalida:document.getElementById('cmpSalida').value,permitido:document.getElementById('cmpPermitido').value==='true',motivo:document.getElementById('cmpMotivo').value};
  const d=await api('@Url.Action("CierreLoteCompatibilidadGuardar","ProcesosCG")',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(req)});alert(d.msg);await cargarCompatibilidad();
 }catch(e){alert(e.message)}
}
async function eliminarCompatibilidad(id){
 if(!confirm('¿Desactivar esta regla?'))return;
 try{const d=await api('@Url.Action("CierreLoteCompatibilidadEliminar","ProcesosCG")?'+new URLSearchParams({source:document.getElementById('clSource').value,id}),{method:'POST'});alert(d.msg);await cargarCompatibilidad()}catch(e){alert(e.message)}
}

function actualizarReglaTipoLote(){
 const el=document.getElementById('clReglaTipoLote');
 if(!el)return;

 const source=(document.getElementById('clSource').value||'').trim().toUpperCase();

 el.textContent =
   source==='P1'
     ? '· P1 excluye TipoLote 11.'
     : '';
}

document.getElementById('clSource')?.addEventListener('change',actualizarReglaTipoLote);

document.addEventListener('DOMContentLoaded',async()=>{
 actualizarReglaTipoLote();
 await cargarPermisos();
 await buscarLotes();
});
</script>
