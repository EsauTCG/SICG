@model Plataforma_CG.Models.ViewModels.KpisPermisosViewModel
@using System.Linq

@{
    ViewBag.Title = "KPIs por Perfil";
    Layout = "~/Views/Shared/_Layout2.cshtml";

    var totalPerfiles = Model.Perfiles.Count;
    var totalKpis = Model.Kpis.Count;
    var totalAsignaciones = Model.PermisosKpi.Count;
}

@await Html.PartialAsync("_KpiAdminTheme")

<style>
    /* ============================================================
           KPIS POR PERFIL - Ajuste visual sobre _KpiAdminTheme
        ============================================================ */

    .kpi-permisos-page .dashboard-panel {
        overflow: visible;
    }

    .kpi-permisos-page .filters-area {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
    }

        .kpi-permisos-page .filters-area .input-group {
            min-width: 270px;
            max-width: 420px;
        }

    .perfil-item {
        border: 1px solid var(--kpi-border);
        border-radius: 12px;
        background: var(--kpi-card-bg);
        color: var(--kpi-text);
        margin-bottom: 0.85rem;
        box-shadow: var(--kpi-shadow);
        overflow: hidden;
        transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease;
    }

        .perfil-item:hover {
            border-color: var(--kpi-border-strong);
            box-shadow: var(--kpi-shadow-strong);
            transform: translateY(-1px);
        }

    .perfil-header {
        padding: 1rem 1.15rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        background: var(--kpi-card-bg);
    }

    .perfil-main {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        min-width: 0;
        flex: 1;
    }

    .perfil-icon {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: rgba(122, 11, 11, 0.10);
        color: var(--brand-main);
        border: 1px solid rgba(122, 11, 11, 0.18);
        flex-shrink: 0;
    }

    body[data-theme="dark"] .perfil-icon {
        background: rgba(248,113,113,0.12);
        color: #fca5a5;
        border-color: rgba(248,113,113,0.30);
    }

    .perfil-info {
        min-width: 0;
        flex: 1;
    }

    .perfil-nombre {
        display: block;
        font-weight: 900;
        color: var(--kpi-text-strong);
        font-size: 1rem;
        line-height: 1.15;
        word-break: break-word;
    }

    .perfil-meta {
        margin-top: 0.25rem;
        color: var(--kpi-text-muted);
        font-size: 0.78rem;
        font-weight: 700;
    }

    .perfil-progress {
        width: 100%;
        max-width: 280px;
        height: 7px;
        background: var(--kpi-panel-soft);
        border: 1px solid var(--kpi-border);
        border-radius: 999px;
        overflow: hidden;
        margin-top: 0.55rem;
    }

    .perfil-progress-bar {
        height: 100%;
        background: linear-gradient(90deg, var(--brand-main), #ef4444);
        border-radius: 999px;
        transition: width .25s ease;
    }

    .perfil-actions {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-shrink: 0;
    }

    .perfil-count {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        border-radius: 999px;
        padding: 0.35rem 0.7rem;
        font-size: 0.78rem;
        font-weight: 900;
        background: rgba(122,11,11,0.08);
        color: var(--brand-main);
        border: 1px solid rgba(122,11,11,0.20);
        white-space: nowrap;
    }

    body[data-theme="dark"] .perfil-count {
        background: rgba(248,113,113,0.12);
        color: #fecaca;
        border-color: rgba(248,113,113,0.32);
    }

    .perfil-chevron {
        color: var(--kpi-text-muted);
        transition: transform .2s ease, color .2s ease;
        font-weight: 900;
    }

    .perfil-item.active .perfil-chevron {
        transform: rotate(90deg);
        color: var(--brand-main);
    }

    body[data-theme="dark"] .perfil-item.active .perfil-chevron {
        color: #fca5a5;
    }

    .kpis-panel {
        background: var(--kpi-panel-soft);
        max-height: 0;
        overflow: hidden;
        transition: max-height .35s ease;
        border-top: 1px solid transparent;
    }

    .perfil-item.active .kpis-panel {
        max-height: 99999px;
        border-top-color: var(--kpi-border);
    }

    .kpis-panel-inner {
        padding: 1rem;
    }

    .kpi-row {
        background: var(--kpi-card-bg);
        border: 1px solid var(--kpi-border);
        border-radius: 12px;
        padding: 0.7rem 0.85rem;
        margin-bottom: 0.65rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.9rem;
        transition: border-color .2s ease, box-shadow .2s ease, background-color .2s ease, transform .2s ease;
    }

        .kpi-row:hover {
            border-color: var(--kpi-border-strong);
            box-shadow: var(--kpi-shadow);
            transform: translateY(-1px);
        }

        .kpi-row.active {
            border-color: var(--kpi-active-border);
            background: var(--kpi-active-bg);
        }

    .kpi-left {
        display: flex;
        align-items: center;
        gap: 0.8rem;
        min-width: 0;
        flex: 1;
    }

    .kpi-check {
        transform: scale(1.25);
        accent-color: var(--brand-main);
        flex-shrink: 0;
    }

    body[data-theme="dark"] .kpi-check {
        accent-color: #ef4444;
    }

    .kpi-row-thumb {
        width: 74px;
        height: 44px;
        object-fit: cover;
        border-radius: 9px;
        border: 1px solid var(--kpi-border);
        background: var(--kpi-panel-soft);
        flex-shrink: 0;
    }

    .kpi-label {
        cursor: pointer;
        min-width: 0;
        flex: 1;
    }

    .kpi-title {
        font-weight: 900;
        color: var(--kpi-text-strong);
        line-height: 1.15;
        margin: 0;
        word-break: break-word;
    }

    .kpi-sub {
        margin: 0.35rem 0 0;
        color: var(--kpi-text-muted);
        font-size: 0.78rem;
        display: flex;
        gap: 0.4rem;
        flex-wrap: wrap;
    }

    .chip {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        border: 1px solid rgba(122,11,11,0.22);
        background: rgba(122,11,11,0.06);
        color: var(--brand-main);
        border-radius: 999px;
        padding: 2px 10px;
        font-weight: 900;
        font-size: 0.72rem;
        white-space: nowrap;
    }

    body[data-theme="dark"] .chip {
        background: rgba(248,113,113,0.12);
        border-color: rgba(248,113,113,0.30);
        color: #fecaca;
    }

    .kpi-right {
        display: flex;
        align-items: center;
        gap: 0.55rem;
        flex-shrink: 0;
    }

    .kpi-id {
        color: var(--kpi-text-muted);
        font-size: 0.76rem;
        font-weight: 800;
        white-space: nowrap;
    }

    .assigned-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        border-radius: 999px;
        padding: 0.28rem 0.6rem;
        font-size: 0.72rem;
        font-weight: 900;
        border: 1px solid transparent;
        background: rgba(107,114,128,0.10);
        color: var(--kpi-text-muted);
        white-space: nowrap;
    }

    .kpi-row.active .assigned-pill {
        background: rgba(25,135,84,0.12);
        color: #198754;
        border-color: rgba(25,135,84,0.25);
    }

    body[data-theme="dark"] .kpi-row.active .assigned-pill {
        background: rgba(34,197,94,0.14);
        color: #bbf7d0;
        border-color: rgba(34,197,94,0.35);
    }

    .empty-filter-msg {
        display: none;
        text-align: center;
        color: var(--kpi-text-muted);
        padding: 1.5rem 1rem;
        border: 1px dashed var(--kpi-border);
        border-radius: 10px;
        background: var(--kpi-card-bg);
        font-weight: 700;
    }

    @@media (max-width: 768px) {
        .perfil-header {
            align-items: flex-start;
        }

        .perfil-actions {
            flex-direction: column;
            align-items: flex-end;
            gap: 0.5rem;
        }

        .kpi-row {
            align-items: flex-start;
            flex-direction: column;
        }

        .kpi-right {
            width: 100%;
            justify-content: space-between;
            padding-left: 2rem;
        }

        .kpi-row-thumb {
            width: 62px;
            height: 38px;
        }

        .kpi-permisos-page .filters-area .input-group {
            min-width: 100%;
            max-width: 100%;
        }
    }
</style>

<div class="container-fluid py-4 px-3 px-md-4 container-custom kpi-permisos-page">

    <div class="top-banner d-flex justify-content-between align-items-center flex-wrap gap-3 shadow-sm">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-shield-lock me-2"></i> KPIs por Perfil
            </h2>
            <p class="mb-0" style="font-size: 0.85rem; opacity: 0.85;">
                Asigna y revoca indicadores por perfil para controlar qué KPIs puede consultar cada grupo de usuarios.
            </p>
        </div>

        <div>
            <a class="btn btn-sm btn-outline-light fw-bold px-3 border-2" href="/KpisAdmin/InicioKpi">
                <i class="bi bi-arrow-left-circle me-1"></i> Regresar
            </a>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-3 mb-4">

        <div class="action-group shadow-sm">
            <div class="action-label">
                <i class="bi bi-sliders me-1"></i> Acciones
            </div>

            <div class="d-flex gap-2">
                <button type="button" class="btn-rojo" onclick="location.reload()">
                    <i class="bi bi-arrow-clockwise"></i> Refrescar
                </button>

                <button type="button" class="btn-rojo" onclick="expandirTodos(true)">
                    <i class="bi bi-arrows-angle-expand"></i> Expandir
                </button>

                <button type="button" class="btn-rojo" onclick="expandirTodos(false)">
                    <i class="bi bi-arrows-angle-contract"></i> Colapsar
                </button>
            </div>
        </div>

        <div class="action-group shadow-sm">
            <div class="action-label">
                <i class="bi bi-search me-1"></i> Búsqueda
            </div>

            <div class="filters-area">
                <div class="input-group input-group-sm">
                    <span class="input-group-text">
                        <i class="bi bi-person-badge"></i>
                    </span>
                    <input id="searchPerfil"
                           type="search"
                           class="form-control"
                           placeholder="Buscar perfil..." />
                </div>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <div class="stat-card">
                <div class="stat-label">Perfiles</div>
                <div class="stat-value">@totalPerfiles</div>
            </div>

            <div class="stat-card">
                <div class="stat-label">KPIs</div>
                <div class="stat-value">@totalKpis</div>
            </div>

            <div class="stat-card">
                <div class="stat-label">Asignaciones</div>
                <div class="stat-value">@totalAsignaciones</div>
            </div>
        </div>

    </div>

    <div class="dashboard-panel">
        <div class="dashboard-panel-head">
            <div>
                <h6 class="dashboard-panel-title">
                    <i class="bi bi-diagram-3 me-1"></i> Gestión de KPIs por Perfil
                </h6>
                <p class="dashboard-panel-subtitle">
                    Abre un perfil y marca los KPIs que debe tener disponibles.
                </p>
            </div>

            <div class="filters-area">
                <div class="input-group input-group-sm">
                    <span class="input-group-text">
                        <i class="bi bi-funnel"></i>
                    </span>
                    <input id="searchKpi"
                           type="search"
                           class="form-control"
                           placeholder="Buscar KPI en perfiles abiertos..." />
                </div>
            </div>
        </div>

        <div class="p-3" id="lista-perfiles">
            @if (!Model.Perfiles.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-person-x"></i>
                    <span class="fw-bold">No hay perfiles disponibles.</span><br />
                    <small>Primero registra perfiles para poder asignar KPIs.</small>
                </div>
            }
            else
            {
                @foreach (var perfil in Model.Perfiles)
                {
                    var totalKpisPerfil = Model.Kpis.Count;
                    var kpisActivos = Model.PermisosKpi.Count(p => p.PerfilId == perfil.Id);
                    var porcentaje = totalKpisPerfil == 0 ? 0 : (kpisActivos * 100 / totalKpisPerfil);

                    <div class="perfil-item"
                         data-perfil="@perfil.Nombre.ToLowerInvariant()"
                         data-total-kpis="@totalKpisPerfil">

                        <div class="perfil-header">
                            <div class="perfil-main">
                                <div class="perfil-icon">
                                    <i class="bi bi-person-badge fs-5"></i>
                                </div>

                                <div class="perfil-info">
                                    <span class="perfil-nombre">@perfil.Nombre</span>

                                    <div class="perfil-meta">
                                        KPIs autorizados para este perfil
                                    </div>

                                    <div class="perfil-progress">
                                        <div class="perfil-progress-bar js-progress" style="width:@porcentaje%;"></div>
                                    </div>
                                </div>
                            </div>

                            <div class="perfil-actions">
                                <span class="perfil-count js-count">
                                    <i class="bi bi-check2-circle"></i>
                                    @kpisActivos / @totalKpisPerfil asignados
                                </span>

                                <span class="perfil-chevron">
                                    <i class="bi bi-chevron-right"></i>
                                </span>
                            </div>
                        </div>

                        <div class="kpis-panel">
                            <div class="kpis-panel-inner">
                                @if (!Model.Kpis.Any())
                                {
                                    <div class="empty-state">
                                        <i class="bi bi-bar-chart-line"></i>
                                        <span class="fw-bold">No hay KPIs registrados.</span><br />
                                        <small>Primero crea KPIs en el catálogo.</small>
                                    </div>
                                }
                                else
                                {
                                    @foreach (var kpi in Model.Kpis)
                                    {
                                        var permiso = Model.PermisosKpi.FirstOrDefault(p => p.PerfilId == perfil.Id && p.KpiCatalogoId == kpi.Id);
                                        var img = string.IsNullOrWhiteSpace(kpi.ImagenUrl)
                                        ? "/img/kpi/kpi-default.png"
                                        : kpi.ImagenUrl;

                                        <div class="kpi-row @(permiso != null ? "active" : "")"
                                             data-kpi-title="@kpi.Titulo.ToLowerInvariant()"
                                             data-kpi-cat="@kpi.Categoria.ToLowerInvariant()">

                                            <div class="kpi-left">
                                                <input type="checkbox"
                                                       class="kpi-check"
                                                       id="chk-@perfil.Id-@kpi.Id"
                                                       data-permiso-id="@(permiso?.Id ?? 0)"
                                                       @(permiso != null ? "checked" : "")
                                                       onchange="toggleKpi(@perfil.Id, @kpi.Id, this)" />

                                                <img src="@img" class="kpi-row-thumb" alt="Imagen KPI" />

                                                <label for="chk-@perfil.Id-@kpi.Id" class="kpi-label mb-0">
                                                    <p class="kpi-title">@kpi.Titulo</p>
                                                    <p class="kpi-sub">
                                                        <span class="chip">
                                                            <i class="bi bi-tags"></i> @kpi.Categoria
                                                        </span>
                                                    </p>
                                                </label>
                                            </div>

                                            <div class="kpi-right">
                                                <span class="assigned-pill">
                                                    <i class="bi bi-check-circle"></i>
                                                    @(permiso != null ? "Asignado" : "Disponible")
                                                </span>

                                                <span class="kpi-id">ID: @kpi.Id</span>
                                            </div>
                                        </div>
                                    }

                                    <div class="empty-filter-msg">
                                        <i class="bi bi-search me-1"></i>
                                        No hay KPIs que coincidan con la búsqueda.
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

    <script>
        function expandirTodos(expand) {
            document.querySelectorAll(".perfil-item").forEach(item => {
                item.classList.toggle("active", !!expand);
            });

            applyKpiFilter();
        }

        document.querySelectorAll(".perfil-header").forEach(header => {
            header.addEventListener("click", () => {
                const item = header.closest(".perfil-item");
                const isActive = item.classList.contains("active");

                document.querySelectorAll(".perfil-item").forEach(i => i.classList.remove("active"));

                if (!isActive) {
                    item.classList.add("active");
                }

                applyKpiFilter();
            });
        });

        const searchPerfil = document.getElementById("searchPerfil");

        searchPerfil?.addEventListener("input", () => {
            const txt = (searchPerfil.value || "").toLowerCase().trim();

            document.querySelectorAll(".perfil-item").forEach(item => {
                const nombre = item.getAttribute("data-perfil") || "";
                item.style.display = (!txt || nombre.includes(txt)) ? "block" : "none";
            });
        });

        const searchKpi = document.getElementById("searchKpi");

        function applyKpiFilter() {
            const q = (searchKpi?.value || "").toLowerCase().trim();

            document.querySelectorAll(".perfil-item.active").forEach(open => {
                let visibles = 0;

                open.querySelectorAll(".kpi-row").forEach(row => {
                    const titulo = row.getAttribute("data-kpi-title") || "";
                    const categoria = row.getAttribute("data-kpi-cat") || "";
                    const show = !q || titulo.includes(q) || categoria.includes(q);

                    row.style.display = show ? "" : "none";

                    if (show) {
                        visibles++;
                    }
                });

                const emptyMsg = open.querySelector(".empty-filter-msg");

                if (emptyMsg) {
                    emptyMsg.style.display = visibles === 0 ? "block" : "none";
                }
            });
        }

        searchKpi?.addEventListener("input", applyKpiFilter);

        function actualizarResumenPerfil(perfilItem) {
            if (!perfilItem) return;

            const total = parseInt(perfilItem.getAttribute("data-total-kpis") || "0", 10);
            const activos = perfilItem.querySelectorAll(".kpi-row.active").length;
            const porcentaje = total === 0 ? 0 : Math.round((activos * 100) / total);

            const count = perfilItem.querySelector(".js-count");
            const progress = perfilItem.querySelector(".js-progress");

            if (count) {
                count.innerHTML = `<i class="bi bi-check2-circle"></i> ${activos} / ${total} asignados`;
            }

            if (progress) {
                progress.style.width = `${porcentaje}%`;
            }
        }

        function actualizarPillKpi(row, asignado) {
            if (!row) return;

            const pill = row.querySelector(".assigned-pill");

            if (pill) {
                pill.innerHTML = asignado
                    ? `<i class="bi bi-check-circle"></i> Asignado`
                    : `<i class="bi bi-circle"></i> Disponible`;
            }
        }

        function toggleKpi(perfilId, kpiId, checkbox) {
            const asignar = checkbox.checked;
            const permisoId = checkbox.getAttribute("data-permiso-id");
            const form = new FormData();
            let url = "";

            if (asignar) {
                url = "/KpisPermisos/Asignar";
                form.append("perfilId", perfilId);
                form.append("kpiId", kpiId);
            } else {
                if (!permisoId || permisoId === "0") {
                    checkbox.checked = true;
                    return;
                }

                url = "/KpisPermisos/Revocar";
                form.append("id", permisoId);
            }

            fetch(url, {
                method: "POST",
                body: form
            })
                .then(async r => {
                    if (!r.ok) {
                        throw new Error("Error al actualizar KPI");
                    }

                    const ct = r.headers.get("content-type") || "";
                    return ct.includes("application/json") ? await r.json() : {};
                })
                .then(data => {
                    const row = checkbox.closest(".kpi-row");
                    const perfilItem = checkbox.closest(".perfil-item");

                    if (asignar && data && data.id) {
                        checkbox.setAttribute("data-permiso-id", data.id);
                        row?.classList.add("active");
                        actualizarPillKpi(row, true);
                    } else if (!asignar) {
                        checkbox.setAttribute("data-permiso-id", "0");
                        row?.classList.remove("active");
                        actualizarPillKpi(row, false);
                    }

                    actualizarResumenPerfil(perfilItem);
                })
                .catch(err => {
                    console.error(err);
                    alert("❌ Error al actualizar KPI");
                    checkbox.checked = !asignar;
                });
        }
    </script>
}