        // ELIMINAR CONVERSIÓN PERMANENTEMENTE
        function confirmarEliminarConversion(conversionId, skuOrigen, skuDestino) {
            if (!confirm(`⚠️ ¿ELIMINAR PERMANENTEMENTE?\n\n${skuOrigen} → ${skuDestino}\n\n⚠️ NO SE PUEDE DESHACER`)) {
                return;
            }

            $.ajax({
                url: '@Url.Action("EliminarConversion", "SkuConversion")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(conversionId),
                success: function (response) {
                    if (response.success) {
                        alert(response.message);
                        cargarConversiones(currentSku);
                    } else {
                        alert('Error: ' + response.message);
                    }
                },
                error: function () {
                    alert('Error al eliminar la conversión');
                }
            });
        }

        $(document).ready(function () {
            actualizarEstadoBotones();

            const $grupoActivo = $('.grupo-item.active').first();

            if ($grupoActivo.length) {
                const grupoId = $grupoActivo.data('grupo-id');
                const masterSku = $grupoActivo.data('master-sku');

                currentGrupoId = grupoId;
                currentSku = masterSku;

                $('.grupo-item').removeClass('active');
                $grupoActivo.addClass('active');

                cargarGrupoItems(grupoId, masterSku);
            }
        });
    </script>
}
