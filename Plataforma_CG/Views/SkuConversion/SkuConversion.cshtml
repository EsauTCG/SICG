@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "SKU Conversion";

    var items = ViewBag.Items as IEnumerable<Plataforma_CG.Models.SkuGrupoItem>;
    var skuSeleccionado = ViewBag.SkuSeleccionado as string;
    var grupos = ViewBag.Grupos as IEnumerable<Plataforma_CG.Models.SkuGrupo>;
    var grupo = ViewBag.GrupoSeleccionado as Plataforma_CG.Models.SkuGrupo;
    var conversiones = ViewBag.Conversiones as IEnumerable<Plataforma_CG.Models.SkuConversion>;
}


<link rel="stylesheet" href="~/css/sku-conversion-grid.css" asp-append-version="true" />

<div class="sku-conversion-app">
<div class="shell">

    <div class="titlebar">
        <div>
            <h5><i class="bi bi-arrow-left-right"></i> SKU Conversion</h5>
            <p class="sub">Catálogo de equivalencias y conversiones por grupo</p>
        </div>

        <span class="chip-soft">
            <i class="bi bi-diagram-3"></i> Catálogo interno
        </span>
    </div>

    <div class="content-pad">

        <div class="row">

            <!-- ===================== -->
            <!-- GRUPOS SKU (IZQUIERDA) -->
            <!-- ===================== -->
            <div class="col-md-4">
                <div class="panel">
                    <div class="panel-head">
                        <div class="panel-title">
                            <i class="bi bi-collection"></i> Grupos SKU
                        </div>
                        <div class="panel-actions">
                            <button class="btn-icon-action btn-primary-icon"
                                    data-bs-toggle="modal"
                                    data-bs-target="#modalNuevoGrupo"
                                    title="Nuevo Grupo">
                                <i class="bi bi-folder-plus"></i>
                            </button>
                            <button class="btn-icon-action btn-success-icon"
                                    data-bs-toggle="modal"
                                    data-bs-target="#modalNuevoSku"
                                    id="btnNuevoSku"
                                    disabled
                                    title="Nuevo SKU en grupo">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>
                    </div>

                    <div class="table-wrap" style="position: relative;">
                        <div id="gruposLoading" class="loading-overlay" style="display: none;">
                            <div class="spinner-border-custom"></div>
                        </div>
                        <ul class="list-group list-group-flush" id="gruposList">

                            @foreach (var g in grupos ?? Enumerable.Empty<Plataforma_CG.Models.SkuGrupo>())
                            {
                                var grupoActivo = grupo != null && g.GrupoId == grupo.GrupoId ? "active" : "";
                                var inactiveClass = !g.Activo ? "inactive" : "";

                                <a class="list-group-item list-group-item-action grupo-item @grupoActivo @inactiveClass"
                                   data-grupo-id="@g.GrupoId"
                                   data-master-sku="@g.MasterSku"
                                   data-activo="@g.Activo.ToString().ToLower()"
                                   href="javascript:void(0);">

                                    <strong>@g.MasterSku</strong>
                                    @if (!g.Activo)
                                    {
                                        <span class="badge badge-inactive ms-1">Inactivo</span>
                                    }
                                    <br />
                                    <small class="text-muted">@g.NombreGrupo</small>

                                    <div class="btn-actions-grupo">
                                        <button class="btn-edit-grupo"
                                                onclick="abrirModalEditarGrupo(@g.GrupoId, event)"
                                                title="Editar grupo">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        @if (!g.Activo)
                                        {
                                            <button class="btn-reactivate-grupo"
                                                    onclick="confirmarReactivarGrupo(@g.GrupoId, '@g.MasterSku', event)"
                                                    title="Reactivar grupo">
                                                <i class="bi bi-arrow-clockwise"></i>
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn-deactivate-grupo"
                                                    onclick="confirmarDesactivarGrupo(@g.GrupoId, '@g.MasterSku', event)"
                                                    title="Desactivar grupo">
                                                <i class="bi bi-dash-circle"></i>
                                            </button>
                                        }
                                        <button class="btn-delete-grupo"
                                                onclick="confirmarEliminarGrupo(@g.GrupoId, '@g.MasterSku', event)"
                                                title="Eliminar permanentemente">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>

                                    @if (grupo != null && g.GrupoId == grupo.GrupoId)
                                    {
                                        <ul class="list-group list-group-flush mt-2 items-container">
                                            @foreach (var i in items ?? Enumerable.Empty<Plataforma_CG.Models.SkuGrupoItem>())
                                            {
                                                var skuActivo = i.Sku == skuSeleccionado ? "active" : "";
                                                var skuInactive = !i.Activo ? "inactive" : "";
                                                var isMaster = i.TipoRelacion == "Master";

                                                <a class="list-group-item list-group-item-action sku-item @skuActivo @skuInactive"
                                                   style="padding-left:@(10 + i.Nivel * 15)px;"
                                                   data-sku="@i.Sku"
                                                   data-nivel="@i.Nivel"
                                                   data-is-master="@(isMaster ? "true" : "false")"
                                                   data-activo="@i.Activo.ToString().ToLower()"
                                                   href="javascript:void(0);">
                                                    @i.Sku

                                                    @if (isMaster)
                                                    {
                                                        <span class="badge bg-primary ms-2">Master</span>
                                                    }
                                                    @if (!i.Activo)
                                                    {
                                                        <span class="badge badge-inactive ms-1">Inactivo</span>
                                                    }

                                                    <div class="btn-actions-sku">
                                                        <button class="btn-edit-sku"
                                                                onclick="abrirModalEditarSku(@g.GrupoId, '@i.Sku', event)"
                                                                title="Editar SKU">
                                                            <i class="bi bi-pencil"></i>
                                                        </button>
                                                        @if (!i.Activo)
                                                        {
                                                            <button class="btn-reactivate-sku"
                                                                    onclick="confirmarReactivarSku(@g.GrupoId, '@i.Sku', @(isMaster ? "true" : "false"), event)"
                                                                    title="Reactivar @(isMaster ? "Master SKU y Grupo" : "SKU")">
                                                                <i class="bi bi-arrow-clockwise"></i>
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <button class="btn-deactivate-sku"
                                                                    onclick="confirmarDesactivarSku(@g.GrupoId, '@i.Sku', @(isMaster ? "true" : "false"), event)"
                                                                    title="Desactivar @(isMaster ? "Master SKU y Grupo" : "SKU")">
                                                                <i class="bi bi-dash-circle"></i>
                                                            </button>
                                                        }
                                                        <button class="btn-delete-sku"
                                                                onclick="confirmarEliminarSku(@g.GrupoId, '@i.Sku', @(isMaster ? "true" : "false"), event)"
                                                                title="Eliminar permanentemente">
                                                            <i class="bi bi-x"></i>
                                                        </button>
                                                    </div>
                                                </a>
                                            }
                                        </ul>
                                    }
                                </a>
                            }

                        </ul>
                    </div>

                </div>
            </div>

            <!-- ===================== -->
            <!-- DETALLE (DERECHA) -->
            <!-- ===================== -->
            <div class="col-md-8">
                <div class="panel">
                    <div class="panel-head">
                        <div class="panel-title">
                            <i class="bi bi-arrow-left-right"></i>
                            Conversiones – <span id="skuTitle">@(skuSeleccionado ?? grupo?.MasterSku ?? "—")</span>
                        </div>
                        <div class="panel-actions">
                            <button class="btn-icon-action btn-warning-icon"
                                    data-bs-toggle="modal"
                                    data-bs-target="#modalNuevaConversion"
                                    id="btnNuevaConversion"
                                    disabled
                                    title="Nueva Conversión">
                                <i class="bi bi-plus-lg"></i>
                            </button>
                        </div>
                    </div>

                    <div class="table-wrap" style="position: relative;">
                        <div id="conversionesLoading" class="loading-overlay" style="display: none;">
                            <div class="spinner-border-custom"></div>
                        </div>
                        <table class="table table-bordered table-hover mb-0">
                            <thead class="text-white" style="background:#8B0000;">
                                <tr>
                                    <th style="width:100px;">Prioridad</th>
                                    <th>Origen</th>
                                    <th style="width:40px;"></th>
                                    <th>Destino</th>
                                    <th style="width:100px;">Estado</th>
                                    <th style="width:180px;">Acciones</th>
                                </tr>
                            </thead>
                            <tbody id="conversionesBody">
                                @foreach (var c in conversiones ?? Enumerable.Empty<Plataforma_CG.Models.SkuConversion>())
                                {
                                    var inactiveRowClass = !c.Activo ? "inactive-row" : "";
                                    <tr class="@inactiveRowClass">
                                        <td>@(c.Prioridad.HasValue? c.Prioridad.ToString() : "Base")</td>
                                        <td>@c.SkuOrigen</td>
                                        <td class="text-center">→</td>
                                        <td><strong>@c.SkuDestino</strong></td>
                                        <td>
                                            @if (c.Activo)
                                            {
                                                <span class="badge rounded-pill bg-success">
                                                    <i class="bi bi-check-circle"></i> Activo
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge rounded-pill bg-secondary">
                                                    <i class="bi bi-x-circle"></i> Inactivo
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            <div class="btn-actions-conversion">
                                                <button class="btn-edit-conversion"
                                                        onclick="abrirModalEditarConversion(@c.Id)"
                                                        title="Editar conversión">
                                                    <i class="bi bi-pencil"></i>
                                                </button>
                                                @if (!c.Activo)
                                                {
                                                    <button class="btn-reactivate-conversion"
                                                            onclick="confirmarReactivarConversion(@c.Id, '@c.SkuOrigen', '@c.SkuDestino')"
                                                            title="Reactivar conversión">
                                                        <i class="bi bi-arrow-clockwise"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button class="btn-deactivate-conversion"
                                                            onclick="confirmarDesactivarConversion(@c.Id, '@c.SkuOrigen', '@c.SkuDestino')"
                                                            title="Desactivar conversión">
                                                        <i class="bi bi-dash-circle"></i>
                                                    </button>
                                                }
                                                <button class="btn-delete-conversion"
                                                        onclick="confirmarEliminarConversion(@c.Id, '@c.SkuOrigen', '@c.SkuDestino')"
                                                        title="Eliminar permanentemente">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>


<!-- ========== MODAL: NUEVO GRUPO ========== -->
<div class="modal fade" id="modalNuevoGrupo" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background: linear-gradient(90deg, #8B0000 0%, #5a0000 100%); color: white;">
                <h5 class="modal-title"><i class="bi bi-collection"></i> Nuevo Grupo SKU</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="formNuevoGrupo">
                    <div class="mb-3">
                        <label class="form-label">Master SKU <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="grupoMasterSku" required>
                        <small class="text-muted">Código del SKU principal del grupo</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Nombre del Grupo <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="grupoNombre" required>
                        
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" onclick="guardarGrupo()">
                    <i class="bi bi-save"></i> Guardar Grupo
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ========== 🔥 MODAL: EDITAR GRUPO ========== -->
<div class="modal fade" id="modalEditarGrupo" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background: linear-gradient(90deg, #3b82f6 0%, #2563eb 100%); color: white;">
                <h5 class="modal-title"><i class="bi bi-pencil"></i> Editar Grupo SKU</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="formEditarGrupo">
                    <input type="hidden" id="editGrupoId">
                    <div class="mb-3">
                        <label class="form-label">Master SKU</label>
                        <input type="text" class="form-control" id="editGrupoMasterSku" readonly>
                        <small class="text-muted">El Master SKU no se puede modificar</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Nombre del Grupo <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="editGrupoNombre" required>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" onclick="guardarEdicionGrupo()">
                    <i class="bi bi-save"></i> Guardar Cambios
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ========== MODAL: NUEVO SKU ITEM ========== -->
<div class="modal fade" id="modalNuevoSku" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background: linear-gradient(90deg, #16a34a 0%, #15803d 100%); color: white;">
                <h5 class="modal-title"><i class="bi bi-tag"></i> Nuevo SKU</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="formNuevoSku">
                    <div class="mb-3">
                        <label class="form-label">Grupo</label>
                        <input type="text" class="form-control" id="skuGrupoNombre" readonly>
                        <input type="hidden" id="skuGrupoId">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">SKU <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="skuCodigo" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Tipo de Relación <span class="text-danger">*</span></label>
                        <select class="form-control" id="skuTipoRelacion" required>
                            <option value="">Seleccione...</option>
                            <option value="Master">Master</option>
                            <option value="Derivado">Derivado</option>
                        </select>
                        <small class="text-muted">Master = SKU principal (nivel 0), Derivado = SKU relacionado (nivel 1+)</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Nivel <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" id="skuNivel" value="0" min="0" required>
                        <small class="text-muted">0 = Master (raíz), 1+ = Derivados</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Orden</label>
                        <input type="number" class="form-control" id="skuOrden" value="0" min="0">
                        <small class="text-muted">Orden de visualización (0 = automático)</small>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-success" onclick="guardarSku()">
                    <i class="bi bi-save"></i> Guardar SKU
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ========== 🔥 MODAL: EDITAR SKU ITEM ========== -->
<div class="modal fade" id="modalEditarSku" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background: linear-gradient(90deg, #3b82f6 0%, #2563eb 100%); color: white;">
                <h5 class="modal-title"><i class="bi bi-pencil"></i> Editar SKU</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="formEditarSku">
                    <input type="hidden" id="editSkuGrupoId">
                    <input type="hidden" id="editSkuOriginal">
                    <div class="mb-3">
                        <label class="form-label">SKU</label>
                        <input type="text" class="form-control" id="editSkuCodigo" readonly>
                        <small class="text-muted">El código SKU no se puede modificar</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Tipo de Relación <span class="text-danger">*</span></label>
                        <select class="form-control" id="editSkuTipoRelacion" required>
                            <option value="Master">Master</option>
                            <option value="Derivado">Derivado</option>
                        </select>
                        <small class="text-muted">Master = SKU principal (nivel 0), Derivado = SKU relacionado (nivel 1+)</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Nivel <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" id="editSkuNivel" min="0" required>
                        <small class="text-muted">0 = Master, 1+ = Derivados</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Orden</label>
                        <input type="number" class="form-control" id="editSkuOrden" min="0">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" onclick="guardarEdicionSku()">
                    <i class="bi bi-save"></i> Guardar Cambios
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ========== MODAL: NUEVA CONVERSIÓN ========== -->
<div class="modal fade" id="modalNuevaConversion" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background: linear-gradient(90deg, #f59e0b 0%, #d97706 100%); color: white;">
                <h5 class="modal-title"><i class="bi bi-arrow-left-right"></i> Nueva Conversión</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="formNuevaConversion">
                    <div class="mb-3">
                        <label class="form-label">SKU Origen</label>
                        <input type="text" class="form-control" id="conversionOrigen" readonly>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">SKU Destino <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="conversionDestino" required>
                        <small class="text-muted">SKU al que se convertirá</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Prioridad</label>
                        <input type="number" class="form-control" id="conversionPrioridad" value="0" min="0">
                        <small class="text-muted">0 = automático, mayor número = mayor prioridad</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Factor de Conversión (Opcional)</label>
                        <input type="number" step="0.01" class="form-control" id="conversionFactor" value="1.00">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-warning" onclick="guardarConversion()">
                    <i class="bi bi-save"></i> Guardar Conversión
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ========== 🔥 MODAL: EDITAR CONVERSIÓN ========== -->
<div class="modal fade" id="modalEditarConversion" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background: linear-gradient(90deg, #3b82f6 0%, #2563eb 100%); color: white;">
                <h5 class="modal-title"><i class="bi bi-pencil"></i> Editar Conversión</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="formEditarConversion">
                    <input type="hidden" id="editConversionId">
                    <div class="mb-3">
                        <label class="form-label">SKU Origen</label>
                        <input type="text" class="form-control" id="editConversionOrigen" readonly>
                        <small class="text-muted">El SKU Origen no se puede modificar</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">SKU Destino <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="editConversionDestino" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Prioridad</label>
                        <input type="number" class="form-control" id="editConversionPrioridad" min="0">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Factor de Conversión</label>
                        <input type="number" step="0.01" class="form-control" id="editConversionFactor">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" onclick="guardarEdicionConversion()">
                    <i class="bi bi-save"></i> Guardar Cambios
                </button>
            </div>
        </div>
    </div>
</div>



</div>

@section Scripts {
    <script>
        let currentGrupoId = @(grupo?.GrupoId ?? 0);
        let currentSku = '@(skuSeleccionado ?? "")';

        $(document).ready(function () {

            // Click en Grupo
            $(document).on('click', '.grupo-item', function (e) {
                if ($(e.target).closest('.btn-actions-grupo').length > 0) {
                    return;
                }

                e.preventDefault();

                const grupoId = $(this).data('grupo-id');
                const masterSku = $(this).data('master-sku');

                if (grupoId === currentGrupoId) return;

                currentGrupoId = grupoId;
                currentSku = masterSku;

                $('.grupo-item').removeClass('active');
                $(this).addClass('active');

                cargarGrupoItems(grupoId, masterSku);
            });

            // Click en SKU
            $(document).on('click', '.sku-item', function (e) {
                if ($(e.target).closest('.btn-actions-sku').length > 0) {
                    return;
                }

                e.preventDefault();

                const sku = $(this).data('sku');

                if (sku === currentSku) return;

                currentSku = sku;

                $('.sku-item').removeClass('active');
                $(this).addClass('active');

                cargarConversiones(sku);
            });

        });

        function cargarGrupoItems(grupoId, masterSku) {
            $('#gruposLoading').show();

            $.ajax({
                url: '@Url.Action("GetGrupoItems", "SkuConversion")',
                type: 'GET',
                data: { grupoId: grupoId },
                success: function (data) {
                    $('.items-container').remove();

                    if (data.items && data.items.length > 0) {
                        let itemsHtml = '<ul class="list-group list-group-flush mt-2 items-container">';

                        data.items.forEach(function (item) {
                            const paddingLeft = 10 + (item.nivel * 15);
                            const activeClass = item.sku === currentSku ? 'active' : '';
                            const inactiveClass = !item.activo ? 'inactive' : '';
                            const isMaster = item.tipoRelacion === 'Master';
                            const masterBadge = isMaster ? '<span class="badge bg-primary ms-2">Master</span>' : '';
                            const inactiveBadge = !item.activo ? '<span class="badge badge-inactive ms-1">Inactivo</span>' : '';

                            let actionButtons = `
