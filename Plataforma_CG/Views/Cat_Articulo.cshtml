@model IEnumerable<Plataforma_CG.Models.ArticuloSap>

@{
    ViewData["Title"] = "Catalogo de Articulos SAP";
    Layout = "~/Views/Shared/_Layout2.cshtml";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

<style>
    :root {
        --sap-bg: #f0dede;
        --sap-panel: #f8eeee;
        --sap-panel-2: #f1dede;
        --sap-surface: #fffafa;
        --sap-soft: #fff7f7;
        --sap-soft-2: #f4dddd;
        --sap-line: #c79d9d;
        --sap-line-dark: #8f4c4c;
        --sap-text: #3b1717;
        --sap-muted: #6a3a3a;
        --sap-brand: #8B0000;
        --sap-header: linear-gradient(180deg, #b30000 0%, #8b0000 55%, #5c0000 100%);
        --sap-toolbar: linear-gradient(#fff6f6, #ecd8d8);
        --sap-status: linear-gradient(#f6e9e9, #ead5d5);
        --sap-shadow: 0 0 0 1px rgba(255,255,255,.45) inset, 0 8px 18px rgba(70,12,12,.14);
    }

    body[data-theme="dark"] {
        --sap-bg: #0b1120;
        --sap-panel: #111827;
        --sap-panel-2: #182235;
        --sap-surface: #111827;
        --sap-soft: #1f2937;
        --sap-soft-2: #243044;
        --sap-line: #374151;
        --sap-line-dark: #4b5563;
        --sap-text: #f9fafb;
        --sap-muted: #9ca3af;
        --sap-header: linear-gradient(180deg, #7f1d1d 0%, #5f1212 55%, #2b0505 100%);
        --sap-toolbar: linear-gradient(180deg, #1f2937 0%, #111827 100%);
        --sap-status: linear-gradient(180deg, #1f2937 0%, #111827 100%);
        --sap-shadow: 0 10px 24px rgba(0,0,0,.35);
    }

    * {
        box-sizing: border-box;
    }

    body {
        margin: 0 !important;
        padding: 0 !important;
        font-family: Tahoma, Verdana, Arial, sans-serif;
        background: transparent !important;
        color: var(--sap-text);
    }

    .container,
    .container-fluid {
        max-width: 100% !important;
        width: 100% !important;
        padding: 0 !important;
        margin: 0 !important;
    }

    .window {
        width: 100%;
        max-width: 100%;
        margin: 0 !important;
        border: 1px solid var(--sap-line-dark);
        background: var(--sap-panel);
        box-shadow: var(--sap-shadow);
        overflow: hidden;
        padding: 0 !important;
        color: var(--sap-text);
    }

    .titlebar {
        display: none !important;
    }

    .toolbar {
        display: flex;
        align-items: flex-end;
        gap: 6px;
        padding: 6px 8px;
        background: var(--sap-toolbar);
        border-bottom: 1px solid var(--sap-line);
        font-size: 12px;
        flex-wrap: wrap;
    }

        .toolbar .group {
            display: flex;
            flex-direction: column;
            gap: 3px;
            min-width: 260px;
            flex: 1 1 320px;
        }

        .toolbar label {
            display: block;
            color: var(--sap-text);
            font-size: 12px;
            margin-bottom: 2px !important;
            font-weight: bold;
        }

        .toolbar input,
        .toolbar .form-control,
        .rotacion-input {
            height: 28px !important;
            padding: 3px 6px !important;
            border: 1px solid var(--sap-line-dark) !important;
            background: var(--sap-surface) !important;
            font-family: inherit !important;
            font-size: 12px !important;
            width: 100%;
            border-radius: 0 !important;
            box-shadow: none !important;
            color: var(--sap-text) !important;
        }

            .toolbar input::placeholder {
                color: var(--sap-muted) !important;
            }

            .toolbar input:focus,
            .toolbar .form-control:focus,
            .rotacion-input:focus {
                border-color: var(--sap-brand) !important;
                outline: none !important;
                box-shadow: 0 0 0 1px rgba(139,0,0,.25) !important;
            }

    .tool-btn {
        min-width: 72px;
        text-align: center;
        background: linear-gradient(#fffefe, #ecd7d7);
        border: 1px solid var(--sap-line-dark);
        box-shadow: 0 1px 0 rgba(255,255,255,.55) inset;
        cursor: pointer;
        color: #4a1111;
        height: 28px;
        font-size: 12px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 0 10px;
        text-decoration: none;
        border-radius: 0;
        white-space: nowrap;
    }

    body[data-theme="dark"] .tool-btn {
        background: linear-gradient(180deg, #374151 0%, #1f2937 100%);
        color: #f9fafb;
        border-color: #4b5563;
        box-shadow: none;
    }

    .tool-btn-primary {
        color: #fff;
        border-color: #7f0a0a;
        background: linear-gradient(180deg, #b40000 0%, #8f0000 55%, #6e0000 100%);
    }

    .tool-btn-success {
        color: #fff;
        border-color: #157347;
        background: linear-gradient(180deg, #27ae60 0%, #1f9a54 55%, #198754 100%);
    }

    .content {
        padding: 8px;
        background: var(--sap-bg);
    }

    .workspace {
        border: 1px solid var(--sap-line);
        background: var(--sap-panel);
        padding: 8px;
    }

    .section {
        border: 1px solid var(--sap-line);
        background: var(--sap-surface);
        margin-bottom: 10px;
    }

    .section-title {
        padding: 6px 8px;
        font-size: 12px;
        font-weight: bold;
        color: #fff;
        background: var(--sap-header);
        border-bottom: 1px solid #6b1f1f;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        flex-wrap: wrap;
    }

    .status-chip,
    #pageInfo {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 3px 8px;
        font-size: 11px;
        font-weight: 700;
        border: 1px solid var(--sap-line);
        border-radius: 2px;
        background: var(--sap-soft);
        color: var(--sap-text);
    }

    .table-wrap {
        padding: 0;
        overflow: auto;
        max-height: 70vh;
        background: var(--sap-surface);
        width: 100%;
        position: relative;
        border-top: 1px solid var(--sap-line);
    }

        .table-wrap table {
            width: 100%;
            table-layout: fixed;
            border-collapse: separate !important;
            border-spacing: 0 !important;
            font-size: 12px;
            background: var(--sap-surface) !important;
            color: var(--sap-text) !important;
        }

        .table-wrap thead,
        .table-wrap thead tr,
        .table-wrap thead th {
            background: var(--sap-header) !important;
            color: #fff !important;
        }

            .table-wrap thead th {
                position: sticky;
                top: -1px;
                z-index: 20;
                border-top: 1px solid rgba(255,255,255,.2);
                border-right: 1px solid rgba(0,0,0,.35);
                border-bottom: 1px solid rgba(0,0,0,.45);
                padding: 6px 5px;
                text-align: left;
                white-space: nowrap;
                font-size: 12px;
                line-height: 1.2;
                box-shadow: 0 2px 0 rgba(0,0,0,.25);
                font-weight: 700;
            }

        .table-wrap tbody td {
            background: var(--sap-surface) !important;
            border-right: 1px solid var(--sap-line) !important;
            border-bottom: 1px solid var(--sap-line) !important;
            padding: 6px 5px;
            white-space: nowrap;
            vertical-align: middle;
            font-size: 12px;
            overflow: hidden;
            text-overflow: ellipsis;
            line-height: 1.2;
            color: var(--sap-text) !important;
            font-weight: 400;
        }

            .table-wrap tbody td:first-child {
                border-left: 1px solid var(--sap-line) !important;
            }

        .table-wrap tbody tr:nth-child(even) td {
            background: var(--sap-panel-2) !important;
        }

        .table-wrap tbody tr:hover td {
            background: var(--sap-soft-2) !important;
        }

    .num {
        text-align: right !important;
        font-variant-numeric: tabular-nums;
    }

    #tablaPrecios th:nth-child(1), #tablaPrecios td:nth-child(1) {
        width: 130px;
    }

    #tablaPrecios th:nth-child(2), #tablaPrecios td:nth-child(2) {
        width: 420px;
    }

    #tablaPrecios th:nth-child(3), #tablaPrecios td:nth-child(3) {
        width: 140px;
    }

    #tablaPrecios th:nth-child(4), #tablaPrecios td:nth-child(4) {
        width: 120px;
    }

    #tablaPrecios th:nth-child(5), #tablaPrecios td:nth-child(5) {
        width: 110px;
    }

    #tablaPrecios th:nth-child(6), #tablaPrecios td:nth-child(6) {
        width: 130px;
    }

    #tablaPrecios th:nth-child(7), #tablaPrecios td:nth-child(7) {
        width: 180px;
    }

    .pager {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .75rem;
        flex-wrap: wrap;
        padding: 10px;
        border-top: 1px solid var(--sap-line);
        background: var(--sap-surface);
    }

        .pager .btn {
            min-width: 110px;
            border-radius: 0;
            font-size: 12px;
        }

            .pager .btn:focus {
                box-shadow: none;
            }

    body[data-theme="dark"] .pager .btn-outline-secondary {
        color: #e5e7eb;
        border-color: #4b5563;
        background: #1f2937;
    }

        body[data-theme="dark"] .pager .btn-outline-secondary:hover:not(:disabled) {
            background: #374151;
            color: #ffffff;
        }

        body[data-theme="dark"] .pager .btn-outline-secondary:disabled {
            color: #6b7280;
            border-color: #374151;
            background: #111827;
        }

    #loader {
        font-weight: 700;
        color: var(--sap-brand);
        font-size: 12px;
    }

    body[data-theme="dark"] #loader {
        color: #fca5a5;
    }

    .statusbar {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 6px 10px;
        font-size: 11px;
        color: var(--sap-text);
        border-top: 1px solid var(--sap-line-dark);
        background: var(--sap-status);
        flex-wrap: wrap;
    }

    body[data-theme="dark"] .text-warning {
        color: #facc15 !important;
    }

    body[data-theme="dark"] .text-danger {
        color: #fca5a5 !important;
    }

    @@media (max-width: 992px) {
        .toolbar {
            align-items: stretch;
        }

            .toolbar .group {
                min-width: 100%;
                flex: 1 1 100%;
            }
    }

    @@media (max-width: 768px) {
        .table-wrap table {
            min-width: 1200px;
        }
    }

    /* ============================================================
       GRID COMPACTO FINAL — CATÁLOGO DE ARTÍCULOS SAP
       Fuente: Poppins
       Conserva Razor, IDs, paginación, búsqueda, sincronización,
       exportación Excel y JavaScript existentes.
       ============================================================ */

    .catalogo-articulos-sap-app {
        width: 100% !important;
        max-width: 100% !important;
        min-width: 0 !important;
        margin: 0 !important;
        padding: 0 !important;
        box-sizing: border-box !important;
        container-type: inline-size;
        container-name: catalogo-articulos-sap;
        font-family: "Poppins", "Segoe UI", Arial, sans-serif !important;
    }

    .catalogo-articulos-sap-app,
    .catalogo-articulos-sap-app > *,
    .catalogo-articulos-sap-app .content,
    .catalogo-articulos-sap-app .workspace,
    .catalogo-articulos-sap-app .section,
    .catalogo-articulos-sap-app .toolbar,
    .catalogo-articulos-sap-app .table-wrap,
    .catalogo-articulos-sap-app .pager {
        min-width: 0 !important;
        max-width: 100% !important;
        box-sizing: border-box !important;
    }

    .catalogo-articulos-sap-app button,
    .catalogo-articulos-sap-app input,
    .catalogo-articulos-sap-app select,
    .catalogo-articulos-sap-app textarea,
    .catalogo-articulos-sap-app table {
        font-family: "Poppins", "Segoe UI", Arial, sans-serif !important;
    }

    /* Encabezado visible y compacto */
    .catalogo-articulos-sap-app .titlebar {
        display: flex !important;
        min-height: 30px !important;
        height: 30px !important;
        padding: 0 7px !important;
        align-items: center !important;
        justify-content: space-between !important;
        gap: 5px !important;
        background: var(--sap-header) !important;
        color: #fff !important;
        border-bottom: 1px solid #6b1f1f !important;
        font-size: 9px !important;
        font-weight: 700 !important;
        line-height: 1 !important;
    }

    .catalogo-articulos-sap-app .titlebar .actions {
        display: flex !important;
        align-items: center !important;
        gap: 3px !important;
    }

    .catalogo-articulos-sap-app .titlebar .win-btn {
        width: 7px !important;
        height: 7px !important;
        border-radius: 50% !important;
        background: rgba(255,255,255,.70) !important;
        border: 0 !important;
    }

    /* ============================================================
       TOOLBAR GRID
       Buscador flexible + Excel + Sincronizar + loader
       ============================================================ */
    .catalogo-articulos-sap-app .toolbar {
        display: grid !important;
        grid-template-columns:
            minmax(260px, 1fr)
            max-content
            max-content
            max-content !important;
        gap: 4px !important;
        align-items: end !important;
        width: 100% !important;
        padding: 4px 5px !important;
        flex-wrap: nowrap !important;
        font-size: 8px !important;
    }

    .catalogo-articulos-sap-app .toolbar .group {
        width: 100% !important;
        min-width: 0 !important;
        flex: none !important;
        gap: 1px !important;
    }

    .catalogo-articulos-sap-app .toolbar label {
        display: none !important;
    }

    .catalogo-articulos-sap-app .toolbar input,
    .catalogo-articulos-sap-app .toolbar .form-control,
    .catalogo-articulos-sap-app .rotacion-input {
        width: 100% !important;
        min-width: 0 !important;
        min-height: 25px !important;
        height: 25px !important;
        padding: 2px 6px !important;
        border-radius: 0 !important;
        font-size: 8px !important;
        line-height: 1 !important;
        box-shadow: none !important;
    }

    .catalogo-articulos-sap-app .tool-btn {
        min-width: 0 !important;
        min-height: 25px !important;
        height: 25px !important;
        padding: 0 7px !important;
        gap: 3px !important;
        border-radius: 0 !important;
        font-size: 7.5px !important;
        line-height: 1 !important;
        font-weight: 600 !important;
        box-shadow: none !important;
        white-space: nowrap !important;
    }

    .catalogo-articulos-sap-app .tool-btn i {
        font-size: 8px !important;
    }

    .catalogo-articulos-sap-app #loader {
        align-self: center !important;
        margin: 0 !important;
        font-size: 7px !important;
        line-height: 1 !important;
        white-space: nowrap !important;
    }

    /* Contenido */
    .catalogo-articulos-sap-app .content {
        width: 100% !important;
        padding: 4px !important;
    }

    .catalogo-articulos-sap-app .workspace {
        width: 100% !important;
        padding: 0 !important;
        border: 0 !important;
        background: transparent !important;
    }

    .catalogo-articulos-sap-app .section {
        width: 100% !important;
        margin: 0 !important;
        border-radius: 0 !important;
        box-shadow: none !important;
    }

    .catalogo-articulos-sap-app .section-title {
        min-height: 24px !important;
        padding: 4px 6px !important;
        gap: 4px !important;
        border-radius: 0 !important;
        font-size: 8px !important;
        line-height: 1 !important;
    }

    .catalogo-articulos-sap-app .status-chip,
    .catalogo-articulos-sap-app #pageInfo {
        min-height: 20px !important;
        padding: 2px 5px !important;
        gap: 3px !important;
        border-radius: 2px !important;
        font-size: 7px !important;
        line-height: 1 !important;
    }

    /* ============================================================
       TABLA — 7 columnas compactas
       ============================================================ */
    .catalogo-articulos-sap-app .table-wrap {
        width: 100% !important;
        min-height: 300px !important;
        height: clamp(300px, 61dvh, 700px) !important;
        max-height: 700px !important;
        overflow: auto !important;
        scrollbar-gutter: stable;
    }

    .catalogo-articulos-sap-app #tablaPrecios {
        width: 100% !important;
        min-width: 880px !important;
        table-layout: fixed !important;
        font-size: 8px !important;
    }

    .catalogo-articulos-sap-app .table-wrap thead th {
        padding: 4px 3px !important;
        font-size: 7px !important;
        line-height: 1 !important;
        font-weight: 700 !important;
        box-shadow: none !important;
        letter-spacing: 0 !important;
    }

    .catalogo-articulos-sap-app .table-wrap tbody td {
        padding: 3px !important;
        font-size: 8px !important;
        line-height: 1.05 !important;
        font-weight: 400 !important;
    }

    .catalogo-articulos-sap-app #tablaPrecios th:nth-child(1),
    .catalogo-articulos-sap-app #tablaPrecios td:nth-child(1) {
        width: 90px !important;
    }

    .catalogo-articulos-sap-app #tablaPrecios th:nth-child(2),
    .catalogo-articulos-sap-app #tablaPrecios td:nth-child(2) {
        width: 300px !important;
    }

    .catalogo-articulos-sap-app #tablaPrecios th:nth-child(3),
    .catalogo-articulos-sap-app #tablaPrecios td:nth-child(3) {
        width: 95px !important;
    }

    .catalogo-articulos-sap-app #tablaPrecios th:nth-child(4),
    .catalogo-articulos-sap-app #tablaPrecios td:nth-child(4) {
        width: 95px !important;
    }

    .catalogo-articulos-sap-app #tablaPrecios th:nth-child(5),
    .catalogo-articulos-sap-app #tablaPrecios td:nth-child(5) {
        width: 70px !important;
    }

    .catalogo-articulos-sap-app #tablaPrecios th:nth-child(6),
    .catalogo-articulos-sap-app #tablaPrecios td:nth-child(6) {
        width: 90px !important;
    }

    .catalogo-articulos-sap-app #tablaPrecios th:nth-child(7),
    .catalogo-articulos-sap-app #tablaPrecios td:nth-child(7) {
        width: 140px !important;
    }

    .catalogo-articulos-sap-app #tablaPrecios td:nth-child(2),
    .catalogo-articulos-sap-app #tablaPrecios td:nth-child(3),
    .catalogo-articulos-sap-app #tablaPrecios td:nth-child(4),
    .catalogo-articulos-sap-app #tablaPrecios td:nth-child(7) {
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        white-space: nowrap !important;
    }

    .catalogo-articulos-sap-app .rotacion-input {
        width: 58px !important;
        max-width: 58px !important;
        min-height: 21px !important;
        height: 21px !important;
        padding: 1px 3px !important;
        font-size: 7.5px !important;
    }

    /* ============================================================
       PAGINACIÓN
       ============================================================ */
    .catalogo-articulos-sap-app .pager {
        display: grid !important;
        grid-template-columns: max-content minmax(0, 1fr) max-content !important;
        gap: 4px !important;
        align-items: center !important;
        width: 100% !important;
        padding: 4px 5px !important;
    }

    .catalogo-articulos-sap-app .pager .btn {
        min-width: 76px !important;
        min-height: 24px !important;
        height: 24px !important;
        padding: 0 6px !important;
        border-radius: 0 !important;
        font-family: "Poppins", "Segoe UI", Arial, sans-serif !important;
        font-size: 7px !important;
        line-height: 1 !important;
        font-weight: 600 !important;
        box-shadow: none !important;
    }

    .catalogo-articulos-sap-app .pager > .d-flex {
        min-width: 0 !important;
        justify-content: center !important;
    }

    .catalogo-articulos-sap-app #pageInfo {
        max-width: 100% !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
        white-space: nowrap !important;
    }

    /* Barra inferior */
    .catalogo-articulos-sap-app .statusbar {
        min-height: 18px !important;
        padding: 2px 5px !important;
        gap: 3px !important;
        font-size: 6.2px !important;
        line-height: 1 !important;
        align-items: center !important;
    }

    .catalogo-articulos-sap-app .statusbar > div {
        min-width: 0 !important;
        white-space: nowrap !important;
        overflow: hidden !important;
        text-overflow: ellipsis !important;
    }

    /* ============================================================
       RESPONSIVO POR ANCHO REAL DEL CONTENEDOR / SIDEBAR
       ============================================================ */
    @@container catalogo-articulos-sap (max-width: 900px) {
        .catalogo-articulos-sap-app .toolbar {
            grid-template-columns: minmax(0, 1fr) repeat(2, max-content) !important;
        }

        .catalogo-articulos-sap-app #loader {
            grid-column: 1 / -1 !important;
            justify-self: end !important;
        }

        .catalogo-articulos-sap-app .table-wrap {
            height: 56dvh !important;
            min-height: 270px !important;
        }
    }

    @@container catalogo-articulos-sap (max-width: 620px) {
        .catalogo-articulos-sap-app .toolbar {
            grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        }

        .catalogo-articulos-sap-app .toolbar .group {
            grid-column: 1 / -1 !important;
        }

        .catalogo-articulos-sap-app .tool-btn {
            width: 100% !important;
        }

        .catalogo-articulos-sap-app #loader {
            grid-column: 1 / -1 !important;
            justify-self: start !important;
        }

        .catalogo-articulos-sap-app .content {
            padding: 0 !important;
        }

        .catalogo-articulos-sap-app .table-wrap {
            height: 51dvh !important;
            min-height: 250px !important;
        }

        .catalogo-articulos-sap-app .pager {
            grid-template-columns: 1fr 1fr !important;
        }

