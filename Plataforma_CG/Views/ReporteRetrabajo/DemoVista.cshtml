                if (!/^\d{4}-\d{2}-\d{2}$/.test(f)) return;
                const lunes = new Date(`${f}T12:00:00`);
                lunes.setDate(lunes.getDate() - ((lunes.getDay() + 6) % 7));
                const domingo = new Date(lunes);
                domingo.setDate(domingo.getDate() + 6);
                const desde = fechaLocal(lunes), hasta = fechaLocal(domingo);
                semanas.set(`${desde}|${hasta}`, `Semana ${desde} a ${hasta}`);
            });
            if (!semanasOriginales && hayConsultaReal) {
                semanasOriginales = new Map(semanas);
            }
            const disponibles = semanasOriginales || semanas;
            [...disponibles.entries()].sort((a, b) => a[0].localeCompare(b[0]))
                .forEach(([clave, texto]) => combo.add(new Option(texto, clave)));
            if (disponibles.has(previo)) combo.value = previo;
        }

        function borrarConsultaReal() {
            semanasOriginales = null;
            fechasOriginales = null;
            datosReales = { entradas: [], salidas: [], advertencias: [] };
            hayConsultaReal = false;
            actualizarSemanasReales();
            actualizarVistaMaster();
        }

        function exportarCSV(nombre, filas) {
            const texto = '\ufeff' + filas.map(fila => fila.map(v => {
                let valor = String(v ?? '');
                if (/^[=+\x40\t\r]/.test(valor)) valor = "'" + valor;
                return '"' + valor.replaceAll('"', '""') + '"';
            }).join(',')).join('\r\n');
            const url = URL.createObjectURL(new Blob([texto], {type:'text/csv;charset=utf-8'}));
            const link = document.createElement('a');
            link.href = url;
            link.download = nombre;
            link.click();
            setTimeout(() => URL.revokeObjectURL(url), 1000);
        }

        function exportarVisceras() {
            if (!hayConsultaReal) {
                $('estadoConsulta').textContent = 'Primero consulta PyMeat para exportar datos reales.';
                return;
            }
            const { entradas, salidas, advertencias } = obtenerDatosFiltradosMaster();
            const filas = [['Tipo', 'Fecha de salida', 'Solicitud', 'SKU', 'Producto', 'Etiquetas', 'Kilogramos', 'Observación']];
            entradas.forEach(e => filas.push([
                'ENTRADA', '', e.solicitudProduccionId, e.sku, e.producto,
                e.cantidadEtiquetas, e.totalKg, 'Entrada completa vinculada a solicitud'
            ]));
            salidas.forEach(e => filas.push([
                'SALIDA', String(e.fecha || '').substring(0,10), e.solicitudProduccionId,
                e.sku, e.producto, e.cantidadEtiquetas, e.totalKg, 'Salida del periodo consultado'
            ]));
            const idsConMultiples = new Set();
            const porSolicitud = new Map();
            (datosReales.entradas || []).forEach(e => {
                if (!porSolicitud.has(e.solicitudProduccionId)) porSolicitud.set(e.solicitudProduccionId, new Set());
                porSolicitud.get(e.solicitudProduccionId).add(e.sku);
            });
            entradas.forEach(e => {
                if ((porSolicitud.get(e.solicitudProduccionId)?.size || 0) > 1)
                    idsConMultiples.add(e.solicitudProduccionId);
            });
            const parcial = advertencias.length > 0 || idsConMultiples.size > 0;
            const kgEntrada = entradas.reduce((a,e)=>a+Number(e.totalKg||0),0);
            const kgSalida = salidas.reduce((a,e)=>a+Number(e.totalKg||0),0);
            const pct = kgEntrada > 0 && !parcial
                ? (((kgSalida-kgEntrada)/kgEntrada)*100).toFixed(2) + '%'
                : 'Por validar';
            filas.push(['RESUMEN','', '', $('grupoProducto').value,
                'Total entrada asociada', '', kgEntrada,
                `Salida del periodo: ${kgSalida.toFixed(3)} kg; variación: ${pct}`]);
            exportarCSV(`Visceras_TIF_${$('start').value}_${$('end').value}.csv`, filas);
        }

        function exportarDemoDecomisos() {
            const s = sheets[1], rows = filterRows(), cols = columns();
            const filas = [cols.map(i=>s.head[i])].concat(rows.map(r=>cols.map(i=>
                i===1 ? r.date : i===0 ? r.week : r.v[i] ?? '')));
            exportarCSV('Decomisos_TIF_REFERENCIA_DEMO.csv', filas);
        }

        function setupTab(i) {
            active = i;
            const visceras = i === 0;
            document.querySelectorAll('.tab').forEach((el,j)=>el.classList.toggle('active',j===i));
            document.querySelectorAll('.solo-visceras').forEach(el=>el.hidden=!visceras);
            document.querySelectorAll('.solo-decomisos').forEach(el=>el.hidden=visceras);
            $('campoMaster').hidden = !visceras;
            $('campoMovimiento').hidden = visceras;
            $('consultarReal').hidden = !visceras;
            $('download').textContent = visceras ? 'Exportar CSV real' : 'Exportar demo CSV';
            $('labelBusqueda').textContent = visceras
                ? 'Buscar SKU o producto de entrada (resumen)' : 'Buscar indicador o SKU (demo)';
            $('estadoModulo').textContent = visceras
                ? 'Vísceras TIF: datos de PyMeat. Sin fechas se consultan los últimos 30 días. Las entradas son completas por solicitud; las salidas se filtran por fecha.'
                : 'Decomisos TIF: esta pestaña TODAVÍA contiene datos de referencia del Excel; no son datos actuales de PyMeat.';
            if (visceras) {
                actualizarSemanasReales();
                actualizarVistaMaster();
            } else {
                updateWeek();
                render();
                $('notaGraficaEvolucion').textContent = 'Gráfica de referencia del Excel, no PyMeat.';
                $('notaGraficaSku').textContent = 'Comparación de datos estáticos del Excel.';
            }
        }

        // La vista está al final del HTML: los elementos ya existen en el DOM.
        cargarProductosEntrada();
        document.querySelectorAll('.tab').forEach(el =>
            el.addEventListener('click', () => setupTab(Number(el.dataset.tab))));
        $('week').addEventListener('change', () => {
            if (active === 1) { render(); return; }
            if (!$('week').value) {
                if (fechasOriginales) {
                    $('start').value = fechasOriginales.inicio;
                    $('end').value = fechasOriginales.fin;
                    semanasOriginales = null;
                    fechasOriginales = null;
                    consultarConEstado();
                }
                return;
            }
            if (!fechasOriginales) fechasOriginales = {
                inicio: $('start').value, fin: $('end').value
            };
            const [inicio, fin] = $('week').value.split('|');
            $('start').value = inicio;
            $('end').value = fin;
            consultarConEstado();
        });
        ['start', 'end'].forEach(id => $(id).addEventListener('change', () => {
            if (active === 1) render();
            else {
                borrarConsultaReal();
                $('estadoConsulta').textContent = 'Fechas cambiadas; presiona Consultar para actualizar la información.';
            }
        }));
        $('search').addEventListener('input', () => {
            if (active === 0) mostrarResumenGeneral(); else render();
        });
        $('movement').addEventListener('change', () => { if (active === 1) render(); });
        $('reset').addEventListener('click', () => {
            if (active === 1) {
                $('start').value=''; $('end').value=''; $('search').value='';
                $('movement').value='both'; $('week').value=''; updateWeek(); render();
            } else {
                $('start').value=''; $('end').value=''; $('search').value='';
                $('grupoProducto').value='TODOS';
                borrarConsultaReal();
                $('estadoConsulta').textContent = 'Filtros limpios. Sin fechas se consultarán los últimos 30 días.';
            }
        });
        $('download').addEventListener('click', () => {
            if (active === 0) exportarVisceras(); else exportarDemoDecomisos();
        });
        window.addEventListener('resize', () => {
            if (active === 0) { if (hayConsultaReal) mostrarGraficasReales(); }
            else render();
        });
        setupTab(0);
    })();
</script>
