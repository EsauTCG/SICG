        function cargarProductosEntrada() {

            const selector = document.getElementById("grupoProducto");
            const seleccionado = selector.value || "TODOS";

            const productos = new Map();

            // Catálogo conocido: disponible incluso sin consultar.
            catalogoSkuEntradas.forEach(sku => {
                productos.set(sku, sku);
            });

            // Completar nombres con los productos obtenidos de PyMeat.
            (datosReales.entradas || []).forEach(e => {
                if (e.sku) {
                    productos.set(e.sku, e.producto || e.sku);
                }
            });

            selector.replaceChildren();

            selector.add(new Option("TODOS LOS PRODUCTOS", "TODOS"));

            [...productos.entries()]
                .sort((a, b) => a[0].localeCompare(b[0]))
                .forEach(([sku, producto]) => {
                    const nombre = producto === sku
                        ? sku
                        : `${sku} - ${producto}`;

                    selector.add(new Option(nombre, sku));
                });

            selector.value = productos.has(seleccionado)
                ? seleccionado
                : "TODOS";
        }

        
        function mostrarResumenGeneral() {

            const tbody = document.getElementById("tbodyResumenGeneral");
            const contador = document.getElementById("contadorResumenGeneral");

            tbody.innerHTML = "";

            const entradas = datosReales.entradas || [];
            const salidas = datosReales.salidas || [];
            const advertencias = datosReales.advertencias || [];

            const entradasPorSolicitud = new Map();

            entradas.forEach(e => {
                if (!entradasPorSolicitud.has(e.solicitudProduccionId)) {
                    entradasPorSolicitud.set(e.solicitudProduccionId, new Set());
                }
                entradasPorSolicitud.get(e.solicitudProduccionId).add(e.sku);
            });

            const master = document.getElementByID("grupoProducto").value;

                const entradasVisibles = entradas.filter(e =>
                    master === "TODOS" || e.sku === master
                );

            const solicitudesParciales = new Set(
                advertencias.map(a => a.solicitudProduccionId)
            );

            const resumen = new Map();

            entradasVisibles.forEach(e => {

                if (!resumen.has(e.sku)) {
                    resumen.set(e.sku, {
                        sku: e.sku,
                        producto: e.producto || e.sku,
                        solicitudes: new Set(),
                        entrada: 0,
                        salida: 0,
                        revisar: false
                    });
                }

                const r = resumen.get(e.sku);

                r.solicitudes.add(e.solicitudProduccionId);
                r.entrada += Number(e.totalKg || 0);
            });

            resumen.forEach(r => {

                r.revisar = [...r.solicitudes].some(id =>
                    solicitudesParciales.has(id) ||
                    (entradasPorSolicitud.get(id)?.size || 0) > 1
                );

                    const solicitudesValidas = [...r.solicitudes]
                        .filter(id =>
                            (entradasPorSolicitud.get(id)?.size || 0) === 1
                        );

                    const salidaValidada = salidas
                        .filter(s =>
                            solicitudesValidas.includes(s.solicitudProduccionId)
                        )
                        .reduce((total, s) =>
                            total + Number(s.totalKg || 0), 0
                        );

                    r.salida = r.revisar ? null : salidaValidada;

            });

            const formatoKg = new Intl.NumberFormat("es-MX", {
                minimumFractionDigits: 3,
                maximumFractionDigits: 3
            });

            const formatoPorcentaje = new Intl.NumberFormat("es-MX", {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2,
                signDisplay: "exceptZero"
            });

            [...resumen.values()]
                .sort((a, b) => a.producto.localeCompare(b.producto))
                .forEach(r => {

                    const fila = tbody.insertRow();

                    let variacion = "—";

                    if (r.entrada > 0 && !r.revisar) {
                        variacion = formatoPorcentaje.format(
                            ((r.salida - r.entrada) / r.entrada) * 100
                        ) + "%";
                    } else if (r.revisar) {
                        variacion = "Por validar";
                    }

                    [
                        r.sku,
                        r.producto,
                        r.solicitudes.size,
                        formatoKg.format(r.entrada),
                        r.salida === null
                            ? "Por validar"
                            : formatoKg.format(r.salida),
                        variacion
                    ].forEach(valor => {
                        const celda = fila.insertCell();
                        celda.textContent = valor;
                    });

                    const celdaAccion = fila.insertCell();

                    const boton = document.createElement("button");
                    boton.type = "button";
                    boton.className = "secondary";
                    boton.textContent = "Ver detalle";

                    boton.addEventListener("click", () => {

                        document.getElementById("grupoProducto").value = r.sku;

                        actualizarVistaMaster();

                        document.getElementById("theadIndicadoresReal")
                            .scrollIntoView({
                                behavior: "smooth",
                                block: "center"
                            });
                    });

                    celdaAccion.appendChild(boton);
                });

            if (resumen.size === 0) {
                const fila = tbody.insertRow();
                const celda = fila.insertCell();
                celda.colSpan = 7;
                celda.textContent = "Sin productos para el periodo seleccionado.";
            }

            contador.textContent = `${resumen.size} SKU de entrada con actividad`;
        }

