        // Utilidades del reporte de Vísceras TIF
        const $ = id => document.getElementById(id);

        const fmt = (v, d = 2) =>
            Number(v).toLocaleString('es-MX', {
                minimumFractionDigits: d,
                maximumFractionDigits: d
            });


        function chart(canvas, type, labels, series, barLabels)
        {
            let c = $(canvas),
            dpr = window.devicePixelRatio || 1,
            rect = c.getBoundingClientRect(),
            W = Math.max(300, rect.width),
            H = Math.max(180, rect.height);
            c.width = W * dpr; c.height = H * dpr; let ctx = c.getContext('2d');
            ctx.scale(dpr, dpr); ctx.clearRect(0, 0, W, H);
            const left = 55,
                right = 12,
                top = 12,
                bottom = 34,
                max = Math.max(1, ...series.map(x => x.value || 0)) * 1.14;
                ctx.font = '11px Segoe UI';
                ctx.fillStyle = '#738091'; ctx.strokeStyle = '#e6e9ee'; ctx.lineWidth = 1;

                for (let i = 0; i <= 4; i++)
                {
                    let y = top + (H - top - bottom) * i / 4; ctx.beginPath();
                    ctx.moveTo(left, y); ctx.lineTo(W - right, y);
                    ctx.stroke();
                    ctx.fillText(fmt(max * (1 - i / 4), 0), 4, y + 4)
                }
                if (type === 'bar')
                {
                    let bw = (W - left - right) / Math.max(series.length, 1);
                    series.forEach((p, i) => { let bh = p.value / max * (H - top - bottom),
                        x = left + i * bw + bw * .18, y = H - bottom - bh;
                        ctx.fillStyle = ['#8b162a', '#c24d60', '#e19aa6', '#69525d', '#aa8690'][i % 5];
                        ctx.fillRect(x, y, bw * .64, bh);
                        ctx.save();
                        ctx.translate(x + 5, H - 15);
                        ctx.rotate(-.28);
                        ctx.fillStyle = '#5e6b7b';
                        ctx.fillText(p.label.slice(0, 14), 0, 0);
                        ctx.restore() })
                    }
                    else
                    {
                        let n = series.length;
                        ctx.strokeStyle = '#8b162a';
                        ctx.lineWidth = 2.5;
                        ctx.beginPath();
                        series.forEach((p, i) => { let x = left + (W - left - right) * (n === 1 ? .5 : i / (n - 1)),
                            y = H - bottom - (p.value / max) * (H - top - bottom); i ? ctx.lineTo(x, y) : ctx.moveTo(x, y) });
                            ctx.stroke(); series.forEach((p, i) => {
                                if (i % Math.max(1, Math.ceil(n / 14))) return;
                                let x = left + (W - left - right) * (n === 1 ? .5 : i / (n - 1)), y = H - bottom - (p.value / max) * (H - top - bottom); ctx.beginPath(); ctx.fillStyle = '#8b162a'; ctx.arc(x, y, 3, 0, 7); ctx.fill(); ctx.fillStyle = '#748092'; ctx.fillText(labels[i]?.slice(5) || '', x - 16, H - 12) }) } }

        window.chartRetrabajos = chart;

        
        // Un único flujo de actualización para los componentes reales de Vísceras.
        function actualizarVistaMaster() {
            mostrarResumenGeneral();
            mostrarDesgloseEntradas();
            mostrarIndicadoresGrupo();
            mostrarTarjetasReales();
            mostrarGraficasReales();
        }

        function fechaLocal(d) {
            const y = d.getFullYear(), m = String(d.getMonth() + 1).padStart(2, '0');
            return `${y}-${m}-${String(d.getDate()).padStart(2, '0')}`;
        }

        // Semanas con salidas en el resultado REAL; al elegir una, se vuelve a consultar
        // ese rango contra PyMeat para recalcular correctamente advertencias y entradas.
        function actualizarSemanasReales() {
            const combo = $('week');
            const previo = combo.value;
            combo.replaceChildren(new Option('Todas las semanas del periodo', ''));
            const semanas = new Map();
            (datosReales.salidas || []).forEach(s => {
                const f = String(s.fecha || '').substring(0, 10);
                if (!/^\d{4}-\d{2}-\d{2}$/.test(f)) return;
                const lunes = new Date(`${f}T12:00:00`);
                lunes.setDate(lunes.getDate() - ((lunes.getDay() + 6) % 7));
                const domingo = new Date(lunes);
                domingo.setDate(domingo.getDate() + 6);
                const desde = fechaLocal(lunes), hasta = fechaLocal(domingo);
                semanas.set(`${desde}|${hasta}`, `Semana ${desde} a ${hasta}`);
            });
            if (!semanasOriginales && hayConsultaReal) {
                semanasOriginales = new Map(semanas);
            }
            const disponibles = semanasOriginales || semanas;
            [...disponibles.entries()].sort((a, b) => a[0].localeCompare(b[0]))
                .forEach(([clave, texto]) => combo.add(new Option(texto, clave)));
            if (disponibles.has(previo)) combo.value = previo;
        }

        function borrarConsultaReal() {
            semanasOriginales = null;
            fechasOriginales = null;
            datosReales = { entradas: [], salidas: [], advertencias: [] };
            hayConsultaReal = false;
            actualizarSemanasReales();
            actualizarVistaMaster();
        }

        function exportarCSV(nombre, filas) {
            const texto = '\ufeff' + filas.map(fila => fila.map(v => {
                let valor = String(v ?? '');
                if (/^[=+\x40\t\r]/.test(valor)) valor = "'" + valor;
                return '"' + valor.replaceAll('"', '""') + '"';
            }).join(',')).join('\r\n');
            const url = URL.createObjectURL(new Blob([texto], {type:'text/csv;charset=utf-8'}));
            const link = document.createElement('a');
            link.href = url;
            link.download = nombre;
            link.click();
            setTimeout(() => URL.revokeObjectURL(url), 1000);
        }

        function exportarVisceras() {
            if (!hayConsultaReal) {
                $('estadoConsulta').textContent = 'Primero consulta PyMeat para exportar datos reales.';
                return;
            }
            const { entradas, salidas, advertencias } = obtenerDatosFiltradosMaster();
            const filas = [['Tipo', 'Fecha de salida', 'Solicitud', 'SKU', 'Producto', 'Etiquetas', 'Kilogramos', 'Observación']];
            entradas.forEach(e => filas.push([
                'ENTRADA', '', e.solicitudProduccionId, e.sku, e.producto,
                e.cantidadEtiquetas, e.totalKg, 'Entrada completa vinculada a solicitud'
            ]));
            salidas.forEach(e => filas.push([
                'SALIDA', String(e.fecha || '').substring(0,10), e.solicitudProduccionId,
                e.sku, e.producto, e.cantidadEtiquetas, e.totalKg, 'Salida del periodo consultado'
            ]));
            const idsConMultiples = new Set();
            const porSolicitud = new Map();
            (datosReales.entradas || []).forEach(e => {
                if (!porSolicitud.has(e.solicitudProduccionId)) porSolicitud.set(e.solicitudProduccionId, new Set());
                porSolicitud.get(e.solicitudProduccionId).add(e.sku);
            });
            entradas.forEach(e => {
                if ((porSolicitud.get(e.solicitudProduccionId)?.size || 0) > 1)
                    idsConMultiples.add(e.solicitudProduccionId);
            });
            const parcial = advertencias.length > 0 || idsConMultiples.size > 0;
            const kgEntrada = entradas.reduce((a,e)=>a+Number(e.totalKg||0),0);
            const kgSalida = salidas.reduce((a,e)=>a+Number(e.totalKg||0),0);
            const pct = kgEntrada > 0 && !parcial
                ? (((kgSalida-kgEntrada)/kgEntrada)*100).toFixed(2) + '%'
                : 'Por validar';
            filas.push(['RESUMEN','', '', $('grupoProducto').value,
                'Total entrada asociada', '', kgEntrada,
                `Salida del periodo: ${kgSalida.toFixed(3)} kg; variación: ${pct}`]);
            exportarCSV(`Visceras_TIF_${$('start').value}_${$('end').value}.csv`, filas);
        }
       
           // La vista está al final del HTML: los elementos ya existen en el DOM.
    cargarProductosEntrada();

    // Cambio de semana
    $('week').addEventListener('change', () => {
        if (!$('week').value) {
            if (fechasOriginales) {
                $('start').value = fechasOriginales.inicio;
                $('end').value = fechasOriginales.fin;
                semanasOriginales = null;
                fechasOriginales = null;
                consultarConEstado();
            }
            return;
        }

        if (!fechasOriginales) {
            fechasOriginales = {
                inicio: $('start').value,
                fin: $('end').value
            };
        }

        const [inicio, fin] = $('week').value.split('|');
        $('start').value = inicio;
        $('end').value = fin;
        consultarConEstado();
    });

    // Cambio manual de fechas
    ['start', 'end'].forEach(id => {
        $(id).addEventListener('change', () => {
            borrarConsultaReal();
            $('estadoConsulta').textContent =
                'Fechas cambiadas; presiona Consultar para actualizar la información.';
        });
    });

    // Búsqueda
    $('search').addEventListener('input', () => {
        mostrarResumenGeneral();
    });

    // Limpiar filtros
    $('reset').addEventListener('click', () => {
        $('start').value = '';
        $('end').value = '';
        $('search').value = '';
        $('grupoProducto').value = 'TODOS';
        $('week').value = '';

        borrarConsultaReal();

        $('estadoConsulta').textContent =
            'Filtros limpios. Sin fechas se consultarán los últimos 30 días.';
    });

    // Exportar información real
    $('download').addEventListener('click', exportarVisceras);

    // Redimensionar gráficas
    window.addEventListener('resize', () => {
        if (hayConsultaReal) {
            mostrarGraficasReales();
        }
    });

    // Inicialización del reporte de Vísceras TIF
    actualizarSemanasReales();
    actualizarVistaMaster();
    })();
</script>
