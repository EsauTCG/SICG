                    const boton = document.createElement("button");

                    boton.type = "button";
                    boton.className = "indicador-kg";
                    boton.textContent = formatoKg.format(g.kg);

                    boton.addEventListener("click", () => {
                        consultarDetalleCelda(g.fecha, g.sku);
