                encabezado.appendChild(th);
            });

            const salidas = datosReales.salidas || [];
            const grupos = new Map();

            salidas.forEach(s => {

                const fecha = s.fecha.substring(0, 10);
                const clave = `${fecha}|${s.sku}`;

                if (!grupos.has(clave)) {
                    grupos.set(clave, {
                        fecha,
                        sku: s.sku,
                        producto: s.producto,
                        solicitudes: new Set(),
                        etiquetas: 0,
                        kg: 0
                    });
                }

                const grupo = grupos.get(clave);

                grupo.solicitudes.add(s.solicitudProduccionId);
                grupo.etiquetas += Number(s.cantidadEtiquetas);
                grupo.kg += Number(s.totalKg);
            });

