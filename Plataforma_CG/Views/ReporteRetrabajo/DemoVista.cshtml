@{

    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Indicadores de Retrabajos TIF";
}

@* Vísceras TIF consulta PyMeat. Decomisos conserva únicamente datos de referencia del Excel.
   Validar permisos de SIGO y reglas de negocio antes de liberar. *@
<style>
    #retrabajos-demo {
        --wine: #820b1b;
        --ink: #20252d;
        --muted: #647185;
        --line: #e5e7ed;
        --bg: #f5f6f9
    }

        #retrabajos-demo * {
            box-sizing: border-box
        }

    #retrabajos-demo {
        margin: 0;
        background: var(--bg);
        font: 14px "Segoe UI", Arial, sans-serif;
        color: var(--ink)
    }

        #retrabajos-demo header {
            background: linear-gradient(110deg, #690b19, #9c1730);
            color: white;
            padding: 22px 32px
        }

            #retrabajos-demo header .brand {
                font-size: 12px;
                letter-spacing: 2px;
                font-weight: 700;
                opacity: .75
            }

            #retrabajos-demo header h1 {
                font-size: 24px;
                margin: 6px 0
            }

            #retrabajos-demo header p {
                opacity: .85;
                margin: 0
            }

        #retrabajos-demo .wrap {
            padding: 24px 28px;
            max-width: 1750px;
            margin: auto
        }

        #retrabajos-demo .notice {
            border: 1px solid #eac78c;
            background: #fff9eb;
            color: #79551d;
            padding: 12px 16px;
            border-radius: 9px;
            margin-bottom: 20px
        }

        #retrabajos-demo .tabs {
            display: flex;
            gap: 8px;
            border-bottom: 1px solid #ddd;
            margin-bottom: 18px
        }

        #retrabajos-demo .tab {
            border: none;
            background: transparent;
            padding: 13px 18px;
            font-weight: 650;
            color: #697281;
            cursor: pointer;
            border-bottom: 3px solid transparent
        }

            #retrabajos-demo .tab.active {
                color: var(--wine);
                border-color: var(--wine)
            }

        #retrabajos-demo .panel {
            background: white;
            border: 1px solid var(--line);
            border-radius: 12px;
            box-shadow: 0 2px 8px #14203608;
            margin-bottom: 18px;
            padding: 18px
        }

            #retrabajos-demo .panel h3 {
                margin: 0 0 14px;
                font-size: 16px
            }

        #retrabajos-demo .filters {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            align-items: end
        }

        #retrabajos-demo .field {
            min-width: 145px;
            flex: 1
        }

            #retrabajos-demo .field label {
                display: block;
                margin: 0 0 6px;
                color: #607080;
                font-size: 12px;
                font-weight: 650
            }

        #retrabajos-demo input,
        #retrabajos-demo select,
        #retrabajos-demo button {
            font: inherit
        }

        #retrabajos-demo input,
        #retrabajos-demo select {
            width: 100%;
            border: 1px solid #d9dce4;
            border-radius: 7px;
            padding: 10px;
            background: white
        }

        #retrabajos-demo button {
            cursor: pointer
        }

        #retrabajos-demo .primary {
            border: 0;
            border-radius: 7px;
            background: var(--wine);
            color: white;
            padding: 10px 17px
        }

        #retrabajos-demo .secondary {
            border: 1px solid #d9dce4;
            border-radius: 7px;
            background: #fff;
            padding: 10px 15px
        }

        #retrabajos-demo .stats {
            display: grid;
            grid-template-columns: repeat(4, minmax(140px, 1fr));
            gap: 14px;
            margin-bottom: 18px
        }

        #retrabajos-demo .stat {
            background: white;
            border: 1px solid var(--line);
            border-radius: 12px;
            padding: 18px
        }

            #retrabajos-demo .stat small {
                display: block;
                color: var(--muted);
                margin-bottom: 7px;
                font-weight: 650
            }

            #retrabajos-demo .stat strong {
                display: block;
                font-size: 25px;
                letter-spacing: -.8px
            }

            #retrabajos-demo .stat em {
                display: block;
                font-style: normal;
                color: #8a94a4;
                font-size: 11px;
                margin-top: 5px
            }

        #retrabajos-demo .charts {
            display: grid;
            grid-template-columns: 1.3fr 1fr;
            gap: 18px
        }

        #retrabajos-demo .chartbox {
            height: 235px;
            overflow: hidden
        }

        #retrabajos-demo canvas {
            width: 100%;
            height: 100%
        }

        #retrabajos-demo .tablebar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap
        }

            #retrabajos-demo .tablebar small {
                color: var(--muted)
            }

        #retrabajos-demo .scroll {
            overflow: auto;
            max-height: 560px;
            border: 1px solid var(--line);
            border-radius: 8px
        }

        #retrabajos-demo .data {
            border-collapse: separate;
            border-spacing: 0;
            font-size: 12px;
            min-width: max-content;
            width: 100%
        }

            #retrabajos-demo .data th {
                position: sticky;
                top: 0;
                background: #f0edf0;
                border-bottom: 1px solid #d9d8dc;
                padding: 11px 9px;
                min-width: 110px;
                max-width: 220px;
                text-align: left;
                z-index: 2;
                white-space: normal
            }

            #retrabajos-demo .data td {
                border-bottom: 1px solid #edf0f4;
                padding: 9px 10px;
                white-space: nowrap;
                text-align: right
            }

                #retrabajos-demo .data td:nth-child(1),
                #retrabajos-demo .data td:nth-child(2) {
                    text-align: left
                }

            #retrabajos-demo .data tbody tr:hover td {
                background: #fff6f7
            }

            #retrabajos-demo .data th:nth-child(1),
            #retrabajos-demo .data td:nth-child(1) {
                position: sticky;
                left: 0;
                z-index: 3;
                background: #fff
            }

            #retrabajos-demo .data th:nth-child(2),
            #retrabajos-demo .data td:nth-child(2) {
                position: sticky;
                left: 116px;
                z-index: 3;
                background: #fff
            }

            #retrabajos-demo .data th:nth-child(-n
            /**/
            +2) {
                background: #eee9eb;
                z-index: 5;
                min-width: 116px
            }

            #retrabajos-demo .data .pct {
                background: #f8f6f7;
                color: #7f2435;
                font-weight: 650
            }

            #retrabajos-demo .data .neg {
                color: #b4233c
            }

            #retrabajos-demo .data .pos {
                color: #19805c
            }

        #retrabajos-demo .code {
            display: block;
            color: #8b93a1;
            font-size: 10px;
            font-weight: 400;
            margin-top: 3px
        }

        #retrabajos-demo .foot {
            font-size: 12px;
            color: #697587;
            margin-top: 12px
        }

        #retrabajos-demo [hidden] {
            display: none !important;
        }

    @@media(max-width:850px) {
        #retrabajos-demo .stats {
            grid-template-columns: repeat(2, 1fr)
        }

        #retrabajos-demo .charts {
            grid-template-columns: 1fr
        }

        #retrabajos-demo .wrap {
            padding: 15px
        }

        #retrabajos-demo header {
            padding: 20px
        }

        #retrabajos-demo .stat strong {
            font-size: 20px
        }
    }

    @@media(max-width:500px) {
        #retrabajos-demo .stats {
            grid-template-columns: 1fr 1fr
        }

        #retrabajos-demo .field {
            flex-basis: 40%
        }
    }

    
    /* Indicadores interactivos del reporte */

    #retrabajos-demo #theadIndicadoresReal th {
        text-align: center;
        vertical-align: middle;
        padding: 14px 12px;
    }

    #retrabajos-demo #tbodySalidasReal td {
        text-align: center;
        vertical-align: middle;
        padding: 12px;
    }

    #retrabajos-demo .indicador-kg {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 110px;
        padding: 9px 14px;
        border: 1px solid #e0c1c7;
        border-radius: 9px;
        background: #fff7f8;
        color: #820b1b;
        font-size: 0.92rem;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        #retrabajos-demo .indicador-kg:hover {
            background: #820b1b;
            border-color: #820b1b;
            color: white;
            box-shadow: 0 4px 12px rgba(130, 11, 27, 0.2);
            transform: translateY(-2px);
        }

        #retrabajos-demo .indicador-kg:focus-visible {
            outline: 2px solid #820b1b;
            outline-offset: 3px;
        }

    #retrabajos-demo .total-kg {
        font-weight: 800;
        color: #820b1b;
        font-variant-numeric: tabular-nums;
        background: #fff1f3;
    }


    /* Columnas de entrada - diseño tipo Excel */

    #retrabajos-demo .columna-entrada {
        background: #eaf6ee !important;
        color: #176b42 !important;
        font-weight: 700;
        text-align: center;
        border-left: 2px solid #82c49b;
        border-right: 2px solid #82c49b;
    }

    #retrabajos-demo .fila-total-indicadores td {
        font-weight: 700;
        background: #f5f0f1;
        border-top: 2px solid #820b1b;
    }

    #retrabajos-demo .fila-total-indicadores .columna-entrada {
        background: #d9f0e1 !important;
    }

    /* Diseño del desglose de entradas TIF */

    #retrabajos-demo .tabla-entradas {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        font-variant-numeric: tabular-nums;
    }

    /* Encabezados */
    #retrabajos-demo .tabla-entradas thead th {
        text-align: center;
        vertical-align: middle;
        padding: 14px 16px;
        background: #f3f0f1;
        color: #5c2330;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    /* Celdas de datos */
    #retrabajos-demo .tabla-entradas tbody td {
        text-align: center !important;
        vertical-align: middle;
        padding: 12px 16px;
        font-size: 12px;
        white-space: nowrap;
    }

    /* Alinear específicamente encabezados y datos */
    #retrabajos-demo .tabla-entradas th:nth-child(1),
    #retrabajos-demo .tabla-entradas td:nth-child(1) {
        min-width: 135px;
    }

    #retrabajos-demo .tabla-entradas th:nth-child(2),
    #retrabajos-demo .tabla-entradas td:nth-child(2) {
        min-width: 110px;
    }

    #retrabajos-demo .tabla-entradas th:nth-child(3),
    #retrabajos-demo .tabla-entradas td:nth-child(3) {
        min-width: 205px;
    }

    #retrabajos-demo .tabla-entradas th:nth-child(4),
    #retrabajos-demo .tabla-entradas td:nth-child(4) {
        min-width: 115px;
    }

    #retrabajos-demo .tabla-entradas th:nth-child(5),
    #retrabajos-demo .tabla-entradas td:nth-child(5) {
        min-width: 200px;
    }

    /* Kilogramos: alineados a la derecha */
    #retrabajos-demo .tabla-entradas th:nth-child(6),
    #retrabajos-demo .tabla-entradas td:nth-child(6) {
        min-width: 145px;
        text-align: right !important;
        font-weight: 700;
    }

    /* Resaltar el total */
    #retrabajos-demo .tabla-entradas tfoot th {
        padding: 14px 16px;
        background: #f5ebee;
        color: #820b1b;
        font-weight: 800;
        border-top: 2px solid #820b1b;
    }

    #retrabajos-demo .tabla-entradas tfoot th:last-child {
        text-align: right !important;
    }

   /* Mantener los encabezados visibles al hacer scroll vertical */

    #retrabajos-demo .tabla-entradas thead th {
        position: sticky !important;
        top: 0;
        z-index: 5;
        background: #f3f0f1;
    }

    /* Evitar columnas fijas en el cuerpo de esta tabla */

    #retrabajos-demo .tabla-entradas tbody td:nth-child(1),
    #retrabajos-demo .tabla-entradas tbody td:nth-child(2) {
        position: static !important;
        left: auto !important;
    }

    /* Mantener el encabezado alineado con el cuerpo */

    #retrabajos-demo .tabla-entradas thead th:nth-child(1),
    #retrabajos-demo .tabla-entradas thead th:nth-child(2) {
        left: auto !important;
    }

    /* Resumen general de Vísceras TIF */

    #retrabajos-demo .tabla-resumen {
        width: 100%;
        font-variant-numeric: tabular-nums;
    }

    #retrabajos-demo .tabla-resumen thead th {
        text-align: center;
        vertical-align: middle;
        padding: 14px 16px;
        background: #f3f0f1;
        color: #5c2330;
        font-weight: 700;
        white-space: nowrap;
    }

    #retrabajos-demo .tabla-resumen tbody td {
        text-align: center !important;
        vertical-align: middle;
        padding: 12px 16px;
        white-space: nowrap;
    }

    #retrabajos-demo .tabla-resumen th:nth-child(2),
    #retrabajos-demo .tabla-resumen td:nth-child(2) {
        min-width: 190px;
    }

    #retrabajos-demo .tabla-resumen th:nth-child(4),
    #retrabajos-demo .tabla-resumen th:nth-child(5),
    #retrabajos-demo .tabla-resumen td:nth-child(4),
    #retrabajos-demo .tabla-resumen td:nth-child(5) {
        text-align: right !important;
        min-width: 135px;
    }

    #retrabajos-demo .tabla-resumen tbody td:nth-child(6) {
        font-weight: 700;
        color: #820b1b;
    }

    #retrabajos-demo .tabla-resumen tbody tr:hover td {
        background: #fff6f7;
    }

    /* Vista de salidas: TODOS LOS PRODUCTOS */

    #retrabajos-demo .tabla-salidas-todos {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        font-variant-numeric: tabular-nums;
    }

    /* Encabezados */
    #retrabajos-demo .tabla-salidas-todos thead th {
        position: sticky !important;
        top: 0;
        z-index: 5;
        padding: 14px 18px;
        background: #f3f0f1;
        color: #5c2330;
        font-size: 12px;
        font-weight: 700;
        text-align: center;
        vertical-align: middle;
        white-space: nowrap;
    }

    /* Cuerpo */
    #retrabajos-demo .tabla-salidas-todos tbody td {
        position: static !important;
        left: auto !important;
        padding: 12px 18px;
        font-size: 13px;
        vertical-align: middle;
        text-align: center;
        border-bottom: 1px solid #eee7e9;
    }

    /* Asegurar que los primeros encabezados no se desplacen diferente */
    #retrabajos-demo .tabla-salidas-todos thead th:nth-child(1),
    #retrabajos-demo .tabla-salidas-todos thead th:nth-child(2) {
        left: auto !important;
    }

    /* Fecha */
    #retrabajos-demo .tabla-salidas-todos th:nth-child(1),
    #retrabajos-demo .tabla-salidas-todos td:nth-child(1) {
        min-width: 135px;
    }

    /* SKU */
    #retrabajos-demo .tabla-salidas-todos td:nth-child(2) {
        font-weight: 700;
        color: #820b1b;
    }

    /* Producto: alineado a la izquierda */
    #retrabajos-demo .tabla-salidas-todos th:nth-child(3),
    #retrabajos-demo .tabla-salidas-todos td:nth-child(3) {
        text-align: left !important;
        min-width: 250px;
    }

    /* Columnas numéricas */
    #retrabajos-demo .tabla-salidas-todos th:nth-child(4),
    #retrabajos-demo .tabla-salidas-todos th:nth-child(5),
    #retrabajos-demo .tabla-salidas-todos th:nth-child(6),
    #retrabajos-demo .tabla-salidas-todos td:nth-child(4),
    #retrabajos-demo .tabla-salidas-todos td:nth-child(5),
    #retrabajos-demo .tabla-salidas-todos td:nth-child(6) {
        text-align: right !important;
        min-width: 115px;
    }

    /* Kilogramos */
    #retrabajos-demo .tabla-salidas-todos td:nth-child(6) {
        font-weight: 700;
    }

    /* Filas alternadas */
    #retrabajos-demo .tabla-salidas-todos tbody tr:nth-child(even) td {
        background: #faf8f9;
    }

    /* Resaltar la fila al pasar el cursor */
    #retrabajos-demo .tabla-salidas-todos tbody tr:hover td {
        background: #f5ebee;
    }

    /* Indicadores horizontales: TODOS LOS PRODUCTOS */

#retrabajos-demo .tabla-salidas-horizontal {
    width: max-content;
    min-width: 100%;
    border-collapse: separate;
    border-spacing: 0;
    font-variant-numeric: tabular-nums;
}

/* Encabezados fijos */
#retrabajos-demo .tabla-salidas-horizontal thead th {
    position: sticky !important;
    top: 0;
    z-index: 5;
    background: #f3f0f1;
    color: #5c2330;
    text-align: center !important;
    vertical-align: middle;
    padding: 12px 16px;
    min-width: 145px;
    border-bottom: 2px solid #ded1d5;
}

/* Código y descripción del producto */
#retrabajos-demo .tabla-salidas-horizontal
.encabezado-sku-horizontal strong {
    display: block;
    font-size: 12px;
    margin-bottom: 5px;
}

#retrabajos-demo .tabla-salidas-horizontal
.encabezado-sku-horizontal span {
    display: block;
    font-size: 11px;
    font-weight: 500;
    white-space: normal;
    line-height: 1.4;
    max-width: 160px;
    margin: auto;
}

/* Cuerpo */
#retrabajos-demo .tabla-salidas-horizontal tbody td {
    position: static !important;
    text-align: center !important;
    vertical-align: middle;
    padding: 11px 14px;
    white-space: nowrap;
    border-bottom: 1px solid #eee7e9;
}

/* Primera columna: fecha siempre visible */
#retrabajos-demo .tabla-salidas-horizontal
thead th:first-child {
    position: sticky !important;
    left: 0 !important;
    z-index: 8;
    min-width: 135px;
}

#retrabajos-demo .tabla-salidas-horizontal
tbody td:first-child {
    position: sticky !important;
    left: 0 !important;
    z-index: 3;
    background: #ffffff;
    font-weight: 700;
    min-width: 135px;
}

/* Filas alternadas */
#retrabajos-demo .tabla-salidas-horizontal
tbody tr:nth-child(even) td {
    background: #faf8f9;
}

/* Resaltar fila */
#retrabajos-demo .tabla-salidas-horizontal
tbody tr:hover td {
    background: #f5ebee;
}

/* Celdas sin actividad */
#retrabajos-demo .tabla-salidas-horizontal
.celda-vacia-horizontal {
    color: #b8b1b5;
}

/* Total de salida por día */
#retrabajos-demo .tabla-salidas-horizontal
.columna-total-horizontal {
    background: #f5ebee !important;
    color: #820b1b;
    font-weight: 800;
    min-width: 155px;
}

/* Totales finales */
#retrabajos-demo .tabla-salidas-horizontal
.fila-total-horizontal td {
    background: #f0e3e7 !important;
    color: #820b1b;
    font-weight: 800;
    border-top: 2px solid #820b1b;
}
</style>
<div id="retrabajos-demo">
    <header>
        <div class="brand">SIGO / REPORTES OPERATIVOS</div>
        <h1>Indicadores de Retrabajos · TIF</h1>
        <p>Consulta de entradas, salidas y etiquetas desde PyMeat</p>
    </header>
    <main class="wrap">
        <div class="notice" id="estadoModulo">
            Vísceras TIF consulta PyMeat. Sin fechas se consultarán los últimos 30 días al presionar Consultar.
            Decomisos permanece como referencia del Excel hasta validar sus reglas.
        </div>
        <nav class="tabs">
            <button class="tab active" data-tab="0">Vísceras TIF</button><button class="tab"
                                                                             data-tab="1">
            Decomisos Vísceras TIF
        </button>
    </nav>
    <section class="panel">
        <h3>Filtros del reporte</h3>
        <div class="filters">
            <div class="field" id="campoSemana">
                <label>Semana</label><select id="week">
                <option value="">Todas las semanas</option>
            </select>
        </div>
        <div class="field"><label>Fecha inicial</label><input type="date" id="start"></div>
        <div class="field"><label>Fecha final</label><input type="date" id="end"></div>

        <div class="field" id="campoMaster">
            <label for="grupoProducto">Master · SKU de entrada</label>
            <select id="grupoProducto">
                <option value="TODOS">TODOS LOS PRODUCTOS</option>
            </select>
        </div>

        <div class="field" id="campoMovimiento" hidden>
            <label>Movimiento (solo demo Decomisos)</label><select id="movement">
            <option value="both">Ambos</option>
            <option value="in">Entrada</option>
            <option value="out">Salida</option>
        </select>
    </div>
    <div class="field">
        <label id="labelBusqueda" for="search">Buscar SKU o producto de entrada (resumen)</label>
        <input id="search" placeholder="Ej. Y072, CORAZON">
    </div>
    <button class="primary" id="consultarReal" type="button">
        Consultar PyMeat
    </button>

    <button class="secondary" id="reset" type="button">Limpiar</button>
    <button class="secondary" id="download" type="button">Exportar CSV</button>
</div>
<div class="foot" id="estadoConsulta" role="status" aria-live="polite">
    Sin consulta. El Master se carga desde el inicio; selecciona un periodo y presiona Consultar.
</div>
</section>
