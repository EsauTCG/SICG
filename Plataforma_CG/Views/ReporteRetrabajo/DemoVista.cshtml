                                let x = left + (W - left - right) * (n === 1 ? .5 : i / (n - 1)), y = H - bottom - (p.value / max) * (H - top - bottom); ctx.beginPath(); ctx.fillStyle = '#8b162a'; ctx.arc(x, y, 3, 0, 7); ctx.fill(); ctx.fillStyle = '#748092'; ctx.fillText(labels[i]?.slice(5) || '', x - 16, H - 12) }) } }

        window.chartRetrabajos = chart;

        function drawCharts(rows, s) { let idx = active === 0 ? 2 : 10, series = rows.filter(r => r.date).map(r => ({ label: r.date, value: numeric(r, idx) })); $('charttitle').textContent = active === 0 ? 'Kg MPC-Cabeza Res por fecha' : 'Decomiso de cabezas por fecha (kg)'; chart('line', 'line', series.map(x => x.label), series); let targets = active === 0 ? [2, 3, 17, 18, 22, 23] : [10, 14, 16, 18, 20, 26]; let bars = targets.map(i => ({ label: s.head[i].replace(/^MPC-|^G-|^DECOMISO /, '').slice(0, 14), value: rows.reduce((a, r) => a + numeric(r, i), 0) })); chart('bars', 'bar', [], bars) }
        
        function setupTab(i) { active = i; document.querySelectorAll('.tab').forEach((t, j) => t.classList.toggle('active', j === i)); $('start').value = ''; $('end').value = ''; $('search').value = ''; $('movement').value = 'both'; $('week').value = ''; updateWeek(); render() }
        document.querySelectorAll('.tab').forEach(el => el.addEventListener('click', () => setupTab(Number(el.dataset.tab))));['week', 'start', 'end', 'movement', 'search'].forEach(id => $(id).addEventListener('input', render)); $('reset').onclick = () => setupTab(active); window.addEventListener('resize', render); $('download').onclick = () => { let s = sheets[active], rows = filterRows(), cols = columns(), cs = [cols.map(i => s.head[i])].concat(rows.map(r => cols.map(i => i === 1 ? r.date : i === 0 ? r.week : r.v[i] ?? ''))); let text = '\ufeff' + cs.map(row => row.map(x => '"' + String(x).replaceAll('"', '""') + '"').join(',')).join('\r\n'); let b = new Blob([text], { type: 'text/csv;charset=utf-8' }), a = document.createElement('a'); a.href = URL.createObjectURL(b); a.download = (active === 0 ? 'visceras' : 'decomisos') + '_demo.csv'; a.click(); URL.revokeObjectURL(a.href) }; setupTab(0);

    })();

