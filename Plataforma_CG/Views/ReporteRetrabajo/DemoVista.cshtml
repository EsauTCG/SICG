<script>
    (() => {

        const API_REPORTE = '@Url.Action("ConsultarReporteVisceras", "Retrabajos")';
        const API_DETALLE = '@Url.Action("ConsultarDetalle", "Retrabajos")';

        let datosReales = {
            entradas: [],
            salidas: [],
            advertencias: []
        };

        
        const gruposProductos = {
            HIGADO: {
                nombre: "Hígado Res",
                entrada: ["Y095"],
                salidas: [
                    { sku: "S004", nombre: "G-Hígado Res" },
                    { sku: "S114", nombre: "Hígado rebanado 0.5 kg" },
                    { sku: "S117", nombre: "Hígado rebanado 1 kg vacío" }
                ]
            }
        };

        document.getElementById("grupoProducto")
            .addEventListener("change", function () {
                actualizarVistaMaster();
            });

        function resolverFechasReporte(fechaInicio, fechaFin){
             const formatoFecha = fecha => {
                const año = fecha.getFullYear();
                const mes = String(fecha.getMonth() + 1).padStart(2, "0");
                const dia = String(fecha.getDate()).padStart(2, "0");

                return `${año}-${mes}-${dia}`;
            };

            const hoy = formatoFecha(new Date());

            if (!fechaInicio && !fechaFin) {
                fechaFin = hoy;
            }

            if (!fechaFin) {
                fechaFin = hoy;
            }

            if (!fechaInicio) {
                const fecha = new Date(`${fechaFin}T12:00:00`);
                fecha.setDate(fecha.getDate() - 29);

                fechaInicio = formatoFecha(fecha);
            }

            if (fechaInicio > fechaFin) {
                throw new Error(
                    "La fecha inicial no puede ser posterior a la fecha final."
                );
            }

            return { fechaInicio, fechaFin };
        }


        async function consultarReporteReal(fechaInicio, fechaFin, skuEntrada = null){

            const fechas = resolverFechasReporte(fechaInicio, fechaFin);

            fechaInicio = fechas.fechaInicio;
            fechaFin = fechas.fechaFin;

            document.getElementById("start").value = fechaInicio;
            document.getElementById("end").value = fechaFin;

            const parametros = new URLSearchParams({
                fechaInicio,
                fechaFin
            });

             if (skuEntrada && skuEntrada !== "TODOS") {
                parametros.append("skuEntrada", skuEntrada);
            }

            const respuesta = await fetch(`${API_REPORTE}?${parametros}`);

             if (!respuesta.ok) {
                    throw new Error(`Error HTTP ${respuesta.status}`);
                }

                const resultado = await respuesta.json();

                if (!resultado.success) {
                    throw new Error("No se pudo consultar el reporte.");
                }

                datosReales = resultado.data;
             
                hayConsultaReal = true;

                cargarProductosEntrada();
                actualizarVistaMaster();

                return datosReales;
        }


        function mostrarGraficasReales() {

           const { salidas } = obtenerDatosFiltradosMaster();

            const porFecha = new Map();
            const porSku = new Map();

            salidas.forEach(s => {

                const fecha = String(s.fecha || "").substring(0, 10);
                const sku = s.sku || "SIN SKU";
                const kg = Number(s.totalKg || 0);

                porFecha.set(
                    fecha,
                    (porFecha.get(fecha) || 0) + kg
                );

                porSku.set(
                    sku,
                    (porSku.get(sku) || 0) + kg
                );
            });

            const serieFechas = [...porFecha.entries()]
                .sort((a, b) => a[0].localeCompare(b[0]))
                .map(([fecha, kg]) => ({
                    label: fecha,
                    value: kg
                }));

            const serieSku = [...porSku.entries()]
                .sort((a, b) => b[1] - a[1])
                .slice(0, 10)
                .map(([sku, kg]) => ({
                    label: sku,
                    value: kg
                }));

            document.getElementById("charttitle").textContent =
                "Evolución diaria de salidas (kg)";
            document.getElementById("notaGraficaEvolucion").textContent =
                "Salidas por fecha de producción del periodo consultado (PyMeat).";
            document.getElementById("notaGraficaSku").textContent =
                "Kilogramos por SKU de salida de las solicitudes seleccionadas.";

            window.chartRetrabajos(
                "line",
                "line",
                serieFechas.map(x => x.label),
                serieFechas
            );

             window.chartRetrabajos(
                "bars",
                "bar",
                [],
                serieSku
            );
        }

        function mostrarTarjetasReales() {
            if (!hayConsultaReal) {
                document.getElementById("stats").innerHTML = '';
                return;
            }

            const {
                entradas,
                salidas,
                advertencias
            } = obtenerDatosFiltradosMaster();

            const totalEntrada = entradas.reduce(
                (suma, e) => suma + Number(e.totalKg || 0), 0
            );

            const totalSalida = salidas.reduce(
                (suma, s) => suma + Number(s.totalKg || 0), 0
            );

            const solicitudes = new Set([
                ...entradas.map(e => e.solicitudProduccionId),
                ...salidas.map(s => s.solicitudProduccionId)
            ]);

            const etiquetasSalida = salidas.reduce(
                (suma, s) => suma + Number(s.cantidadEtiquetas || 0), 0
            );

            const solicitudesAdvertencia = new Set(
                advertencias.map(a => a.solicitudProduccionId)
            );

            const formato = valor =>
                new Intl.NumberFormat("es-MX", {
                    maximumFractionDigits: 3
                }).format(valor);

            const tarjetas = [
                {
                    titulo: "Entrada asociada",
                    valor: formato(totalEntrada),
                    unidad: "kg de entradas vinculadas"
                },
                {
                    titulo: "Salida del periodo",
                    valor: formato(totalSalida),
                    unidad: "kg de salida asociada a solicitudes"
                },
                {
                    titulo: "Solicitudes",
                    valor: formato(solicitudes.size),
                    unidad: "Con actividad"
                },
                {
                    titulo: "Etiquetas de salida",
                    valor: formato(etiquetasSalida),
                    unidad: "Etiquetas registradas"
                },
                {
                    titulo: "Advertencias",
                    valor: formato(solicitudesAdvertencia.size),
                    unidad: "Solicitudes con salidas fuera del periodo"
                }
            ];

            document.getElementById("stats").innerHTML =
                tarjetas.map(t => `
                    <div class="stat">
                        <small>${t.titulo}</small>
                        <strong>${t.valor}</strong>
                        <em>${t.unidad}</em>
                    </div>
                `).join("");
        }


        
        const catalogoSkuEntradas = [
            "Y056", "Y059", "Y061", "Y066",
            "Y072", "Y092", "Y093", "Y094",
            "Y095", "Y096", "Y097", "Y098",
            "Y099", "Y101", "Y102", "Y103",
            "Y104", "Y112", "Y113"
        ];

        function cargarProductosEntrada() {

            const selector = document.getElementById("grupoProducto");
            const seleccionado = selector.value || "TODOS";

            const nombresConocidos = {
                Y056:"MPC-CABEZA RES", Y059:"MPC-BOFE NOV", Y061:"MPC-VIRIL NOV",
                Y066:"MPC-COLA RES", Y072:"MPC-CORAZON NOV", Y092:"MPC-LIBRO RES",
                Y093:"MPC-TRIPA GRUESAS RES", Y094:"MPC-LENGUA RES",
                Y095:"MPC-HIGADO RES", Y096:"MPC-TRIPA DELGADA RES",
                Y097:"MPC-MOLLEJA RES", Y098:"MPC-MEDULA RES", Y099:"MPC-CUAJO RES",
                Y101:"MPC-PATAS RES", Y102:"MPC-MENUDO RES", Y103:"MPC-RECTO RES",
                Y104:"MPC-TRAQUEA RES", Y112:"MPC-PLACENTA", Y113:"MPC-ESOFAGO"
            };
            const productos = new Map();
            catalogoSkuEntradas.forEach(sku => {
                productos.set(sku, nombresConocidos[sku] || sku);
            });

            // Completar nombres con los productos obtenidos de PyMeat.
            (datosReales.entradas || []).forEach(e => {
                if (e.sku) {
                    productos.set(e.sku, e.producto || e.sku);
                }
            });

            selector.replaceChildren();

            selector.add(new Option("TODOS LOS PRODUCTOS", "TODOS"));

            [...productos.entries()]
                .sort((a, b) => a[0].localeCompare(b[0]))
                .forEach(([sku, producto]) => {
                    const nombre = producto === sku
                        ? sku
                        : `${sku} - ${producto}`;

                    selector.add(new Option(nombre, sku));
                });

            selector.value = productos.has(seleccionado)
                ? seleccionado
                : "TODOS";
        }

        
        function mostrarResumenGeneral() {

            const tbody = document.getElementById("tbodyResumenGeneral");
            const contador = document.getElementById("contadorResumenGeneral");

            tbody.innerHTML = "";

            const entradas = datosReales.entradas || [];
            const salidas = datosReales.salidas || [];
            const advertencias = datosReales.advertencias || [];

            const entradasPorSolicitud = new Map();

            entradas.forEach(e => {
                if (!entradasPorSolicitud.has(e.solicitudProduccionId)) {
                    entradasPorSolicitud.set(e.solicitudProduccionId, new Set());
                }
                entradasPorSolicitud.get(e.solicitudProduccionId).add(e.sku);
            });

            const master = document.getElementById("grupoProducto").value;

                const entradasVisibles = entradas.filter(e =>
                    master === "TODOS" || e.sku === master
                );

            const solicitudesParciales = new Set(
                advertencias.map(a => a.solicitudProduccionId)
            );

            const resumen = new Map();

            entradasVisibles.forEach(e => {

                if (!resumen.has(e.sku)) {
                    resumen.set(e.sku, {
                        sku: e.sku,
                        producto: e.producto || e.sku,
                        solicitudes: new Set(),
                        entrada: 0,
                        salida: 0,
                        revisar: false
                    });
                }

                const r = resumen.get(e.sku);

                r.solicitudes.add(e.solicitudProduccionId);
                r.entrada += Number(e.totalKg || 0);
            });

            resumen.forEach(r => {

                r.revisar = [...r.solicitudes].some(id =>
                    solicitudesParciales.has(id) ||
                    (entradasPorSolicitud.get(id)?.size || 0) > 1
                );

                    const solicitudesValidas = [...r.solicitudes]
                        .filter(id =>
                            (entradasPorSolicitud.get(id)?.size || 0) === 1
                        );

                    const salidaValidada = salidas
                        .filter(s =>
                            solicitudesValidas.includes(s.solicitudProduccionId)
                        )
                        .reduce((total, s) =>
                            total + Number(s.totalKg || 0), 0
                        );

                    r.salida = r.revisar ? null : salidaValidada;

            });

            const formatoKg = new Intl.NumberFormat("es-MX", {
                minimumFractionDigits: 3,
                maximumFractionDigits: 3
            });

            const formatoPorcentaje = new Intl.NumberFormat("es-MX", {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2,
                signDisplay: "exceptZero"
            });

            const busqueda = document.getElementById("search")
                .value.trim().toLocaleLowerCase("es-MX");

            const resultadosVisibles = [...resumen.values()]
                .filter(r => !busqueda ||
                    `${r.sku} ${r.producto}`.toLocaleLowerCase("es-MX").includes(busqueda))
                .sort((a, b) => a.producto.localeCompare(b.producto));

            resultadosVisibles.forEach(r => {

                    const fila = tbody.insertRow();

                    let variacion = "—";

                    if (r.entrada > 0 && !r.revisar) {
                        variacion = formatoPorcentaje.format(
                            ((r.salida - r.entrada) / r.entrada) * 100
                        ) + "%";
                    } else if (r.revisar) {
                        variacion = "Por validar";
                    }

                    [
                        r.sku,
                        r.producto,
                        r.solicitudes.size,
                        formatoKg.format(r.entrada),
                        r.salida === null
                            ? "Por validar"
                            : formatoKg.format(r.salida),
                        variacion
                    ].forEach(valor => {
                        const celda = fila.insertCell();
                        celda.textContent = valor;
                    });

                    const celdaAccion = fila.insertCell();

                    const boton = document.createElement("button");
                    boton.type = "button";
                    boton.className = "secondary";
                    boton.textContent = "Ver detalle";

                    boton.addEventListener("click", () => {

                        document.getElementById("grupoProducto").value = r.sku;

                        actualizarVistaMaster();

                        document.getElementById("theadIndicadoresReal")
                            .scrollIntoView({
                                behavior: "smooth",
                                block: "center"
                            });
                    });

                    celdaAccion.appendChild(boton);
                });

            if (resultadosVisibles.length === 0) {
                const fila = tbody.insertRow();
                const celda = fila.insertCell();
                celda.colSpan = 7;
                celda.textContent = hayConsultaReal
                    ? "Sin productos para el periodo seleccionado."
                    : "Consulta un periodo para mostrar los productos.";
            }

            contador.textContent = 
                `${resultadosVisibles.length} de ${resumen.size} SKU de entrada con actividad`;
        }

            function mostrarDesgloseEntradas() {

        const tbody = document.getElementById("tbodyEntradasReal");
        const contador = document.getElementById("contadorEntradasReal");
        const totalElemento = document.getElementById("totalEntradasDesglose");

        tbody.innerHTML = "";

        const master = document.getElementById("grupoProducto").value;

        const entradas = (datosReales.entradas || [])
            .filter(e =>
                master === "TODOS" || e.sku === master
            )
            .sort((a, b) =>
                String(a.fechaEntrada || "").localeCompare(
                    String(b.fechaEntrada || "")
                ) ||
                a.sku.localeCompare(b.sku) ||
                Number(a.solicitudProduccionId) -
                Number(b.solicitudProduccionId)
            );

        const formatoKg = new Intl.NumberFormat("es-MX", {
            minimumFractionDigits: 3,
            maximumFractionDigits: 3
        });

        const formatoNumero = new Intl.NumberFormat("es-MX");

        let totalKg = 0;
        let totalEtiquetas = 0;

        entradas.forEach(e => {

            const fila = tbody.insertRow();

            const kg = Number(e.totalKg || 0);
            const etiquetas = 1;

            totalKg += kg;
            totalEtiquetas += etiquetas;

            [
                e.fechaEntrada
                    ? String(e.fechaEntrada).substring(0, 10)
                    : "-",
                e.solicitudProduccionId,
                e.codigoEtiqueta,
                e.sku,
                e.producto || e.sku,
                formatoKg.format(kg)
            ].forEach(valor => {
                const celda = fila.insertCell();
                celda.textContent = valor;
            });
        });

        if (entradas.length === 0) {
            const fila = tbody.insertRow();
            const celda = fila.insertCell();

            celda.colSpan = 6;
            celda.textContent = hayConsultaReal
                ? "Sin entradas para mostrar en el periodo."
                : "Consulta un periodo para ver el desglose de entradas.";
        }

        totalElemento.textContent = formatoKg.format(totalKg);

        contador.textContent =
            `${entradas.length} ${entradas.length === 1 ? "registro agrupado" : "registros agrupados"} · ` +
            `${formatoNumero.format(totalEtiquetas)} etiquetas`;
    }

        function obtenerDatosFiltradosMaster() {

        const master = document.getElementById("grupoProducto").value;

        const entradasCompletas = datosReales.entradas || [];
        const salidasCompletas = datosReales.salidas || [];
        const advertenciasCompletas = datosReales.advertencias || [];

        if (master === "TODOS") {
            return {
                entradas: entradasCompletas,
                salidas: salidasCompletas,
                advertencias: advertenciasCompletas
            };
        }

        const entradas = entradasCompletas.filter(e => e.sku === master);

        const solicitudes = new Set(
            entradas.map(e => e.solicitudProduccionId)
        );

        return {
            entradas,
            salidas: salidasCompletas.filter(s =>
                solicitudes.has(s.solicitudProduccionId)
            ),
            advertencias: advertenciasCompletas.filter(a =>
                solicitudes.has(a.solicitudProduccionId)
            )
        };
    }

        
        function mostrarSalidasReales() {

            const tbody = document.getElementById("tbodySalidasReal");
            const contador = document.getElementById("totalSalidasReal");

            tbody.innerHTML = "";

            const salidas = datosReales.salidas || [];

            if (salidas.length === 0) {
                const fila = tbody.insertRow();
                const celda = fila.insertCell();
                celda.colSpan = 6;
                celda.textContent = "No se encontraron salidas.";
                contador.textContent = "0 registros";
                return;
            }

            const formatoKg = new Intl.NumberFormat("es-MX", {
                minimumFractionDigits: 3,
                maximumFractionDigits: 3
            });

            salidas.forEach(salida => {

                const fila = tbody.insertRow();

                const valores = [
                    salida.fecha.substring(0, 10),
                    salida.solicitudProduccionId,
                    salida.sku,
                    salida.producto,
                    salida.cantidadEtiquetas,
                    formatoKg.format(salida.totalKg)
                ];

                valores.forEach(valor => {
                    const celda = fila.insertCell();
                    celda.textContent = valor ?? "";
                });

                const celdaDetalle = fila.insertCell();

                const boton = document.createElement("button");
                boton.type = "button";
                boton.className = "secondary";
                boton.textContent = "Ver detalle";

                boton.addEventListener("click", () => {
                    consultarDetalleSalida(salida);
                });

                celdaDetalle.appendChild(boton);
            });

            contador.textContent = `${salidas.length} registros`;
        }

        
        
        function mostrarIndicadoresGrupo() {

            const skuEntrada = document.getElementById("grupoProducto").value;

            if (skuEntrada === "TODOS") {
                mostrarTodosLosProductos();
                return;
            }

            const thead = document.getElementById("theadIndicadoresReal");
            const tbody = document.getElementById("tbodySalidasReal");
            const contador = document.getElementById("totalSalidasReal");
            tbody.closest("table").classList.remove("tabla-salidas-horizontal");

            // Restaurar el diseño original al seleccionar un SKU.
            tbody.closest("table").classList.remove("tabla-salidas-todos");

            thead.innerHTML = "";
            tbody.innerHTML = "";

            // Entradas seleccionadas.
            const entradas = (datosReales.entradas || [])
                .filter(e => e.sku === skuEntrada);

            const solicitudes = new Set(
                entradas.map(e => e.solicitudProduccionId)
            );

            // Salidas asociadas a las solicitudes de entrada.
            const salidas = (datosReales.salidas || [])
                .filter(s => solicitudes.has(s.solicitudProduccionId));

            // Detectar solicitudes que comparten varios SKU de entrada.
            const entradasPorSolicitud = new Map();

            (datosReales.entradas || []).forEach(e => {
                if (!entradasPorSolicitud.has(e.solicitudProduccionId)) {
                    entradasPorSolicitud.set(e.solicitudProduccionId, new Set());
                }
                entradasPorSolicitud.get(e.solicitudProduccionId).add(e.sku);
            });

            const solicitudesCompartidas = [...solicitudes].filter(id =>
                (entradasPorSolicitud.get(id)?.size || 0) > 1
            );

            // SKU de salida dinámicos.
            const productosSalida = new Map();

            salidas.forEach(s => {
                if (!productosSalida.has(s.sku)) {
                    productosSalida.set(s.sku, s.producto || s.sku);
                }
            });

            const columnasSalida = [...productosSalida.entries()]
                .sort(([a], [b]) => a.localeCompare(b));

            const formatoKg = new Intl.NumberFormat("es-MX", {
                minimumFractionDigits: 3,
                maximumFractionDigits: 3
            });

            const formatoPorcentaje = new Intl.NumberFormat("es-MX", {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });

            // Encabezados.
            const encabezado = thead.insertRow();

            const encabezados = [
                "Fecha",
                `ENTRADA · ${skuEntrada}`,
                ...columnasSalida.map(([sku, nombre]) => `${sku} · ${nombre}`),
                "Total salida",
                "Variación"
            ];

            encabezados.forEach((nombre, indice) => {
                const th = document.createElement("th");
                th.textContent = nombre;

                if (indice === 1) {
                    th.className = "columna-entrada";
                }

                encabezado.appendChild(th);
            });
            
            // Agrupar entradas por su fecha real.
            const entradasPorFecha = new Map();

            entradas.forEach(e => {
                if (!e.fechaEntrada) return;

                const fecha = String(e.fechaEntrada).substring(0, 10);
                const kg = Number(e.totalKg || 0);

                entradasPorFecha.set(
                    fecha,
                    (entradasPorFecha.get(fecha) || 0) + kg
                );
            });

            // Agrupar por fecha y SKU.
            const fechas = new Map();


            salidas.forEach(s => {

                const fecha = s.fecha.substring(0, 10);

                if (!fechas.has(fecha)) {
                    fechas.set(fecha, new Map());
                }

                const productos = fechas.get(fecha);

                productos.set(
                    s.sku,
                    (productos.get(s.sku) || 0) + Number(s.totalKg)
                );
            });

            // Mostrar tambén los días con entrada 
            // aunque no tengan salidas.
            const fechaInicio = document.getElementById("start").value;
            const fechaFin = document.getElementById("end").value;

            entradasPorFecha.forEach((kg, fecha) => {
                if (fecha >= fechaInicio && fecha <= fechaFin) {
                    if (!fechas.has(fecha)) {
                        fechas.set(fecha, new Map());
                    }
                }
            });


            // Filas por fecha: solo salidas. Las entradas se desglosan por solicitud
            // en la tabla anterior; no tienen fecha de salida atribuible por día.
            [...fechas.entries()]
                .sort(([a], [b]) => a.localeCompare(b))
                .forEach(([fecha, productos]) => {

                    const fila = tbody.insertRow();

                    fila.insertCell().textContent = fecha;

                    // Entrada real registrada en esta fecha.
                    const celdaEntrada = fila.insertCell();

                    const kgEntradaDia = entradasPorFecha.get(fecha);

                    celdaEntrada.textContent =
                        kgEntradaDia !== undefined
                            ? formatoKg.format(kgEntradaDia)
                            : "—";

                    celdaEntrada.className = "columna-entrada";

                    let totalDia = 0;

                    columnasSalida.forEach(([sku]) => {

                        const celda = fila.insertCell();

                        if (!productos.has(sku)) {
                            celda.textContent = "—";
                            return;
                        }

                        const kg = productos.get(sku);
                        totalDia += kg;

                        const boton = document.createElement("button");
                        boton.type = "button";
                        boton.className = "indicador-kg";
                        boton.textContent = formatoKg.format(kg);

                        boton.addEventListener("click", () => {
                            consultarDetalleCelda(fecha, sku, solicitudes);
                        });

                        celda.appendChild(boton);
                    });

                    const celdaTotal = fila.insertCell();
                    celdaTotal.textContent = formatoKg.format(totalDia);
                    celdaTotal.className = "total-kg";

                    fila.insertCell().textContent = "—";
                });

            // Totales del periodo.
            const totalEntrada = entradas.reduce(
                (suma, e) => suma + Number(e.totalKg || 0), 0
            );

            const totalSalida = salidas.reduce(
                (suma, s) => suma + Number(s.totalKg || 0), 0
            );

            const filaTotal = tbody.insertRow();
            filaTotal.className = "fila-total-indicadores";

            filaTotal.insertCell().textContent = "TOTAL PERIODO";

            const celdaEntradaTotal = filaTotal.insertCell();
            celdaEntradaTotal.textContent = formatoKg.format(totalEntrada);
            celdaEntradaTotal.className = "columna-entrada";

            columnasSalida.forEach(([sku]) => {

                const kg = salidas
                    .filter(s => s.sku === sku)
                    .reduce((suma, s) => suma + Number(s.totalKg), 0);

                const celda = filaTotal.insertCell();
                celda.textContent = formatoKg.format(kg);
            });

            const celdaSalidaTotal = filaTotal.insertCell();
            celdaSalidaTotal.textContent = formatoKg.format(totalSalida);
            celdaSalidaTotal.className = "total-kg";

            const celdaVariacion = filaTotal.insertCell();

            const advertencias = (datosReales.advertencias || [])
                .filter(a => solicitudes.has(a.solicitudProduccionId));

            const calculoParcial =
                advertencias.length > 0 ||
                solicitudesCompartidas.length > 0;

            if (totalEntrada > 0 && !calculoParcial) {

                const variacion =
                    ((totalSalida - totalEntrada) / totalEntrada) * 100;

                celdaVariacion.textContent =
                    `${formatoPorcentaje.format(variacion)}%`;

            } else {
                celdaVariacion.textContent = "No definitivo";
            }

            // Avisos de integridad.
            const contenedorAvisos =
                document.getElementById("advertenciasRetrabajo");

            contenedorAvisos.innerHTML = "";

            const mensajes = [];

            if (advertencias.length) {
                mensajes.push(
                    `${advertencias.length} solicitudes tienen salidas ` +
                    "fuera del periodo seleccionado."
                );
            }

            if (solicitudesCompartidas.length) {
                mensajes.push(
                    `${solicitudesCompartidas.length} solicitudes contienen ` +
                    "más de un SKU de entrada. Sus salidas necesitan " +
                    "una regla de atribución."
                );
            }

            if (mensajes.length) {
                const aviso = document.createElement("div");
                aviso.className = "alert alert-warning";
                aviso.textContent = mensajes.join(" ");
                contenedorAvisos.appendChild(aviso);
            }

            // Evitar mostrar dos resúmenes de rendimiento.
            document.getElementById("resumenEntradasGrupo").innerHTML = "";

            contador.textContent =
                `${fechas.size} días · ${salidas.length} registros de salida`;
        }


        
