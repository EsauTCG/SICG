                    skusEntrada.has(e.sku) &&
                    solicitudes.has(e.solicitudProduccionId)
                );

            const totalEntrada = entradas.reduce(
                (suma, e) => suma + Number(e.totalKg || 0), 0
            );

            const totalSalida = salidas.reduce(
                (suma, s) => suma + Number(s.totalKg || 0), 0
            );

            const diferencia = totalSalida - totalEntrada;

            const rendimiento = totalEntrada > 0
                ? (totalSalida / totalEntrada) * 100
                : null;

            const solicitudesConAdvertencia = new Set(
                (datosReales.advertencias || [])
                    .map(a => a.solicitudProduccionId)
            );

            const periodoParcial = [...solicitudes]
                .some(id => solicitudesConAdvertencia.has(id));

            const formatoKg = new Intl.NumberFormat("es-MX", {
                minimumFractionDigits: 3,
                maximumFractionDigits: 3
            });

            const formatoPorcentaje = new Intl.NumberFormat("es-MX", {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });

            const tarjeta = document.createElement("div");
            tarjeta.className = "p-3 rounded border";

            const titulo = document.createElement("h5");
            titulo.textContent = `Resumen · ${grupo.nombre}`;

            const valores = document.createElement("div");
            valores.className = "row g-3 my-2";

            const indicadores = [
                ["Entrada asociada", formatoKg.format(totalEntrada) + " kg"],
