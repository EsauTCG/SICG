        function mostrarEntradasGrupo() {

            const grupoId = document.getElementById("grupoProducto").value;
            const grupo = gruposProductos[grupoId];
            const contenedor = document.getElementById("resumenEntradasGrupo");

            contenedor.innerHTML = "";
            if (!grupo) return;

            const skusEntrada = new Set(grupo.entrada);
            const skusSalida = new Set(grupo.salidas.map(s => s.sku));

            const salidas = (datosReales.salidas || [])
                .filter(s => skusSalida.has(s.sku));

            const solicitudes = new Set(
                salidas.map(s => s.solicitudProduccionId)
            );

            const entradas = (datosReales.entradas || [])
                .filter(e =>
                    skusEntrada.has(e.sku) &&
                    solicitudes.has(e.solicitudProduccionId)
                );

            const totalEntrada = entradas.reduce(
                (suma, e) => suma + Number(e.totalKg || 0), 0
            );

            const totalSalida = salidas.reduce(
                (suma, s) => suma + Number(s.totalKg || 0), 0
            );

            const diferencia = totalSalida - totalEntrada;

            const rendimiento = totalEntrada > 0
                ? (totalSalida / totalEntrada) * 100
                : null;

            const solicitudesConAdvertencia = new Set(
                (datosReales.advertencias || [])
                    .map(a => a.solicitudProduccionId)
            );

            const periodoParcial = [...solicitudes]
                .some(id => solicitudesConAdvertencia.has(id));

            const formatoKg = new Intl.NumberFormat("es-MX", {
                minimumFractionDigits: 3,
                maximumFractionDigits: 3
            });

            const formatoPorcentaje = new Intl.NumberFormat("es-MX", {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });

            const tarjeta = document.createElement("div");
            tarjeta.className = "p-3 rounded border";

            const titulo = document.createElement("h5");
            titulo.textContent = `Resumen · ${grupo.nombre}`;

            const valores = document.createElement("div");
            valores.className = "row g-3 my-2";

            const indicadores = [
                ["Entrada asociada", formatoKg.format(totalEntrada) + " kg"],
                ["Salida del periodo", formatoKg.format(totalSalida) + " kg"],
                ["Diferencia", formatoKg.format(diferencia) + " kg"]
            ];

            indicadores.forEach(([nombre, valor]) => {

                const columna = document.createElement("div");
                columna.className = "col-md-4";

                const cuadro = document.createElement("div");
                cuadro.className = "border rounded p-3 h-100";

                const etiqueta = document.createElement("small");
                etiqueta.textContent = nombre;

                const cantidad = document.createElement("div");
                cantidad.textContent = valor;
                cantidad.style.fontWeight = "700";
                cantidad.style.fontSize = "1.3rem";
                cantidad.style.color = "#820b1b";

                cuadro.append(etiqueta, cantidad);
                columna.appendChild(cuadro);
                valores.appendChild(columna);
            });

            const resultado = document.createElement("div");

            if (rendimiento === null) {
                resultado.textContent = "Rendimiento: sin entrada asociada válida.";
            } else if (periodoParcial) {
                resultado.textContent =
                    "Rendimiento no definitivo: existen salidas fuera del periodo. " +
                    `Comparación parcial: ${formatoPorcentaje.format(rendimiento)}%.`;
            } else {
                resultado.textContent =
                    `Rendimiento calculado: ${formatoPorcentaje.format(rendimiento)}%.`;
            }

            resultado.style.fontWeight = "600";

            const nota = document.createElement("small");
            nota.className = "d-block mt-2 text-muted";
            nota.textContent =
                `${solicitudes.size} solicitudes con salida. ` +
                "La diferencia no representa necesariamente merma. " +
                "El cálculo requiere validar que todos los SKU de salida estén clasificados.";

            tarjeta.append(titulo, valores, resultado, nota);
            contenedor.appendChild(tarjeta);
        }


        
        function mostrarAdvertenciasRetrabajo() {

            const contenedor = document.getElementById("advertenciasRetrabajo");
            contenedor.innerHTML = "";

            const grupo = gruposProductos[
                document.getElementById("grupoProducto").value
            ];

            if (!grupo) return;

            const skus = new Set(grupo.salidas.map(s => s.sku));

            const solicitudes = new Set(
                (datosReales.salidas || [])
                    .filter(s => skus.has(s.sku))
                    .map(s => s.solicitudProduccionId)
            );

            const advertencias = (datosReales.advertencias || [])
                .filter(a => solicitudes.has(a.solicitudProduccionId));

            if (!advertencias.length) return;

            const aviso = document.createElement("div");
            aviso.className = "alert alert-warning";

            const titulo = document.createElement("strong");
            titulo.textContent = "Atención: producción en otras fechas";

            const descripcion = document.createElement("p");
            descripcion.className = "mb-1";
            descripcion.textContent =
                `${advertencias.length} solicitudes tienen salidas fuera del periodo seleccionado. ` +
                "Las entradas corresponden a la solicitud completa, " +
                "pero las salidas mostradas corresponden solamente al periodo consultado.";

            aviso.append(titulo, descripcion);
            contenedor.appendChild(aviso);
        }


        
        async function consultarDetalleCelda(fecha, sku, solicitudesPermitidas = null) {

            const solicitudes = (datosReales.salidas || [])
                .filter(s =>
                    s.fecha.substring(0, 10) === fecha &&
                    s.sku === sku &&
                    (
                        solicitudesPermitidas === null ||
                        solicitudesPermitidas.has(s.solicitudProduccionId)
                    )
                );

            if (!solicitudes.length) return;

            const tbody = document.getElementById("tbodyDetalleRetrabajo");
            const resumen = document.getElementById("resumenDetalleRetrabajo");
            const titulo = document.getElementById("tituloDetalleRetrabajo");

            tbody.innerHTML = "";
            titulo.textContent = `Detalle ${sku} - ${fecha}`;
            resumen.textContent = "Consultando etiquetas...";

            const modal = new bootstrap.Modal(
                document.getElementById("modalDetalleRetrabajo")
            );
            modal.show();

            try {
                const fechaInicio = document.getElementById("start").value;
                const fechaFin = document.getElementById("end").value;

                // Una consulta por cada solicitud asociada a la celda.
                const respuestas = await Promise.all(
                    solicitudes.map(async s => {

                        const parametros = new URLSearchParams({
                            fechaInicio,
                            fechaFin,
                            solicitudId: s.solicitudProduccionId,
                            tipoMovimiento: "SALIDA",
                            sku,
                            fechaSalida: fecha
                        });

                        const respuesta = await fetch(
                            `${API_DETALLE}?${parametros}`
                        );

                        if (!respuesta.ok) {
                            const mensajeServidor = await respuesta.text();

                            console.error("RESPUESTA DEL SERVIDOR:", mensajeServidor);

                            throw new Error(`HTTP ${respuesta.status}`);
                        }

                        const resultado = await respuesta.json();

                        if (!resultado.success) {
                            throw new Error("Error consultando etiquetas.");
                        }

                        return resultado.data;
                    })
                );

                const etiquetas = respuestas.flat();

                const formatoKg = new Intl.NumberFormat("es-MX", {
                    minimumFractionDigits: 3,
                    maximumFractionDigits: 3
                });

                let totalKg = 0;

                etiquetas.forEach(e => {

                    totalKg += Number(e.kg);

                    const fila = tbody.insertRow();

                    [
                        e.solicitudProduccionID,
                        e.produccionID,
                        e.codigoEtiqueta,
                        e.fecha?.replace("T", " ").substring(0, 19),
                        e.almacen,
                        formatoKg.format(e.kg)
                    ].forEach(valor => {
                        const celda = fila.insertCell();
                        celda.textContent = valor ?? "";
                    });
                });

                resumen.textContent =
                    `${solicitudes.length} solicitudes | ` +
                    `${etiquetas.length} etiquetas | ` +
                    `${formatoKg.format(totalKg)} kg`;

                // Comprobar que el detalle coincida con la celda.
                const totalEsperado = solicitudes.reduce(
                    (suma, s) => suma + Number(s.totalKg), 0
                );

                if (Math.abs(totalEsperado - totalKg) > 0.001) {
                    resumen.textContent +=
                        " | ADVERTENCIA: el detalle no coincide con el resumen.";
                }

            } catch (error) {
                console.error("ERROR DETALLE RETRABAJOS:", error);

                resumen.textContent =
                    "Error al consultar detalle: " + error.message;
            }
        }



        async function consultarDetalleSalida(salida) {

            const parametros = new URLSearchParams({
                fechaInicio: document.getElementById("start").value,
                fechaFin: document.getElementById("end").value,
                solicitudId: salida.solicitudProduccionId,
                tipoMovimiento: "SALIDA",
                sku: salida.sku,
                fechaSalida: salida.fecha.substring(0, 10)
            });

            try {
                const respuesta = await fetch(
                    `${API_DETALLE}?${parametros}`
                );

                if (!respuesta.ok) {
                    throw new Error(`HTTP ${respuesta.status}`);
                }

                const resultado = await respuesta.json();

                if (!resultado.success) {
                    throw new Error("Error consultando etiquetas.");
                }

                console.log("ETIQUETAS DE SALIDA:", resultado.data);

                alert(
                    `Solicitud ${salida.solicitudProduccionId}\n` +
                    `SKU: ${salida.sku}\n` +
                    `Etiquetas encontradas: ${resultado.data.length}`
                );

            } catch (error) {
                console.error(error);
                alert("No fue posible consultar las etiquetas.");
            }
        }

        document.getElementById("consultarReal").addEventListener("click", async () => {

            const fechaInicio = document.getElementById("start").value;
            const fechaFin = document.getElementById("end").value;

            if (!fechaInicio || !fechaFin) {
                alert("Selecciona una fecha inicial y final.");
                return;
            }

            if (fechaFin < fechaInicio) {
                alert("La fecha final no puede ser menor que la inicial.");
                return;
            }

            try {
                await consultarReporteReal(fechaInicio, fechaFin);

                alert("Consulta realizada correctamente. Revisa la consola.");

            } catch (error) {
                console.error(error);
                alert("No fue posible consultar los datos.");
            }
        });

        

