        function aplicarSubclasDia(){

            const fecha = inputDiaActual.dataset.fecha;

            const filas = document.querySelectorAll("#tablaSubclasDia tbody tr");

            const cantidades = {};
            const pesos = {};
            for (const fila of filas) {
                const canalesInput = fila.querySelector(".input-subclas");
                const pesoInput = fila.querySelector(".input-peso-diario");
                pesoInput.required = Number(canalesInput.value) > 0;
                pesoInput.setCustomValidity(pesoInput.required && !(Number(pesoInput.value) > 0)
                    ? "Captura un peso promedio diario mayor a cero." : "");
                if (!canalesInput.reportValidity() || !pesoInput.reportValidity()) return;
            }

            let total = 0;

            filas.forEach(fila => {

                const subclas = fila.dataset.subclasificacion;
                const valor = Number(fila.querySelector(".input-subclas").value);
                const peso = fila.querySelector(".input-peso-diario").value;

                cantidades[subclas] = valor;
                pesos[subclas] = peso === "" ? null : Number(peso);
                total += valor;
            });

            overridesSubclas[fecha] = cantidades;
            pesosPromedioDia[fecha] = pesos;
            diasDistribucionModificados.add(fecha);
            inputDiaActual.value = total;
            esCambioManual = false;
            validarTotalDiario(inputDiaActual);

            bootstrap.Modal.getInstance(
                document.getElementById("modalSubclas")
            ).hide();
        }

