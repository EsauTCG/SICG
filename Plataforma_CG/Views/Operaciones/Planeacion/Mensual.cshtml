@model IEnumerable<dynamic>
@using System.Globalization
@using System.Text.Json

@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
}

<link rel="stylesheet" href="~/css/planeador-produccion-sigo.css" asp-append-version="true" />

<div id="planeadorContenido" class="container-principal pp-sigo pp-page" tabindex="-1">
    <header class="pp-titlebar">
        <div>
            <span class="pp-eyebrow">Operaciones · SIGO</span>
            <h1>Planeador de Producción</h1>
            <p>Planeación mensual, distribución semanal y plan diario.</p>
        </div>
    <div class="pp-actions pp-catalog-actions">
    <a class="btn btn-primary" asp-controller="PlaneadorSkuConversion" asp-action="Index">
        <i class="bi bi-arrow-left-right" aria-hidden="true"></i>
        Sku Conversión
    </a>
    <a class="btn btn-primary" asp-controller="PlaneadorParticipacion" asp-action="Index">
        <i class="bi bi-sliders" aria-hidden="true"></i>
        Participación
    </a>
    <button type="button"
            class="btn btn-primary"
            onclick="abrirResumenPlaneacion()">
        <i class="bi bi-bar-chart-line"></i>
        Resumen de Planeación
    </button>
    </div>
    </header>
    <!-- ================= MESES ================= -->
    <div id="vista-meses" class="containers active">
        <div class="pp-view-content">
            <div class="pp-section-heading">
                <div>
                    <h2>Selecciona un mes</h2>
                    <p>Abre el periodo para consultar y distribuir la producción.</p>
                </div>
                <span class="pp-period">@DateTime.Now.Year</span>
            </div>
            <div class="row g-4 pp-month-grid">
                @{
                    var meses = new[] {
                                "Enero","Febrero","Marzo","Abril","Mayo","Junio",
                                "Julio","Agosto","Septiembre","Octubre","Noviembre","Diciembre"
                                };
                    var anio = DateTime.Now.Year;
                }
                @for (int i = 0; i < 12; i++)
                {
                    <div class="col-md-4">
                        <div class="card shadow-sm text-center pp-month-card"
                             style="cursor:pointer"
                             onclick="mostrarMes(@(i + 1), '@meses[i]', @anio)">
                            <div class="card-body">
                                <span class="pp-month-number">@((i + 1).ToString("00"))</span>
                                <div>
                                    <h5>@meses[i]</h5>
                                    <small>@anio</small>
                                </div>
                                <i class="bi bi-arrow-right pp-month-arrow" aria-hidden="true"></i>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ================= SEMANAL / PLANEADOR ================= -->
    <div id="vista-semanal" class="containers">

        <div class="pp-view-content">

            <div id="panel-mes" style="display:none;">
                <!-- Header -->
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="fw-bold text-danger" id="titulo-mes"></div>
                    <button class="btn btn-sm btn-outline-danger" onclick="volverAMeses()">← Meses</button>
                </div>

                <div class="mb-2">
                    <small class="text-muted fw-semibold">
                        Canales restantes del mes
                    </small>
                </div>
                <div id="resumen-clasificaciones" class="d-flex flex-wrap gap-2"></div>

                <!-- Slider -->
                <div id="barra-modo" class="d-flex justify-content-end mb-3">
                    <div class="btn-group">
                        <input type="radio" class="btn-check" name="modo" id="modoSemanal" checked>
                        <label class="btn btn-outline-danger btn-sm" for="modoSemanal">Semanal</label>

                        <input type="radio" class="btn-check" name="modo" id="modoPlaneador">
                        <label class="btn btn-outline-danger btn-sm" for="modoPlaneador">Planeador</label>
                    </div>
                </div>

                <div id="barra-dia" class="mb-3" style="display:none">
                    <button class="btn btn-outline-danger btn-sm" onclick="volverASemanasDesdeDia()">
                        ← Regresar a semanas
                    </button>
                </div>
            </div>


            <!-- Contenido -->
            <div id="semanas-body"></div>
            <div id="contenedor-planeador" style="display:none">
                <!-- Por ahora vacío -->
            </div>

        </div>
    </div>

</div>

<div id="planeadorCarga" class="pp-loading-overlay" role="dialog" aria-modal="true"
     aria-labelledby="planeadorCargaTitulo" aria-describedby="planeadorCargaDetalle" tabindex="-1" hidden>
    <div class="pp-loading-card">
        <img src="~/images/vaquita-comiendo.gif" asp-append-version="true" class="pp-loading-cow"
             width="184" height="180" alt="" draggable="false" />
        <span class="pp-loading-label">Planeador de producción</span>
        <h2 id="planeadorCargaTitulo" role="status" aria-live="polite" aria-atomic="true">Cargando información…</h2>
        <p id="planeadorCargaDetalle">Un momento, estamos preparando tu información.</p>
    </div>
</div>

<div class="modal fade pp-sigo" id="modalDistribucion" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">
                    Distribución diaria
                </h5>
                <button type="button" class="btn-close"
                        data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" id="modalDistribucionBody">
            </div>

        </div>
    </div>
</div>
<div class="modal fade pp-sigo" id="modalSubclas" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Distribución por subclasificación</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <p class="text-muted small">Fecha: <strong id="fechaSubclasDia"></strong>. El peso capturado se usará en el plan diario de esta fecha.</p>

                <table class="table table-sm table-bordered text-center" id="tablaSubclasDia">

                    <thead>
                        <tr>
                            <th>Subclasificación</th>
                            <th>%</th>
                            <th>Canales</th>
                            <th>Peso promedio diario (kg/canal)</th>
                        </tr>
                    </thead>

                    <tbody></tbody>

                    <tfoot>
                        <tr>
                            <th>Total</th>
                            <th></th>
                            <th id="totalSubclasDia">0</th>
                            <th><span id="pesoPromedioSubclasDia">0.00</span> kg/canal</th>
                        </tr>
                    </tfoot>

                </table>

            </div>
            <div class="text-end">
                <button class="btn btn-success btn-sm" onclick="aplicarSubclasDia()">
                    Aplicar
                </button>
            </div>
        </div>
    </div>
</div>



<div class="modal fade pp-sigo" id="modalPlantillaSemanal" tabindex="-1">
    <div class="modal-dialog modal-xl modal-dialog-scrollable" style="max-width:95%;">
        <div class="modal-content" style="height:90vh;">

            <div class="modal-header">
                <h5 class="modal-title">Plantilla semanal</h5>
                <button class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body" id="contenidoPlantillaSemanal">
                <div class="text-center">
                    <span>Cargando...</span>
                </div>
            </div>

        </div>
    </div>
</div>

<div class="modal fade pp-sigo"
     id="modalResumenPlaneacion"
     tabindex="-1"
     aria-labelledby="modalResumenPlaneacionLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">

        <div class="modal-content">

            <div class="modal-header">

                <h5 class="modal-title"
                    id="modalResumenPlaneacionLabel">
                    Resumen de Planeación
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar">
                </button>

            </div>

            <div class="modal-body p-2">

                <div id="contenedorResumenPlaneacion">

                    <div class="text-center p-4">
                        <div class="spinner-border"></div>
                        <div class="mt-2">
                            Cargando resumen...
                        </div>
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>



<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
                    let distribucionClasificacion = {};
                    let clasificacionActual = "";

                        let overridesSubclas = {};
                        let pesosPromedioDia = {};
                        let diasDistribucionModificados = new Set();




                            async function abrirPlantillaSemanal(fechaInicio, fechaFin) {

        const tipo = "NOV"; // 🔥 como pediste

        const url = `/Operaciones/PlantillaSemanal?tipo=${tipo}&fechain=${fechaInicio}&fechafin=${fechaFin}`;

        const contenedor = document.getElementById("contenidoPlantillaSemanal");

        contenedor.innerHTML = "<div class='text-center'>Cargando...</div>";

        const carga = fetch(url)
            .then(res => res.text())
            .then(async html => {
                contenedor.innerHTML = html;
                await inicializarPlanSemanal();
            })
            .catch(err => {
                console.error(err);
                contenedor.innerHTML = "<div class='text-danger'>Error al cargar</div>";
            });

        const modal = new bootstrap.Modal(
            document.getElementById("modalPlantillaSemanal")
        );

        modal.show();
        await carga;
        
    }
                    async function abrirModalDistribucion(clasificacion, btn) {

            overridesSubclas = {};
            pesosPromedioDia = {};
            diasDistribucionModificados = new Set();
            clasificacionActual = clasificacion;

            const card = btn.closest(".card");
            const registro = btn.closest(".registro");
                                        distribucionClasificacion = generarDistribucionClasificacion(registro, clasificacion);
                                    console.log("Distribución:", distribucionClasificacion);
            const inputSemana = card.querySelector("input[type='number']");
            const totalSemana = parseInt(inputSemana.value) || 0;

            const inicioOriginal = new Date(registro.dataset.fechaInicio);
            const finOriginal = new Date(registro.dataset.fechaFin);

            const fechasAjustadas = ajustarSemanaAlMes(
                inicioOriginal,
                finOriginal,
                mesSel,
                anioSel
            );

            let html = `
                <div class="mb-3">
                    <strong>Clasificación:</strong> ${clasificacion} <br>
                    <strong>Total semana:</strong> ${totalSemana}
                </div>

                <button class="btn btn-success btn-sm"
                    onclick="guardarDistribucion('${clasificacion}')">
                    Guardar distribución
                </button>

                <table class="table table-bordered">
                    <thead>
                        <tr>
                            <th>Día</th>
                            <th>Fecha</th>
                            <th>Canales</th>
                        </tr>
                    </thead>
                    <tbody>
            `;

            let fecha = new Date(fechasAjustadas.inicio);

            while (fecha <= fechasAjustadas.fin) {

                const fechaStr = fecha.toISOString().split('T')[0];

                html += `
                    <tr>
                        <td>${obtenerDiaSemana(fechaStr)}</td>
                        <td>${fechaStr}</td>
                        <td class="d-flex gap-1">

                            <input type="number"
                                class="form-control form-control-sm input-dia"
                                data-fecha="${fechaStr}"
                                data-total-semana="${totalSemana}"
                                value="0"
                                    oninput="onInputDia(this)">

                            <button class="btn btn-sm btn-outline-primary"
                                onclick="abrirDetalleDia(this)">
                                ⚙
                            </button>

                        </td>
                    </tr>
                `;

                fecha.setDate(fecha.getDate() + 1);
            }

            html += `
                    </tbody>
                </table>

                <div class="mt-4">
                    <canvas id="graficaSemana"></canvas>
                </div>

                <div class="text-end">
                    <span id="sumaActual" class="fw-bold text-danger">
                        0 / ${totalSemana}
                    </span>
                </div>
            `;

            const contenedor = document.getElementById("modalDistribucionBody");
            contenedor.innerHTML = html;

            const modal = new bootstrap.Modal(
                document.getElementById("modalDistribucion")
            );

            modal.show();

            const controles = contenedor.querySelectorAll("input, button");
            controles.forEach(control => control.disabled = true);
            const cargado = await consultarValoresExistentes(clasificacion);
            if (cargado) {
                controles.forEach(control => control.disabled = false);
            } else if (contenedor.contains(controles[0])) {
                alert("No se pudo cargar la distribución completa. Cierra esta ventana y vuelve a abrirla antes de editar.");
            }
        }
                                        async function consultarValoresExistentes(clasificacion) {

            const inputs = document.querySelectorAll("#modalDistribucionBody .input-dia");

            console.log("Inputs encontrados:", inputs.length);

            for (const input of inputs) {

                const fecha = input.dataset.fecha;

                try {

                    const res = await fetch(`/Operaciones/ObtenerDistribucionDia?clasificacion=${clasificacion}&fecha=${fecha}`);

                    if (!res.ok) {
                        throw new Error("No se pudo consultar la distribución diaria.");
                    }

                    const data = await res.json();
                    if (!Array.isArray(data)) throw new Error("La distribución recibida no es válida.");
                    if (!input.isConnected || clasificacion !== clasificacionActual) return false;
                    const lista = data;

                    // 🔥 GUARDAR DETALLE REAL
                    overridesSubclas[fecha] = {};
                    pesosPromedioDia[fecha] = {};

                    let total = 0;

                    lista.forEach(item => {

                        const sub = (item.subClasificacion ?? item.SubClasificacion ?? item.subclasificacion ?? item.Subclasificacion ?? "").trim();
                        const val = item.canales ?? item.Canales ?? 0;
                        const peso = item.pesoPromedio ?? item.PesoPromedio ?? null;

                        if (sub) {
                            overridesSubclas[fecha][sub] = val;
                            pesosPromedioDia[fecha][sub] = peso;
                        }

                        total += val;
                    });

                    // 🔥 ASIGNAR TOTAL AL INPUT
                    input.value = total;

                } catch (e) {

                    console.error("ERROR fetch:", e);
                    return false;

                }
            }

            if (inputs.length > 0) {
                validarTotalDiario(inputs[0]);
            }
            return true;
        }

            function recalcularSubclas(){

            let suma = 0;
            let kilos = 0;
            document.querySelectorAll("#tablaSubclasDia tbody tr").forEach(fila => {
                const canales = Number(fila.querySelector(".input-subclas").value) || 0;
                const peso = Number(fila.querySelector(".input-peso-diario").value) || 0;
                suma += canales;
                kilos += canales * peso;
            });

            document.getElementById("totalSubclasDia").innerText = suma;
            document.getElementById("pesoPromedioSubclasDia").innerText = (suma > 0 ? kilos / suma : 0).toFixed(2);

        }
            let inputDiaActual = null;

                    function abrirDetalleDia(btn){

            const input = btn.closest("td").querySelector(".input-dia");
            inputDiaActual = input;

            const fecha = input.dataset.fecha;
            const totalDia = parseInt(input.value) || 0;

            const tbody = document.querySelector("#tablaSubclasDia tbody");
            tbody.innerHTML = "";

            document.getElementById("fechaSubclasDia").innerText = fecha;
            const subclasificaciones = new Set([
                ...Object.keys(distribucionClasificacion), ...Object.keys(overridesSubclas[fecha] || {})
            ]);
            subclasificaciones.forEach(subclas => {
                const porcentaje = distribucionClasificacion[subclas] || 0;

                let canales = 0;

                // 🔴 PRIORIDAD 1: override manual
                if (overridesSubclas[fecha]?.[subclas] !== undefined) {

                    canales = overridesSubclas[fecha][subclas];

                }
                // ⚪ PRIORIDAD 3: cálculo por porcentaje
                else {

                    canales = Math.round((totalDia * porcentaje) / 100);

                }

                const peso = pesosPromedioDia[fecha]?.[subclas];
                const fila = document.createElement("tr");
                fila.dataset.subclasificacion = subclas;
                fila.innerHTML = `
                        <td class="nombre-subclas"></td>
                        <td>${porcentaje.toFixed(2)}%</td>
                        <td>
                            <input type="number"
                                class="form-control form-control-sm input-subclas"
                                min="0" step="1" required aria-label="Canales"
                                value="${canales}"
                                oninput="recalcularSubclas()">
                        </td>
                        <td>
                            <input type="number" class="form-control form-control-sm input-peso-diario"
                                min="0" step="any" inputmode="decimal" aria-label="Peso promedio diario en kg por canal"
                                placeholder="Captura el peso del día" value="${peso > 0 ? peso : ''}"
                                oninput="this.setCustomValidity(''); recalcularSubclas()">
                        </td>
                `;
                fila.querySelector(".nombre-subclas").textContent = subclas;
                tbody.appendChild(fila);
            });

            recalcularSubclas();

            const modal = new bootstrap.Modal(
                document.getElementById("modalSubclas")
            );

            modal.show();
        }

            let graficaSemana = null;

            function crearGraficaSemana(labels, datos, totalSemana) {

            if (typeof Chart === "undefined") {
                console.error("Chart.js no está cargado");
                return;
            }

            const ctx = document.getElementById("graficaSemana");

            if (!ctx) {
                console.error("Canvas graficaSemana no encontrado");
                return;
            }

            if (graficaSemana)
                graficaSemana.destroy();

            graficaSemana = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Canales por día',
                        data: datos
                    }]
                },
                options: {
                    responsive: true
                }
            });
        }

            function actualizarGraficaSemana() {

            const inputs = document.querySelectorAll(".input-dia");

            const labels = [];
            const datos = [];

            inputs.forEach(input => {

                const fecha = input.dataset.fecha;
                const valor = parseInt(input.value) || 0;

                labels.push(obtenerDiaSemana(fecha));
                datos.push(valor);

            });

            const totalSemana = parseInt(inputs[0]?.dataset.totalSemana || 0);

            crearGraficaSemana(labels, datos, totalSemana);

        }



                function generarDistribucionClasificacion(registro, clasificacion) {

            const distribucion = {};

            const cards = registro.querySelectorAll(".card");

            cards.forEach(card => {

                const nombre = card.querySelector(".fw-bold")?.innerText.trim();

                if (nombre !== clasificacion)
                    return;

                const filas = card.querySelectorAll("tbody tr");

                filas.forEach(fila => {

                    const subClas = fila.querySelector(".nomClas")?.innerText.trim();
                    const porcentaje = parseFloat(fila.dataset.porcentaje) || 0;

                    distribucion[subClas] = porcentaje;

                });

            });

            return distribucion;
        }

                                    async function guardarDistribucion() {

            const inputs = document.querySelectorAll("#modalDistribucionBody .input-dia");

            const distribucion = [];

            let total = 0;
            let totalSemana = 0;
            let error = "";

            inputs.forEach(input => {

                const cantidad = Number(input.value);
                const fecha = input.dataset.fecha;
                if (!Number.isInteger(cantidad) || cantidad < 0) {
                    error = `Revisa la cantidad de canales del ${fecha}.`;
                    return;
                }

                total += cantidad;
                totalSemana = parseInt(input.dataset.totalSemana);

                if (cantidad === 0 && !diasDistribucionModificados.has(fecha) &&
                    !Object.values(pesosPromedioDia[fecha] || {}).some(peso => peso > 0)) return;

                const detalle = overridesSubclas[fecha] || {};
                for (const subClas of new Set([...Object.keys(distribucionClasificacion), ...Object.keys(detalle)])) {
                    const canales = detalle[subClas] ?? Math.round(cantidad * (distribucionClasificacion[subClas] || 0) / 100);
                    const peso = pesosPromedioDia[fecha]?.[subClas] ?? null;
                    if (!Number.isInteger(canales) || canales < 0 ||
                        (peso !== null && (!Number.isFinite(peso) || peso < 0)) || (canales > 0 && !(peso > 0))) {
                        error = `Captura un peso promedio diario mayor a cero y canales válidos para ${subClas} el ${fecha}.`;
                    }
                    distribucion.push({
                        Clasificacion: clasificacionActual,
                        Subclasificacion: subClas,
                        Fecha: fecha,
                        Cantidad: canales,
                        PesoPromedio: peso
                    });
                }
            });

            if (error) { alert(error); return; }
            if (distribucion.length === 0) { alert("No hay datos para guardar."); return; }

            // ⚠️ SOLO AVISO (NO BLOQUEO)
            if (total > totalSemana) {
                alert("⚠️ La suma excede el total semanal, pero se guardará de todas formas.");
            }

            const payload = [{
                Distribucion: distribucion
            }];

            try {
                const response = await fetch("/Operaciones/GuardarDistribucion", {

                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify(payload)

                });
                const data = await response.json();
                if (!response.ok || !data.ok) throw new Error(data.mensaje || "No se pudo guardar la distribución.");
                diasDistribucionModificados.clear();
                alert("Distribución y pesos diarios guardados correctamente.");
            } catch (err) {
                console.error(err);
                alert(err.message || "Error al guardar");
            }
        }
            function obtenerDiaSemana(fechaStr) {

            const partes = fechaStr.split('-');

            const anio = parseInt(partes[0]);
            const mes = parseInt(partes[1]) - 1;
            const dia = parseInt(partes[2]);

            const fecha = new Date(anio, mes, dia);

            return fecha.toLocaleDateString('es-MX', { weekday: 'long' });
        }
            let esCambioManual = false;
           function validarTotalDiario(input) {

            const tbody = input.closest("tbody");
            const inputs = tbody.querySelectorAll(".input-dia");

            let suma = 0;

            inputs.forEach(i => {
                suma += parseInt(i.value) || 0;
            });

            const totalSemana = parseInt(input.dataset.totalSemana) || 0;

            const indicador = document.getElementById("sumaActual");

            indicador.innerText = `${suma} / ${totalSemana}`;

            actualizarGraficaSemana();
            //////////////////////////////////////////////////////////////////////////////////////////////////////
                    if (esCambioManual) {
            recalcularSubclasPorDia(input);
        }

                    input.classList.add("border-warning");
            // limpiar estilos
            inputs.forEach(i => i.classList.remove("is-invalid"));

            if (suma > totalSemana) {

                indicador.classList.remove("text-success");
                indicador.classList.add("text-warning");

                // ⚠️ SOLO AVISO
                indicador.title = "Excede el total semanal, pero se permitirá guardar";

            } else {

                indicador.classList.remove("text-warning");
                indicador.classList.add("text-success");

                indicador.title = "";
            }
                esCambioManual = false;
        }
        function onInputDia(input){
            const nuevo = parseInt(input.value) || 0;
            const anterior = input.dataset.prev || 0;

            if(nuevo !== anterior){
                esCambioManual = true;
                input.dataset.prev = nuevo;
            }

            validarTotalDiario(input);
        }

        // ================= VARIABLES GLOBALES =================

        let mesSel = null;
        let anioSel = null;
        let diaSel = null;
        let fechaActual = null;
        let planActivo = "NOV";

        let ResumenMensualGlobal = [];

        let semanasBody = null;
        let contenedorPlaneador = null;

        // ================= INIT =================

        document.addEventListener("DOMContentLoaded", function () {

            semanasBody = document.getElementById("semanas-body");
            contenedorPlaneador = document.getElementById("contenedor-planeador");

