            function recalcularSubclasPorDia(input) {

            const fecha = input.dataset.fecha;
            const totalDia = parseInt(input.value) || 0;

            console.log("Recalculando TODO por porcentaje:", fecha);

            const nuevaDistribucion = {};

            new Set([...Object.keys(distribucionClasificacion), ...Object.keys(overridesSubclas[fecha] || {})]).forEach(subclas => {
                const porcentaje = distribucionClasificacion[subclas] || 0;

                const canales = Math.round((totalDia * porcentaje) / 100);

                nuevaDistribucion[subclas] = canales;
            });

            // 🔥 sobrescribe TODO (incluye backend y overrides)
            overridesSubclas[fecha] = nuevaDistribucion;
            diasDistribucionModificados.add(fecha);

        }
        // ================= RESUMEN MENSUAL =================

        async function cargarResumenMensual() {

            if (!anioSel || !mesSel) return;

            try {

                const response = await fetch(
                    `/Operaciones/ObtenerResumenMensual?anio=${anioSel}&mes=${mesSel}`
                );

                const data = await response.json();

                const contenedor = document.getElementById("resumen-clasificaciones");
                contenedor.innerHTML = "";

                ResumenMensualGlobal = data || [];

                if (!ResumenMensualGlobal.length) {
                    contenedor.innerHTML =
                        `<span class="text-muted">Sin clasificaciones</span>`;
                    return;
                }

                ResumenMensualGlobal.forEach(item => {
                    contenedor.innerHTML += `
                        <span class="badge bg-danger me-2">
                            ${item.clasificacion}:
                            <b>${item.canales ?? 0}</b>
                        </span>
                    `;
                });

            } catch (err) {
                console.error("Error resumen mensual:", err);
            }
        }

        // ================= PLANEACION MENSUAL =================

            async function cargarPlaneacionMensual() {

        if (!anioSel || !mesSel) return;

        contenedorPlaneador.innerHTML = "";

        try {

            const response = await fetch(
                `/Operaciones/PlaneacionMensual?anio=${anioSel}&mes=${mesSel}`
            );

            if (!response.ok)
                throw new Error("No se pudo cargar la planeación mensual.");

            const html = await response.text();

            contenedorPlaneador.innerHTML = html;

            // Cargar las vistas parciales de cada clasificación
            await cargarDetallesClasificacionMensual();

        } catch (error) {

            console.error("Error cargando planeación mensual:", error);

            contenedorPlaneador.innerHTML = `
                <div class="alert alert-danger">
                    Error al cargar la planeación mensual.
                </div>`;
        }
    }

        // ================= SEMANAS =================

        function generarSemanas() {

            if (!anioSel || !mesSel) return;

            semanasBody.innerHTML = "";

            const primerDia = new Date(anioSel, mesSel - 1, 1);
            const ultimoDia = new Date(anioSel, mesSel, 0);

            let inicioSemana = new Date(primerDia);
            let ajuste = inicioSemana.getDay() === 0 ? -6 : 1 - inicioSemana.getDay();
            inicioSemana.setDate(inicioSemana.getDate() + ajuste);

            while (inicioSemana <= ultimoDia) {

                let diasHtml = "";

                const fechaInicioSemana = new Date(inicioSemana);
                const fechaFinSemana = new Date(inicioSemana);
                fechaFinSemana.setDate(fechaFinSemana.getDate() + 6);


                    const fechasAjustadas = ajustarSemanaAlMes(
            fechaInicioSemana,
            fechaFinSemana,
            mesSel,
            anioSel
        );

            function formatearFechaLocal(fecha) {
        const yyyy = fecha.getFullYear();
        const mm = String(fecha.getMonth() + 1).padStart(2, '0');
        const dd = String(fecha.getDate()).padStart(2, '0');
        return `${yyyy}-${mm}-${dd}`;
    }

    const inicioVisible = formatearFechaLocal(fechasAjustadas.inicio);
    const finVisible = formatearFechaLocal(fechasAjustadas.fin);
        //const inicioVisible = fechasAjustadas.inicio.toISOString().split('T')[0];
        //const finVisible = fechasAjustadas.fin.toISOString().split('T')[0];



                const inicioStr = fechaInicioSemana.toISOString().split('T')[0];
                const finStr = fechaFinSemana.toISOString().split('T')[0];

                for (let d = 0; d < 7; d++) {

                    let fecha = new Date(inicioSemana);
                    fecha.setDate(fecha.getDate() + d);

                    let fueraMes = (fecha.getMonth() + 1 !== mesSel) ? "fuera-mes" : "";
                    let fechaStr = fecha.toISOString().split('T')[0];

                    diasHtml += `
                        <div class="col text-center">
                            <div class="card dia-card ${fueraMes}"
                                 onclick="seleccionarDia(this, '${fechaStr}')">
                                <div class="card-body p-2">
                                    <b>${fecha.toLocaleDateString('es-MX', { weekday: 'short' })}</b>
                                    <div>${fecha.getDate()}</div>
                                </div>
                            </div>
                        </div>`;
                }

                semanasBody.innerHTML += `
                    <div class="registro"
                         data-fecha-inicio="${inicioVisible}"
                         data-fecha-fin="${finVisible}">



                             <div class="d-flex justify-content-between align-items-center mb-2">
        <h6 class="text-danger mb-0">
            Semana (${inicioVisible} al ${finVisible})
        </h6>

        <div class="d-flex gap-2">
            <button class="btn btn-sm btn-primary"
                    onclick="abrirPlantillaSemanal('${inicioVisible}','${finVisible}')">
                📊 Plantilla semanal
            </button>

            <button class="btn btn-sm btn-success"
                    onclick="guardarSemana(this)">
                Guardar semana
            </button>
        </div>
    </div>



                        <div class="row g-2 align-items-start">
                            ${diasHtml}
                            <div class="col-md-5 tabla-distribucion-semana d-flex gap-2"></div>
                        </div>
                    </div>`;

                inicioSemana.setDate(inicioSemana.getDate() + 7);
            }
        }

        // ================= TABLAS =================
            function ajustarSemanaAlMes(fechaInicio, fechaFin, mes, anio) {

            const inicioMes = new Date(anio, mes - 1, 1);
            const finMes = new Date(anio, mes, 0); // último día del mes

            const inicioValido = fechaInicio < inicioMes ? inicioMes : fechaInicio;
            const finValido = fechaFin > finMes ? finMes : fechaFin;

            return {
                inicio: inicioValido,
                fin: finValido
            };
        }
            async function obtenerTotalSemanal(fechaInicio, fechaFin, clasificacion) {

            const fechain = fechaInicio.toISOString().split('T')[0];
            const fechafin = fechaFin.toISOString().split('T')[0];

            const response = await fetch(`ObtenerSemanal?fechain=${fechain}&fechafin=${fechafin}&clas=${clasificacion}`);

            if (!response.ok) {
                console.error("Error al obtener semanal");
                return 0;
            }

            return await response.json();
        }
            async function cargarTotalesSemanas(semanas, clasificaciones) {

        const promesas = [];

        for (let semana of semanas) {

            const inicioOriginal = new Date(semana.dataset.fechaInicio);
            const finOriginal = new Date(semana.dataset.fechaFin);

            const fechasAjustadas = ajustarSemanaAlMes(
                inicioOriginal,
                finOriginal,
                mesSel,
                anioSel
            );

            for (let clasificacion of clasificaciones) {

                const promesa = obtenerTotalSemanal(
                    fechasAjustadas.inicio,
                    fechasAjustadas.fin,
                    clasificacion
                ).then(lista => {

                    // 🔥 encontrar el card correcto
                    const cards = semana.querySelectorAll(".card");

                    cards.forEach(card => {

                        const nombre = card.querySelector(".fw-bold")?.innerText.trim();

                        if (nombre !== clasificacion) return;

                        const filas = card.querySelectorAll("tbody tr");

                        // 🔥 MAPEAR RESPUESTA DEL BACKEND
                        const mapa = {};

                        if (Array.isArray(lista)) {
                            lista.forEach(item => {
                                const key = (item.subClasificacion || item.SubClasificacion || "").trim();
                                mapa[key] = item.canales ?? item.Canales ?? 0;
                            });
                        }

                        let total = 0;

                        filas.forEach(fila => {

                            const sub = fila.querySelector(".nomClas")?.innerText.trim();

                            const input = fila.querySelector(".input-subclas-semana");

                            let valor = mapa[sub] ?? 0;

                            input.value = valor;

                            total += valor;
                        });

                        // 🔥 actualizar total semanal
                        const totalInput = card.querySelector(".total-semana");
                        if (totalInput) {
                            totalInput.value = total;
                        }

                        // 🔥 recalcular porcentajes visuales
                        filas.forEach(fila => {

                            const inputFila = fila.querySelector(".input-subclas-semana");
                            const valor = parseInt(inputFila.value) || 0;

                            const porcentaje = total > 0
                                ? (valor / total) * 100
                                : 0;

                            const celda = fila.querySelector(".porcentaje-est");

                            if (celda) {
                                celda.innerText = porcentaje.toFixed(2) + "%";
                            }
                        });

                    });

                });

                promesas.push(promesa);
            }
        }

        await Promise.all(promesas);
    }
            async function renderTablasEnSemanas() {

            if (!ResumenMensualGlobal.length) return;

            const semanas = document.querySelectorAll(".registro");

            for (const semana of semanas) {

                const contenedor = semana.querySelector(".tabla-distribucion-semana");
                if (!contenedor) continue;

                let html = "";

                ResumenMensualGlobal.forEach(clas => {

                    html += `
                        <div class="card p-2 shadow-sm" style="min-width:170px; max-width:200px; font-size:11px;">
                                <div class="d-flex justify-content-between align-items-center mb-2">
            <span class="fw-bold text-danger">
                ${clas.clasificacion}
            </span>

            <button class="btn btn-sm btn-outline-primary"
                onclick="abrirModalDistribucion(
                    '${clas.clasificacion}',
                    this
                )">
                📅
            </button>
        </div>


                            <input type="number"
                                   id="input-${clas.clasificacion}-${semana.dataset.numero}"
                                   class="form-control form-control-sm mb-2 total-semana"
                                   placeholder="Total semana"
                                   >

                            <table class="table table-sm table-bordered mb-0">
                                <thead class="table-light">
                                    <tr>
        <th>Sub</th>
        <th>% Est.</th>
        <th>Canales</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    ${clas.detalle?.map(det => `
                                        <tr data-porcentaje="${det.porcentaje}">
                                            <td class="nomClas">${det.nombreClasificacion}</td>
                                                <td class="porcentaje-est">0%</td>
    <td>
        <input type="number"
               class="form-control form-control-sm input-subclas-semana"
               value="0"
               oninput="recalcularSemana(this)">
    </td>
                                        </tr>
                                    `).join("") || ""}
                                </tbody>
                            </table>
                        </div>
                    `;
                });

                contenedor.innerHTML = html;
            }
            const clasificaciones = ResumenMensualGlobal.map(c => c.clasificacion);

            // ⚠️ IMPORTANTE: llamar una sola vez después de renderizar todo
            await cargarTotalesSemanas(semanas,clasificaciones);
        }
                    function recalcularSemana(input){

        const card = input.closest(".card");
        if(!card) return;

        const inputs = card.querySelectorAll(".input-subclas-semana");
        const filas = card.querySelectorAll("tbody tr");

        let total = 0;

        inputs.forEach(i=>{
            total += parseInt(i.value) || 0;
        });

        // ✅ actualizar total arriba
        const totalInput = card.querySelector(".total-semana");
        if(totalInput){
            totalInput.value = total;
        }

        // ✅ recalcular porcentajes
        filas.forEach(fila => {

            const inputFila = fila.querySelector(".input-subclas-semana");
            const valor = parseInt(inputFila.value) || 0;

            let porcentaje = total > 0
                ? (valor / total) * 100
                : 0;

            const celda = fila.querySelector(".porcentaje-est");
            if(celda){
                celda.innerText = porcentaje.toFixed(2) + "%";
            }
        });
    }

