@using Plataforma_CG.Models.Operaciones.Planeacion
@using Plataforma_CG.Models.Operaciones.Planeacion.Extra

<div class="resumen-planeacion">

    <!-- ========================================= -->
    <!-- FILTROS -->
    <!-- ========================================= -->

    <div class="card mb-3">

        <div class="card-body">

            <div class="row g-3 align-items-end">

                <div class="col-md-3">

                    <label class="form-label">
                        Fecha inicial
                    </label>

                    <input type="date"
                           id="fechaInicialResumenPlaneacion"
                           class="form-control" />

                </div>

                <div class="col-md-3">

                    <label class="form-label">
                        Fecha final
                    </label>

                    <input type="date"
                           id="fechaFinalResumenPlaneacion"
                           class="form-control" />

                </div>

                <div class="col-md-3">

                    <label class="form-label">
                        Clasificación
                    </label>

                    <select id="clasificacionResumenPlaneacion"
                            class="form-select">

                        <option value="">
                            Seleccione...
                        </option>

                        <option value="8">
                            Novillo
                        </option>

                        <option value="9">
                            Vaca Gorda
                        </option>

                    </select>

                </div>

                <div class="col-md-3">

                    <button type="button"
                            id="btnRefrescarResumenPlaneacion"
                            class="btn btn-primary w-100"
                            onclick="refrescarResumenPlaneacion()">

                        Refrescar

                    </button>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================================= -->
    <!-- TABLA -->
    <!-- ========================================= -->

    <div class="table-responsive resumen-planeacion-table-container">

        <table class="table table-bordered table-sm text-center tabla-resumen-planeacion">

            <thead class="table-light">

                <tr>

                    <th>
                        Máster
                    </th>

                    <th>
                        SKU Desh.
                    </th>

                    <th>
                        SKU Empacado
                    </th>

                    <th>
                        Kg Desh. Plan
                    </th>

                    <th>
                        % Inyección esperado.
                    </th>
                    <th>
                        % Inyeccion Produccion
                    </th>
                    <th>
                        Kg Empaque Plan
                    </th>
                    <th>
                        Kg Empaque Produccion
                    </th>
                    <th>
                        Cumplimiento
                    </th>

                </tr>

            </thead>

            <tbody id="tbodyResumenPlaneacion">

                <!--
                    La tabla inicia vacía.
                    Los registros se agregan mediante JavaScript.
                -->

            </tbody>

        </table>

    </div>

</div>