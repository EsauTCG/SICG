  /* Columna Izquierda: Buscador y Catálogo Visual */
  .ref-pos-catalog {
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-height: 0;
  }

  .ref-pos-scan {
    background: var(--ref-card);
    border: 1px solid var(--ref-border);
    border-radius: 12px;
    padding: 10px 16px;
    display: flex;
    align-items: center;
    gap: 10px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.03);
    flex-shrink: 0;
  }

    .ref-pos-scan input {
      border: none;
      outline: none;
      background: transparent;
      color: var(--ref-text);
      flex: 1;
      padding: 4px;
      font-size: 1rem;
      font-weight: 600;
    }

      .ref-pos-scan input::placeholder {
        color: var(--ref-text-muted);
        opacity: 0.7;
        font-weight: 400;
      }


    /* Cuadrícula de fotos */
    .ref-pos-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
        gap: 12px;
        overflow-y: auto;
        padding: 4px;
        align-content: flex-start;
    }

    .ref-pos-item {
        background: var(--ref-card);
        border: 1px solid var(--ref-border);
        border-radius: 12px;
        padding: 10px;
        text-align: center;
        cursor: pointer;
        transition: all 0.2s ease;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: flex-start;
        box-shadow: 0 2px 5px rgba(0,0,0,0.02);
        user-select: none;
        position: relative;
        overflow: hidden;
        min-height: 165px; /* <--- Obligamos a que la tarjeta tenga buena altura */
    }

        .ref-pos-item:hover {
            border-color: var(--ref-brand);
            transform: translateY(-2px);
            box-shadow: 0 6px 12px rgba(179, 0, 0, 0.1);
        }

        .ref-pos-item:active {
            transform: scale(0.96);
        }

        .ref-pos-item.agotado {
            opacity: 0.5;
            pointer-events: none;
            filter: grayscale(100%);
        }

        .ref-pos-item img {
            width: 100%;
            height: 70px;
            object-fit: cover;
            border-radius: 8px;
            margin-bottom: 8px;
            background: var(--ref-bg);
            flex-shrink: 0; /* <--- Evitamos que el navegador aplaste la imagen */
        }

        .ref-pos-item .no-foto {
            width: 100%;
            height: 70px;
            border-radius: 8px;
            margin-bottom: 8px;
            background: var(--ref-bg);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--ref-text-muted);
            font-size: 1.8rem;
            flex-shrink: 0; /* <--- Evitamos que el navegador aplaste el ícono */
        }

        .ref-pos-item .sku {
            font-size: 0.7rem;
            font-weight: 800;
            color: var(--ref-brand);
            margin-bottom: 2px;
            word-break: break-all;
            width: 100%; /* Para que centre bien el texto */
        }

        .ref-pos-item .desc {
            font-size: 0.72rem;
            color: var(--ref-text);
            line-height: 1.2;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
            width: 100%; /* Para que centre bien el texto */
        }

        .ref-pos-item .stock {
            position: absolute;
            top: 6px;
            right: 6px;
            background: rgba(0,0,0,0.7);
            color: white;
            font-size: 0.65rem;
            font-weight: 800;
            padding: 2px 6px;
            border-radius: 6px;
            backdrop-filter: blur(4px);
            z-index: 2;
        }
    /* ===== Botón Pendientes / Centro de alertas de stock ===== */
    .ref-alert-btn {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        border: 1px solid var(--ref-border);
        background: var(--ref-card);
        color: var(--ref-text);
        border-radius: 20px;
        padding: 5px 12px;
        font-weight: 700;
        font-size: 0.7rem;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .ref-alert-btn:hover {
            border-color: var(--ref-brand);
            color: var(--ref-brand);
        }

        .ref-alert-btn .ref-alert-icon {
            position: relative;
            display: inline-grid;
            place-items: center;
        }

        .ref-alert-btn .ref-alert-count {
            min-width: 20px;
            height: 20px;
            padding: 0 6px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 999px;
            background: var(--ref-bg);
            color: var(--ref-text-muted);
            font-size: 0.68rem;
            font-weight: 900;
            line-height: 1;
        }

        .ref-alert-btn.has-pending {
            border-color: #ffc107;
            background: rgba(255,193,7,0.12);
            color: #b45309;
        }

            .ref-alert-btn.has-pending .ref-alert-count {
                background: var(--ref-danger);
                color: #fff;
            }

            .ref-alert-btn.has-pending .ref-alert-icon::after {
                content: "";
                position: absolute;
                top: -2px;
                right: -2px;
                width: 7px;
                height: 7px;
                border: 1px solid var(--ref-card);
                border-radius: 50%;
                background: var(--ref-danger);
                animation: refBellPulse 1.8s infinite;
            }

        .ref-alert-btn.is-clear .ref-alert-count {
            background: #d1fae5;
            color: #065f46;
        }

    @@keyframes refBellPulse {
        0%, 100%

    {
        transform: scale(1);
        opacity: 1;
    }

    50% {
        transform: scale(1.5);
        opacity: .55;
    }

    }

    /* Modal Alertas */
    .ref-alert-summary {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
        margin-bottom: 12px;
