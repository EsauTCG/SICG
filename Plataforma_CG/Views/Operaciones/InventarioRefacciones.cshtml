          <h5 class="modal-title fw-bold" style="font-size:1rem;"><i class="bi bi-printer me-2"></i>Reimprimir ticket de salida</h5>
          <div style="font-size:.7rem; opacity:.85;">Busca una salida por folio, referencia o máquina y vuelve a generar sus dos tickets (usuario y almacén).</div>
        </div>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
      </div>
      <div class="modal-body p-4">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
          <input type="search" id="buscarReimpresionSalida" class="form-control form-control-sm" style="max-width:340px;" placeholder="Buscar folio, referencia o máquina..." oninput="renderSalidasReimpresion()" />
          <div id="resumenReimpresionSalidas" class="text-muted" style="font-size:.78rem;">Cargando...</div>
        </div>
        <div class="table-responsive" style="max-height:60vh; overflow:auto;">
          <table class="ref-alert-table">
            <thead><tr><th>Folio</th><th>Fecha</th><th>Referencia / OT</th><th>Artículos</th><th>Registró</th><th></th></tr></thead>
            <tbody id="tbodyReimpresionSalidas"><tr><td colspan="6" class="text-center py-4">Cargando...</td></tr></tbody>
          </table>
        </div>
      </div>
      <div class="modal-footer bg-light">
        <button type="button" class="btn btn-light" onclick="cargarSalidasReimpresion()"><i class="bi bi-arrow-clockwise me-1"></i>Actualizar</button>
        <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cerrar</button>
      </div>
    </div>
  </div>
</div>

<!-- Modal: Vista previa de sincronización SAP -->
<div class="modal fade modal-ref" id="modalPreviaSap" tabindex="-1" aria-hidden="true">
