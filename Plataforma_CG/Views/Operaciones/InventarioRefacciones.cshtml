        }

    /* Controles de + y - para la cantidad */
    .ref-pos-line-controls {
        display: flex;
        align-items: center;
        background: var(--ref-bg);
        border: 1px solid var(--ref-border);
        border-radius: 8px;
        overflow: hidden;
    }

        .ref-pos-line-controls button {
            background: transparent;
            border: none;
            padding: 4px 10px;
            color: var(--ref-text-muted);
