            function canonSku(s) {
                return String(s || '').trim().toUpperCase().replace(/'/g, '-');
            }

            function normalizarCodigo(codigo) {
                let c = String(codigo || '').trim();
                if (!c) return '';
                c = c.replace(/'/g, '-');
                c = c.replace(/^REF[^A-Za-z0-9]+/i, '').trim();
                return c;
            }

            function manejarEscaneo(codigo) {
                if ($('#vistaPos').is(':visible')) {
                    procesarEscaneo(codigo);
                    return;
                }

                const sku = normalizarCodigo(codigo);
                if (!sku) return;

                const item = inventario.find(x => canonSku(x.sku) === canonSku(sku) && enPlantaRef(x));
                if (!item) {
                    if (/REF/i.test(codigo)) {
                        alert(`No existe la refacción con SKU "${sku}" en la planta seleccionada.`);
                    }
                    return;
                }

                filtroActual = 'Todos';
                $('#searchInput').val(item.sku);
                renderTabs();
                renderTarjetas();
                resaltarRefaccion(item.id);
            }

            function resaltarRefaccion(id) {
                const el = document.querySelector(`[data-ref-id="${id}"]`);
                if (!el) return;
                el.scrollIntoView({ behavior: 'smooth', block: 'center' });
                el.classList.add('ref-highlight');
                setTimeout(() => el.classList.remove('ref-highlight'), 2600);
            }

            // ===== Foto de la refacción =====
            let fotoRefIdActual = 0;

            function subirFoto(id) {
                fotoRefIdActual = id;
                const input = document.getElementById('refFotoInput');
                input.value = '';
                input.click();
            }

            async function onFotoSeleccionada(input) {
                const archivo = input.files && input.files[0];
                if (!archivo) return;

                const id = fotoRefIdActual || parseInt($('#editId').val());
                if (!id) { alert('No se identificó la refacción.'); return; }

                const form = new FormData();
                form.append('id', id);
                form.append('archivo', archivo);

                try {
                    const res = await fetch(URL_SUBIR_FOTO, {
                        method: 'POST',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                        body: form
                    });
                    const data = await res.json();
                    if (!data || !data.ok) {
                        alert((data && data.mensaje) || 'No se pudo subir la foto.');
                        return;
                    }

                    cerrarModal('modalFotoRef');
                    await cargarDatos();
                    if (fotoRefIdActual) {
                        setTimeout(() => verFoto(fotoRefIdActual), 250);
                    }
                } catch (e) {
                    console.error(e);
                    alert('Error al subir la foto.');
                } finally {
                    input.value = '';
                }
            }

            function verFoto(id) {
                const item = inventario.find(x => x.id === id);
                if (!item || !item.foto) { subirFoto(id); return; }

                fotoRefIdActual = id;
                $('#fotoRefNombre').text(`${item.sku} · ${item.desc}`);
                $('#fotoRefImg').attr('src', item.foto);
                abrirModal('modalFotoRef');
            }

            async function eliminarFotoActual() {
                if (!fotoRefIdActual) return;

                const item = inventario.find(x => x.id === fotoRefIdActual);
                const nombre = item ? item.desc : '';
                if (!confirm(`¿Eliminar la foto de "${nombre}"?`)) return;

                const res = await postJson(URL_ELIMINAR_FOTO, { id: fotoRefIdActual });
                if (!res || !res.ok) {
                    alert((res && res.mensaje) || 'No se pudo eliminar la foto.');
                    return;
                }

                cerrarModal('modalFotoRef');
                await cargarDatos();
            }

            async function revisarPendientesSap() {
                try {
                    // Consulta silenciosa al endpoint existente sin mostrar el Loading
                    const res = await getJson(URL_PREVIA_SAP);
                    if (res && res.ok) {
                        const pendientes = (res.nuevos || 0) + (res.actualizados || 0);
                        const badge = document.getElementById('badgeSyncSap');

                        if (badge) {
                            if (pendientes > 0) {
                                badge.textContent = pendientes > 99 ? '+99' : pendientes;
                                badge.style.display = 'inline-block';
                            } else {
                                badge.style.display = 'none';
                            }
                        }
                    }
                } catch (e) {
                    console.log("No se pudo verificar consumibles pendientes en segundo plano.", e);
                }
            }

            // ===== Funciones de SAP =====
            async function sincronizarSap() {
                const btn = document.getElementById('btnSyncSap');
                if (btn) { btn.disabled = true; }
                const htmlOriginal = btn ? btn.innerHTML : '';
                if (btn) { btn.innerHTML = '<i class="bi bi-arrow-repeat ref-spin"></i> <span class="d-none d-sm-inline">Cargando consumibles...</span>'; }
                mostrarLoadingRef('Generando vista previa...');

                try {
                    const res = await getJson(URL_PREVIA_SAP);
                    if (!res || !res.ok) {
                        alert((res && res.mensaje) || 'No se pudieron cargar los consumibles.');
                        return;
                    }

                    pintarPreviaSap(res);
                    abrirModal('modalPreviaSap');
                } catch (e) {
                    console.error(e);
                    alert('Error al cargar los consumibles.');
                } finally {
                    ocultarLoadingRef();
                    if (btn) { btn.disabled = false; btn.innerHTML = htmlOriginal; }
                }
            }

            let previaSapItems = [];
            let previaDebounce = null;

            function pintarPreviaSap(res) {
                const setTxt = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };

                setTxt('prevNuevas', res.nuevos || 0);
                setTxt('prevActualizados', res.actualizados || 0);
                setTxt('prevTotal', (res.nuevos || 0) + (res.actualizados || 0));

                previaSapItems = Array.isArray(res.items) ? res.items : [];

                const buscar = document.getElementById('prevBuscar');
                if (buscar) buscar.value = '';

                renderPreviaSap();
            }

            function debounceRenderPrevia() {
                clearTimeout(previaDebounce);
                previaDebounce = setTimeout(renderPreviaSap, 150);
            }

            function renderPreviaSap() {
                const esc = (s) => String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
                const q = (document.getElementById('prevBuscar')?.value || '').trim().toLowerCase();

                const num = (v, dec) => (v == null || v === '') ? '—' : Number(v).toFixed(dec == null ? 2 : dec);

                const filtrados = previaSapItems.filter(m => {
                    if (!q) return true;
                    const blob = [m.sku, m.nombre].join(' ').toLowerCase();
                    return blob.includes(q);
                });

                const tbody = document.getElementById('prevMuestra');
                if (tbody) {
                    if (!filtrados.length) {
                        tbody.innerHTML = '<tr><td colspan="10">No hay refacciones nuevas ni por modificar.</td></tr>';
                    } else {
                        tbody.innerHTML = filtrados.map(m => {
                            const cambios = Array.isArray(m.cambios) ? m.cambios : [];
                            const detalle = cambios.length
                                ? `<div class="ref-prev-cambios">${cambios.map(c => `
                                        <span class="ref-prev-cambio">
                                            <span class="campo">${esc(c.campo)}:</span>
                                            <span class="antes">${esc(c.antes)}</span>
                                            <span class="flecha">&rarr;</span>
                                            <span class="despues">${esc(c.despues)}</span>
                                        </span>`).join('')}</div>`
                                : '<span style="color:var(--ref-text-muted);">—</span>';

                            return `
                            <tr>
                                <td><span class="ref-prev-accion ${m.accion === 'Nuevo' ? 'nuevo' : 'actualizar'}">${esc(m.accion)}</span></td>
                                <td><b>${esc(m.sku)}</b></td>
                                <td>
                                    <span class="badge" style="background:var(--ref-brand); font-size:.62rem;">${esc(m.planta || 'Sin planta')}</span>
                                    ${(Array.isArray(m.almacenes) && m.almacenes.length)
                                        ? `<div style="font-size:.62rem; color:var(--ref-text-muted);">${esc(m.almacenes.map(a => a.codigo).filter(Boolean).join(', '))}</div>`
                                        : ''}
                                </td>
                                <td>${esc(m.nombre)}</td>
                                <td>${esc(m.unidadMedidaInventario || '—')}</td>
                                <td>${detalle}</td>
                                <td class="text-end">${m.grupo == null ? '—' : esc(m.grupo)}</td>
                                <td class="text-end">${num(m.costo)}</td>
                                <td class="text-end">${num(m.stock)}</td>
                                <td class="text-end">${num(m.disponible)}</td>
                            </tr>`;
                        }).join('');
                    }
                }

                const cont = document.getElementById('prevMostrados');
                if (cont) cont.textContent = filtrados.length;
            }

            function descargarPreviaCsv() {
                if (!previaSapItems.length) { alert('No hay artículos para exportar.'); return; }

                const escCsv = (v) => {
                    const s = (v == null ? '' : String(v));
                    return /[",\n\r;]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s;
                };
                const cab = ['Accion', 'SKU', 'Planta', 'Almacenes', 'Descripcion', 'Unidad inventario', 'Cambios', 'Grupo', 'Costo', 'Stock', 'Disponible'];
                const lineas = [cab.join(',')];
                for (const m of previaSapItems) {
                    const cambiosTxt = (m.cambios || []).map(c => `${c.campo}: ${c.antes} -> ${c.despues}`).join(' | ');
                    const almacenesTxt = (m.almacenes || []).map(a => a.codigo).filter(Boolean).join(' ');
                    lineas.push([
                        escCsv(m.accion), escCsv(m.sku), escCsv(m.planta || 'Sin planta'), escCsv(almacenesTxt),
                        escCsv(m.nombre), escCsv(m.unidadMedidaInventario), escCsv(cambiosTxt),
                        escCsv(m.grupo), escCsv(m.costo), escCsv(m.stock), escCsv(m.disponible)
                    ].join(','));
                }

                const blob = new Blob(['\uFEFF' + lineas.join('\r\n')], { type: 'text/csv;charset=utf-8;' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = 'refacciones_sap_' + new Date().toISOString().slice(0, 10) + '.csv';
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
            }

            async function confirmarSincronizacionSap() {
                const btn = document.getElementById('btnConfirmarSyncSap');
                if (btn) { btn.disabled = true; }
                const htmlOriginal = btn ? btn.innerHTML : '';
                if (btn) { btn.innerHTML = '<i class="bi bi-arrow-repeat ref-spin"></i> Guardando...'; }
                mostrarLoadingRef('Importando a refacciones...');

                try {
                    const res = await postJson(URL_SYNC_SAP, {});
                    if (!res || !res.ok) {
                        alert((res && res.mensaje) || 'No se pudo importar a refacciones.');
                        return;
                    }

                    cerrarModal('modalPreviaSap');
                    await cargarDatos();
                    revisarPendientesSap();
                    alert(res.mensaje);
                } catch (e) {
                    console.error(e);
                    alert('Error al importar a refacciones.');
                } finally {
                    ocultarLoadingRef();
                    if (btn) { btn.disabled = false; btn.innerHTML = htmlOriginal; }
                }
            }

            // =========================================================
            // VISTA POS DUAL (Punto de Venta)
            // =========================================================
            let posLineas = [];
            let posModoMaquina = 'unica';

            function abrirPos() {
                posLineas = [];
                posModoMaquina = 'unica';
                $('#posScan, #posMaquina, #posRef, #posComment').val('');

                cambiarModoMaquina(posModoMaquina);
                filtrarCatalogoPos();

                $('#vistaInventario, #vistaSolicitudCompraSap').hide();
                document.getElementById('btnAbrirSolicitudCompraSap')?.classList.remove('active');
                $('#vistaPos').show();
                $('#posScan').trigger('focus');
            }

            function limpiarPos() {
                if(posLineas.length > 0 && !confirm("¿Borrar todos los artículos escaneados?")) return;
                posLineas = [];
                $('#posScan, #posMaquina, #posRef, #posComment').val('');
                renderPos();
                $('#posScan').trigger('focus');
            }

            function filtrarCatalogoPos() {
                const q = ($('#posScan').val() || '').trim().toLowerCase();
                const cont = $('#posGridCatalog');
                cont.empty();

                let filtrados = [];

                if (q) {
                    // Si escribiste algo en el buscador, mostramos los resultados del catálogo
                    filtrados = inventario.filter(item => {
                        return enPlantaRef(item) &&
                            (item.sku.toLowerCase().includes(q) || item.desc.toLowerCase().includes(q));
                    });
                } else {
                    // Si no hay búsqueda, SÓLO mostramos lo que ya escaneaste (tu ticket)
                    if (posLineas.length === 0) {
                        cont.append(`
                            <div class="ref-empty" style="grid-column: 1/-1; padding-top: 60px;">
                                <i class="bi bi-upc-scan" style="font-size: 3rem; opacity: 0.15; color: var(--ref-text);"></i>
                                <p class="mt-3 text-muted fw-bold">Aún no hay artículos escaneados.</p>
                                <p class="text-muted" style="font-size: 0.8rem;">Busca por nombre o escanea un código para empezar.</p>
                            </div>
                        `);
                        return;
                    }

                    // Filtramos para sacar solo los que están en la lista de salida
                    const idsEnTicket = posLineas.map(l => l.id);
                    filtrados = inventario.filter(item => idsEnTicket.includes(item.id));
                }

                // Ordenamiento
                filtrados.sort((a, b) => {
                    if(a.stock > 0 && b.stock <= 0) return -1;
                    if(a.stock <= 0 && b.stock > 0) return 1;
                    return a.desc.localeCompare(b.desc);
                });

                const limite = filtrados.slice(0, 100);

                if (limite.length === 0) {
                    cont.append('<div class="ref-empty" style="grid-column: 1/-1;">No se encontraron refacciones.</div>');
                    return;
                }

                limite.forEach(item => {
                    const img = item.foto
                        ? `<img src="${escapeHtml(item.foto)}" loading="lazy" />`
                        : `<div class="no-foto"><i class="bi bi-box-seam"></i></div>`;

                    const agotadoClass = item.stock <= 0 ? 'agotado' : '';

                    // Globito para saber cuántos llevas de este artículo
                    const qtyEnTicket = posLineas.find(l => l.id === item.id)?.cantidad || 0;
                    const badgeEnTicket = qtyEnTicket > 0
                        ? `<div style="position:absolute; top:6px; left:6px; background:#2563eb; color:white; font-size:0.65rem; font-weight:800; padding:2px 6px; border-radius:6px; z-index:2;">Llevas ${qtyEnTicket}</div>`
                        : '';

                    cont.append(`
                        <div class="ref-pos-item ${agotadoClass}" onclick="procesarClicCatalogoPos('${item.sku}')" title="${escapeHtml(item.desc)}">
                            ${badgeEnTicket}
                            <div class="stock">${item.stock}</div>
                            ${img}
                            <div class="sku">${escapeHtml(item.sku)}</div>
                            <div class="desc">${escapeHtml(item.desc)}</div>
                            <div class="desc" style="font-size:.68rem; opacity:.75;">Unidad: ${escapeHtml(item.unidadMedidaInventario || '—')}</div>
                            <div class="desc" style="font-size:.66rem; opacity:.7;">${escapeHtml(plantaDeItem(item))}${almacenesDeItem(item) ? ' · ' + escapeHtml(almacenesDeItem(item)) : ''}</div>
                        </div>
                    `);
                });
            }

            function procesarClicCatalogoPos(skuCode) {
                procesarEscaneo(skuCode);
                $('#posScan').val('').trigger('focus');
                filtrarCatalogoPos();
            }

            function procesarEscaneo(valor) {
                const sku = normalizarCodigo(valor);
                if (!sku) return;

                const item = inventario.find(x => canonSku(x.sku) === canonSku(sku) && enPlantaRef(x));
                if (!item) {
                    alert(`No existe la refacción con SKU "${sku}" en la planta seleccionada.`);
                    $('#posScan').val('').trigger('focus');
                    return;
                }

                const linea = posLineas.find(l => l.id === item.id);
                if (linea) {
                    if (linea.cantidad >= item.stock) {
                        alert(`Stock insuficiente para "${item.desc}". Disponible: ${item.stock}.`);
                        $('#posScan').val('').trigger('focus');
                        return;
                    }
                    linea.cantidad++;
                } else {
                    if (item.stock <= 0) {
                        alert(`"${item.desc}" se encuentra agotado.`);
                        $('#posScan').val('').trigger('focus');
                        return;
                    }
                    posLineas.push({ id: item.id, sku: item.sku, desc: item.desc, stock: item.stock, cantidad: 1, maquina: '', sap: valoresPredeterminadosSap(), foto: item.foto, unidad: item.unidadMedidaInventario || 'PZAS' });
                }

                // Bip auditivo
                try {
                    let context = new (window.AudioContext || window.webkitAudioContext)();
                    let osc = context.createOscillator();
                    let gain = context.createGain();
                    osc.connect(gain);
                    gain.connect(context.destination);
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(800, context.currentTime);
                    gain.gain.setValueAtTime(0.1, context.currentTime);
                    osc.start();
                    osc.stop(context.currentTime + 0.1);
                } catch(e){}

                // ¡AQUÍ ESTÁ LA MAGIA! Limpiar la caja a la de a fuerza
                $('#posScan').val('');

                renderPos();          // Repinta el ticket derecho
                filtrarCatalogoPos(); // Repinta el catálogo izquierdo para que muestre el resumen

                const divLista = document.getElementById('posLista');
                if (divLista) setTimeout(() => divLista.scrollTop = divLista.scrollHeight, 50);

                $('#posScan').trigger('focus');
            }

            function cambiarModoMaquina(modo) {
                posModoMaquina = modo === 'porArticulo' ? 'porArticulo' : 'unica';
                $('#btnPosModoUnica').toggleClass('active', posModoMaquina === 'unica');
                $('#btnPosModoPorArticulo').toggleClass('active', posModoMaquina === 'porArticulo');
                $('#divPosMaquinaGlobal').toggle(posModoMaquina === 'unica');
                renderPos();
            }

            function setMaquinaPos(id, valor) {
                const linea = posLineas.find(l => l.id === id);
                if (linea) linea.maquina = valor;
            }

            function setSapPos(id, campo, valor) {
                const linea = posLineas.find(l => l.id === id);
                if (!linea) return;
                linea.sap = linea.sap || valoresPredeterminadosSap();
                linea.sap[campo] = valor;
            }

            function cerrarPos() {
                $('#vistaPos').hide();
                $('#vistaInventario').show();
                document.getElementById('btnAbrirSolicitudCompraSap')?.classList.remove('active');
                renderTarjetas();
            }

            function cambiarCantidadPos(id, delta) {
                const linea = posLineas.find(l => l.id === id);
                if (!linea) return;

                const nueva = linea.cantidad + delta;
                if (nueva < 1) { quitarLineaPos(id); return; }
                if (nueva > linea.stock) {
                    alert(`Solo hay ${linea.stock} pieza(s) disponibles.`);
                    return;
                }

                linea.cantidad = nueva; 
                renderPos();
            }

            function quitarLineaPos(id) {
                posLineas = posLineas.filter(l => l.id !== id);
                renderPos();
            }

            function renderPos() {
                const cont = $('#posLista');
                cont.empty();

                const totalPiezas = posLineas.reduce((s, l) => s + l.cantidad, 0);
                $('#posResumen').text(`${posLineas.length} artículo(s) • ${totalPiezas} pza(s)`);

                if (posLineas.length === 0) {
                    cont.append(`
                        <div class="ref-empty" style="padding-top: 40px;">
                            <i class="bi bi-upc-scan" style="font-size: 2rem; opacity: 0.3;"></i>
                            <p class="mt-2 mb-0">Escanea o selecciona refacciones del catálogo.</p>
                        </div>`);
                    return;
                }

                const camposVisibles = camposSapSalida.filter(campo =>
                    (valorConfigSap(sapSalidaConfig.opciones || {}, campo.key) || []).length > 0);
                const maquinaColumna = posModoMaquina === 'porArticulo' ? '<th class="pos-machine-cell">Máquina / Equipo</th>' : '';
                const encabezadosSap = camposVisibles.map(campo => `<th class="pos-select-cell">${campo.label}</th>`).join('');
                let filas = '';

                posLineas.forEach(l => {
                    const itemInventario = inventario.find(x => Number(x.id) === Number(l.id));
                    const opcionesMaquina = '<option value="">Seleccionar máquina...</option>' +
                        maquinas.map(m => {
                            const sel = (l.maquina || '') === m.nombre ? ' selected' : '';
                            return `<option value="${escapeHtml(m.nombre)}"${sel}>${escapeHtml(m.nombre)}</option>`;
                        }).join('');
                    const maquinaCelda = posModoMaquina === 'porArticulo'
                        ? `<td class="pos-machine-cell"><select class="form-select form-select-sm select2-dinamico" onchange="setMaquinaPos(${l.id}, this.value)">${opcionesMaquina}</select></td>`
                        : '';

                    const fotoHtml = l.foto
                        ? `<img src="${escapeHtml(l.foto)}" style="width:34px;height:34px;border-radius:6px;object-fit:cover;border:1px solid var(--ref-border);flex-shrink:0;">`
                        : `<span class="d-inline-flex align-items-center justify-content-center" style="width:34px;height:34px;border-radius:6px;background:var(--ref-bg);border:1px dashed var(--ref-border);color:var(--ref-text-muted);flex-shrink:0;"><i class="bi bi-box"></i></span>`;
                    const sapCeldas = camposVisibles.map(campo => {
                        const lista = campo.key === 'WarehouseCode'
                            ? almacenesPermitidosItem(itemInventario)
                            : valorConfigSap(sapSalidaConfig.opciones || {}, campo.key) || [];
                        const valorActual = l.sap && l.sap[campo.key] !== undefined
                            ? l.sap[campo.key]
                            : (valorConfigSap(sapSalidaConfig.valores || {}, campo.key) || '');
                        const seleccionado = lista.includes(valorActual) ? valorActual : (campo.requerido ? lista[0] : '');
                        l.sap = l.sap || {};
                        l.sap[campo.key] = seleccionado;
                        const opcionVacia = campo.requerido ? '' : '<option value="">(Sin asignar)</option>';
                        const opciones = lista.map(valor =>
                            `<option value="${escapeHtml(valor)}" ${String(valor) === String(seleccionado) ? 'selected' : ''}>${escapeHtml(etiquetaOpcionSap(campo.key, valor))}</option>`
                        ).join('');
                        const claseBusqueda = campo.key === 'AccountCode' ? ' select2-cuenta-sap' : '';
                        return `<td class="pos-select-cell"><select class="form-select form-select-sm${claseBusqueda}" aria-label="${campo.label} para ${escapeHtml(l.sku)}" onchange="setSapPos(${l.id}, '${campo.key}', this.value)">${opcionVacia}${opciones}</select></td>`;
                    }).join('');

                    filas += `<tr>
                        <td class="pos-articulo-cell"><div class="d-flex align-items-center gap-2">${fotoHtml}<div class="min-w-0"><div class="fw-bold text-truncate" title="${escapeHtml(l.desc)}">${escapeHtml(l.desc)}</div><small class="text-muted">${escapeHtml(l.sku)} · Disponible: ${l.stock}</small></div></div></td>
                        <td class="pos-qty-cell"><div class="ref-pos-line-controls"><button type="button" title="Quitar 1" onclick="cambiarCantidadPos(${l.id}, -1)"><i class="bi bi-dash"></i></button><span>${l.cantidad}</span><button type="button" title="Agregar 1" onclick="cambiarCantidadPos(${l.id}, 1)"><i class="bi bi-plus"></i></button></div><button class="btn btn-link text-danger p-0 ms-1 border-0" title="Quitar artículo" onclick="quitarLineaPos(${l.id})"><i class="bi bi-x-circle-fill"></i></button></td>
                        ${maquinaCelda}${sapCeldas}
                    </tr>`;
                });

                cont.html(`<table class="pos-sap-table"><thead><tr><th class="pos-articulo-cell">Artículo</th><th class="pos-qty-cell">Cantidad</th>${maquinaColumna}${encabezadosSap}</tr></thead><tbody>${filas}</tbody></table>`);

                if ($.fn.select2) {
                    cont.find('.select2-cuenta-sap').select2({
                        width: '100%',
                        minimumResultsForSearch: 0,
                        dropdownParent: $('#vistaPos')
                    });
                }

                // === INICIALIZAR SELECT2 EN LAS LÍNEAS DEL POS DUAL ===
                if (posModoMaquina === 'porArticulo') {
                     $('.select2-dinamico').select2({
                        width: '100%',
                        dropdownParent: $('#vistaPos') // Esto evita que el panel flote raro en la vista POS
                    });
                }
            }

            async function confirmarPos() {
                if (posLineas.length === 0) {
                    alert('La lista de salida está vacía.');
                    return;
                }

                let maquina = '';
                if (posModoMaquina === 'unica') {
                    maquina = ($('#posMaquina').val() || '').trim();
                    if (!maquina) {
                        alert('Selecciona la máquina o equipo destino para la salida.');
                        $('#posMaquina').trigger('focus');
                        return;
                    }
                } else {
                    const sinMaquina = posLineas.find(l => !(l.maquina || '').trim());
                    if (sinMaquina) {
                        alert(`Asigna la máquina o equipo destino para "${sinMaquina.desc}".`);
                        return;
                    }
                }

                // Abrir la ventana de tickets dentro del clic del usuario para que el
                // navegador no bloquee la impresión después de esperar al servidor.
                const ventanaTickets = window.open('', '_blank');
                if (ventanaTickets) {
                    ventanaTickets.document.write('<!doctype html><title>Generando tickets...</title><p style="font:16px Arial;padding:24px">Generando los tickets de salida...</p>');
                }

                const btn = document.querySelector('#vistaPos .ref-btn-brand');
                const originalHtml = btn.innerHTML;
                btn.innerHTML = '<i class="bi bi-arrow-repeat ref-spin me-2"></i> Procesando...';
                btn.disabled = true;

                const datos = {
                    lineas: posLineas.map(l => ({
                        id: l.id,
                        cantidad: l.cantidad,
                        maquina: posModoMaquina === 'porArticulo' ? (l.maquina || '').trim() : '',
                        sap: l.sap || valoresPredeterminadosSap()
                    })),
                    maquina: maquina,
                    referencia: ($('#posRef').val() || '').trim(),
                    comentario: ($('#posComment').val() || '').trim()
                };

            try {
                                const res = await postJson(URL_SALIDA_POS, datos);
                                if (!res || !res.ok) {
                                    if (ventanaTickets) ventanaTickets.close();
                                    alert((res && res.mensaje) || 'No se pudo registrar la salida.');
                                    return;
                                }

                                const datosTicket = {
                                    folio: res.folio || '',
                                    fecha: new Date(),
                                    usuario: usuarioSesion,
                                    referencia: datos.referencia,
                                    comentario: datos.comentario,
                                    maquina: maquina,
                                    lineas: posLineas.map(l => ({
                                        sku: l.sku,
                                        desc: l.desc,
                                        cantidad: l.cantidad,
                                        unidad: l.unidad,
                                        maquina: posModoMaquina === 'porArticulo' ? (l.maquina || '') : ''
                                    }))
                                };

                                alert(res.mensaje + (res.folio ? ` Folio: ${res.folio}` : ''));

                                if (ventanaTickets) {
                                    imprimirTicketsSalida(ventanaTickets, datosTicket);
                                } else {
                                    alert('Permite las ventanas emergentes para imprimir los tickets de salida.');
                                }

                                posLineas = [];
                                cerrarPos();
                                await cargarDatos();
                            } catch (e) {
                                if (ventanaTickets) ventanaTickets.close();
                                alert('Ocurrió un error al intentar registrar la salida. Revisa la consola.');
                                console.error(e);
                            } finally {
                                btn.innerHTML = originalHtml;
                                btn.disabled = false;
                            }
                        }

        </script>
}
