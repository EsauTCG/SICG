            async function registrarRecepcionSap(solicitudId, ordenDocEntry, ordenDocNum) {
                const seccion = document.getElementById(`recepcionOrden-${solicitudId}-${ordenDocEntry}`);
                const inputs = [...(seccion?.querySelectorAll('.recepcion-cantidad') || [])];
                const lineas = inputs.map(i => ({ lineNum: Number(i.dataset.line), cantidad: Number(i.value || 0) })).filter(x => x.cantidad > 0);
                if (!lineas.length) { alert('Captura la cantidad recibida en al menos un artículo.'); return; }
                const excede = inputs.some(i => Number(i.value || 0) > Number(i.max || 0));
                if (excede) { alert('Una cantidad excede lo pendiente en SAP. Actualiza la lista y vuelve a intentarlo.'); return; }
                if (!confirm(`¿Registrar en SAP y SIGO las cantidades recibidas de la orden ${ordenDocNum}?`)) return;
                const comentario = prompt('Comentario de recepción (opcional):', '') || '';
                mostrarLoadingRef('Registrando la entrada en SAP...');
                try {
                    const res = await postJson(URL_REGISTRAR_RECEPCION_SAP, { solicitudCompraId: solicitudId, ordenCompraDocEntry: ordenDocEntry, comentario, lineas });
                    if (!res?.ok) throw new Error(res?.mensaje || 'No se pudo registrar la recepción.');
                    alert(res.mensaje || 'Entrada registrada.');
                    await cargarDatos();
                    await cargarOrdenesCompraRecepcionSap();
                } catch (error) { alert(error.message || 'Error al registrar la entrada.'); }
                finally { ocultarLoadingRef(); }
            }

            async function reaplicarInventarioRecepcionSap(id) {
                if (!confirm('SAP ya registró esta entrada. ¿Actualizar ahora el inventario y el kardex de SIGO?')) return;
                mostrarLoadingRef('Sincronizando inventario de SIGO...');
                try {
                    const res = await postJson(URL_REAPLICAR_RECEPCION_SAP, { id });
                    if (!res?.ok) throw new Error(res?.mensaje || 'No se pudo sincronizar SIGO.');
                    alert(res.mensaje || 'Inventario sincronizado.');
                    await cargarDatos();
                    await cargarOrdenesCompraRecepcionSap();
                } catch (error) { alert(error.message || 'Error al sincronizar inventario.'); }
                finally { ocultarLoadingRef(); }
            }

            async function reintentarRecepcionCompraSap(id) {
                if (!confirm('Se comprobará primero si SAP ya creó el documento. ¿Reintentar esta misma recepción?')) return;
                mostrarLoadingRef('Verificando la recepción en SAP...');
