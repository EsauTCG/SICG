            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s ease;
        }

            .ref-pos-line-controls button:hover {
                background: rgba(0,0,0,0.04);
                color: var(--ref-brand);
            }

        .ref-pos-line-controls span {
            font-size: 0.85rem;
            font-weight: 800;
            padding: 0 4px;
            min-width: 26px;
            text-align: center;
            color: var(--ref-text);
        }
