    body[data-theme="dark"] .icon-out {
      background: #351f22;
      color: #ff9a9f;
    }

    body[data-theme="dark"] .icon-in {
      background: #173426;
      color: #72dba5;
    }

    body[data-theme="dark"] .icon-adj {
      background: #182b48;
      color: #82b1ff;
    }

    body[data-theme="dark"] .ref-empty {
      color: var(--ref-text-muted);
    }

    body[data-theme="dark"] .ref-cat-item {
      background: var(--ref-card);
    }

    body[data-theme="dark"] .modal-ref .modal-content {
