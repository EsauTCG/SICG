    }

        .ref-pos-ticket-header h6 {
            margin: 0;
            font-weight: 800;
            color: var(--ref-text);
        }

    #posLista {
        flex: 1;
        overflow-y: auto;
        min-height: 200px;
    }

    /* Footer y boton principal */
    .ref-pos-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 16px;
        border-top: 1px dashed var(--ref-border);
        margin-top: auto;
    }

    .ref-btn-brand {
        background: linear-gradient(135deg, var(--ref-brand-dark), var(--ref-brand));
        color: white;
        border: none;0
        padding: 8px 20px;
        border-radius: 8px;
        font-weight: 700;
        font-size: 0.9rem;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        transition: filter 0.2s ease;
    }

        .ref-btn-brand:hover {
            filter: brightness(1.15);
        }

    /* =========================================
           Líneas de los artículos en el Ticket
           ========================================= */
    .ref-pos-line {
        display: flex;
        align-items: center;
        padding: 12px 0;
        border-bottom: 1px solid var(--ref-border);
        gap: 10px;
    }

        .ref-pos-line:last-child {
            border-bottom: none;
        }

    .ref-pos-line-info {
        flex: 1;
        min-width: 0; /* Para que textos largos no rompan el flex */
    }

        .ref-pos-line-info .name {
            margin: 0 0 2px 0;
            font-size: 0.8rem;
            font-weight: 800;
            color: var(--ref-text);
            line-height: 1.2;
        }

        .ref-pos-line-info .meta {
