                        '</bo' + 'dy>',
                        '</ht' + 'ml>'
                    ].join('\n');

                    ventana.document.open();
                    ventana.document.write(html);
                    ventana.document.close();
                    setTimeout(() => { ventana.focus(); ventana.print(); }, 250);
                } catch (error) {
                    ventana.close();
                    alert(error.message || 'No se pudo recuperar la orden desde SAP.');
                }
            }

