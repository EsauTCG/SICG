@section Scripts {
        <!-- CSS de Select2 -->
        <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

        <!-- JS de Select2 -->
        <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
        <script>
            let inventario = [];
            let movimientos = [];
            let categorias = [];
            let ubicaciones = [];
            let maquinas = [];
            let sapSalidaConfig = {};

            let filtroActual = 'Todos';
            let plantaRefGlobal = (localStorage.getItem('refPlantaGlobal') || 'TIF').toUpperCase();
            if (plantaRefGlobal !== 'TIF' && plantaRefGlobal !== 'P1') plantaRefGlobal = 'TIF';
            let verTodosMovimientos = false;
            let modoVista = 'grid';
            let paginaRef = 1;
            let tamPaginaRef = 24;
            let totalPaginasRef = 1;
            let alertasRefActuales = [];
            let alertasSeleccionadasSolicitud = new Set();
            let scanBuffer = '';
            let lastScanKeyTime = 0;

            const URL_CARGAR = '@Url.Action("Cargar", "InventarioRefacciones")' || '/InventarioRefacciones/Cargar';
            const URL_GUARDAR_REF = '@Url.Action("GuardarRefaccion", "InventarioRefacciones")' || '/InventarioRefacciones/GuardarRefaccion';
            const URL_MARCAR_SOLICITUD_STOCK = '@Url.Action("MarcarSolicitudStock", "InventarioRefacciones")' || '/InventarioRefacciones/MarcarSolicitudStock';
            const URL_EXPORTAR_PENDIENTES_EXCEL = '@Url.Action("ExportarPendientesExcel", "InventarioRefacciones")' || '/InventarioRefacciones/ExportarPendientesExcel';
            const URL_MOVIMIENTO = '@Url.Action("RegistrarMovimiento", "InventarioRefacciones")' || '/InventarioRefacciones/RegistrarMovimiento';
            const URL_SALIDA_POS = '@Url.Action("RegistrarSalidaPos", "InventarioRefacciones")' || '/InventarioRefacciones/RegistrarSalidaPos';
            const URL_SALIDAS_POS_REIMPRESION = '@Url.Action("SalidasPosRecientes", "InventarioRefacciones")' || '/InventarioRefacciones/SalidasPosRecientes';
            const URL_SALIDAS_SAP_PENDIENTES = '@Url.Action("SalidasSapPendientes", "InventarioRefacciones")' || '/InventarioRefacciones/SalidasSapPendientes';
            const URL_SALIDAS_SAP_ENVIADAS = '@Url.Action("SalidasSapEnviadas", "InventarioRefacciones")' || '/InventarioRefacciones/SalidasSapEnviadas';
            const URL_ENVIAR_SALIDA_SAP = '@Url.Action("EnviarSalidaSap", "InventarioRefacciones")' || '/InventarioRefacciones/EnviarSalidaSap';
            const URL_OBTENER_SALIDA_EDITABLE = '@Url.Action("ObtenerSalidaSapParaEditar", "InventarioRefacciones")' || '/InventarioRefacciones/ObtenerSalidaSapParaEditar';
            const URL_EDITAR_SALIDA_SAP = '@Url.Action("EditarSalidaSap", "InventarioRefacciones")' || '/InventarioRefacciones/EditarSalidaSap';
            const URL_CREAR_SOLICITUD_COMPRA_SAP = '@Url.Action("CrearSolicitudCompraSap", "InventarioRefacciones")' || '/InventarioRefacciones/CrearSolicitudCompraSap';
            const URL_LISTAR_SOLICITUDES_COMPRA_SAP = '@Url.Action("SolicitudesCompraSapRefacciones", "InventarioRefacciones")' || '/InventarioRefacciones/SolicitudesCompraSapRefacciones';
            const URL_ENVIAR_SOLICITUD_COMPRA_SAP = '@Url.Action("EnviarSolicitudCompraSapRefacciones", "InventarioRefacciones")' || '/InventarioRefacciones/EnviarSolicitudCompraSapRefacciones';
            const URL_REVISAR_SOLICITUD_COMPRA_SAP = '@Url.Action("RevisarSolicitudCompraSapRefacciones", "InventarioRefacciones")' || '/InventarioRefacciones/RevisarSolicitudCompraSapRefacciones';
            const URL_AUTORIZAR_SOLICITUD_COMPRA_SAP = '@Url.Action("AutorizarSolicitudCompraSapRefacciones", "InventarioRefacciones")' || '/InventarioRefacciones/AutorizarSolicitudCompraSapRefacciones';
            const URL_ORDENES_RECEPCION_SAP = '@Url.Action("OrdenesCompraPendientesRecepcionSap", "InventarioRefacciones")' || '/InventarioRefacciones/OrdenesCompraPendientesRecepcionSap';
            const URL_REGISTRAR_RECEPCION_SAP = '@Url.Action("RegistrarRecepcionCompraSap", "InventarioRefacciones")' || '/InventarioRefacciones/RegistrarRecepcionCompraSap';
            const URL_REAPLICAR_RECEPCION_SAP = '@Url.Action("ReaplicarInventarioRecepcionSap", "InventarioRefacciones")' || '/InventarioRefacciones/ReaplicarInventarioRecepcionSap';
            const URL_REINTENTAR_RECEPCION_SAP = '@Url.Action("ReintentarRecepcionCompraSap", "InventarioRefacciones")' || '/InventarioRefacciones/ReintentarRecepcionCompraSap';
            const URL_DOCUMENTO_ORDEN_COMPRA_SAP = '@Url.Action("ObtenerDocumentoOrdenCompraRecepcionSap", "InventarioRefacciones")' || '/InventarioRefacciones/ObtenerDocumentoOrdenCompraRecepcionSap';
            const URL_GUARDAR_CAT = '@Url.Action("GuardarCategoria", "InventarioRefacciones")' || '/InventarioRefacciones/GuardarCategoria';
            const URL_ELIMINAR_CAT = '@Url.Action("EliminarCategoria", "InventarioRefacciones")' || '/InventarioRefacciones/EliminarCategoria';
            const URL_GUARDAR_UBI = '@Url.Action("GuardarUbicacion", "InventarioRefacciones")' || '/InventarioRefacciones/GuardarUbicacion';
            const URL_ELIMINAR_UBI = '@Url.Action("EliminarUbicacion", "InventarioRefacciones")' || '/InventarioRefacciones/EliminarUbicacion';
            const URL_GUARDAR_MAQ = '@Url.Action("GuardarMaquina", "InventarioRefacciones")' || '/InventarioRefacciones/GuardarMaquina';
            const URL_ELIMINAR_MAQ = '@Url.Action("EliminarMaquina", "InventarioRefacciones")' || '/InventarioRefacciones/EliminarMaquina';
            const URL_SUBIR_FOTO = '@Url.Action("SubirFoto", "InventarioRefacciones")' || '/InventarioRefacciones/SubirFoto';
            const URL_ELIMINAR_FOTO = '@Url.Action("EliminarFoto", "InventarioRefacciones")' || '/InventarioRefacciones/EliminarFoto';
            const URL_SYNC_SAP = '@Url.Action("SincronizarSap", "InventarioRefacciones")' || '/InventarioRefacciones/SincronizarSap';
            const URL_PREVIA_SAP = '@Url.Action("PreviaSap", "InventarioRefacciones")' || '/InventarioRefacciones/PreviaSap';
            const URL_GENERAR_QR = '@Url.Action("GenerarQR", "InventarioRefacciones")' || '/InventarioRefacciones/GenerarQR';
            const URL_GUARDAR_VISTA = '@Url.Action("GuardarVista", "InventarioRefacciones")' || '/InventarioRefacciones/GuardarVista';

            async function postJson(url, data) {
                const res = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                    body: JSON.stringify(data || {})
                });
                return await res.json();
            }

            function mostrarLoadingRef(txt) {
                const el = document.getElementById('refLoading');
                const t = document.getElementById('refLoadingTxt');
                if (t && txt) t.textContent = txt;
                if (el) el.classList.add('show');
            }

            function ocultarLoadingRef() {
                const el = document.getElementById('refLoading');
                if (el) el.classList.remove('show');
            }

            async function getJson(url) {
                const res = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                return await res.json();
            }

            async function cargarDatos() {
                try {
                    const res = await fetch(URL_CARGAR, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                    const data = await res.json();

                    if (!data || !data.ok) {
                        alert('No se pudo cargar la información de la base de datos.');
                        return;
                    }

                    inventario = data.refacciones || [];
                    categorias = data.categorias || [];
                    ubicaciones = data.ubicaciones || [];
                    maquinas = data.maquinas || [];
                    movimientos = data.movimientos || [];
                    sapSalidaConfig = data.sap || {};

                    modoVista = data.vista === 'table' ? 'table' : 'grid';
                    aplicarModoVistaUI();

                    renderTabs();
                    renderSelectsCatalogos();
                    renderCatalogos();
                    renderUI();
                    cargarSalidasSapPendientes();
                } catch (e) {
                    console.error(e);
                    alert('Error al cargar la información.');
                }
            }

            // Serialize as a JavaScript string so session text cannot inject HTML
            // or close this inline script when Razor renders the view.
            const usuarioSesion = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(usuarioActual));

            function abrirModal(id) {
                const el = document.getElementById(id);
                if (el) bootstrap.Modal.getOrCreateInstance(el).show();
            }

            async function abrirSalidasSapPendientes() {
                abrirModal('modalSalidasSap');
                await cargarSalidasSapPendientes();
            }

            let volverAlModalSalidasSap = false;

            async function abrirSalidasSapEnviadas() {
                await cargarSalidasSapEnviadas();
                const pendientes = document.getElementById('modalSalidasSap');
                const enviadas = document.getElementById('modalSalidasSapEnviadas');
                if (pendientes && pendientes.classList.contains('show')) {
                    volverAlModalSalidasSap = true;
                    pendientes.addEventListener('hidden.bs.modal', function abrirHistorial() {
                        abrirModal('modalSalidasSapEnviadas');
                    }, { once: true });
                    bootstrap.Modal.getOrCreateInstance(pendientes).hide();
                } else if (enviadas) {
                    abrirModal('modalSalidasSapEnviadas');
                }
            }

            document.getElementById('modalSalidasSapEnviadas')?.addEventListener('hidden.bs.modal', async function () {
                if (!volverAlModalSalidasSap) return;
                volverAlModalSalidasSap = false;
                abrirModal('modalSalidasSap');
                await cargarSalidasSapPendientes();
            });

            // ------------------- Reimpresión de tickets de salida -------------------
            let salidasReimpresion = [];
            let salidasReimpresionFiltradas = [];

            async function abrirReimpresionSalidas() {
                abrirModal('modalReimprimirSalidas');
                const buscador = document.getElementById('buscarReimpresionSalida');
                if (buscador) buscador.value = '';
                await cargarSalidasReimpresion();
            }

            async function cargarSalidasReimpresion() {
                const tbody = document.getElementById('tbodyReimpresionSalidas');
                const resumen = document.getElementById('resumenReimpresionSalidas');
                if (tbody) tbody.innerHTML = '<tr><td colspan="6" class="text-center py-4">Cargando salidas...</td></tr>';
                if (resumen) resumen.textContent = 'Cargando...';

                try {
                    const res = await getJson(URL_SALIDAS_POS_REIMPRESION);
                    if (!res || !res.ok) throw new Error((res && res.mensaje) || 'No se pudieron consultar las salidas.');
                    salidasReimpresion = Array.isArray(res.items) ? res.items : [];
                    renderSalidasReimpresion();
                } catch (e) {
                    console.error(e);
                    salidasReimpresion = [];
                    salidasReimpresionFiltradas = [];
                    if (tbody) tbody.innerHTML = `<tr><td colspan="6" class="text-center py-4 text-danger">${escapeHtml(e.message || 'No se pudieron consultar las salidas.')}</td></tr>`;
                    if (resumen) resumen.textContent = '';
                }
            }

            function renderSalidasReimpresion() {
                const tbody = document.getElementById('tbodyReimpresionSalidas');
                const resumen = document.getElementById('resumenReimpresionSalidas');
                if (!tbody) return;

                const q = (document.getElementById('buscarReimpresionSalida')?.value || '').trim().toLowerCase();
                salidasReimpresionFiltradas = !q ? salidasReimpresion.slice() : salidasReimpresion.filter(s => {
                    const maquinas = (s.lineas || []).map(l => l.maquina || '').join(' ');
                    return [s.folio, s.referencia, s.usuario, s.comentario, maquinas]
                        .filter(Boolean).join(' ').toLowerCase().includes(q);
                });

                if (resumen) {
                    resumen.textContent = `${salidasReimpresionFiltradas.length} de ${salidasReimpresion.length} salida(s)`;
                }

                if (!salidasReimpresionFiltradas.length) {
                    tbody.innerHTML = `<tr><td colspan="6" class="text-center py-4">${salidasReimpresion.length ? 'Ninguna salida coincide con la búsqueda.' : 'Todavía no hay salidas registradas.'}</td></tr>`;
                    return;
                }

                tbody.innerHTML = salidasReimpresionFiltradas.map((s, i) => {
                    const fecha = s.fecha ? new Date(s.fecha).toLocaleString('es-MX') : '—';
                    const total = Number(s.totalPiezas || 0).toLocaleString('es-MX');
                    return `
                    <tr>
                        <td><strong>${escapeHtml(s.folio || '—')}</strong></td>
                        <td>${escapeHtml(fecha)}</td>
                        <td>${escapeHtml(s.referencia || '—')}</td>
                        <td>${Number(s.cantidadLineas || 0)} artículo(s)<br><small class="text-muted">${total} pieza(s)</small></td>
                        <td>${escapeHtml(s.usuario || '—')}</td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-primary" onclick="reimprimirTicketSalidaPorIndice(${i})">
                                <i class="bi bi-printer me-1"></i>Reimprimir
                            </button>
                        </td>
                    </tr>`;
                }).join('');
            }

            function reimprimirTicketSalidaPorIndice(indice) {
                const salida = salidasReimpresionFiltradas[indice];
                if (!salida) return;

                // Abrir la ventana dentro del clic para que el navegador no la bloquee.
                const ventana = window.open('', '_blank');
                if (!ventana) {
                    alert('Permite las ventanas emergentes para imprimir los tickets de salida.');
                    return;
                }
                ventana.document.write('<!doctype html><title>Generando ticket...</title><p style="font:16px Arial;padding:24px">Generando el ticket de salida...</p>');

                const lineas = Array.isArray(salida.lineas) ? salida.lineas : [];
                const maquinasLinea = Array.from(new Set(lineas.map(l => (l.maquina || '').trim()).filter(Boolean)));
                const maquinaUnica = maquinasLinea.length === 1 ? maquinasLinea[0] : '';

                imprimirTicketsSalida(ventana, {
                    folio: salida.folio,
                    fecha: salida.fecha ? new Date(salida.fecha) : new Date(),
                    usuario: salida.usuario,
                    referencia: salida.referencia,
                    comentario: salida.comentario,
                    maquina: maquinaUnica,
                    lineas: lineas.map(l => ({
                        sku: l.sku,
                        desc: l.desc,
                        cantidad: l.cantidad,
                        unidad: l.unidad,
                        maquina: maquinaUnica ? '' : (l.maquina || '')
                    }))
                });
            }

            function renderDetalleArticulosSap(articulos) {
                const lineas = Array.isArray(articulos) ? articulos : [];
                if (!lineas.length) return '<div class="text-muted small py-2">No hay detalle de artículos guardado para este documento.</div>';
                return `<div class="table-responsive"><table class="table table-sm table-bordered align-middle mb-0 bg-white">
                    <thead class="table-light"><tr><th>Artículo</th><th>Descripción</th><th class="text-end">Cantidad</th><th>Almacén</th><th>Cuenta</th></tr></thead>
                    <tbody>${lineas.map(a => `<tr>
                        <td><strong>${escapeHtml(a.itemCode || '—')}</strong></td>
                        <td>${escapeHtml(a.descripcion || '—')}</td>
                        <td class="text-end">${a.quantity ?? a.cantidad ?? '—'}</td>
                        <td>${escapeHtml(a.warehouseCode || a.almacen || '—')}</td>
                        <td>${escapeHtml(a.accountCode || a.cuentaContable || '—')}</td>
                    </tr>`).join('')}</tbody></table></div>`;
            }

            function toggleDetalleArticulosSap(id, boton) {
                const fila = document.getElementById(id);
                if (!fila) return;
                const mostrar = fila.classList.contains('d-none');
                fila.classList.toggle('d-none', !mostrar);
                boton.setAttribute('aria-expanded', mostrar ? 'true' : 'false');
                boton.innerHTML = mostrar
                    ? '<i class="bi bi-chevron-up me-1"></i>Ocultar artículos'
                    : '<i class="bi bi-list-ul me-1"></i>Ver artículos';
            }

            async function cargarSalidasSapEnviadas() {
                const tbody = document.getElementById('tbodySalidasSapEnviadas');
                if (!tbody) return;
                tbody.innerHTML = '<tr><td colspan="5" class="text-center">Cargando...</td></tr>';

                try {
                    const res = await getJson(URL_SALIDAS_SAP_ENVIADAS);
                    if (!res || !res.ok) throw new Error('No se pudo consultar el historial de salidas enviadas.');
                    const items = res.items || [];
                    if (!items.length) {
                        tbody.innerHTML = '<tr><td colspan="5" class="text-center py-4">Todavía no hay salidas enviadas a SAP.</td></tr>';
                        return;
                    }

                    tbody.innerHTML = items.map((s, index) => {
                        const detalleId = `salida-enviada-detalle-${index}`;
                        const cantidadArticulos = (s.articulos || []).length || s.cantidadLineas || 0;
                        return `<tr>
                            <td><strong>${escapeHtml(s.folio || '')}</strong><br><small>${escapeHtml(s.usuario || '')}</small></td>
                            <td><strong>${s.documentoSap ?? '—'}</strong></td>
                            <td>${s.fecha ? new Date(s.fecha).toLocaleString() : '—'}</td>
                            <td>${escapeHtml(s.referencia || '—')}</td>
                            <td><button type="button" class="btn btn-sm btn-outline-primary" aria-expanded="false" onclick="toggleDetalleArticulosSap('${detalleId}', this)"><i class="bi bi-list-ul me-1"></i>Ver ${cantidadArticulos} artículo(s)</button></td>
                        </tr>
                        <tr id="${detalleId}" class="d-none"><td colspan="5" class="p-2 bg-light">${renderDetalleArticulosSap(s.articulos)}</td></tr>`;
                    }).join('');
                } catch (e) {
                    console.error(e);
                    tbody.innerHTML = '<tr><td colspan="5" class="text-center text-danger py-4">No se pudo cargar el historial de salidas enviadas.</td></tr>';
                }
            }

            async function cargarSalidasSapPendientes() {
                try {
                    const res = await getJson(URL_SALIDAS_SAP_PENDIENTES);
                    if (!res || !res.ok) throw new Error(res?.mensaje || 'No se pudieron consultar las salidas pendientes.');

                    const items = res.items || [];
                    const badge = document.getElementById('badgeSalidasSap');
                    if (badge) {
                        badge.textContent = items.length > 99 ? '99+' : String(items.length);
                        badge.style.display = items.length ? '' : 'none';
                    }

                    const config = res.sap || {};
                    const textoConfig = config.habilitado
                        ? `Prueba configurada: almacén ${config.almacen}, cuenta ${config.cuenta}, dimensiones ${config.dimensiones.filter(Boolean).join(' / ')}.`
                        : 'El envío a SAP está deshabilitado en esta configuración.';
                    document.getElementById('salidasSapConfiguracion').textContent =
                        `Las salidas quedan registradas en Sigo antes del envío. ${textoConfig}`;

                    const tbody = document.getElementById('tbodySalidasSap');
                    if (!tbody) return;
                    if (!items.length) {
                        tbody.innerHTML = '<tr><td colspan="6" class="text-center py-4">No hay salidas pendientes de SAP.</td></tr>';
                        return;
                    }

                    tbody.innerHTML = items.map((s, index) => {
                        const detalleId = `salida-pendiente-detalle-${index}`;
                        const cantidadArticulos = (s.articulos || []).length || s.cantidadLineas || 0;
                        return `
                        <tr>
                            <td><strong>${escapeHtml(s.folio)}</strong><br><small>${escapeHtml(s.usuario || '')}</small></td>
                            <td>${s.fecha ? new Date(s.fecha).toLocaleString() : '—'}</td>
                            <td>${escapeHtml(s.referencia || '—')}</td>
                            <td><button type="button" class="btn btn-sm btn-outline-primary" aria-expanded="false" onclick="toggleDetalleArticulosSap('${detalleId}', this)"><i class="bi bi-list-ul me-1"></i>Ver ${cantidadArticulos} artículo(s)</button></td>
                            <td><span class="badge ${s.estado === 'ERROR' ? 'bg-danger' : 'bg-warning text-dark'}">${escapeHtml(s.estado)}</span></td>
                            <td>${s.error ? `<small class="text-danger d-block mb-1">${escapeHtml(s.error)}</small>` : ''}
                                <button type="button" class="btn btn-sm btn-outline-secondary me-1" onclick="abrirEdicionSalidaSap('${escapeHtml(s.folio)}')"><i class="bi bi-pencil me-1"></i>Editar</button>
                                <button type="button" class="btn btn-sm btn-outline-primary" ${config.habilitado ? '' : 'disabled'} onclick="enviarSalidaSap('${escapeHtml(s.folio)}')">
                                    <i class="bi bi-cloud-upload me-1"></i>${s.estado === 'PENDIENTE' ? 'Enviar a SAP' : 'Reintentar'}
                                </button>
                            </td>
                        </tr>
                        <tr id="${detalleId}" class="d-none"><td colspan="6" class="p-2 bg-light">${renderDetalleArticulosSap(s.articulos)}</td></tr>`;
                    }).join('');
                } catch (e) {
                    console.error(e);
                    const tbody = document.getElementById('tbodySalidasSap');
                    if (tbody) tbody.innerHTML = `<tr><td colspan="6" class="text-center text-danger py-4">${escapeHtml(e.message || 'No se pudieron cargar las salidas pendientes.')}</td></tr>`;
                }
            }

            let lineasEdicionSalida = [];
            let ordenesCompraRecepcionSap = [];

            async function abrirEdicionSalidaSap(folio) {
                try {
                    const res = await getJson(`${URL_OBTENER_SALIDA_EDITABLE}?folio=${encodeURIComponent(folio)}`);
                    if (!res?.ok) { alert(res?.mensaje || 'No se pudo abrir la salida.'); return; }
                    const salida = res.salida;
                    document.getElementById('editarSalidaFolio').value = salida.folio;
                    document.getElementById('editarSalidaReferencia').value = salida.referencia || '';
                    document.getElementById('editarSalidaComentario').value = salida.comentario || '';
                    lineasEdicionSalida = (salida.lineas || []).map(x => ({ id: x.id, cantidad: x.cantidad, maquina: x.maquina, sap: x.sap || {} }));
                    renderLineasEdicionSalida();
                    abrirModal('modalEditarSalidaSap');
                } catch (e) { console.error(e); alert('No se pudo cargar el detalle de la salida.'); }
            }

            function agregarLineaEdicionSalida() {
                const item = inventario.find(x => x.activo && x.stock > 0 && enPlantaRef(x));
                if (!item) { alert('No hay artículos activos con existencias para agregar.'); return; }
                lineasEdicionSalida.push({ id: item.id, cantidad: 1, maquina: '', sap: valoresPredeterminadosSap() });
                renderLineasEdicionSalida();
            }

            function renderLineasEdicionSalida() {
                const tbody = document.getElementById('tbodyEditarSalidaLineas');
                if (!tbody) return;
                const articulos = [...inventario].filter(x => x.activo && enPlantaRef(x)).sort((a, b) => a.sku.localeCompare(b.sku));
                const opcionesArticulos = articulos.map(x => `<option value="${x.id}">${escapeHtml(x.sku)} — ${escapeHtml(x.desc)}</option>`).join('');
                const opcionesMaquinas = maquinas.map(x => `<option value="${escapeHtml(x.nombre)}">${escapeHtml(x.nombre)}</option>`).join('');
                const camposEditablesSap = camposSapSalida.filter(campo => (valorConfigSap(sapSalidaConfig.opciones || {}, campo.key) || []).length > 0);
                tbody.innerHTML = lineasEdicionSalida.map((linea, i) => {
                    const item = articulos.find(x => x.id === Number(linea.id));
                    const maquinasHtml = linea.maquina && !maquinas.some(x => x.nombre === linea.maquina)
                        ? `<option value="${escapeHtml(linea.maquina)}">${escapeHtml(linea.maquina)}</option>` : '';
                    const camposHtml = camposEditablesSap.map(campo => {
                        const valores = campo.key === 'WarehouseCode'
                            ? almacenesPermitidosItem(item)
                            : valorConfigSap(sapSalidaConfig.opciones || {}, campo.key) || [];
                        const previo = linea.sap?.[campo.key] || valorConfigSap(sapSalidaConfig.valores || {}, campo.key) || '';
                        const valor = valores.includes(previo) ? previo : (campo.requerido ? valores[0] || '' : '');
                        linea.sap = linea.sap || {};
                        linea.sap[campo.key] = valor;
                        const opciones = valores.map(x => `<option value="${escapeHtml(x)}">${escapeHtml(etiquetaOpcionSap(campo.key, x))}</option>`).join('');
                        return `<div class="col-md-3 col-6"><label class="form-label small mb-1">${campo.label}</label><select class="form-select form-select-sm" onchange="actualizarSapEdicionSalida(${i},'${campo.key}',this.value)">${campo.requerido ? '' : '<option value="">(Sin asignar)</option>'}${opciones}</select></div>`;
                    }).join('');
                    return `<tr data-line-index="${i}">
                        <td><select class="form-select form-select-sm" onchange="actualizarLineaEdicionSalida(${i},'id',this.value)"><option value="">Selecciona artículo</option>${opcionesArticulos}</select><small class="text-muted d-block mt-1">Disponible en SIGO: ${item?.stock ?? 0}</small></td>
                        <td><input type="number" min="1" step="1" class="form-control form-control-sm" value="${Number(linea.cantidad) || 1}" onchange="actualizarLineaEdicionSalida(${i},'cantidad',this.value)" /></td>
                        <td><select class="form-select form-select-sm" onchange="actualizarLineaEdicionSalida(${i},'maquina',this.value)"><option value="">Selecciona equipo</option>${maquinasHtml}${opcionesMaquinas}</select></td>
                        <td><button type="button" class="btn btn-sm btn-outline-danger" title="Quitar artículo" onclick="quitarLineaEdicionSalida(${i})"><i class="bi bi-x-lg"></i></button></td>
                    </tr><tr class="bg-light" data-line-index="${i}"><td colspan="4"><div class="row g-2">${camposHtml}</div></td></tr>`;
                }).join('');
                tbody.querySelectorAll('tr').forEach(row => {
                    const i = Number(row.dataset.lineIndex);
                    if (!row.classList.contains('bg-light')) {
                        const selects = row.querySelectorAll('select');
                        if (selects[0]) selects[0].value = String(lineasEdicionSalida[i].id || '');
                        if (selects[1]) selects[1].value = lineasEdicionSalida[i].maquina || '';
                    } else {
                        row.querySelectorAll('select').forEach((select, j) => {
                            const campo = camposEditablesSap[j];
                            if (campo) select.value = lineasEdicionSalida[i].sap?.[campo.key] || valorConfigSap(sapSalidaConfig.valores || {}, campo.key) || '';
                        });
                    }
                });
            }

            function actualizarLineaEdicionSalida(indice, campo, valor) {
                if (!lineasEdicionSalida[indice]) return;
                lineasEdicionSalida[indice][campo] = campo === 'id' || campo === 'cantidad' ? Number(valor) : valor;
                if (campo === 'id') renderLineasEdicionSalida();
            }

            function actualizarSapEdicionSalida(indice, campo, valor) {
                if (!lineasEdicionSalida[indice]) return;
                lineasEdicionSalida[indice].sap = lineasEdicionSalida[indice].sap || {};
                lineasEdicionSalida[indice].sap[campo] = valor;
            }

            function quitarLineaEdicionSalida(indice) {
                lineasEdicionSalida.splice(indice, 1);
                renderLineasEdicionSalida();
            }

            async function guardarEdicionSalidaSap() {
                const lineas = lineasEdicionSalida.map(x => ({ id: Number(x.id), cantidad: Number(x.cantidad), maquina: x.maquina, sap: x.sap }))
                    .filter(x => x.id > 0);
                if (!lineas.length) { alert('Agrega al menos un artículo.'); return; }
                if (lineas.length !== lineasEdicionSalida.length || lineas.some(x => !Number.isInteger(x.cantidad) || x.cantidad <= 0 || !x.maquina)) {
                    alert('Completa artículo, cantidad y máquina en todas las líneas.'); return;
                }
                const btn = document.getElementById('btnGuardarEdicionSalida');
                btn.disabled = true;
                try {
                    const res = await postJson(URL_EDITAR_SALIDA_SAP, {
                        folio: document.getElementById('editarSalidaFolio').value,
                        referencia: document.getElementById('editarSalidaReferencia').value,
                        comentario: document.getElementById('editarSalidaComentario').value,
                        lineas
                    });
                    alert(res?.mensaje || 'No se recibió respuesta al guardar.');
                    if (res?.ok) {
                        bootstrap.Modal.getOrCreateInstance(document.getElementById('modalEditarSalidaSap')).hide();
                        await Promise.all([cargarSalidasSapPendientes(), cargarDatos()]);
                    }
                } catch (e) { console.error(e); alert('No se pudo guardar la salida.'); }
                finally { btn.disabled = false; }
            }

            async function enviarSalidaSap(folio) {
                if (!confirm(`¿Enviar la salida ${folio} a SAP? Sigo no volverá a descontar el stock.`)) return;
                const botones = document.querySelectorAll('#tbodySalidasSap button');
                botones.forEach(b => b.disabled = true);
                try {
                    const res = await postJson(URL_ENVIAR_SALIDA_SAP, { folio });
                    const mensaje = (res && res.mensaje) || 'No se recibió respuesta del envío a SAP.';
                    const referenciaSap = res && res.ok && (res.docNum || res.docEntry)
                        ? `\nDocumento SAP: ${res.docNum || '—'} (DocEntry ${res.docEntry || '—'}).`
                        : '';
                    alert(mensaje + referenciaSap);
                    await cargarSalidasSapPendientes();
                } catch (e) {
                    console.error(e);
                    alert('No se pudo procesar el envío a SAP. La salida sigue registrada en Sigo.');
                    await cargarSalidasSapPendientes();
                }
            }

            function cerrarModal(id) {
                const el = document.getElementById(id);
                if (el) bootstrap.Modal.getOrCreateInstance(el).hide();
            }

            function fechaRelativa(iso) {
                if (!iso) return '';
                const fecha = new Date(iso);
                if (isNaN(fecha)) return '';

                const seg = Math.floor((Date.now() - fecha.getTime()) / 1000);
                if (seg < 60) return 'Justo ahora';

                const min = Math.floor(seg / 60);
                if (min < 60) return `Hace ${min} min`;

                const hrs = Math.floor(min / 60);
                if (hrs < 24) return `Hace ${hrs} hrs`;

                const dias = Math.floor(hrs / 24);
                if (dias < 30) return `Hace ${dias} día${dias === 1 ? '' : 's'}`;

                return fecha.toLocaleDateString('es-MX', { day: '2-digit', month: 'short', year: 'numeric' });
            }

            function inicialesDe(nombre) {
                const partes = String(nombre || '').trim().split(/\s+/).filter(Boolean);
                if (partes.length === 0) return '--';
                return (partes[0][0] + (partes[1] ? partes[1][0] : '')).toUpperCase();
            }

            function escapeHtml(s) {
                return String(s == null ? '' : s)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            }

            // =========================================================
            // FILTRO GLOBAL POR PLANTA (TIF / P1)
            // =========================================================
            function enPlantaRef(item) {
                if (!plantaRefGlobal) return true;
                return String((item && item.planta) || '').trim().toUpperCase() === plantaRefGlobal;
            }

            function plantaDeItem(item) {
                const p = String((item && item.planta) || '').trim().toUpperCase();
                return (p === 'TIF' || p === 'P1') ? p : '—';
            }

            function almacenesDeItem(item) {
                return (Array.isArray(item?.almacenes) ? item.almacenes : [])
                    .map(a => {
                        const codigo = a.codigo || a.warehouseCode || '';
                        const stock = a.stock ?? a.inStock;
                        return codigo ? `${codigo}${stock != null ? ` (${Number(stock).toLocaleString('es-MX')})` : ''}` : '';
                    })
                    .filter(Boolean)
                    .join(', ');
            }

            function plantaDeAlmacenRef(codigo) {
                const code = String(codigo || '').trim().toUpperCase();
                return code === 'MAN001' || code === 'MAN003' ? 'TIF' : code === 'MAN002' ? 'P1' : '';
            }

            function almacenesPermitidosItem(item) {
                const planta = plantaDeItem(item) === '—' ? plantaRefGlobal : plantaDeItem(item);
                if (!planta) return [];
                const conocidos = (Array.isArray(item?.almacenes) ? item.almacenes : [])
                    .map(a => String(a.codigo || a.warehouseCode || '').trim())
                    .filter(code => plantaDeAlmacenRef(code) === planta);
                const configurados = valorConfigSap(sapSalidaConfig.opciones || {}, 'WarehouseCode') || [];
                const disponibles = conocidos.length ? conocidos : configurados.filter(code => plantaDeAlmacenRef(code) === planta);
                return disponibles.length ? [...new Set(disponibles)] : (planta === 'P1' ? ['MAN002'] : ['MAN001', 'MAN003']);
            }

            function cambiarPlantaRef() {
                const v = String(document.getElementById('refPlantaGlobal')?.value || '').toUpperCase();
                plantaRefGlobal = (v === 'TIF' || v === 'P1') ? v : 'TIF';
                localStorage.setItem('refPlantaGlobal', plantaRefGlobal);
                paginaRef = 1;
                renderUI();
                if ($('#vistaPos').is(':visible')) filtrarCatalogoPos();
                if ($('#vistaSolicitudCompraSap').is(':visible')) renderCatalogoSolicitudCompraSap();
            }

            $(document).ready(function () {
                $('#userInitials').text(inicialesDe(usuarioSesion));
                $('#refPlantaGlobal').val(plantaRefGlobal);

                $('#refTabs').on('click', '.ref-tab', function () {
                    const valor = decodeURIComponent($(this).data('cat') || '');
                    filtrarPorCategoria(valor, this);
                });

               $('#posScan').off('keydown').on('keydown', function (e) {
                if (e.which === 13 || e.keyCode === 13 || e.key === 'Enter') {
                    e.preventDefault();
                    const valorEscaneado = $(this).val().trim();
                    if (valorEscaneado) {
                        procesarEscaneo(valorEscaneado);
                    }
                }
            });

                // ===== Escaneo global (pistola) =====
                $(document).on('keydown.scanref', function (e) {
                    if (e.ctrlKey || e.altKey || e.metaKey) return;

                    const el = e.target || {};
                    const tag = (el.tagName || '').toLowerCase();
                    const id = el.id || '';

                    if (id === 'posScan') return;

                    const posVisible = $('#vistaPos').is(':visible');
                    const enCampoTexto = tag === 'input' || tag === 'textarea' || tag === 'select' || el.isContentEditable;
                    const esBuscador = id === 'searchInput';

                    if (enCampoTexto && !esBuscador && !posVisible) return;
                    if (document.querySelector('.modal.show')) return;

                    const now = Date.now();
                    if (now - lastScanKeyTime > 100) scanBuffer = '';
                    lastScanKeyTime = now;

                    if (e.key === 'Enter') {
                        const codigo = scanBuffer;
                        scanBuffer = '';
                        if (codigo.length > 2) {
                            e.preventDefault();
                            manejarEscaneo(codigo);
                        }
                    } else if (e.key && e.key.length === 1) {
                        scanBuffer += e.key;
                    }
                });

                $('#adjType').on('change', function() {
                    if($(this).val() === 'salida') {
                        $('#divMaquinaDestino').show();
                        $('#divSapSalida').show();
                    } else {
                        $('#divMaquinaDestino').hide();
                        $('#divSapSalida').hide();
                        $('#adjMachine').val('');
                    }
                    actualizarValidacionCantidad();
                });

                cargarDatos();
                revisarPendientesSap();
            });

            function actualizarValidacionCantidad() {
                const input = document.getElementById('adjQty');
                if (!input) return;

                const tipo = $('#adjType').val();
                input.setAttribute('min', tipo === 'ajuste' ? '-999999' : '1');
                input.placeholder = tipo === 'ajuste' ? 'Ej. -3 para restar' : '';
            }

            function filtrarPorCategoria(categoria, elemento) {
                $('.ref-tab').removeClass('active');$(elemento).addClass('active');
                filtroActual = categoria;
                paginaRef = 1;
                renderTarjetas();
            }

            function renderTabs() {
                const cont = document.getElementById('refTabs');
                if (!cont) return;

                const nombresCat = categorias.map(c => c.nombre);
                const disponibles = ['Todos', 'Bajo Stock', 'Sobre Stock'].concat(nombresCat);
                if (!disponibles.includes(filtroActual)) filtroActual = 'Todos';

                const base = [
                    { nombre: 'Todos', valor: 'Todos' },
                    { nombre: 'Bajo Stock', valor: 'Bajo Stock' },
                    { nombre: 'Sobre Stock', valor: 'Sobre Stock' }
                ].concat(nombresCat.map(n => ({ nombre: n, valor: n })));

                cont.innerHTML = base.map(t =>
                    `<div class="ref-tab${t.valor === filtroActual ? ' active' : ''}" data-cat="${encodeURIComponent(t.valor)}">${escapeHtml(t.nombre)}</div>`
                ).join('');
            }

               function renderSelectsCatalogos() {
                const selCat = document.getElementById('newCat');
                if (selCat) {
                    const actual = selCat.value;
                    selCat.innerHTML = categorias.length
                        ? categorias.map(c => `<option value="${escapeHtml(c.nombre)}">${escapeHtml(c.nombre)}</option>`).join('')
                        : '<option value="">(sin categorías)</option>';
                    if (actual && categorias.some(c => c.nombre === actual)) selCat.value = actual;
                }

                const selUbi = document.getElementById('newLoc');
                if (selUbi) {
                    const actual = selUbi.value;
                    selUbi.innerHTML = ubicaciones.length
                        ? ubicaciones.map(u => `<option value="${escapeHtml(u.nombre)}">${escapeHtml(u.nombre)}</option>`).join('')
                        : '<option value="">(sin ubicaciones)</option>';
                    if (actual && ubicaciones.some(u => u.nombre === actual)) selUbi.value = actual;
                }

                const opcionesMaquina = '<option value="">Selecciona una máquina...</option>' +
                    maquinas.map(m => `<option value="${escapeHtml(m.nombre)}">${escapeHtml(m.nombre)}</option>`).join('');

                const selMaq = document.getElementById('adjMachine');
                if (selMaq) {
                    const actual = selMaq.value;
                    selMaq.innerHTML = opcionesMaquina;
                    if (actual && maquinas.some(m => m.nombre === actual)) selMaq.value = actual;
                }

                const selPosMaq = document.getElementById('posMaquina');
                if (selPosMaq) {
                    const actual = selPosMaq.value;
                    selPosMaq.innerHTML = opcionesMaquina;
                    if (actual && maquinas.some(m => m.nombre === actual)) selPosMaq.value = actual;
                }

                renderSapSelectors('adj');

                // === AQUI SE INICIALIZA SELECT2 ===
                // Inicializa en los modales y en el POS global
                $('#newCat, #newLoc, #adjMachine, #posMaquina, #adjSapSelectors select').select2({
                    width: '100%',
                    dropdownParent: function () {
                        // Ayuda a que el buscador del select no quede oculto detrás de los modales
                        const modals = $('.modal.show');
                        return modals.length ? modals.last() : $(document.body);
                    }()
                });
            }

            const camposSapSalida = [
                { key: 'WarehouseCode', label: 'Almacén', requerido: true },
                { key: 'AccountCode', label: 'Cuenta contable', requerido: true },
                { key: 'CostingCode', label: 'Planta', requerido: true },
                { key: 'CostingCode2', label: 'Unidad de negocio' },
                { key: 'CostingCode3', label: 'Departamento' },
                { key: 'CostingCode4', label: 'Área' },
                { key: 'CostingCode5', label: 'Empleado' }
            ];

            function valorConfigSap(obj, key) {
                if (!obj) return undefined;
                const lower = key.charAt(0).toLowerCase() + key.slice(1);
                return obj[key] !== undefined ? obj[key] : obj[lower];
            }

            function etiquetaOpcionSap(campo, valor) {
                const mapa = valorConfigSap(sapSalidaConfig.etiquetas || {}, campo);
                return (mapa && (mapa[valor] || mapa[String(valor).toLowerCase()])) || valor;
            }

            function renderSapSelectors(prefix) {
                const cont = document.getElementById(prefix + 'SapSelectors');
                if (!cont) return;
                const opciones = sapSalidaConfig.opciones || {};
                const valores = sapSalidaConfig.valores || {};
                cont.innerHTML = camposSapSalida.map(campo => {
                    const lista = valorConfigSap(opciones, campo.key) || [];
                    if (!lista.length) return '';
                    const actual = valorConfigSap(valores, campo.key) || '';
                    const id = prefix + campo.key;
                    const optionsHtml = lista.map(valor =>
                        `<option value="${escapeHtml(valor)}" ${String(valor) === String(actual) ? 'selected' : ''}>${escapeHtml(etiquetaOpcionSap(campo.key, valor))}</option>`
                    ).join('');
                    return `<div class="col-6"><label class="form-label small mb-1" for="${id}">${campo.label}${campo.requerido ? ' *' : ''}</label><select class="form-select form-select-sm" id="${id}">${optionsHtml}</select></div>`;
                }).join('');
            }

            function leerSeleccionSap(prefix) {
                const datos = {};
                for (const campo of camposSapSalida) {
                    const select = document.getElementById(prefix + campo.key);
                    if (select) datos[campo.key] = select.value || '';
                }
                return datos;
            }

            function valoresPredeterminadosSap() {
                const valores = sapSalidaConfig.valores || {};
                const datos = {};
                for (const campo of camposSapSalida) {
                    const valor = valorConfigSap(valores, campo.key);
                    datos[campo.key] = valor === undefined ? '' : valor;
                }
                return datos;
            }

            function restaurarSeleccionSap(prefix) {
                const valores = sapSalidaConfig.valores || {};
                for (const campo of camposSapSalida) {
                    const select = document.getElementById(prefix + campo.key);
                    const valor = valorConfigSap(valores, campo.key);
                    if (select && valor !== undefined) $(select).val(valor).trigger('change.select2');
                }
            }

            function renderCatalogos() {
                const contCat = document.getElementById('listaCategorias');
                if (contCat) {
                    contCat.innerHTML = categorias.length
                        ? categorias.map(c => itemCatalogoHtml('categoria', c)).join('')
                        : '<div class="ref-empty">Sin categorías registradas.</div>';
                }

                const contUbi = document.getElementById('listaUbicaciones');
                if (contUbi) {
                    contUbi.innerHTML = ubicaciones.length
                        ? ubicaciones.map(u => itemCatalogoHtml('ubicacion', u)).join('')
                        : '<div class="ref-empty">Sin ubicaciones registradas.</div>';
                }

                const contMaq = document.getElementById('listaMaquinas');
                if (contMaq) {
                    contMaq.innerHTML = maquinas.length
                        ? maquinas.map(m => itemCatalogoHtml('maquina', m)).join('')
                        : '<div class="ref-empty">Sin máquinas registradas.</div>';
                }
            }

            function itemCatalogoHtml(tipo, item) {
                const etiquetaUso = tipo === 'maquina' ? 'uso(s) en movimientos' : 'refacción(es)';
                const usoTexto = item.uso > 0 ? `<span class="ref-cat-uso">${item.uso} ${etiquetaUso}</span>` : '';

                return `
                    <div class="ref-cat-item">
                        <div class="d-flex flex-column" style="min-width:0;">
                            <span class="ref-cat-nombre">${escapeHtml(item.nombre)}</span>
                            ${usoTexto}
                        </div>
                        <div class="ref-cat-actions">
                            <button type="button" class="ref-icon-btn" title="Renombrar" onclick="renombrarCatalogo('${tipo}', ${item.id})">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button type="button" class="ref-icon-btn danger" title="Eliminar" onclick="eliminarCatalogo('${tipo}', ${item.id})">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                `;
            }

            async function agregarCatalogo(tipo) {
                const cfg = {
                    categoria: { input: 'catNuevaCategoria', url: URL_GUARDAR_CAT },
                    ubicacion: { input: 'catNuevaUbicacion', url: URL_GUARDAR_UBI },
                    maquina: { input: 'catNuevaMaquina', url: URL_GUARDAR_MAQ }
                }[tipo];
                if (!cfg) return;

                const input = document.getElementById(cfg.input);
                const nombre = (input.value || '').trim();

                if (!nombre) { alert('Escribe un nombre.'); return; }

                const res = await postJson(cfg.url, { id: 0, nombre: nombre });
                if (!res || !res.ok) {
                    alert((res && res.mensaje) || 'No se pudo guardar en el catálogo.');
                    return;
                }

                input.value = '';
                await cargarDatos();
            }

            async function renombrarCatalogo(tipo, id) {
                const cfg = {
                    categoria: { lista: categorias, url: URL_GUARDAR_CAT },
                    ubicacion: { lista: ubicaciones, url: URL_GUARDAR_UBI },
                    maquina: { lista: maquinas, url: URL_GUARDAR_MAQ }
                }[tipo];
                if (!cfg) return;

                const item = cfg.lista.find(x => x.id === id);
                if (!item) return;

                const nuevo = prompt('Nuevo nombre:', item.nombre);
                if (nuevo == null) return;

                const limpio = nuevo.trim();
                if (!limpio || limpio === item.nombre) return;

                const res = await postJson(cfg.url, { id: id, nombre: limpio });
                if (!res || !res.ok) {
                    alert((res && res.mensaje) || 'No se pudo renombrar.');
                    return;
                }

                await cargarDatos();
            }

            async function eliminarCatalogo(tipo, id) {
                const cfg = {
                    categoria: { lista: categorias, url: URL_ELIMINAR_CAT },
                    ubicacion: { lista: ubicaciones, url: URL_ELIMINAR_UBI },
                    maquina: { lista: maquinas, url: URL_ELIMINAR_MAQ }
                }[tipo];
                if (!cfg) return;

                const item = cfg.lista.find(x => x.id === id);
                if (!item) return;

                if (tipo !== 'maquina' && item.uso > 0) {
                    alert(`No se puede eliminar "${item.nombre}": está en uso en ${item.uso} refacción(es).`);
                    return;
                }

                if (!confirm(`¿Eliminar "${item.nombre}" del catálogo?`)) return;

                const res = await postJson(cfg.url, { id: id });
                if (!res || !res.ok) {
                    alert((res && res.mensaje) || 'No se pudo eliminar.');
                    return;
                }

                if (filtroActual === item.nombre) filtroActual = 'Todos';
                await cargarDatos();
            }

            function claseEstado(item) {
                if (item.stock === 0) return { dot: 'dot-out', qty: 'out' };
                if (item.max > 0 && item.stock > item.max) return { dot: 'dot-over', qty: 'over' };
                if (item.stock <= item.min) return { dot: 'dot-low', qty: 'low' };
                return { dot: 'dot-ok', qty: '' };
            }

            function renderTarjetas() {
                const container = $('#gridRefacciones');
                container.empty();

                const textoBusqueda = $('#searchInput').val().toLowerCase();

                let datosFiltrados = inventario.filter(item => {
                    if (!enPlantaRef(item)) return false;

                    let pasaFiltroTab = true;
                    if (filtroActual === 'Bajo Stock') {
                        pasaFiltroTab = item.stock <= item.min;
                    } else if (filtroActual === 'Sobre Stock') {
                        pasaFiltroTab = item.max > 0 && item.stock > item.max;
                    } else if (filtroActual !== 'Todos') {
                        pasaFiltroTab = item.cat === filtroActual;
                    }

                    let pasaFiltroTexto = true;
                    if (textoBusqueda) {
                        pasaFiltroTexto = item.desc.toLowerCase().includes(textoBusqueda) ||
                                          item.sku.toLowerCase().includes(textoBusqueda) ||
                                          item.loc.toLowerCase().includes(textoBusqueda);
                    }

                    return pasaFiltroTab && pasaFiltroTexto;
                });

                if (datosFiltrados.length === 0) {
                    container.append('<div style="text-align:center; padding: 30px 10px; color: #64748b; font-size: 0.9rem; grid-column: 1/-1;">No se encontraron refacciones con estos filtros.</div>');
                    renderPagerRefacciones(0);
                    return;
                }

                totalPaginasRef = Math.max(1, Math.ceil(datosFiltrados.length / tamPaginaRef));
                if (paginaRef > totalPaginasRef) paginaRef = totalPaginasRef;
                if (paginaRef < 1) paginaRef = 1;

                const inicio = (paginaRef - 1) * tamPaginaRef;
                const pagina = datosFiltrados.slice(inicio, inicio + tamPaginaRef);

                if (modoVista === 'table') {
                    renderTablaRefacciones(container, pagina);
                    renderPagerRefacciones(datosFiltrados.length);
                    return;
                }

                pagina.forEach(item => {
                    const estado = claseEstado(item);
                    const statusClass = estado.dot;
                    const qtyClass = estado.qty;

                    let formatoMoneda = new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(item.costo);

                    let html = `
                        <div class="ref-card-item" data-ref-id="${item.id}">
                            <div class="ref-card-top">
                                <span class="ref-sku-badge" title="Costo Unitario: ${formatoMoneda}">${escapeHtml(item.sku)}</span>
                                <span class="ref-status-dot ${statusClass}"></span>
                            </div>
                            <h3 class="ref-name">${escapeHtml(item.desc)}</h3>
                            <p class="ref-desc"><i class="bi bi-geo-alt"></i> ${escapeHtml(item.loc)}</p>
                            <p class="ref-desc" style="margin-top:-4px;">
                                <i class="bi bi-diagram-3"></i>
                                <span class="badge" style="background:var(--ref-brand); font-size:.62rem;">${escapeHtml(plantaDeItem(item))}</span>
                                ${almacenesDeItem(item) ? `<span style="font-size:.66rem; margin-left:4px;">${escapeHtml(almacenesDeItem(item))}</span>` : ''}
                            </p>
                            ${item.foto ? `<img class="ref-foto-thumb" src="${escapeHtml(item.foto)}" loading="lazy" decoding="async" alt="${escapeHtml(item.desc)}" title="Ver foto" onclick="verFoto(${item.id})" />` : ''}

                            <div class="ref-card-bottom">
                                <div class="ref-stock-info">
                                    <p>STOCK ACTUAL</p>
                            <div class="ref-stock-qty ${qtyClass}">${item.stock} <span style="font-size:0.7rem; color:var(--ref-text-muted);">${escapeHtml(item.unidadMedidaInventario || 'PZAS')}</span></div>
                                    <div class="ref-minmax">Mín ${item.min} · Máx ${item.max > 0 ? item.max : '—'}</div>
                                </div>
                                <div class="d-flex gap-1">
                                    <button class="ref-icon-btn" title="Editar refacción" onclick="abrirEditar(${item.id})">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="ref-icon-btn" title="${item.foto ? 'Ver / cambiar foto' : 'Cargar o tomar foto'}" onclick="${item.foto ? `verFoto(${item.id})` : `subirFoto(${item.id})`}">
                                        <i class="bi ${item.foto ? 'bi-image' : 'bi-camera'}"></i>
                                    </button>
                                    <button class="ref-icon-btn" title="Imprimir etiqueta QR" onclick="imprimirEtiqueta(${item.id})">
                                        <i class="bi bi-qr-code"></i>
                                    </button>
                                    <button class="btn-action" onclick="abrirAjuste(${item.id})">
                                        <i class="bi bi-arrow-left-right"></i> Ajustar
                                    </button>
                                </div>
                            </div>
                        </div>
                    `;
                    container.append(html);
                });

                renderPagerRefacciones(datosFiltrados.length);
            }

            function renderPagerRefacciones(totalFiltrados) {
                const cont = document.getElementById('pagerRefacciones');
                if (!cont) return;

                if (!totalFiltrados) {
                    cont.innerHTML = '';
                    return;
                }

                const maxBotones = 7;
                let inicio = Math.max(1, paginaRef - 3);
                let fin = Math.min(totalPaginasRef, inicio + maxBotones - 1);
                inicio = Math.max(1, fin - maxBotones + 1);

                let botones = '';
                for (let p = inicio; p <= fin; p++) {
                    botones += `<button type="button" class="ref-page-btn ${p === paginaRef ? 'active' : ''}" onclick="irPaginaRef(${p})">${p}</button>`;
                }

                const desde = (paginaRef - 1) * tamPaginaRef + 1;
                const hasta = Math.min(paginaRef * tamPaginaRef, totalFiltrados);

                cont.innerHTML = `
                    <span class="ref-pager-info">Mostrando ${desde}–${hasta} de ${totalFiltrados}</span>
                    <div class="ref-pager-controls">
                        <select class="ref-page-size" onchange="cambiarTamPaginaRef(this.value)">
                            <option value="12" ${tamPaginaRef === 12 ? 'selected' : ''}>12 / pág.</option>
                            <option value="24" ${tamPaginaRef === 24 ? 'selected' : ''}>24 / pág.</option>
                            <option value="48" ${tamPaginaRef === 48 ? 'selected' : ''}>48 / pág.</option>
                            <option value="96" ${tamPaginaRef === 96 ? 'selected' : ''}>96 / pág.</option>
                        </select>
                        <div class="ref-pager-btns">
                            <button type="button" class="ref-page-btn" ${paginaRef <= 1 ? 'disabled' : ''} onclick="irPaginaRef(1)">«</button>
                            <button type="button" class="ref-page-btn" ${paginaRef <= 1 ? 'disabled' : ''} onclick="irPaginaRef(${paginaRef - 1})">‹</button>
                            ${botones}
                            <button type="button" class="ref-page-btn" ${paginaRef >= totalPaginasRef ? 'disabled' : ''} onclick="irPaginaRef(${paginaRef + 1})">›</button>
                            <button type="button" class="ref-page-btn" ${paginaRef >= totalPaginasRef ? 'disabled' : ''} onclick="irPaginaRef(${totalPaginasRef})">»</button>
                        </div>
                    </div>`;
            }

            function irPaginaRef(p) {
                if (p < 1 || p > totalPaginasRef || p === paginaRef) return;
                paginaRef = p;
                renderTarjetas();
                document.getElementById('gridRefacciones')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }

            function cambiarTamPaginaRef(valor) {
                tamPaginaRef = parseInt(valor, 10) || 24;
                paginaRef = 1;
                renderTarjetas();
            }

            function aplicarModoVistaUI() {
                $('#btnVistaGrid').toggleClass('active', modoVista === 'grid');
                $('#btnVistaTabla').toggleClass('active', modoVista === 'table');

                $('#gridRefacciones')
                    .removeClass('ref-grid ref-table-wrap')
                    .addClass(modoVista === 'table' ? 'ref-table-wrap' : 'ref-grid');
            }

            function cambiarVista(modo) {
                modoVista = modo === 'table' ? 'table' : 'grid';
                aplicarModoVistaUI();
                renderTarjetas();
                guardarVista(modoVista);
            }

            async function guardarVista(modo) {
                try {
                    await postJson(URL_GUARDAR_VISTA, { vista: modo });
                } catch (e) {
                    console.error('No se pudo guardar la preferencia de vista.', e);
                }
            }

            function renderTablaRefacciones(container, datos) {
                const fmtMoneda = new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' });

                const filas = datos.map(item => {
                    const estado = claseEstado(item);
                    const statusClass = estado.dot;
                    const qtyClass = estado.qty;

                    return `
                        <tr data-ref-id="${item.id}">
                            <td>
                                ${item.foto ? `<img class="ref-foto-thumb-sm" src="${escapeHtml(item.foto)}" loading="lazy" decoding="async" alt="${escapeHtml(item.desc)}" title="Ver foto" onclick="verFoto(${item.id})" />` : ''}
                                <span class="ref-sku-badge" title="Costo Unitario: ${fmtMoneda.format(item.costo)}">${escapeHtml(item.sku)}</span>
                            </td>
                            <td>${escapeHtml(item.desc)}</td>
                            <td class="d-none d-md-table-cell">
                                <span class="badge" style="background:var(--ref-brand); font-size:.62rem;">${escapeHtml(plantaDeItem(item))}</span>
                                ${almacenesDeItem(item) ? `<div style="font-size:.64rem; color:var(--ref-text-muted);">${escapeHtml(almacenesDeItem(item))}</div>` : ''}
                            </td>
                            <td class="d-none d-md-table-cell">${escapeHtml(item.unidadMedidaInventario || '—')}</td>
                            <td class="d-none d-md-table-cell">${escapeHtml(item.cat || '')}</td>
                            <td><i class="bi bi-geo-alt" style="color:var(--ref-text-muted);"></i> ${escapeHtml(item.loc)}</td>
                            <td class="d-none d-md-table-cell text-center">${item.min}</td>
                            <td class="d-none d-md-table-cell text-center">${item.max > 0 ? item.max : '—'}</td>
                            <td class="text-center">
                                <span class="ref-status-dot ${statusClass}"></span>
                                <span class="ref-table-qty ${qtyClass}">${item.stock}</span>
                            </td>
                            <td class="d-none d-md-table-cell">${fmtMoneda.format(item.costo)}</td>
                            <td>
                                <div class="d-flex gap-1">
                                    <button class="ref-icon-btn" title="Editar refacción" onclick="abrirEditar(${item.id})">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="ref-icon-btn" title="${item.foto ? 'Ver / cambiar foto' : 'Cargar o tomar foto'}" onclick="${item.foto ? `verFoto(${item.id})` : `subirFoto(${item.id})`}">
                                        <i class="bi ${item.foto ? 'bi-image' : 'bi-camera'}"></i>
                                    </button>
                                    <button class="ref-icon-btn" title="Imprimir etiqueta QR" onclick="imprimirEtiqueta(${item.id})">
                                        <i class="bi bi-qr-code"></i>
                                    </button>
                                    <button class="btn-action" onclick="abrirAjuste(${item.id})">
                                        <i class="bi bi-arrow-left-right"></i> Ajustar
                                    </button>
                                </div>
                            </td>
                        </tr>
                    `;
                }).join('');

                container.append(`
                    <table class="ref-table">
                        <thead>
                            <tr>
                                <th>SKU</th>
                                <th>Descripción</th>
                                <th class="d-none d-md-table-cell">Planta</th>
                                <th class="d-none d-md-table-cell">Unidad inventario</th>
                                <th class="d-none d-md-table-cell">Categoría</th>
                                <th>Ubicación</th>
                                <th class="d-none d-md-table-cell text-center">Mín.</th>
                                <th class="d-none d-md-table-cell text-center">Máx.</th>
                                <th class="text-center">Stock</th>
                                <th class="d-none d-md-table-cell">Costo</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>${filas}</tbody>
                    </table>
                `);
            }

            function renderUI() {
                renderTarjetas();
                renderMovimientos();
                calcularEstadisticas();
                renderCentroAlertasRef();
            }

            function renderMovimientos() {
                const container = $('#listaMovimientos');
                container.empty();

                const movimientosPlanta = movimientos.filter(mov =>
                    !plantaRefGlobal ||
                    String(mov.planta || '').trim().toUpperCase() === plantaRefGlobal);

                const limite = verTodosMovimientos ? movimientosPlanta.length : 5;
                const recientes = movimientosPlanta.slice(0, limite);

                $('#btnVerTodos').toggle(movimientosPlanta.length > 5);
                $('#btnVerTodos').text(verTodosMovimientos ? 'Ver menos' : 'Ver todos');
                $('#movTitle').text(movimientosPlanta.length > 0
                    ? `Movimientos (${movimientosPlanta.length})`
                    : 'Últimos Movimientos');

                if (recientes.length === 0) {
                    container.append('<div class="ref-empty">Aún no hay movimientos registrados.</div>');
                    return;
                }

                recientes.forEach(mov => {
                    const tipo = String(mov.tipo || '').toUpperCase();
                    const iconClass = tipo === 'SALIDA' ? 'icon-out' : (tipo === 'ENTRADA' ? 'icon-in' : 'icon-adj');
                    const iconBi = tipo === 'SALIDA' ? 'bi-arrow-down-right' : (tipo === 'ENTRADA' ? 'bi-arrow-up-right' : 'bi-pencil');

                    let textoExtra = mov.usuario || 'Sistema';
                    if (tipo === 'SALIDA' && mov.maquina) {
                        textoExtra += ` • Instalado en: ${mov.maquina}`;
                    }

                    const cuando = fechaRelativa(mov.fecha);
                    const refLinea = [mov.planta || null, mov.referencia || 'Sin documento', mov.folio || ''].filter(Boolean).join(' • ');

                    const qtyDisplay = mov.cantidad > 0 ? `+${mov.cantidad}` : mov.cantidad;

                    let html = `
                        <div class="ref-history-item">
                            <div class="history-icon ${iconClass}"><i class="bi ${iconBi}"></i></div>
                            <div class="history-details">
                                <p class="history-name">${escapeHtml(mov.desc)}</p>
                                <p class="history-meta" style="color:var(--ref-brand); font-weight:600;">${escapeHtml(textoExtra)}</p>
                                <p class="history-meta">${escapeHtml(refLinea)} • ${cuando}</p>
                            </div>
                            <div class="ref-stock-qty" style="font-size: 1.1rem;">${qtyDisplay}</div>
                        </div>
                    `;
                    container.append(html);
                });
            }

            function toggleTodosMovimientos() {
                verTodosMovimientos = !verTodosMovimientos;
                renderMovimientos();
            }

            function calcularEstadisticas() {
                let total = 0;
                let low = 0;
                let out = 0;
                let valorInventario = 0;

                inventario.forEach(item => {
                    if (!enPlantaRef(item)) return;

                    let s = parseInt(item.stock);
                    total += s;
                    valorInventario += (s * parseFloat(item.costo));

                    if (s === 0) out++;
                    else if (s <= item.min) low++;
                });

                $('#statTotal').text(total);
                $('#statLow').text(low);
                $('#statOut').text(out);

                let formatoInv = new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN', maximumFractionDigits: 0 }).format(valorInventario);
                $('#statValue').text(formatoInv);
            }

            function calcularAlertasRef() {
                const res = [];

                inventario.forEach(item => {
                    if (!enPlantaRef(item)) return;

                    const stock = Number(item.stock) || 0;
                    const min = Number(item.min) || 0;
                    const max = Number(item.max) || 0;

                    let nivel = '';
                    if (stock === 0) nivel = 'AGOTADO';
                    else if (min > 0 && stock <= min) nivel = 'BAJO';
                    else if (max > 0 && stock > max) nivel = 'SOBRE';

                    if (!nivel) return;

                    const objetivo = max > 0 ? max : Math.max(min * 2, min + 1);
                    let sugerido;
                    let tipoSugerencia;
                    if (nivel === 'SOBRE') {
                        sugerido = stock - max;
                        tipoSugerencia = 'sobrante';
                    } else {
                        sugerido = Math.max(objetivo - stock, 1);
                        tipoSugerencia = 'faltante';
                    }

                    res.push({
                        id: item.id,
                        sku: item.sku,
                        desc: item.desc,
                        loc: item.loc || '',
                        planta: plantaDeItem(item),
                        almacenes: almacenesDeItem(item),
                        stock: stock,
                        min: min,
                        max: max,
                        objetivo: objetivo,
                        sugerido: sugerido,
                        tipoSugerencia: tipoSugerencia,
                        nivel: nivel,
                        solicitudStockActiva: item.solicitudStockActiva === true,
                        fechaSolicitudStock: item.fechaSolicitudStock,
                        usuarioSolicitudStock: item.usuarioSolicitudStock
                    });
                });

                const prioridad = { AGOTADO: 0, BAJO: 1, SOBRE: 2 };
                res.sort((a, b) => (prioridad[a.nivel] - prioridad[b.nivel]) || (a.stock - b.stock));
                return res;
            }

            function renderCentroAlertasRef() {
                alertasRefActuales = calcularAlertasRef();

                const pendientesSolicitud = alertasRefActuales.filter(x => !x.solicitudStockActiva);
                const agotados = pendientesSolicitud.filter(x => x.nivel === 'AGOTADO').length;
                const bajos = pendientesSolicitud.filter(x => x.nivel === 'BAJO').length;
                const sobre = pendientesSolicitud.filter(x => x.nivel === 'SOBRE').length;
                const total = pendientesSolicitud.length;

                $('#refAlertAgotados').text(agotados);
                $('#refAlertBajos').text(bajos);
                $('#refAlertSobre').text(sobre);

                const btn = document.getElementById('refAlertBellButton');
                const count = document.getElementById('refAlertBellCount');
                if (count) count.textContent = String(total);
                if (btn) {
                    btn.classList.toggle('has-pending', total > 0);
                    btn.classList.toggle('is-clear', total === 0);
                    const texto = total > 0
                        ? `${total} pendiente(s): ${agotados} agotadas, ${bajos} bajo mínimo, ${sobre} sobre máximo.`
                        : 'Sin pendientes de stock';
                    btn.title = texto;
                    btn.setAttribute('aria-label', texto);
                }

                const q = ($('#alertasBuscar').val() || '').trim().toLowerCase();
                const filtroSolicitud = $('#alertasFiltroSolicitud').val() || 'pendientes';
                const visibles = alertasRefActuales.filter(a =>
                    (filtroSolicitud === 'todos' ||
                        (filtroSolicitud === 'solicitados' ? a.solicitudStockActiva : !a.solicitudStockActiva)) &&
                    (!q || `${a.sku} ${a.desc}`.toLowerCase().includes(q)));

                const totalSeleccionadas = alertasSeleccionadasSolicitud.size;
                $('#refSolicitudSeleccionCount').text(totalSeleccionadas ? `(${totalSeleccionadas})` : '');
                const checkAll = document.getElementById('refSeleccionarAlertas');
                const elegiblesVisibles = visibles.filter(a => a.tipoSugerencia === 'faltante' && !a.solicitudStockActiva);
                if (checkAll) {
                    checkAll.checked = elegiblesVisibles.length > 0 && elegiblesVisibles.every(a => alertasSeleccionadasSolicitud.has(a.id));
                    checkAll.indeterminate = elegiblesVisibles.some(a => alertasSeleccionadasSolicitud.has(a.id)) && !checkAll.checked;
                }

                let rows = '';
                visibles.forEach(a => {
                    const clase = a.nivel === 'AGOTADO' ? 'agotado' : (a.nivel === 'BAJO' ? 'bajo' : 'sobre');
                    const etiqueta = a.nivel === 'AGOTADO' ? 'Agotado' : (a.nivel === 'BAJO' ? 'Bajo mínimo' : 'Sobre máximo');
                    const solicitud = a.solicitudStockActiva
                        ? `<div><strong>Ya solicitado</strong><br><small>${escapeHtml(a.usuarioSolicitudStock || '')}${a.fechaSolicitudStock ? ' · ' + new Date(a.fechaSolicitudStock).toLocaleDateString() : ''}</small><br><button type="button" class="btn btn-sm btn-outline-secondary mt-1" onclick="marcarSolicitudStock(${a.id}, false)">Quitar marca</button></div>`
                        : (a.nivel === 'SOBRE' ? '—' : `<button type="button" class="btn btn-sm btn-outline-primary" onclick="marcarSolicitudStock(${a.id}, true)"><i class="bi bi-check2-circle me-1"></i>Marcar solicitado</button>`);

                    rows += `<tr>
                        <td style="text-align:center;">${a.tipoSugerencia === 'faltante' && !a.solicitudStockActiva ? `<input type="checkbox" class="ref-alerta-seleccion" data-id="${a.id}" ${alertasSeleccionadasSolicitud.has(a.id) ? 'checked' : ''} aria-label="Agregar ${escapeHtml(a.sku)} a solicitud" />` : '—'}</td>
                        <td><span class="ref-alert-level ${clase}">${etiqueta}</span></td>
                        <td><strong style="color: var(--ref-brand);">${escapeHtml(a.sku)}</strong><br><small>${escapeHtml(a.desc)}</small></td>
                        <td>${escapeHtml(a.loc || 'Sin ubicación')}</td>
                        <td style="text-align:center;" class="fw-bold">${a.stock}</td>
                        <td style="text-align:center;">${a.min}</td>
                        <td style="text-align:center;">${a.max > 0 ? a.max : '—'}</td>
                        <td style="text-align:center;"><strong>${a.sugerido}</strong><br><small style="color: var(--ref-text-muted);">${a.tipoSugerencia}</small></td>
                        <td style="text-align:center;">
                            ${solicitud}
                            <button type="button" class="ref-icon-btn" title="Ajustar stock" onclick="ajustarDesdeAlertaRef(${a.id})">
                                <i class="bi bi-arrow-left-right"></i>
                            </button>
                        </td>
                    </tr>`;
                });

                $('#tbodyAlertasRef').html(rows || `<tr><td colspan="9" style="text-align:center; padding: 24px; color: var(--ref-success); font-weight:700;">${q ? 'No hay coincidencias.' : 'Sin pendientes de stock.'}</td></tr>`);
            }

            let solicitudCompraSapLineas = [];

            let vistaAnteriorSolicitudSap = 'inventario';

            function abrirSolicitudCompraSap() {
                if (!$('#vistaSolicitudCompraSap').is(':visible'))
                    vistaAnteriorSolicitudSap = $('#vistaPos').is(':visible') ? 'pos' : 'inventario';
                $('#vistaInventario, #vistaPos').hide();
                $('#vistaSolicitudCompraSap').show();
                cambiarPestanaFlujoSolicitud('crear');
                document.getElementById('btnAutorizacionesJefe')?.classList.remove('active');
                document.getElementById('btnAbrirSolicitudCompraSap')?.classList.add('active');
                if (!document.getElementById('refSolicitudFechaVista').value) {
                    const fecha = new Date();
                    fecha.setDate(fecha.getDate() + 7);
                    const y = fecha.getFullYear();
                    const m = String(fecha.getMonth() + 1).padStart(2, '0');
                    const d = String(fecha.getDate()).padStart(2, '0');
                    document.getElementById('refSolicitudFechaVista').value = `${y}-${m}-${d}`;
                }
                renderCatalogoSolicitudCompraSap();
                renderListaSolicitudCompraSap();
                document.getElementById('refSolicitudBusqueda')?.focus();
            }

            function cerrarSolicitudCompraSap() {
                $('#vistaSolicitudCompraSap').hide();
                if (vistaAnteriorSolicitudSap === 'pos') {
                    $('#vistaPos').show();
                    $('#posScan').trigger('focus');
                } else {
                    $('#vistaInventario').show();
                    renderTarjetas();
                }
                document.getElementById('btnAbrirSolicitudCompraSap')?.classList.remove('active');
                document.getElementById('btnAutorizacionesJefe')?.classList.remove('active');
            }

            function pasarSeleccionAlertasASolicitudSap() {
                const seleccion = alertasRefActuales.filter(a => alertasSeleccionadasSolicitud.has(a.id) && a.tipoSugerencia === 'faltante');
                if (!seleccion.length) {
                    alert('Marca primero uno o más artículos agotados o bajo mínimo.');
                    return;
                }
                const cuentaDefecto = sapSalidaConfig?.valores?.AccountCode || (sapSalidaConfig?.opciones?.AccountCode || [])[0] || '';
                seleccion.forEach(a => agregarArticuloSolicitudSap(a.id, a.sugerido, undefined, cuentaDefecto));
                alertasSeleccionadasSolicitud.clear();
                renderCentroAlertasRef();
                const modalAlertas = document.getElementById('modalAlertasRef');
                modalAlertas?.addEventListener('hidden.bs.modal', abrirSolicitudCompraSap, { once: true });
                if (modalAlertas?.classList.contains('show')) bootstrap.Modal.getOrCreateInstance(modalAlertas).hide();
                else abrirSolicitudCompraSap();
            }

            function renderCatalogoSolicitudCompraSap() {
                const cont = document.getElementById('refSolicitudCatalogo');
                if (!cont) return;
                const q = (document.getElementById('refSolicitudBusqueda')?.value || '').trim().toLowerCase();
                const alertas = new Map(calcularAlertasRef().map(a => [a.id, a]));
                let items = inventario.filter(x => enPlantaRef(x) && (!q || `${x.sku} ${x.desc}`.toLowerCase().includes(q)));
                items.sort((a, b) => {
                    const aa = alertas.get(a.id), bb = alertas.get(b.id);
                    const pa = aa?.nivel === 'AGOTADO' ? 0 : aa?.nivel === 'BAJO' ? 1 : 2;
                    const pb = bb?.nivel === 'AGOTADO' ? 0 : bb?.nivel === 'BAJO' ? 1 : 2;
                    return pa - pb || a.desc.localeCompare(b.desc);
                });
                items = items.slice(0, q ? 100 : 60);
                if (!items.length) {
                    cont.innerHTML = '<div class="ref-empty" style="grid-column:1/-1;">No se encontraron artículos.</div>';
                    return;
                }
                cont.innerHTML = items.map(item => {
                    const linea = solicitudCompraSapLineas.find(x => x.id === item.id);
                    const alerta = alertas.get(item.id);
                    const solicitado = item.solicitudStockActiva;
                    const foto = item.foto ? `<img src="${escapeHtml(item.foto)}" loading="lazy" />` : '<div class="no-foto"><i class="bi bi-box-seam"></i></div>';
                    const badge = solicitado
                        ? '<div class="stock" style="background:#d97706;color:#fff;">Solicitado</div>'
                        : linea ? `<div class="stock" style="background:#2563eb;color:#fff;">En lista: ${linea.cantidad}</div>`
                        : item.stock <= 0 ? '<div class="stock" style="background:var(--ref-danger);color:#fff;">Agotado</div>'
                        : `<div class="stock">${item.stock}</div>`;
                    const status = solicitado ? 'Ya tiene una solicitud activa' : alerta ? alerta.nivel : 'Disponible para solicitar';
                    return `<button type="button" class="ref-pos-item ${item.stock <= 0 ? 'ref-solicitud-agotado' : ''}" ${solicitado ? 'disabled' : ''} onclick="agregarArticuloSolicitudSap(${item.id})" title="${escapeHtml(item.desc)}">
                        ${badge}${foto}<div class="sku">${escapeHtml(item.sku)}</div><div class="desc">${escapeHtml(item.desc)}</div>
                        <div class="desc" style="font-size:.68rem;opacity:.75;">Stock ${item.stock} · ${escapeHtml(status)}</div>
                        <div class="desc" style="font-size:.66rem;opacity:.7;">Planta ${escapeHtml(plantaDeItem(item))}${almacenesDeItem(item) ? ` · ${escapeHtml(almacenesDeItem(item))}` : ''}</div>
                    </button>`;
                }).join('');
            }

            function agregarArticuloSolicitudSap(id, cantidadInicial, almacenInicial, cuentaInicial) {
                const item = inventario.find(x => x.id === Number(id));
                if (!item) return;
                if (item.solicitudStockActiva) {
                    alert(`${item.sku} ya está marcado como solicitado. Quita la marca desde Pendientes si necesitas generar otra solicitud.`);
                    return;
                }
                const existente = solicitudCompraSapLineas.find(x => x.id === item.id);
                if (existente) {
                    document.getElementById('refSolicitudListaVista')?.scrollIntoView({ behavior: 'smooth', block: 'end' });
                    return;
                }
                const alerta = calcularAlertasRef().find(x => x.id === item.id && x.tipoSugerencia === 'faltante');
                const almacenSugerido = plantaDeItem(item) === 'P1' ? 'MAN002' : 'MAN001';
                const almacenesItem = almacenesPermitidosItem(item);
                solicitudCompraSapLineas.push({
                    id: item.id, sku: item.sku, desc: item.desc, stock: item.stock,
                    cantidad: Number(cantidadInicial || alerta?.sugerido || 1),
                    warehouseCode: almacenInicial || (almacenesItem.includes(almacenSugerido) ? almacenSugerido : almacenesItem[0]) || almacenSugerido,
                    accountCode: cuentaInicial ?? sapSalidaConfig?.valores?.AccountCode ?? ''
                });
                renderCatalogoSolicitudCompraSap();
                renderListaSolicitudCompraSap();
            }

            function abrirAutorizacionesJefe() {
                abrirSolicitudCompraSap();
                cambiarPestanaFlujoSolicitud('jefe');
                document.getElementById('btnAbrirSolicitudCompraSap')?.classList.remove('active');
                document.getElementById('btnAutorizacionesJefe')?.classList.add('active');
            }

            function actualizarLineaSolicitudSap(id, campo, valor) {
                const linea = solicitudCompraSapLineas.find(x => x.id === Number(id));
                if (!linea) return;
                linea[campo] = campo === 'cantidad' ? Number(valor) : valor;
                const total = solicitudCompraSapLineas.reduce((s, x) => s + (Number(x.cantidad) || 0), 0);
                document.getElementById('refSolicitudResumenVista').textContent = `${solicitudCompraSapLineas.length} artículo(s) · ${total} pza(s)`;
            }

            function quitarArticuloSolicitudSap(id) {
                solicitudCompraSapLineas = solicitudCompraSapLineas.filter(x => x.id !== Number(id));
                renderCatalogoSolicitudCompraSap();
                renderListaSolicitudCompraSap();
            }

            function limpiarSolicitudCompraSap() {
                if (!solicitudCompraSapLineas.length) return;
                if (!confirm('¿Quitar todos los artículos de esta solicitud?')) return;
                solicitudCompraSapLineas = [];
                renderCatalogoSolicitudCompraSap();
                renderListaSolicitudCompraSap();
            }

            function renderListaSolicitudCompraSap() {
                const cont = document.getElementById('refSolicitudListaVista');
                if (!cont) return;
                const total = solicitudCompraSapLineas.reduce((s, x) => s + (Number(x.cantidad) || 0), 0);
                document.getElementById('refSolicitudResumenVista').textContent = `${solicitudCompraSapLineas.length} artículo(s) · ${total} pza(s)`;
                if (!solicitudCompraSapLineas.length) {
                    cont.innerHTML = '<div class="ref-empty" style="padding-top:40px;"><i class="bi bi-cart-plus" style="font-size:2rem;opacity:.3"></i><p class="mt-2 mb-0">Busca y selecciona artículos del catálogo.</p></div>';
                    return;
                }
                const cuentas = sapSalidaConfig?.opciones?.AccountCode || [];
                const etiquetas = sapSalidaConfig?.etiquetas?.AccountCode || {};
                const rows = solicitudCompraSapLineas.map(x => {
                    const item = inventario.find(a => Number(a.id) === Number(x.id));
                    const almacenes = almacenesPermitidosItem(item);
                    if (!almacenes.includes(x.warehouseCode)) x.warehouseCode = almacenes[0] || '';
                    const cuentaOptions = '<option value="">Predeterminada SAP</option>' + cuentas.map(c => `<option value="${escapeHtml(c)}" ${String(x.accountCode) === String(c) ? 'selected' : ''}>${escapeHtml(etiquetas[c] || c)}</option>`).join('');
                    const almacenOptions = almacenes.map(c => `<option value="${escapeHtml(c)}" ${x.warehouseCode === c ? 'selected' : ''}>${escapeHtml(c)}</option>`).join('');
                    return `<tr>
                        <td class="ref-request-item"><strong>${escapeHtml(x.sku)}</strong><br>${escapeHtml(x.desc)}<br><small class="ref-request-meta">Stock SIGO: ${x.stock}</small></td>
                        <td><input class="form-control form-control-sm" type="number" min="0.01" step="0.01" value="${x.cantidad}" onchange="actualizarLineaSolicitudSap(${x.id},'cantidad',this.value)" /></td>
                        <td><select class="form-select form-select-sm" onchange="actualizarLineaSolicitudSap(${x.id},'warehouseCode',this.value)">${almacenOptions}</select><small class="text-muted d-block">Planta ${escapeHtml(plantaDeItem(item))}</small></td>
                        <td><select class="form-select form-select-sm select2-cuenta-sap" aria-label="Buscar cuenta contable para ${escapeHtml(x.sku)}" onchange="actualizarLineaSolicitudSap(${x.id},'accountCode',this.value)">${cuentaOptions}</select></td>
                        <td class="text-center"><button class="btn btn-sm btn-outline-danger" title="Quitar artículo" onclick="quitarArticuloSolicitudSap(${x.id})"><i class="bi bi-x-lg"></i></button></td>
                    </tr>`;
                }).join('');
                cont.innerHTML = `<table class="ref-request-table"><thead><tr><th>Artículo</th><th>Cantidad</th><th>Almacén destino</th><th>Cuenta contable</th><th></th></tr></thead><tbody>${rows}</tbody></table>`;

                if ($.fn.select2) {
                    $('#refSolicitudListaVista .select2-cuenta-sap').select2({
                        width: '100%',
                        minimumResultsForSearch: 0,
                        dropdownParent: $('#vistaSolicitudCompraSap')
                    });
                }
            }

            async function crearSolicitudCompraSapDesdeVista() {
                if (!solicitudCompraSapLineas.length) { alert('Agrega artículos a la solicitud.'); return; }
                if (solicitudCompraSapLineas.some(x => !Number.isFinite(Number(x.cantidad)) || Number(x.cantidad) <= 0)) { alert('Verifica que todas las cantidades sean mayores a cero.'); return; }
                if (!document.getElementById('refSolicitudFechaVista').value) { alert('Selecciona la fecha necesaria.'); return; }
                if (!confirm(`¿Enviar a revisión una solicitud de compra con ${solicitudCompraSapLineas.length} artículo(s)? Todavía no se enviará a SAP.`)) return;
                const payload = {
                    fechaNecesaria: document.getElementById('refSolicitudFechaVista').value,
                    comentario: document.getElementById('refSolicitudComentarioVista').value.trim(),
                    lineas: solicitudCompraSapLineas.map(x => ({ id: x.id, cantidad: x.cantidad, warehouseCode: x.warehouseCode, accountCode: x.accountCode }))
                };
                const btn = document.querySelector('#vistaSolicitudCompraSap .ref-pos-footer .ref-btn-brand');
                const html = btn?.innerHTML;
                if (btn) { btn.disabled = true; btn.innerHTML = '<i class="bi bi-arrow-repeat ref-spin me-1"></i>Guardando...'; }
                mostrarLoadingRef('Guardando solicitud para revisión...');
                try {
                    const creada = await postJson(URL_CREAR_SOLICITUD_COMPRA_SAP, payload);
                    if (!creada?.ok) throw new Error(creada?.mensaje || 'No se pudo guardar la solicitud.');
                    solicitudCompraSapLineas = [];
                    alertasSeleccionadasSolicitud.clear();
                    await cargarDatos();
                    renderCatalogoSolicitudCompraSap();
                    renderListaSolicitudCompraSap();
                    alert(`Solicitud guardada en SIGO. Folio: ${creada.folio}. Estatus: Pendiente de revisión del jefe de área.`);
                    await cargarSolicitudesCompraSapRefacciones();
                    abrirModal('modalSolicitudesCompraSapRefacciones');
                } catch (error) {
                    alert(error.message || 'No se pudo enviar la solicitud.');
                } finally {
                    ocultarLoadingRef();
                    if (btn) { btn.disabled = false; btn.innerHTML = html; }
                }
            }

            async function abrirSolicitudesCompraSapRefacciones() {
                const solicitudes = document.getElementById('modalSolicitudesCompraSapRefacciones');
                const alertas = document.getElementById('modalAlertasRef');
                if (alertas?.classList.contains('show')) {
                    alertas.addEventListener('hidden.bs.modal', async function abrirLista() {
                        abrirModal('modalSolicitudesCompraSapRefacciones');
                        await cargarSolicitudesCompraSapRefacciones();
                    }, { once: true });
                    bootstrap.Modal.getOrCreateInstance(alertas).hide();
                    return;
                }
                abrirModal('modalSolicitudesCompraSapRefacciones');
                await cargarSolicitudesCompraSapRefacciones();
            }

            async function cargarSolicitudesCompraSapRefacciones() {
                const tbody = document.getElementById('tbodySolicitudesCompraSapRefacciones');
                if (!tbody) return;
                tbody.innerHTML = '<tr><td colspan="6" class="text-center">Cargando...</td></tr>';
                try {
                    const res = await getJson(URL_LISTAR_SOLICITUDES_COMPRA_SAP);
                    const items = res?.items || [];
                    if (!res?.ok || !items.length) {
                        tbody.innerHTML = `<tr><td colspan="6" class="text-center py-4">${res?.ok ? 'Aún no hay solicitudes.' : 'No se pudieron consultar las solicitudes.'}</td></tr>`;
                        return;
                    }
                    tbody.innerHTML = items.map((s, index) => {
                        const detalleId = `solicitud-compra-detalle-${index}`;
                        const articulos = s.articulos || [];
                        const cantidadArticulos = articulos.length || s.cantidadLineas || 0;
                        return `<tr>
                            <td><strong>${escapeHtml(s.folio)}</strong><br><small>${escapeHtml(s.usuario || '')}</small></td>
                            <td>${s.fechaCreacion ? new Date(s.fechaCreacion).toLocaleString() : '—'}</td>
                            <td>${s.fechaNecesaria ? new Date(s.fechaNecesaria).toLocaleDateString() : '—'}</td>
                            <td><button type="button" class="btn btn-sm btn-outline-primary" aria-expanded="false" onclick="toggleDetalleArticulosSap('${detalleId}', this)"><i class="bi bi-list-ul me-1"></i>Ver ${cantidadArticulos} artículo(s)</button></td>
                            <td><span class="badge ${claseEstadoSolicitud(s.estado)}">${escapeHtml(etiquetaEstadoSolicitud(s.estado))}</span>${s.error ? `<small class="d-block text-danger mt-1">${escapeHtml(s.error)}</small>` : ''}</td>
                            <td>${s.estado === 'ENVIADO' ? `<strong>SAP ${s.sapDocNum || 'Enviado'}</strong>` : (s.estado === 'AUTORIZADA_CONTADURIA' || s.estado === 'ERROR_SAP' ? 'Lista para envío del jefe de área' : 'Sigue el flujo de autorización')}</td>
                        </tr>
                        <tr id="${detalleId}" class="d-none"><td colspan="6" class="p-2 bg-light">${renderDetalleArticulosSap(articulos)}</td></tr>`;
                    }).join('');
                } catch (error) {
                    tbody.innerHTML = `<tr><td colspan="6" class="text-center text-danger">${escapeHtml(error.message || 'Error de consulta.')}</td></tr>`;
                }
            }

            function etiquetaEstadoSolicitud(estado) {
                return ({ PENDIENTE_JEFE: 'Pendiente revisión de jefatura', PENDIENTE_CONTADURIA: 'Pendiente contaduría',
                    AUTORIZADA_CONTADURIA: 'Autorizada', ENVIANDO: 'Enviando a SAP', ENVIADO: 'Enviado a SAP',
                    ERROR_SAP: 'Autorizada · Error SAP', CANCELADA: 'Cancelada', RECHAZADA_CONTADURIA: 'Rechazada por contaduría' })[estado] || estado || '—';
            }

            function claseEstadoSolicitud(estado) {
                if (estado === 'ENVIADO' || estado === 'AUTORIZADA_CONTADURIA') return 'bg-success';
                if (estado === 'CANCELADA' || estado === 'RECHAZADA_CONTADURIA' || estado === 'ERROR_SAP') return 'bg-danger';
                if (estado === 'ENVIANDO') return 'bg-info text-dark';
                return 'bg-warning text-dark';
            }

            let pestanaFlujoSolicitudActual = 'crear';

            function cambiarPestanaFlujoSolicitud(pestana) {
                pestanaFlujoSolicitudActual = pestana;
                const esCrear = pestana === 'crear';
                document.getElementById('panelCrearSolicitudCompra')?.classList.toggle('d-none', !esCrear);
                document.getElementById('panelGestionSolicitudesCompra')?.classList.toggle('d-none', esCrear);
                document.getElementById('tabCrearSolicitudCompra')?.classList.toggle('active', esCrear);
                const titulo = document.querySelector('#vistaSolicitudCompraSap > .ref-pos-header h5');
                if (titulo) titulo.innerHTML = esCrear
                    ? '<i class="bi bi-cart-plus me-2"></i>Solicitud de compra para SAP'
                    : '<i class="bi bi-clipboard-check me-2"></i>Autorizaciones de jefatura';
                if (!esCrear) cargarPanelFlujoSolicitud();
            }

            async function cargarPanelFlujoSolicitud() {
                const tbody = document.getElementById('tbodyGestionSolicitudesCompra');
                if (!tbody) return;
                const esJefe = pestanaFlujoSolicitudActual === 'jefe';
                document.getElementById('tituloPanelFlujoSolicitud').textContent = esJefe ? 'Revisión de jefatura' : 'Autorización de contaduría';
                document.getElementById('descripcionPanelFlujoSolicitud').textContent = esJefe
                    ? 'Revisa el motivo y el detalle. Después de la autorización contable, desde esta pestaña puedes enviar la solicitud a SAP.'
                    : 'Autoriza o rechaza las solicitudes aprobadas por jefatura. La autorización habilita el envío a SAP.';
                tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4">Cargando solicitudes...</td></tr>';
                try {
                    const res = await getJson(URL_LISTAR_SOLICITUDES_COMPRA_SAP);
                    if (!res || !res.ok) throw new Error('No se pudo consultar la bandeja.');
                    const items = res.items || [];
                    if (!items.length) {
                        tbody.innerHTML = '<tr><td colspan="7" class="text-center py-4">No hay solicitudes registradas.</td></tr>';
                        return;
                    }
                    tbody.innerHTML = items.map(function (s, index) {
                        const detalleId = 'flujo-solicitud-detalle-' + pestanaFlujoSolicitudActual + '-' + index;
                        let acciones = '<span class="text-muted">—</span>';
                        if (esJefe && s.estado === 'PENDIENTE_JEFE') {
                            acciones = '<button type="button" class="btn btn-sm btn-success me-1" onclick="decidirSolicitudCompra(' + s.id + ',\'jefe\',true)"><i class="bi bi-check2 me-1"></i>Pasar a contaduría</button>' +
                                '<button type="button" class="btn btn-sm btn-outline-danger" onclick="decidirSolicitudCompra(' + s.id + ',\'jefe\',false)">Cancelar</button>';
                        } else if (esJefe && (s.estado === 'AUTORIZADA_CONTADURIA' || s.estado === 'ERROR_SAP')) {
                            acciones = '<button type="button" class="btn btn-sm btn-primary" onclick="enviarSolicitudCompraSapFlujo(' + s.id + ',\'' + escapeHtml(s.folio) + '\')"><i class="bi bi-cloud-upload me-1"></i>' +
                                (s.estado === 'ERROR_SAP' ? 'Reintentar SAP' : 'Enviar a SAP') + '</button>';
                        }
                        const decisiones = [];
                        if (s.jefeAreaUsuario) decisiones.push('<div><strong>Jefatura:</strong> ' + escapeHtml(s.jefeAreaUsuario) +
                            (s.jefeAreaFecha ? ' · ' + new Date(s.jefeAreaFecha).toLocaleString() : '') +
                            (s.jefeAreaComentario ? '<br><small>' + escapeHtml(s.jefeAreaComentario) + '</small>' : '') + '</div>');
                        if (s.contaduriaUsuario) decisiones.push('<div class="mt-1"><strong>Contaduría:</strong> ' + escapeHtml(s.contaduriaUsuario) +
                            (s.contaduriaFecha ? ' · ' + new Date(s.contaduriaFecha).toLocaleString() : '') +
                            (s.contaduriaComentario ? '<br><small>' + escapeHtml(s.contaduriaComentario) + '</small>' : '') + '</div>');
                        const articulos = s.articulos || [];
                        const textoFiltro = [s.folio, s.usuario, s.comentario, s.estado, s.error,
                            ...articulos.flatMap(function (a) { return [a.itemCode, a.descripcion, a.almacen, a.cuentaContable]; })].join(' ');
                        return '<tr data-fila-flujo="1" data-fecha="' + escapeHtml((s.fechaCreacion || '').slice(0, 10)) + '" data-estado="' + escapeHtml(s.estado) +
                            '" data-busqueda="' + escapeHtml(textoFiltro) + '" data-detalle-id="' + detalleId + '"><td><strong>' + escapeHtml(s.folio) + '</strong><br><small>' + escapeHtml(s.usuario || '') + '</small></td>' +
                            '<td>' + (s.fechaCreacion ? new Date(s.fechaCreacion).toLocaleString() : '—') + '</td>' +
                            '<td>' + (s.fechaNecesaria ? new Date(s.fechaNecesaria).toLocaleDateString() : '—') + '</td>' +
                            '<td><button type="button" class="btn btn-sm btn-outline-primary" aria-expanded="false" onclick="toggleDetalleArticulosSap(\'' + detalleId + '\',this)"><i class="bi bi-list-ul me-1"></i>Ver ' + (articulos.length || s.cantidadLineas || 0) + '</button></td>' +
                            '<td><span class="badge ' + claseEstadoSolicitud(s.estado) + '">' + escapeHtml(etiquetaEstadoSolicitud(s.estado)) + '</span>' +
                            (s.sapDocNum ? '<small class="d-block mt-1">SAP ' + s.sapDocNum + '</small>' : '') +
                            (s.error ? '<small class="d-block text-danger mt-1">' + escapeHtml(s.error) + '</small>' : '') + '</td>' +
                            '<td>' + (decisiones.join('') || '<span class="text-muted">Sin revisión</span>') + '</td><td>' + acciones + '</td></tr>' +
                            '<tr id="' + detalleId + '" class="d-none"><td colspan="7" class="p-2 bg-light">' + renderDetalleArticulosSap(articulos) + '</td></tr>';
                    }).join('');
                    aplicarFiltrosJefeSolicitud();
                } catch (error) {
                    tbody.innerHTML = '<tr><td colspan="7" class="text-center text-danger py-4">' + escapeHtml(error.message || 'Error al cargar solicitudes.') + '</td></tr>';
                }
            }

            function aplicarFiltrosJefeSolicitud() {
                const tbody = document.getElementById('tbodyGestionSolicitudesCompra');
                if (!tbody) return;
                const texto = (document.getElementById('filtroTextoJefeSolicitud')?.value || '').trim().toLocaleLowerCase();
                const desde = document.getElementById('filtroDesdeJefeSolicitud')?.value || '';
                const hasta = document.getElementById('filtroHastaJefeSolicitud')?.value || '';
                const estado = document.getElementById('filtroEstadoJefeSolicitud')?.value || '';
                const filas = [...tbody.querySelectorAll('tr[data-fila-flujo="1"]')];
                let visibles = 0;
                filas.forEach(function (fila) {
                    const fecha = fila.dataset.fecha || '';
                    const coincide = (!texto || (fila.dataset.busqueda || '').toLocaleLowerCase().includes(texto)) &&
                        (!desde || fecha >= desde) && (!hasta || fecha <= hasta) && (!estado || fila.dataset.estado === estado);
                    fila.classList.toggle('d-none', !coincide);
                    const detalle = document.getElementById(fila.dataset.detalleId);
                    const expandido = fila.querySelector('button[aria-expanded="true"]');
                    if (detalle) detalle.classList.toggle('d-none', !coincide || !expandido);
                    if (coincide) visibles++;
                });
                let vacio = tbody.querySelector('.sin-resultados-filtro-jefe');
                if (!visibles && filas.length) {
                    if (!vacio) {
                        vacio = document.createElement('tr');
                        vacio.className = 'sin-resultados-filtro-jefe';
                        vacio.innerHTML = '<td colspan="7" class="text-center text-muted py-4">No hay solicitudes que coincidan con estos filtros.</td>';
                        tbody.appendChild(vacio);
                    }
                } else if (vacio) vacio.remove();
                const resumen = document.getElementById('resumenFiltrosJefeSolicitud');
                if (resumen) resumen.textContent = visibles + ' de ' + filas.length + ' solicitud(es)';
            }

            function limpiarFiltrosJefeSolicitud() {
                ['filtroTextoJefeSolicitud', 'filtroDesdeJefeSolicitud', 'filtroHastaJefeSolicitud', 'filtroEstadoJefeSolicitud']
                    .forEach(function (id) { const input = document.getElementById(id); if (input) input.value = ''; });
                aplicarFiltrosJefeSolicitud();
            }

            async function decidirSolicitudCompra(id, etapa, aprobar) {
                const comentario = prompt(aprobar ? 'Comentario de revisión (opcional):' :
                    (etapa === 'jefe' ? 'Motivo de cancelación:' : 'Motivo del rechazo:'), '');
                if (comentario === null) return;
                if (!aprobar && !comentario.trim()) { alert('Escribe el motivo para continuar.'); return; }
                const verbo = etapa === 'jefe' ? (aprobar ? 'pasar a contaduría' : 'cancelar') : (aprobar ? 'autorizar' : 'rechazar');
                if (!confirm('¿Confirmas ' + verbo + ' esta solicitud?')) return;
                try {
                    const url = etapa === 'jefe' ? URL_REVISAR_SOLICITUD_COMPRA_SAP : URL_AUTORIZAR_SOLICITUD_COMPRA_SAP;
                    const res = await postJson(url, { id: id, aprobar: aprobar, comentario: comentario.trim() });
                    if (!res || !res.ok) throw new Error((res && res.mensaje) || 'No se pudo actualizar la solicitud.');
                    alert(res.mensaje);
                    await cargarPanelFlujoSolicitud();
                    await cargarSolicitudesCompraSapRefacciones();
                    await cargarDatos();
                } catch (error) { alert(error.message || 'No se pudo actualizar la solicitud.'); }
            }

            async function enviarSolicitudCompraSapFlujo(id, folio) {
                if (!confirm('¿Enviar a SAP la solicitud ' + folio + '? Solo se enviará el documento ya autorizado por contaduría.')) return;
                mostrarLoadingRef('Comprobando autorización y enviando a SAP...');
                try {
                    const res = await postJson(URL_ENVIAR_SOLICITUD_COMPRA_SAP, { id: id });
                    if (!res || !res.ok) throw new Error((res && res.mensaje) || 'SAP no confirmó el envío.');
                    alert(res.mensaje + '\nDocumento SAP: ' + (res.docNum || '—') + ' (DocEntry ' + (res.docEntry || '—') + ').');
                    await cargarPanelFlujoSolicitud();
                    await cargarSolicitudesCompraSapRefacciones();
                } catch (error) {
                    alert(error.message || 'No se pudo enviar la solicitud a SAP.');
                    await cargarPanelFlujoSolicitud();
                } finally { ocultarLoadingRef(); }
            }

            async function abrirRecepcionesSap() {
                abrirModal('modalRecepcionesCompraSap');
                await cargarOrdenesCompraRecepcionSap();
            }

                async function cargarOrdenesCompraRecepcionSap() {
                const lista = document.getElementById('listaOrdenesCompraRecepcionSap');
                const historial = document.getElementById('tbodyHistorialRecepcionSap');

                if (!lista || !historial) return;

                lista.innerHTML = '<div class="text-center py-4">Consultando órdenes abiertas en SAP...</div>';
                historial.innerHTML = '<tr><td colspan="6" class="text-center">Cargando...</td></tr>';

                try {
                    const res = await getJson(URL_ORDENES_RECEPCION_SAP);
                    if (!res?.ok) throw new Error(res?.mensaje || 'No se pudieron consultar las órdenes.');

                    ordenesCompraRecepcionSap = res.ordenes || [];

                    // Generar lista principal de ordenes
                    lista.innerHTML = ordenesCompraRecepcionSap.length
                        ? ordenesCompraRecepcionSap.map(generarHtmlOrden).join('')
                        : '<div class="text-center text-muted py-4">No hay órdenes abiertas vinculadas a las solicitudes de SIGO.</div>';

                    const recepciones = res.recepciones || [];

                    // Generar historial
                    historial.innerHTML = recepciones.length
                        ? recepciones.map(generarHtmlHistorial).join('')
                        : '<tr><td colspan="6" class="text-center text-muted">Aún no hay entradas registradas.</td></tr>';

                } catch (error) {
                    lista.innerHTML = `<div class="alert alert-danger">${escapeHtml(error.message || 'Error al consultar SAP.')}</div>`;
                    historial.innerHTML = '<tr><td colspan="6" class="text-center text-muted">No disponible.</td></tr>';
                }
            }

            // Retorna el bloque principal de cada orden
            function generarHtmlOrden(o) {
                const lineasHtml = (o.lineas || []).map(generarHtmlLinea).join('');

                return `
                    <section class="border rounded-3 p-3 mb-3" id="recepcionOrden-${o.solicitudId}-${o.docEntry}">
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                            <div>
                                <strong>Orden SAP ${o.docNum}</strong> · ${escapeHtml(o.proveedor || 'Proveedor no especificado')}<br>
                                <small>Solicitud SAP ${o.solicitudSap || '—'} · Folio SIGO ${escapeHtml(o.folioSolicitud || '')}</small>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-sm btn-outline-primary" onclick="imprimirOrdenCompraSap(${o.docEntry})">
                                    <i class="bi bi-printer me-1"></i>Imprimir OC
                                </button>
                                <button type="button" class="btn btn-sm btn-danger" onclick="registrarRecepcionSap(${o.solicitudId},${o.docEntry},${o.docNum})">
                                    <i class="bi bi-check2-circle me-1"></i>Registrar lo recibido
                                </button>
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr><th>Artículo</th><th>Almacén SAP</th><th>Ordenado</th><th>Pendiente en SAP</th><th>Recibido ahora</th></tr>
                                </thead>
                                <tbody>
                                    ${lineasHtml}
                                </tbody>
                            </table>
                        </div>
                    </section>`;
            }

            // Retorna la fila de articulo para la tabla
            function generarHtmlLinea(l) {
                const cantidadAbierta = Math.floor(Number(l.cantidadAbierta || 0));

                return `
                    <tr>
                        <td>
                            <strong>${escapeHtml(l.sku)}</strong><br>
                            <small>${escapeHtml(l.descripcion || '')}</small>
                        </td>
                        <td>${escapeHtml(l.almacen || '—')}</td>
                        <td>${Number(l.cantidadOrdenada || 0)}</td>
                        <td>${Number(l.cantidadAbierta || 0)}</td>
                        <td>
                            <input class="form-control form-control-sm recepcion-cantidad"
                                   type="number" min="0" max="${cantidadAbierta}" step="1" value="0"
                                   data-line="${l.lineNum}"
                                   aria-label="Cantidad a recibir de ${escapeHtml(l.sku)}" />
                        </td>
                    </tr>`;
            }

            // Retorna la fila para la tabla de historial
            function generarHtmlHistorial(x) {
                const fecha = x.fechaCreacion ? new Date(x.fechaCreacion).toLocaleString() : '—';
                const badgeClass = x.estado === 'ENVIADO' ? 'bg-success' : x.estado === 'ERROR' ? 'bg-danger' : 'bg-warning text-dark';
                const errorMsg = x.error ? `<small class="d-block text-danger">${escapeHtml(x.error)}</small>` : '';

                let btnAccion = '—';
                if (x.estado === 'SAP_ENVIADO_PENDIENTE_LOCAL' && x.sapDocNum) {
                    btnAccion = `<button class="btn btn-sm btn-outline-primary" onclick="reaplicarInventarioRecepcionSap(${x.id})">Sincronizar SIGO</button>`;
                } else if (x.estado === 'ERROR') {
                    btnAccion = `<button class="btn btn-sm btn-outline-primary" onclick="reintentarRecepcionCompraSap(${x.id})">Reintentar seguro</button>`;
                }

                return `
                    <tr>
                        <td>${fecha}</td>
                        <td>${x.ordenCompraDocNum || '—'}</td>
                        <td>${escapeHtml(x.folio || '')}</td>
                        <td>
                            <span class="badge ${badgeClass}">${escapeHtml(x.estado)}</span>
                            ${errorMsg}
                        </td>
                        <td>${x.sapDocNum || '—'}</td>
                        <td>${btnAccion}</td>
                    </tr>`;
            }
            async function imprimirOrdenCompraSap(docEntry) {
                // Abrir la pestaña en el gesto del usuario para evitar que el navegador
                // bloquee la impresión mientras esperamos la respuesta de SAP.
                const ventana = window.open('', '_blank');
                if (!ventana) {
                    alert('Permite las ventanas emergentes para imprimir la orden.');
                    return;
                }

                ventana.document.write('<!doctype html><title>Consultando orden...</title><p style="font:16px Arial;padding:24px">Consultando la orden en SAP...</p>');
                try {
                    const data = await getJson(`${URL_DOCUMENTO_ORDEN_COMPRA_SAP}?docEntry=${encodeURIComponent(docEntry)}`);
                    if (!data?.ok) throw new Error(data?.mensaje || 'SAP no devolvió la orden de compra.');

                    const moneda = data.moneda || 'MXN';
                    const importe = valor => Number(valor || 0).toLocaleString('es-MX', {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    }) + ' ' + escapeHtml(moneda);
                    const fecha = valor => valor ? new Date(valor + 'T00:00:00').toLocaleDateString('es-MX') : '—';
                    const lineas = (data.lineas || []).map(l => `
                        <tr>
                            <td>${Number(l.linea ?? 0) + 1}</td>
                            <td><strong>${escapeHtml(l.sku || '')}</strong><br>${escapeHtml(l.descripcion || '')}</td>
                            <td class="num">${Number(l.cantidad || 0).toLocaleString('es-MX')}</td>
                            <td>${escapeHtml(l.unidad || '—')}</td>
                            <td>${escapeHtml(l.almacen || '—')}</td>
                            <td class="num">${importe(l.precioUnitario)}</td>
                            <td class="num">${Number(l.descuento || 0).toLocaleString('es-MX')}%</td>
                            <td>${escapeHtml(l.impuesto || '—')}</td>
                            <td class="num">${importe(l.importe)}</td>
                        </tr>`).join('');

                    const solicitudSap = ordenesCompraRecepcionSap.find(o => Number(o.docEntry) === Number(docEntry))?.solicitudSap || '—';
                    const comentarios = data.comentarios
                        ? '<p><strong>Comentarios:</strong> ' + escapeHtml(data.comentarios) + '</p>'
                        : '';

                    // Se arma como arreglo de cadenas (igual que imprimirEtiqueta) para que
                    // las etiquetas <style></style> queden balanceadas y Razor no trate el
                    // resto del script como CSS.
                    const html = [
                        '<!doctype html>',
                        '<html lang="es">',
                        '<head>',
                        '<meta charset="utf-8" />',
                        '<title>Orden de compra SAP ' + escapeHtml(data.docNum) + '</title>',
                        '<style>',
                        '  @@page { size: landscape; margin: 12mm; }',
                        '  * { box-sizing: border-box; }',
                        '  body { font: 12px Arial, sans-serif; color: #172033; margin: 0; }',
                        '  h1 { font-size: 20px; margin: 0 0 4px; }',
                        '  h2 { font-size: 14px; margin: 0 0 12px; color: #475569; }',
                        '  .top { display: flex; justify-content: space-between; border-bottom: 2px solid #991b1b; padding-bottom: 12px; margin-bottom: 14px; }',
                        '  .logo { height: 80px; width: 190; display: block; margin-bottom: 6px; }',
                        '  .badge { color: #991b1b; font-weight: bold; font-size: 18px; }',
                        '  .info { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px 18px; margin-bottom: 16px; }',
                        '  .label { color: #64748b; font-size: 10px; text-transform: uppercase; }',
                        '  .value { font-weight: 600; margin-top: 3px; }',
                        '  table { width: 100%; border-collapse: collapse; }',
                        '  th { background: #f1f5f9; text-align: left; font-size: 10px; }',
                        '  th, td { border: 1px solid #cbd5e1; padding: 6px; vertical-align: top; }',
                        '  .num { text-align: right; white-space: nowrap; }',
                        '  .totales { width: 320px; margin: 12px 0 0 auto; }',
                        '  .totales div { display: flex; justify-content: space-between; padding: 4px 0; }',
                        '  .gran-total { border-top: 2px solid #991b1b; font-size: 15px; font-weight: bold; }',
                        '  .nota { margin-top: 18px; font-size: 10px; color: #64748b; }',
                        '  @@media print { button { display: none; } }',
                        '</style>',
                        '</head>',
                        '<body>',
                        '<div class="top">',
                        '  <div><img class="logo" src="' + escapeHtml(location.origin + '/images/ico_sigo.ico') + '" alt="SIGO" /><h1>Orden de compra</h1><h2>Documento recuperado de SAP Business One</h2></div>',
                        '  <div class="badge">OC ' + escapeHtml(data.docNum) + '</div>',
                        '</div>',
                        '<div class="info">',
                        '  <div><div class="label">Proveedor</div><div class="value">' + escapeHtml(data.proveedorCodigo) + ' · ' + escapeHtml(data.proveedor) + '</div></div>',
                        '  <div><div class="label">Referencia del proveedor</div><div class="value">' + escapeHtml(data.referenciaProveedor || '—') + '</div></div>',
                        '  <div><div class="label">Moneda</div><div class="value">' + escapeHtml(moneda) + '</div></div>',
                        '  <div><div class="label">Fecha del documento</div><div class="value">' + fecha(data.fecha) + '</div></div>',
