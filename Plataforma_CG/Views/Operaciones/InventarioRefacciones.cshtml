                    if (!res?.ok) throw new Error(res?.mensaje || 'No se pudo completar el reintento.');
                    alert(res.mensaje || 'Recepción sincronizada.');
                    await cargarDatos();
                    await cargarOrdenesCompraRecepcionSap();
                } catch (error) { alert(error.message || 'Error al reintentar la recepción.'); }
                finally { ocultarLoadingRef(); }
            }

