@section Scripts {
        <!-- CSS de Select2 -->
        <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />

        <!-- JS de Select2 -->
        <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
        <script>
            let inventario = [];
            let movimientos = [];
            let categorias = [];
            let ubicaciones = [];
            let maquinas = [];

            let filtroActual = 'Todos';
            let verTodosMovimientos = false;
            let modoVista = 'grid';
            let paginaRef = 1;
            let tamPaginaRef = 24;
            let totalPaginasRef = 1;
            let alertasRefActuales = [];
            let scanBuffer = '';
            let lastScanKeyTime = 0;

            const URL_CARGAR = '@Url.Action("Cargar", "InventarioRefacciones")' || '/InventarioRefacciones/Cargar';
            const URL_GUARDAR_REF = '@Url.Action("GuardarRefaccion", "InventarioRefacciones")' || '/InventarioRefacciones/GuardarRefaccion';
            const URL_MOVIMIENTO = '@Url.Action("RegistrarMovimiento", "InventarioRefacciones")' || '/InventarioRefacciones/RegistrarMovimiento';
            const URL_SALIDA_POS = '@Url.Action("RegistrarSalidaPos", "InventarioRefacciones")' || '/InventarioRefacciones/RegistrarSalidaPos';
            const URL_GUARDAR_CAT = '@Url.Action("GuardarCategoria", "InventarioRefacciones")' || '/InventarioRefacciones/GuardarCategoria';
            const URL_ELIMINAR_CAT = '@Url.Action("EliminarCategoria", "InventarioRefacciones")' || '/InventarioRefacciones/EliminarCategoria';
            const URL_GUARDAR_UBI = '@Url.Action("GuardarUbicacion", "InventarioRefacciones")' || '/InventarioRefacciones/GuardarUbicacion';
            const URL_ELIMINAR_UBI = '@Url.Action("EliminarUbicacion", "InventarioRefacciones")' || '/InventarioRefacciones/EliminarUbicacion';
            const URL_GUARDAR_MAQ = '@Url.Action("GuardarMaquina", "InventarioRefacciones")' || '/InventarioRefacciones/GuardarMaquina';
            const URL_ELIMINAR_MAQ = '@Url.Action("EliminarMaquina", "InventarioRefacciones")' || '/InventarioRefacciones/EliminarMaquina';
            const URL_SUBIR_FOTO = '@Url.Action("SubirFoto", "InventarioRefacciones")' || '/InventarioRefacciones/SubirFoto';
            const URL_ELIMINAR_FOTO = '@Url.Action("EliminarFoto", "InventarioRefacciones")' || '/InventarioRefacciones/EliminarFoto';
            const URL_SYNC_SAP = '@Url.Action("SincronizarSap", "InventarioRefacciones")' || '/InventarioRefacciones/SincronizarSap';
            const URL_PREVIA_SAP = '@Url.Action("PreviaSap", "InventarioRefacciones")' || '/InventarioRefacciones/PreviaSap';
            const URL_GENERAR_QR = '@Url.Action("GenerarQR", "InventarioRefacciones")' || '/InventarioRefacciones/GenerarQR';
            const URL_GUARDAR_VISTA = '@Url.Action("GuardarVista", "InventarioRefacciones")' || '/InventarioRefacciones/GuardarVista';

            async function postJson(url, data) {
                const res = await fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                    body: JSON.stringify(data || {})
                });
                return await res.json();
            }

            function mostrarLoadingRef(txt) {
                const el = document.getElementById('refLoading');
                const t = document.getElementById('refLoadingTxt');
                if (t && txt) t.textContent = txt;
                if (el) el.classList.add('show');
            }

            function ocultarLoadingRef() {
                const el = document.getElementById('refLoading');
                if (el) el.classList.remove('show');
            }

            async function getJson(url) {
                const res = await fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                return await res.json();
            }

            async function cargarDatos() {
                try {
                    const res = await fetch(URL_CARGAR, { headers: { 'X-Requested-With': 'XMLHttpRequest' } });
                    const data = await res.json();

                    if (!data || !data.ok) {
                        alert('No se pudo cargar la información de la base de datos.');
                        return;
                    }

                    inventario = data.refacciones || [];
                    categorias = data.categorias || [];
                    ubicaciones = data.ubicaciones || [];
                    maquinas = data.maquinas || [];
                    movimientos = data.movimientos || [];

                    modoVista = data.vista === 'table' ? 'table' : 'grid';
                    aplicarModoVistaUI();

                    renderTabs();
                    renderSelectsCatalogos();
                    renderCatalogos();
                    renderUI();
                } catch (e) {
                    console.error(e);
                    alert('Error al cargar la información.');
                }
            }

            const usuarioSesion = '@Html.Raw(usuarioActual.Replace("'", "\\'"))';

            function abrirModal(id) {
                const el = document.getElementById(id);
                if (el) bootstrap.Modal.getOrCreateInstance(el).show();
            }

            function cerrarModal(id) {
                const el = document.getElementById(id);
                if (el) bootstrap.Modal.getOrCreateInstance(el).hide();
            }

            function fechaRelativa(iso) {
                if (!iso) return '';
                const fecha = new Date(iso);
                if (isNaN(fecha)) return '';

                const seg = Math.floor((Date.now() - fecha.getTime()) / 1000);
                if (seg < 60) return 'Justo ahora';

                const min = Math.floor(seg / 60);
                if (min < 60) return `Hace ${min} min`;

                const hrs = Math.floor(min / 60);
                if (hrs < 24) return `Hace ${hrs} hrs`;

                const dias = Math.floor(hrs / 24);
                if (dias < 30) return `Hace ${dias} día${dias === 1 ? '' : 's'}`;

                return fecha.toLocaleDateString('es-MX', { day: '2-digit', month: 'short', year: 'numeric' });
            }

            function inicialesDe(nombre) {
                const partes = String(nombre || '').trim().split(/\s+/).filter(Boolean);
                if (partes.length === 0) return '--';
                return (partes[0][0] + (partes[1] ? partes[1][0] : '')).toUpperCase();
            }

            function escapeHtml(s) {
                return String(s == null ? '' : s)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#39;');
            }

            $(document).ready(function () {
                $('#userInitials').text(inicialesDe(usuarioSesion));

                $('#refTabs').on('click', '.ref-tab', function () {
                    const valor = decodeURIComponent($(this).data('cat') || '');
                    filtrarPorCategoria(valor, this);
                });

               $('#posScan').off('keydown').on('keydown', function (e) {
                if (e.which === 13 || e.keyCode === 13 || e.key === 'Enter') {
                    e.preventDefault();
                    const valorEscaneado = $(this).val().trim();
                    if (valorEscaneado) {
                        procesarEscaneo(valorEscaneado);
                    }
                }
            });

                // ===== Escaneo global (pistola) =====
                $(document).on('keydown.scanref', function (e) {
                    if (e.ctrlKey || e.altKey || e.metaKey) return;

                    const el = e.target || {};
                    const tag = (el.tagName || '').toLowerCase();
                    const id = el.id || '';

                    if (id === 'posScan') return;

                    const posVisible = $('#vistaPos').is(':visible');
                    const enCampoTexto = tag === 'input' || tag === 'textarea' || tag === 'select' || el.isContentEditable;
                    const esBuscador = id === 'searchInput';

                    if (enCampoTexto && !esBuscador && !posVisible) return;
                    if (document.querySelector('.modal.show')) return;

                    const now = Date.now();
                    if (now - lastScanKeyTime > 100) scanBuffer = '';
                    lastScanKeyTime = now;

                    if (e.key === 'Enter') {
                        const codigo = scanBuffer;
                        scanBuffer = '';
                        if (codigo.length > 2) {
                            e.preventDefault();
                            manejarEscaneo(codigo);
                        }
                    } else if (e.key && e.key.length === 1) {
                        scanBuffer += e.key;
                    }
                });

                $('#adjType').on('change', function() {
                    if($(this).val() === 'salida') {
                        $('#divMaquinaDestino').show();
                    } else {
                        $('#divMaquinaDestino').hide();
                        $('#adjMachine').val('');
                    }
                    actualizarValidacionCantidad();
                });

                cargarDatos();
                revisarPendientesSap();
            });

            function actualizarValidacionCantidad() {
                const input = document.getElementById('adjQty');
                if (!input) return;

                const tipo = $('#adjType').val();
                input.setAttribute('min', tipo === 'ajuste' ? '-999999' : '1');
                input.placeholder = tipo === 'ajuste' ? 'Ej. -3 para restar' : '';
            }

            function filtrarPorCategoria(categoria, elemento) {
                $('.ref-tab').removeClass('active');$(elemento).addClass('active');
                filtroActual = categoria;
                paginaRef = 1;
                renderTarjetas();
            }

            function renderTabs() {
                const cont = document.getElementById('refTabs');
                if (!cont) return;

                const nombresCat = categorias.map(c => c.nombre);
                const disponibles = ['Todos', 'Bajo Stock', 'Sobre Stock'].concat(nombresCat);
                if (!disponibles.includes(filtroActual)) filtroActual = 'Todos';

                const base = [
                    { nombre: 'Todos', valor: 'Todos' },
                    { nombre: 'Bajo Stock', valor: 'Bajo Stock' },
                    { nombre: 'Sobre Stock', valor: 'Sobre Stock' }
                ].concat(nombresCat.map(n => ({ nombre: n, valor: n })));

                cont.innerHTML = base.map(t =>
                    `<div class="ref-tab${t.valor === filtroActual ? ' active' : ''}" data-cat="${encodeURIComponent(t.valor)}">${escapeHtml(t.nombre)}</div>`
                ).join('');
            }

               function renderSelectsCatalogos() {
                const selCat = document.getElementById('newCat');
                if (selCat) {
                    const actual = selCat.value;
                    selCat.innerHTML = categorias.length
                        ? categorias.map(c => `<option value="${escapeHtml(c.nombre)}">${escapeHtml(c.nombre)}</option>`).join('')
                        : '<option value="">(sin categorías)</option>';
                    if (actual && categorias.some(c => c.nombre === actual)) selCat.value = actual;
                }

                const selUbi = document.getElementById('newLoc');
                if (selUbi) {
                    const actual = selUbi.value;
                    selUbi.innerHTML = ubicaciones.length
                        ? ubicaciones.map(u => `<option value="${escapeHtml(u.nombre)}">${escapeHtml(u.nombre)}</option>`).join('')
                        : '<option value="">(sin ubicaciones)</option>';
                    if (actual && ubicaciones.some(u => u.nombre === actual)) selUbi.value = actual;
                }

                const opcionesMaquina = '<option value="">Selecciona una máquina...</option>' +
                    maquinas.map(m => `<option value="${escapeHtml(m.nombre)}">${escapeHtml(m.nombre)}</option>`).join('');

                const selMaq = document.getElementById('adjMachine');
                if (selMaq) {
                    const actual = selMaq.value;
                    selMaq.innerHTML = opcionesMaquina;
                    if (actual && maquinas.some(m => m.nombre === actual)) selMaq.value = actual;
                }

                const selPosMaq = document.getElementById('posMaquina');
                if (selPosMaq) {
                    const actual = selPosMaq.value;
                    selPosMaq.innerHTML = opcionesMaquina;
                    if (actual && maquinas.some(m => m.nombre === actual)) selPosMaq.value = actual;
                }

                // === AQUI SE INICIALIZA SELECT2 ===
                // Inicializa en los modales y en el POS global
                $('#newCat, #newLoc, #adjMachine, #posMaquina').select2({
                    width: '100%',
                    dropdownParent: function () {
                        // Ayuda a que el buscador del select no quede oculto detrás de los modales
                        const modals = $('.modal.show');
                        return modals.length ? modals.last() : $(document.body);
                    }()
                });
            }

            function renderCatalogos() {
                const contCat = document.getElementById('listaCategorias');
                if (contCat) {
                    contCat.innerHTML = categorias.length
                        ? categorias.map(c => itemCatalogoHtml('categoria', c)).join('')
                        : '<div class="ref-empty">Sin categorías registradas.</div>';
                }

                const contUbi = document.getElementById('listaUbicaciones');
                if (contUbi) {
                    contUbi.innerHTML = ubicaciones.length
                        ? ubicaciones.map(u => itemCatalogoHtml('ubicacion', u)).join('')
                        : '<div class="ref-empty">Sin ubicaciones registradas.</div>';
                }

                const contMaq = document.getElementById('listaMaquinas');
                if (contMaq) {
                    contMaq.innerHTML = maquinas.length
                        ? maquinas.map(m => itemCatalogoHtml('maquina', m)).join('')
                        : '<div class="ref-empty">Sin máquinas registradas.</div>';
                }
            }

            function itemCatalogoHtml(tipo, item) {
                const etiquetaUso = tipo === 'maquina' ? 'uso(s) en movimientos' : 'refacción(es)';
                const usoTexto = item.uso > 0 ? `<span class="ref-cat-uso">${item.uso} ${etiquetaUso}</span>` : '';

                return `
                    <div class="ref-cat-item">
                        <div class="d-flex flex-column" style="min-width:0;">
                            <span class="ref-cat-nombre">${escapeHtml(item.nombre)}</span>
                            ${usoTexto}
                        </div>
                        <div class="ref-cat-actions">
                            <button type="button" class="ref-icon-btn" title="Renombrar" onclick="renombrarCatalogo('${tipo}', ${item.id})">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button type="button" class="ref-icon-btn danger" title="Eliminar" onclick="eliminarCatalogo('${tipo}', ${item.id})">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </div>
                `;
            }

            async function agregarCatalogo(tipo) {
                const cfg = {
                    categoria: { input: 'catNuevaCategoria', url: URL_GUARDAR_CAT },
                    ubicacion: { input: 'catNuevaUbicacion', url: URL_GUARDAR_UBI },
                    maquina: { input: 'catNuevaMaquina', url: URL_GUARDAR_MAQ }
                }[tipo];
                if (!cfg) return;

                const input = document.getElementById(cfg.input);
                const nombre = (input.value || '').trim();

                if (!nombre) { alert('Escribe un nombre.'); return; }

                const res = await postJson(cfg.url, { id: 0, nombre: nombre });
                if (!res || !res.ok) {
                    alert((res && res.mensaje) || 'No se pudo guardar en el catálogo.');
                    return;
                }

                input.value = '';
                await cargarDatos();
            }

            async function renombrarCatalogo(tipo, id) {
                const cfg = {
                    categoria: { lista: categorias, url: URL_GUARDAR_CAT },
                    ubicacion: { lista: ubicaciones, url: URL_GUARDAR_UBI },
                    maquina: { lista: maquinas, url: URL_GUARDAR_MAQ }
                }[tipo];
                if (!cfg) return;

                const item = cfg.lista.find(x => x.id === id);
                if (!item) return;

                const nuevo = prompt('Nuevo nombre:', item.nombre);
                if (nuevo == null) return;

                const limpio = nuevo.trim();
                if (!limpio || limpio === item.nombre) return;

                const res = await postJson(cfg.url, { id: id, nombre: limpio });
                if (!res || !res.ok) {
                    alert((res && res.mensaje) || 'No se pudo renombrar.');
                    return;
                }

                await cargarDatos();
            }

            async function eliminarCatalogo(tipo, id) {
                const cfg = {
                    categoria: { lista: categorias, url: URL_ELIMINAR_CAT },
                    ubicacion: { lista: ubicaciones, url: URL_ELIMINAR_UBI },
                    maquina: { lista: maquinas, url: URL_ELIMINAR_MAQ }
                }[tipo];
                if (!cfg) return;

                const item = cfg.lista.find(x => x.id === id);
                if (!item) return;

                if (tipo !== 'maquina' && item.uso > 0) {
                    alert(`No se puede eliminar "${item.nombre}": está en uso en ${item.uso} refacción(es).`);
                    return;
                }

                if (!confirm(`¿Eliminar "${item.nombre}" del catálogo?`)) return;

                const res = await postJson(cfg.url, { id: id });
                if (!res || !res.ok) {
                    alert((res && res.mensaje) || 'No se pudo eliminar.');
                    return;
                }

                if (filtroActual === item.nombre) filtroActual = 'Todos';
                await cargarDatos();
            }

            function claseEstado(item) {
                if (item.stock === 0) return { dot: 'dot-out', qty: 'out' };
                if (item.max > 0 && item.stock > item.max) return { dot: 'dot-over', qty: 'over' };
                if (item.stock <= item.min) return { dot: 'dot-low', qty: 'low' };
                return { dot: 'dot-ok', qty: '' };
            }

            function renderTarjetas() {
                const container = $('#gridRefacciones');
                container.empty();

                const textoBusqueda = $('#searchInput').val().toLowerCase();

                let datosFiltrados = inventario.filter(item => {
                    let pasaFiltroTab = true;
                    if (filtroActual === 'Bajo Stock') {
                        pasaFiltroTab = item.stock <= item.min;
                    } else if (filtroActual === 'Sobre Stock') {
                        pasaFiltroTab = item.max > 0 && item.stock > item.max;
                    } else if (filtroActual !== 'Todos') {
                        pasaFiltroTab = item.cat === filtroActual;
                    }

                    let pasaFiltroTexto = true;
                    if (textoBusqueda) {
                        pasaFiltroTexto = item.desc.toLowerCase().includes(textoBusqueda) ||
                                          item.sku.toLowerCase().includes(textoBusqueda) ||
                                          item.loc.toLowerCase().includes(textoBusqueda);
                    }

                    return pasaFiltroTab && pasaFiltroTexto;
                });

                if (datosFiltrados.length === 0) {
                    container.append('<div style="text-align:center; padding: 30px 10px; color: #64748b; font-size: 0.9rem; grid-column: 1/-1;">No se encontraron refacciones con estos filtros.</div>');
                    renderPagerRefacciones(0);
                    return;
                }

                totalPaginasRef = Math.max(1, Math.ceil(datosFiltrados.length / tamPaginaRef));
                if (paginaRef > totalPaginasRef) paginaRef = totalPaginasRef;
                if (paginaRef < 1) paginaRef = 1;

                const inicio = (paginaRef - 1) * tamPaginaRef;
                const pagina = datosFiltrados.slice(inicio, inicio + tamPaginaRef);

                if (modoVista === 'table') {
                    renderTablaRefacciones(container, pagina);
                    renderPagerRefacciones(datosFiltrados.length);
                    return;
                }

                pagina.forEach(item => {
                    const estado = claseEstado(item);
                    const statusClass = estado.dot;
                    const qtyClass = estado.qty;

                    let formatoMoneda = new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(item.costo);

                    let html = `
                        <div class="ref-card-item" data-ref-id="${item.id}">
                            <div class="ref-card-top">
                                <span class="ref-sku-badge" title="Costo Unitario: ${formatoMoneda}">${escapeHtml(item.sku)}</span>
                                <span class="ref-status-dot ${statusClass}"></span>
                            </div>
                            <h3 class="ref-name">${escapeHtml(item.desc)}</h3>
                            <p class="ref-desc"><i class="bi bi-geo-alt"></i> ${escapeHtml(item.loc)}</p>
                            ${item.foto ? `<img class="ref-foto-thumb" src="${escapeHtml(item.foto)}" loading="lazy" decoding="async" alt="${escapeHtml(item.desc)}" title="Ver foto" onclick="verFoto(${item.id})" />` : ''}

                            <div class="ref-card-bottom">
                                <div class="ref-stock-info">
                                    <p>STOCK ACTUAL</p>
                            <div class="ref-stock-qty ${qtyClass}">${item.stock} <span style="font-size:0.7rem; color:var(--ref-text-muted);">${escapeHtml(item.unidadMedidaInventario || 'PZAS')}</span></div>
                                    <div class="ref-minmax">Mín ${item.min} · Máx ${item.max > 0 ? item.max : '—'}</div>
                                </div>
                                <div class="d-flex gap-1">
                                    <button class="ref-icon-btn" title="Editar refacción" onclick="abrirEditar(${item.id})">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="ref-icon-btn" title="${item.foto ? 'Ver / cambiar foto' : 'Cargar o tomar foto'}" onclick="${item.foto ? `verFoto(${item.id})` : `subirFoto(${item.id})`}">
                                        <i class="bi ${item.foto ? 'bi-image' : 'bi-camera'}"></i>
                                    </button>
                                    <button class="ref-icon-btn" title="Imprimir etiqueta QR" onclick="imprimirEtiqueta(${item.id})">
                                        <i class="bi bi-qr-code"></i>
                                    </button>
                                    <button class="btn-action" onclick="abrirAjuste(${item.id})">
                                        <i class="bi bi-arrow-left-right"></i> Ajustar
                                    </button>
                                </div>
                            </div>
                        </div>
                    `;
                    container.append(html);
                });

                renderPagerRefacciones(datosFiltrados.length);
            }

            function renderPagerRefacciones(totalFiltrados) {
                const cont = document.getElementById('pagerRefacciones');
                if (!cont) return;

                if (!totalFiltrados) {
                    cont.innerHTML = '';
                    return;
                }

                const maxBotones = 7;
                let inicio = Math.max(1, paginaRef - 3);
                let fin = Math.min(totalPaginasRef, inicio + maxBotones - 1);
                inicio = Math.max(1, fin - maxBotones + 1);

                let botones = '';
                for (let p = inicio; p <= fin; p++) {
                    botones += `<button type="button" class="ref-page-btn ${p === paginaRef ? 'active' : ''}" onclick="irPaginaRef(${p})">${p}</button>`;
                }

                const desde = (paginaRef - 1) * tamPaginaRef + 1;
                const hasta = Math.min(paginaRef * tamPaginaRef, totalFiltrados);

                cont.innerHTML = `
                    <span class="ref-pager-info">Mostrando ${desde}–${hasta} de ${totalFiltrados}</span>
                    <div class="ref-pager-controls">
                        <select class="ref-page-size" onchange="cambiarTamPaginaRef(this.value)">
                            <option value="12" ${tamPaginaRef === 12 ? 'selected' : ''}>12 / pág.</option>
                            <option value="24" ${tamPaginaRef === 24 ? 'selected' : ''}>24 / pág.</option>
                            <option value="48" ${tamPaginaRef === 48 ? 'selected' : ''}>48 / pág.</option>
                            <option value="96" ${tamPaginaRef === 96 ? 'selected' : ''}>96 / pág.</option>
                        </select>
                        <div class="ref-pager-btns">
                            <button type="button" class="ref-page-btn" ${paginaRef <= 1 ? 'disabled' : ''} onclick="irPaginaRef(1)">«</button>
                            <button type="button" class="ref-page-btn" ${paginaRef <= 1 ? 'disabled' : ''} onclick="irPaginaRef(${paginaRef - 1})">‹</button>
                            ${botones}
                            <button type="button" class="ref-page-btn" ${paginaRef >= totalPaginasRef ? 'disabled' : ''} onclick="irPaginaRef(${paginaRef + 1})">›</button>
                            <button type="button" class="ref-page-btn" ${paginaRef >= totalPaginasRef ? 'disabled' : ''} onclick="irPaginaRef(${totalPaginasRef})">»</button>
                        </div>
                    </div>`;
            }

            function irPaginaRef(p) {
                if (p < 1 || p > totalPaginasRef || p === paginaRef) return;
                paginaRef = p;
                renderTarjetas();
                document.getElementById('gridRefacciones')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }

            function cambiarTamPaginaRef(valor) {
                tamPaginaRef = parseInt(valor, 10) || 24;
                paginaRef = 1;
                renderTarjetas();
            }

            function aplicarModoVistaUI() {
                $('#btnVistaGrid').toggleClass('active', modoVista === 'grid');
                $('#btnVistaTabla').toggleClass('active', modoVista === 'table');

                $('#gridRefacciones')
                    .removeClass('ref-grid ref-table-wrap')
                    .addClass(modoVista === 'table' ? 'ref-table-wrap' : 'ref-grid');
            }

            function cambiarVista(modo) {
                modoVista = modo === 'table' ? 'table' : 'grid';
                aplicarModoVistaUI();
                renderTarjetas();
                guardarVista(modoVista);
            }

            async function guardarVista(modo) {
                try {
                    await postJson(URL_GUARDAR_VISTA, { vista: modo });
                } catch (e) {
                    console.error('No se pudo guardar la preferencia de vista.', e);
                }
            }

            function renderTablaRefacciones(container, datos) {
                const fmtMoneda = new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' });

                const filas = datos.map(item => {
                    const estado = claseEstado(item);
                    const statusClass = estado.dot;
                    const qtyClass = estado.qty;

                    return `
                        <tr data-ref-id="${item.id}">
                            <td>
                                ${item.foto ? `<img class="ref-foto-thumb-sm" src="${escapeHtml(item.foto)}" loading="lazy" decoding="async" alt="${escapeHtml(item.desc)}" title="Ver foto" onclick="verFoto(${item.id})" />` : ''}
                                <span class="ref-sku-badge" title="Costo Unitario: ${fmtMoneda.format(item.costo)}">${escapeHtml(item.sku)}</span>
                            </td>
                            <td>${escapeHtml(item.desc)}</td>
                            <td class="d-none d-md-table-cell">${escapeHtml(item.unidadMedidaInventario || '—')}</td>
                            <td class="d-none d-md-table-cell">${escapeHtml(item.cat || '')}</td>
                            <td><i class="bi bi-geo-alt" style="color:var(--ref-text-muted);"></i> ${escapeHtml(item.loc)}</td>
                            <td class="d-none d-md-table-cell text-center">${item.min}</td>
                            <td class="d-none d-md-table-cell text-center">${item.max > 0 ? item.max : '—'}</td>
                            <td class="text-center">
                                <span class="ref-status-dot ${statusClass}"></span>
                                <span class="ref-table-qty ${qtyClass}">${item.stock}</span>
                            </td>
                            <td class="d-none d-md-table-cell">${fmtMoneda.format(item.costo)}</td>
                            <td>
                                <div class="d-flex gap-1">
                                    <button class="ref-icon-btn" title="Editar refacción" onclick="abrirEditar(${item.id})">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="ref-icon-btn" title="${item.foto ? 'Ver / cambiar foto' : 'Cargar o tomar foto'}" onclick="${item.foto ? `verFoto(${item.id})` : `subirFoto(${item.id})`}">
                                        <i class="bi ${item.foto ? 'bi-image' : 'bi-camera'}"></i>
                                    </button>
                                    <button class="ref-icon-btn" title="Imprimir etiqueta QR" onclick="imprimirEtiqueta(${item.id})">
                                        <i class="bi bi-qr-code"></i>
                                    </button>
                                    <button class="btn-action" onclick="abrirAjuste(${item.id})">
                                        <i class="bi bi-arrow-left-right"></i> Ajustar
                                    </button>
                                </div>
                            </td>
                        </tr>
                    `;
                }).join('');

                container.append(`
                    <table class="ref-table">
                        <thead>
                            <tr>
                                <th>SKU</th>
                                <th>Descripción</th>
                                <th class="d-none d-md-table-cell">Unidad inventario</th>
                                <th class="d-none d-md-table-cell">Categoría</th>
                                <th>Ubicación</th>
                                <th class="d-none d-md-table-cell text-center">Mín.</th>
                                <th class="d-none d-md-table-cell text-center">Máx.</th>
                                <th class="text-center">Stock</th>
                                <th class="d-none d-md-table-cell">Costo</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>${filas}</tbody>
                    </table>
                `);
            }

            function renderUI() {
                renderTarjetas();
                renderMovimientos();
                calcularEstadisticas();
                renderCentroAlertasRef();
            }

            function renderMovimientos() {
                const container = $('#listaMovimientos');
                container.empty();

                const limite = verTodosMovimientos ? movimientos.length : 5;
                const recientes = movimientos.slice(0, limite);

                $('#btnVerTodos').toggle(movimientos.length > 5);
                $('#btnVerTodos').text(verTodosMovimientos ? 'Ver menos' : 'Ver todos');
                $('#movTitle').text(movimientos.length > 0
                    ? `Movimientos (${movimientos.length})`
                    : 'Últimos Movimientos');

                if (recientes.length === 0) {
                    container.append('<div class="ref-empty">Aún no hay movimientos registrados.</div>');
                    return;
                }

                recientes.forEach(mov => {
                    const tipo = String(mov.tipo || '').toUpperCase();
                    const iconClass = tipo === 'SALIDA' ? 'icon-out' : (tipo === 'ENTRADA' ? 'icon-in' : 'icon-adj');
                    const iconBi = tipo === 'SALIDA' ? 'bi-arrow-down-right' : (tipo === 'ENTRADA' ? 'bi-arrow-up-right' : 'bi-pencil');

                    let textoExtra = mov.usuario || 'Sistema';
                    if (tipo === 'SALIDA' && mov.maquina) {
                        textoExtra += ` • Instalado en: ${mov.maquina}`;
                    }

                    const cuando = fechaRelativa(mov.fecha);
                    const refLinea = [mov.referencia || 'Sin documento', mov.folio || ''].filter(Boolean).join(' • ');

                    const qtyDisplay = mov.cantidad > 0 ? `+${mov.cantidad}` : mov.cantidad;

                    let html = `
                        <div class="ref-history-item">
                            <div class="history-icon ${iconClass}"><i class="bi ${iconBi}"></i></div>
                            <div class="history-details">
                                <p class="history-name">${escapeHtml(mov.desc)}</p>
                                <p class="history-meta" style="color:var(--ref-brand); font-weight:600;">${escapeHtml(textoExtra)}</p>
                                <p class="history-meta">${escapeHtml(refLinea)} • ${cuando}</p>
                            </div>
                            <div class="ref-stock-qty" style="font-size: 1.1rem;">${qtyDisplay}</div>
                        </div>
                    `;
                    container.append(html);
                });
            }

            function toggleTodosMovimientos() {
                verTodosMovimientos = !verTodosMovimientos;
                renderMovimientos();
            }

            function calcularEstadisticas() {
                let total = 0;
                let low = 0;
                let out = 0;
                let valorInventario = 0;

                inventario.forEach(item => {
                    let s = parseInt(item.stock);
                    total += s;
                    valorInventario += (s * parseFloat(item.costo));

                    if (s === 0) out++;
                    else if (s <= item.min) low++;
                });

                $('#statTotal').text(total);
                $('#statLow').text(low);
                $('#statOut').text(out);

                let formatoInv = new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN', maximumFractionDigits: 0 }).format(valorInventario);
                $('#statValue').text(formatoInv);
            }

            function calcularAlertasRef() {
                const res = [];

                inventario.forEach(item => {
                    const stock = Number(item.stock) || 0;
                    const min = Number(item.min) || 0;
                    const max = Number(item.max) || 0;

                    let nivel = '';
                    if (stock === 0) nivel = 'AGOTADO';
                    else if (min > 0 && stock <= min) nivel = 'BAJO';
                    else if (max > 0 && stock > max) nivel = 'SOBRE';

                    if (!nivel) return;

                    const objetivo = max > 0 ? max : Math.max(min * 2, min + 1);
                    let sugerido;
                    let tipoSugerencia;
                    if (nivel === 'SOBRE') {
                        sugerido = stock - max;
                        tipoSugerencia = 'sobrante';
                    } else {
                        sugerido = Math.max(objetivo - stock, 1);
                        tipoSugerencia = 'faltante';
                    }

                    res.push({
                        id: item.id,
                        sku: item.sku,
                        desc: item.desc,
                        loc: item.loc || '',
                        stock: stock,
                        min: min,
                        max: max,
                        objetivo: objetivo,
                        sugerido: sugerido,
                        tipoSugerencia: tipoSugerencia,
                        nivel: nivel
                    });
                });

                const prioridad = { AGOTADO: 0, BAJO: 1, SOBRE: 2 };
                res.sort((a, b) => (prioridad[a.nivel] - prioridad[b.nivel]) || (a.stock - b.stock));
                return res;
            }

            function renderCentroAlertasRef() {
                alertasRefActuales = calcularAlertasRef();

                const agotados = alertasRefActuales.filter(x => x.nivel === 'AGOTADO').length;
                const bajos = alertasRefActuales.filter(x => x.nivel === 'BAJO').length;
                const sobre = alertasRefActuales.filter(x => x.nivel === 'SOBRE').length;
                const total = alertasRefActuales.length;

                $('#refAlertAgotados').text(agotados);
                $('#refAlertBajos').text(bajos);
                $('#refAlertSobre').text(sobre);

                const btn = document.getElementById('refAlertBellButton');
                const count = document.getElementById('refAlertBellCount');
                if (count) count.textContent = String(total);
                if (btn) {
                    btn.classList.toggle('has-pending', total > 0);
                    btn.classList.toggle('is-clear', total === 0);
                    const texto = total > 0
                        ? `${total} pendiente(s): ${agotados} agotadas, ${bajos} bajo mínimo, ${sobre} sobre máximo.`
                        : 'Sin pendientes de stock';
                    btn.title = texto;
                    btn.setAttribute('aria-label', texto);
                }

                let rows = '';
                alertasRefActuales.forEach(a => {
                    const clase = a.nivel === 'AGOTADO' ? 'agotado' : (a.nivel === 'BAJO' ? 'bajo' : 'sobre');
                    const etiqueta = a.nivel === 'AGOTADO' ? 'Agotado' : (a.nivel === 'BAJO' ? 'Bajo mínimo' : 'Sobre máximo');

                    rows += `<tr>
                        <td><span class="ref-alert-level ${clase}">${etiqueta}</span></td>
                        <td><strong style="color: var(--ref-brand);">${escapeHtml(a.sku)}</strong><br><small>${escapeHtml(a.desc)}</small></td>
                        <td>${escapeHtml(a.loc || 'Sin ubicación')}</td>
                        <td style="text-align:center;" class="fw-bold">${a.stock}</td>
                        <td style="text-align:center;">${a.min}</td>
                        <td style="text-align:center;">${a.max > 0 ? a.max : '—'}</td>
                        <td style="text-align:center;"><strong>${a.sugerido}</strong><br><small style="color: var(--ref-text-muted);">${a.tipoSugerencia}</small></td>
                        <td style="text-align:center;">
                            <button type="button" class="ref-icon-btn" title="Ajustar stock" onclick="ajustarDesdeAlertaRef(${a.id})">
                                <i class="bi bi-arrow-left-right"></i>
                            </button>
                        </td>
                    </tr>`;
                });

                $('#tbodyAlertasRef').html(rows || '<tr><td colspan="8" style="text-align:center; padding: 24px; color: var(--ref-success); font-weight:700;"><i class="bi bi-check-circle-fill me-1"></i>Sin pendientes de stock.</td></tr>');
            }

            function abrirAlertasRef() {
                renderCentroAlertasRef();
                abrirModal('modalAlertasRef');
            }

            function ajustarDesdeAlertaRef(id) {
                cerrarModal('modalAlertasRef');
                setTimeout(() => abrirAjuste(id), 250);
            }

            function verBajoStockDesdeAlertas() {
                cerrarModal('modalAlertasRef');
                filtroActual = 'Bajo Stock';
                renderTabs();
                renderTarjetas();
                setTimeout(() => {
                    document.getElementById('gridRefacciones')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }, 200);
            }

            function prepararNuevaRefaccion() {
                $('#editId').val('');
                $('#refModalTitulo').text('Nueva Refacción');
                $('#btnGuardarRef').text('Guardar');
                $('#newSku, #newDesc').val('');
                $('#newStock, #newCost').val('0');
                $('#newMin').val('1');
                $('#newMax').val('0');
                renderSelectsCatalogos();
            }

            function abrirEditar(id) {
                const item = inventario.find(x => x.id === id);
                if (!item) return;

                renderSelectsCatalogos();

                $('#editId').val(item.id);
                $('#refModalTitulo').text('Editar Refacción');
                $('#btnGuardarRef').text('Actualizar');
                $('#newSku').val(item.sku);
                $('#newDesc').val(item.desc);
                $('#newCat').val(item.cat);
                $('#newLoc').val(item.loc);
                $('#newMin').val(item.min);
                $('#newMax').val(item.max);
                $('#newStock').val(item.stock);
                $('#newCost').val(item.costo);

                abrirModal('modalNuevaRefaccion');
            }

            async function guardarNuevaRefaccion() {
                const editId = parseInt($('#editId').val());
                const esEdicion = !isNaN(editId) && editId > 0;

                const datos = {
                    id: esEdicion ? editId : 0,
                    sku: ($('#newSku').val() || '').trim(),
                    desc: ($('#newDesc').val() || '').trim(),
                    cat: $('#newCat').val(),
                    loc: $('#newLoc').val(),
                    stock: parseInt($('#newStock').val()) || 0,
                    min: parseInt($('#newMin').val()) || 0,
                    max: parseInt($('#newMax').val()) || 0,
                    costo: parseFloat($('#newCost').val()) || 0
                };

                if (!datos.desc) {
                    alert("La descripción es obligatoria.");
                    return;
                }

                if (!datos.sku) {
                    alert("El Código/SKU es obligatorio.");
                    return;
                }

                if (!datos.cat) {
                    alert("Selecciona una categoría (revisa el catálogo).");
                    return;
                }

                const res = await postJson(URL_GUARDAR_REF, datos);
                if (!res || !res.ok) {
                    alert((res && res.mensaje) || 'No se pudo guardar la refacción.');
                    return;
                }

                cerrarModal('modalNuevaRefaccion');
                await cargarDatos();
            }

            function abrirAjuste(id) {
                const item = inventario.find(x => x.id === id);
                if (!item) return;

                renderSelectsCatalogos();

                $('#adjId').val(item.id);
                $('#adjName').text(item.desc);
                $('#adjStock').text(item.stock);
                $('#adjQty').val('');
                $('#adjRef, #adjComment').val('');

                $('#adjType').val('salida').trigger('change');
                $('#adjMachine').val('');
                actualizarValidacionCantidad();

                abrirModal('modalAjuste');
            }

            async function guardarAjuste() {
                const id = parseInt($('#adjId').val());
                const tipo = String($('#adjType').val() || '').toUpperCase();
                const valor = parseInt($('#adjQty').val());
                const maquina = ($('#adjMachine').val() || '').trim();

                if (isNaN(valor) || valor === 0) {
                    alert("Ingresa una cantidad válida.");
                    return;
                }

                if (tipo !== 'AJUSTE' && valor < 0) {
                    alert("La cantidad debe ser positiva en entradas y salidas.");
                    return;
                }

                if (tipo === 'SALIDA' && !maquina) {
                    alert("Debes seleccionar la máquina o equipo de destino para la salida.");
                    return;
                }

                const datos = {
                    id: id,
                    tipo: tipo,
                    cantidad: valor,
                    referencia: ($('#adjRef').val() || '').trim(),
                    maquina: tipo === 'SALIDA' ? maquina : null,
                    comentario: ($('#adjComment').val() || '').trim()
                };

                const res = await postJson(URL_MOVIMIENTO, datos);
                if (!res || !res.ok) {
                    alert((res && res.mensaje) || 'No se pudo registrar el movimiento.');
                    return;
                }

                cerrarModal('modalAjuste');
                await cargarDatos();
            }

