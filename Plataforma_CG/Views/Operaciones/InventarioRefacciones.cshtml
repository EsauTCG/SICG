      background: var(--ref-bg) !important;
      color: var(--ref-text);
    }

    body[data-theme="dark"] .ref-tab {
      color: var(--ref-text-muted);
    }

      body[data-theme="dark"] .ref-tab.active {
        color: #fff;
      }

    body[data-theme="dark"] .ref-card-item, body[data-theme="dark"] .ref-search-wrapper, body[data-theme="dark"] .ref-history-item, body[data-theme="dark"] .ref-status-bar, body[data-theme="dark"] .ref-userbar, body[data-theme="dark"] .ref-pos-scan, body[data-theme="dark"] .ref-pos-campos {
      background: var(--ref-card);
