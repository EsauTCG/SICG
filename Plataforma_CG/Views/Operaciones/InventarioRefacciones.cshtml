    body[data-theme="dark"] .ref-card-top, body[data-theme="dark"] .ref-card-bottom, body[data-theme="dark"] .history-details, body[data-theme="dark"] .ref-more-btn, body[data-theme="dark"] .ref-more-btn:hover {
      color: var(--ref-text);
    }

    body[data-theme="dark"] .ref-name, body[data-theme="dark"] .ref-desc, body[data-theme="dark"] .history-name, body[data-theme="dark"] .ref-userbar, body[data-theme="dark"] .ref-user-name {
