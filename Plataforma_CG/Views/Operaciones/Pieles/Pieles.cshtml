            async function cargarPielesLote(loteId) {

        loteId = Number(loteId);

        const contenedor =
            document.getElementById(`pieles-${loteId}`);

        if (!contenedor) {
            console.error(
                `No existe el contenedor pieles-${loteId}`
            );
            return;
        }

        try {

            const response = await fetch(
                `${URL_PIELES}?loteId=${encodeURIComponent(loteId)}`
            );

            if (!response.ok) {
                throw new Error(
                    `HTTP ${response.status}`
                );
            }

            const pieles = await response.json();

            console.log(
                `Lote ${loteId}:`,
                pieles
            );

            // ==========================================
            // GUARDAR EN EL LOTE
            // ==========================================

            const lote =
                lotes.find(
                    x => Number(x.loteId) === loteId
                );

            if (lote) {
                lote.pieles = pieles || [];
            }

            // ==========================================
            // GUARDAR EN COLECCIÓN GLOBAL
            // ==========================================

            // Primero eliminamos las que pudiera haber
            // previamente de este lote
            todasLasPieles =
                todasLasPieles.filter(
                    x => Number(x.loteId) !== loteId
                );

            (pieles || []).forEach(function (piel) {

                todasLasPieles.push({
                    loteId: loteId,
                    piel: piel
                });

            });

            console.log(
                `Total de pieles cargadas: ${todasLasPieles.length}`
            );

            // ==========================================
            // CONSTRUIR TABLA
            // ==========================================

            if (!pieles || pieles.length === 0) {

                contenedor.innerHTML =
                    '<div class="sin-pieles">No hay pieles para este lote.</div>';

                actualizarContador(loteId, 0);

                return;
            }

            construirTablaPieles(
                loteId,
                pieles
            );
            actualizarResumenLote(loteId);
        }
        catch (error) {

            console.error(
                `Error cargando pieles del lote ${loteId}:`,
                error
            );

            contenedor.innerHTML =
                '<div class="sin-pieles">Error al cargar las pieles.</div>';
        }
    }

        function actualizarResumenLote(loteId) {

        const lote =
            lotes.find(
                x => Number(x.loteId) === Number(loteId)
            );

        if (!lote) {
            return;
        }

        const pieles =
            lote.pieles || [];

        // ==========================================
        // TOTAL DEL LOTE
        // ==========================================

        const totalPieles =
            pieles.length;

        const totalKg =
            pieles.reduce(function (total, piel) {

                return total +
                    (Number(piel.pesoNeto) || 0);

            }, 0);

        // ==========================================
        // SELECCIONADAS
        // ==========================================

        const seleccionadas =
            pieles.filter(
                piel => piel.seleccionada === true
            );

        const cantidadSeleccionadas =
            seleccionadas.length;

        const kgSeleccionados =
            seleccionadas.reduce(
                function (total, piel) {

                    return total +
                        (Number(piel.pesoNeto) || 0);

                },
                0
            );

        // ==========================================
        // ACTUALIZAR HTML
        // ==========================================

        const totalPielesElement =
            document.getElementById(
                `total-pieles-${loteId}`
            );

        const totalKgElement =
            document.getElementById(
                `total-kg-${loteId}`
            );

        const seleccionadasPielesElement =
            document.getElementById(
                `seleccionadas-pieles-${loteId}`
            );

        const seleccionadasKgElement =
            document.getElementById(
                `seleccionadas-kg-${loteId}`
            );

        if (totalPielesElement) {

            totalPielesElement.textContent =
                `${totalPieles} pieles`;

        }

        if (totalKgElement) {

            totalKgElement.textContent =
                `${formatearPeso(totalKg)} kg`;

        }

        if (seleccionadasPielesElement) {

            seleccionadasPielesElement.textContent =
                `${cantidadSeleccionadas} seleccionadas`;

        }

        if (seleccionadasKgElement) {

            seleccionadasKgElement.textContent =
                `${formatearPeso(kgSeleccionados)} kg`;

        }
    }
