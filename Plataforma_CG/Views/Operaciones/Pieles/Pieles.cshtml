@model IEnumerable<dynamic>
@using System.Globalization
@using System.Text.Json

@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
}

<style>
    :root {
        --pieles-rojo: #b42318;
        --pieles-rojo-oscuro: #8f1d14;
        --pieles-rojo-claro: #fef3f2;
        --pieles-rojo-medio: #fecdca;
        --pieles-gris-900: #292524;
        --pieles-gris-700: #57534e;
        --pieles-gris-500: #78716c;
        --pieles-gris-300: #d6d3d1;
        --pieles-gris-200: #e7e5e4;
        --pieles-gris-100: #f5f5f4;
        --pieles-blanco: #ffffff;
        --pieles-radio: 10px;
        --pieles-sombra: 0 2px 8px rgba(0, 0, 0, .08);
    }


    /* =========================================================
           PANEL PRINCIPAL
           ========================================================= */

    .panel-pieles {
        width: 100%;
        max-width: 1600px;
        margin: 0 auto;
    }


    /* =========================================================
           PANEL DE CONTROL / ORDEN
           ========================================================= */

    .panel-control-pieles {
        background: var(--pieles-blanco);
        border: 1px solid var(--pieles-gris-200);
        border-radius: var(--pieles-radio);
        box-shadow: var(--pieles-sombra);
        margin-bottom: 18px;
        overflow: hidden;
    }

    .panel-control-header {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 13px 18px;
        background: var(--pieles-rojo);
        color: white;
    }

    .panel-control-header-titulo {
        font-size: 16px;
        font-weight: 700;
        margin: 0;
    }

    .panel-control-header-subtitulo {
        font-size: 13px;
        opacity: .85;
    }

    .panel-control-body {
        padding: 18px;
    }


    /* =========================================================
           DATOS DE LA ORDEN
           ========================================================= */

    .datos-orden-pieles {
        display: grid;
        grid-template-columns: minmax(140px, 180px) minmax(220px, 1fr) minmax(160px, 220px);
        gap: 14px;
        align-items: end;
    }

    .campo-pieles {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

        .campo-pieles label {
            font-size: 12px;
            font-weight: 700;
            color: var(--pieles-gris-700);
            margin: 0;
        }

        .campo-pieles input {
            width: 100%;
            min-height: 40px;
            border: 1px solid var(--pieles-gris-300);
            border-radius: 7px;
            padding: 8px 11px;
            background: white;
            color: var(--pieles-gris-900);
            transition: border-color .15s, box-shadow .15s;
        }

            .campo-pieles input:focus {
                outline: none;
                border-color: var(--pieles-rojo);
                box-shadow: 0 0 0 3px rgba(180, 35, 24, .12);
            }

            .campo-pieles input[readonly] {
                background: var(--pieles-gris-100);
                color: var(--pieles-gris-700);
                cursor: default;
            }

    .cantidad-pieles {
        font-weight: 700;
        text-align: center;
    }


    /* =========================================================
           BOTONES
           ========================================================= */

    .acciones-pieles {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
        align-items: center;
        margin-top: 16px;
        padding-top: 16px;
        border-top: 1px solid var(--pieles-gris-200);
    }

    .btn-pieles {
        min-height: 40px;
        border: none;
        border-radius: 7px;
        padding: 8px 16px;
        font-weight: 600;
        cursor: pointer;
        transition: background-color .15s, transform .1s, box-shadow .15s;
    }

        .btn-pieles:hover {
            transform: translateY(-1px);
        }

        .btn-pieles:active {
            transform: translateY(0);
        }

    .btn-consultar-ordenes {
        background: white;
        color: var(--pieles-rojo);
        border: 1px solid var(--pieles-rojo);
    }

        .btn-consultar-ordenes:hover {
            background: var(--pieles-rojo-claro);
        }

    .btn-seleccionar-pieles {
        background: var(--pieles-rojo);
        color: white;
    }

        .btn-seleccionar-pieles:hover {
            background: var(--pieles-rojo-oscuro);
        }

    .btn-guardar-pieles {
        background: #991b1b;
        color: white;
    }

        .btn-guardar-pieles:hover {
            background: #7f1d1d;
        }

    .btn-cerrar-modal {
        background: var(--pieles-gris-100);
        color: var(--pieles-gris-700);
        border: 1px solid var(--pieles-gris-300);
    }

    .mensaje-cantidad,
    .mensaje-guardar {
        font-size: 13px;
        min-height: 20px;
    }

    .mensaje-cantidad {
        color: var(--pieles-gris-700);
    }


    /* =========================================================
           RESUMEN DE SELECCIÓN
           ========================================================= */

    .resumen-seleccion-pieles {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 14px;
        padding: 10px 12px;
        border-radius: 7px;
        background: var(--pieles-rojo-claro);
        border: 1px solid var(--pieles-rojo-medio);
        color: var(--pieles-rojo-oscuro);
        font-size: 13px;
    }


    /* =========================================================
           LOTES
           ========================================================= */

    .contenedor-lotes {
        width: 100%;
    }

    .lote-item {
        border: 1px solid var(--pieles-gris-200);
        border-radius: var(--pieles-radio);
        margin-bottom: 10px;
        overflow: hidden;
        background: white;
        box-shadow: 0 1px 4px rgba(0, 0, 0, .05);
    }

    .lote-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        min-height: 68px;
        padding: 11px 15px;
        background: var(--pieles-gris-100);
        border-left: 4px solid transparent;
        cursor: pointer;
        user-select: none;
        transition: background-color .15s, border-color .15s;
    }

        .lote-header:hover {
            background: var(--pieles-rojo-claro);
            border-left-color: var(--pieles-rojo);
        }

    .lote-header-izquierda {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .lote-datos {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
    }

    .lote-nombre {
        font-weight: 700;
        font-size: 15px;
        color: var(--pieles-gris-900);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .lote-fecha {
        font-size: 12px;
        color: var(--pieles-gris-500);
    }

    .lote-header-derecha {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-left: auto;
        flex-shrink: 0;
    }

    .lote-checkbox {
        width: 19px;
        height: 19px;
        cursor: pointer;
        accent-color: var(--pieles-rojo);
        margin: 0;
        flex-shrink: 0;
    }

    .lote-flecha {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 26px;
        height: 26px;
        border-radius: 50%;
        color: var(--pieles-rojo);
        font-size: 15px;
        transition: transform .2s, background-color .15s;
    }

        .lote-flecha:hover {
            background: var(--pieles-rojo-medio);
        }

    .lote-item.abierto .lote-flecha {
        transform: rotate(180deg);
    }


    /* =========================================================
           RESUMEN DEL LOTE
           ========================================================= */

    .resumen-lote {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 5px;
        font-size: 12px;
        color: var(--pieles-gris-700);
        white-space: nowrap;
    }

    .dato-lote {
        font-weight: 500;
    }

        .dato-lote.seleccionadas {
            color: var(--pieles-rojo);
            font-weight: 700;
        }

    .separador-lote {
        opacity: .45;
    }

    .contador-pieles {
        font-size: 12px;
        color: var(--pieles-gris-500);
    }


    /* =========================================================
           CONTENIDO DEL LOTE
           ========================================================= */

    .lote-contenido {
        display: none;
        padding: 0;
        background: white;
        border-top: 1px solid var(--pieles-gris-200);
    }

    .lote-item.abierto .lote-contenido {
        display: block;
    }


    /* =========================================================
           TABLA DE PIELES
           ========================================================= */

    .tabla-pieles {
        width: 100%;
        border-collapse: collapse;
        min-width: 650px;
    }

        .tabla-pieles th {
            background: #fff5f5;
            color: var(--pieles-gris-700);
            border-bottom: 1px solid var(--pieles-rojo-medio);
            padding: 10px;
            text-align: left;
            font-size: 12px;
            font-weight: 700;
        }

        .tabla-pieles td {
            padding: 9px 10px;
            border-bottom: 1px solid var(--pieles-gris-200);
            font-size: 13px;
            color: var(--pieles-gris-900);
        }

        .tabla-pieles tbody tr {
            transition: background-color .12s;
        }

            .tabla-pieles tbody tr:hover {
                background: var(--pieles-rojo-claro);
            }

    .piel-checkbox {
        width: 17px;
        height: 17px;
        cursor: pointer;
        accent-color: var(--pieles-rojo);
    }

    .centrado {
        text-align: center !important;
    }

    .peso {
        text-align: right !important;
        white-space: nowrap;
    }


    /* =========================================================
           ESTADOS
           ========================================================= */

    .sin-pieles,
    .cargando,
    .sin-lotes {
        padding: 30px 20px;
        text-align: center;
        color: var(--pieles-gris-500);
    }

    .sin-pieles {
        font-style: italic;
    }

    .sin-lotes {
        border: 1px dashed var(--pieles-gris-300);
        border-radius: 8px;
        background: var(--pieles-gris-100);
    }


    /* =========================================================
           MODAL DE ÓRDENES
           ========================================================= */

    #modalOrdenesPieles .modal-content {
        border: none;
        border-radius: 11px;
        overflow: hidden;
        box-shadow: 0 12px 35px rgba(0, 0, 0, .18);
    }

    #modalOrdenesPieles .modal-header {
        background: var(--pieles-rojo);
        color: white;
        border-bottom: none;
        padding: 15px 18px;
    }

    #modalOrdenesPieles .modal-title {
        font-weight: 700;
        font-size: 17px;
    }

    #modalOrdenesPieles .btn-close {
        filter: brightness(0) invert(1);
        opacity: .9;
    }

    #modalOrdenesPieles .modal-body {
        padding: 18px;
    }

    #contenedorOrdenesPieles {
        width: 100%;
        overflow-x: auto;
    }

    #tablaOrdenesPieles {
        margin: 0;
        min-width: 700px;
    }

        #tablaOrdenesPieles thead th {
            background: #fff5f5;
            color: var(--pieles-gris-700);
            border-color: var(--pieles-rojo-medio);
            font-size: 12px;
            white-space: nowrap;
        }

        #tablaOrdenesPieles tbody tr {
            cursor: pointer;
            transition: background-color .12s;
        }

            #tablaOrdenesPieles tbody tr:hover {
                background: var(--pieles-rojo-claro);
            }

        #tablaOrdenesPieles tbody td {
            vertical-align: middle;
            font-size: 13px;
        }

        #tablaOrdenesPieles tbody tr:active {
            background: var(--pieles-rojo-medio);
        }

    #modalOrdenesPieles .modal-footer {
        border-top: 1px solid var(--pieles-gris-200);
        padding: 12px 18px;
    }


    /* =========================================================
           RESPONSIVE - TABLET
           ========================================================= */

    @@media (max-width: 992px) {
        .datos-orden-pieles

    {
        grid-template-columns: minmax(130px, 180px) minmax(180px, 1fr);
    }

    .campo-solicitud {
        grid-column: 1 / -1;
    }

    .lote-header {
        align-items: flex-start;
    }

    .lote-header-derecha {
        flex-direction: column;
        align-items: flex-end;
        gap: 5px;
    }

    .resumen-lote {
        justify-content: flex-end;
    }

    }


    /* =========================================================
           RESPONSIVE - CELULAR
           ========================================================= */

    @@media (max-width: 576px) {
        .panel-control-body

    {
        padding: 14px;
    }

    .datos-orden-pieles {
        grid-template-columns: 1fr;
        gap: 11px;
    }

    .campo-solicitud {
        grid-column: auto;
    }

    .acciones-pieles {
        flex-direction: column;
        align-items: stretch;
    }

    .btn-pieles {
        width: 100%;
    }

    .mensaje-cantidad,
    .mensaje-guardar {
        width: 100%;
    }

    .lote-header {
        padding: 11px;
        gap: 8px;
    }

    .lote-header-izquierda {
        gap: 8px;
    }

    .lote-header-derecha {
        gap: 3px;
    }

    .resumen-lote {
        display: none;
    }

    .lote-flecha {
        width: 23px;
        height: 23px;
    }

    .tabla-pieles {
        min-width: 600px;
    }

    .lote-contenido {
        overflow-x: auto;
    }

    #modalOrdenesPieles .modal-body {
        padding: 10px;
    }

    }
</style>
<div class="container-fluid">

    <div class="panel-pieles">

        <!-- =====================================================
             PANEL DE CONTROL
             ===================================================== -->

        <div class="panel-control-pieles">

            <div class="panel-control-header">

                <div>
                    <div class="panel-control-header-titulo">
                        Surtido de pieles
                    </div>

                    <div class="panel-control-header-subtitulo">
                        Selecciona una orden y posteriormente las pieles
                    </div>
                </div>

            </div>


            <div class="panel-control-body">

                <!-- =================================================
                     DATOS DE LA ORDEN
                     ================================================= -->

                <div class="datos-orden-pieles">

                    <!-- CANTIDAD -->

                    <div class="campo-pieles">

                        <label for="cantidadPielesGlobal">
                            Cantidad de pieles
                        </label>

                        <input type="number"
                               id="cantidadPielesGlobal"
                               class="cantidad-pieles"
                               min="1"
                               step="1"
                               placeholder="Cantidad" />

                    </div>


                    <!-- CLIENTE -->

                    <div class="campo-pieles">

                        <label for="txtClienteOrden">
                            Cliente
                        </label>

                        <input type="text"
                               id="txtClienteOrden"
                               readonly
                               placeholder="Sin orden seleccionada" />

                    </div>


                    <!-- SOLICITUD -->

                    <div class="campo-pieles campo-solicitud">

                        <label for="txtSolicitudSurtidoId">
                            Solicitud
                        </label>

                        <input type="text"
                               id="txtSolicitudSurtidoId"
                               readonly
                               placeholder="Sin orden seleccionada" />

                    </div>

                </div>


                <!-- =================================================
                     ACCIONES
                     ================================================= -->

                <div class="acciones-pieles">

                    <!-- CONSULTAR ÓRDENES -->

                    <button type="button"
                            class="btn-pieles btn-consultar-ordenes"
                            onclick="abrirModalOrdenesPieles()">

                        Consultar órdenes

                    </button>


                    <!-- SELECCIONAR PIELES -->

                    <button type="button"
                            class="btn-pieles btn-seleccionar-pieles"
                            onclick="seleccionarPielesAntiguasGlobal()">

                        Seleccionar pieles

                    </button>


                    <!-- GUARDAR -->

                    <button type="button"
                            class="btn-pieles btn-guardar-pieles"
                            onclick="guardarPielesSeleccionadas()">

                        Guardar

                    </button>


                    <!-- MENSAJE SELECCIÓN -->

                    <span id="mensajeCantidadGlobal"
                          class="mensaje-cantidad">
                    </span>


                    <!-- MENSAJE GUARDADO -->

                    <span id="mensajeGuardarPieles"
                          class="mensaje-guardar">
                    </span>

                </div>

            </div>

        </div>


        <!-- =====================================================
             CONTENEDOR DE LOTES
             ===================================================== -->

        <div id="contenedorLotes"
             class="contenedor-lotes">

            <div class="cargando">
                Cargando lotes...
            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     MODAL DE ÓRDENES DE SURTIDO
     ========================================================= -->

<div class="modal fade"
     id="modalOrdenesPieles"
     tabindex="-1"
     aria-labelledby="modalOrdenesPielesLabel"
     aria-hidden="true">

    <div class="modal-dialog modal-xl modal-dialog-scrollable">

        <div class="modal-content">


            <!-- =================================================
                 HEADER
                 ================================================= -->

            <div class="modal-header">

                <div>

                    <h5 class="modal-title"
                        id="modalOrdenesPielesLabel">

                        Órdenes de surtido

                    </h5>

                </div>


                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar">
                </button>

            </div>


            <!-- =================================================
                 BODY
                 ================================================= -->

            <div class="modal-body">


                <!-- CARGANDO -->

                <div id="cargandoOrdenesPieles"
                     class="text-center"
                     style="display:none; padding:30px;">

                    <div class="spinner-border"
                         style="color:#b42318;"
                         role="status">

                        <span class="visually-hidden">
                            Cargando...
                        </span>

                    </div>

                    <div style="margin-top:10px;">
                        Cargando órdenes...
                    </div>

                </div>


                <!-- MENSAJE -->

                <div id="mensajeOrdenesPieles"
                     class="alert alert-info"
                     style="display:none;">
                </div>


                <!-- =================================================
                     TABLA DE ÓRDENES
                     ================================================= -->

                <div id="contenedorOrdenesPieles"
                     class="table-responsive">

                    <table class="table table-bordered table-hover"
                           id="tablaOrdenesPieles">

                        <thead>

                            <tr>

                                <th>
                                    Fecha surtido
                                </th>

                                <th>
                                    Folio
                                </th>

                                <th>
                                    Cliente
                                </th>

                                <th class="text-center">
                                    Unidades
                                </th>

                                <th class="text-center">
                                    Capturadas
                                </th>

                                <th class="text-center">
                                    Pendientes
                                </th>

                            </tr>

                        </thead>


                        <tbody id="tbodyOrdenesPieles">
                        </tbody>

                    </table>

                </div>

            </div>


            <!-- =================================================
                 FOOTER
                 ================================================= -->

            <div class="modal-footer">

                <button type="button"
                        class="btn-pieles btn-cerrar-modal"
                        data-bs-dismiss="modal">

                    Cerrar

                </button>

            </div>

        </div>

    </div>

</div>
<script>
    const URL_ORDENES_PIELES =
    '/Operaciones/ConsultarOrdenesPieles';
    /*
     * ============================================================
     * CONFIGURACIÓN DE ENDPOINTS
     * ============================================================
     *
     * Cambia únicamente estas dos URLs por tus controladores.
     */

    const URL_LOTES = '/Operaciones/ConsultarLotesPieles';

    const URL_PIELES = '/Operaciones/ConsultarPielesLote';


    /*
     * ============================================================
     * VARIABLES
     * ============================================================
     */

    let lotes = [];
    let todasLasPieles = [];

    /*
     * ============================================================
     * CARGA INICIAL
     * ============================================================
     */

    document.addEventListener('DOMContentLoaded', function () {

        cargarLotes();

    });


    /*
     * ============================================================
     * 1. CONSULTAR LOTES
     * ============================================================
     */

        async function cargarLotes() {

        const contenedor = document.getElementById('contenedorLotes');

        try {

            contenedor.innerHTML = `
                <div class="cargando">
                    Cargando lotes...
                </div>
            `;

            const response = await fetch(URL_LOTES, {
                method: 'GET'
            });

            if (!response.ok) {
                throw new Error('Error al consultar los lotes.');
            }

            const resultado = await response.json();

            console.log('RESPUESTA ORIGINAL LOTES:', resultado);
            console.log('PRIMER LOTE:', resultado?.[0]);

            if (!resultado || resultado.length === 0) {

                contenedor.innerHTML = `
                    <div class="sin-lotes">
                        No existen lotes para mostrar.
                    </div>
                `;

                return;
            }

            /*
             * Guardamos exactamente lo que devuelve el endpoint.
             */
            lotes = resultado;

            contenedor.innerHTML = '';

            /*
             * Crear cada lote.
             */
            lotes.forEach(function (lote, index) {

                console.log(`Lote ${index}:`, lote);

                crearLote(lote);

            });

            /*
             * Consultar las pieles de cada lote.
             */
    for (const lote of lotes) {

        await cargarPielesLote(lote.loteId);

    }

        }
        catch (error) {

            console.error('Error cargando lotes:', error);

            contenedor.innerHTML = `
                <div class="sin-lotes">
                    Ocurrió un error al cargar los lotes.
                </div>
            `;

        }

    }


    /*
     * ============================================================
     * CREAR BARRA DEL LOTE
     * ============================================================
     */

                function crearLote(lote) {

        const contenedor =
            document.getElementById('contenedorLotes');

        const loteId =
            Number(lote.loteId);

        const nombreLote =
            lote.lote;

        const fechaProduccion =
            lote.fechaProduccion;

        const divLote =
            document.createElement('div');

        divLote.className =
            'lote-item';

        divLote.id =
            `lote-${loteId}`;

        divLote.innerHTML = `

            <div
                class="lote-header"
                onclick="toggleLote(${loteId}, event)"
            >

                <div class="lote-header-izquierda">

                    <input
                        type="checkbox"
                        class="lote-checkbox"
                        id="check-lote-${loteId}"
                        data-lote-id="${loteId}"
                        onclick="seleccionarLote(${loteId}, event)"
                    />

                    <div class="lote-datos">

                        <div class="lote-nombre">
                            ${escapeHtml(nombreLote ?? '')}
                        </div>

                        <div class="lote-fecha">
                            ${escapeHtml(fechaProduccion ?? '')}
                        </div>

                    </div>

                </div>

                <div class="lote-header-derecha">

                    <div
                        id="resumen-lote-${loteId}"
                        class="resumen-lote"
                    >

                        <span
                            id="total-pieles-${loteId}"
