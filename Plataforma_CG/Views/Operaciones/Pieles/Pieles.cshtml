        function actualizarCheckboxLote(loteId) {

        const lote =
            lotes.find(
                x => Number(x.loteId) === Number(loteId)
            );

        if (!lote) {
            return;
        }

        const pieles =
            lote.pieles || [];

        const checkbox =
            document.getElementById(
                `check-lote-${loteId}`
            );

        if (!checkbox) {
            return;
        }

        const seleccionadas =
            pieles.filter(
                x => x.seleccionada === true
            ).length;

        if (pieles.length === 0) {

            checkbox.checked = false;
            checkbox.indeterminate = false;

            return;
        }

        if (seleccionadas === 0) {

            checkbox.checked = false;
            checkbox.indeterminate = false;

        }
        else if (seleccionadas === pieles.length) {

            checkbox.checked = true;
            checkbox.indeterminate = false;

        }
        else {

            checkbox.checked = false;
            checkbox.indeterminate = true;

        }
    }
        function convertirFechaProduccion(fecha) {

        if (!fecha) {
            return Number.MAX_SAFE_INTEGER;
        }


        /*
         * Formato esperado:
         *
         * 18/09/2026 12:27:02 p. m.
         *
         * o
         *
         * 18/09/2026 12:27:02 a. m.
         */

        const regex =
            /^(\d{2})\/(\d{2})\/(\d{4})\s+(\d{1,2}):(\d{2}):(\d{2})\s+(a\.\s*m\.|p\.\s*m\.)$/i;


        const match =
            String(fecha).match(regex);


        if (!match) {

            console.warn(
                'Formato de fecha no reconocido:',
                fecha
            );

            return Number.MAX_SAFE_INTEGER;

        }


        const dia =
            parseInt(match[1], 10);

        const mes =
            parseInt(match[2], 10) - 1;

        const anio =
            parseInt(match[3], 10);

        let hora =
            parseInt(match[4], 10);

        const minuto =
            parseInt(match[5], 10);

        const segundo =
            parseInt(match[6], 10);

        const periodo =
            match[7].toLowerCase();


        /*
         * Convertir 12 a.m. / 12 p.m.
         */
        if (periodo.includes('p') && hora !== 12) {
            hora += 12;
        }

        if (periodo.includes('a') && hora === 12) {
            hora = 0;
        }


        return new Date(
            anio,
            mes,
            dia,
            hora,
            minuto,
            segundo
        ).getTime();

    }
