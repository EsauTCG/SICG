        function cambioSeleccionPiel(loteId) {

        const lote =
            lotes.find(
                x => Number(x.loteId) === Number(loteId)
            );

        if (!lote) {
            return;
        }

        const pieles =
            lote.pieles || [];

        const checkboxes =
            document.querySelectorAll(
                `.piel-checkbox[data-lote-id="${loteId}"]`
            );

