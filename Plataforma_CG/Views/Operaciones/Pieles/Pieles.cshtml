    function obtenerPielesSeleccionadas() {

        const checkboxes =
            document.querySelectorAll(
                '.piel-checkbox:checked'
            );


        const seleccionadas = [];


        checkboxes.forEach(function (checkbox) {

            const loteId =
                parseInt(
                    checkbox.dataset.loteId
                );


            const produccionId =
                parseInt(
                    checkbox.dataset.produccionId
                );


            const codigo =
                checkbox.dataset.codigo;


            const lote =
                lotes.find(
                    x => x.LoteId == loteId
                );


            const pieles =
                lote?.Pieles || [];


            const piel =
                pieles.find(
                    x =>
                        x.ProduccionId == produccionId &&
                        x.CodigoEtiqueta == codigo
                );


            if (piel) {

                seleccionadas.push(piel);

            }

        });


        return seleccionadas;

    }


