        checkboxes.forEach(function (checkbox) {

            const produccionId =
                String(checkbox.dataset.produccionId);

            const codigo =
                String(checkbox.dataset.codigo);

            const piel =
                pieles.find(function (p) {

                    return (
                        String(p.produccionId) === produccionId &&
                        String(p.codigoEtiqueta) === codigo
                    );

                });

            if (piel) {

                piel.seleccionada =
                    checkbox.checked;

            }

        });

        actualizarCheckboxLote(loteId);
        actualizarResumenLote(loteId);
