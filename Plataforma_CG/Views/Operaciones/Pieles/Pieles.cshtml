        function formatearPeso(peso) {

        if (peso === null || peso === undefined || peso === '') {
            return '0.00';
        }

        const valor = Number(peso);

        if (isNaN(valor)) {
            return '0.00';
        }

        return valor.toFixed(2);
    }


    function escapeHtml(texto) {

        if (texto === null || texto === undefined) {
            return '';
        }

        return String(texto)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');

    }
        async function abrirModalOrdenesPieles() {

        const modalElement =
            document.getElementById('modalOrdenesPieles');

        if (!modalElement) {
            console.error(
                'No existe el modal modalOrdenesPieles'
            );
            return;
        }

        const modal =
            bootstrap.Modal.getOrCreateInstance(
                modalElement
            );

        // Mostrar modal inmediatamente
        modal.show();

        // Cargar información
        await cargarOrdenesPieles();
    }
        async function cargarOrdenesPieles() {

        const loading =
            document.getElementById(
                'cargandoOrdenesPieles'
            );

        const mensaje =
            document.getElementById(
                'mensajeOrdenesPieles'
            );

        const tbody =
            document.getElementById(
                'tbodyOrdenesPieles'
            );

        if (!tbody) {
            return;
        }

        // Limpiar contenido anterior
        tbody.innerHTML = '';

        mensaje.style.display = 'none';

        loading.style.display = 'block';

        try {

            const response =
                await fetch(
                    URL_ORDENES_PIELES,
                    {
                        method: 'GET',
                        headers: {
                            'Content-Type':
                                'application/json'
                        }
                    }
                );

            if (!response.ok) {

                throw new Error(
                    `HTTP ${response.status}`
                );

            }

            const resultado =
                await response.json();

            console.log(
                'Órdenes de pieles:',
                resultado
            );

            const ordenes =
                resultado || [];

            if (ordenes.length === 0) {

                mensaje.textContent =
                    'No existen órdenes de surtido.';

                mensaje.className =
                    'alert alert-info';

                mensaje.style.display =
                    'block';

                return;
            }

            construirTablaOrdenesPieles(
                ordenes
            );

        }
        catch (error) {

            console.error(
                'Error al consultar órdenes de pieles:',
                error
            );

            mensaje.textContent =
                'Ocurrió un error al consultar las órdenes de surtido.';

            mensaje.className =
                'alert alert-danger';

            mensaje.style.display =
                'block';
        }
        finally {

            loading.style.display =
                'none';

        }
    }
            function construirTablaOrdenesPieles(ordenes) {

        const tbody =
            document.getElementById('tbodyOrdenesPieles');

        if (!tbody) {
            return;
        }

        tbody.innerHTML = '';

        ordenes.forEach(function (orden) {

            const unidades =
                Number(orden.unidades) || 0;

            const capturadas =
                Number(orden.capturadas) || 0;

            const pendientes =
                Math.max(unidades - capturadas, 0);

            const tr =
                document.createElement('tr');

            tr.style.cursor = 'pointer';

            tr.dataset.solicitudSurtidoId =
                orden.solicitudSurtidoId ?? '';

            tr.innerHTML = `
                <td>${escapeHtml(orden.fechaSurtido ?? '')}</td>
                <td>${escapeHtml(orden.folio ?? '')}</td>
                <td>${escapeHtml(orden.cliente ?? '')}</td>
                <td class="text-center">${unidades}</td>
                <td class="text-center">${capturadas}</td>
                <td class="text-center">${pendientes}</td>
            `;

            tr.addEventListener('dblclick', function () {

                seleccionarOrdenPieles(orden);

            });

            tbody.appendChild(tr);
        });
    }


        function seleccionarOrdenPieles(orden) {

        const cantidadPieles =
            document.getElementById('cantidadPielesGlobal');

        const txtCliente =
            document.getElementById('txtClienteOrden');

        const txtSolicitud =
            document.getElementById('txtSolicitudSurtidoId');

        if (cantidadPieles) {
            cantidadPieles.value =
                Number(orden.unidades) || 0;
        }

        if (txtCliente) {
            txtCliente.value =
                orden.cliente ?? '';
        }

        if (txtSolicitud) {
            txtSolicitud.value =
                orden.solicitudSurtidoId ?? '';
        }

        // También lo dejamos disponible para JS
        window.solicitudSurtidoIdSeleccionada =
            orden.solicitudSurtidoId ?? null;

        // Cerrar modal
        const modalElement =
            document.getElementById('modalOrdenesPieles');

        if (modalElement) {

            const modal =
                bootstrap.Modal.getInstance(modalElement);

            if (modal) {
                modal.hide();
            }
        }
    }
        function obtenerPielesSeleccionadas() {

        const seleccionadas = [];

        lotes.forEach(function (lote) {

            (lote.pieles || []).forEach(function (piel) {

                if (piel.seleccionada === true) {

                    seleccionadas.push({
                        loteId: Number(piel.loteId || lote.loteId),

                        lote:
                            piel.lote ??
                            lote.lote ??
                            '',

                        produccionId:
                            Number(piel.produccionId) || 0,

                        codigoEtiqueta:
                            piel.codigoEtiqueta ?? '',

                        pesoNeto:
                            Number(piel.pesoNeto) || 0,

                        fechaProduccion:
                            piel.fechaProduccion ?? ''
                    });
                }

            });

        });

        return seleccionadas;
    }
            async function guardarPielesSeleccionadas() {

        const mensaje =
            document.getElementById('mensajeGuardarPieles');

        const txtSolicitud =
            document.getElementById('txtSolicitudSurtidoId');

        const txtCliente =
            document.getElementById('txtClienteOrden');

        const cantidadPieles =
            document.getElementById('cantidadPielesGlobal');

        if (!txtSolicitud) {
            console.error(
                'No existe txtSolicitudSurtidoId'
            );
            return;
        }

        const solicitudSurtidoId =
            Number(txtSolicitud.value);

        if (!solicitudSurtidoId) {

            mensaje.textContent =
                'Primero selecciona una orden de surtido.';

            mensaje.className =
                'ms-2 text-danger';

            return;
        }

        const pieles =
            obtenerPielesSeleccionadas();

        if (pieles.length === 0) {

            mensaje.textContent =
                'No hay pieles seleccionadas.';

            mensaje.className =
                'ms-2 text-danger';

            return;
        }

        const datos = {
            solicitudSurtidoId: solicitudSurtidoId,
            pieles: pieles
        };

        console.log('Datos a guardar:', datos);

        try {

            const response =
                await fetch(
                    '/Operaciones/GuardarPielesSurtido',
                    {
                        method: 'POST',

                        headers: {
                            'Content-Type':
                                'application/json'
                        },

                        body:
                            JSON.stringify(datos)
                    }
                );

            if (!response.ok) {

                const error =
                    await response.text();

                throw new Error(
                    error ||
                    `HTTP ${response.status}`
                );
            }

            // El endpoint ahora devuelve directamente un string
            const resultado =
                (await response.text()).trim();

            console.log(
                'Respuesta guardar:',
                resultado
            );

            // ==========================================
            // VALIDAR RESULTADO
            // ==========================================

            if (resultado === '') {

                mensaje.textContent =
                    'El proceso terminó sin generar una remisión.';

                mensaje.className =
                    'ms-2 text-warning';

                return;
            }

            // ==========================================
            // ÉXITO
            // ==========================================

            alert(
                `Remisión creada con éxito: ${resultado}`
            );

            // ==========================================
            // LIMPIAR TEXTBOX
            // ==========================================

            if (cantidadPieles) {
                cantidadPieles.value = '';
            }

            if (txtCliente) {
                txtCliente.value = '';
            }

            if (txtSolicitud) {
                txtSolicitud.value = '';
            }

            // Limpiar ID seleccionado
            window.solicitudSurtidoIdSeleccionada = null;

            // Limpiar mensajes
            if (mensaje) {
                mensaje.textContent = '';
                mensaje.className = 'ms-2 mensaje-guardar';
            }

            const mensajeCantidad =
                document.getElementById(
                    'mensajeCantidadGlobal'
                );

            if (mensajeCantidad) {
                mensajeCantidad.textContent = '';
            }

            // ==========================================
            // RECARGAR LOTES
            // ==========================================

            await cargarLotes();

        }
        catch (error) {

            console.error(
                'Error al guardar las pieles:',
                error
            );

            mensaje.textContent =
                error.message ||
                'Ocurrió un error al guardar las pieles.';

            mensaje.className =
                'ms-2 text-danger';
        }
    }
</script>