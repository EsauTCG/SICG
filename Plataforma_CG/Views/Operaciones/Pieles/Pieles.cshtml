                    function seleccionarPielesAntiguasGlobal() {

        const input =
            document.getElementById('cantidadPielesGlobal');

        const mensaje =
            document.getElementById('mensajeCantidadGlobal');

        if (!input) {
            return;
        }

        const cantidad = parseInt(input.value, 10);

        if (!cantidad || cantidad < 1) {

            mensaje.textContent =
                'Ingresa una cantidad válida.';

            input.focus();

            return;
        }

        // =====================================================
        // VALIDAR QUE EXISTAN LOTES Y PIELES
        // =====================================================

        if (!lotes || lotes.length === 0) {

            mensaje.textContent =
                'No hay lotes disponibles.';

            return;
        }

        const totalPieles =
            todasLasPieles.length;

        if (totalPieles === 0) {

            mensaje.textContent =
                'No hay pieles disponibles.';

            console.error(
                'todasLasPieles está vacío'
            );

            return;
        }

        if (cantidad > totalPieles) {

            mensaje.textContent =
                `Solo existen ${totalPieles} pieles disponibles.`;

            return;
        }

        // =====================================================
        // LIMPIAR SELECCIÓN ANTERIOR
        // =====================================================

        todasLasPieles.forEach(function (item) {

            item.piel.seleccionada = false;

        });

        // =====================================================
        // 1. ORDENAR LOS LOTES POR FECHA/HORA
        // =====================================================

        const lotesOrdenados =
            [...lotes].sort(function (a, b) {

                const fechaA =
                    convertirFechaProduccion(
                        a.fechaProduccion
                    );

                const fechaB =
                    convertirFechaProduccion(
                        b.fechaProduccion
                    );

                return fechaA - fechaB;

            });

        // =====================================================
        // 2. RECORRER LOS LOTES EN ORDEN
        // =====================================================

        let restantes = cantidad;
        let seleccionadas = [];

        for (const lote of lotesOrdenados) {

            if (restantes <= 0) {
                break;
            }

            // Obtener las pieles de ESTE lote
            const pielesLote =
                todasLasPieles.filter(function (item) {

                    return Number(item.loteId) ===
                           Number(lote.loteId);

                });

            if (pielesLote.length === 0) {
                continue;
            }

            // =================================================
            // 3. ORDENAR LAS PIELES DE ESTE LOTE
            //    POR SU FECHA/HORA
            // =================================================

            pielesLote.sort(function (a, b) {

                const fechaA =
                    convertirFechaProduccion(
                        a.piel.fechaProduccion
                    );

                const fechaB =
                    convertirFechaProduccion(
                        b.piel.fechaProduccion
                    );

                return fechaA - fechaB;

            });

            // =================================================
            // 4. TOMAR SOLO LAS QUE FALTAN
            // =================================================

            const cantidadLote =
                Math.min(
                    restantes,
                    pielesLote.length
                );

            const pielesSeleccionadasLote =
                pielesLote.slice(
                    0,
                    cantidadLote
                );

            // =================================================
            // 5. MARCARLAS
            // =================================================

            pielesSeleccionadasLote.forEach(function (item) {

                item.piel.seleccionada = true;

                seleccionadas.push(item);

            });

            // =================================================
            // 6. RESTAR LAS QUE YA TOMAMOS
            // =================================================

            restantes -= cantidadLote;
        }

        // =====================================================
        // ACTUALIZAR CHECKBOXES DE LAS PIELES QUE YA EXISTAN
        // EN EL DOM
        // =====================================================

        document
            .querySelectorAll('.piel-checkbox')
            .forEach(function (checkbox) {

                const loteId =
                    Number(
                        checkbox.dataset.loteId
                    );

                const produccionId =
                    String(
                        checkbox.dataset.produccionId
                    );

                const codigo =
                    String(
                        checkbox.dataset.codigo
                    );

                const item =
                    todasLasPieles.find(function (x) {

                        return (
                            Number(x.loteId) === loteId &&
                            String(x.piel.produccionId) === produccionId &&
                            String(x.piel.codigoEtiqueta) === codigo
                        );

                    });

                checkbox.checked =
                    item?.piel.seleccionada === true;

            });

        // =====================================================
        // ACTUALIZAR CHECKBOXES DE LOS LOTES
        // =====================================================

        lotes.forEach(function (lote) {


     const loteId =
        Number(lote.loteId);

    actualizarCheckboxLote(loteId);

    actualizarResumenLote(loteId);

        });

        // =====================================================
        // MOSTRAR RESUMEN
        // =====================================================

        const resumenLotes = {};

        seleccionadas.forEach(function (item) {

            const loteId =
                Number(item.loteId);

            if (!resumenLotes[loteId]) {
                resumenLotes[loteId] = 0;
            }

            resumenLotes[loteId]++;

        });

        console.table(
            seleccionadas.map(function (item) {

                return {

                    loteId:
                        item.loteId,

                    codigo:
                        item.piel.codigoEtiqueta,

                    produccionId:
                        item.piel.produccionId,

                    fechaLote:
                        lotes.find(
                            x =>
                                Number(x.loteId) ===
                                Number(item.loteId)
                        )?.fechaProduccion,

                    fechaPiel:
                        item.piel.fechaProduccion

                };

            })
        );

        console.log(
            'Distribución por lote:',
            resumenLotes
        );

        mensaje.textContent =
            `Se seleccionaron ${seleccionadas.length} pieles.`;

    }
        function seleccionarPielesAntiguas(loteId) {

