@model IEnumerable<dynamic>
@using System.Globalization
@using System.Text.Json

@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
}

<div class="articulos-container">

    <div class="articulos-ubicacion">

        <div class="ubicacion-slider">

            <input type="radio"
                   id="ubicacionTif"
                   name="ubicacionEtiquetacion"
                   value="0"
                   checked />

            <label for="ubicacionTif">
                TIF
            </label>


            <input type="radio"
                   id="ubicacionPlanta1"
                   name="ubicacionEtiquetacion"
                   value="1" />

            <label for="ubicacionPlanta1">
                Planta 1
            </label>

        </div>

    </div>
    <button type="button"
            class="btn btn-outline-primary"
            onclick="abrirModalLogEtiquetacion()">

        Historial de etiquetación

    </button>
    
    <div class="articulos-buscador">

        <input type="text"
               id="buscadorArticulos"
               class="form-control"
               placeholder="Buscar artículo, producto o etiqueta..."
               autocomplete="off" />

    </div>



    <div class="articulos-tabla-wrapper">

        <table class="table table-bordered table-hover table-sm articulos-tabla">

            <thead>

                <tr>
                    <th>ArticuloId</th>
                    <th>Producto</th>
                    <th>Etiqueta</th>
                </tr>

            </thead>

            <tbody id="tbodyArticulos">


            </tbody>

        </table>

    </div>

</div>


<style>
    .articulos-ubicacion {
        position: sticky;
        top: 0;
        z-index: 1001;
        background: white;
        padding: 10px 0 5px 0;
    }


    /*
        Contenedor del slider
    */
    .ubicacion-slider {
        display: flex;
        width: 100%;
        border: 1px solid #ced4da;
        border-radius: 8px;
        overflow: hidden;
    }


        /*
        Ocultamos los radio buttons
    */
        .ubicacion-slider input {
            display: none;
        }


        /*
        Opciones
    */
        .ubicacion-slider label {
            flex: 1;
            text-align: center;
            padding: 10px;
            cursor: pointer;
            background: #f8f9fa;
            color: #495057;
            font-weight: 500;
            user-select: none;
        }


        /*
        Opción seleccionada
    */
        .ubicacion-slider input:checked + label {
            background: #0d6efd;
            color: white;
        }


        /*
        Efecto al tocar
    */
        .ubicacion-slider label:active {
            opacity: 0.8;
        }
    .articulos-container {
        width: 100%;
        max-width: 100%;
        padding: 10px;
        box-sizing: border-box;
    }

    /*
            Barra de búsqueda siempre visible
        */
    .articulos-buscador {
        position: sticky;
        top: 0;
        z-index: 1000;
        background: white;
        padding: 10px 0;
        border-bottom: 1px solid #dee2e6;
    }

        .articulos-buscador input {
            width: 100%;
            min-height: 45px;
            font-size: 16px;
            padding: 10px 12px;
            box-sizing: border-box;
        }


    /*
            Contenedor con scroll
        */
    .articulos-tabla-wrapper {
        width: 100%;
        overflow-x: auto;
        overflow-y: auto;
        max-height: calc(100vh - 90px);
        -webkit-overflow-scrolling: touch;
    }


    /*
            Tabla
        */
    .articulos-tabla {
        width: 100%;
        min-width: 500px;
        margin-bottom: 0;
        border-collapse: separate;
        border-spacing: 0;
    }


        /*
            Encabezados fijos
        */
        .articulos-tabla thead th {
            position: sticky;
            top: 0;
            z-index: 10;
            background: #f8f9fa;
            white-space: nowrap;
            font-weight: 600;
            padding: 10px;
        }


        /*
            Celdas
        */
        .articulos-tabla td {
            padding: 10px;
            vertical-align: middle;
            white-space: nowrap;
        }


            /*
            Primera columna
        */
            .articulos-tabla th:first-child,
            .articulos-tabla td:first-child {
                width: 100px;
                text-align: center;
            }


            /*
            Producto
        */
            .articulos-tabla th:nth-child(2),
            .articulos-tabla td:nth-child(2) {
                min-width: 180px;
                text-align: left;
            }


            /*
            Etiqueta
        */
            .articulos-tabla th:nth-child(3),
            .articulos-tabla td:nth-child(3) {
                min-width: 150px;
                text-align: left;
            }


        /*
            Mejora visual al pasar sobre una fila
        */
        .articulos-tabla tbody tr {
            cursor: pointer;
        }

    .log-etiquetacion-tabla-wrapper {
        width: 100%;
        overflow-x: auto;
        overflow-y: auto;
        max-height: 60vh;
        -webkit-overflow-scrolling: touch;
    }


    #tablaLogEtiquetacion {
        width: 100%;
        min-width: 700px;
        margin-bottom: 0;
    }


        #tablaLogEtiquetacion thead th {
            position: sticky;
            top: 0;
            z-index: 10;
            background: #f8f9fa;
            white-space: nowrap;
        }


        #tablaLogEtiquetacion td {
            vertical-align: middle;
            white-space: nowrap;
        }


        #tablaLogEtiquetacion tbody tr {
            cursor: default;
        }
</style>

<div class="modal fade"
     id="modalDetalleArticulo"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <!-- ===================================== -->
            <!-- HEADER -->
            <!-- ===================================== -->

            <div class="modal-header">

                <h5 class="modal-title">
                    Detalle del artículo
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar">
                </button>

            </div>


            <!-- ===================================== -->
            <!-- BODY -->
            <!-- ===================================== -->

            <div class="modal-body">

                <!-- ArticuloId -->
                <div class="mb-3">

                    <label class="form-label">
                        ArticuloId
                    </label>

                    <input type="text"
                           id="detalleArticuloId"
                           class="form-control"
                           readonly />

                </div>


                <!-- Producto -->
                <div class="mb-3">

                    <label class="form-label">
                        Producto
                    </label>

                    <input type="text"
                           id="detalleProducto"
                           class="form-control"
                           readonly />

                </div>


                <!-- ================================= -->
                <!-- ETIQUETA -->
                <!-- ================================= -->

                <div class="mb-3">

                    <label for="detalleEtiqueta"
                           class="form-label">

                        Etiqueta

                    </label>

                    <div class="position-relative">

                        <input type="text"
                               id="detalleEtiqueta"
                               class="form-control"
                               autocomplete="off"
                               placeholder="Buscar etiqueta..." />

                        <div id="listaEtiquetasAutocomplete"
                             class="list-group position-absolute w-100 shadow"
                             style="z-index: 1056; max-height: 250px; overflow-y: auto; display: none;">
                        </div>

                    </div>

                </div>


                <hr />


                <!-- ================================= -->
                <!-- NOMBRE -->
                <!-- ================================= -->

                <div class="mb-3">

                    <label class="form-label">
                        Nombre
                    </label>

                    <input type="text"
                           id="detalleNombre"
                           class="form-control"
                           readonly />

                </div>


                <!-- ================================= -->
                <!-- CADUCIDAD -->
                <!-- ================================= -->

                <div class="mb-3">

                    <label class="form-label">
                        Días de caducidad
                    </label>

                    <input type="text"
                           id="detalleDiasCaducidad"
                           class="form-control"
                           readonly />

                </div>


                <!-- ================================= -->
                <!-- DATOS INTERNOS -->
                <!-- No visibles para el usuario -->
                <!-- ================================= -->

                <input type="hidden"
                       id="detalleColectorId" />

            </div>


            <!-- ===================================== -->
            <!-- FOOTER -->
            <!-- ===================================== -->

            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Cerrar
                </button>

                <button type="button"
                        id="btnGuardarEtiqueta"
                        class="btn btn-primary"
                        onclick="guardarEtiquetaArticulo()">
                    Guardar
                </button>

            </div>

        </div>

    </div>

</div>

<div class="modal fade"
     id="modalLogEtiquetacion"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">

        <div class="modal-content">

            <!-- ========================================= -->
            <!-- HEADER -->
            <!-- ========================================= -->

            <div class="modal-header">

                <h5 class="modal-title">
                    Historial de etiquetación
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Cerrar">
                </button>

            </div>


            <!-- ========================================= -->
            <!-- BODY -->
            <!-- ========================================= -->

            <div class="modal-body">

                <!-- ===================================== -->
                <!-- FILTROS -->
                <!-- ===================================== -->

                <div class="card mb-3">

                    <div class="card-body">

                        <div class="row g-3 align-items-end">

                            <div class="col-md-5">

                                <label for="fechaInicialLogEtiq"
                                       class="form-label">
                                    Fecha inicial
                                </label>

                                <input type="date"
                                       id="fechaInicialLogEtiq"
                                       class="form-control" />

                            </div>


                            <div class="col-md-5">

                                <label for="fechaFinalLogEtiq"
                                       class="form-label">
                                    Fecha final
                                </label>

                                <input type="date"
                                       id="fechaFinalLogEtiq"
                                       class="form-control" />

                            </div>


                            <div class="col-md-2">

                                <button type="button"
                                        id="btnConsultarLogEtiq"
                                        class="btn btn-primary w-100"
                                        onclick="cargarLogEtiquetacion()">

                                    Consultar

                                </button>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- ===================================== -->
                <!-- TABLA -->
                <!-- ===================================== -->

                <div class="log-etiquetacion-tabla-wrapper">

                    <table class="table table-bordered table-hover table-sm text-center"
                           id="tablaLogEtiquetacion">

                        <thead class="table-light">

                            <tr>

                                <th>
                                    SKU
                                </th>

                                <th>
                                    Producto
                                </th>

                                <th>
                                    Etiqueta Anterior
                                </th>

                                <th>
                                    Etiqueta Nueva
                                </th>

                                <th>
                                    FechaHora
                                </th>

                            </tr>

                        </thead>

                        <tbody id="tbodyLogEtiquetacion">
                        </tbody>

                    </table>

                </div>

            </div>


            <div class="modal-footer">

                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">

                    Cerrar

                </button>

            </div>

        </div>

    </div>

</div>


<script src="~/js/Etiquetas/planetiquetacion.js"></script>