@model IEnumerable<dynamic>
@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Captura de Inyecciones";
}
<style>
    /* CSS INTERNO - RESPONSIVE V4 */
    500;600;700;800&display=swap');

    :root {
        --inj-brand: #781823;
        --inj-brand-dark: #521018;
        --inj-brand-soft: #f7e9eb;
        --inj-bg: #eef2f5;
        --inj-card: #ffffff;
        --inj-line: #d8e1e8;
        --inj-text: #203142;
        --inj-muted: #63788b;
        --inj-blue: #1875e8;
        --inj-green: #20a95b;
        --inj-green-dark: #158149;
        --inj-orange: #e89a17;
        --inj-shadow: 0 5px 18px rgba(27, 43, 58, .08);
    }

    /* =========================================================
       BASE
       ========================================================= */
    html,
    body {
        width: 100% !important;
        max-width: 100% !important;
        min-width: 0 !important;
        overflow-x: hidden !important;
    }

    body,
    .op-inj-v3,
    .op-inj-v3 * {
        box-sizing: border-box;
        font-family: 'Poppins', 'Segoe UI', Arial, sans-serif;
    }

    body {
        background: var(--inj-bg) !important;
        color: var(--inj-text);
    }

        body:has(.op-inj-v3) .layout-main-content,
        body:has(.op-inj-v3) .layout-container-fluid {
            min-width: 0 !important;
            max-width: 100% !important;
        }

    /*
      IMPORTANTE:
      no ponemos width:100vw porque Layout2 ya tiene sidebar.
      100vw + sidebar provoca que el contenido se salga hacia la derecha.
    */
    .op-inj-v3 {
        width: 100%;
        min-width: 0;
        max-width: 100%;
        padding: 8px;
        overflow: hidden;
    }

    .inj-page,
    .inj-header,
    .inj-dashboard,
    .inj-main,
    .inj-side,
    .inj-setup,
    .inj-data,
    .inj-card,
    .inj-tools-grid {
        min-width: 0;
        max-width: 100%;
    }

    .inj-page {
        width: 100%;
        max-width: 100%;
        margin: 0;
        display: grid;
        gap: 8px;
    }

    .inj-card {
        background: var(--inj-card);
        border: 1px solid var(--inj-line);
        border-radius: 14px;
        box-shadow: var(--inj-shadow);
    }

    /* =========================================================
       CABECERA
       ========================================================= */
    .inj-header {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(210px, 26%);
        gap: 10px;
        align-items: center;
        padding: 10px 13px;
        color: #fff;
        background: linear-gradient(135deg, var(--inj-brand-dark), var(--inj-brand));
        border-radius: 16px;
    }

    .inj-kicker {
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .05em;
    }

    .inj-title-row {
        display: flex;
        align-items: center;
        gap: 18px;
        min-width: 0;
    }

        .inj-title-row h1 {
            margin: 2px 0;
            white-space: nowrap;
            font-size: clamp(24px, 2vw, 34px);
            line-height: 1;
            font-weight: 800;
        }

    .inj-header-main > p {
        margin: 4px 0 0;
        font-size: 11px;
        color: #f4dfe2;
    }

    .inj-flow {
        flex: 1;
        min-width: 0;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 5px;
    }

        .inj-flow span {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            min-width: 0;
            padding: 5px 8px;
            border: 1px solid rgba(255,255,255,.18);
            border-radius: 9px;
            background: rgba(255,255,255,.08);
            white-space: nowrap;
            font-size: 9px;
            font-weight: 700;
        }

            .inj-flow span.finish {
                background: rgba(240, 160, 60, .28);
            }

            .inj-flow span b {
                display: inline-grid;
                place-items: center;
                width: 21px;
                height: 21px;
                border-radius: 999px;
                background: #fff;
                color: var(--inj-brand);
                font-size: 9px;
            }

        .inj-flow i {
            opacity: .65;
            font-style: normal;
            font-size: 9px;
        }

    .inj-program {
        padding: 8px 10px;
        border: 1px solid rgba(255,255,255,.18);
        border-radius: 12px;
        background: rgba(255,255,255,.11);
    }

        .inj-program span {
            display: block;
            font-size: 8px;
            font-weight: 800;
        }

        .inj-program strong {
            display: block;
            min-height: 30px;
            margin-top: 4px;
            padding: 5px 8px;
            border-radius: 8px;
            background: rgba(255,255,255,.94);
            color: var(--inj-brand-dark);
            font-size: 16px;
            line-height: 20px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

    /* =========================================================
       TABLERO
       ========================================================= */
    .inj-dashboard {
        display: grid;
        grid-template-columns: minmax(0, 1.65fr) minmax(280px, .72fr);
        gap: 8px;
        align-items: stretch;
    }

    .inj-main {
        display: grid;
        grid-template-rows: auto minmax(0, 1fr) auto;
        gap: 8px;
    }

    .inj-side {
        display: grid;
        grid-template-rows: minmax(105px, .65fr) minmax(150px, 1fr) auto;
        gap: 8px;
    }

    /* =========================================================
       PASOS 1,2,4
       ========================================================= */
    .inj-setup {
        display: grid;
        grid-template-columns: minmax(150px, .72fr) minmax(0, 1.35fr) minmax(155px, .62fr);
        gap: 8px;
    }

    .inj-lot,
    .inj-product,
    .inj-capture {
        padding: 8px 9px;
    }

    .inj-card label {
        display: flex;
        align-items: center;
        gap: 6px;
        margin: 0 0 5px;
        font-size: 9px;
        font-weight: 800;
        color: #526f88;
    }

        .inj-card label b {
            display: inline-grid;
            place-items: center;
            width: 18px;
            height: 18px;
            border-radius: 999px;
            background: #eaf2fb;
            color: var(--inj-blue);
            font-size: 9px;
        }

    .inj-lot select {
        width: 100%;
        height: 36px;
        min-width: 0;
        border: 1px solid var(--inj-line);
        border-radius: 9px;
        background: #fff;
        color: var(--inj-text);
        padding: 0 9px;
        font-size: 11px;
    }

    .inj-product-btn {
        width: 100%;
        height: 48px;
        min-width: 0;
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 5px 7px;
        border: 1px solid #bbd3ee;
        border-radius: 10px;
        background: #f5faff;
        color: var(--inj-text);
        cursor: pointer;
    }

    .inj-product-icon {
        flex: 0 0 31px;
        width: 31px;
        height: 31px;
        display: grid;
        place-items: center;
        border-radius: 8px;
        background: #dfeefa;
        font-size: 16px;
    }

    .inj-product-text {
        flex: 1;
        min-width: 0;
        display: grid;
        text-align: left;
    }

        .inj-product-text strong {
            font-size: 11px;
            line-height: 1.1;
        }

        .inj-product-text small {
            margin-top: 2px;
            color: var(--inj-muted);
            font-size: 8px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

    .inj-product-btn em {
        flex: 0 0 auto;
        color: var(--inj-blue);
        font-style: normal;
        font-size: 8px;
        font-weight: 800;
    }

    .inj-capture {
        display: flex;
        flex-direction: column;
    }

    .inj-capture-btn {
        width: 100%;
        flex: 1;
        min-height: 48px;
        border: 0 !important;
        border-radius: 10px !important;
        background: linear-gradient(180deg, #2cbb6b, #1c9f57) !important;
        color: #fff !important;
        font-size: clamp(15px, 1.3vw, 19px) !important;
        font-weight: 800 !important;
        cursor: pointer;
    }

    /* =========================================================
       PESO
       ========================================================= */
    .inj-weight {
        min-height: 0;
        padding: 9px 11px;
        display: grid;
        grid-template-rows: auto minmax(0, 1fr) auto;
        border-color: #cfdeec;
        background: linear-gradient(180deg, #fff, #f8fbfe);
    }

    .inj-weight-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 8px;
    }

        .inj-weight-head label {
            margin-bottom: 2px;
        }

        .inj-weight-head small {
            display: block;
            color: var(--inj-muted);
            font-size: 8px;
        }

    .inj-mode-btn {
        flex: 0 0 auto;
        margin: 0 !important;
        padding: 5px 9px !important;
        border: 1px solid #efd58f !important;
        border-radius: 999px !important;
        background: #fff5dc !important;
        color: #7b5600 !important;
        font-size: 8px !important;
        font-weight: 800 !important;
        cursor: pointer;
    }

    .inj-weight-body {
        min-height: 0;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .inj-weight-body .value {
            color: #981722;
            font-size: clamp(54px, 7.4vh, 82px);
            line-height: .88;
            font-weight: 800;
        }

        .inj-weight-body > span {
            color: var(--inj-muted);
            font-size: 19px;
            font-weight: 800;
        }

    .inj-manual-weight {
        display: none;
        width: 170px !important;
        height: 38px !important;
        min-height: 38px !important;
        margin-left: 8px;
        border: 2px solid #e6a4aa !important;
        border-radius: 9px !important;
        color: #bd2733 !important;
        text-align: center;
        font-size: 21px !important;
        font-weight: 800;
    }

    .inj-weight-note {
        color: var(--inj-muted);
        font-size: 8px;
    }

    /* =========================================================
       DATOS DE PROCESO
       ========================================================= */
    .inj-data {
        display: grid;
        grid-template-columns: .75fr .75fr .85fr 1.35fr .75fr .75fr .75fr .75fr .8fr;
        gap: 4px;
    }

        .inj-data article {
            min-width: 0;
            min-height: 52px;
            padding: 5px 6px;
            border: 1px solid var(--inj-line);
            border-radius: 9px;
            background: #fff;
            overflow: hidden;
        }

            .inj-data article.wide {
                border-left: 3px solid var(--inj-brand);
            }

        .inj-data small {
            display: block;
            color: #58738b;
            font-size: 6.8px;
            line-height: 1;
            font-weight: 800;
            text-transform: uppercase;
        }

        .inj-data input[disabled] {
            width: 100%;
            height: 27px;
            min-height: 27px;
            padding: 0;
            border: 0;
            background: transparent;
            color: var(--inj-text);
            font-size: clamp(11px, .9vw, 15px);
            line-height: 27px;
            font-weight: 800;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

    /* =========================================================
       DERECHA: PRODUCTO
       ========================================================= */
    .inj-preview {
        min-height: 0;
        padding: 7px 8px;
        display: grid;
        grid-template-rows: auto minmax(0, 1fr);
        overflow: hidden;
    }

    .inj-section-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 8px;
    }

        .inj-section-head span {
            display: block;
            color: var(--inj-muted);
            font-size: 7px;
            font-weight: 800;
        }

        .inj-section-head strong {
            display: block;
            margin-top: 1px;
            color: var(--inj-text);
            font-size: 11px;
            line-height: 1.08;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

    .inj-ok-dot {
        color: var(--inj-green);
        font-style: normal;
        font-size: 12px;
    }

    .inj-image {
        position: relative;
        min-height: 0;
        height: 100%;
        margin-top: 4px;
        display: grid;
        place-items: center;
        border: 1px dashed #cedbe5;
        border-radius: 8px;
        background: #f5f8fa;
        overflow: hidden;
    }

        .inj-image img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            padding: 4px;
            object-fit: contain;
        }

    .inj-image-empty {
        color: #8b9aaa;
        font-size: 8px;
        font-weight: 700;
    }

    /* =========================================================
       DERECHA: ÚLTIMAS CAPTURAS
       ========================================================= */
    .inj-recent {
        min-height: 0;
        padding: 7px 8px;
        display: grid;
        grid-template-rows: auto minmax(0, 1fr);
        overflow: hidden;
    }

    .inj-report-btn {
        flex: 0 0 auto;
        padding: 4px 7px;
        border: 1px solid #e3c5ca;
        border-radius: 7px;
        background: #fff3f4;
        color: var(--inj-brand);
        font-size: 7px;
        font-weight: 800;
        cursor: pointer;
    }

    .inj-table-scroll {
        min-width: 0;
        min-height: 0;
        height: 100%;
        margin-top: 4px;
        overflow: auto;
        -webkit-overflow-scrolling: touch;
    }

    .tabla-reporte {
        width: max-content;
        min-width: 650px;
        border-collapse: collapse;
    }

        .tabla-reporte th,
        .tabla-reporte td {
            padding: 3px 4px;
            border: 1px solid #d8e1e8;
            white-space: nowrap;
            text-align: center;
            font-size: 7px;
            line-height: 1.1;
        }

        .tabla-reporte thead th {
            position: sticky;
            top: 0;
            z-index: 2;
            background: #243c51;
            color: #fff;
        }

    /* =========================================================
       DERECHA: CONFIGURACIÓN
       ========================================================= */
    .inj-tools {
        padding: 7px 8px;
    }

    .inj-tools-title {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 6px;
    }

        .inj-tools-title span {
            color: var(--inj-muted);
            font-size: 7px;
            font-weight: 800;
        }

        .inj-tools-title small {
            color: var(--inj-muted);
            font-size: 6px;
        }

    .inj-tools-grid {
        margin-top: 4px;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 4px;
    }

        .inj-tools-grid button {
            min-width: 0;
            min-height: 44px;
            padding: 4px 3px;
            display: grid;
            grid-template-columns: 20px minmax(0, 1fr);
            grid-template-rows: auto auto;
            column-gap: 3px;
            align-items: center;
            border: 1px solid var(--inj-line);
            border-radius: 7px;
            background: #f7fafc;
            color: var(--inj-text);
            text-align: left;
            cursor: pointer;
        }

            .inj-tools-grid button > span {
                grid-row: 1 / 3;
                width: 20px;
                height: 20px;
                display: grid;
                place-items: center;
                border-radius: 6px;
                background: #e7eff7;
                font-size: 10px;
            }

            .inj-tools-grid button b {
                min-width: 0;
                font-size: 6.8px;
                line-height: 1;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .inj-tools-grid button small {
                min-width: 0;
                color: var(--inj-muted);
                font-size: 5.5px;
                line-height: 1;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

    /* =========================================================
       MODALES / ELEMENTOS EXISTENTES
       ========================================================= */
    .overlay {
        position: fixed;
        inset: 0;
        display: none;
        background: rgba(0,0,0,.45);
        z-index: 1000;
    }

    .modal {
        display: none;
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: min(96vw, 980px);
        max-height: 88vh;
        overflow-y: auto;
        padding: 18px;
        border-radius: 16px;
        background: #fff;
        box-shadow: 0 18px 40px rgba(0,0,0,.25);
        z-index: 1001;
    }

    .modal-full,
    .modal-reporte {
        width: min(98vw, 1500px);
        max-height: 92vh;
    }

    .modal-header {
        margin-bottom: 12px;
        color: var(--inj-brand-dark);
        font-size: 22px;
        font-weight: 800;
    }

    .modal-body {
        margin-top: 10px;
    }

    .modal-footer {
        margin-top: 12px;
        display: flex;
        justify-content: flex-end;
        gap: 8px;
    }

    .modal input,
    .modal select {
        width: 100%;
        min-height: 42px;
        border: 1px solid #cfd9e1;
        border-radius: 9px;
        padding: 0 10px;
    }

    .btn {
        border: 0;
        border-radius: 9px;
        padding: 9px 12px;
        font-weight: 700;
        cursor: pointer;
    }

        .btn.primary2 {
            background: var(--inj-brand);
            color: #fff;
        }

        .btn.report,
        .btn.excel {
            background: #edf3f7;
            color: var(--inj-text);
        }

    .btn-Pr {
        float: right;
        border: 0;
        background: transparent;
        color: #d63d32;
        font-size: 22px;
        font-weight: 800;
        cursor: pointer;
    }

    .op-search-bar {
        padding: 0 0 10px;
    }

        .op-search-bar #resultadosBusqueda {
            margin-top: 6px;
            color: var(--inj-muted);
            font-size: 12px;
        }

    .product-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(165px, 1fr));
        gap: 12px;
    }

    .tara-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
        gap: 10px;
    }

    .filtros-reporte,
    .filtros-reportes-top,
    .fechas-reportes,
    .acciones-reportes-left,
    .acciones-reportes-right,
    .tabs {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .filtros-reportes-top {
        justify-content: space-between;
    }

    .tab-btn {
        padding: 9px 12px;
        border: 0;
        border-bottom: 3px solid transparent;
        background: transparent;
        font-weight: 700;
        cursor: pointer;
    }

        .tab-btn.active {
            color: var(--inj-brand);
            border-bottom-color: var(--inj-brand);
        }

    .tab-content {
        display: none;
    }

        .tab-content.active {
            display: block;
        }

    .tabla-contenedor,
    .tabla-wrapper {
        overflow: auto;
    }

    #tablaComparacion {
        width: 100%;
        border-collapse: collapse;
    }

        #tablaComparacion th,
        #tablaComparacion td {
            padding: 7px;
            border: 1px solid #ddd;
            text-align: center;
        }

        #tablaComparacion th {
            background: #f4f6f8;
        }

    .toast {
        position: fixed;
        right: 18px;
        bottom: 18px;
        z-index: 1200;
        display: none;
        min-width: 280px;
        padding: 12px 14px;
        border: 1px solid var(--inj-line);
        border-radius: 12px;
        background: #fff;
        box-shadow: var(--inj-shadow);
    }

    .toast-error {
        border-color: #efb5b5;
    }

    .toast-title {
        font-weight: 800;
    }

    .toast-message {
        margin-top: 3px;
        color: var(--inj-muted);
    }

    .toast-actions {
        margin-top: 8px;
        display: flex;
        gap: 6px;
    }

    .toast-btn {
        padding: 7px 10px;
        border: 0;
        border-radius: 8px;
        cursor: pointer;
    }

    .loading-overlay {
        position: fixed;
        inset: 0;
        z-index: 1300;
        display: none;
        align-items: center;
        justify-content: center;
        background: rgba(255,255,255,.65);
    }

    .loading-box {
        padding: 18px 22px;
        border-radius: 14px;
        background: #fff;
        box-shadow: var(--inj-shadow);
        text-align: center;
    }

    .spinner {
        width: 38px;
        height: 38px;
        margin: 0 auto 10px;
        border: 4px solid #e6ecf2;
        border-top-color: var(--inj-brand);
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @@keyframes spin {
        to {
            transform: rotate(360deg);
        }
    }

    .confirm-summary {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 8px;
    }

    .confirm-item {
        padding: 10px;
        border: 1px solid var(--inj-line);
        border-radius: 10px;
        background: #f7fafc;
    }

        .confirm-item span {
            display: block;
            color: var(--inj-muted);
            font-size: 11px;
        }

        .confirm-item strong {
            display: block;
            margin-top: 3px;
            font-size: 16px;
        }

    .confirm-warning {
        margin: 12px 0;
        padding: 10px;
        border: 1px solid #ecd18d;
        border-radius: 10px;
        background: #fff6dd;
        color: #775600;
    }

    .confirm-actions {
        display: flex;
        justify-content: flex-end;
        gap: 8px;
    }

    .btn-cancelar-confirm {
        background: #eef2f5;
    }

    .btn-confirmar-captura {
        background: var(--inj-green);
        color: #fff;
    }

    /* =========================================================
       LAPTOP / ESCRITORIO:
       TODO DEBE CABER SIN SCROLL DE PÁGINA
       ========================================================= */
    @@media (min-width: 681px) {
        body:has(.op-inj-v3) {
            overflow-y: hidden !important;
        }

        .op-inj-v3 {
            /*
              Layout2 ocupa aproximadamente la barra superior.
              86px deja margen suficiente sin depender de una resolución fija.
            */
            height: calc(100dvh - 86px);
            max-height: calc(100dvh - 86px);
        }

        .inj-page {
            height: 100%;
            min-height: 0;
            grid-template-rows: auto minmax(0, 1fr);
            overflow: hidden;
        }

        .inj-dashboard,
        .inj-main,
        .inj-side {
            min-height: 0;
            height: 100%;
            overflow: hidden;
