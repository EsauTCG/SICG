@model IEnumerable<dynamic>
@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
}


<link rel="stylesheet" href="~/css/inyecciones-grid.css" asp-append-version="true" />


<!-- Shell Bar -->
<!-- Layout -->
<div class="inyecciones-app">
<div class="layout">

    <!-- Contenido principal -->
    <main class="contents">

        <!-- Toolbar / Filtros principales -->
        <section class="toolbar">
            <div class="filters">
                <div>
                    <label for="loteSelect">Lote</label>
                    <select id="loteSelect">
                        <option>—</option>
                    </select>
                </div>
                <div style="display:flex; align-items:center;gap:2rem;">
                    <div>
                        <label>Producto</label>
                        <button class="btn report" onclick="refrescarYAbrirModalProducto()">
                            Seleccionar producto
                        </button>
                        <span id="productoSeleccionado" style="margin-left:10px; font-weight:600;">—</span>
                    </div>
                    <div>
                    </div>
                </div>

                <div class="toolbar-actions">
                    <button class="btn primary" id="btnStart" onclick="abrirConfirmacionCaptura()">
                        Capturar
                    </button>
                    <!-- <button class="btn report" id="btnreporte">Ver Reporte</button> -->
                    <button class="btn report" onclick="abrirModalReportes()">
                        Ver Reportes
                    </button>

                    <button class="btn report" id="SeleccionarTara">⚙️ Configurar Tara</button>


                </div>

                <!-- 👇 SIEMPRE abajo -->
                <div class="programacion-info">
                    <span>Programación actual:</span>
                    <span id="programacionActual">—</span>
                </div>
            </div>
        </section>

        <!-- KPIs + Tabla tiempo real arriba -->
        <section class="kpis kpis-con-tiempo-real">

            <!-- IZQUIERDA: Peso + Imagen -->
            <div class="kpis-main">
                <div class="kpi ok" id="kpiPeso">
                    <div class="title">Peso actual (kg)</div>

                    <div style="display: flex; align-items: center; gap: 10px; justify-content: center;">
                        <div class="value" id="pesoActual">0.00</div>

                        <input type="number"
                               id="inputPesoManual"
                               step="0.01"
                               min="0"
                               placeholder="0.00"
                               style="display: none; width: 120px; padding: 8px; font-size: 24px; font-weight: bold; text-align: center; border: 2px solid #007bff; border-radius: 4px;" />
                    </div>
                </div>

                <div class="kpi kpi-producto-preview">
                    <img id="imagenProducto"
                         src=""
                         alt="Imagen del producto">
                </div>
            </div>

            <!-- DERECHA: Tabla tiempo real -->
            <div class="panel panel-tiempo-real">
                <div class="header">
                    Últimas capturas de hoy
                </div>

                <div class="tabla-tiempo-real-wrapper">
                    <table class="tabla-reporte tabla-tiempo-real">
                        <thead>
                            <tr>
                                <th>Ref</th>
                                <th>Hora</th>
                                <th>Lote</th>
                                <th>SKU</th>
                                <th>Producto</th>
                                <th>Peso</th>
                                <th>Tara</th>
                                <th>Modo</th>
                                <th>Usuario</th>
                                <th>Autorizacion</th>
                            </tr>
                        </thead>

                        <tbody id="tbodyDetalladoTiempoReal">
                            <tr>
                                <td colspan="10">Seleccione un lote para ver capturas.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>

        </section>
    </main>
</div>

<!-- Dos columnas: Datos de proceso + Config rápida -->
<section class="one-col">
    <section class="two-col">
        <!-- Datos de la corrida -->
        <div class="panel">
            <div class="header">Datos de proceso</div>
            <div class="bodys">
                <div class="form-grid readonly">
                    <div class="field">
                        <label>SKU</label>
                        <input type="text" id="sku" disabled placeholder="—" />
                    </div>
                    <div class="field">
                        <label>Porcentaje</label>
                        <input type="text" id="porcentaje" disabled placeholder="—" />
                    </div>
                    <div class="field">
                        <label>Velocidad</label>
                        <input type="text" id="velocidad" disabled placeholder="—" />
                    </div>
                    <div class="field">
                        <label>Producto</label>
                        <input type="text" id="producto" disabled placeholder="—" />
                    </div>
                    <div class="field">
                        <label>Modo</label>
                        <input type="text" id="modo" disabled placeholder="—" />
                    </div>
                    <div class="field">
                        <label>Presión</label>
                        <input type="text" id="presion" disabled placeholder="—" />
                    </div>
                    <div class="field">
                        <label>Altura</label>
                        <input type="text" id="altura" disabled placeholder="—" />
                    </div>
                    <div class="field">
                        <label>Avance</label>
                        <input type="text" id="avance" disabled placeholder="—" />
                    </div>
                    <div class="field">
                        <label>Seleccionar Tara</label>
                        <input type="text" id="tara" disabled placeholder="—" />
                    </div>
                </div>
            </div>
        </div>




        <!-- Configuración rápida (Báscula/Impresora) -->
        <div class="panel">
            <div class="header">Configuración rápida</div>
            <div class="bodys">
                <div class="cards">
                    <div class="Contra">


                        <div class="card">
                            <div class="row">
                                <div>
                                    <div style="font-weight:700;">Báscula</div>
                                    <div class="meta" id="metaBascula">Sin configurar</div>
                                </div>
                                <!-- Antes: onclick="abrirModal('modalContra')" -->
                                @*<button class="btn" onclick="abrirModalContra('modalBascula')">⚖️ Configurar</button>*@
                                <button class="btn" onclick="abrirModal('modalBascula')">⚖️ Configurar</button>
                            </div>
                        </div>

                        <div class="card">
                            <div class="row">
                                <div>
                                    <div style="font-weight:700;">Impresora</div>
                                    <div class="meta" id="metaImpresora">Sin configurar</div>
                                </div>
                                <!-- Antes: onclick="abrirModal('modalContra')" -->
                                <button class="btn" onclick="abrirModal('modalImpresora')">🖨️ Configurar</button>
                            </div>
                        </div>


                    </div>



                    <div class="card">
                        <div class="row">
                            <div>
                                <div style="font-weight:700;">Impresiones</div>
                            </div>
                            <button onclick="reimprimirUltimaCaptura()" class="btn-secondary" style="background: #17a2b8;">
                                🖨️ Reimprimir Última
                            </button>
                        </div>
                    </div>

                    <div class="card">
                        <div class="row">
                            <div>
                                <div style="font-weight:700;">Seleccionar Modo</div>
                            </div>
                            <button id="btnTogglePeso"
                                    class="btn-toggle-peso"
                                    title="Cambiar a modo manual"
                                    style="margin-top: 10px;">
                                Manual
                            </button>
                        </div>
                    </div>





                </div>
            </div>
        </div>
    </section>


@*     <div class="tabla-contenedor">
        <table class="tabla-reporte">
            <thead>
                <tr>
                    <th>SKU</th>
                    <th>Esperado %</th>
                    <th>Peso Entrada</th>
                    <th>Peso Salida</th>
