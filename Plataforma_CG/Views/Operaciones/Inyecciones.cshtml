                        <label><b>2</b> PRODUCTO</label>

                        <div class="inj-product-actions">
                            <button class="inj-product-btn"
                                    type="button"
                                    onclick="refrescarYAbrirModalProducto()">
                                <span class="inj-product-icon">📦</span>
                                <span class="inj-product-text">
                                    <strong>Elegir producto</strong>
                                    <small id="productoSeleccionado">—</small>
                                </span>
                                <em>CAMBIAR →</em>
                            </button>

                            <button type="button"
                                    id="SeleccionarTara"
                                    class="inj-tara-top-btn"
                                    title="Seleccionar tara">
                                <span class="inj-tara-top-icon">⚖️</span>
                                <span class="inj-tara-top-text">
                                    <strong>Tara</strong>
                                    <small id="metaTara">Sin seleccionar</small>
                                </span>
                            </button>
                        </div>
                    </article>

                    <article class="inj-card inj-capture">
                        <label><b>4</b> REGISTRAR</label>
                        <button class="btn primary inj-capture-btn"
                                id="btnStart"
                                type="button"
                                onclick="abrirConfirmacionCaptura()">
                            ✓ CAPTURAR
                        </button>
                    </article>
                </section>

                <article class="inj-card inj-weight" id="kpiPeso">
                    <div class="inj-weight-head">
                        <div>
                            <label><b>3</b> PESO ACTUAL</label>
                            <small>Confirma que la lectura esté estable para capturar.</small>
                        </div>

                        <button id="btnTogglePeso"
                                class="btn-toggle-peso inj-mode-btn"
                                title="Cambiar a modo manual"
                                type="button">
                            Manual
                        </button>
                    </div>

                    <div class="inj-weight-shell">
                        <div class="inj-scale-widget">
                            <div class="inj-scale-handle"></div>

                            <div class="inj-scale-screen">
                                <div class="inj-weight-body">
                                    <div class="value" id="pesoActual">0.00</div>
                                    <span>kg</span>

                                    <input type="number"
                                           id="inputPesoManual"
                                           step="0.01"
                                           min="0"
                                           placeholder="0.00"
                                           class="inj-manual-weight" />
                                </div>
                            </div>

                            <div class="inj-scale-feet">
                                <i></i>
                                <i></i>
                            </div>
                        </div>

                        <div class="inj-weight-side">
                            <div class="inj-weight-tip">
                                <strong>Lectura de báscula</strong>
                                <small>Cuando el valor sea correcto, presiona <b>CAPTURAR</b>.</small>
                            </div>

                            <div class="inj-weight-mini-grid">
                                <div>
                                    <span>MODO</span>
                                    <b id="indicadorModoPeso">BÁSCULA</b>
                                </div>
                                <div>
                                    <span>ESTADO</span>
                                    <b id="indicadorEstadoPeso">LISTO</b>
                                </div>
                            </div>

                            <div class="inj-weight-note">
                                Este es el peso que se enviará al confirmar.
                            </div>
                        </div>
                    </div>
                </article>

                <section class="inj-data">
                    <article><small>SKU</small><input type="text" id="sku" disabled placeholder="—" /></article>
                    <article><small>%</small><input type="text" id="porcentaje" disabled placeholder="—" /></article>
                    <article><small>Velocidad</small><input type="text" id="velocidad" disabled placeholder="—" /></article>
                    <article class="wide"><small>Producto</small><input type="text" id="producto" disabled placeholder="—" /></article>
                    <article><small>Modo</small><input type="text" id="modo" disabled placeholder="—" /></article>
                    <article><small>Presión</small><input type="text" id="presion" disabled placeholder="—" /></article>
                    <article><small>Altura</small><input type="text" id="altura" disabled placeholder="—" /></article>
                    <article><small>Avance</small><input type="text" id="avance" disabled placeholder="—" /></article>
                    <article><small>Tara</small><input type="text" id="tara" disabled placeholder="—" /></article>
                </section>

            </div>

            <!-- APOYO OPERATIVO -->
            <aside class="inj-side">

                <section class="inj-card inj-preview">
                    <div class="inj-section-head">
                        <div>
                            <span>PRODUCTO ACTUAL</span>
                            <strong id="opProductoNombre">Revisa la selección</strong>
                        </div>
                        <i class="inj-ok-dot">●</i>
                    </div>

                    <div class="inj-image">
                        <img id="imagenProducto" src="" alt="Imagen del producto" />
                        <div class="inj-image-empty">Vista del producto</div>
                    </div>
                </section>

                <section class="inj-card inj-recent panel panel-tiempo-real">
                    <div class="inj-section-head">
                        <div>
                            <span>CONTROL DEL TURNO</span>
                            <strong>Últimas capturas</strong>
                        </div>

                        <button class="inj-report-btn"
                                type="button"
                                onclick="abrirModalReportes()">
                            📊 Reportes
                        </button>
                    </div>

                    <div class="tabla-tiempo-real-wrapper inj-table-scroll">
                        <table class="tabla-reporte tabla-tiempo-real">
                            <thead>
                                <tr>
                                    <th>Ref</th>
                                    <th>Hora</th>
                                    <th>Lote</th>
                                    <th>SKU</th>
                                    <th>Producto</th>
                                    <th>Peso</th>
                                    <th>Tara</th>
                                    <th>Modo</th>
                                    <th>Usuario</th>
                                    <th>Autorización</th>
                                </tr>
                            </thead>
                            <tbody id="tbodyDetalladoTiempoReal">
                                <tr>
                                    <td colspan="10">
                                        Seleccione un lote para ver capturas.
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </section>

                <section class="inj-card inj-tools">
                    <div class="inj-tools-title">
                        <span>CONFIGURACIÓN RÁPIDA</span>
                        <small>Solo cuando sea necesario</small>
                    </div>

                    <div class="inj-tools-grid">
                        <button type="button"
                                onclick="abrirModal('modalBascula')">
                            <span>⚖️</span>
                            <b>Báscula</b>
                            <small id="metaBascula">Sin configurar</small>
                        </button>

                        <button type="button"
                                onclick="abrirModal('modalImpresora')">
                            <span>🖨️</span>
                            <b>Impresora</b>
                            <small id="metaImpresora">Sin configurar</small>
                        </button>

                        <button type="button"
                                onclick="reimprimirUltimaCaptura()">
                            <span>🏷️</span>
                            <b>Etiqueta</b>
                            <small>Reimprimir</small>
                        </button>
                    </div>
                </section>

            </aside>
        </section>


        <!-- Overlay + Modales -->
        <div class="overlay" id="overlay"></div>

        <!--Modale Contraseña-->
        <div class="modal modal-Confi" id="modalContra">
            <div class="modal-header">Autenticacion</div>
            <div class="modal-body">
                <div>
                    <label for="Contra">Configuracion</label>
                    <input type="password" id="Password" placeholder="Ingresa la contraseña" />
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn" onclick="cerrarModal('modalContra')">Cancelar</button>
                <button class="btn primary2" onclick="Comparar()">Acceder</button>
            </div>
        </div>

        <!--Modale Bascula-->
        <div class="modal modal-Confi" id="modalBascula">
            <div class="modal-header">Configuración de Báscula</div>
            <div class="modal-body">
                <div>
                    <label for="ipBascula">IP</label>
                    <input type="text" id="ipBascula" placeholder="Ej. 192.168.1.10" />
                </div>
                <div>
                    <label for="comandoBascula">Tipo de Comando</label>
                    <input type="text" id="comandoBascula" placeholder="P" />
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn" onclick="cerrarModal('modalBascula')">Cancelar</button>
                <button class="btn primary2" onclick="guardarBascula()">Guardar</button>
            </div>
        </div>

        <!--Modale Impresora-->
        <div class="modal modal-Confi" id="modalImpresora">
            <div class="modal-header">Configuración de Impresora</div>
            <div class="modal-body">
                <div>
                    <label for="ipImpresora">IP</label>
                    <input type="text" id="ipImpresora" placeholder="Ej. 192.168.1.20" />
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn" onclick="cerrarModal('modalImpresora')">Cancelar</button>
                <button class="btn primary2" onclick="guardarImpresora()">Guardar</button>
            </div>
        </div>

        <!--Modal Producto con Buscador-->
        <div class="modal modal-producto" id="modalProducto">
            <button class="btn-Pr" onclick="cerrarModal('modalProducto')">X</button>
            <div class="modal-header">Selecciona el Producto</div>
            <div class="op-search-bar">
                <input type="text"
                       id="searchProducto"
                       placeholder="Buscar por SKU o nombre de producto"
                       onkeyup="filtrarProductos()" />
                <div id="resultadosBusqueda"></div>
            </div>
            <div class="modal-body">
                <div class="product-grid" id="contenedorProductos"></div>
                <div id="sinResultados" style="display: none; text-align: center; padding: 40px; color: #999;">
                    <div style="margin-top: 10px; font-size: 16px;">No se encontraron productos</div>
                </div>
            </div>
            <div class="modal-footer"></div>
        </div>

        <!-- Modal Tara -->
        <div class="modal modal-tara" id="modalTara">
            <button class="btn-Pr" onclick="cerrarModal('modalTara')">X</button>
            <div class="modal-header">Selecciona la Tara</div>
            <div class="modal-body">
                <div class="tara-help">Selecciona la tara que corresponde al recipiente utilizado.</div>
                <div class="tara-grid" id="contenedorTaras"></div>
            </div>
            <div class="modal-footer"></div>
        </div>

        <!-- Modal Reporte -->
        <div class="modal modal-reporte modal-full" id="modalreporte">
            <button class="btn-Pr" onclick="cerrarModal('modalreporte')">X</button>
            <div class="modal-header">Reporte de Capturas</div>
            <div class="filtros-reporte">
                <label>Lote:<input type="text" id="filtroLote" placeholder="Ej. DEST00001975" /></label>
                <label>Usuario:<input type="text" id="filtroUsuario" placeholder="correo@ejemplo.com" /></label>
                <label>Fecha:<input type="date" id="filtroFecha" /></label>
                <div>
                    <button class="btn primary2" id="btnFiltrar">Filtrar</button>
                    <button class="btn report" id="btnLimpiarFiltros">Limpiar</button>
                </div>
            </div>
            <div class="modal-body">
                <div class="tabla-contenedor">
                    <table class="tabla-reporte">
                        <thead>
                            <tr>
                                <th>Id</th>
                                <th>Lote</th>
                                <th>Producto</th>
                                <th>Programación</th>
                                <th>SKU</th>
                                <th>Porcentaje</th>
                                <th>Velocidad</th>
                                <th>Modo</th>
                                <th>Presión</th>
                                <th>Altura</th>
                                <th>Avance</th>
                                <th>Tara</th>
                                <th>Peso Actual</th>
                                <th>Porcentaje Actual</th>
                                <th>Velocidad Actual</th>
                                <th>Fecha Captura</th>
                                <th>Usuario</th>
                            </tr>
                        </thead>
                        <tbody id="tablaReporteBody"></tbody>
                    </table>
                </div>
            </div>
        </div>

        <div id="modalComparacion" class="modal modal-reporte modal-full ">
            <button class="btn-Pr" onclick="cerrarModal('modalComparacion')">X</button>
            <div class="modal-header">Reporte de Capturas</div>
            <div class="filtros-reporte">
                <label for="fechaComparacion">Fecha:<input type="date" id="fechaComparacion"></label>
                <label for="Capt"><button class="btn primary2" id="Capt" onclick="cargarComparacion()">Consultar</button></label>
            </div>
            <div class="modal-body">
                <table id="tablaComparacion">
                    <thead>
                        <tr><th>Lote</th><th>SKU</th><th>Producto</th><th>Peso Entrada</th><th>Esperado</th><th>Peso Salida</th><th>Diferencia</th></tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>

        <div class="modal modal-Aut" id="modalModoManual">
            <div class="modal-header">Validación Modo Manual</div>
            <div class="modal-body">
                <div>
                    <label for="usuarioIdManual">Usuario ID</label>
                    <input type="number" id="usuarioIdManual" placeholder="Ingresa tu ID de usuario" />
                </div>
                <div style="margin-top: 15px;">
                    <label for="nipManual">NIP</label>
                    <input type="password" id="nipManual" placeholder="Ingresa tu NIP" />
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn" onclick="cerrarModal('modalModoManual')">Cancelar</button>
                <button class="btn primary2" onclick="validarYActivarModoManual()">Validar</button>
            </div>
        </div>

        <div id="modalReportes" class="modal modal-reporte modal-full">
            <button class="btn-Pr"
                    type="button"
                    onclick="cerrarModal('modalReportes')"
                    aria-label="Cerrar">
                X
            </button>

            <div class="modal-header">Reportes de Producción</div>

            <div class="tabs">
                <button class="tab-btn active"
                        type="button"
                        data-tab="rendimiento"
                        onclick="cambiarTab('rendimiento', this)">
                    Rendimiento
                </button>

                <button class="tab-btn"
                        type="button"
                        data-tab="detallado"
                        onclick="cambiarTab('detallado', this)">
                    Detallado
                </button>
            </div>

            <div class="filtros-reportes-top">
                <div class="filtros-reportes-left">

                    <div class="fechas-reportes">
                        <label>
                            <span>Fecha inicio</span>
                            <input type="date" id="repFechaInicio">
                        </label>

                        <label>
                            <span>Fecha fin</span>
                            <input type="date" id="repFechaFin">
                        </label>
                    </div>

                    <div class="acciones-reportes-left">
                        <button type="button"
                                class="btn btn-buscar-reporte"
                                onclick="consultarReporteActivo()">
                            🔎 Buscar
                        </button>
                    </div>

                </div>

                <div class="acciones-reportes-right">
                    <button type="button"
                            class="btn btn-excel-reporte"
                            onclick="exportarReporteExcel()">
                        📊 Exportar a Excel
                    </button>
                </div>
            </div>

            <div class="tab-content active" id="tab-rendimiento">
                <div class="tabla-wrapper reporte-tabla-wrapper">
                    <table class="tabla-reporte reporte-tabla reporte-rendimiento">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Lote</th>
                                <th>SKU</th>
                                <th>Peso Entrada</th>
                                <th>Peso Salida</th>
                                <th>Esperado %</th>
                                <th>Variación</th>
                                <th>Rendimiento %</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyRendimientoModal"></tbody>
                    </table>
                </div>
            </div>

            <div class="tab-content" id="tab-detallado">
                <div class="tabla-wrapper reporte-tabla-wrapper">
                    <table class="tabla-reporte reporte-tabla reporte-detallado">
                        <thead>
                            <tr>
                                <th>Referencia</th>
                                <th>Folio</th>
                                <th>Fecha / Hora</th>
                                <th>Lote</th>
                                <th>SKU</th>
                                <th>Producto</th>
                                <th>Peso</th>
                                <th>Tara</th>
                                <th>Modo</th>
                                <th>Usuario</th>
                                <th>Autorización</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyDetallado"></tbody>
                    </table>
                </div>
            </div>
        </div>

        <div id="toastEntrada" class="toast">
            <div class="toast-icon">✅</div>
            <div class="toast-content">
                <div class="toast-title">Entrada registrada</div>
                <div class="toast-message">ID: <span id="toastEntradaId"></span></div>
            </div>
        </div>

        <div id="toastImpresionError" class="toast toast-error">
            <div class="toast-icon"></div>
            <div class="toast-content">
                <div class="toast-title">Error de impresión</div>
                <div class="toast-message">No se pudo imprimir la etiqueta</div>
                <div class="toast-actions">
                    <button class="toast-btn retry" onclick="reintentarImpresion()">Reimprimir</button>
                    <button class="toast-btn close" onclick="ocultarToastImpresion()">Cerrar</button>
                </div>
            </div>
        </div>

        <div id="loadingOverlay" class="loading-overlay" role="status" aria-live="polite" aria-hidden="true">
            <div class="loading-box"><div class="spinner"></div><div class="loading-text">Cargando información...</div></div>
        </div>

        <div id="modalConfirmarCaptura" class="modal modal-confirm-captura" style="display:none;">
            <div class="confirm-header">
                <div class="confirm-icon">⚠️</div>
                <div>
                    <h4>Confirmar captura</h4>
                    <p>Revisa la información antes de registrar la entrada.</p>
                </div>
            </div>
            <div class="confirm-summary">
                <div class="confirm-item"><span>Lote</span><strong id="confirmLote">—</strong></div>
                <div class="confirm-item"><span>Producto</span><strong id="confirmProducto">—</strong></div>
                <div class="confirm-item"><span>SKU</span><strong id="confirmSku">—</strong></div>
                <div class="confirm-item peso"><span>Peso a capturar</span><strong id="confirmPeso">0.000 kg</strong></div>
                <div class="confirm-item tara"><span>Tara</span><strong id="confirmTara">0.000 kg</strong></div>
            </div>
            <div class="confirm-warning">Esta acción registrará la captura y enviará la impresión correspondiente.</div>
            <div class="confirm-actions">
                <button type="button" class="btn btn-cancelar-confirm" onclick="cerrarConfirmacionCaptura()">Cancelar</button>
                <button type="button" class="btn btn-confirmar-captura" id="btnConfirmarCaptura" onclick="confirmarCapturaEntrada()">Confirmar captura</button>
            </div>
        </div>

    </main>
</div>

<script>
    const correoUsuario = @Html.Raw(Json.Serialize(User.FindFirst("Correo")?.Value));
</script>
<script src="~/js/inyeccion.js" asp-append-version="true"></script>
