        <footer class="modal-footer fc-capture-footer"><span><i class="bi bi-info-circle"></i> Revisa los pesos antes de confirmar la captura.</span><div><button class="tbtn" type="button" onclick="cerrarModal('modalRecorte')">Cancelar</button><button id="btnGuardarRecorte" class="tbtn primary" type="button" onclick="prepararConfirmacionFactor('recorte')"><i class="bi bi-check2-circle"></i> Revisar y confirmar</button></div></footer>
    </div>
</div>

<div id="modalGrasa" role="dialog" aria-modal="true" aria-labelledby="fc-title-grasa" class="modal-overlay fc-capture-overlay" data-factor="grasa">
    <div class="modal-content-sap fc-capture-modal">
        <header class="fc-capture-head">
            <div><span class="fc-eyebrow">CALIDAD · FACTOR CRÍTICO</span><h3 id="fc-title-grasa">Captura de grasa</h3><p>Lote <strong id="lote-Grasa"></strong> <span class="badge-sap" id="badge-prueba-grasa"></span></p></div>
