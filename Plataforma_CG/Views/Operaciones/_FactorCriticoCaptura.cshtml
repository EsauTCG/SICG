        <footer class="modal-footer fc-capture-footer"><span><i class="bi bi-info-circle"></i> Revisa los pesos antes de confirmar la captura.</span><div><button class="tbtn" type="button" onclick="cerrarModal('modalRecorte')">Cancelar</button><button id="btnGuardarRecorte" class="tbtn primary" type="button" onclick="prepararConfirmacionFactor('recorte')"><i class="bi bi-check2-circle"></i> Revisar y confirmar</button></div></footer>
    </div>
</div>

