                </section>

                <aside class="fc-panel fc-preview-panel"><div class="fc-panel-head"><div><span>SELECCIÓN ACTUAL</span><h4 data-selected-name>Ninguna receta seleccionada</h4></div></div><div class="fc-preview-image"><img data-selected-image src="/images/Recorte-80-20.png" alt="Recorte seleccionado" /></div><dl class="fc-selection-data"><div><dt>Objetivo</dt><dd data-selected-objective>—</dd></div><div><dt>Entrada</dt><dd data-current-entry>0.000 kg</dd></div><div><dt>Salida</dt><dd data-current-exit>0.000 kg</dd></div></dl></aside>
