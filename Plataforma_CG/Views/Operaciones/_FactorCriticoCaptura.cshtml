@* Interfaz de captura solamente. Conserva los IDs consumidos por el guardado actual de Factor Crítico. *@

<div id="modalHueso" role="dialog" aria-modal="true" aria-labelledby="fc-title-hueso" class="modal-overlay fc-capture-overlay" data-factor="hueso">
    <div class="modal-content-sap fc-capture-modal">
        <header class="fc-capture-head">
            <div>
                <span class="fc-eyebrow">CALIDAD · FACTOR CRÍTICO</span>
                <h3 id="fc-title-hueso">Captura de hueso</h3>
                <p>Lote <strong id="lote-hueso"></strong> <span class="badge-sap" id="badge-prueba-hueso"></span></p>
            </div>
            <button class="fc-icon-button" type="button" onclick="cerrarModal('modalHueso')" aria-label="Cerrar"><i class="bi bi-x-lg"></i></button>
        </header>

        <div class="fc-stepper" aria-label="Flujo de captura">
            <span class="done"><b>1</b> Lote</span><i>→</i><span class="active"><b>2</b> Selección</span><i>→</i><span><b>3</b> Peso</span><i>→</i><span><b>4</b> Confirmar</span>
        </div>

        <div class="modal-body-scroll fc-capture-body">
            <nav class="fc-factor-switch" aria-label="Cambiar factor">
                <button class="active" type="button"><img src="/images/Hueso.png" alt="" /><span>Hueso</span></button>
                <button type="button" onclick="cambiarFactorCaptura('recorte')"><img src="/images/Recorte-80-20.png" alt="" /><span>Recorte</span></button>
                <button type="button" onclick="cambiarFactorCaptura('grasa')"><img src="/images/Rib con Grasa.jpeg" alt="" /><span>Grasa</span></button>
            </nav>

            <div class="fc-workstation">
                <section class="fc-panel fc-catalog-panel">
                    <div class="fc-panel-head"><div><span>PASO 2</span><h4>¿Qué hueso vas a pesar?</h4></div><small>Selecciona una tarjeta</small></div>
                    <div id="catalogoHueso" class="fc-item-grid"><div class="fc-catalog-loading">Cargando tipos de hueso…</div></div>
                </section>

                <section class="fc-panel fc-scale-panel">
                    <div class="fc-panel-head">
                        <div><span>PASO 3</span><h4>Lectura de peso</h4></div>
                        <button class="fc-mode-button" type="button" data-scale-mode onclick="alternarModoPesoFactor('hueso')">Manual</button>
                    </div>
                    <div class="fc-weight-target" role="group" aria-label="Tipo de peso">
                        <button class="active" type="button" data-weight-target="entrada" onclick="seleccionarTipoPesoFactor('hueso','entrada')"><span>Entrada</span><strong data-current-entry>0.000 kg</strong></button>
                        <button type="button" data-weight-target="salida" onclick="seleccionarTipoPesoFactor('hueso','salida')"><span>Salida</span><strong data-current-exit>0.000 kg</strong></button>
                    </div>
                    <div class="fc-scale-shell">
                        <div class="fc-scale-handle"></div>
                        <div class="fc-scale-screen"><div class="fc-scale-value" data-scale-value>0.000</div><span>kg</span></div>
                        <input class="fc-manual-input" data-manual-weight aria-label="Peso manual en kilogramos" type="number" min="0" step="0.001" inputmode="decimal" placeholder="0.000" oninput="actualizarPesoManualFactor('hueso', this.value)" />
                        <div class="fc-scale-feet"><i></i><i></i></div>
                    </div>
                    <div class="fc-scale-status"><span><i></i><b data-scale-status>Modo manual</b></span><button type="button" onclick="abrirConfiguracionBasculaFactor()"><i class="bi bi-gear"></i> Configurar báscula</button></div>
                    <button class="fc-use-weight" type="button" data-apply-weight onclick="aplicarPesoFactor('hueso')"><i class="bi bi-arrow-down-circle"></i> Usar este peso</button>
                    <p class="fc-scale-help" role="status" data-scale-help>Selecciona primero un tipo de hueso.</p>
                </section>

                <aside class="fc-panel fc-preview-panel">
                    <div class="fc-panel-head"><div><span>SELECCIÓN ACTUAL</span><h4 data-selected-name>Ningún hueso seleccionado</h4></div></div>
                    <div class="fc-preview-image"><img data-selected-image src="/images/Hueso.png" alt="Hueso seleccionado" /></div>
                    <dl class="fc-selection-data"><div><dt>Objetivo</dt><dd data-selected-objective>—</dd></div><div><dt>Entrada</dt><dd data-current-entry>0.000 kg</dd></div><div><dt>Salida</dt><dd data-current-exit>0.000 kg</dd></div></dl>
                </aside>
            </div>

            <details class="fc-summary" open>
                <summary><span><i class="bi bi-list-check"></i> Resumen de huesos</span><small>Desliza la tabla para ver todos los pesos</small></summary>
                <div class="fc-summary-scroll" tabindex="0" role="region" aria-label="Resumen de pesos"><table class="sap-table fc-summary-table"><thead><tr><th>Hueso</th><th>% Obj.</th><th>% Part.</th><th>% Dif.</th><th>Entrada</th><th>Salida</th><th></th></tr></thead><tbody id="tabla-hueso"></tbody></table></div>
            </details>
        </div>

        <footer class="modal-footer fc-capture-footer">
            <span><i class="bi bi-info-circle"></i> Revisa los pesos antes de confirmar la captura.</span>
            <div><button class="tbtn" type="button" onclick="cerrarModal('modalHueso')">Cancelar</button><button id="btnGuardarTodosHueso" class="tbtn primary" type="button" onclick="prepararConfirmacionFactor('hueso')"><i class="bi bi-check2-circle"></i> Revisar y confirmar</button></div>
        </footer>
    </div>
</div>

<div id="modalRecorte" role="dialog" aria-modal="true" aria-labelledby="fc-title-recorte" class="modal-overlay fc-capture-overlay" data-factor="recorte">
