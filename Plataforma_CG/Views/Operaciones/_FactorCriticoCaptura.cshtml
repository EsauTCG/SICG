                    <div class="fc-scale-shell"><div class="fc-scale-handle"></div><div class="fc-scale-screen"><div class="fc-scale-value" data-scale-value>0.00</div><span>kg</span></div><input class="fc-manual-input" data-manual-weight aria-label="Peso manual en kilogramos" type="number" min="0" step="0.001" inputmode="decimal" placeholder="0.000" oninput="actualizarPesoManualFactor('recorte', this.value)" /><div class="fc-scale-feet"><i></i><i></i></div></div>
                    <div class="fc-scale-status"><span><i></i><b data-scale-status>Modo automático</b></span><button type="button" onclick="abrirConfiguracionBasculaFactor()"><i class="bi bi-gear"></i> Configurar báscula</button></div>
