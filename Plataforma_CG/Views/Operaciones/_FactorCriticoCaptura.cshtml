                    <div class="fc-scale-shell"><div class="fc-scale-handle"></div><div class="fc-scale-screen"><div class="fc-scale-value" data-scale-value>0.000</div><span>kg</span></div><input class="fc-manual-input" data-manual-weight aria-label="Peso manual en kilogramos" type="number" min="0" step="0.001" inputmode="decimal" placeholder="0.000" oninput="actualizarPesoManualFactor('recorte', this.value)" /><div class="fc-scale-feet"><i></i><i></i></div></div>
                    <div class="fc-scale-status"><span><i></i><b data-scale-status>Modo manual</b></span><button type="button" onclick="abrirConfiguracionBasculaFactor()"><i class="bi bi-gear"></i> Configurar báscula</button></div>
                    <button class="fc-use-weight" type="button" data-apply-weight onclick="aplicarPesoFactor('recorte')"><i class="bi bi-arrow-down-circle"></i> Usar este peso</button>
                    <p class="fc-scale-help" role="status" data-scale-help>Selecciona primero una receta.</p>
                </section>

                <aside class="fc-panel fc-preview-panel"><div class="fc-panel-head"><div><span>SELECCIÓN ACTUAL</span><h4 data-selected-name>Ninguna receta seleccionada</h4></div></div><div class="fc-preview-image"><img data-selected-image src="/images/Recorte-80-20.png" alt="Recorte seleccionado" /></div><dl class="fc-selection-data"><div><dt>Objetivo</dt><dd data-selected-objective>—</dd></div><div><dt>Entrada</dt><dd data-current-entry>0.000 kg</dd></div><div><dt>Salida</dt><dd data-current-exit>0.000 kg</dd></div></dl></aside>
            </div>

            <details class="fc-summary" open><summary><span><i class="bi bi-list-check"></i> Resumen de recorte</span><small>Desliza la tabla para ver todos los pesos</small></summary><div class="fc-summary-scroll" tabindex="0" role="region" aria-label="Resumen de pesos"><table class="sap-table fc-summary-table"><thead><tr><th>Receta</th><th>% Obj.</th><th>% Part.</th><th>% Dif.</th><th>Entrada</th><th>Salida</th></tr></thead><tbody id="tabla-Recorte"></tbody></table></div></details>
