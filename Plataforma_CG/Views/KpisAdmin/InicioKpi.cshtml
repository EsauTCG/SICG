@model IEnumerable<Plataforma_CG.Models.KpiCatalogo>
@using System.Linq

@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Administrar KPIs";

    var kpis = Model?.ToList() ?? Enumerable.Empty<Plataforma_CG.Models.KpiCatalogo>().ToList();
    var totalKpis = kpis.Count;
    var activos = kpis.Count(x => x.Activo);
    var inactivos = totalKpis - activos;
}

@await Html.PartialAsync("_KpiAdminTheme")

<div class="container-fluid py-4 px-3 px-md-4 container-custom">

    <div class="top-banner d-flex justify-content-between align-items-center flex-wrap gap-3 shadow-sm">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-graph-up-arrow me-2"></i> Administración de KPIs
            </h2>
            <p class="mb-0" style="font-size: 0.85rem; opacity: 0.85;">
                Controla el catálogo de indicadores, imágenes, categorías, enlaces Power BI y estado de publicación.
            </p>
        </div>
        <div>
            <a class="btn btn-sm btn-outline-light fw-bold px-3 border-2" href="@Url.Action("Inicio", "Home")">
                <i class="bi bi-door-closed me-1"></i> Salir al Inicio
            </a>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-3 mb-4">

        <div class="action-group shadow-sm">
            <div class="action-label">
                <i class="bi bi-speedometer2 me-1"></i> Catálogo
            </div>
            <div class="d-flex gap-2">
                <a class="btn-rojo" href="@Url.Action("Crear", "KpisAdmin")">
                    <i class="bi bi-plus-circle"></i> Nuevo KPI
                </a>
                <button type="button" class="btn-rojo" onclick="location.reload()">
                    <i class="bi bi-arrow-clockwise"></i> Refrescar
                </button>
            </div>
        </div>

        <div class="action-group shadow-sm">
            <div class="action-label">
                <i class="bi bi-shield-check me-1"></i> Seguridad
            </div>
            <div class="d-flex gap-2">
                <a class="btn-rojo" href="@Url.Action("KpisPermisosConfiguracion", "KpisPermisos")">
                    <i class="bi bi-arrow-right-square"></i> Autorizar KPIs
                </a>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <div class="stat-card">
                <div class="stat-label">Total</div>
                <div class="stat-value">@totalKpis</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Activos</div>
                <div class="stat-value">@activos</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Inactivos</div>
                <div class="stat-value">@inactivos</div>
            </div>
        </div>

    </div>

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success">
            <i class="bi bi-check-circle me-2"></i>@TempData["Exito"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
        </div>
    }

    <div class="dashboard-panel">
        <div class="dashboard-panel-head">
            <div>
                <h6 class="dashboard-panel-title">
                    <i class="bi bi-table me-1"></i> KPIs registrados
                </h6>
                <p class="dashboard-panel-subtitle">
                    Consulta, edita o elimina los indicadores disponibles para los usuarios.
                </p>
            </div>

            <div style="min-width: 260px;">
                <input type="text"
                       id="buscarKpi"
                       class="form-control form-control-sm"
                       placeholder="Buscar por título o categoría..." />
            </div>
        </div>

        <div class="p-3">
            <div class="table-responsive border rounded" style="max-height: 70vh; overflow: auto;">
                <table class="table table-custom table-hover align-middle mb-0" id="tablaKpis">
                    <thead>
                        <tr>
                            <th style="width: 90px;">Imagen</th>
                            <th>Título</th>
                            <th>Categoría</th>
                            <th style="width: 130px;">Estado</th>
                            <th style="width: 230px;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!kpis.Any())
                        {
                            <tr>
                                <td colspan="5">
                                    <div class="empty-state">
                                        <i class="bi bi-inbox"></i>
                                        <span class="fw-bold">No hay KPIs registrados todavía.</span><br />
                                        <small>Usa el botón “Nuevo KPI” para comenzar.</small>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var k in kpis)
                            {
                                var img = string.IsNullOrWhiteSpace(k.ImagenUrl)
                                ? "/img/kpi/kpi-default.png"
                                : k.ImagenUrl;

                                <tr>
                                    <td>
                                        <img src="@img" class="kpi-thumb" alt="Imagen KPI" />
                                    </td>

                                    <td>
                                        <div class="fw-bold text-dark">@k.Titulo</div>
                                        @if (!string.IsNullOrWhiteSpace(k.Descripcion))
                                        {
                                            <small class="text-muted d-block text-truncate" style="max-width: 420px;">
                                                @k.Descripcion
                                            </small>
                                        }
                                    </td>

                                    <td>
                                        <span class="badge bg-secondary rounded-pill">@k.Categoria</span>
                                    </td>

                                    <td>
                                        @if (k.Activo)
                                        {
                                            <span class="status-pill on">
                                                <i class="bi bi-check-circle-fill"></i> Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-pill off">
                                                <i class="bi bi-x-circle-fill"></i> Inactivo
                                            </span>
                                        }
                                    </td>

                                    <td class="text-nowrap">
                                        <a class="btn btn-sm btn-outline-primary fw-bold me-1"
                                           href="@Url.Action("Editar", "KpisAdmin", new { id = k.Id })">
                                            <i class="bi bi-pencil-square"></i> Editar
                                        </a>

                                        <form method="post"
                                              asp-action="Eliminar"
                                              class="d-inline"
                                              onsubmit="return confirm('¿Seguro que deseas eliminar este KPI?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@k.Id" />
                                            <button class="btn btn-sm btn-outline-danger fw-bold">
                                                <i class="bi bi-trash"></i> Eliminar
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

    <script>
        const buscarKpi = document.getElementById("buscarKpi");

        if (buscarKpi) {
            buscarKpi.addEventListener("input", function () {
                const texto = this.value.toLowerCase().trim();

                document.querySelectorAll("#tablaKpis tbody tr").forEach(row => {
                    const contenido = row.textContent.toLowerCase();
                    row.style.display = contenido.includes(texto) ? "" : "none";
                });
            });
        }
    </script>
}