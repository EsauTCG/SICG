@model Plataforma_CG.Models.ViewModels.KpiCatalogoFormVM

@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Editar KPI";

    var preview = string.IsNullOrWhiteSpace(Model.ImagenUrlActual)
        ? "/img/kpi/kpi-default.png"
        : Model.ImagenUrlActual;
}

@await Html.PartialAsync("_KpiAdminTheme")

<div class="container-fluid py-4 px-3 px-md-4 container-custom form-width">

    <div class="top-banner d-flex justify-content-between align-items-center flex-wrap gap-3 shadow-sm">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-pencil-square me-2"></i> Editar KPI
            </h2>
            <p class="mb-0" style="font-size: 0.85rem; opacity: 0.85;">
                Actualiza la información del indicador, reemplaza su imagen o cambia su estado de publicación.
            </p>
        </div>
        <div>
            <a class="btn btn-sm btn-outline-light fw-bold px-3 border-2" href="@Url.Action("InicioKpi", "KpisAdmin")">
                <i class="bi bi-arrow-left-circle me-1"></i> Volver
            </a>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
        </div>
    }

    <div class="dashboard-panel mb-4">
        <div class="dashboard-panel-head">
            <div>
                <h6 class="dashboard-panel-title">
                    <i class="bi bi-card-image me-1"></i> Imagen actual
                </h6>
                <p class="dashboard-panel-subtitle">
                    Vista previa de la imagen que se está usando actualmente para este KPI.
                </p>
            </div>
        </div>

        <div class="p-3 p-md-4">
            <div class="filter-panel d-flex gap-3 flex-wrap align-items-center">
                <img src="@preview" class="kpi-preview" alt="Imagen actual del KPI" />

                <div class="flex-grow-1">
                    <div class="fw-bold text-dark mb-1">Ruta actual:</div>

                    @if (string.IsNullOrWhiteSpace(Model.ImagenUrlActual))
                    {
                        <code>(sin imagen personalizada)</code>
                    }
                    else
                    {
                        <code>@Model.ImagenUrlActual</code>
                    }

                    <div class="text-muted small mt-2">
                        Puedes reemplazarla cargando una nueva imagen o marcar la opción para quitarla.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="dashboard-panel">
        <div class="dashboard-panel-head">
            <div>
                <h6 class="dashboard-panel-title">
                    <i class="bi bi-pencil-square me-1"></i> Datos del KPI
                </h6>
                <p class="dashboard-panel-subtitle">
                    Modifica únicamente los campos necesarios y guarda los cambios.
                </p>
            </div>
        </div>

        <div class="p-3 p-md-4">
            <form method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ImagenUrlActual" />

                <div class="filter-panel mb-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-muted small">TÍTULO</label>
                            <input class="form-control" asp-for="Titulo" />
                            <span class="text-danger" asp-validation-for="Titulo"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold text-muted small">CATEGORÍA</label>
                            <input class="form-control" asp-for="Categoria" />
                            <span class="text-danger" asp-validation-for="Categoria"></span>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold text-muted small">DESCRIPCIÓN</label>
                            <textarea class="form-control" rows="4" asp-for="Descripcion"></textarea>
                            <span class="text-danger" asp-validation-for="Descripcion"></span>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold text-muted small">EMBED URL POWER BI</label>
                            <input class="form-control" asp-for="EmbedUrl" />
                            <span class="text-danger" asp-validation-for="EmbedUrl"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold text-muted small">REEMPLAZAR IMAGEN</label>
                            <input class="form-control" asp-for="Imagen" type="file" accept="image/*" />
                            <div class="text-muted small mt-1">
                                Este campo es opcional.
                            </div>
                        </div>

                        <div class="col-md-6 d-flex align-items-end">
                            <div class="d-flex gap-4 flex-wrap">
                                <div class="form-check">
                                    <input class="form-check-input" asp-for="Activo" />
                                    <label class="form-check-label fw-bold text-dark" asp-for="Activo">
                                        Activo
                                    </label>
                                </div>

                                <div class="form-check">
                                    <input class="form-check-input" asp-for="QuitarImagen" />
                                    <label class="form-check-label fw-bold text-dark" asp-for="QuitarImagen">
                                        Quitar imagen
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 flex-wrap">
                    <a class="btn btn-outline-secondary fw-bold" href="@Url.Action("InicioKpi", "KpisAdmin")">
                        <i class="bi bi-x-circle me-1"></i> Cancelar
                    </a>

                    <button class="btn btn-brand fw-bold px-4">
                        <i class="bi bi-save me-1"></i> Guardar cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <partial name="_ValidationScriptsPartial" />
}