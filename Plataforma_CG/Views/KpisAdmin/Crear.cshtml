@model Plataforma_CG.Models.ViewModels.KpiCatalogoFormVM

@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Crear KPI";
}

@await Html.PartialAsync("_KpiAdminTheme")

<div class="container-fluid py-4 px-3 px-md-4 container-custom form-width">

    <div class="top-banner d-flex justify-content-between align-items-center flex-wrap gap-3 shadow-sm">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-plus-circle me-2"></i> Crear KPI
            </h2>
            <p class="mb-0" style="font-size: 0.85rem; opacity: 0.85;">
                Registra un nuevo indicador en el catálogo, agrega su imagen y enlaza su reporte Power BI.
            </p>
        </div>
        <div>
            <a class="btn btn-sm btn-outline-light fw-bold px-3 border-2" href="@Url.Action("InicioKpi", "KpisAdmin")">
                <i class="bi bi-arrow-left-circle me-1"></i> Volver
            </a>
        </div>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
        </div>
    }

    <div class="dashboard-panel">
        <div class="dashboard-panel-head">
            <div>
                <h6 class="dashboard-panel-title">
                    <i class="bi bi-pencil-square me-1"></i> Datos del KPI
                </h6>
                <p class="dashboard-panel-subtitle">
                    Completa la información principal para mostrar el KPI en el portal.
                </p>
            </div>
        </div>

        <div class="p-3 p-md-4">
            <form method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div class="filter-panel mb-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold text-muted small">TÍTULO</label>
                            <input class="form-control" asp-for="Titulo" placeholder="Ej. Ventas mensuales" />
                            <span class="text-danger" asp-validation-for="Titulo"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold text-muted small">CATEGORÍA</label>
                            <select class="form-select" asp-for="Categoria">
                                <option value="">-- Selecciona una categoría --</option>
                                <option value="Ventas">Ventas</option>
                                <option value="Compras">Compras</option>
                                <option value="Producción">Producción</option>
                                <option value="Sacrificio">Sacrificio</option>
                                <option value="Inventarios">Inventarios</option>
                            </select>
                            <span class="text-danger" asp-validation-for="Categoria"></span>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold text-muted small">DESCRIPCIÓN</label>
                            <textarea class="form-control" rows="4" asp-for="Descripcion" placeholder="Describe brevemente qué muestra este indicador..."></textarea>
                            <span class="text-danger" asp-validation-for="Descripcion"></span>
                        </div>

                        <div class="col-12">
                            <label class="form-label fw-bold text-muted small">EMBED URL POWER BI</label>
                            <input class="form-control" asp-for="EmbedUrl" placeholder="Pega aquí el link del reporte..." />
                            <span class="text-danger" asp-validation-for="EmbedUrl"></span>
                            <div class="text-muted small mt-1">
                                Pega el enlace de inserción o acceso del reporte.
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold text-muted small">IMAGEN OPCIONAL</label>
                            <input class="form-control" asp-for="Imagen" type="file" accept="image/*" />
                            <div class="text-muted small mt-1">
                                Se guarda en <code>wwwroot/img/kpi</code>.
                            </div>
                        </div>

                        <div class="col-md-6 d-flex align-items-end">
                            <div class="form-check">
                                <input class="form-check-input" asp-for="Activo" />
                                <label class="form-check-label fw-bold text-dark" asp-for="Activo">
                                    Publicar como activo
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 flex-wrap">
                    <a class="btn btn-outline-secondary fw-bold" href="@Url.Action("InicioKpi", "KpisAdmin")">
                        <i class="bi bi-x-circle me-1"></i> Cancelar
                    </a>

                    <button class="btn btn-brand fw-bold px-4">
                        <i class="bi bi-save me-1"></i> Guardar KPI
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <partial name="_ValidationScriptsPartial" />
}