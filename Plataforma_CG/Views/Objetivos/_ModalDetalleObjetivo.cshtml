@model Plataforma_CG.Models.ObjetivoViewModel

<div class="modal-header text-white" style="background: linear-gradient(180deg,#b30000 0%,#8b0000 100%);">
    <h5 class="modal-title fw-bold" id="tituloModal-@Model.ID">
        Detalles del Objetivo #@Model.ID
    </h5>
    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
</div>

<div class="modal-body p-4" style="max-height: 70vh; overflow-y: auto;">
    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <div class="card h-100 shadow-sm border">
                <div class="card-body p-3">
                    <h6 class="text-danger fw-bold border-bottom pb-2 mb-3">Información General</h6>
                    <p class="mb-1"><small class="text-muted fw-bold">Área:</small> <span class="badge bg-secondary">@Model.NombrePerfil</span></p>
                    <p class="mb-1"><small class="text-muted fw-bold">Tipo Objetivo:</small> <span class="fw-bold">@Model.NombreTipoObjetivo</span></p>
                    <p class="mb-1">
                        <small class="text-muted fw-bold">Estado:</small>
                        @if (Model.Estado == "Activo")
                        {
                            <span class="badge bg-success">@Model.Estado</span>
                        }
                        else if (Model.Estado == "Pendiente")
                        {
                            <span class="badge bg-warning text-dark">@Model.Estado</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@Model.Estado</span>
                        }
                    </p>
                    <p class="mb-0"><small class="text-muted fw-bold">Creado el:</small> <span>@Model.Fecha_Creacion.ToString("dd/MM/yyyy HH:mm")</span></p>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card h-100 shadow-sm border">
                <div class="card-body p-3">
                    <h6 class="text-danger fw-bold border-bottom pb-2 mb-3">Vigencia y Frecuencia</h6>
                    <p class="mb-1"><small class="text-muted fw-bold">Evaluación:</small> <span>@Model.Tipo_Periodo_Cumplimiento</span></p>
                    <p class="mb-1"><small class="text-muted fw-bold">Inicio:</small> <span>@Model.Fecha_Desde.ToString("dd/MMM/yyyy")</span></p>
                    <p class="mb-0"><small class="text-muted fw-bold">Fin:</small> <span>@(Model.Fecha_Hasta?.ToString("dd/MMM/yyyy") ?? "Sin límite")</span></p>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border mb-3">
        <div class="card-body p-3">
            <h6 class="text-danger fw-bold border-bottom pb-2 mb-3">Detalles Operativos y Comerciales</h6>
            <div class="row g-3">
                <div class="col-md-4">
                    <small class="text-muted fw-bold d-block">Cliente:</small>
                    <span>@(string.IsNullOrEmpty(Model.ID_Cliente) ? "No especificado" : Model.ID_Cliente)</span>
                </div>
                <div class="col-md-4">
                    <small class="text-muted fw-bold d-block">Vendedor:</small>
                    @if (!string.IsNullOrEmpty(Model.NombreVendedor))
                    {
                        <span>@Model.NombreVendedor</span>
                        @if (!string.IsNullOrEmpty(Model.UsuarioVendedor))
                        {
                            <small class="text-muted d-block">Usuario: @Model.UsuarioVendedor</small>
                            <small class="text-muted d-block">ID: @Model.UsuarioID_Vendedor</small>
                        }
                    }
                    else
                    {
                        <span>No especificado</span>
                    }
                </div>
                <div class="col-md-4">
                    <small class="text-muted fw-bold d-block">Proveedor:</small>
                    <span>@(string.IsNullOrEmpty(Model.Proveedor) ? "No especificado" : Model.Proveedor)</span>
                </div>

                <div class="col-md-4">
                    <small class="text-muted fw-bold d-block">SKU:</small>
                    @if (!string.IsNullOrEmpty(Model.SKU))
                    {
                        <span class="fw-bold">
                            @Model.SKU
                            @if (!string.IsNullOrEmpty(Model.NombreArticulo))
                            {
                                <text> - @Model.NombreArticulo</text>
                            }
                        </span>
                    }
                    else
                    {
                        <span>No especificado</span>
                    }
                </div>
                <div class="col-md-4">
                    <small class="text-muted fw-bold d-block">Línea:</small>
                    <span>@(string.IsNullOrEmpty(Model.Linea) ? "No especificado" : Model.Linea)</span>
                </div>
                <div class="col-md-4">
                    <small class="text-muted fw-bold d-block">Cuenta Contable:</small>
                    <span>@(string.IsNullOrEmpty(Model.CC) ? "No especificado" : Model.CC)</span>
                </div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.Descripcion_Objetivo))
    {
        <div class="card shadow-sm border mb-3">
            <div class="card-body p-3">
                <h6 class="text-danger fw-bold border-bottom pb-2 mb-2">Descripción / Notas</h6>
                <p class="mb-0" style="font-size: 0.9rem;">@Model.Descripcion_Objetivo</p>
            </div>
        </div>
    }

    <div class="card shadow-sm border">
        <div class="card-body p-3">
            <h6 class="text-danger fw-bold border-bottom pb-2 mb-3">Metas Configuradas</h6>
            <div class="table-responsive">
                <table class="table table-sm table-bordered mb-0 text-center">
                    <thead class="table-secondary">
                        <tr>
                            <th>¿Qué se mide?</th>
                            <th>Unidad</th>
                            <th>Mínimo</th>
                            <th>Máximo</th>
                            <th>Objetivo</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.ValoresConfigurados != null && Model.ValoresConfigurados.Any())
                        {
                            foreach (var val in Model.ValoresConfigurados)
                            {
                                <tr>
                                    <td class="align-middle text-start ps-3">@val.Tipo_Valor</td>
                                    <td class="align-middle">@val.Unidad_Medida</td>
                                    <td class="align-middle text-muted">@(val.Valor_Minimo?.ToString("0.00") ?? "-")</td>
                                    <td class="align-middle text-muted">@(val.Valor_Maximo?.ToString("0.00") ?? "-")</td>
                                    <td class="align-middle fw-bold fs-6 text-danger">@(val.Valor_Objetivo?.ToString("0.00") ?? "-")</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="5" class="text-muted py-3">No hay metas configuradas.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal-footer border-top-0">
    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>

    @if (ViewBag.PuedeEliminarObjetivos == true)
    {
        <button type="button" class="btn btn-warning text-dark fw-bold shadow-sm" onclick="cargarEditarObjetivo(@Model.ID)">
            <i class="bi bi-pencil-square me-1"></i> Editar
        </button>

        @if (Model.Estado == "Pendiente")
        {
            <form asp-action="Autorizar" asp-controller="Objetivos" method="post" class="d-inline" onsubmit="return confirm('¿Estás seguro de autorizar este objetivo?');">
                <input type="hidden" name="id" value="@Model.ID" />
                <button type="submit" class="btn btn-success fw-bold shadow-sm">
                    <i class="bi bi-check-circle me-1"></i> Autorizar
                </button>
            </form>
        }

        <form asp-action="Cancelar" asp-controller="Objetivos" method="post" class="d-inline" onsubmit="return confirm('¿Estás seguro de cancelar este objetivo?');">
            <input type="hidden" name="id" value="@Model.ID" />
            <button type="submit" class="btn btn-danger fw-bold shadow-sm">
                <i class="bi bi-x-circle me-1"></i> Cancelar
            </button>
        </form>
    }
</div>