@model Plataforma_CG.Models.ObjetivoViewModel

@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Nuevo Objetivo";

    // Obtenemos los datos de sesion para filtrar la vista
    bool esAdmin = User.IsInRole("Administrador") || User.IsInRole("Sistemas");
    string miPerfilId = User.FindFirst("PerfilId")?.Value;
}

<style>
    :root {
        --brand-main: #8b0000;
        --bg-page: #e9edf2;
    }

    body, main {
        padding: 0 !important;
        margin: 0 !important;
    }

    .container-fluid{
        padding-left: 0 !important;
        padding-right: 0 !important;
    }

    .top-banner {
        background: linear-gradient(180deg, #b30000 0%, #8b0000 100%) !important;
        color: white;
        padding: 1.5rem 2rem;
        box-shadow: 0 4px 12px rgba(0,0,0,.15);
    }

    .section-title {
         background: linear-gradient(180deg,#b30000 0%,#8b0000 100%);
        color: #fff;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        padding: 0.55rem 0.85rem;
        border-radius: 0.375rem;
        margin-bottom: 1rem;
    }

        #formNuevoObjetivo .form-control,
    #formNuevoObjetivo .form-select {
        box-shadow: 0 .125rem .25rem rgba(0,0,0,.075);
    }

    #formNuevoObjetivo .form-label {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        color: #6c757d;

    }
