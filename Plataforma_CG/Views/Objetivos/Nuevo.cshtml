@model Plataforma_CG.Models.ObjetivoViewModel

@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Nuevo Objetivo";

    // Obtenemos los datos de sesion para filtrar la vista
    bool esAdmin = User.IsInRole("Administrador") || User.IsInRole("Sistemas");
    string miPerfilId = User.FindFirst("PerfilId")?.Value;
}

<style>
    :root {
        --brand-main: #8b0000;
        --bg-page: #e9edf2;
    }

    body, main {
        padding: 0 !important;
        margin: 0 !important;
    }

    .container-fluid{
        padding-left: 0 !important;
        padding-right: 0 !important;
    }

    .top-banner {
        background: linear-gradient(180deg, #b30000 0%, #8b0000 100%) !important;
        color: white;
        padding: 1.5rem 2rem;
        box-shadow: 0 4px 12px rgba(0,0,0,.15);
    }

    .section-title {
         background: linear-gradient(180deg,#b30000 0%,#8b0000 100%);
        color: #fff;
        font-size: 0.75rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        padding: 0.55rem 0.85rem;
        border-radius: 0.375rem;
        margin-bottom: 1rem;
    }

        #formNuevoObjetivo .form-control,
    #formNuevoObjetivo .form-select {
        box-shadow: 0 .125rem .25rem rgba(0,0,0,.075);
    }

    #formNuevoObjetivo .form-label {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.5px;
        text-transform: uppercase;
        color: #6c757d;

    }

    /* Acordeon y controles del modal Configurar Tipos en rojo corporativo */
    #accordionTipos .accordion-button:not(.collapsed) {
        background-color: #fdecec;
        color: #8b0000;
        box-shadow: inset 0 -1px 0 rgba(0,0,0,.125);
    }

        #accordionTipos .accordion-button:not(.collapsed)::after {
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16' fill='%238b0000'%3e%3cpath fill-rule='evenodd' d='M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708z'/%3e%3c/svg%3e");
        }

    #accordionTipos .accordion-button:focus,
    #accordionTipos .form-check-input:focus,
    #buscarTipoConfig:focus {
        border-color: #b30000;
        box-shadow: 0 0 0 .2rem rgba(139,0,0,.25);
    }

    #accordionTipos .form-check-input:checked {
        background-color: #8b0000;
        border-color: #8b0000;
    }

        #accordionTipos .form-check-input:checked[type="checkbox"]:disabled {
            background-color: #8b0000;
            border-color: #8b0000;
        }

    #accordionTipos .form-switch .form-check-input:focus:not(:checked) {
        background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='-4 -4 8 8'%3e%3ccircle r='3' fill='%23b30000'/%3e%3c/svg%3e");
    }

    /* Modal de SKU por encima del modal de configuracion de tipos (modales apilados) */
    #modalSkuObjetivo { z-index: 1085; }
</style>

<div class="container-fluid p-0">
    <!-- Banner Superior -->
    <div class="top-banner d-flex justify-content-between align-items-center">
        <div>
            <h3 class="fw-bold mb-1"><i class="bi bi-plus-circle-dotted me-2"></i>Crear Nuevo Objetivo</h3>
            <p class="mb-0" style="opacity: 0.9; font-size: 0.85rem;">Configura las metas y métricas esperadas para un área.</p>
        </div>
        <div>
            <a href="@Url.Action("Tablero", "Objetivos")" class="btn btn-outline-light fw-bold shadow-sm">
                <i class="bi bi-arrow-left me-1"></i> Volver al Tablero
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm mx-3 mt-3 mb-4" style="border-radius: 0.375rem;">
        <div class="card-body p-3 p-md-4">

        

    <!-- Formulario -->
    <form asp-action="GuardarNuevo" asp-controller="Objetivos" method="post" id="formNuevoObjetivo">
        <div asp-validation-summary="All" class="alert alert-danger py-2" style="font-size: 0.85rem;"></div>

        <div class="section-title d-flex justify-content-between align-items-center">
            <span><i class="bi bi-clipboard-data me-1"></i>Datos del objetivo</span>

                    @if (ViewBag.PuedeEliminarObjetivos == true)
                    {
                        <div class="d-flex gap-2">
                            <button type="button"
                                    class="btn btn-sm btn-outline-light shadow-sm"
                                    data-bs-toggle="modal"
                                    data-bs-target="#modalConfigTipos"
                                    style="font-size: 0.70rem; padding: 0.1rem 0.5rem;">
                                <i class="bi bi-gear"></i> Configurar Tipos
                            </button>
                            <button type="button"
                                    class="btn btn-sm btn-outline-light shadow-sm"
                                    data-bs-toggle="modal"
                                    data-bs-target="#modalNuevoKpi"
                                    style="font-size: 0.70rem; padding: 0.1rem 0.5rem;">
                                <i class="bi bi-plus-lg"></i> Crear Nuevo Tipo de Objetivo
                            </button>
                        </div>
                    }
        </div>

        <div class="row g-3">

            <!-- PERFIL (Filtrado por Rol) -->
            <div class="col-md-6">
                <label asp-for="ID_Perfil" class="form-label">
                    Perfil *
                </label>

                <select asp-for="ID_Perfil" class="form-select form-select-sm" id="comboArea" required>
                    @if (esAdmin)
                    {
                        <option value="">-- Selecciona el perfil --</option>
                    }

                    @if (ViewBag.Perfiles != null)
                    {
                        foreach (var p in ViewBag.Perfiles)
                        {
                            // Solo muestra el perfil si es Admin, o si el ID coincide con el del usuario logueado
                            if (esAdmin || p.Id.ToString() == miPerfilId)
                            {
                                if (!esAdmin)
                                {
                                    <option value="@p.Id" selected>@p.Nombre</option>
                                }
                                else
                                {
                                    <option value="@p.Id">@p.Nombre</option>
                                }
                            }
                        }
                    }
                </select>
            </div>

            <!-- Tipo de Objetivo con Boton para Modal -->
            <div class="col-md-6">
                    <label asp-for="ID_Tipo_Objetivo" class="form-label mb-0">Tipo de Objetivo *</label>
                    

                <select asp-for="ID_Tipo_Objetivo" class="form-select form-select-sm" id="tipoObjetivo" required disabled>
                    <option value="">-- Esperando área... --</option>
                </select>
            </div>


            <!-- PERIODO DE CUMPLIMIENTO -->
            <div class="col-md-4">
                <label asp-for="Tipo_Periodo_Cumplimiento" class="form-label">
                    Periodo de cumplimiento
                </label>

                <select asp-for="Tipo_Periodo_Cumplimiento" class="form-select form-select-sm">
                    <option value="">Seleccione un periodo</option>
                    <option value="Diario">Diario</option>
                    <option value="Semanal">Semanal</option>
                    <option value="Mensual">Mensual</option>
                    <option value="Trimestral">Trimestral</option>
                    <option value="Anual">Anual</option>
                </select>
            </div>

            <!-- Fecha desde -->
            <div class="col-md-4">
                <label asp-for="Fecha_Desde" class="form-label">Fecha Desde</label>
                <input asp-for="Fecha_Desde" type="date" class="form-control form-control-sm" />
            </div>

            <!-- Fecha hasta -->
            <div class="col-md-4">
                <label asp-for="Fecha_Hasta" class="form-label">Fecha Hasta</label>
                <input asp-for="Fecha_Hasta" type="date" class="form-control form-control-sm" />
            </div>

            <!-- CLIENTE -->
            <div class="col-md-6 campo-tipo" data-campo="Cliente">
                <label asp-for="ID_Cliente" class="form-label">Cliente</label>
                <select asp-for="ID_Cliente" class="form-select form-select-sm select2-buscar" id="cliente">
                    <option value="">-- Selecciona un Cliente --</option>
                    @if (ViewBag.Clientes != null)
                    {
                        foreach (var c in ViewBag.Clientes)
                        {
                            <option value="@c.Cliente">@c.Nombrecliente</option>
                        }
                    }
                </select>
            </div>

            <!-- VENDEDOR -->
            <div class="col-md-6 campo-tipo" data-campo="Vendedor">
                <label asp-for="UsuarioID_Vendedor" class="form-label">Vendedor</label>
                <select asp-for="UsuarioID_Vendedor" class="form-select form-select-sm select2-buscar" id="vendedor">
                    <option value="">-- Selecciona un Vendedor --</option>
                    @if (ViewBag.Vendedores != null)
                    {
                        foreach (var v in ViewBag.Vendedores)
                        {
                            if (ViewBag.MiUsuarioId != null && v.Id.ToString() == ViewBag.MiUsuarioId.ToString())
                            {
                                <option value="@v.Id" selected>@v.Nombre</option>
                            }
                            else
                            {
                                <option value="@v.Id">@v.Nombre</option>
                            }
                        }
                    }
                </select>
            </div>

            <!-- PROVEEDOR -->
            <div class="col-md-6 campo-tipo" data-campo="Proveedor">
                <label asp-for="Proveedor" class="form-label">Proveedor</label>
                <input asp-for="Proveedor" class="form-control form-control-sm" placeholder="Proveedor" />
            </div>

            <!-- SKU -->
            <div class="col-md-6 campo-tipo" data-campo="SKU">
                <label asp-for="SKU" class="form-label">SKU</label>
                <select asp-for="SKU" class="form-select form-select-sm select2-buscar" id="sku">
                    <option value="">-- Selecciona un SKU --</option>
                    @if (ViewBag.Articulos != null)
                    {
                        foreach (var a in ViewBag.Articulos)
                        {
                            <option value="@a.ProductoCodigo">@a.ProductoCodigo - @a.ProductoNombre</option>
                        }
                    }
                </select>
            </div>

            <!-- CUENTA CONTABLE -->
            <div class="col-md-6 campo-tipo" data-campo="CC">
                <label asp-for="CC" class="form-label">Cuenta Contable</label>
                <input asp-for="CC" class="form-control form-control-sm" placeholder="Cuenta Contable" />
            </div>

            <!-- LINEA -->
            <div class="col-md-6 campo-tipo" data-campo="Linea">
                <label asp-for="Linea" class="form-label">Línea</label>
                <select asp-for="Linea" class="form-select form-select-sm">
                    <option value="">Sin línea / No aplica</option>
                    <option value="VG">VG</option>
                    <option value="NOV">NOV</option>
                    <option value="VR">VR</option>
                    <option value="RES">RES</option>
                </select>
            </div>

            <!-- DESCRIPCIÓN -->
            <div class="col-12">
                <label asp-for="Descripcion_Objetivo" class="form-label">Descripción / Notas</label>
                <textarea asp-for="Descripcion_Objetivo" class="form-control form-control-sm" rows="3" placeholder="Detalles específicos sobre cómo se medirá este objetivo..."></textarea>
            </div>
        </div>

        <!-- SECCION META / VALORES -->
        <div class="mt-4">
            <div class="section-title d-flex justify-content-between align-items-center">
                <span><i class="bi bi-speedometer2 me-1"></i>Metas / Valores</span>

                        @if (User.IsInRole("Administrador"))
                    {
                        <button type="button"
                                class="btn btn-sm btn-outline-light shadow-sm"
                                data-bs-toggle="modal"
                                data-bs-target="#modalNuevoValorObjetivo"
                                style="font-size: 0.70rem; padding: 0.1rem 0.5rem;">
                            <i class="bi bi-plus-lg"></i> Configurar valor
                        </button>
                    }
            </div>


            <div id="valoresContainer">
                <!-- FILA DE VALORES -->
                <div class="row g-2 align-items-end valor-row mb-2">
                    <div class="col-md-4">
                        <label class="form-label">¿Qué se mide?</label>

                        <select name="ValoresConfigurados[0].ID_Catalogo_ValorObjetivo"
                                class="form-select form-select-sm catalogo-sm">

                                <option value="">Seleccione una métrica</option>

                                @if (ViewBag.CatalogoValores != null)
                                {
                                    foreach (var item in ViewBag.CatalogoValores)
                                    {
                                        <option value="@item.ID"
                                            data-unidad="@item.Unidad_Medida">
                                            @item.Nombre (@item.Unidad_Medida)
                                        </option>
                                    }
                                }
                            </select>

                            <input type="hidden"
                                   name="ValoresConfigurados[0].Tipo_Valor"
                                   class="tipo-valor" />

                            <input type="hidden"
                                   name="ValoresConfigurados[0].Unidad_Medida"
                                   class="unidad-medida" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Mínimo</label>
                        <input type="number" name="ValoresConfigurados[0].Valor_Minimo" class="form-control form-control-sm" step="0.01" placeholder="0.00" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Máximo</label>
                        <input type="number" name="ValoresConfigurados[0].Valor_Maximo" class="form-control form-control-sm" step="0.01" placeholder="0.00" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Objetivo</label>
                        <input type="number" name="ValoresConfigurados[0].Valor_Objetivo" class="form-control form-control-sm" step="0.01" placeholder="0.00" />
                    </div>
                    <div class="col-md-1">
                        <button type="button" class="btn btn-outline-danger btn-sm w-100 btn-eliminar-valor" title="Eliminar valor">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>
            </div>

            <template id="plantillaValor">
    <div class="row g-2 align-items-end valor-row mb-2">

        <div class="col-md-4">
            <label class="form-label">¿Qué se mide?</label>

            <select name="ValoresConfigurados[__INDEX__].ID_Catalogo_ValorObjetivo"
                    class="form-select form-select-sm catalogo-sm">

                <option value="">Seleccione una métrica</option>

                @if (ViewBag.CatalogoValores != null)
                {
                    foreach (var item in ViewBag.CatalogoValores)
                    {
                        <option value="@item.ID"
                                data-unidad="@item.Unidad_Medida">
                            @item.Nombre (@item.Unidad_Medida)
                        </option>
                    }
                }
            </select>

            <input type="hidden"
                   name="ValoresConfigurados[__INDEX__].Tipo_Valor"
                   class="tipo-valor" />

            <input type="hidden"
                   name="ValoresConfigurados[__INDEX__].Unidad_Medida"
                   class="unidad-medida" />
        </div>

        <div class="col-md-2">
            <label class="form-label">Mínimo</label>
            <input type="number"
                   name="ValoresConfigurados[__INDEX__].Valor_Minimo"
                   class="form-control form-control-sm"
                   step="0.01"
                   placeholder="0.00" />
        </div>

        <div class="col-md-2">
            <label class="form-label">Máximo</label>
            <input type="number"
                   name="ValoresConfigurados[__INDEX__].Valor_Maximo"
                   class="form-control form-control-sm"
                   step="0.01"
                   placeholder="0.00" />
        </div>

        <div class="col-md-2">
            <label class="form-label">Objetivo</label>
            <input type="number"
                   name="ValoresConfigurados[__INDEX__].Valor_Objetivo"
                   class="form-control form-control-sm"
                   step="0.01"
                   placeholder="0.00" />
        </div>

        <div class="col-md-1">
            <button type="button"
                    class="btn btn-outline-danger btn-sm w-100 btn-eliminar-valor"
                    title="Eliminar valor">
                <i class="bi bi-trash"></i>
            </button>
        </div>

    </div>
</template>

            <!-- Agregar valor -->
            <div class="mt-3">
                <button type="button" id="btnAgregarValor" class="btn btn-outline-danger btn-sm">
                    <i class="bi bi-plus-circle me-1"></i> Agregar valor
                </button>
            </div>
        </div>

        <!-- Botonera -->
        <div class="mt-4 d-flex justify-content-end gap-2">
            <a asp-action="Tablero" asp-controller="Objetivos" class="btn btn-secondary">
                <i class="bi bi-x-circle me-1"></i> Cancelar
            </a>
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-save me-1"></i> Guardar Objetivo
            </button>
        </div>
    </form>
</div>
</div>
    </div>

<!-- Modal para Crear Nuevo KPI -->
<div class="modal fade" id="modalNuevoKpi" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header text-white" style="background: linear-gradient(180deg,#b30000 0%,#8b0000 100%);">
                <h6 class="modal-title fw-bold"><i class="bi bi-graph-up-arrow me-2"></i>Registrar Nuevo KPI</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4 bg-light">
                <div class="mb-3">
                    <label class="form-label fw-bold" style="font-size: 0.85rem;">Área del KPI *</label>
                    <select id="kpiPerfil" class="form-select form-select-sm" required>
                        @if (esAdmin)
                        {
                            <option value="">-- Selecciona el área --</option>
                        }

                        @if (ViewBag.Perfiles != null)
                        {
                            foreach (var p in ViewBag.Perfiles)
                            {
                                if (esAdmin || p.Id.ToString() == miPerfilId)
                                {
                                    if (!esAdmin)
                                    {
                                        <option value="@p.Id" selected>@p.Nombre</option>
                                    }
                                    else
                                    {
                                        <option value="@p.Id">@p.Nombre</option>
                                    }
                                }
                            }
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold" style="font-size: 0.85rem;">Nombre del Indicador *</label>
                    <input type="text" id="kpiNombre" class="form-control form-control-sm" placeholder="Ej. Rotación de Personal" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold" style="font-size: 0.85rem;">Descripción de lo que mide</label>
                    <textarea id="kpiDesc" class="form-control form-control-sm" rows="2" placeholder="Opcional..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger btn-sm fw-bold" id="btnGuardarKpi">
                    <i class="bi bi-save me-1"></i> Guardar y Usar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal para configurar Tipos de Objetivo -->
<div class="modal fade" id="modalConfigTipos" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header text-white" style="background: linear-gradient(180deg,#b30000 0%,#8b0000 100%);">
                <h6 class="modal-title fw-bold"><i class="bi bi-gear me-2"></i>Configurar Tipos de Objetivo</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-3 bg-light">
                <input type="text" id="buscarTipoConfig" class="form-control form-control-sm mb-3" placeholder="Buscar tipo o perfil..." />
                <div id="msgConfigTipos" class="alert alert-danger py-2 small d-none"></div>
                <div class="accordion" id="accordionTipos"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal para elegir los SKU que apareceran como seleccionables en un tipo de objetivo -->
<div class="modal fade" id="modalSkuObjetivo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header text-white" style="background: linear-gradient(180deg,#b30000 0%,#8b0000 100%);">
                <h6 class="modal-title fw-bold"><i class="bi bi-upc-scan me-2"></i>SKU aplicables al objetivo</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-3 bg-light">
                <div class="small text-muted mb-2">Tipo: <span class="fw-bold text-dark" id="skuTipoNombre"></span></div>

                <div class="alert alert-warning py-2 small mb-2">
                    Si no seleccionas ninguno, el formulario mostrará <b>todos</b> los SKU.
                </div>

                <div class="d-flex flex-wrap gap-2 align-items-center mb-2">
                    <input type="text" id="buscarSkuObjetivo" class="form-control form-control-sm" style="max-width: 320px;" placeholder="Buscar SKU o descripción..." />
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="btnSkuTodos">Todos</button>
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="btnSkuNinguno">Ninguno</button>
                    <span class="ms-auto small fw-bold text-dark"><span id="skuContador">0</span> seleccionados</span>
                </div>

                <div id="msgSkuObjetivo" class="alert alert-danger py-2 small d-none"></div>

                <div id="listaSkuObjetivo" class="border rounded bg-white p-2" style="max-height: 45vh; overflow: auto;">
                    @if (ViewBag.Articulos != null)
                    {
                        foreach (var a in ViewBag.Articulos)
                        {
                            <label class="form-check sku-obj-item mb-1" data-texto="@a.ProductoCodigo @a.ProductoNombre">
                                <input class="form-check-input chk-sku-obj" type="checkbox" value="@a.ProductoCodigo" />
                                <span class="form-check-label small ms-1">@a.ProductoCodigo - @a.ProductoNombre</span>
                            </label>
                        }
                    }
                </div>
            </div>
            <div class="modal-footer">
                <span class="small text-success fw-bold me-auto" id="skuGuardadoOk"></span>
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger btn-sm fw-bold" id="btnGuardarSkuObjetivo">
                    <i class="bi bi-save me-1"></i> Guardar
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalNuevoValorObjetivo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">

            <div class="modal-header text-white"
                style="background: linear-gradient(180deg,#b30000 0%,#8b0000 100%);">

                <h6 class="modal-title fw-bold">
                    <i class="bi bi-sliders me-2"></i>
                    Configurar Valor de Objetivo
                </h6>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body p-4 bg-light">

                <div class="mb-3">
                    <label class="form-label fw-bold"
                            style="font-size: 0.85rem;">
                        Nombre *
                    </label>

                    <input type="text"
                            id="valorObjetivoNombre"
                            class="form-control form-control-sm"
                            placeholder="Ej. Peso por Caja"
                            required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold"
                            style="font-size: 0.85rem;">
                        Unidad de medida *
                    </label>

                    <select id="valorObjetivoUnidad"
                            class="form-select form-select-sm"
                            required>
                        <option value="">-- Selecciona una unidad --</option>

                        <optgroup label="Porcentaje y proporción">
                            <option value="%">%</option>
                            <option value="Puntos %">Puntos %</option>
                            <option value="Índice">Índice (OEE, ERI...)</option>
                            <option value="PPM">PPM (partes por millón)</option>
                        </optgroup>

                        <optgroup label="Cantidad / Conteo">
                            <option value="Unidades">Unidades o #</option>
                            <option value="Piezas">Piezas</option>
                            <option value="Cajas">Cajas</option>
                            <option value="Paquetes">Paquetes</option>
                            <option value="Tarimas">Tarimas / Pallets</option>
                            <option value="Canales">Canales</option>
                            <option value="Lotes">Lotes</option>
                            <option value="Rollos">Rollos</option>
                            <option value="Viajes">Viajes</option>
                            <option value="Embarques">Embarques</option>
                            <option value="Entregas">Entregas</option>
                            <option value="Pedidos">Pedidos</option>
                            <option value="Clientes">Clientes</option>
                            <option value="SKU">SKU</option>
                        </optgroup>

                        <optgroup label="Peso / Masa">
                            <option value="KG">KG</option>
                            <option value="G">G</option>
                            <option value="MG">MG</option>
                            <option value="TON">TON</option>
                            <option value="LB">LB</option>
                            <option value="OZ">OZ</option>
                        </optgroup>

                        <optgroup label="Volumen">
                            <option value="L">L</option>
                            <option value="ML">ML</option>
                            <option value="M3">M3</option>
                        </optgroup>

                        <optgroup label="Longitud">
                            <option value="MM">MM</option>
                            <option value="CM">CM</option>
                            <option value="M">M</option>
                            <option value="KM">KM</option>
                        </optgroup>

                        <optgroup label="Dinero">
                            <option value="$">$ (MXN)</option>
                            <option value="$USD">$USD</option>
                            <option value="$/KG">$/KG</option>
                            <option value="$/Pieza">$/Pieza</option>
                            <option value="$/Caja">$/Caja</option>
                            <option value="$/Hora">$/Hora</option>
                        </optgroup>

                        <optgroup label="Tiempo">
                            <option value="Días">Días</option>
                            <option value="Horas">Horas</option>
                            <option value="Minutos">Minutos</option>
                            <option value="Segundos">Segundos</option>
                            <option value="Semanas">Semanas</option>
                            <option value="Meses">Meses</option>
                        </optgroup>

                        <optgroup label="Productividad / Velocidad">
                            <option value="Kg/Hora">Kg/Hora</option>
                            <option value="Piezas/Hora">Piezas/Hora</option>
                            <option value="Cajas/Hora">Cajas/Hora</option>
                            <option value="Unidades/Hora">Unidades/Hora</option>
                            <option value="Kg/Día">Kg/Día</option>
                            <option value="Cajas/Día">Cajas/Día</option>
                        </optgroup>

                        <optgroup label="Temperatura">
                            <option value="°C">°C</option>
                            <option value="°F">°F</option>
                        </optgroup>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold"
                            style="font-size: 0.85rem;">
                        Descripción
                    </label>

                    <textarea id="valorObjetivoDescripcion"
                              class="form-control form-control-sm"
                              rows="3"
                              placeholder="Descripción de lo que representa este valor..."></textarea>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button"
                    class="btn btn-outline-secondary btn-sm"
                    data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button type="button"
                        class="btn btn-danger btn-sm fw-bold"
                        id="btnGuardarValorObjetivo">
                    <i class="bi bi-save me-1"></i>
                    Guardar y Usar
                </button>

            </div>

        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        (function () {
            if (!window.jQuery || !jQuery.fn.select2) return;
            jQuery('#cliente, #vendedor, #sku').select2({ width: '100%' });
        })();
    </script>
    <script>
        $(document).ready(function () {
            // Lista maestra de SKU del combo (se captura una sola vez, antes de filtrar)
            var skuOpcionesTodas = [];
            $('#sku option').each(function () {
                if (this.value) { skuOpcionesTodas.push({ value: this.value, text: this.text }); }
            });

            function aplicarCamposTipo(){
                var campos = ($('#tipoObjetivo option:selected').attr('data-campos') || '').trim();
                var lista = campos ? campos.split(',').map(function (s) {return s.trim(); }) : [];

                $('.campo-tipo').each(function () {
                    var $c = $(this);
                    var visible = lista.length === 0 || lista.indexOf($c.data('campo')) !== -1;
                    $c.toggle(visible);
                    $c.find('input, select, textarea').prop('disabled', !visible);
                })

                // Restringe el combo de SKU a los configurados para el tipo seleccionado
                var skuVisible = lista.length === 0 || lista.indexOf('SKU') !== -1;
                if (skuVisible) {
                    filtrarSkuPorTipo($('#tipoObjetivo').val());
                } else {
                    aplicarRestriccionSku(null);
                }
            }

            $('#tipoObjetivo').on('change', aplicarCamposTipo);

            // Carga de KPIs segun el Area seleccionada
            $('#comboArea').change(function () {
                var areaId = $(this).val();
                var $comboKpi =$('#tipoObjetivo');

                $comboKpi.empty().append('<option value="">-- Selecciona el Tipo --</option>').prop('disabled', true);

                aplicarCamposTipo();

                if (areaId) {
                    $.getJSON('@Url.Action("ObtenerKpisPorArea", "Objetivos")', { idPerfil: areaId }, function (data) {
                        if (data && data.length > 0) {
                            $.each(data, function (index, item) {
                                // Usamos item.Valor y item.Texto segun retorna el controlador
                                $comboKpi.append($('<option/>', { value: item.Valor, text: item.Texto ,'data-campos': item.Campos || '' }));
                            });
                            $comboKpi.prop('disabled', false);
                        } else {
                            $comboKpi.empty().append('<option value="">No hay KPIs para esta área</option>');
                        }
                    });
                } else {
                    $comboKpi.empty().append('<option value="">-- Esperando área... --</option>');
                }
            });

            // Dispara el evento al inicio por si el area ya viene seleccionada (usuarios sin permisos de Admin)
            if ($('#comboArea').val()) {
                $('#comboArea').trigger('change');
            }

            // Logica para crear KPI en tiempo real (AJAX)
            $('#btnGuardarKpi').click(function () {
                var idPerfil = $('#kpiPerfil').val();
                var nombre = $('#kpiNombre').val();
                var desc = $('#kpiDesc').val();

                if (!idPerfil || !nombre) {
                    alert("Por favor, selecciona un área y escribe el nombre del KPI.");
                    return;
                }

                var $btn = $(this);$btn.html('<i class="spinner-border spinner-border-sm"></i> Guardando...').prop('disabled', true);

                $.post('@Url.Action("CrearTipoObjetivo", "Objetivos")', {
                    idPerfil: idPerfil,
                    nombre: nombre,
                    descripcion: desc
                }, function (response) {
                    if (response.success) {
                        $('#kpiNombre').val('');
                        $('#kpiDesc').val('');
                        bootstrap.Modal.getOrCreateInstance(document.getElementById('modalNuevoKpi')).hide();

                        // Si el area en la que se creo es la misma que la del formulario principal, lo agregamos
                        if ($('#comboArea').val() == idPerfil) {
                            $('#tipoObjetivo').append($('<option/>', { value: response.id, text: response.nombre }));$('#tipoObjetivo').val(response.id).prop('disabled', false).trigger('change');
                        } else {
                            alert("KPI creado exitosamente.");
                        }

                    } else {
                        alert("Error al guardar: " + response.message);
                    }
                }).always(function() {
                    $btn.html('<i class="bi bi-save me-1"></i> Guardar y Usar').prop('disabled', false);
                });
            });

            // Crear nuevo Valor de Objetivo en el catálogo
            $('#btnGuardarValorObjetivo').click(function () {

                var nombre = $('#valorObjetivoNombre').val().trim();
                var unidad = $('#valorObjetivoUnidad').val().trim();
                var descripcion = $('#valorObjetivoDescripcion').val().trim();

                if (!nombre || !unidad){
                    alert("Por favor, capturar el nombre y la unidad de medida.");
                    return;
                }

                var $btn = $(this);

                $btn.html('<i class="spinner-border spinner-border-sm"></i> Guardando...')
                    .prop('disabled', true);

                $.post('@Url.Action("CrearValorObjetivo", "Objetivos")', {
                    nombre: nombre,
                    unidadMedida: unidad,
                    descripcion: descripcion
                }, function (response) {

                    if (response.success) {

                        // Registrar la métrica en la lista maestra compartida
                        if (window.catalogoOpciones) {
                            window.catalogoOpciones.push({
                                value: response.id,
                                text: response.nombre + ' (' + response.unidad + ')',
                                unidad: response.unidad
                            });
                        }

                        // Repoblar TODOS los combos (incluye filas agregadas después de crear la métrica)
                        $('.catalogo-sm').each(function () {
                            llenarSelectCatalogo(this, $(this).val());
                        });

                        // Seleccionar automáticamente el nuevo valor en la última fila
                        var $ultimaFila = $('.valor-row').last();
                        var $select = $ultimaFila.find('.catalogo-sm');

                        $select.val(response.id).trigger('change');

                        // Limpiar formulario del modal
                        $('#valorObjetivoNombre').val('');
                        $('#valorObjetivoUnidad').val('');
                        $('#valorObjetivoDescripcion').val('');

                        // Cerrar modal
                        bootstrap.Modal.getOrCreateInstance(document.getElementById('modalNuevoValorObjetivo')).hide();

                    } else {

                        alert("Error al guardar: " + response.message);

                    }
                }).always(function () {

                    $btn.html('<i class="bi bi-save me-1"></i> Guardar y Usar')
                        .prop('disabled', false);

                });
            });

            // Carga dinamica de clientes segun el vendedor seleccionado
            function cargarClientesPorVendedor(idVendedor) {
                var $comboCliente = $('#cliente');
                $comboCliente.empty().append('<option value="">Cargando clientes...</option>');
                $.getJSON('@Url.Action("ObtenerClientesPorVendedor", "Objetivos")', { idVendedor: idVendedor }, function (data) {
                    $comboCliente.empty().append('<option value="">-- Selecciona un Cliente --</option>');
                    if (data && data.length > 0) {
                        $.each(data, function (index, item) {
                            $comboCliente.append($('<option/>', { value: item.Cliente, text: item.Nombrecliente }));
                        });
                    } else {
                        $comboCliente.append('<option value="">No hay clientes para este vendedor</option>');
                    }
                });
            }

            $('#vendedor').change(function () {
                cargarClientesPorVendedor($(this).val() || 0);
            });

            // Al iniciar, si ya viene un vendedor preseleccionado, cargar sus clientes
            if ($('#vendedor').val()) {
                $('#vendedor').trigger('change');
            }

            // ===== Configurar Tipos de Objetivo (solo lectura) =====
            var camposConfig = [
                { clave: 'Cliente', texto: 'Cliente' },
                { clave: 'Vendedor', texto: 'Vendedor' },
                { clave: 'Proveedor', texto: 'Proveedor' },
                { clave: 'SKU', texto: 'SKU' },
                { clave: 'CC', texto: 'Cuenta Contable' },
                { clave: 'Linea', texto: 'Línea' }
            ];

            function esc(t) {
            return $('<div/>').text(t == null ? '' : t).html();
            }

            function escAttr(t) {
                return esc(t).replace(/"/g, '&quot;');
            }

            function cargarTiposConfiguracion() {
                var $acc = $('#accordionTipos');
                var $msg = $('#msgConfigTipos');

                $msg.addClass('d-none').text('');
                $acc.html('<div class="text-center text-muted py-3"><span class="spinner-border spinner-border-sm"></span> Cargando tipos...</div>');

                $.getJSON('@Url.Action("ObtenerTiposConfiguracion", "Objetivos")', function (data) {
                    if (!Array.isArray(data)) {
                        $acc.empty();
                        $msg.removeClass('d-none').text('No se pudieron cargar los tipos' + (data && data.error ? ': ' + data.error : '.'));
                        return;
                    }

                    if (data.length === 0) {
                        $acc.html('<div class="text-center text-muted py-3">No hay tipos de objetivo.</div>');
                        return;
                    }

                    var html = '';
                    $.each(data, function (i, t) {
                        var lista = t.Campos ? t.Campos.split(',').map(function (s) { return s.trim(); }) : null;

                        var checks = '';
                        $.each(camposConfig, function (j, c) {
                            var marcado = (lista === null || lista.indexOf(c.clave) !== -1) ? ' checked' : '';
                            var idChk = 'chk_' + t.ID + '_' + c.clave;
                            checks += '<div class="form-check form-check-inline">' +
                                '<input class="form-check-input chk-campo-tipo" type="checkbox" id="' + idChk + '" data-campo="' + c.clave + '"' + marcado + ' />' +
                                '<label class="form-check-label small" for="' + idChk + '">' + c.texto + '</label></div>';
                        });

                        var badgeEstado = '<span class="badge ' + (t.Activo ? 'bg-success' : 'bg-secondary') + ' ms-2 cfg-badge-estado">' + (t.Activo ? 'Activo' : 'Inactivo') + '</span>';
                        var skusCount = Number(t.SkusConfigurados || 0);

                        html += '<div class="accordion-item">' +
                            '<h2 class="accordion-header">' +
                            '<button class="accordion-button collapsed py-2" type="button" data-bs-toggle="collapse" data-bs-target="#tipoCfg_' + t.ID + '">' +
                            '<span class="fw-bold cfg-titulo-nombre">' + esc(t.Nombre) + '</span>' +
                            '<span class="badge bg-light text-dark border ms-2">' + esc(t.NombrePerfil || 'Sin perfil') + '</span>' + badgeEstado +
                            '</button></h2>' +
                            '<div id="tipoCfg_' + t.ID + '" class="accordion-collapse collapse" data-bs-parent="#accordionTipos">' +
                            '<div class="accordion-body">' +

                            '<div class="row g-2 mb-3">' +
                            '<div class="col-md-8"><label class="form-label small fw-bold text-muted mb-1">Nombre</label>' +
                            '<input type="text" class="form-control form-control-sm cfg-nombre" maxlength="150" value="' + escAttr(t.Nombre) + '" /></div>' +
                            '<div class="col-md-4 d-flex align-items-end"><div class="form-check form-switch mb-1">' +
                            '<input class="form-check-input cfg-activo" type="checkbox" role="switch" id="act_' + t.ID + '"' + (t.Activo ? ' checked' : '') + ' />' +
                            '<label class="form-check-label small fw-bold" for="act_' + t.ID + '">Activo</label></div></div>' +
                            '<div class="col-12"><label class="form-label small fw-bold text-muted mb-1">Descripción</label>' +
                            '<textarea class="form-control form-control-sm cfg-desc" rows="2" maxlength="500">' + esc(t.Descripcion) + '</textarea></div>' +
                            '</div>' +

                            '<div class="small fw-bold text-muted mb-1">Campos que muestra el formulario</div>' +
                            checks +
                            '<div class="small text-muted mt-2 cfg-nota-sin-config' + (lista === null ? '' : ' d-none') + '">Sin configurar: se muestran todos los campos.</div>' +

                            '<div class="btn-sku-wrap mt-2' + ((lista === null || lista.indexOf('SKU') !== -1) ? '' : ' d-none') + '">' +
                            '<button type="button" class="btn btn-outline-danger btn-sm fw-bold btn-config-sku" data-id="' + t.ID + '">' +
                            '<i class="bi bi-upc-scan me-1"></i> SKU aplicables' +
                            ' <span class="badge bg-danger cfg-sku-badge' + (skusCount > 0 ? '' : ' d-none') + '">' + skusCount + '</span>' +
                            '</button>' +
                            '<span class="small text-muted ms-2 cfg-sku-info">' + (skusCount > 0 ? '' : 'Sin restricción: se muestran todos los SKU') + '</span>' +
                            '</div>' +

                            '<div class="d-flex justify-content-end align-items-center gap-2 mt-3">' +
                            '<span class="small cfg-resultado"></span>' +
                            '<button type="button" class="btn btn-danger btn-sm fw-bold btn-guardar-tipo" data-id="' + t.ID + '"><i class="bi bi-save me-1"></i> Guardar</button>' +
                            '</div>' +

                            '</div></div></div>';
                    });

                    $acc.html(html);
                }).fail(function () {
                    $acc.empty();
                    $msg.removeClass('d-none').text('Error de comunicación al cargar los tipos.');
                });
            }

            $('#modalConfigTipos').on('show.bs.modal', function () {
                $('#buscarTipoConfig').val('');
                cargarTiposConfiguracion();
            });

            $('#buscarTipoConfig').on('input', function () {
                var q = $(this).val().toLowerCase();
                $('#accordionTipos .accordion-item').each(function () {
                    $(this).toggle($(this).find('.accordion-header').text().toLowerCase().indexOf(q) !== -1);
                });
            });

            $(document).on('click', '.btn-guardar-tipo', function () {
                var $btn = $(this);
                var $item = $btn.closest('.accordion-item');
                var $res = $item.find('.cfg-resultado');
                var id = $btn.data('id');

                var nombre = $item.find('.cfg-nombre').val().trim();
                var descripcion = $item.find('.cfg-desc').val().trim();
                var activo = $item.find('.cfg-activo').is(':checked');
                var campos = $item.find('.chk-campo-tipo:checked').map(function () {
                    return $(this).data('campo');
                }).get().join(',');

                function mostrar(texto, ok) {
                    $res.removeClass('text-danger text-success').addClass(ok ? 'text-success' : 'text-danger').text(texto);
                }

                if (!nombre) {
                    mostrar('El nombre es obligatorio.', false);
                    return;
                }

                $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span> Guardando...');
                $res.text('');

                $.post('@Url.Action("GuardarConfiguracionTipo", "Objetivos")', {
                    id: id,
                    nombre: nombre,
                    descripcion: descripcion,
                    activo: activo,
                    campos: campos
                }, function (response) {
                    if (!response.success) {
                        mostrar(response.message || 'No se pudo guardar.', false);
                        return;
                    }

                    // Actualiza el encabezado del desplegable
                    $item.find('.cfg-titulo-nombre').text(response.nombre);
                    $item.find('.cfg-badge-estado')
                        .toggleClass('bg-success', response.activo)
                        .toggleClass('bg-secondary', !response.activo)
                        .text(response.activo ? 'Activo' : 'Inactivo');
                    $item.find('.cfg-nota-sin-config').toggleClass('d-none', response.campos !== null);

                    // Sincroniza el combo "Tipo de Objetivo" del formulario si ese tipo esta cargado
                    var $combo = $('#tipoObjetivo');
                    var $opt = $combo.find('option[value="' + id + '"]');
                    if ($opt.length) {
                        if (!response.activo) {
                            var estabaSeleccionado = String($combo.val()) === String(id);
                            $opt.remove();
                            if (estabaSeleccionado) {
                                $combo.val('').trigger('change');
                            }
                        } else {
                            $opt.text(response.nombre).attr('data-campos', response.campos || '');
                            if (String($combo.val()) === String(id)) {
                                aplicarCamposTipo();
                            }
                        }
                    }

                    mostrar('Guardado correctamente.', true);
                }).fail(function () {
                    mostrar('Error de comunicación al guardar.', false);
                }).always(function () {
                    $btn.prop('disabled', false).html('<i class="bi bi-save me-1"></i> Guardar');
                });
            });

            // ===== SKU aplicables por tipo de objetivo =====
            var skusRelevantesCache = {};

            // Reconstruye el combo SKU con la lista permitida (null = todos)
            function aplicarRestriccionSku(listaPermitida) {
                var permitidos = (listaPermitida && listaPermitida.length) ? listaPermitida : null;
                var $sel = $('#sku');
                var actual = $sel.val();

                var permitido = {};
                if (permitidos) {
                    permitidos.forEach(function (s) { permitido[String(s)] = true; });
                }

                $sel.empty();
                $sel.append($('<option/>', { value: '', text: '-- Selecciona un SKU --' }));

                $.each(skuOpcionesTodas, function (i, o) {
                    if (!permitidos || permitido[String(o.value)]) {
                        $sel.append($('<option/>', { value: o.value, text: o.text }));
                    }
                });

                // Conserva el valor actual si sigue disponible en la lista
                var existe = false;
                $sel.find('option').each(function () { if (this.value === actual) { existe = true; } });
                var valorFinal = existe ? actual : '';

                if ($sel.hasClass('select2-hidden-accessible')) {
                    $sel.select2('destroy');
                    $sel.val(valorFinal);
                    $sel.select2({ width: '100%' });
                } else {
                    $sel.val(valorFinal);
                }
            }

            function filtrarSkuPorTipo(tipoId) {
                tipoId = (tipoId || '').toString();

                if (!tipoId) {
                    aplicarRestriccionSku(null);
                    return;
                }

                if (Object.prototype.hasOwnProperty.call(skusRelevantesCache, tipoId)) {
                    aplicarRestriccionSku(skusRelevantesCache[tipoId]);
                    return;
                }

                $.getJSON('@Url.Action("ObtenerArticulosRelevantes", "Objetivos")', { idTipo: tipoId }, function (r) {
                    var lista = (r && r.success && r.skus && r.skus.length) ? r.skus : null;
                    skusRelevantesCache[tipoId] = lista;
                    if (String($('#tipoObjetivo').val()) === String(tipoId)) {
                        aplicarRestriccionSku(lista);
                    }
                }).fail(function () {
                    aplicarRestriccionSku(null);
                });
            }

            // ===== Modal: seleccionar SKU aplicables de un tipo =====
            var skuTipoActual = null;
            var $skuItemActual = null;

            function skuModal() {
                return bootstrap.Modal.getOrCreateInstance(document.getElementById('modalSkuObjetivo'));
            }

            function actualizarContadorSku() {
                $('#skuContador').text($('#listaSkuObjetivo .chk-sku-obj:checked').length);
            }

            function pintarInfoSkuBoton($item, total) {
                $item.find('.cfg-sku-badge')
                    .toggleClass('d-none', total <= 0)
                    .text(total);
                $item.find('.cfg-sku-info').text(total > 0 ? '' : 'Sin restricción: se muestran todos los SKU');
            }

            // Muestra/oculta el boton al marcar o desmarcar el campo SKU
            $(document).on('change', '.chk-campo-tipo', function () {
                var $item = $(this).closest('.accordion-item');
                var on = $item.find('.chk-campo-tipo[data-campo="SKU"]').is(':checked');
                $item.find('.btn-sku-wrap').toggleClass('d-none', !on);
            });

            $(document).on('click', '.btn-config-sku', function () {
                var $item = $(this).closest('.accordion-item');
                skuTipoActual = $(this).data('id');
                $skuItemActual = $item;

                $('#skuTipoNombre').text($item.find('.cfg-nombre').val() || $item.find('.cfg-titulo-nombre').text());
                $('#buscarSkuObjetivo').val('');
                $('#msgSkuObjetivo').addClass('d-none').text('');
                $('#skuGuardadoOk').text('');
                $('#listaSkuObjetivo .sku-obj-item').removeClass('d-none');
                $('#listaSkuObjetivo .chk-sku-obj').prop('checked', false);
                actualizarContadorSku();

                skuModal().show();

                $.getJSON('@Url.Action("ObtenerArticulosRelevantes", "Objetivos")', { idTipo: skuTipoActual }, function (r) {
                    if (r && r.success && Array.isArray(r.skus)) {
                        var set = {};
                        r.skus.forEach(function (s) { set[String(s)] = true; });
                        $('#listaSkuObjetivo .chk-sku-obj').each(function () {
                            $(this).prop('checked', !!set[String($(this).val())]);
                        });
                        actualizarContadorSku();
                    } else if (r && r.message) {
                        $('#msgSkuObjetivo').removeClass('d-none').text(r.message);
                    }
                }).fail(function () {
                    $('#msgSkuObjetivo').removeClass('d-none').text('No se pudieron cargar los SKU configurados.');
                });
            });

            $(document).on('change', '#listaSkuObjetivo .chk-sku-obj', actualizarContadorSku);

            $('#buscarSkuObjetivo').on('input', function () {
                var q = $(this).val().toLowerCase();
                $('#listaSkuObjetivo .sku-obj-item').each(function () {
                    var t = ($(this).data('texto') || '').toString().toLowerCase();
                    $(this).toggle(t.indexOf(q) !== -1);
                });
            });

            $('#btnSkuTodos').on('click', function () {
                $('#listaSkuObjetivo .sku-obj-item').not('.d-none').find('.chk-sku-obj').prop('checked', true);
                actualizarContadorSku();
            });

            $('#btnSkuNinguno').on('click', function () {
                $('#listaSkuObjetivo .sku-obj-item').not('.d-none').find('.chk-sku-obj').prop('checked', false);
                actualizarContadorSku();
            });

            $('#btnGuardarSkuObjetivo').on('click', function () {
                if (!skuTipoActual) { return; }

                var $btn = $(this);
                var skus = $('#listaSkuObjetivo .chk-sku-obj:checked').map(function () {
                    return $(this).val();
                }).get().join(',');

                $('#msgSkuObjetivo').addClass('d-none').text('');
                $btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm"></span> Guardando...');

                $.post('@Url.Action("GuardarArticulosRelevantes", "Objetivos")', {
                    idTipo: skuTipoActual,
                    skus: skus
                }, function (r) {
                    if (!r || !r.success) {
                        $('#msgSkuObjetivo').removeClass('d-none').text((r && r.message) || 'No se pudo guardar.');
                        return;
                    }

                    var total = Number(r.total || 0);
                    if ($skuItemActual) { pintarInfoSkuBoton($skuItemActual, total); }

                    delete skusRelevantesCache[skuTipoActual];
                    if (String($('#tipoObjetivo').val()) === String(skuTipoActual)) {
                        filtrarSkuPorTipo(skuTipoActual);
                    }

                    skuModal().hide();
                }).fail(function () {
                    $('#msgSkuObjetivo').removeClass('d-none').text('Error de comunicación al guardar.');
                }).always(function () {
                    $btn.prop('disabled', false).html('<i class="bi bi-save me-1"></i> Guardar');
                });
            });
        });

        // Logica de Filas Dinamicas
        let indiceValor = 1;

        // Catalogo de metricas compartido: se mantiene aunque se agreguen filas
        // o se creen metricas nuevas desde el modal. Evita que una fila nueva
        // quede sin las metricas recien creadas.
        window.catalogoOpciones = (function () {
            var opciones = [];
            var sel = document.querySelector('.catalogo-sm');
            if (sel) {
                Array.prototype.forEach.call(sel.options, function (o) {
                    if (o.value) {
                        opciones.push({ value: o.value, text: o.textContent.trim(), unidad: o.dataset.unidad || '' });
                    }
                });
            }
            return opciones;
        })();

        function llenarSelectCatalogo(select, seleccionado) {
            if (!select) return;

            var opciones = window.catalogoOpciones || [];

            select.innerHTML = '';
            var vacio = document.createElement('option');
            vacio.value = '';
            vacio.textContent = 'Seleccione una métrica';
            select.appendChild(vacio);

            opciones.forEach(function (o) {
                var opt = document.createElement('option');
                opt.value = o.value;
                opt.textContent = o.text;
                opt.dataset.unidad = o.unidad;
                if (seleccionado != null && String(o.value) === String(seleccionado)) {
                    opt.selected = true;
                }
                select.appendChild(opt);
            });
        }

        function renumerarValores() {

    const filas = document.querySelectorAll(".valor-row");

    filas.forEach((fila, indice) => {

        const campos = fila.querySelectorAll("input, select");

        campos.forEach(campo => {

            const nombre = campo.name;

            if (!nombre) return;

            campo.name = nombre.replace(
                /ValoresConfigurados\[\d+\]/,
                `ValoresConfigurados[${indice}]`
            );
        });
    });

    indiceValor = filas.length;
}

        document.getElementById("btnAgregarValor").addEventListener("click", function () {

    const container = document.getElementById("valoresContainer");
    const plantilla = document.getElementById("plantillaValor");

    const nuevaFila = plantilla.content.cloneNode(true);

    nuevaFila.querySelectorAll("[name]").forEach(elemento => {
        elemento.name = elemento.name.replace(
            /__INDEX__/g,
            indiceValor
        );
    });

    container.appendChild(nuevaFila);

    // Rellena el combo de la fila nueva con el catalogo vigente
    const filas = container.querySelectorAll(".valor-row");
    const ultima = filas[filas.length - 1];
    if (ultima) { llenarSelectCatalogo(ultima.querySelector(".catalogo-sm")); }

    indiceValor++;
});

        document.getElementById("valoresContainer").addEventListener("click", function (e) {
            const botonEliminar = e.target.closest(".btn-eliminar-valor");

            if(!botonEliminar) return;

            const filas = document.querySelectorAll(".valor-row");

            // Mantener al menos una fila
            if (filas.length <= 1) return;

            botonEliminar.closest(".valor-row").remove();
            renumerarValores();
        });

        document.getElementById("valoresContainer").addEventListener("change", function (e) {

            if (!e.target.classList.contains("catalogo-sm")) return;

            const select = e.target;
            const opcion = select.options[select.selectedIndex];
            const fila = select.closest(".valor-row");

            const tipoValor = fila.querySelector(".tipo-valor");
            const unidadMedida = fila.querySelector(".unidad-medida");

            if (!opcion || !opcion.value) {
                tipoValor.value = "";
                unidadMedida.value = "";
                return;
            }

            tipoValor.value = opcion.textContent
                .replace(/\s*\([^)]*\)\s*$/, "")
                .trim();

            unidadMedida.value = opcion.dataset.unidad || "";
        });
    </script>
}