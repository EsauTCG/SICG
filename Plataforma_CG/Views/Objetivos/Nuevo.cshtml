</style>

<div class="container-fluid p-0">
    <!-- Banner Superior -->
    <div class="top-banner d-flex justify-content-between align-items-center">
        <div>
            <h3 class="fw-bold mb-1"><i class="bi bi-plus-circle-dotted me-2"></i>Crear Nuevo Objetivo</h3>
            <p class="mb-0" style="opacity: 0.9; font-size: 0.85rem;">Configura las metas y métricas esperadas para un área.</p>
        </div>
        <div>
            <a href="@Url.Action("Tablero", "Objetivos")" class="btn btn-outline-light fw-bold shadow-sm">
                <i class="bi bi-arrow-left me-1"></i> Volver al Tablero
            </a>
        </div>
    </div>

    <div class="card border-0 shadow-sm mx-3 mt-3 mb-4" style="border-radius: 0.375rem;">
        <div class="card-body p-3 p-md-4">

        

    <!-- Formulario -->
    <form asp-action="GuardarNuevo" asp-controller="Objetivos" method="post" id="formNuevoObjetivo">
        <div asp-validation-summary="All" class="alert alert-danger py-2" style="font-size: 0.85rem;"></div>

        <div class="section-title d-flex justify-content-between align-items-center">
            <span><i class="bi bi-clipboard-data me-1"></i>Datos del objetivo</span>

            @if (ViewBag.PuedeEliminarObjetivos == true)
            {
                <button type="button"
                        class="btn btn-sm btn-outline-light shadow-sm"
                        data-bs-toggle="modal"
                        data-bs-target="#modalNuevoKpi"
                        style="font-size: 0.70rem; padding: 0.1rem 0.5rem;">
                    <i class="bi bi-plus-lg"></i> Crear Nuevo Tipo de Objetivo
                </button>
            }
        </div>

        <div class="row g-3">

            <!-- PERFIL (Filtrado por Rol) -->
            <div class="col-md-6">
                <label asp-for="ID_Perfil" class="form-label">
                    Perfil *
                </label>

                <select asp-for="ID_Perfil" class="form-select form-select-sm" id="comboArea" required>
                    @if (esAdmin)
                    {
                        <option value="">-- Selecciona el perfil --</option>
                    }

                    @if (ViewBag.Perfiles != null)
                    {
                        foreach (var p in ViewBag.Perfiles)
                        {
                            // Solo muestra el perfil si es Admin, o si el ID coincide con el del usuario logueado
                            if (esAdmin || p.Id.ToString() == miPerfilId)
                            {
                                if (!esAdmin)
                                {
                                    <option value="@p.Id" selected>@p.Nombre</option>
                                }
                                else
                                {
                                    <option value="@p.Id">@p.Nombre</option>
                                }
                            }
                        }
                    }
                </select>
            </div>

            <!-- Tipo de Objetivo con Boton para Modal -->
            <div class="col-md-6">
                    <label asp-for="ID_Tipo_Objetivo" class="form-label mb-0">Tipo de Objetivo *</label>
                    

                <select asp-for="ID_Tipo_Objetivo" class="form-select form-select-sm" id="tipoObjetivo" required disabled>
                    <option value="">-- Esperando área... --</option>
                </select>
            </div>


            <!-- PERIODO DE CUMPLIMIENTO -->
            <div class="col-md-4">
                <label asp-for="Tipo_Periodo_Cumplimiento" class="form-label">
                    Periodo de cumplimiento
                </label>

                <select asp-for="Tipo_Periodo_Cumplimiento" class="form-select form-select-sm">
                    <option value="">Seleccione un periodo</option>
                    <option value="Diario">Diario</option>
                    <option value="Semanal">Semanal</option>
                    <option value="Mensual">Mensual</option>
                    <option value="Trimestral">Trimestral</option>
                    <option value="Anual">Anual</option>
                </select>
            </div>

            <!-- Fecha desde -->
            <div class="col-md-4">
                <label asp-for="Fecha_Desde" class="form-label">Fecha Desde</label>
                <input asp-for="Fecha_Desde" type="date" class="form-control form-control-sm" />
            </div>

            <!-- Fecha hasta -->
            <div class="col-md-4">
                <label asp-for="Fecha_Hasta" class="form-label">Fecha Hasta</label>
                <input asp-for="Fecha_Hasta" type="date" class="form-control form-control-sm" />
            </div>

            <!-- CLIENTE -->
            <div class="col-md-6">
                <label asp-for="ID_Cliente" class="form-label">Cliente</label>
                <select asp-for="ID_Cliente" class="form-select form-select-sm select2-buscar" id="cliente">
                    <option value="">-- Selecciona un Cliente --</option>
                    @if (ViewBag.Clientes != null)
                    {
                        foreach (var c in ViewBag.Clientes)
                        {
                            <option value="@c.Cliente">@c.Nombrecliente</option>
                        }
                    }
                </select>
            </div>

            <!-- VENDEDOR -->
            <div class="col-md-6">
                <label asp-for="UsuarioID_Vendedor" class="form-label">Vendedor</label>
                <select asp-for="UsuarioID_Vendedor" class="form-select form-select-sm select2-buscar" id="vendedor">
                    <option value="">-- Selecciona un Vendedor --</option>
                    @if (ViewBag.Vendedores != null)
                    {
                        foreach (var v in ViewBag.Vendedores)
                        {
                            if (ViewBag.MiUsuarioId != null && v.Id.ToString() == ViewBag.MiUsuarioId.ToString())
                            {
                                <option value="@v.Id" selected>@v.Nombre</option>
                            }
                            else
                            {
                                <option value="@v.Id">@v.Nombre</option>
                            }
                        }
                    }
                </select>
            </div>

            <!-- PROVEEDOR -->
            <div class="col-md-6">
                <label asp-for="Proveedor" class="form-label">Proveedor</label>
                <input asp-for="Proveedor" class="form-control form-control-sm" placeholder="Proveedor" />
            </div>

            <!-- SKU -->
            <div class="col-md-6">
                <label asp-for="SKU" class="form-label">SKU</label>
                <select asp-for="SKU" class="form-select form-select-sm select2-buscar" id="sku">
                    <option value="">-- Selecciona un SKU --</option>
                    @if (ViewBag.Articulos != null)
                    {
                        foreach (var a in ViewBag.Articulos)
                        {
                            <option value="@a.ProductoCodigo">@a.ProductoCodigo - @a.ProductoNombre</option>
                        }
                    }
                </select>
            </div>

            <!-- CUENTA CONTABLE -->
            <div class="col-md-6">
                <label asp-for="CC" class="form-label">Cuenta Contable</label>
                <input asp-for="CC" class="form-control form-control-sm" placeholder="Cuenta Contable" />
            </div>

            <!-- LINEA -->
            <div class="col-md-6">
                <label asp-for="Linea" class="form-label">Línea</label>
                <select asp-for="Linea" class="form-select form-select-sm">
                    <option value="">Sin línea / No aplica</option>
                    <option value="VG">VG</option>
                    <option value="NOV">NOV</option>
                    <option value="VR">VR</option>
                    <option value="RES">RES</option>
                </select>
            </div>

            <!-- DESCRIPCIÓN -->
            <div class="col-12">
                <label asp-for="Descripcion_Objetivo" class="form-label">Descripción / Notas</label>
                <textarea asp-for="Descripcion_Objetivo" class="form-control form-control-sm" rows="3" placeholder="Detalles específicos sobre cómo se medirá este objetivo..."></textarea>
            </div>
        </div>

        <!-- SECCION META / VALORES -->
        <div class="mt-4">
            <div class="section-title d-flex justify-content-between align-items-center">
                <span><i class="bi bi-speedometer2 me-1"></i>Metas / Valores</span>

                        @if (User.IsInRole("Administrador"))
                    {
                        <button type="button"
                                class="btn btn-sm btn-outline-light shadow-sm"
                                data-bs-toggle="modal"
                                data-bs-target="#modalNuevoValorObjetivo"
                                style="font-size: 0.70rem; padding: 0.1rem 0.5rem;">
                            <i class="bi bi-plus-lg"></i> Configurar valor
                        </button>
                    }
            </div>


            <div id="valoresContainer">
                <!-- FILA DE VALORES -->
                <div class="row g-2 align-items-end valor-row mb-2">
                    <div class="col-md-4">
                        <label class="form-label">¿Qué se mide?</label>

                        <select name="ValoresConfigurados[0].ID_Catalogo_ValorObjetivo"
                                class="form-select form-select-sm catalogo-sm">

                                <option value="">Seleccione una métrica</option>

                                @if (ViewBag.CatalogoValores != null)
                                {
                                    foreach (var item in ViewBag.CatalogoValores)
                                    {
                                        <option value="@item.ID"
                                            data-unidad="@item.Unidad_Medida">
                                            @item.Nombre (@item.Unidad_Medida)
                                        </option>
                                    }
                                }
                            </select>

                            <input type="hidden"
                                   name="ValoresConfigurados[0].Tipo_Valor"
                                   class="tipo-valor" />

                            <input type="hidden"
                                   name="ValoresConfigurados[0].Unidad_Medida"
                                   class="unidad-medida" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Mínimo</label>
                        <input type="number" name="ValoresConfigurados[0].Valor_Minimo" class="form-control form-control-sm" step="0.01" placeholder="0.00" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Máximo</label>
                        <input type="number" name="ValoresConfigurados[0].Valor_Maximo" class="form-control form-control-sm" step="0.01" placeholder="0.00" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Objetivo</label>
                        <input type="number" name="ValoresConfigurados[0].Valor_Objetivo" class="form-control form-control-sm" step="0.01" placeholder="0.00" />
                    </div>
                    <div class="col-md-1">
                        <button type="button" class="btn btn-outline-danger btn-sm w-100 btn-eliminar-valor" title="Eliminar valor">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                </div>
            </div>

            <template id="plantillaValor">
    <div class="row g-2 align-items-end valor-row mb-2">

        <div class="col-md-4">
            <label class="form-label">¿Qué se mide?</label>

            <select name="ValoresConfigurados[__INDEX__].ID_Catalogo_ValorObjetivo"
                    class="form-select form-select-sm catalogo-sm">

                <option value="">Seleccione una métrica</option>

                @if (ViewBag.CatalogoValores != null)
                {
                    foreach (var item in ViewBag.CatalogoValores)
                    {
                        <option value="@item.ID"
                                data-unidad="@item.Unidad_Medida">
                            @item.Nombre (@item.Unidad_Medida)
                        </option>
                    }
                }
            </select>

            <input type="hidden"
                   name="ValoresConfigurados[__INDEX__].Tipo_Valor"
                   class="tipo-valor" />

            <input type="hidden"
                   name="ValoresConfigurados[__INDEX__].Unidad_Medida"
                   class="unidad-medida" />
        </div>

        <div class="col-md-2">
            <label class="form-label">Mínimo</label>
            <input type="number"
                   name="ValoresConfigurados[__INDEX__].Valor_Minimo"
                   class="form-control form-control-sm"
                   step="0.01"
                   placeholder="0.00" />
        </div>

        <div class="col-md-2">
            <label class="form-label">Máximo</label>
            <input type="number"
                   name="ValoresConfigurados[__INDEX__].Valor_Maximo"
                   class="form-control form-control-sm"
                   step="0.01"
                   placeholder="0.00" />
        </div>

        <div class="col-md-2">
            <label class="form-label">Objetivo</label>
            <input type="number"
                   name="ValoresConfigurados[__INDEX__].Valor_Objetivo"
                   class="form-control form-control-sm"
                   step="0.01"
                   placeholder="0.00" />
        </div>

        <div class="col-md-1">
            <button type="button"
                    class="btn btn-outline-danger btn-sm w-100 btn-eliminar-valor"
                    title="Eliminar valor">
                <i class="bi bi-trash"></i>
            </button>
        </div>

    </div>
</template>

            <!-- Agregar valor -->
            <div class="mt-3">
                <button type="button" id="btnAgregarValor" class="btn btn-outline-danger btn-sm">
                    <i class="bi bi-plus-circle me-1"></i> Agregar valor
                </button>
            </div>
        </div>

        <!-- Botonera -->
        <div class="mt-4 d-flex justify-content-end gap-2">
            <a asp-action="Tablero" asp-controller="Objetivos" class="btn btn-secondary">
                <i class="bi bi-x-circle me-1"></i> Cancelar
            </a>
            <button type="submit" class="btn btn-danger">
                <i class="bi bi-save me-1"></i> Guardar Objetivo
            </button>
        </div>
    </form>
</div>
</div>


<!-- Modal para Crear Nuevo KPI -->
<div class="modal fade" id="modalNuevoKpi" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header text-white" style="background: linear-gradient(180deg,#b30000 0%,#8b0000 100%);">
                <h6 class="modal-title fw-bold"><i class="bi bi-graph-up-arrow me-2"></i>Registrar Nuevo KPI</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4 bg-light">
                <div class="mb-3">
                    <label class="form-label fw-bold" style="font-size: 0.85rem;">Área del KPI *</label>
                    <select id="kpiPerfil" class="form-select form-select-sm" required>
                        @if (esAdmin)
                        {
                            <option value="">-- Selecciona el área --</option>
                        }

                        @if (ViewBag.Perfiles != null)
                        {
                            foreach (var p in ViewBag.Perfiles)
                            {
                                if (esAdmin || p.Id.ToString() == miPerfilId)
                                {
                                    if (!esAdmin)
                                    {
                                        <option value="@p.Id" selected>@p.Nombre</option>
                                    }
                                    else
                                    {
                                        <option value="@p.Id">@p.Nombre</option>
                                    }
                                }
                            }
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold" style="font-size: 0.85rem;">Nombre del Indicador *</label>
                    <input type="text" id="kpiNombre" class="form-control form-control-sm" placeholder="Ej. Rotación de Personal" required />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold" style="font-size: 0.85rem;">Descripción de lo que mide</label>
                    <textarea id="kpiDesc" class="form-control form-control-sm" rows="2" placeholder="Opcional..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger btn-sm fw-bold" id="btnGuardarKpi">
                    <i class="bi bi-save me-1"></i> Guardar y Usar
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalNuevoValorObjetivo" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">

            <div class="modal-header text-white"
                style="background: linear-gradient(180deg,#b30000 0%,#8b0000 100%);">

                <h6 class="modal-title fw-bold">
                    <i class="bi bi-sliders me-2"></i>
                    Configurar Valor de Objetivo
                </h6>

                <button type="button"
                        class="btn-close btn-close-white"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body p-4 bg-light">

                <div class="mb-3">
                    <label class="form-label fw-bold"
                            style="font-size: 0.85rem;">
                        Nombre *
                    </label>

                    <input type="text"
                            id="valorObjetivoNombre"
                            class="form-control form-control-sm"
                            placeholder="Ej. Peso por Caja"
                            required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold"
                            style="font-size: 0.85rem;">
                        Unidad de medida *
                    </label>

                    <input type="text"
                            id="valorObjetivoUnidad"
                            class="form-control form-control-sm"
                            placeholder="Ej. KG"
                            required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold"
                            style="font-size: 0.85rem;">
                        Descripción
                    </label>

                    <textarea id="valorObjetivoDescripcion"
                              class="form-control form-control-sm"
                              rows="3"
                              placeholder="Descripción de lo que representa este valor..."></textarea>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button"
                    class="btn btn-outline-secondary btn-sm"
                    data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button type="button"
                        class="btn btn-danger btn-sm fw-bold"
                        id="btnGuardarValorObjetivo">
                    <i class="bi bi-save me-1"></i>
                    Guardar y Usar
                </button>

            </div>

        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        (function () {
            if (!window.jQuery || !jQuery.fn.select2) return;
            jQuery('#cliente, #vendedor, #sku').select2({ width: '100%' });
        })();
    </script>
    <script>
        $(document).ready(function () {
            // Carga de KPIs segun el Area seleccionada
            $('#comboArea').change(function () {
                var areaId = $(this).val();
                var $comboKpi =$('#tipoObjetivo');

                $comboKpi.empty().append('<option value="">-- Selecciona el Tipo --</option>').prop('disabled', true);

                if (areaId) {
                    $.getJSON('@Url.Action("ObtenerKpisPorArea", "Objetivos")', { idPerfil: areaId }, function (data) {
                        if (data && data.length > 0) {
                            $.each(data, function (index, item) {
                                // Usamos item.Valor y item.Texto segun retorna el controlador
                                $comboKpi.append($('<option/>', { value: item.Valor, text: item.Texto }));
                            });
                            $comboKpi.prop('disabled', false);
                        } else {
                            $comboKpi.empty().append('<option value="">No hay KPIs para esta área</option>');
                        }
                    });
                } else {
                    $comboKpi.empty().append('<option value="">-- Esperando área... --</option>');
                }
            });

            // Dispara el evento al inicio por si el area ya viene seleccionada (usuarios sin permisos de Admin)
            if ($('#comboArea').val()) {
                $('#comboArea').trigger('change');
            }

            // Logica para crear KPI en tiempo real (AJAX)
            $('#btnGuardarKpi').click(function () {
                var idPerfil = $('#kpiPerfil').val();
                var nombre = $('#kpiNombre').val();
                var desc = $('#kpiDesc').val();

                if (!idPerfil || !nombre) {
                    alert("Por favor, selecciona un área y escribe el nombre del KPI.");
                    return;
                }

                var $btn = $(this);$btn.html('<i class="spinner-border spinner-border-sm"></i> Guardando...').prop('disabled', true);

                $.post('@Url.Action("CrearTipoObjetivo", "Objetivos")', {
                    idPerfil: idPerfil,
                    nombre: nombre,
                    descripcion: desc
                }, function (response) {
                    if (response.success) {
                        $('#kpiNombre').val('');
                        $('#kpiDesc').val('');
                        $('#modalNuevoKpi').modal('hide');

                        // Si el area en la que se creo es la misma que la del formulario principal, lo agregamos
                        if ($('#comboArea').val() == idPerfil) {
                            $('#tipoObjetivo').append($('<option/>', { value: response.id, text: response.nombre }));$('#tipoObjetivo').val(response.id).prop('disabled', false);
                        } else {
                            alert("KPI creado exitosamente.");
                        }

                    } else {
                        alert("Error al guardar: " + response.message);
                    }
                }).always(function() {
                    $btn.html('<i class="bi bi-save me-1"></i> Guardar y Usar').prop('disabled', false);
                });
            });

            // Crear nuevo Valor de Objetivo en el catálogo
            $('#btnGuardarValorObjetivo').click(function () {

                var nombre = $('#valorObjetivoNombre').val().trim();
                var unidad = $('#valorObjetivoUnidad').val().trim();
                var descripcion = $('#valorObjetivoDescripcion').val().trim();

                if (!nombre || !unidad){
                    alert("Por favor, capturar el nombre y la unidad de medida.");
                    return;
                }

                var $btn = $(this);

                $btn.html('<i class="spinner-border spinner-border-sm"></i> Guardando...')
                    .prop('disabled', true);

                $.post('@Url.Action("CrearValorObjetivo", "Objetivos")', {
                    nombre: nombre,
                    unidadMedida: unidad,
                    descripcion: descripcion
                }, function (response) {

                    if (response.success) {

                        // Agregar el nuevo valor al catálogo del formulario
                        $('.catalogo-sm').each(function () {

                            $(this).append(
                                $('<option/>', {
                                    value: response.id,
                                    text: response.nombre + '(' + response.unidad + ')',
                                    'data-unidad': response.unidad
                                })
                            );

                        });

                        // Seleccionar automáticamente el nuevo valor
                        var $ultimaFila = $('.valor-row').last();
                        var $select = $ultimaFila.find('.catalogo-sm');

                        $select.val(response.id).trigger('change');

                        // Limpiar formulario del modal
                        $('#valorObjetivoNombre').val('');
                        $('#valorObjetivoUnidad').val('');
                        $('#valorObjetivoDescripcion').val('');

                        // Cerrar modal
                        $('#modalNuevoValorObjetivo').modal('hide');

                    } else {

                        alert("Error al guardar: " + response.message);

                    }
                }).always(function () {

                    $btn.html('<i class="bi bi-save me-1"></i> Guardar y Usar')
                        .prop('disabled', false);

                });
            });

            // Carga dinamica de clientes segun el vendedor seleccionado
            function cargarClientesPorVendedor(idVendedor) {
                var $comboCliente = $('#cliente');
                $comboCliente.empty().append('<option value="">Cargando clientes...</option>');
                $.getJSON('@Url.Action("ObtenerClientesPorVendedor", "Objetivos")', { idVendedor: idVendedor }, function (data) {
                    $comboCliente.empty().append('<option value="">-- Selecciona un Cliente --</option>');
                    if (data && data.length > 0) {
                        $.each(data, function (index, item) {
                            $comboCliente.append($('<option/>', { value: item.Cliente, text: item.Nombrecliente }));
                        });
                    } else {
                        $comboCliente.append('<option value="">No hay clientes para este vendedor</option>');
                    }
                });
            }

            $('#vendedor').change(function () {
                cargarClientesPorVendedor($(this).val() || 0);
            });

            // Al iniciar, si ya viene un vendedor preseleccionado, cargar sus clientes
            if ($('#vendedor').val()) {
                $('#vendedor').trigger('change');
            }
        });

        // Logica de Filas Dinamicas
        let indiceValor = 1;

        function renumerarValores() {

    const filas = document.querySelectorAll(".valor-row");

    filas.forEach((fila, indice) => {

        const campos = fila.querySelectorAll("input, select");

        campos.forEach(campo => {

            const nombre = campo.name;

            if (!nombre) return;

            campo.name = nombre.replace(
                /ValoresConfigurados\[\d+\]/,
                `ValoresConfigurados[${indice}]`
            );
        });
    });

    indiceValor = filas.length;
}

        document.getElementById("btnAgregarValor").addEventListener("click", function () {

    const container = document.getElementById("valoresContainer");
    const plantilla = document.getElementById("plantillaValor");

    const nuevaFila = plantilla.content.cloneNode(true);

    nuevaFila.querySelectorAll("[name]").forEach(elemento => {
        elemento.name = elemento.name.replace(
            /__INDEX__/g,
            indiceValor
        );
    });

    container.appendChild(nuevaFila);

    indiceValor++;
});

        document.getElementById("valoresContainer").addEventListener("click", function (e) {
            const botonEliminar = e.target.closest(".btn-eliminar-valor");

            if(!botonEliminar) return;

            const filas = document.querySelectorAll(".valor-row");

            // Mantener al menos una fila
            if (filas.length <= 1) return;

            botonEliminar.closest(".valor-row").remove();
            renumerarValores();
        });

        document.getElementById("valoresContainer").addEventListener("change", function (e) {

            if (!e.target.classList.contains("catalogo-sm")) return;

            const select = e.target;
            const opcion = select.options[select.selectedIndex];
            const fila = select.closest(".valor-row");

            const tipoValor = fila.querySelector(".tipo-valor");
            const unidadMedida = fila.querySelector(".unidad-medida");

            if (!opcion || !opcion.value) {
                tipoValor.value = "";
                unidadMedida.value = "";
                return;
            }

            tipoValor.value = opcion.textContent
                .replace(/\s*\([^)]*\)\s*$/, "")
                .trim();

            unidadMedida.value = opcion.dataset.unidad || "";
        });
    </script>
}