@model IEnumerable<Plataforma_CG.Models.ObjetivoViewModel>

@{
    Layout = "~/Views/Shared/_Layout2.cshtml";
    ViewData["Title"] = "Gestión de Objetivos";
}

<style>
    body, main {
        padding: 0 !important;
        margin: 0 !important;
    }

    .container-fluid {
        padding-left: 0 !important;
        padding-right: 0 !important;
    }

    .top-banner {
        background: linear-gradient(180deg,#b30000 0%,#8b0000 100%) !important;
        color: white;
        padding: 1.5rem 2rem;
        box-shadow: 0 4px 12px rgba(0,0,0,.15);
    }

    .table-custom th {
        background: linear-gradient(180deg,#b30000 0%,#8b0000 100%) !important;
        color: white !important;
        font-size: 0.75rem;
        text-transform: uppercase;
        vertical-align: middle;
        border-bottom: none;
    }

    .table-custom td {
        vertical-align: middle;
        font-size: 0.85rem;
    }
</style>

<div class="container-fluid p-0">

    <!-- Encabezado superior -->
    <div class="top-banner d-flex justify-content-between align-items-center">
        <div>
            <h3 class="fw-bold mb-1">Gestión de Objetivos</h3>
            <p class="mb-0" style="opacity: 0.9; font-size: 0.85rem;">Configuración y listado de metas operativas por área.</p>
        </div>
        <div>
            <button type="button" class="btn btn-outline-light fw-bold shadow-sm me-2" data-bs-toggle="modal" data-bs-target="#modalBitacora">
                Bitácora
            </button>
            <button type="button" class="btn btn-outline-light fw-bold shadow-sm me-2" data-bs-toggle="modal" data-bs-target="#modalCargarExcel">
                <i class="bi bi-file-earmark-excel me-1"></i> Cargar Excel
            </button>
            <a href="@Url.Action("Nuevo", "Objetivos")" class="btn btn-light fw-bold text-danger shadow-sm">
                <i class="bi bi-plus-circle-fill me-1"></i> Crear Nuevo Objetivo
            </a>
        </div>
    </div>

    @if (TempData["ErrorObjetivos"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show mx-3 shadow-sm mt-3">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorObjetivos"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["OkObjetivos"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show mx-3 shadow-sm mt-3">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["OkObjetivos"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Barra de filtros -->
    <div class="card rounded-0 border-start-0 border-end-0 shadow-sm mb-3 mt-3">
        <div class="card-body py-3 px-4">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-bold text-muted mb-1" style="font-size: 0.8rem;">Buscar</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" id="filtroTexto" class="form-control" placeholder="Buscar por Tipo Objetivo" />
                    </div>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-bold text-muted mb-1" style="font-size: 0.8rem;">Filtrar por Área</label>
                    <select id="filtroArea" class="form-select form-select-sm">
                        <option value="">Todas las Áreas</option>
                        @if (ViewBag.Perfiles != null)
                        {
                            foreach (var p in ViewBag.Perfiles)
                            {
                                <option value="@p.Nombre">@p.Nombre</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label fw-bold text-muted mb-1" style="font-size: 0.8rem;">Filtrar por Estado</label>
                    <select id="filtroEstado" class="form-select form-select-sm">
                        <option value="">Todos los Estados</option>
                        <option value="Pendiente">Pendientes</option>
                        <option value="Activo">Activos</option>
                        <option value="Cancelado">Cancelados</option>
                    </select>
                </div>

                <div class="col-md-3 text-end">
                    <button type="button" id="btnLimpiarFiltros" class="btn btn-sm btn-outline-secondary">
                        <i class=""></i> Limpiar Filtros
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla principal -->
    <div class="card rounded-0 border-0 shadow-sm mx-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-custom mb-0" id="tablaObjetivos">
                    <thead>
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Área / Perfil</th>
                            <th>Tipo de Objetivo</th>
                            <th>Periodo</th>
                            <th>Vigencia</th>
                            <th class="text-center">Métricas</th>
                            <th>Estado</th>
                            <th class="text-center pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr class="fila-objetivo">
                                    <td class="ps-4 fw-bold text-muted">#@item.ID</td>
                                    <td class="col-area"><span class="badge bg-secondary">@item.NombrePerfil</span></td>
                                    <td class="fw-bold">@item.NombreTipoObjetivo</td>
                                    <td><span class="badge border border-secondary text-secondary"><i class="bi bi-calendar-range me-1"></i>@item.Tipo_Periodo_Cumplimiento</span></td>
                                    <td>
                                        <small class="d-block text-muted">Desde: <strong>@item.Fecha_Desde.ToString("dd/MMM/yyyy")</strong></small>
                                        <small class="d-block text-muted">Hasta: <strong>@(item.Fecha_Hasta?.ToString("dd/MMM/yyyy") ?? "Sin límite")</strong></small>
                                    </td>
                                    <td class="text-center">
                                        @if (item.ValoresConfigurados != null && item.ValoresConfigurados.Any())
                                        {
                                            <span class="badge border border-secondary text-secondary">@item.ValoresConfigurados.Count métrica(s)</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic" style="font-size: 0.75rem;">Sin valores</span>
                                        }
                                    </td>
                                    <td class="col-estado">
                                        @if (item.Estado == "Activo")
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                        else if (item.Estado == "Pendiente")
                                        {
                                            <span class="badge bg-warning text-dark">Pendiente</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@item.Estado</span>
                                        }
                                    </td>
                                    <td class="text-center pe-4">
                                        <button type="button" class="btn btn-sm btn-outline-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#modalDetalle-@item.ID" title="Ver Detalles">
                                            <i class="bi bi-eye-fill"></i> Ver
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr id="filaVacia">
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                                    Aún no hay objetivos registrados.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Renderizado de modales -->
@if (Model != null && Model.Any())
{
    foreach (var item in Model)
    {
        <!-- Modal Detalles -->
        <div class="modal fade" id="modalDetalle-@item.ID" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-xl modal-dialog-centered">
                <div class="modal-content shadow-lg border-0">

                    <div class="modal-header text-white" style="background: linear-gradient(180deg,#b30000 0%,#8b0000 100%);">
                        <h5 class="modal-title fw-bold" id="tituloModal-@item.ID">
                            Detalles del Objetivo #@item.ID
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>

                    <div class="modal-body p-4">
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <div class="card h-100 shadow-sm border">
                                    <div class="card-body p-3">
                                        <h6 class="text-danger fw-bold border-bottom pb-2 mb-3">Información General</h6>
                                        <p class="mb-1"><small class="text-muted fw-bold">Área:</small> <span class="badge bg-secondary">@item.NombrePerfil</span></p>
                                        <p class="mb-1"><small class="text-muted fw-bold">Tipo Objetivo:</small> <span class="fw-bold">@item.NombreTipoObjetivo</span></p>
                                        <p class="mb-1">
                                            <small class="text-muted fw-bold">Estado:</small>
                                            @if (item.Estado == "Activo")
                                            {
                                                <span class="badge bg-success">@item.Estado</span>
                                            }
                                            else if (item.Estado == "Pendiente")
                                            {
                                                <span class="badge bg-warning text-dark">@item.Estado</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">@item.Estado</span>
                                            }
                                        </p>
                                        <p class="mb-0"><small class="text-muted fw-bold">Creado el:</small> <span>@item.Fecha_Creacion.ToString("dd/MM/yyyy HH:mm")</span></p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="card h-100 shadow-sm border">
                                    <div class="card-body p-3">
                                        <h6 class="text-danger fw-bold border-bottom pb-2 mb-3">Vigencia y Frecuencia</h6>
                                        <p class="mb-1"><small class="text-muted fw-bold">Evaluación:</small> <span>@item.Tipo_Periodo_Cumplimiento</span></p>
                                        <p class="mb-1"><small class="text-muted fw-bold">Inicio:</small> <span>@item.Fecha_Desde.ToString("dd/MMM/yyyy")</span></p>
                                        <p class="mb-0"><small class="text-muted fw-bold">Fin:</small> <span>@(item.Fecha_Hasta?.ToString("dd/MMM/yyyy") ?? "Sin límite")</span></p>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="card shadow-sm border mb-3">
                            <div class="card-body p-3">
                                <h6 class="text-danger fw-bold border-bottom pb-2 mb-3">Detalles Operativos y Comerciales</h6>
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <small class="text-muted fw-bold d-block">Cliente:</small>
                                        <span>@(string.IsNullOrEmpty(item.ID_Cliente) ? "No especificado" : item.ID_Cliente)</span>
                                    </div>
                                    <div class="col-md-4">
                                        <small class="text-muted fw-bold d-block">Vendedor:</small>
                                        @if (!string.IsNullOrEmpty(item.NombreVendedor))
                                        {
                                            <span>@item.NombreVendedor</span>
                                            @if (!string.IsNullOrEmpty(item.UsuarioVendedor))
                                            {
                                                <small class="text-muted d-block">Usuario: @item.UsuarioVendedor</small>
                                                <small class="text-muted d-block">ID: @item.UsuarioID_Vendedor</small>
                                            }
                                        }
                                        else
                                        {
                                            <span>No especificado</span>
                                        }
                                        
                                    </div>
                                    <div class="col-md-4">
                                        <small class="text-muted fw-bold d-block">Proveedor:</small>
                                        <span>@(string.IsNullOrEmpty(item.Proveedor) ? "No especificado" : item.Proveedor)</span>
                                    </div>

                                    <div class="col-md-4">
                                        <small class="text-muted fw-bold d-block">SKU:</small>

                                        @if (!string.IsNullOrEmpty(item.SKU))
                                        {
                                            <span class="fw-bold">
                                                @item.SKU
                                                @if (!string.IsNullOrEmpty(item.NombreArticulo))
                                                {
                                                    <text> - @item.NombreArticulo</text>   
                                                }
                                            </span>
                                        }
                                        else
                                        {
                                            <span>No especificado</span>
                                        }

                                        
                                    </div>

                                    <div class="col-md-4">
                                        <small class="text-muted fw-bold d-block">Línea:</small>
                                        <span>@(string.IsNullOrEmpty(item.Linea) ? "No especificado" : item.Linea)</span>
                                    </div>
                                    <div class="col-md-4">
                                        <small class="text-muted fw-bold d-block">Cuenta Contable:</small>
                                        <span>@(string.IsNullOrEmpty(item.CC) ? "No especificado" : item.CC)</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        @if (!string.IsNullOrEmpty(item.Descripcion_Objetivo))
                        {
                            <div class="card shadow-sm border mb-3">
                                <div class="card-body p-3">
                                    <h6 class="text-danger fw-bold border-bottom pb-2 mb-2">Descripción / Notas</h6>
                                    <p class="mb-0" style="font-size: 0.9rem;">@item.Descripcion_Objetivo</p>
                                </div>
                            </div>
                        }

                        <div class="card shadow-sm border">
                            <div class="card-body p-3">
                                <h6 class="text-danger fw-bold border-bottom pb-2 mb-3">Metas Configuradas</h6>
                                <div class="table-responsive">
                                    <table class="table table-sm table-bordered mb-0 text-center">
                                        <thead class="table-secondary">
                                            <tr>
                                                <th>¿Qué se mide?</th>
                                                <th>Unidad</th>
                                                <th>Mínimo</th>
                                                <th>Máximo</th>
                                                <th>Objetivo</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (item.ValoresConfigurados != null && item.ValoresConfigurados.Any())
                                            {
                                                foreach (var val in item.ValoresConfigurados)
                                                {
                                                    <tr>
                                                        <td class="align-middle text-start ps-3">@val.Tipo_Valor</td>
                                                        <td class="align-middle">@val.Unidad_Medida</td>
                                                        <td class="align-middle text-muted">@(val.Valor_Minimo?.ToString("0.00") ?? "-")</td>
                                                        <td class="align-middle text-muted">@(val.Valor_Maximo?.ToString("0.00") ?? "-")</td>
                                                        <td class="align-middle fw-bold fs-6 text-danger">@(val.Valor_Objetivo?.ToString("0.00") ?? "-")</td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr><td colspan="5" class="text-muted py-3">No hay metas configuradas.</td></tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer border-top-0">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>

                        @if (ViewBag.PuedeEliminarObjetivos == true)
                        {
                            <button type="button" class="btn btn-warning text-dark fw-bold shadow-sm" onclick="intercambiarModales('modalDetalle-@item.ID', 'modalEditar-@item.ID')">
                                <i class="bi bi-pencil-square me-1"></i> Editar
                            </button>

                            @if (item.Estado == "Pendiente")
                            {
                                <form asp-action="Autorizar" asp-controller="Objetivos" method="post" class="d-inline" onsubmit="return confirm('¿Estás seguro de autorizar este objetivo?');">
                                    <input type="hidden" name="id" value="@item.ID" />
                                    <button type="submit" class="btn btn-success fw-bold shadow-sm">
                                        <i class="bi bi-check-circle me-1"></i> Autorizar
                                    </button>
                                </form>
                            }

                            <form asp-action="Cancelar" asp-controller="Objetivos" method="post" class="d-inline" onsubmit="return confirm('¿Estás seguro de cancelar este objetivo?');">
                                <input type="hidden" name="id" value="@item.ID" />
                                <button type="submit" class="btn btn-danger fw-bold shadow-sm">
                                    <i class="bi bi-x-circle me-1"></i> Cancelar
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal Editar -->
        <div class="modal fade" id="modalEditar-@item.ID" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-xl modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg">

                    <form asp-action="Editar" asp-controller="Objetivos" method="post">
                        <input type="hidden" name="ID" value="@item.ID" />

                        <div class="modal-header text-dark" style="background-color: #ffc107;">
                            <h5 class="modal-title fw-bold">
                                Editar Objetivo #@item.ID
                            </h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                        </div>

                        <div class="modal-body p-4">
                            <div class="alert alert-warning border shadow-sm mb-4">
                                <strong class="text-danger">Área:</strong> @item.NombrePerfil &nbsp;|&nbsp;
                                <strong class="text-danger">Tipo Objetivo:</strong> @item.NombreTipoObjetivo
                            </div>

                            <div class="row g-3 mb-4">
                                <div class="col-md-4">
                                    <label class="form-label fw-bold" style="font-size: 0.85rem;">Estado</label>
                                    <select name="Estado" class="form-select form-select-sm">
                                        @foreach (var est in new[] { "Activo", "Pendiente", "Cancelado", "Inactivo" })
                                        {
                                            @if (est == item.Estado)
                                            {
                                                <option value="@est" selected>@est</option>
                                            }
                                            else
                                            {
                                                <option value="@est">@est</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold" style="font-size: 0.85rem;">Periodo de cumplimiento</label>
                                    <select name="Tipo_Periodo_Cumplimiento" class="form-select form-select-sm">
                                        @foreach (var op in new[] { "Diario", "Semanal", "Mensual", "Trimestral", "Anual" })
                                        {
                                            @if (op == item.Tipo_Periodo_Cumplimiento)
                                            {
                                                <option value="@op" selected>@op</option>
                                            }
                                            else
                                            {
                                                <option value="@op">@op</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold" style="font-size: 0.85rem;">Fecha Desde</label>
                                    <input type="date" name="Fecha_Desde" class="form-control form-control-sm" value="@item.Fecha_Desde.ToString("yyyy-MM-dd")" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold" style="font-size: 0.85rem;">Fecha Hasta</label>
                                    <input type="date" name="Fecha_Hasta" class="form-control form-control-sm" value="@(item.Fecha_Hasta?.ToString("yyyy-MM-dd"))" />
                                </div>

                                <!-- SECCIÓN MODIFICADA: Select2 Nativo sin inputs adicionales -->
                                <div class="col-md-4">
                                    <label class="form-label fw-bold" style="font-size: 0.85rem;">Cliente</label>
                                    <select name="ID_Cliente" class="form-select form-select-sm select2-buscar" id="selCliente-@item.ID">
                                        <option value="">-- Selecciona un Cliente --</option>
                                        @if (ViewBag.Clientes != null)
                                        {
                                            foreach (var c in ViewBag.Clientes)
                                            {
                                                @if (c.Cliente.ToString() == (item.ID_Cliente ?? ""))
                                                {
                                                    <option value="@c.Cliente" selected>@c.Nombrecliente</option>
                                                }
                                                else
                                                {
                                                    <option value="@c.Cliente">@c.Nombrecliente</option>
                                                }
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold" style="font-size: 0.85rem;">Vendedor</label>
                                    <select name="UsuarioID_Vendedor" class="form-select form-select-sm select2-buscar" id="selVendedor-@item.ID">
                                        <option value="">-- Selecciona un Vendedor --</option>
                                        @if (ViewBag.Vendedores != null)
                                        {
                                            foreach (var v in ViewBag.Vendedores)
                                            {
                                                @if ((item.UsuarioID_Vendedor ?? 0) == (int)v.Id)
                                                {
                                                    <option value="@v.Id" selected>@v.Nombre</option>
                                                }
                                                else
                                                {
                                                    <option value="@v.Id">@v.Nombre</option>
                                                }
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold" style="font-size: 0.85rem;">Proveedor</label>
                                    <input type="text" name="Proveedor" class="form-control form-control-sm" value="@item.Proveedor" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold" style="font-size: 0.85rem;">SKU</label>
                                    <select name="SKU" class="form-select form-select-sm select2-buscar" id="selSku-@item.ID">
                                        <option value="">-- Selecciona un SKU --</option>
                                        @if (ViewBag.Articulos != null)
                                        {
                                            foreach (var a in ViewBag.Articulos)
                                            {
                                                @if (a.ProductoCodigo.ToString() == (item.SKU ?? ""))
                                                {
                                                    <option value="@a.ProductoCodigo" selected>@a.ProductoCodigo - @a.ProductoNombre</option>
                                                }
                                                else
                                                {
                                                    <option value="@a.ProductoCodigo">@a.ProductoCodigo - @a.ProductoNombre</option>
                                                }
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-bold" style="font-size: 0.85rem;">Cuenta Contable</label>
                                    <input type="text" name="CC" class="form-control form-control-sm" value="@item.CC" />
                                </div>
                                <div class="col-md-12">
                                    <label class="form-label fw-bold" style="font-size: 0.85rem;">Línea</label>
                                    <input type="text" name="Linea" class="form-control form-control-sm" value="@item.Linea" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label fw-bold" style="font-size: 0.85rem;">Descripción / Notas</label>
                                    <textarea name="Descripcion_Objetivo" class="form-control form-control-sm" rows="2">@item.Descripcion_Objetivo</textarea>
                                </div>
                            </div>

                            <div class="card shadow-sm border">
                                <div class="card-body p-3">
                                    <h6 class="text-danger fw-bold border-bottom pb-2 mb-3">Actualizar Metas</h6>
                                    <div class="table-responsive">
                                        <table class="table table-sm table-bordered mb-0 text-center">
                                            <thead class="table-secondary">
                                                <tr>
                                                    <th>¿Qué se mide?</th>
                                                    <th>Unidad</th>
                                                    <th>Mínimo</th>
                                                    <th>Máximo</th>
                                                    <th>Meta Esperada</th>
                                                    <th>Acciones</th>
                                                </tr>
                                            </thead>
                                            <tbody id="tbodyMetas-@item.ID">
                                                @if (item.ValoresConfigurados != null && item.ValoresConfigurados.Any())
                                                {
                                                    int i = 0;

                                                    foreach (var val in item.ValoresConfigurados)
                                                    {
                                                        <tr>
                                                            <input type="hidden"
                                                                   name="ValoresConfigurados.Index"
                                                                   value="v@(i)" />

                                                            <input type="hidden"
                                                                   name="ValoresConfigurados[v@(i)].ID"
                                                                   value="@val.ID" />

                                                            <td class="align-middle text-start ps-3">

                                                                <select name="ValoresConfigurados[v@(i)].ID_Catalogo_ValorObjetivo"
                                                                        class="form-select form-select-sm catalogo-editar">

                                                                    <option value="">Seleccione una métrica</option>

                                                                    @if (ViewBag.CatalogoValores != null)
                                                                    {
                                                                        foreach (var catalogo in ViewBag.CatalogoValores)
                                                                        {
                                                                            if (Convert.ToInt32(catalogo.ID) == Convert.ToInt32(val.ID_Catalogo_ValorObjetivo))
                                                                            {
                                                                                <option value="@catalogo.ID"
                                                                                        data-unidad="@catalogo.Unidad_Medida"
                                                                                        selected>
                                                                                    @catalogo.Nombre (@catalogo.Unidad_Medida)
                                                                                </option>
                                                                            }
                                                                            else
                                                                            {
                                                                                <option value="@catalogo.ID"
                                                                                        data-unidad="@catalogo.Unidad_Medida">
                                                                                    @catalogo.Nombre (@catalogo.Unidad_Medida)
                                                                                </option>
                                                                            }
                                                                        }
                                                                    }

                                                                </select>

                                                                <input type="hidden"
                                                                       name="ValoresConfigurados[v@(i)].Tipo_Valor"
                                                                       class="tipo-valor-editar"
                                                                       value="@val.Tipo_Valor" />

                                                                <input type="hidden"
                                                                       name="ValoresConfigurados[v@(i)].Unidad_Medida"
                                                                       class="unidad-medida-editar"
                                                                       value="@val.Unidad_Medida" />

                                                            </td>

                                                            <td class="align-middle">
                                                                <span class="unidad-visible-editar">
                                                                    @val.Unidad_Medida
                                                                </span>
                                                            </td>

                                                            <td>
                                                                <input type="number"
                                                                       step="0.01"
                                                                       name="ValoresConfigurados[v@(i)].Valor_Minimo"
                                                                       class="form-control form-control-sm text-center"
                                                                       value="@val.Valor_Minimo" />
                                                            </td>

                                                            <td>
                                                                <input type="number"
                                                                       step="0.01"
                                                                       name="ValoresConfigurados[v@(i)].Valor_Maximo"
                                                                       class="form-control form-control-sm text-center"
                                                                       value="@val.Valor_Maximo" />
                                                            </td>

                                                            <td>
                                                                <input type="number"
                                                                       step="0.01"
                                                                       name="ValoresConfigurados[v@(i)].Valor_Objetivo"
                                                                       class="form-control form-control-sm text-center fw-bold text-danger"
                                                                       value="@val.Valor_Objetivo" />
                                                            </td>

                                                            <td class="align-middle">
                                                                <button type="button"
                                                                        class="btn btn-outline-danger btn-sm btnEliminarMeta"
                                                                        title="Eliminar meta">
                                                                    <i class="bi bi-trash"></i>
                                                                </button>
                                                            </td>
                                                        </tr>

                                                        i++;
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    <button type="button" class="btn btn-outline-danger btn-sm btnAgregarMeta mt-2" data-tbody="tbodyMetas-@item.ID">
                                        <i class="bi bi-plus-circle me-1"></i> Agregar meta
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="modal-footer border-top-0">
                            <button type="button" class="btn btn-outline-secondary" onclick="intercambiarModales('modalEditar-@item.ID', 'modalDetalle-@item.ID')">
                                <i class="bi bi-arrow-left me-1"></i> Volver a Detalles
                            </button>
                            <button type="submit" class="btn btn-success fw-bold shadow-sm">
                                <i class="bi bi-save me-1"></i> Guardar Cambios
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}

<!-- Modal Bitácora -->
<div class="modal fade" id="modalBitacora" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header text-white" style="background: linear-gradient(180deg,#b30000 0%,#8b0000 100%);">
                <h5 class="modal-title fw-bold">Bitácora de Objetivos</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-3">
                <div class="row g-2 align-items-center mb-3">
                    <div class="col-md-4">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input type="text" id="filtroLogTexto" class="form-control" placeholder="Buscar por folio, área, Tipo Objetivo, usuario..." />
                        </div>
                    </div>
                    <div class="col-md-3">
                        <select id="filtroLogEstado" class="form-select form-select-sm">
                            <option value="">Todos los Estados</option>
                            <option value="Activo">Activo</option>
                            <option value="Pendiente">Pendiente</option>
                            <option value="Cancelado">Cancelado</option>
                            <option value="Inactivo">Inactivo</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="button" id="btnLimpiarLog" class="btn btn-sm btn-outline-secondary">
                            <i class=""></i> Limpiar
                        </button>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover table-sm table-bordered mb-0 align-middle" id="tablaBitacora">
                        <thead class="table-secondary">
                            <tr>
                                <th>ID</th>
                                <th>Área / Perfil</th>
                                <th>Tipo de Objetivo</th>
                                <th>Estado</th>
                                <th>Creado por</th>
                                <th>Modificado por</th>
                                <th>Autorizado por</th>
                            </tr>
                        </thead>
                        <tbody id="logBody">
                            @{
                                var logObjetivos = ViewBag.LogObjetivos as List<Plataforma_CG.Models.ObjetivoLogViewModel>;
                            }
                            @if (logObjetivos != null && logObjetivos.Any())
                            {
                                foreach (var it in logObjetivos)
                                {
                                    <tr class="fila-log">
                                        <td class="fw-bold text-muted">#@it.ID</td>
                                        <td><span class="badge bg-secondary">@it.NombrePerfil</span></td>
                                        <td class="fw-bold">@it.NombreTipoObjetivo</td>
                                        <td class="col-estado">
                                            @if (it.Estado == "Activo")
                                            {
                                                <span class="badge bg-success">Activo</span>
                                            }
                                            else if (it.Estado == "Pendiente")
                                            {
                                                <span class="badge bg-warning text-dark">Pendiente</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">@it.Estado</span>
                                            }
                                        </td>
                                        <td>
                                            <small class="d-block"><strong>@(it.NombreCreador ?? it.UsuarioCreacion ?? "—")</strong></small>
                                            <small class="d-block text-muted">@it.Fecha_Creacion.ToString("dd/MM/yyyy HH:mm")</small>
                                        </td>
                                        <td>
                                            @if (it.Fecha_Modificacion.HasValue)
                                            {
                                                <small class="d-block"><strong>@(it.NombreModificador ?? it.UsuarioModificacion ?? "—")</strong></small>
                                                <small class="d-block text-muted">@it.Fecha_Modificacion.Value.ToString("dd/MM/yyyy HH:mm")</small>
                                            }
                                            else
                                            {
                                                <small class="text-muted fst-italic">Sin modificar</small>
                                            }
                                        </td>
                                        <td>
                                            @if (it.Fecha_Aprueba.HasValue)
                                            {
                                                <small class="d-block"><strong>@(it.NombreAutorizador ?? it.UsuarioAprueba ?? "—")</strong></small>
                                                <small class="d-block text-muted">@it.Fecha_Aprueba.Value.ToString("dd/MM/yyyy HH:mm")</small>
                                            }
                                            else
                                            {
                                                <small class="text-muted fst-italic">Sin autorizar</small>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="7" class="text-center text-muted py-4">No hay registros en la bitácora.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL CARGA MASIVA DESDE EXCEL -->
<div class="modal fade" id="modalCargarExcel" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header text-white" style="background: linear-gradient(180deg,#b30000 0%,#8b0000 100%);">
                <h5 class="modal-title fw-bold"><i class="bi bi-file-earmark-excel me-2"></i>Carga Masiva de Objetivos</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-4">
                <div class="alert alert-info small mb-3">
                    <i class="bi bi-info-circle-fill me-1"></i>
                    Descarga la plantilla, llénala <strong>una fila por meta</strong> y súbela.
                    Al procesar: si el objetivo todavía está <strong>Pendiente</strong> se actualiza;
                    si ya está <strong>Activo / cumplido</strong> <strong>NO se toca</strong> (se omite); y los nuevos se insertan.
                    El archivo solo se acepta en formato <strong>.xlsx</strong>.
                </div>
                <div class="mb-3">
                    <a href="@Url.Action("DescargarPlantillaObjetivos", "Objetivos")" class="btn btn-outline-danger btn-sm shadow-sm">
                        <i class="bi bi-download me-1"></i> Descargar Plantilla (.xlsx)
                    </a>
                </div>
                <form id="formCargaObjetivos" enctype="multipart/form-data" method="post">
                    <div class="mb-3">
                        <label for="archivoObjetivos" class="form-label fw-bold text-muted" style="font-size: 0.85rem;">Archivo Excel</label>
                        <input type="file" class="form-control" id="archivoObjetivos" name="archivo" accept=".xlsx" />
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-danger fw-bold shadow-sm" id="btnCargarObjetivos">
                            <i class="bi bi-upload me-1"></i> Cargar Objetivos
                        </button>
                    </div>
                </form>
                <div id="resultadoCargaObjetivos" class="mt-3"></div>
            </div>
        </div>
    </div>
</div>

<!-- ==========================================
     ESTILOS Y SCRIPTS PARA EL BUSCADOR (SELECT2)
     ========================================== -->
<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />

<style>
    /* Ajustes para que el buscador respete el modo oscuro/claro y el modal */
    .select2-container--bootstrap-5 .select2-selection {
        min-height: 31px !important;
        border: 1px solid var(--border-color, #ced4da) !important;
        border-radius: 0.25rem !important;
        background-color: var(--input-bg, #fff) !important;
    }

    .select2-container--bootstrap-5 .select2-selection__rendered {
        line-height: 25px !important;
        font-size: 0.85rem !important;
        padding-left: 0.75rem !important;
        color: var(--text-main, #4a4a4a) !important;
    }

    .select2-container--bootstrap-5 .select2-dropdown {
        font-size: 0.85rem !important;
        background-color: var(--bg-card, #fff) !important;
        border-color: var(--border-color, #ced4da) !important;
    }

    .select2-container--bootstrap-5 .select2-search__field {
        background-color: var(--input-bg, #fff) !important;
        color: var(--text-main, #4a4a4a) !important;
        border: 1px solid var(--border-color, #ced4da) !important;
    }

    .select2-container--bootstrap-5 .select2-results__option {
        color: var(--text-main, #4a4a4a) !important;
    }

    .select2-container--bootstrap-5 .select2-results__option--highlighted[aria-selected] {
        background-color: #8b0000 !important;
        color: white !important;
    }

    /* Z-index altísimo para que el buscador no se esconda detrás del modal */
    .select2-container, .select2-dropdown {
        z-index: 99999 !important;
    }
</style>

@section Scripts {
    <!-- IMPORTANTE: El script debe ir aquí adentro para que encuentre jQuery -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        $(document).ready(function () {

            // 1. Inicializar Select2 con Buscador
            function iniciarSelect2() {
                if (!$.fn.select2) return;

                $('.select2-buscar').each(function () {
                    var $select =$(this);

                    // Si ya está inicializado, lo saltamos
                    if ($select.hasClass("select2-hidden-accessible")) return;

                    var $modal = $select.closest('.modal');$select.select2({
                        theme: 'bootstrap-5',
                        width: '100%',
                        // Si está dentro de un modal, se ancla al modal para evitar bugs de enfoque
                        dropdownParent: $modal.length ? $modal :$(document.body)
                    });
                });
            }

            // Ejecutamos al cargar la página
            iniciarSelect2();

            // Si los modales se abren después, nos aseguramos de que Select2 funcione
            $('.modal').on('shown.bs.modal', function () {
                iniciarSelect2();
            });

            // 2. Buscador y Filtros de la Tabla
            $('#filtroTexto, #filtroArea, #filtroEstado').on('input change', function () {
                ejecutarFiltros();
            });

            $('#btnLimpiarFiltros').click(function() {
                $('#filtroTexto').val('');
                $('#filtroArea').val('');
                $('#filtroEstado').val('');
                ejecutarFiltros();
            });

            function ejecutarFiltros() {
                var textoBuscado = $('#filtroTexto').val().toLowerCase();
                var areaSeleccionada = $('#filtroArea').val().toLowerCase();
                var estadoSeleccionado = $('#filtroEstado').val().toLowerCase();

                $('.fila-objetivo').each(function () {
                    var $fila =$(this);
                    var textoFila = $fila.text().toLowerCase();
                    var textoArea = $fila.find('.col-area').text().toLowerCase();
                    var textoEstado = $fila.find('.col-estado').text().toLowerCase();

                    var coincideTexto = textoFila.indexOf(textoBuscado) > -1;
                    var coincideArea = areaSeleccionada === "" || textoArea.indexOf(areaSeleccionada) > -1;
                    var coincideEstado = estadoSeleccionado === "" || textoEstado.indexOf(estadoSeleccionado) > -1;

                    if (coincideTexto && coincideArea && coincideEstado) {
                        $fila.show();
                    } else {
                        $fila.hide();
                    }
                });
            }

            // 3. Filtros Bitácora
            $('#filtroLogTexto, #filtroLogEstado').on('input change', function () {
                aplicarFiltrosLog();
            });

            $('#btnLimpiarLog').click(function() {
                $('#filtroLogTexto').val('');
                $('#filtroLogEstado').val('');
                aplicarFiltrosLog();
            });

            function aplicarFiltrosLog() {
                var texto = $('#filtroLogTexto').val().toLowerCase();
                var estado = $('#filtroLogEstado').val().toLowerCase();

                $('.fila-log').each(function () {
                    var $fila =$(this);
                    var t = $fila.text().toLowerCase();
                    var e = $fila.find('.col-estado').text().toLowerCase();

                    var coincide = (!texto || t.indexOf(texto) > -1) && (!estado || e.indexOf(estado) > -1);
                    if (coincide) {
                        $fila.show();
                    } else {
                        $fila.hide();
                    }
                });
            }

            // 4. Lógica dinámica para Metas
                    var contadorMetaGlobal = 1000;

        $(document).on('click', '.btnAgregarMeta', function () {

            var tbodyId = $(this).attr('data-tbody');
            var $tbody = $('#' + tbodyId);

            if (!$tbody.length) return;

            var clave = 'n' + (++contadorMetaGlobal);

            var opcionesCatalogo = '<option value="">Seleccione una métrica</option>';

            @if (ViewBag.CatalogoValores != null)
            {
                    foreach (var catalogo in ViewBag.CatalogoValores)
                    {
                            <text>
                                opcionesCatalogo += `
                                    <option value="@catalogo.ID"
                            data-unidad="@catalogo.Unidad_Medida">
                                            @catalogo.Nombre (@catalogo.Unidad_Medida)
                                    </option>`;
                            </text>
                    }
            }

            var tr = `<tr>

                <input type="hidden"
                       name="ValoresConfigurados.Index"
                       value="${clave}" />

                <input type="hidden"
                       name="ValoresConfigurados[${clave}].ID"
                       value="0" />

                <td class="align-middle text-start ps-3">

                    <select name="ValoresConfigurados[${clave}].ID_Catalogo_ValorObjetivo"
                            class="form-select form-select-sm catalogo-editar">
                        ${opcionesCatalogo}
                    </select>

                    <input type="hidden"
                           name="ValoresConfigurados[${clave}].Tipo_Valor"
                           class="tipo-valor-editar"
                           value="" />

                    <input type="hidden"
                           name="ValoresConfigurados[${clave}].Unidad_Medida"
                           class="unidad-medida-editar"
                           value="" />

                </td>

                <td class="align-middle">
                    <span class="unidad-visible-editar"></span>
                </td>

                <td>
                    <input type="number"
                           step="0.01"
                           name="ValoresConfigurados[${clave}].Valor_Minimo"
                           class="form-control form-control-sm text-center"
                           placeholder="0.00" />
                </td>

                <td>
                    <input type="number"
                           step="0.01"
                           name="ValoresConfigurados[${clave}].Valor_Maximo"
                           class="form-control form-control-sm text-center"
                           placeholder="0.00" />
                </td>

                <td>
                    <input type="number"
                           step="0.01"
                           name="ValoresConfigurados[${clave}].Valor_Objetivo"
                           class="form-control form-control-sm text-center fw-bold text-danger"
                           placeholder="0.00" />
                </td>

                <td class="align-middle">
                    <button type="button"
                            class="btn btn-outline-danger btn-sm btnEliminarMeta"
                            title="Eliminar meta">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>

            </tr>`;

            $tbody.append(tr);
        });

            $(document).on('click', '.btnEliminarMeta', function () {

                var $tbody = $(this).closest('tbody');

                if ($tbody.find('tr').length <= 1) {
                    return;
                }

                if (confirm('¿Eliminar esta meta?')) {
                    $(this).closest('tr').remove();
                }
            });
        });

        // Intercambio de modales
        window.intercambiarModales = function (idModalCerrar, idModalAbrir) {
            var elementoCerrar = document.getElementById(idModalCerrar);
            var elementoAbrir = document.getElementById(idModalAbrir);
            if (window.bootstrap && bootstrap.Modal) {
                var modalCerrar = bootstrap.Modal.getInstance(elementoCerrar);
                if (modalCerrar) {
                    modalCerrar.hide();
                }
                setTimeout(function () {
                    var modalAbrir = bootstrap.Modal.getInstance(elementoAbrir) || new bootstrap.Modal(elementoAbrir);
                    modalAbrir.show();
                }, 350);
            }
        };

                document.addEventListener("change", function (e) {

            if (!e.target.classList.contains("catalogo-editar")) {
                return;
            }

            const select = e.target;
            const opcion = select.options[select.selectedIndex];
            const fila = select.closest("tr");

            if (!fila) {
                return;
            }

            const tipoValor = fila.querySelector(".tipo-valor-editar");
            const unidadMedida = fila.querySelector(".unidad-medida-editar");
            const unidadVisible = fila.querySelector(".unidad-visible-editar");

            if (!opcion || !opcion.value) {
                if (tipoValor) tipoValor.value = "";
                if (unidadMedida) unidadMedida.value = "";
                if (unidadVisible) unidadVisible.textContent = "";
                return;
            }

            const nombre = opcion.textContent
                .replace(/\s*\([^)]*\)\s*$/, "")
                .trim();

            const unidad = opcion.dataset.unidad || "";

            if (tipoValor) {
                tipoValor.value = nombre;
            }

            if (unidadMedida) {
                unidadMedida.value = unidad;
            }

            if (unidadVisible) {
                unidadVisible.textContent = unidad;
            }
        });

        // ================================================================
        // CARGA MASIVA DE OBJETIVOS DESDE EXCEL
        // ================================================================
        $('#formCargaObjetivos').on('submit', function (e) {
            e.preventDefault();

            var archivo = $('#archivoObjetivos')[0].files[0];
            if (!archivo) {
                $('#resultadoCargaObjetivos').html('<div class="alert alert-warning py-2 mb-0">Selecciona un archivo .xlsx.</div>');
                return;
            }
            if (!/\.xlsx$/i.test(archivo.name)) {
                $('#resultadoCargaObjetivos').html('<div class="alert alert-danger py-2 mb-0">Solo se aceptan archivos .xlsx.</div>');
                return;
            }

            var btn = $('#btnCargarObjetivos');
            var textoOriginal = btn.html();
            btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Procesando...');
            $('#resultadoCargaObjetivos').html('');

            var fd = new FormData();
            fd.append('archivo', archivo);

            $.ajax({
                url: '@Url.Action("CargarMasivoObjetivos", "Objetivos")',
                type: 'POST',
                data: fd,
                processData: false,
                contentType: false,
                success: function (r) {
                    btn.prop('disabled', false).html(textoOriginal);
                    if (r.ok) {
                        var mensaje = r.mensaje + ' <button type="button" class="btn btn-sm btn-primary ms-2" onclick="location.reload()">Recargar Tablero</button>';
                        $('#resultadoCargaObjetivos').html('<div class="alert alert-success py-2 mb-0">' + mensaje + '</div>');
                        if (r.errores && r.errores.length) {
                            var lista = '<ul class="mb-0 ps-3" style="max-height:150px;overflow:auto;">';
                            r.errores.forEach(function (err) { lista += '<li>' + err + '</li>'; });
                            lista += '</ul>';
                            $('#resultadoCargaObjetivos').append('<div class="alert alert-warning mt-2 py-2 mb-0"><strong>' + r.errores.length + ' fila(s) con error:</strong>' + lista + '</div>');
                        }
                        $('#archivoObjetivos').val('');
                    } else {
                        $('#resultadoCargaObjetivos').html('<div class="alert alert-danger py-2 mb-0">' + (r.mensaje || 'No se pudo procesar el archivo.') + '</div>');
                    }
                },
                error: function () {
                    btn.prop('disabled', false).html(textoOriginal);
                    $('#resultadoCargaObjetivos').html('<div class="alert alert-danger py-2 mb-0">Error al comunicarse con el servidor.</div>');
                }
            });
        });
    </script>
}