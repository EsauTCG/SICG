<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" />

<style>
    .select2-container--bootstrap-5 .select2-selection {
        min-height: 31px !important;
        border: 1px solid var(--border-color, #ced4da) !important;
        border-radius: 0.25rem !important;
        background-color: var(--input-bg, #fff) !important;
    }

    .select2-container--bootstrap-5 .select2-selection__rendered {
        line-height: 25px !important;
        font-size: 0.85rem !important;
        padding-left: 0.75rem !important;
        color: var(--text-main, #4a4a4a) !important;
    }

    .select2-container--bootstrap-5 .select2-dropdown {
        font-size: 0.85rem !important;
        background-color: var(--bg-card, #fff) !important;
        border-color: var(--border-color, #ced4da) !important;
    }

    .select2-container--bootstrap-5 .select2-search__field {
        background-color: var(--input-bg, #fff) !important;
        color: var(--text-main, #4a4a4a) !important;
        border: 1px solid var(--border-color, #ced4da) !important;
    }

    .select2-container--bootstrap-5 .select2-results__option {
        color: var(--text-main, #4a4a4a) !important;
    }

    .select2-container--bootstrap-5 .select2-results__option--highlighted[aria-selected] {
        background-color: #8b0000 !important;
        color: white !important;
    }

    .select2-container, .select2-dropdown {
        z-index: 99999 !important;
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script>
        // Funciones Globales para Carga Dinámica de Modales
        function cargarDetalleObjetivo(id) {
            $('#contenedorModalMaestro').html('<div class="modal-body text-center py-5"><div class="spinner-border text-danger" role="status"></div><p class="mt-2 text-muted">Cargando detalle...</p></div>');
            $('#modalMaestro').modal('show');

            $.get('@Url.Action("VistaParcialDetalle", "Objetivos")/' + id, function (data) {
                $('#contenedorModalMaestro').html(data);
            }).fail(function () {
                $('#contenedorModalMaestro').html('<div class="modal-body p-4 text-center"><i class="bi bi-exclamation-triangle text-danger fs-1"></i><h5 class="mt-3">Error</h5><p>No se pudo cargar la información del objetivo.</p><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button></div>');
            });
        }

        function cargarEditarObjetivo(id) {
            $('#contenedorModalMaestro').html('<div class="modal-body text-center py-5"><div class="spinner-border text-danger" role="status"></div><p class="mt-2 text-muted">Cargando formulario de edición...</p></div>');

            $.get('@Url.Action("VistaParcialEditar", "Objetivos")/' + id, function (data) {
                $('#contenedorModalMaestro').html(data);
                // Al guardar se regresa a esta misma URL con sus filtros y pagina.
                // Solo ruta + query: IsLocalUrl rechaza URLs absolutas.
                $('#formEditarObjetivo input[name="URLRetorno"]')
                    .val(window.location.pathname + window.location.search);
                // Inicializar Select2 al inyectar el HTML de edición
                iniciarSelect2();
            }).fail(function () {
                $('#contenedorModalMaestro').html('<div class="modal-body p-4 text-center"><i class="bi bi-exclamation-triangle text-danger fs-1"></i><h5 class="mt-3">Error</h5><p>No se pudo cargar el formulario.</p><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button></div>');
            });
        }

        // Cierra el modal maestro y limpia su contenido
        function cerrarModalMaestro() {
            $('#modalMaestro').modal('hide');
            $('#modalMaestro').on('hidden.bs.modal', function () {
                $('#contenedorModalMaestro').html('');
            });
        }

        // Esta función inicializa Select2 (se debe llamar tras cargar la vista parcial de Editar)
        function iniciarSelect2() {
            if (!$.fn.select2) return;
            $('.select2-buscar').each(function () {
                var $select = $(this);
                if ($select.hasClass("select2-hidden-accessible")) return;
                var $modal = $select.closest('.modal');
                $select.select2({
                    theme: 'bootstrap-5',
                    width: '100%',
                    dropdownParent: $modal.length ? $modal : $(document.body)
                });
            });
        }

        $(document).ready(function () {

            // Token antifalsificacion en las peticiones POST de esta pagina
            var _tokenCsrf = $('input[name="__RequestVerificationToken"]').first().val();
            if (_tokenCsrf) {
                $.ajaxSetup({ headers: { 'RequestVerificationToken': _tokenCsrf } });
            }

            // 2. Filtros de la tabla principal: se resuelven en el servidor para que
            // busquen en TODOS los registros (no solo la pagina actual) y no se pierdan al paginar.
            function urlTablero(pagina) {
                var params = new URLSearchParams();
                params.set('pagina', pagina || 1);
                params.set('pageSize', $('#selPageSize').val() || 50);
                if ($('#filtroTexto').val()) params.set('qTexto', $('#filtroTexto').val());
                if ($('#filtroArea').val()) params.set('qArea', $('#filtroArea').val());
                if ($('#filtroEstado').val()) params.set('qEstado', $('#filtroEstado').val());
                if ($('#filtroTipo').val()) params.set('qTipo', $('#filtroTipo').val());
                if ($('#filtroPeriodo').val()) params.set('qPeriodo', $('#filtroPeriodo').val());
                if ($('#filtroVendedor').val()) params.set('qVendedor', $('#filtroVendedor').val());
                if ($('#filtroDesde').val()) params.set('qDesde', $('#filtroDesde').val());
                if ($('#filtroHasta').val()) params.set('qHasta', $('#filtroHasta').val());
                if ($('#filtroVigencia').val()) params.set('qVigencia', $('#filtroVigencia').val());
                return '@Url.Action("Tablero", "Objetivos")?' + params.toString();
            }

            function aplicarFiltrosTablero() {
                window.location.href = urlTablero(1);
            }

            // Rangos rapidos de fechas (dias hacia atras / hacia adelante)
            function setRangoFiltros(diasAtras, diasAdelante) {
                var hoy = new Date();
                var fmt = function (d) {
                    return d.getFullYear() + '-' +
                        ('0' + (d.getMonth() + 1)).slice(-2) + '-' +
                        ('0' + d.getDate()).slice(-2);
                };
                var d1 = new Date(hoy); d1.setDate(hoy.getDate() + (diasAtras || 0));
                var d2 = new Date(hoy); d2.setDate(hoy.getDate() + (diasAdelante || 0));
                $('#filtroDesde').val(fmt(d1));
                $('#filtroHasta').val(fmt(d2));
                aplicarFiltrosTablero();
            }

            $('#filtroTexto').on('input', function () {
                clearTimeout(window._timerTablero);
                window._timerTablero = setTimeout(aplicarFiltrosTablero, 400);
            });

            $('#filtroArea, #filtroEstado, #filtroTipo, #filtroPeriodo, #filtroVendedor, #filtroVigencia, #filtroDesde, #filtroHasta')
                .on('change', aplicarFiltrosTablero);

            $('#btnLimpiarFiltros').click(function () {
                $('#filtroTexto').val('');
                $('#filtroArea').val('');
                $('#filtroEstado').val('');
                $('#filtroTipo').val('');
                $('#filtroPeriodo').val('');
                $('#filtroVendedor').val('');
                $('#filtroDesde').val('');
                $('#filtroHasta').val('');
                $('#filtroVigencia').val('');
                window.location.href = urlTablero(1);
            });

            // 3. Bitácora: filtros y tabla se resuelven en el servidor
            var urlBitacora = '@Url.Action("VistaParcialBitacora", "Objetivos")';
            var bitacoraReq = null;

            function paramsBitacora(pagina) {
                var desde = $('#filtroLogDesde').val();
                var hasta = $('#filtroLogHasta').val();

                return {
                    texto: $('#filtroLogTexto').val() || '',
                    estado: $('#filtroLogEstado').val() || '',
                    idPerfil: $('#filtroLogPerfil').val() || '',
                    idTipo: $('#filtroLogTipo').val() || '',
                    campoFecha: $('#filtroLogCampoFecha').val() || 'creacion',
                    desde: desde || '',
                    hasta: hasta || '',
                    actividad: $('#filtroLogActividad').val() || '',
                    pagina: pagina || 1,
                    pageSize: 25
                };
            }

            function cargarBitacora(pagina) {
                var $destino = $('#bitacoraResultado');

                // Se cancela la petición anterior para evitar respuestas fuera de orden
                if (bitacoraReq) { bitacoraReq.abort(); }

                $destino.html('<div class="text-center py-5"><div class="spinner-border text-danger" role="status"><span class="visually-hidden">Cargando...</span></div></div>');

                bitacoraReq = $.ajax({
                    url: urlBitacora,
                    type: 'GET',
                    data: paramsBitacora(pagina),
                    dataType: 'html'
                }).always(function (data, status) {
                    if (status === 'abort') return;
                    bitacoraReq = null;
                    $destino.html(data);
                });
            }

            // Se carga la primera vez que se abre el modal
            $('#modalBitacora').on('show.bs.modal', function () {
                if ($('#bitacoraResultado').data('cargada')) return;
                $('#bitacoraResultado').data('cargada', true);
                cargarBitacora(1);
            });

            $('#filtroLogTexto').on('input', function () {
                clearTimeout(window._timerLog);
                window._timerLog = setTimeout(function () { cargarBitacora(1); }, 350);
            });

            $('#filtroLogEstado, #filtroLogPerfil, #filtroLogTipo, #filtroLogCampoFecha, #filtroLogActividad, #filtroLogDesde, #filtroLogHasta')
                .on('change', function () { cargarBitacora(1); });

            // Rangos rápidos: hoy, últimos 7/30/90 días
            $(document).on('click', '.btn-preset', function () {
                var dias = parseInt($(this).data('dias'), 10) || 0;
                var hoy = new Date();
                var ini = new Date(hoy.getTime());
                ini.setDate(ini.getDate() - dias);

                $('#filtroLogDesde').val(formatoFechaLog(ini));
                $('#filtroLogHasta').val(formatoFechaLog(hoy));
                cargarBitacora(1);
            });

            function formatoFechaLog(d) {
                var m = String(d.getMonth() + 1).padStart(2, '0');
                var dd = String(d.getDate()).padStart(2, '0');
                return d.getFullYear() + '-' + m + '-' + dd;
            }

            $('#btnLimpiarLog').click(function () {
                $('#filtroLogTexto').val('');
                $('#filtroLogEstado').val('');
                $('#filtroLogPerfil').val('');
                $('#filtroLogTipo').val('');
                $('#filtroLogCampoFecha').val('creacion');
                $('#filtroLogDesde').val('');
                $('#filtroLogHasta').val('');
                $('#filtroLogActividad').val('');
                cargarBitacora(1);
            });

            // Paginación de la bitácora (el contenido se reemplaza en cada request)
            $(document).on('click', '#paginadorBitacora .pag-obj__btn', function () {
                if (this.disabled) return;
                cargarBitacora($(this).data('pag'));
            });

            // ===================== VENCIMIENTOS =====================
            var urlVencimientos = '@Url.Action("VistaParcialVencimientos", "Objetivos")';
            var urlRenovar = '@Url.Action("RenovarObjetivo", "Objetivos")';
            var urlInactivo = '@Url.Action("MarcarInactivo", "Objetivos")';
            var objetivoARenovar = null;

            function cargarVencimientos() {
                $('#vencimientosResultado').html(
                    '<div class="text-center py-5"><div class="spinner-border text-danger" role="status"><span class="visually-hidden">Cargando...</span></div></div>');

                $.get(urlVencimientos)
                    .done(function (html) {
                        $('#vencimientosResultado').html(html);
                        actualizarBadgeVencimientos($('#vencimientosResultado tr[id^="filaVenc_"]').length);
                    })
                    .fail(function () {
                        $('#vencimientosResultado').html(
                            '<div class="alert alert-danger py-2 small">No se pudieron cargar los vencimientos.</div>');
                    });
            }

            // Mantiene el contador del encabezado al dia sin recargar la pagina
            function actualizarBadgeVencimientos(total) {
                var $badge = $('#badgeVencimientos');
                if (total > 0) {
                    if (!$badge.length) {
                        $badge = $('<span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" id="badgeVencimientos"></span>');
                        $('#btnVerVencimientos').append($badge);
                    }
                    $badge.text(total);
                } else {
                    $badge.remove();
                }
            }

            $('#modalVencimientos').on('show.bs.modal', function () {
                cerrarFormRenovar();
                cargarVencimientos();
            });

            // Botones del listado de vencimientos (el contenido llega por AJAX, asi que
            // se delegan en document en lugar de usar onclick inline).
            $(document).on('click', '#vencimientosResultado [data-accion="renovar"]', function () {
                abrirRenovar($(this).data('id'), $(this).data('desde'), $(this).data('hasta'));
            });

            $(document).on('click', '#vencimientosResultado [data-accion="inactivo"]', function () {
                marcarInactivoVencimiento($(this).data('id'), $(this).data('dias'));
            });

            // Abre el formulario con el siguiente periodo sugerido, sobre el mismo modal
            function abrirRenovar(id, desde, hasta) {
                objetivoARenovar = id;
                $('#renovarFolio').text(id);
                $('#renovarDesde').val(desde);
                $('#renovarHasta').val(hasta);

                var d1 = new Date(desde), d2 = new Date(hasta);
                var duracion = Math.round((d2 - d1) / 86400000) + 1;
                $('#renovarSugerencia').text('Periodo sugerido: ' + duracion + ' días (misma duración que el actual). Puedes ajustarlo.');

                $('#vencimientosResultado').addClass('d-none');
                $('#vencimientosForm').removeClass('d-none');
                $('#vencimientosForm')[0].scrollIntoView({ behavior: 'smooth', block: 'start' });
            }

            function cerrarFormRenovar() {
                $('#vencimientosForm').addClass('d-none');
                $('#vencimientosResultado').removeClass('d-none');
                objetivoARenovar = null;
            }

            $('#btnCancelarRenovar').click(cerrarFormRenovar);

            $('#btnConfirmarRenovar').click(function () {
                var id = objetivoARenovar;
                var desde = $('#renovarDesde').val();
                var hasta = $('#renovarHasta').val();

                if (!id) { alert('No se ha seleccionado ningún objetivo.'); return; }
                if (!desde || !hasta) {
                    alert('Indica las dos fechas.');
                    return;
                }
                if (hasta < desde) {
                    alert('La fecha final no puede ser anterior a la inicial.');
                    return;
                }

                var $btn = $(this).prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Guardando...');

                $.post(urlRenovar, { id: id, nuevaDesde: desde, nuevaHasta: hasta })
                    .done(function (r) {
                        if (r.success) {
                            cerrarFormRenovar();
                            alert(r.message);
                            cargarVencimientos();
                        } else {
                            alert(r.message);
                        }
                    })
                    .fail(function (xhr) {
                        alert('No se pudo crear el nuevo objetivo.\n\n' + (xhr.responseJSON && xhr.responseJSON.message ? xhr.responseJSON.message : ''));
                    })
                    .always(function () {
                        $btn.prop('disabled', false).html('<i class="bi bi-check-lg me-1"></i> Crear nuevo objetivo');
                    });
            });

            function marcarInactivoVencimiento(id, dias) {

                dias = parseInt(dias, 10);
                if (isNaN(dias)) dias = 0;

                if (dias < 0) {
                    // El periodo ya concluyo: confirmacion simple
                    var msgVencido = '¿Marcar el objetivo #' + id + ' como Inactivo?\n\n'
                        + 'Su periodo ya vencio hace ' + Math.abs(dias) + ' dia(s).\n'
                        + 'Se conservara todo su historial y sus metas.';
                    if (!confirm(msgVencido)) return;
                } else {
                    // Aun le quedan dias: se advierte que el periodo termina de inmediato
                    var plural = dias === 1 ? 'dia' : 'dias';
                    var msgVigente = 'ATENCION: el objetivo #' + id + ' TODAVIA esta vigente.\n\n'
                        + 'Le quedan ' + dias + ' ' + plural + ' para vencer.\n'
                        + 'Si lo pasas a Inactivo ahora, su periodo termina de inmediato y '
                        + 'dejara de contar para los KPI.\n\n'
                        + '¿Seguro que quieres cerrarlo antes de tiempo?';
                    if (!confirm(msgVigente)) return;
                    if (!confirm('Ultima confirmacion: ¿pasar a Inactivo el objetivo #' + id + '?')) return;
                }

                $.post(urlInactivo, { id: id })
                    .done(function (r) {
                        if (r.success) {
                            alert(r.message);
                            cargarVencimientos();
                        } else {
                            alert(r.message);
                        }
                    })
                    .fail(function (xhr) {
                        alert('No se pudo marcar como Inactivo.\n\n' + (xhr.responseJSON && xhr.responseJSON.message ? xhr.responseJSON.message : ''));
                    });
            }

            // 4. Lógica dinámica para agregar y eliminar Metas (Delegada al body porque el modal es dinámico)
            var contadorMetaGlobal = 1000;

            $(document).on('click', '.btnAgregarMeta', function () {
                var tbodyId = $(this).attr('data-tbody');
                var $tbody = $('#' + tbodyId);
                if (!$tbody.length) return;

                var clave = 'n' + (++contadorMetaGlobal);

                var tr = `<tr>
                    <input type="hidden" name="ValoresConfigurados.Index" value="${clave}" />
                    <input type="hidden" name="ValoresConfigurados[${clave}].ID" value="0" />

                    <td class="align-middle text-start ps-3">
                        <select name="ValoresConfigurados[${clave}].ID_Catalogo_ValorObjetivo" class="form-select form-select-sm catalogo-editar">
                            <!-- Este HTML debe generarse desde C# o con JS inyectando opciones -->
                            <option value="">Seleccione o guarde el objetivo primero</option>
                        </select>
                        <input type="hidden" name="ValoresConfigurados[${clave}].Tipo_Valor" class="tipo-valor-editar" value="" />
                        <input type="hidden" name="ValoresConfigurados[${clave}].Unidad_Medida" class="unidad-medida-editar" value="" />
                    </td>

                    <td class="align-middle"><span class="unidad-visible-editar"></span></td>

                    <td>
                        <input type="number" step="0.01" name="ValoresConfigurados[${clave}].Valor_Minimo" class="form-control form-control-sm text-center" placeholder="0.00" />
                    </td>
                    <td>
                        <input type="number" step="0.01" name="ValoresConfigurados[${clave}].Valor_Maximo" class="form-control form-control-sm text-center" placeholder="0.00" />
                    </td>
                    <td>
                        <input type="number" step="0.01" name="ValoresConfigurados[${clave}].Valor_Objetivo" class="form-control form-control-sm text-center fw-bold text-danger" placeholder="0.00" />
                    </td>
                    <td class="align-middle">
                        <button type="button" class="btn btn-outline-danger btn-sm btnEliminarMeta" title="Eliminar meta">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>`;

                $tbody.append(tr);
            });

            $(document).on('click', '.btnEliminarMeta', function () {
                if (confirm('¿Eliminar esta meta?')) {
                    $(this).closest('tr').remove();
                }
            });

            // Auto-llenado de Unidad al cambiar métrica (Delegado)
            $(document).on("change", ".catalogo-editar", function (e) {
                const select = e.target;
                const opcion = select.options[select.selectedIndex];
                const fila = select.closest("tr");
                if (!fila) return;

                const tipoValor = fila.querySelector(".tipo-valor-editar");
                const unidadMedida = fila.querySelector(".unidad-medida-editar");
                const unidadVisible = fila.querySelector(".unidad-visible-editar");

                if (!opcion || !opcion.value) {
                    if (tipoValor) tipoValor.value = "";
                    if (unidadMedida) unidadMedida.value = "";
                    if (unidadVisible) unidadVisible.textContent = "";
                    return;
                }

                const nombre = opcion.textContent.replace(/\s*\([^)]*\)\s*$/, "").trim();
                const unidad = opcion.dataset.unidad || "";

                if (tipoValor) tipoValor.value = nombre;
                if (unidadMedida) unidadMedida.value = unidad;
                if (unidadVisible) unidadVisible.textContent = unidad;
            });

            // 5. Paginacion (navegacion del servidor, conservando los filtros activos)
            function irAPaginaObjetivos(pag) {
                var totalPaginas = parseInt($('#txtIrPagina').attr('max'), 10) || 1;
                pag = Math.min(Math.max(parseInt(pag, 10) || 1, 1), totalPaginas);
                window.location.href = urlTablero(pag);
            }

            $('#selPageSize').on('change', function () {
                irAPaginaObjetivos(1);
            });

            $('#paginadorObjetivos').on('click', '.pag-obj__btn', function () {
                if (this.disabled) return;
                irAPaginaObjetivos($(this).data('pag'));
            });

            $('#txtIrPagina').on('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    irAPaginaObjetivos($(this).val());
                }
            });

            // ================================================================
            // CARGA MASIVA DE OBJETIVOS DESDE EXCEL
            // ================================================================
            $('#formCargaObjetivos').on('submit', function (e) {
                e.preventDefault();

                var archivo = $('#archivoObjetivos')[0].files[0];
                if (!archivo) {
                    $('#resultadoCargaObjetivos').html('<div class="alert alert-warning py-2 mb-0">Selecciona un archivo .xlsx.</div>');
                    return;
                }
                if (!/\.xlsx$/i.test(archivo.name)) {
                    $('#resultadoCargaObjetivos').html('<div class="alert alert-danger py-2 mb-0">Solo se aceptan archivos .xlsx.</div>');
                    return;
                }

                var btn = $('#btnCargarObjetivos');
                var textoOriginal = btn.html();
                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1"></span>Procesando...');
                $('#resultadoCargaObjetivos').html('');

                var fd = new FormData();
                fd.append('archivo', archivo);

                $.ajax({
                    url: '@Url.Action("CargarMasivoObjetivos", "Objetivos")',
                    type: 'POST',
                    data: fd,
                    processData: false,
                    contentType: false,
                    success: function (r) {
                        btn.prop('disabled', false).html(textoOriginal);
                        if (r.ok) {
                            var mensaje = r.mensaje + ' <button type="button" class="btn btn-sm btn-primary ms-2" onclick="location.reload()">Recargar Tablero</button>';
                            $('#resultadoCargaObjetivos').html('<div class="alert alert-success py-2 mb-0">' + mensaje + '</div>');
                            if (r.errores && r.errores.length) {
                                var lista = '<ul class="mb-0 ps-3" style="max-height:150px;overflow:auto;">';
                                r.errores.forEach(function (err) { lista += '<li>' + err + '</li>'; });
                                lista += '</ul>';
                                $('#resultadoCargaObjetivos').append('<div class="alert alert-warning mt-2 py-2 mb-0"><strong>' + r.errores.length + ' fila(s) con error:</strong>' + lista + '</div>');
                            }
                            $('#archivoObjetivos').val('');
                        } else {
                            $('#resultadoCargaObjetivos').html('<div class="alert alert-danger py-2 mb-0">' + (r.mensaje || 'No se pudo procesar el archivo.') + '</div>');
                        }
                    },
                    error: function () {
                        btn.prop('disabled', false).html(textoOriginal);
                        $('#resultadoCargaObjetivos').html('<div class="alert alert-danger py-2 mb-0">Error al comunicarse con el servidor.</div>');
                    }
                });
            });
        });
    </script>
}
