        border-left: 3px solid #7a2029 !important;
        border-radius: 2px !important;

        font-size: 8px !important;
        font-weight: 500 !important;
    }

    body:not([data-theme="dark"]) .sur-alert strong {
        color: #30373b !important;
    }

    body:not([data-theme="dark"]) .sur-warning {
        margin-top: 5px !important;

        padding: 5px 7px !important;

        background: #fff5dc !important;
        color: #705a1a !important;

        border: 1px solid #d6bd79 !important;
        border-radius: 2px !important;

        font-size: 7.8px !important;
        font-weight: 500 !important;
    }

    /* ===============================================================
       BADGE MULTIFUNCIÓN
       =============================================================== */
    body:not([data-theme="dark"]) .sur-hero .badge {
        padding: 3px 6px !important;

        background: rgba(255,255,255,.10) !important;
        color: #fff !important;

        border: 1px solid rgba(255,255,255,.18) !important;
        border-radius: 2px !important;

        font-size: 7.5px !important;
        font-weight: 600 !important;
    }

    /* ===============================================================
       RESPONSIVE
       =============================================================== */
    @@media (max-width: 1100px) {
        body:not([data-theme="dark"]) .role-grid {
            grid-template-columns: repeat(2,minmax(0,1fr)) !important;
        }

        body:not([data-theme="dark"]) .sur-hero-grid {
            grid-template-columns: 1fr !important;
        }
    }

    @@media (max-width: 768px) {
        body:has(.sur-wrap) .layout-main-content,
        body:has(.sur-wrap) .layout-main-content.layout-sidebar-open,
        body:has(.layout-sidebar.layout-hidden):has(.sur-wrap) .layout-main-content,
        body:has(.layout-sidebar.layout-hidden):has(.sur-wrap) .layout-main-content.layout-sidebar-open {
            width: 100% !important;
            max-width: 100% !important;
            margin-left: 0 !important;
        }

        body:not([data-theme="dark"]) .sur-wrap {
            width: 100% !important;
            margin: 0 !important;
        }

        body:not([data-theme="dark"]) .role-grid {
            grid-template-columns: 1fr !important;
        }

        body:not([data-theme="dark"]) .sur-section,
        body:not([data-theme="dark"]) .sur-hero {
            border-left: 0 !important;
            border-right: 0 !important;
        }
    }
</style>

<div class="sur-wrap">

    <!-- =========================================================
         USUARIO / CONTEXTO
         ========================================================= -->
    <section class="sur-hero">

        <div class="sur-hero-grid">

            <div>

                <div class="sur-overline">
                    SIGO · SURTIDO CEDIS
                </div>

                <div class="sur-user">
                    @Model.NombreUsuario
                </div>

                <div class="sur-login">
                    @Model.Login
                </div>

                @if (multifuncion)
                {
                    <div class="mt-2">
                        <span class="badge rounded-pill text-bg-light">
                            Usuario multifunción
                        </span>
                    </div>
                }

            </div>


            <div class="sur-context">

                <small>
                    CONTEXTO ACTUAL
                </small>

                <strong>
                    @Model.PlantaActiva · @Model.AlmacenActivoNombre
                </strong>

                <div class="sur-tags">

                    <span>
                        @Model.AlmacenActivoCodigo
                    </span>

                    <span>
                        @Model.ClasificacionActiva
                    </span>

                    @if (Model.Layout3DConfirmado)
                    {
                        <span>
                            3D CONFIRMADO
                        </span>
                    }
                    else
                    {
                        <span>
                            LAYOUT PENDIENTE
                        </span>
                    }

                </div>

            </div>

        </div>

    </section>

<!-- =========================================================
         FUNCIONES
         ========================================================= -->
    <section class="sur-section">

        <div class="sur-head">

            <div>

                <h5>
                    Mis funciones
                </h5>

                <p>
                    Estas capacidades vienen del usuario
                    autenticado de SIGO.
                </p>

            </div>

        </div>


        <div class="role-grid">

            <!-- MONTACARGUISTA -->
            <a
                class="role-card role-mont @(!Model.PuedeMontacargas ? "off" : "")"
                href="@Url.Action(
                    "Picking",
                    "Surtido"
                )"
            >

                <div class="role-icon">
                    🚜
                </div>

                <h6>
                    Montacarguista
                </h6>

                <p>
                    Todos tus pedidos autorizados,
                    agrupados por almacén, PEPS,
                    recorrido, rack 3D y producto bajado.
                </p>

                <b>
                    @(Model.PuedeMontacargas
                        ? "VER TODOS MIS PEDIDOS →"
                        : "SIN PERMISO")
                </b>

            </a>


            <!-- CAPTURISTA -->
            <a
                class="role-card role-cap @(!Model.PuedeCapturar ? "off" : "")"
                href="@Url.Action(
                    "Captura",
                    "Surtido",
                    new
                    {
                        almacen = Model.AlmacenActivoCodigo
                    }
                )"
            >

                <div class="role-icon">
                    ⌁
                </div>

                <h6>
                    Capturista
                </h6>

                <p>
                    Escanea tarima/caja, valida
                    SKU, lote, kilos y cajas,
                    y vincula al pedido.
                </p>

                <b>
                    @(Model.PuedeCapturar
                        ? "ENTRAR A CAPTURA →"
                        : "SIN PERMISO")
                </b>

            </a>


            <!-- UBICACIÓN -->
            <a
                class="role-card role-ubi @(!Model.PuedeUbicar ? "off" : "")"
                href="@Url.Action(
                    "Ubicar",
                    "Surtido",
                    new
                    {
                        almacen = Model.AlmacenActivoCodigo
                    }
                )"
            >

                <div class="role-icon">
                    ▦
                </div>

                <h6>
                    Ubicación
                </h6>

                <p>
                    Slotting por rotación,
                    agrupación por SKU,
                    ubicación libre y rack 3D.
                </p>

                <b>
                    @(Model.PuedeUbicar
                        ? "ENTRAR A UBICAR →"
                        : "SIN PERMISO")
                </b>

            </a>


            <!-- COORDINADOR -->
            <a
                class="role-card role-coord @(!Model.PuedeCoordinar ? "off" : "")"
                href="@Url.Action(
                    "Coordinador",
                    "Surtido",
                    new
                    {
                        almacen = Model.AlmacenActivoCodigo
                    }
                )"
            >

                <div class="role-icon">
                    ◎
                </div>

                <h6>
                    Coordinación
                </h6>

                <p>
                    Excepciones, productividad,
                    calidad, surtido, almacenes
                    y control de la operación.
                </p>

                <b>
                    @(Model.PuedeCoordinar
                        ? "ENTRAR A COORDINACIÓN →"
                        : "SIN PERMISO")
                </b>

            </a>

        </div>



        @if (
            Model.PuedeMontacargas
            || Model.PuedeUbicar
            || Model.PuedeCoordinar
        )
        {
            <div style="margin-top:10px;">

                <a href="@Url.Action(
                        "Mapa3D",
                        "Surtido",
                        new
                        {
                            almacen = Model.AlmacenActivoCodigo
                        }
                   )"
                   style="
                        display:flex;
                        align-items:center;
                        justify-content:space-between;
                        gap:12px;
                        padding:12px 14px;
                        border-radius:13px;
                        border:1px solid #dce5ee;
                        background:#071827;
                        color:#fff;
                        text-decoration:none;
                   ">

                    <div>
                        <strong style="display:block;">
                            ▦ Mapa 3D del almacén
                        </strong>

                        <span style="
                            display:block;
                            margin-top:3px;
                            font-size:.72rem;
                            opacity:.70;
                        ">
                            @(Model.Layout3DConfirmado
                                ? "Layout completo confirmado · ubicación, rack, posición y altura."
                                : "Vista 3D por rack · sin inventar layout completo.")
                        </span>
                    </div>

                    <strong>
                        ABRIR →
                    </strong>

                </a>

            </div>
        }


        @if (multifuncion)
        {
            <div class="sur-alert">

                <strong>
                    Usuario multifunción.
                </strong>

                Este usuario puede operar más de un módulo
                sin cambiar de cuenta.

            </div>
        }

    </section>

</div>
