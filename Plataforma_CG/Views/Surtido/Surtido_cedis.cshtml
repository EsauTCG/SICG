@model Plataforma_CG.ViewModels.SurtidoInicioVM

@{
    ViewData["Title"] = "Surtido CEDIS";
    Layout = "~/Views/Shared/_Layout2.cshtml";

    var cantidadFunciones =
        new[]
        {
            Model.PuedeMontacargas,
            Model.PuedeCapturar,
            Model.PuedeUbicar,
            Model.PuedeCoordinar
        }
        .Count(x => x);

    var multifuncion = cantidadFunciones > 1;
}

<style>
    :root {
        --op-bg:#eef2f4;
        --op-surface:#ffffff;
        --op-surface-2:#f8fafb;
        --op-border:#d6e0e6;
        --op-text:#233545;
        --op-muted:#667a8b;
        --op-primary:#7b1f29;
        --op-primary-dark:#53151c;
        --op-blue:#1769c2;
        --op-green:#218a54;
        --op-orange:#d78a13;
        --op-purple:#6953a7;
        --op-gray:#737e86;
        --op-shadow:0 6px 18px rgba(28,43,56,.08);
    }

    html,body {
        width:100% !important;
        max-width:100% !important;
        min-width:0 !important;
        overflow-x:hidden !important;
    }

    body {
        background:var(--op-bg) !important;
        color:var(--op-text);
        font-family:"Segoe UI",Tahoma,Arial,sans-serif;
    }

    body:has(.op-wrap) .layout-main-content,
    body:has(.op-wrap) .layout-container-fluid,
    .container,
    .container-fluid {
        width:100% !important;
        max-width:100% !important;
        min-width:0 !important;
    }

    .op-wrap,
    .op-wrap * {
        box-sizing:border-box;
    }

    .op-wrap {
        width:100%;
        max-width:100%;
        min-width:0;
        padding:8px;
    }

    .op-shell {
        width:100%;
        max-width:none;
        min-width:0;
        margin:0;
        display:grid;
        gap:8px;
    }

    /* =========================================================
       CABECERA OPERATIVA
       ========================================================= */
    .op-top {
        color:#fff;
        background:linear-gradient(135deg,var(--op-primary-dark),var(--op-primary));
        border:1px solid #491218;
        border-radius:16px;
        padding:12px 14px;
        box-shadow:0 8px 22px rgba(83,21,28,.16);
    }

    .op-top-grid {
        display:grid;
        grid-template-columns:minmax(0,1.45fr) minmax(290px,.65fr);
        gap:12px;
        align-items:stretch;
    }

    .op-kicker {
        font-size:9px;
        font-weight:800;
        letter-spacing:.07em;
        text-transform:uppercase;
        opacity:.84;
    }

    .op-title {
        margin:3px 0 2px;
        font-size:clamp(25px,2.2vw,36px);
        line-height:1;
        font-weight:900;
    }

    .op-user {
        font-size:12px;
        font-weight:800;
        opacity:.95;
    }

    .op-sub {
        max-width:850px;
        margin-top:5px;
        font-size:10px;
        line-height:1.35;
        opacity:.9;
    }

    .op-steps {
        margin-top:9px;
        display:grid;
        grid-template-columns:repeat(3,minmax(0,1fr));
        gap:6px;
    }

    .op-step {
        min-width:0;
        min-height:54px;
        padding:7px 8px;
        display:grid;
        grid-template-columns:26px minmax(0,1fr);
        grid-template-rows:auto auto;
        column-gap:7px;
        align-items:center;
        border:1px solid rgba(255,255,255,.16);
        border-radius:10px;
        background:rgba(255,255,255,.08);
    }

    .op-step span {
        grid-row:1 / 3;
        width:26px;
        height:26px;
        margin:0;
        display:inline-flex;
        align-items:center;
        justify-content:center;
        border-radius:999px;
        background:#fff;
        color:var(--op-primary);
        font-size:10px;
        font-weight:900;
    }

    .op-step strong {
        margin:0;
        font-size:10px;
        line-height:1.1;
    }

    .op-step small {
        margin-top:2px;
        font-size:7.5px;
        line-height:1.15;
        opacity:.88;
    }

    .op-panel {
        min-width:0;
        padding:9px;
        display:grid;
        grid-template-columns:1fr 1fr;
        gap:6px;
        border:1px solid rgba(255,255,255,.16);
        border-radius:12px;
        background:rgba(255,255,255,.08);
    }

    .op-panel h3 {
        grid-column:1 / -1;
        margin:0;
        font-size:10px;
        font-weight:900;
        text-transform:uppercase;
        letter-spacing:.04em;
        opacity:.85;
    }

    .op-box {
        min-width:0;
        padding:7px 8px;
        border:1px solid rgba(255,255,255,.14);
        border-radius:9px;
        background:rgba(255,255,255,.07);
    }

    .op-box:last-child {
        grid-column:1 / -1;
    }

    .op-box-label {
        display:block;
        font-size:7px;
        font-weight:800;
        text-transform:uppercase;
        letter-spacing:.04em;
        opacity:.72;
    }

    .op-box-value {
        display:block;
        margin-top:2px;
        overflow:hidden;
        text-overflow:ellipsis;
        white-space:nowrap;
        font-size:11px;
        line-height:1.15;
        font-weight:800;
    }

    .op-mini {
        margin-top:2px;
        color:rgba(255,255,255,.78);
        font-size:7px;
        line-height:1.15;
    }

    .op-chips {
        display:flex;
        align-items:center;
        flex-wrap:wrap;
        gap:4px;
    }

    .op-chip {
        padding:4px 7px;
        display:inline-flex;
        align-items:center;
        gap:4px;
        border:1px solid rgba(255,255,255,.18);
        border-radius:999px;
        background:rgba(255,255,255,.10);
        font-size:7.5px;
        font-weight:800;
        white-space:nowrap;
    }

    /* =========================================================
       SECCIÓN FUNCIONES
       ========================================================= */
    .op-section {
        min-width:0;
        margin:0;
        overflow:hidden;
        border:1px solid var(--op-border);
        border-radius:16px;
        background:var(--op-surface);
        box-shadow:var(--op-shadow);
    }

    .op-section-head {
        min-height:44px;
        padding:7px 10px;
        display:flex;
        align-items:center;
        justify-content:space-between;
        gap:10px;
        border-bottom:1px solid var(--op-border);
        background:linear-gradient(180deg,#fff,#f4f7f9);
    }

    .op-section-head h4 {
        margin:0;
        color:var(--op-text);
        font-size:15px;
        line-height:1.1;
        font-weight:900;
    }

    .op-section-head p {
        margin:2px 0 0;
        color:var(--op-muted);
        font-size:8px;
        line-height:1.2;
    }

    .op-counter {
        flex:0 0 auto;
        padding:4px 8px;
        border:1px solid #dfc6ca;
        border-radius:999px;
        background:#f8ecee;
        color:var(--op-primary);
        font-size:7.5px;
        font-weight:900;
        white-space:nowrap;
    }

    .op-actions {
        min-width:0;
        padding:9px;
        display:grid;
        grid-template-columns:repeat(4,minmax(0,1fr));
        gap:8px;
    }

    .op-card {
        min-width:0;
        min-height:172px;
        padding:10px;
        display:flex;
        flex-direction:column;
        position:relative;
        overflow:hidden;
        border:1px solid transparent;
        border-radius:14px;
        color:inherit !important;
        text-decoration:none !important;
        background:var(--op-surface-2);
        box-shadow:inset 0 0 0 1px rgba(0,0,0,.025);
        transition:transform .12s ease,box-shadow .12s ease;
    }

    .op-card:hover {
        transform:translateY(-1px);
        box-shadow:0 8px 18px rgba(25,41,54,.10);
    }

    .op-card.off {
        pointer-events:none;
        opacity:.68;
        border-color:#d4dce1 !important;
        background:#f1f3f4 !important;
    }

    .op-card-top {
        display:flex;
        justify-content:space-between;
        align-items:center;
        gap:7px;
    }

    .op-icon {
        width:42px;
        height:42px;
        display:inline-flex;
        align-items:center;
        justify-content:center;
        border-radius:12px;
        font-size:22px;
        font-weight:900;
    }

    .op-state {
        padding:4px 7px;
        border:1px solid transparent;
        border-radius:999px;
        font-size:7px;
        font-weight:900;
        white-space:nowrap;
    }

    .op-card h5 {
        margin:8px 0 3px;
        font-size:17px;
        line-height:1.05;
        font-weight:900;
    }

    .op-card p {
        margin:0;
        min-height:32px;
        flex:0 0 auto;
        color:var(--op-muted);
        font-size:8.5px;
        line-height:1.28;
    }

    .op-card ul {
        margin:7px 0 0;
        padding:0;
        display:grid;
        gap:3px;
        list-style:none;
    }

    .op-card li {
        display:flex;
        align-items:center;
        gap:5px;
        color:var(--op-text);
        font-size:7.5px;
        line-height:1.15;
        font-weight:700;
    }

    .op-card li::before {
        content:"✓";
        flex:0 0 14px;
        width:14px;
        height:14px;
        display:inline-flex;
        align-items:center;
        justify-content:center;
        border-radius:999px;
        background:rgba(255,255,255,.88);
        font-size:8px;
        font-weight:900;
    }

    .op-go {
        margin-top:auto;
        padding:8px 9px;
        border-radius:9px;
        color:#fff;
        text-align:center;
        font-size:9px;
        line-height:1;
        font-weight:900;
    }

    .op-card.off .op-go {
        background:var(--op-gray) !important;
    }

    .op-blue{border-color:#c9ddf4;background:#f5f9fe}
    .op-blue .op-icon{background:#e2eefb;color:var(--op-blue)}
    .op-blue .op-state{background:#e5f0fc;color:#14599f;border-color:#c8dcf1}
    .op-blue .op-go{background:var(--op-blue)}
    .op-blue li::before{color:var(--op-blue)}

    .op-green{border-color:#c6e5d2;background:#f4fbf7}
    .op-green .op-icon{background:#e1f2e7;color:var(--op-green)}
    .op-green .op-state{background:#e5f4ea;color:#17683e;border-color:#c4e2ce}
    .op-green .op-go{background:var(--op-green)}
    .op-green li::before{color:var(--op-green)}

    .op-orange{border-color:#efd7ac;background:#fffaf0}
    .op-orange .op-icon{background:#fceccf;color:var(--op-orange)}
    .op-orange .op-state{background:#fff0d2;color:#815508;border-color:#ecd49f}
    .op-orange .op-go{background:var(--op-orange)}
    .op-orange li::before{color:var(--op-orange)}

    .op-purple{border-color:#d8cdf2;background:#faf8fe}
    .op-purple .op-icon{background:#ebe5f8;color:var(--op-purple)}
    .op-purple .op-state{background:#eee9fa;color:#54408e;border-color:#d9cef3}
    .op-purple .op-go{background:var(--op-purple)}
    .op-purple li::before{color:var(--op-purple)}

    .op-disabled .op-icon {
        background:#e6eaed;
        color:#6d777f;
    }

    .op-disabled .op-state {
        background:#eceff1;
        color:#6f787f;
        border-color:#d8dee2;
    }

    /* =========================================================
       BLOQUE INFERIOR
       ========================================================= */
    .op-extra {
        padding:0 9px 9px;
        display:grid;
        grid-template-columns:minmax(0,1.2fr) minmax(280px,.8fr);
        gap:8px;
    }

    .op-link-card,
    .op-note-card {
        min-width:0;
        min-height:84px;
        padding:10px 12px;
        border:1px solid var(--op-border);
        border-radius:12px;
    }

    .op-link-card {
        display:flex;
        align-items:center;
        justify-content:space-between;
        gap:10px;
        color:#fff !important;
        text-decoration:none !important;
        border-color:#183247;
        background:linear-gradient(135deg,#102737,#1c415b);
    }

    .op-link-card:hover {
        color:#fff !important;
        box-shadow:0 7px 16px rgba(13,29,43,.15);
    }

    .op-link-card strong {
        display:block;
        margin:0 0 2px;
        font-size:13px;
    }

    .op-link-card span {
        display:block;
        max-width:680px;
        font-size:8px;
        line-height:1.25;
        opacity:.9;
    }

    .op-link-action {
        flex:0 0 auto;
        min-width:120px;
        padding:9px 10px;
        border:1px solid rgba(255,255,255,.22);
        border-radius:9px;
        background:rgba(255,255,255,.10);
        color:#fff;
        text-align:center;
        font-size:9px;
        font-weight:900;
    }

    .op-note-card {
        background:#fff;
    }

    .op-note-card h6 {
        margin:0 0 5px;
        font-size:11px;
        font-weight:900;
    }

    .op-note-card ul {
        margin:0;
        padding:0;
        display:grid;
        grid-template-columns:1fr 1fr;
        gap:3px 8px;
        list-style:none;
    }

    .op-note-card li {
        color:var(--op-text);
        font-size:7.5px;
        line-height:1.2;
    }

    .op-note-card .op-alert {
        margin-top:6px;
        padding:6px 8px;
        border:1px solid #ead29a;
        border-radius:8px;
        background:#fff8e6;
        color:#76570c;
        font-size:7px;
        font-weight:700;
    }

    /* =========================================================
       LAPTOP / ESCRITORIO
       ========================================================= */
    @@media (min-width:901px) {
        body:has(.op-wrap) {
            overflow-y:hidden !important;
        }

        .op-wrap {
            height:calc(100dvh - 82px);
            max-height:calc(100dvh - 82px);
            overflow:hidden;
        }

        .op-shell {
            height:100%;
            grid-template-rows:auto minmax(0,1fr);
            overflow:hidden;
        }

        .op-section {
            min-height:0;
            display:grid;
            grid-template-rows:auto auto auto;
            align-content:start;
        }
    }

    /* Baja altura: ocultamos explicación secundaria, no acciones */
    @@media (min-width:901px) and (max-height:760px) {
        .op-top {
            padding:8px 10px;
        }

        .op-sub,
        .op-step small,
        .op-card p,
        .op-card ul,
        .op-note-card .op-alert {
            display:none;
        }

        .op-steps {
            margin-top:5px;
        }

        .op-step {
            min-height:38px;
            grid-template-rows:1fr;
        }

        .op-step span {
            grid-row:auto;
        }

        .op-panel {
            padding:6px;
        }

        .op-card {
            min-height:116px;
        }

        .op-card h5 {
            margin-top:6px;
        }

        .op-extra {
            padding-bottom:6px;
        }

        .op-link-card,
        .op-note-card {
            min-height:62px;
        }
    }

    /* =========================================================
       TABLET HORIZONTAL / LAPTOP ANGOSTA
       ========================================================= */
    @@media (max-width:1200px) {
        .op-top-grid {
            grid-template-columns:minmax(0,1.25fr) minmax(260px,.75fr);
        }

        .op-actions {
            grid-template-columns:repeat(2,minmax(0,1fr));
        }

        .op-card {
            min-height:135px;
        }

        .op-card p {
            min-height:0;
        }

        .op-extra {
            grid-template-columns:1fr 1fr;
        }
    }

    /* =========================================================
       TABLET
       ========================================================= */
    @@media (max-width:900px) {
        body:has(.op-wrap) {
            overflow-y:auto !important;
        }

        .op-wrap {
            padding:6px;
        }

        .op-top {
            border-radius:13px;
            padding:10px;
        }

        .op-top-grid {
            grid-template-columns:1fr;
        }

        .op-panel {
            grid-template-columns:1fr 1fr 1fr;
        }

        .op-panel h3 {
            grid-column:1 / -1;
        }

        .op-box:last-child {
            grid-column:auto;
        }

        .op-section {
            border-radius:13px;
        }

        .op-actions {
            padding:7px;
            grid-template-columns:repeat(2,minmax(0,1fr));
            gap:7px;
        }

        .op-card {
            min-height:128px;
        }

        .op-card p,
        .op-card ul {
            display:none;
        }

        .op-card h5 {
            margin:7px 0 5px;
            font-size:15px;
        }

        .op-go {
            padding:9px 8px;
            font-size:8.5px;
        }

        .op-extra {
            padding:0 7px 7px;
            grid-template-columns:1fr;
        }

        .op-note-card ul {
            grid-template-columns:repeat(4,minmax(0,1fr));
        }
    }

    @@media (max-width:650px) {
        .op-top-grid,
        .op-steps,
        .op-panel,
        .op-actions,
        .op-note-card ul {
            grid-template-columns:1fr;
        }

        .op-panel h3,
        .op-box:last-child {
            grid-column:auto;
        }

        .op-card {
            min-height:116px;
        }

        .op-link-card {
            flex-direction:column;
            align-items:flex-start;
        }

        .op-link-action {
            width:100%;
            min-width:0;
        }
    }
</style>

<div class="op-wrap">
    <div class="op-shell">

        <section class="op-top">
            <div class="op-top-grid">
                <div>
                    <div class="op-kicker">SIGO · SURTIDO CEDIS</div>
                    <div class="op-title">Panel operativo</div>
                    <div class="op-user">@Model.NombreUsuario · @Model.Login</div>

                    <div class="op-sub">
                        Pantalla pensada para uso operativo: fácil de entender, con colores claros y accesos grandes.
                        Solo revisa tu almacén y entra al módulo que vas a trabajar.
                    </div>

                    <div class="op-steps">
                        <div class="op-step">
                            <span>1</span>
                            <strong>Revisa tu almacén</strong>
                            <small>Confirma planta, almacén y clasificación antes de iniciar.</small>
                        </div>
                        <div class="op-step">
                            <span>2</span>
                            <strong>Toca tu función</strong>
                            <small>Selecciona Montacarguista, Captura, Ubicación o Coordinación.</small>
                        </div>
                        <div class="op-step">
                            <span>3</span>
                            <strong>Empieza a trabajar</strong>
                            <small>La pantalla te manda directo al módulo correspondiente.</small>
                        </div>
                    </div>
                </div>

                <div class="op-panel">
                    <h3>Contexto actual</h3>

                    <div class="op-box">
                        <span class="op-box-label">Ubicación activa</span>
                        <span class="op-box-value">@Model.PlantaActiva · @Model.AlmacenActivoNombre</span>
                        <div class="op-mini">Código: @Model.AlmacenActivoCodigo</div>
                    </div>

                    <div class="op-chips">
                        <div class="op-chip">🏷️ @Model.ClasificacionActiva</div>
                        <div class="op-chip">👤 @cantidadFunciones acceso@(cantidadFunciones == 1 ? "" : "s")</div>
                        @if (multifuncion)
                        {
                            <div class="op-chip">🔁 Usuario multifunción</div>
                        }
                    </div>

                    <div class="op-box">
                        <span class="op-box-label">Estado del layout</span>
                        <span class="op-box-value">@(Model.Layout3DConfirmado ? "3D confirmado" : "Layout pendiente")</span>
                        <div class="op-mini">
                            @(Model.Layout3DConfirmado
                                ? "El almacén tiene layout confirmado para trabajar con rack, posición y altura."
                                : "Puedes abrir el mapa 3D para revisar la vista del almacén.")
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section class="op-section">
            <div class="op-section-head">
                <div>
                    <h4>Mis funciones</h4>
                    <p>Solo pica el bloque del color de tu actividad y entra a trabajar.</p>
                </div>
                <div class="op-counter">@cantidadFunciones función@(cantidadFunciones == 1 ? "" : "es") disponible@(cantidadFunciones == 1 ? "" : "s")</div>
            </div>

            <div class="op-actions">
                <a class="op-card op-blue @(Model.PuedeMontacargas ? "" : "off op-disabled")"
                   href="@Url.Action("Picking", "Surtido")">
                    <div class="op-card-top">
                        <div class="op-icon">🚜</div>
                        <div class="op-state @(Model.PuedeMontacargas ? "" : "op-disabled")">@(Model.PuedeMontacargas ? "Disponible" : "Sin acceso")</div>
                    </div>
                    <h5>Montacarguista</h5>
                    <p>Para surtir pedidos autorizados y seguir el recorrido por almacén, PEPS y producto bajado.</p>
                    <ul>
                        <li>Pedidos listos para surtir</li>
                        <li>Recorrido y prioridad</li>
                        <li>Vista rápida del trabajo</li>
                    </ul>
                    <div class="op-go">@(Model.PuedeMontacargas ? "Entrar a Montacarguista" : "Sin permiso")</div>
                </a>

                <a class="op-card op-green @(Model.PuedeCapturar ? "" : "off op-disabled")"
                   href="@Url.Action("Captura", "Surtido", new { almacen = Model.AlmacenActivoCodigo })">
                    <div class="op-card-top">
                        <div class="op-icon">📦</div>
                        <div class="op-state @(Model.PuedeCapturar ? "" : "op-disabled")">@(Model.PuedeCapturar ? "Disponible" : "Sin acceso")</div>
                    </div>
                    <h5>Captura</h5>
                    <p>Para escanear tarima o caja, validar datos y ligar el producto correcto al pedido.</p>
                    <ul>
                        <li>Escaneo de cajas y tarimas</li>
                        <li>Validación de SKU y lote</li>
                        <li>Registro de kilos y cajas</li>
                    </ul>
                    <div class="op-go">@(Model.PuedeCapturar ? "Entrar a Captura" : "Sin permiso")</div>
                </a>

                <a class="op-card op-orange @(Model.PuedeUbicar ? "" : "off op-disabled")"
                   href="@Url.Action("Ubicar", "Surtido", new { almacen = Model.AlmacenActivoCodigo })">
                    <div class="op-card-top">
                        <div class="op-icon">📍</div>
                        <div class="op-state @(Model.PuedeUbicar ? "" : "op-disabled")">@(Model.PuedeUbicar ? "Disponible" : "Sin acceso")</div>
                    </div>
                    <h5>Ubicación</h5>
                    <p>Para acomodar producto, hacer slotting y trabajar con ubicación libre o rack del almacén.</p>
                    <ul>
                        <li>Ubicar producto por SKU</li>
                        <li>Apoyo a rotación y slotting</li>
                        <li>Trabajo por rack y posición</li>
                    </ul>
                    <div class="op-go">@(Model.PuedeUbicar ? "Entrar a Ubicación" : "Sin permiso")</div>
                </a>

                <a class="op-card op-purple @(Model.PuedeCoordinar ? "" : "off op-disabled")"
                   href="@Url.Action("Coordinador", "Surtido", new { almacen = Model.AlmacenActivoCodigo })">
                    <div class="op-card-top">
                        <div class="op-icon">🧭</div>
                        <div class="op-state @(Model.PuedeCoordinar ? "" : "op-disabled")">@(Model.PuedeCoordinar ? "Disponible" : "Sin acceso")</div>
                    </div>
                    <h5>Coordinación</h5>
                    <p>Para revisar la operación, atender excepciones y dar seguimiento al surtido del almacén.</p>
                    <ul>
                        <li>Control operativo</li>
                        <li>Productividad y calidad</li>
                        <li>Seguimiento de incidencias</li>
                    </ul>
                    <div class="op-go">@(Model.PuedeCoordinar ? "Entrar a Coordinación" : "Sin permiso")</div>
                </a>
            </div>

            <div class="op-extra">
                @if (Model.PuedeMontacargas || Model.PuedeUbicar || Model.PuedeCoordinar)
                {
                    <a class="op-link-card"
                       href="@Url.Action("Mapa3D", "Surtido", new { almacen = Model.AlmacenActivoCodigo })">
                        <div>
                            <strong>Mapa 3D del almacén</strong>
                            <span>
                                @(Model.Layout3DConfirmado
                                    ? "Abre la vista completa del almacén con rack, posición y altura."
                                    : "Abre la vista 3D del almacén para apoyar la operación y ubicación.")
                            </span>
                        </div>
                        <div class="op-link-action">Abrir mapa 3D</div>
                    </a>
                }
                else
                {
                    <div class="op-note-card">
                        <h6>Mapa 3D</h6>
                        <ul>
                            <li>Este acceso aparece cuando el usuario puede trabajar con Montacarguista, Ubicación o Coordinación.</li>
                        </ul>
                    </div>
                }

                <div class="op-note-card">
                    <h6>Indicaciones rápidas</h6>
                    <ul>
                        <li><strong>Azul:</strong> surtido para Montacarguista.</li>
                        <li><strong>Verde:</strong> captura y validación.</li>
                        <li><strong>Naranja:</strong> ubicación de producto.</li>
                        <li><strong>Morado:</strong> coordinación de la operación.</li>
                    </ul>

                    <div class="op-alert">
                        Si ves un bloque en gris, ese módulo no está habilitado para tu usuario.
                    </div>
                </div>
            </div>
        </section>

    </div>
</div>
