<div class="pk-wrap">
    <div class="pk-shell">

        <a class="pk-back"
           href="@Url.Action(
                "PedidoPicking",
                "Surtido",
                new
                {
                    almacen = Model.Almacen.Codigo,
                    solicitudSurtidoId = Model.Pedido.SolicitudSurtidoId
                }
           )">
            ← Cambiar tarea
        </a>

        @if (TempData["Error"] != null)
        {
            <div class="pk-alert bad">@TempData["Error"]</div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Error))
        {
            <div class="pk-alert bad">@Model.Error</div>
        }

        <section class="pk-hero">
            <div class="pk-hero-grid">
                <div>
                    <div class="pk-kicker">DESTINO PEPS · VE A ESTA UBICACIÓN</div>
                    <div class="pk-destino">@destino</div>
                    <div class="pk-product">
                        @Model.Caja.ProductoNombre · @Model.Caja.CodigoEtiqueta · @Model.Caja.PesoNeto.ToString("N2") kg
                    </div>

                    <div class="pk-route">
                        <div class="pk-route-box">
                            <span>Pedido</span>
                            <strong>@Model.Pedido.Pedido</strong>
                        </div>
                        <div class="pk-route-box">
                            <span>Lote</span>
                            <strong>@Model.Caja.Lote</strong>
                        </div>
                        <div class="pk-route-box">
                            <span>Tarima</span>
                            <strong>@(string.IsNullOrWhiteSpace(Model.Caja.TarimaCodigo) ? "-" : Model.Caja.TarimaCodigo)</strong>
                        </div>
                        <div class="pk-route-box">
                            <span>Almacén</span>
                            <strong>@Model.Almacen.Codigo</strong>
                        </div>
                    </div>
                </div>

                <div class="pk-peps">
                    <strong>#@Model.Caja.OrdenPeps</strong>
                    <span>ORDEN PEPS</span>
                </div>
            </div>
        </section>

        <div class="pk-site">
            <span>🏭 @Model.Almacen.Planta</span>
            <span>📦 @Model.Almacen.Nombre</span>
            <span>🏷️ @Model.Almacen.Clasificacion</span>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Caja.UbicacionOrigen))
        {
            <section class="pk-map">
                <div class="pk-map-head">
                    <div>
                        <h3>📍 Ubicación física: @Model.Caja.UbicacionOrigen</h3>
                        <p>Usa el mapa si necesitas confirmar rack, posición o altura.</p>
                    </div>
                    <a class="pk-map-open"
                       href="@Url.Action(
                            "Mapa3D",
                            "Surtido",
                            new
                            {
                                almacen = Model.Almacen.Codigo,
                                ubicacion = Model.Caja.UbicacionOrigen
                            }
                       )">
                        Abrir mapa 3D
                    </a>
                </div>

                <div class="pk-map-body">
                    <div id="pickRack3d"
                         class="wms-rack3d"
                         data-location="@Model.Caja.UbicacionOrigen"
                         data-layout-known="@Model.Almacen.TieneLayout3D.ToString().ToLowerInvariant()"
                         data-compact="false"
                         data-info-target="#pickRackInfo">
                    </div>
                    <div id="pickRackInfo" class="wms-3d-info"></div>
                </div>
            </section>
        }

        <form method="post"
              action="@Url.Action("ConfirmarBajada","Surtido")"
              id="frmBajada"
              data-etiqueta="@((Model.Caja.CodigoEtiqueta ?? "").Trim().ToUpperInvariant())"
              data-tarima="@((Model.Caja.TarimaCodigo ?? "").Trim().ToUpperInvariant())">

            @Html.AntiForgeryToken()

            <input type="hidden" name="Almacen" value="@Model.Almacen.Codigo" />
            <input type="hidden" name="SolicitudSurtidoId" value="@Model.Pedido.SolicitudSurtidoId" />
            <input type="hidden" name="ProduccionId" value="@Model.Caja.ProduccionId" />

            <section class="pk-steps">

                <article class="pk-step blue">
                    <div class="pk-step-number">1</div>
                    <h2>Ve a la ubicación</h2>
                    <p>Confirma físicamente que estás en la ubicación indicada antes de escanear.</p>

                    @if (Model.Almacen.ObligaUbicacion)
                    {
                        if (string.IsNullOrWhiteSpace(Model.Caja.UbicacionOrigen))
                        {
                            <div class="pk-blocked">
                                BLOQUEADO: ProduccionId @Model.Caja.ProduccionId no tiene ubicación activa registrada.
                            </div>
                        }
                        else
                        {
                            <div class="pk-big-value">📍 @Model.Caja.UbicacionOrigen</div>
                        }
                    }
                    else
                    {
                        <div class="pk-big-value">Ubicación no obligatoria</div>
                    }
                </article>

                <article class="pk-step orange">
                    <div class="pk-step-number">2</div>
                    <h2>Escanea tarima o caja</h2>
                    <p>Escanea exactamente el producto indicado. También se acepta la etiqueta de la caja.</p>

                    <div class="pk-scan-label">Esperado</div>
                    <div class="pk-big-value">@codigoEsperado</div>

                    <div class="pk-scan-row">
                        <input id="CodigoEscaneado"
                               name="CodigoEscaneado"
                               placeholder="Escanea aquí..."
                               autocomplete="off"
                               @(puedeConfirmar ? "" : "disabled") />

                        <button type="button"
                                id="btnValidar"
                                @(puedeConfirmar ? "" : "disabled")>
                            VALIDAR
                        </button>
                    </div>

                    <div id="scanMessage" class="wms-validation"></div>
                </article>

                <article class="pk-step green">
                    <div class="pk-step-number">3</div>
                    <h2>Confirma la bajada</h2>
                    <p>Cuando el producto ya esté físicamente en Zona de Surtido, confirma el movimiento.</p>

                    <div class="pk-callout">
                        <strong>Montacarguista</strong>
                        Tu responsabilidad termina al dejar el producto en Zona de Surtido. El Capturista realiza después la vinculación oficial.
                    </div>

                    <button class="wms-success-large"
                            type="submit"
                            id="btnConfirmar"
                            disabled>
                        ✓ CONFIRMAR PRODUCTO BAJADO
                    </button>
                </article>

            </section>
        </form>

    </div>
</div>

@section Scripts {
    <script src="~/js/surtido-picking-tarea-erp.js"
            asp-append-version="true"></script>
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
<script src="~/js/surtido-wms-3d.js" asp-append-version="true"></script>
