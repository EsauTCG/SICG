@model Plataforma_CG.ViewModels.SurtidoPickingTareaVM

@{
    ViewData["Title"] = "Tarea de picking";
    Layout = "~/Views/Shared/_Layout2.cshtml";

    var ubicacionOk =
        !Model.Almacen.ObligaUbicacion
        ||
        !string.IsNullOrWhiteSpace(Model.Caja.UbicacionOrigen);

    var puedeConfirmar =
        string.IsNullOrWhiteSpace(Model.Error)
        && Model.Caja.EsRecomendada
        && Model.Caja.PuedeBajar
        && ubicacionOk;

    var destino = string.IsNullOrWhiteSpace(Model.Caja.UbicacionOrigen)
        ? "PEPS #" + Model.Caja.OrdenPeps
        : Model.Caja.UbicacionOrigen;

    var codigoEsperado = string.IsNullOrWhiteSpace(Model.Caja.TarimaCodigo)
        ? Model.Caja.CodigoEtiqueta
        : Model.Caja.TarimaCodigo;
}

<link rel="stylesheet"
      href="~/css/surtido-wms-v7.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="~/css/surtido-picking-tarea-erp.css"
      asp-append-version="true" />

<style>
    :root {
        --pk-bg:#f1f4f6;
        --pk-card:#ffffff;
        --pk-line:#d7e0e6;
        --pk-text:#1f2b37;
        --pk-muted:#607181;
        --pk-wine:#7a2029;
        --pk-wine-dark:#53161c;
        --pk-blue:#0d6efd;
        --pk-green:#198754;
        --pk-orange:#d98200;
        --pk-red:#b32635;
        --pk-shadow:0 10px 28px rgba(25,40,55,.08);
    }

    html,body{
        width:100%!important;
        max-width:100%!important;
        overflow-x:hidden!important;
    }

    body{
        background:var(--pk-bg)!important;
        color:var(--pk-text);
        font-family:"Segoe UI",Tahoma,Arial,sans-serif;
    }

    .container,.container-fluid,.layout-container-fluid,.layout-main-content{
        max-width:100%!important;
        width:100%!important;
    }

    .pk-wrap{
        width:100%;
        max-width:100%;
        padding:12px;
        box-sizing:border-box;
    }

    .pk-shell{
        max-width:1600px;
        margin:0 auto;
    }

    .pk-back{
        display:inline-flex;
        align-items:center;
        min-height:44px;
        padding:0 16px;
        background:#fff;
        color:#475867!important;
        border:1px solid var(--pk-line);
        border-radius:14px;
        font-size:15px;
        font-weight:800;
        text-decoration:none!important;
        margin-bottom:10px;
    }

    .pk-back:hover{background:#f7ecee;color:var(--pk-wine)!important;}

    .pk-alert{
        margin-bottom:10px;
        border-radius:14px;
        padding:13px 15px;
        font-size:14px;
        font-weight:800;
        border:1px solid transparent;
    }

    .pk-alert.bad{background:#fff0f2;color:#8e1f2b;border-color:#efc8ce;}
    .pk-alert.ok{background:#eaf7ef;color:#176b42;border-color:#c9e8d5;}

    .pk-hero{
        background:linear-gradient(135deg,var(--pk-wine-dark),var(--pk-wine));
        color:#fff;
        border-radius:22px;
        padding:20px;
        box-shadow:var(--pk-shadow);
        border:1px solid #491319;
    }

    .pk-hero-grid{
        display:grid;
        grid-template-columns:1.4fr .6fr;
        gap:16px;
        align-items:center;
    }

    .pk-kicker{
        font-size:12px;
        font-weight:900;
        letter-spacing:.08em;
        text-transform:uppercase;
        opacity:.84;
    }

    .pk-destino{
        margin:6px 0 4px;
        font-size:46px;
        line-height:1;
        font-weight:950;
    }

    .pk-product{
        font-size:17px;
        line-height:1.45;
        opacity:.95;
    }

    .pk-route{
        margin-top:16px;
        display:grid;
        grid-template-columns:repeat(4,minmax(0,1fr));
        gap:8px;
    }

    .pk-route-box{
        background:rgba(255,255,255,.10);
        border:1px solid rgba(255,255,255,.17);
        border-radius:14px;
        padding:10px 12px;
        min-width:0;
    }

    .pk-route-box span{
        display:block;
        font-size:11px;
        text-transform:uppercase;
        letter-spacing:.05em;
        font-weight:800;
        opacity:.78;
    }

    .pk-route-box strong{
        display:block;
        margin-top:4px;
        font-size:16px;
        font-weight:900;
        overflow:hidden;
        text-overflow:ellipsis;
        white-space:nowrap;
    }

    .pk-peps{
        background:rgba(255,255,255,.10);
        border:1px solid rgba(255,255,255,.20);
        border-radius:18px;
        padding:16px;
        text-align:center;
    }

    .pk-peps strong{
        display:block;
        font-size:36px;
        line-height:1;
        font-weight:950;
    }

    .pk-peps span{
        display:block;
        margin-top:5px;
        font-size:13px;
        font-weight:800;
        opacity:.86;
    }

    .pk-site{
        display:flex;
        gap:8px;
        flex-wrap:wrap;
        margin-top:10px;
    }

    .pk-site span{
        background:#fff;
        border:1px solid var(--pk-line);
        border-radius:999px;
        padding:7px 11px;
        font-size:13px;
        font-weight:800;
        color:#536675;
    }

    .pk-steps{
        margin-top:14px;
        display:grid;
        grid-template-columns:repeat(3,minmax(0,1fr));
        gap:12px;
    }

    .pk-step{
        position:relative;
        background:var(--pk-card);
        border:2px solid var(--pk-line);
        border-radius:20px;
        padding:17px;
        box-shadow:var(--pk-shadow);
    }

    .pk-step.blue{border-color:#c9dcff;background:#f6f9ff;}
    .pk-step.orange{border-color:#f2d7a3;background:#fffaf0;}
    .pk-step.green{border-color:#c5e7d2;background:#f4fbf7;}

    .pk-step-number{
        width:42px;
        height:42px;
        border-radius:999px;
        display:inline-flex;
        align-items:center;
        justify-content:center;
        color:#fff;
        font-size:20px;
        font-weight:950;
        margin-bottom:10px;
    }

    .pk-step.blue .pk-step-number{background:var(--pk-blue);}
    .pk-step.orange .pk-step-number{background:var(--pk-orange);}
    .pk-step.green .pk-step-number{background:var(--pk-green);}

    .pk-step h2{
        margin:0 0 6px;
        font-size:25px;
        font-weight:950;
        color:var(--pk-text);
    }

    .pk-step p{
        margin:0;
        font-size:15px;
        line-height:1.45;
        color:var(--pk-muted);
    }

    .pk-big-value{
        margin-top:12px;
        border-radius:16px;
        padding:16px;
        background:#fff;
        border:1px solid var(--pk-line);
        font-size:28px;
        line-height:1.1;
        font-weight:950;
        color:var(--pk-text);
        word-break:break-word;
    }

    .pk-scan-label{
        margin-top:14px;
        font-size:13px;
        font-weight:900;
        color:#4f5f6d;
        text-transform:uppercase;
        letter-spacing:.04em;
    }

    .pk-scan-row{
        margin-top:7px;
        display:grid;
        grid-template-columns:1fr 150px;
        gap:9px;
    }

    #CodigoEscaneado{
        width:100%;
        min-height:58px!important;
        height:58px!important;
        padding:0 16px!important;
        border:2px solid #9db8da!important;
        border-radius:15px!important;
        background:#fff!important;
        color:#1f2b37!important;
        font-size:19px!important;
        font-weight:800!important;
        box-shadow:none!important;
        outline:none!important;
    }

    #CodigoEscaneado:focus{
        border-color:var(--pk-blue)!important;
        box-shadow:0 0 0 4px rgba(13,110,253,.11)!important;
    }

    #btnValidar{
        min-height:58px!important;
        height:58px!important;
        border:0!important;
        border-radius:15px!important;
        background:linear-gradient(180deg,#2b83ff,#0d6efd)!important;
        color:#fff!important;
        font-size:16px!important;
        font-weight:950!important;
    }

    #btnValidar:disabled,#CodigoEscaneado:disabled{
        opacity:.55!important;
        cursor:not-allowed!important;
    }

    #scanMessage{
        min-height:22px;
        margin-top:9px;
        font-size:14px;
        font-weight:800;
    }

    .pk-callout{
        margin-top:14px;
        padding:13px 14px;
        border-radius:14px;
        background:#eef7f2;
        border:1px solid #c8e6d3;
        color:#255d3d;
        font-size:14px;
        line-height:1.4;
    }

    .pk-callout strong{display:block;font-size:15px;margin-bottom:3px;}

    #btnConfirmar{
        width:100%!important;
        min-height:66px!important;
        height:66px!important;
        margin-top:14px!important;
        border:0!important;
        border-radius:16px!important;
        background:linear-gradient(180deg,#29a766,#198754)!important;
        color:#fff!important;
        font-size:19px!important;
        font-weight:950!important;
        box-shadow:0 8px 20px rgba(25,135,84,.18)!important;
    }

    #btnConfirmar:disabled{
        background:#aeb8bf!important;
        box-shadow:none!important;
        opacity:.74!important;
        cursor:not-allowed!important;
    }

    .pk-map{
        margin-top:14px;
        background:#fff;
        border:1px solid var(--pk-line);
        border-radius:20px;
        box-shadow:var(--pk-shadow);
        overflow:hidden;
    }

    .pk-map-head{
        display:flex;
        justify-content:space-between;
        align-items:center;
        gap:12px;
        padding:14px 16px;
        background:linear-gradient(180deg,#fff,#f4f7f9);
        border-bottom:1px solid var(--pk-line);
    }

    .pk-map-head h3{
        margin:0;
        font-size:22px;
        font-weight:950;
    }

    .pk-map-head p{
        margin:3px 0 0;
        font-size:14px;
        color:var(--pk-muted);
    }

    .pk-map-open{
        display:inline-flex;
        align-items:center;
        justify-content:center;
        min-height:46px;
        padding:0 15px;
        border-radius:14px;
        background:var(--pk-blue);
        color:#fff!important;
        text-decoration:none!important;
        font-size:14px;
        font-weight:950;
        white-space:nowrap;
    }

    .pk-map-body{padding:12px;}

    .pk-map .wms-rack3d{
        min-height:260px!important;
        border-radius:14px!important;
        overflow:hidden!important;
    }

    .pk-map .wms-3d-info{
        margin-top:8px;
        font-size:13px;
        color:var(--pk-muted);
    }

    .pk-blocked{
        margin-top:12px;
        padding:13px 14px;
        border-radius:14px;
        background:#fff0f2;
        border:1px solid #efc8ce;
        color:#8e1f2b;
        font-size:14px;
        font-weight:800;
    }

    @@media(max-width:1100px){
        .pk-hero-grid{grid-template-columns:1fr;}
        .pk-steps{grid-template-columns:1fr;}
    }

    @@media(max-width:760px){
        .pk-wrap{padding:6px;}
        .pk-hero{border-radius:16px;padding:15px;}
        .pk-destino{font-size:34px;}
        .pk-route{grid-template-columns:1fr 1fr;}
        .pk-scan-row{grid-template-columns:1fr;}
        #btnValidar{width:100%!important;}
        .pk-map-head{align-items:flex-start;flex-direction:column;}
        .pk-map-open{width:100%;}
    }
</style>
<style id="responsive-operativo-final">
