@using Plataforma_CG.ViewModels
@model Plataforma_CG.ViewModels.SurtidoAlmacenVM

@{
    ViewData["Title"] = "Captura";
    Layout = "~/Views/Shared/_Layout2.cshtml";

    var staging =
        ViewBag.ZonaSurtido as List<SurtidoBajadaFilaVM>
        ?? new List<SurtidoBajadaFilaVM>();
}

<link rel="stylesheet"
      href="~/css/surtido-wms-v7.css"
      asp-append-version="true" />

<style>
    :root {
        --cap-bg: #f3f5f7;
        --cap-card: #ffffff;
        --cap-line: #d8e0e6;
        --cap-text: #1f2b37;
        --cap-muted: #667787;
        --cap-primary: #198754;
        --cap-primary-dark: #11653f;
        --cap-blue: #0d6efd;
        --cap-orange: #d98200;
        --cap-red: #b4232f;
        --cap-burgundy: #7a2029;
        --cap-shadow: 0 12px 32px rgba(22, 35, 48, .08);
    }

    html, body {
        width: 100% !important;
        max-width: 100% !important;
        overflow-x: hidden !important;
    }

    body {
        background: var(--cap-bg) !important;
        color: var(--cap-text);
        font-family: "Segoe UI", Tahoma, Arial, sans-serif;
    }

    body:has(.cap-wrap) .layout-main-content,
    body:has(.cap-wrap) .layout-main-content .layout-container-fluid {
        width: 100% !important;
        max-width: 100% !important;
        min-width: 0 !important;
        box-sizing: border-box !important;
    }

    body:has(.cap-wrap) .layout-main-content .layout-container-fluid {
        padding: 0 !important;
        margin: 0 !important;
    }

    .cap-wrap {
        width: 100%;
        padding: 14px;
        box-sizing: border-box;
    }

    .cap-shell {
        width: 100%;
        max-width: 1600px;
        margin: 0 auto;
    }

    .cap-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-height: 42px;
        padding: 0 14px;
        margin-bottom: 10px;
        background: #fff;
        color: #425466 !important;
        text-decoration: none !important;
        border: 1px solid var(--cap-line);
        border-radius: 12px;
        font-size: 14px;
        font-weight: 800;
    }

    .cap-back:hover {
        background: #f6f8fa;
        color: var(--cap-burgundy) !important;
    }

    .cap-hero {
        display: grid;
        grid-template-columns: 1.25fr .75fr;
        gap: 16px;
        padding: 20px;
        background: linear-gradient(135deg, #0f5132, var(--cap-primary));
        color: #fff;
        border: 1px solid #0f6841;
        border-radius: 22px;
        box-shadow: var(--cap-shadow);
    }

    .cap-kicker {
        font-size: 13px;
        font-weight: 900;
        letter-spacing: .07em;
        text-transform: uppercase;
        opacity: .86;
    }

    .cap-title {
        margin: 7px 0 5px;
        font-size: 34px;
        line-height: 1.05;
        font-weight: 900;
    }

    .cap-desc {
        margin: 0;
        max-width: 820px;
        font-size: 16px;
        line-height: 1.45;
        opacity: .96;
    }

    .cap-steps {
        display: grid;
        grid-template-columns: repeat(3, minmax(0,1fr));
        gap: 9px;
        margin-top: 16px;
    }

    .cap-step {
        background: rgba(255,255,255,.10);
        border: 1px solid rgba(255,255,255,.18);
        border-radius: 15px;
        padding: 11px;
    }

    .cap-step b {
        display: inline-flex;
        width: 30px;
        height: 30px;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        background: #fff;
        color: var(--cap-primary);
        font-size: 15px;
        margin-bottom: 7px;
    }

    .cap-step strong {
        display: block;
        font-size: 15px;
        margin-bottom: 3px;
    }

    .cap-step span {
        display: block;
        font-size: 12px;
        line-height: 1.35;
        opacity: .92;
    }

    .cap-context {
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        gap: 12px;
        background: rgba(255,255,255,.10);
        border: 1px solid rgba(255,255,255,.18);
        border-radius: 18px;
        padding: 15px;
    }

    .cap-context small {
        display: block;
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .05em;
        opacity: .78;
    }

    .cap-context strong {
        display: block;
        margin-top: 4px;
        font-size: 22px;
        font-weight: 900;
    }

    .cap-context span {
        display: block;
        margin-top: 3px;
        font-size: 13px;
        opacity: .9;
    }

    .cap-kpis {
        display: grid;
        grid-template-columns: repeat(3, minmax(0,1fr));
        gap: 12px;
        margin-top: 14px;
    }

    .cap-kpi {
        background: var(--cap-card);
        border: 1px solid var(--cap-line);
        border-radius: 17px;
        padding: 15px 17px;
        box-shadow: var(--cap-shadow);
        min-height: 110px;
    }

    .cap-kpi span {
        display: block;
        color: var(--cap-muted);
        font-size: 12px;
        font-weight: 900;
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    .cap-kpi strong {
        display: block;
        margin-top: 5px;
        color: var(--cap-text);
        font-size: 30px;
        line-height: 1;
        font-weight: 900;
    }

    .cap-kpi small {
        display: block;
        margin-top: 7px;
        color: var(--cap-muted);
        font-size: 13px;
    }

    .cap-kpi.pending {
        border-left: 6px solid var(--cap-orange);
    }

    .cap-kpi.warehouse {
        border-left: 6px solid var(--cap-blue);
    }

    .cap-kpi.origin {
        border-left: 6px solid var(--cap-primary);
    }

    .cap-section {
        margin-top: 14px;
        background: var(--cap-card);
        border: 1px solid var(--cap-line);
        border-radius: 22px;
        box-shadow: var(--cap-shadow);
        overflow: hidden;
    }

    .cap-section-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 16px 18px;
        background: linear-gradient(180deg, #fff, #f5f8fa);
        border-bottom: 1px solid var(--cap-line);
    }

    .cap-section-head span {
        display: block;
        color: var(--cap-primary);
        font-size: 12px;
        font-weight: 900;
        letter-spacing: .06em;
        text-transform: uppercase;
    }

    .cap-section-head h2 {
        margin: 3px 0 0;
        font-size: 23px;
        font-weight: 900;
    }

    .cap-count {
        min-width: 94px;
        text-align: center;
        padding: 9px 12px;
        border-radius: 999px;
        background: #fff3dc;
        border: 1px solid #f0d5a1;
        color: #8a5a00;
        font-size: 14px;
        font-weight: 900;
    }

    .cap-list {
        display: grid;
        gap: 11px;
        padding: 16px;
    }

    .cap-item {
        display: grid;
        grid-template-columns: auto minmax(0,1fr) auto;
        gap: 14px;
        align-items: center;
        padding: 15px;
        background: #fffaf0;
        border: 2px solid #f0ddb6;
        border-left: 7px solid var(--cap-orange);
        border-radius: 18px;
        transition: .15s ease;
    }

    .cap-item:hover {
        border-color: #e7ca90;
        border-left-color: var(--cap-orange);
        box-shadow: 0 10px 24px rgba(41, 50, 58, .07);
    }

    .cap-item-icon {
        width: 58px;
        height: 58px;
        border-radius: 17px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fff0d1;
        color: var(--cap-orange);
        font-size: 29px;
        font-weight: 900;
        border: 1px solid #efd7a4;
    }

    .cap-item-main strong {
        display: block;
        color: var(--cap-text);
        font-size: 20px;
        line-height: 1.15;
        font-weight: 900;
        word-break: break-word;
    }

    .cap-item-main span {
        display: block;
        margin-top: 5px;
        color: #435466;
        font-size: 14px;
        line-height: 1.4;
        font-weight: 700;
    }

    .cap-item-main small {
        display: block;
        margin-top: 6px;
        color: var(--cap-muted);
        font-size: 12px;
        line-height: 1.4;
    }

    .cap-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 120px;
        min-height: 42px;
        border-radius: 14px;
        background: var(--cap-orange);
        color: #fff;
        font-size: 13px;
        font-weight: 900;
        letter-spacing: .03em;
        text-transform: uppercase;
    }

    .cap-empty {
        margin: 16px;
        padding: 28px 18px;
        text-align: center;
        background: #eef8f2;
        border: 2px dashed #b8dfc9;
        border-radius: 18px;
        color: #246445;
        font-size: 16px;
        font-weight: 800;
    }

    .cap-empty strong {
        display: block;
        font-size: 24px;
        margin-bottom: 5px;
    }

    .cap-warning {
        margin-top: 14px;
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 12px;
        align-items: start;
        padding: 15px 17px;
        background: #fff1f1;
        border: 1px solid #ecc3c7;
        border-left: 6px solid var(--cap-red);
        border-radius: 16px;
        color: #7a1d26;
        box-shadow: var(--cap-shadow);
    }

    .cap-warning-icon {
        width: 36px;
        height: 36px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #ffe1e4;
        color: var(--cap-red);
        font-size: 20px;
        font-weight: 900;
    }

    .cap-warning strong {
        display: block;
        margin-bottom: 3px;
        font-size: 15px;
        font-weight: 900;
    }

    .cap-warning span {
        display: block;
        font-size: 13px;
        line-height: 1.45;
    }

    @@media (max-width: 980px) {
        .cap-hero {
            grid-template-columns: 1fr;
        }

        .cap-kpis {
            grid-template-columns: 1fr 1fr;
        }

        .cap-kpi:first-child {
            grid-column: 1 / -1;
        }
    }

    @@media (max-width: 720px) {
        .cap-wrap {
            padding: 8px;
        }

        .cap-hero,
        .cap-section {
            border-radius: 16px;
        }

        .cap-title {
            font-size: 27px;
        }

        .cap-steps,
        .cap-kpis {
            grid-template-columns: 1fr;
        }

        .cap-kpi:first-child {
            grid-column: auto;
        }

        .cap-item {
            grid-template-columns: auto minmax(0,1fr);
        }

        .cap-badge {
            grid-column: 1 / -1;
            width: 100%;
        }
    }
</style>
<style id="responsive-operativo-final">
.cap-wrap,.cap-shell,.cap-hero,.cap-kpis,.cap-section,.cap-list,.cap-item{min-width:0!important;max-width:100%!important}.cap-wrap{padding:7px!important}.cap-shell{max-width:none!important;margin:0!important}.cap-back{min-height:32px!important;margin-bottom:5px!important;padding:0 9px!important;border-radius:8px!important;font-size:9px!important}.cap-hero{grid-template-columns:minmax(0,1.35fr) minmax(230px,.65fr)!important;gap:9px!important;padding:10px 12px!important;border-radius:14px!important}.cap-kicker{font-size:8px!important}.cap-title{margin:3px 0!important;font-size:clamp(22px,2.1vw,30px)!important}.cap-desc{font-size:9px!important;line-height:1.3!important}.cap-steps{grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:5px!important;margin-top:7px!important}.cap-step{padding:6px!important;border-radius:9px!important;display:grid!important;grid-template-columns:24px minmax(0,1fr)!important;grid-template-rows:auto auto!important;gap:2px 6px!important}.cap-step b{grid-row:1/3!important;width:24px!important;height:24px!important;margin:0!important;font-size:9px!important}.cap-step strong{font-size:9px!important;margin:0!important}.cap-step span{font-size:7px!important;line-height:1.15!important}.cap-context{gap:6px!important;padding:8px!important;border-radius:10px!important}.cap-context small{font-size:7px!important}.cap-context strong{margin-top:2px!important;font-size:12px!important}.cap-context span{font-size:7px!important}
.cap-kpis{grid-template-columns:repeat(3,minmax(0,1fr))!important;gap:6px!important;margin-top:6px!important}.cap-kpi{min-height:58px!important;padding:7px 9px!important;border-radius:10px!important;border-left-width:4px!important}.cap-kpi span{font-size:7px!important}.cap-kpi strong{margin-top:2px!important;font-size:18px!important}.cap-kpi small{margin-top:2px!important;font-size:7px!important}.cap-section{margin-top:6px!important;border-radius:12px!important}.cap-section-head{padding:7px 9px!important}.cap-section-head span{font-size:7px!important}.cap-section-head h2{font-size:13px!important}.cap-count{min-width:70px!important;padding:4px 7px!important;font-size:7px!important}.cap-list{gap:5px!important;padding:7px!important}.cap-item{grid-template-columns:32px minmax(0,1fr) 70px!important;gap:7px!important;padding:7px 8px!important;border-radius:10px!important;border-left-width:4px!important}.cap-item-icon{width:32px!important;height:32px!important;border-radius:9px!important;font-size:17px!important}.cap-item-main strong{font-size:11px!important}.cap-item-main span{font-size:7.5px!important;line-height:1.25!important}.cap-item-main small{font-size:6.8px!important;line-height:1.2!important}.cap-badge{padding:5px 7px!important;border-radius:999px!important;font-size:7px!important}.cap-warning{margin-top:6px!important;grid-template-columns:28px minmax(0,1fr)!important;gap:7px!important;padding:7px 9px!important;border-radius:10px!important;border-left-width:4px!important}.cap-warning-icon{width:28px!important;height:28px!important;border-radius:8px!important;font-size:14px!important}.cap-warning strong{font-size:9px!important}.cap-warning span{font-size:7px!important;line-height:1.25!important}
@@media(max-width:900px){.cap-hero{grid-template-columns:minmax(0,1.2fr) minmax(200px,.8fr)!important}.cap-kpis{grid-template-columns:repeat(3,minmax(0,1fr))!important}.cap-item{grid-template-columns:30px minmax(0,1fr) 65px!important}}
@@media(max-width:680px){.cap-hero{grid-template-columns:1fr!important}.cap-desc{display:none!important}.cap-steps{grid-template-columns:1fr!important}.cap-kpis{grid-template-columns:repeat(3,minmax(0,1fr))!important}.cap-kpi small{display:none!important}.cap-item{grid-template-columns:28px minmax(0,1fr)!important}.cap-badge{grid-column:1/-1!important;width:100%!important}}
@@media(max-width:500px){.cap-kpis{grid-template-columns:1fr!important}}
</style>


<div class="cap-wrap">
    <div class="cap-shell">

        <a class="cap-back"
           href="@Url.Action(
                "Surtido_cedis",
                "Surtido",
                new
                {
                    almacen = Model.Codigo
                }
           )">
            ← Regresar al inicio
        </a>

        <section class="cap-hero">
            <div>
                <div class="cap-kicker">CAPTURISTA · ZONA DE SURTIDO</div>
                <div class="cap-title">Producto pendiente de captura</div>
                <p class="cap-desc">
                    Aquí aparece el producto que el Montacarguista ya bajó a Zona de Surtido.
                    Revisa la tarima o etiqueta antes de continuar con la captura.
                </p>

                <div class="cap-steps">
                    <div class="cap-step">
                        <b>1</b>
                        <strong>Identifica</strong>
                        <span>Busca la tarima o etiqueta que aparece en pantalla.</span>
                    </div>
                    <div class="cap-step">
                        <b>2</b>
                        <strong>Escanea</strong>
                        <span>Valida físicamente que corresponda al producto bajado.</span>
                    </div>
                    <div class="cap-step">
                        <b>3</b>
                        <strong>Vincula</strong>
                        <span>Cuando el procedimiento oficial esté habilitado, se ligará al pedido.</span>
                    </div>
                </div>
            </div>

            <div class="cap-context">
                <div>
                    <small>Almacén actual</small>
                    <strong>@Model.Codigo · @Model.Nombre</strong>
                    <span>@Model.Planta · @Model.Sucursal</span>
                </div>

                <div>
                    <small>Cola pendiente</small>
                    <strong>@staging.Count registro@(staging.Count == 1 ? "" : "s")</strong>
                    <span>Producto ya bajado por Montacarguista.</span>
                </div>
            </div>
        </section>

        <section class="cap-kpis">
            <article class="cap-kpi pending">
                <span>Pendientes</span>
                <strong>@staging.Count</strong>
                <small>En Zona de Surtido</small>
            </article>

            <article class="cap-kpi warehouse">
                <span>Almacén</span>
                <strong>@Model.Codigo</strong>
                <small>@Model.Nombre</small>
            </article>

            <article class="cap-kpi origin">
                <span>Origen</span>
                <strong>@Model.Planta</strong>
                <small>@Model.Sucursal</small>
            </article>
        </section>

        <section class="cap-section">
            <div class="cap-section-head">
                <div>
                    <span>Producto bajado</span>
                    <h2>Pendiente de captura</h2>
                </div>

                <div class="cap-count">
                    @staging.Count pendiente@(staging.Count == 1 ? "" : "s")
                </div>
            </div>

            @if (staging.Any())
            {
                <div class="cap-list">
                    @foreach (var x in staging)
                    {
                        <div class="cap-item">
                            <div class="cap-item-icon">⇣</div>

                            <div class="cap-item-main">
                                <strong>
                                    @(string.IsNullOrWhiteSpace(x.TarimaCodigo)
                                        ? x.CodigoEtiqueta
                                        : x.TarimaCodigo)
                                    · @x.Articulo
                                </strong>

                                <span>
                                    Etiqueta @x.CodigoEtiqueta
                                    · @x.PesoNeto?.ToString("N2") kg
                                    · Lote @x.Lote
                                </span>

                                <small>
                                    Solicitud @x.SolicitudSurtidoId
                                    · Bajó @x.UsuarioBaja
                                    · @x.FechaBaja.ToString("dd/MM HH:mm")
                                </small>
                            </div>

                            <div class="cap-badge">Pendiente</div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="cap-empty">
                    <strong>✓ Sin pendientes</strong>
                    Aún no hay producto bajado por Montacarguista en esta zona.
                </div>
            }
        </section>

        <div class="cap-warning">
            <div class="cap-warning-icon">!</div>
            <div>
                <strong>Vinculación final todavía no habilitada</strong>
                <span>
                    La cola real ya está conectada. La acción final “VINCULAR AL PEDIDO” todavía no debe escribir directamente
                    en SalidaEmbarque hasta confirmar el procedimiento oficial de Meat que afecta existencia, ProduccionLog y tarimas.
                </span>
            </div>
        </div>

    </div>
</div>
