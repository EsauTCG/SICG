@model Plataforma_CG.ViewModels.SurtidoAlmacenVM

@{
    ViewData["Title"] = "Ubicación inteligente";
    Layout = "~/Views/Shared/_Layout2.cshtml";
}

<link rel="stylesheet"
      href="~/css/surtido-wms-v7.css"
      asp-append-version="true" />

<link rel="stylesheet"
      href="~/css/surtido-ubicacion-inteligente-erp.css"
      asp-append-version="true" />

<style>
    :root {
        --put-bg: #f3f5f7;
        --put-card: #ffffff;
        --put-line: #d9e1e7;
        --put-text: #1e2a35;
        --put-muted: #607282;
        --put-burgundy: #7a2029;
        --put-burgundy-dark: #53161c;
        --put-blue: #0d6efd;
        --put-green: #198754;
        --put-orange: #d98200;
        --put-yellow: #f2b233;
        --put-red: #b02a37;
        --put-shadow: 0 12px 34px rgba(20, 35, 48, .08);
    }

    html,
    body {
        width: 100% !important;
        max-width: 100% !important;
        overflow-x: hidden !important;
    }

    body {
        background: var(--put-bg) !important;
        color: var(--put-text) !important;
        font-family: "Segoe UI", Tahoma, Arial, sans-serif !important;
    }

    body:has(.put-op) .layout-main-content,
    body:has(.put-op) .layout-container-fluid {
        width: 100% !important;
        max-width: 100% !important;
        min-width: 0 !important;
        box-sizing: border-box !important;
    }

    .put-op {
        width: 100%;
        max-width: 1600px;
        margin: 0 auto;
        padding: 14px;
        box-sizing: border-box;
    }

    .put-back {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 0 16px;
        margin-bottom: 10px;
        background: #fff;
        color: #52626f !important;
        border: 1px solid #cbd5dc;
        border-radius: 12px;
        font-size: 14px;
        font-weight: 800;
        text-decoration: none !important;
    }

    .put-back:hover {
        background: #f8ecee;
        color: var(--put-burgundy) !important;
    }

    .put-hero {
        background: linear-gradient(135deg, var(--put-burgundy-dark), var(--put-burgundy));
        color: #fff;
        border-radius: 22px;
        padding: 20px;
        box-shadow: var(--put-shadow);
        margin-bottom: 14px;
    }

    .put-hero-grid {
        display: grid;
        grid-template-columns: 1.15fr .85fr;
        gap: 16px;
        align-items: stretch;
    }

    .put-kicker {
        font-size: 12px;
        font-weight: 900;
        letter-spacing: .08em;
        text-transform: uppercase;
        opacity: .8;
    }

    .put-title {
        margin: 6px 0 5px;
        font-size: 32px;
        line-height: 1.05;
        font-weight: 900;
    }

    .put-subtitle {
        margin: 0;
        font-size: 15px;
        line-height: 1.45;
        opacity: .93;
        max-width: 800px;
    }

    .put-steps-top {
        display: grid;
        grid-template-columns: repeat(3,minmax(0,1fr));
        gap: 9px;
        margin-top: 16px;
    }

    .put-step-top {
        min-height: 88px;
        padding: 12px;
        border-radius: 15px;
        border: 1px solid rgba(255,255,255,.18);
        background: rgba(255,255,255,.10);
    }

    .put-step-top i {
        width: 30px;
        height: 30px;
        border-radius: 999px;
        background: #fff;
        color: var(--put-burgundy);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-style: normal;
        font-weight: 900;
        margin-bottom: 7px;
    }

    .put-step-top strong {
        display: block;
        font-size: 15px;
        margin-bottom: 3px;
    }

    .put-step-top span {
        display: block;
        font-size: 12px;
        line-height: 1.35;
        opacity: .9;
    }

    .put-context {
        border-radius: 18px;
        border: 1px solid rgba(255,255,255,.18);
        background: rgba(255,255,255,.10);
        padding: 15px;
        display: grid;
        gap: 10px;
    }

    .put-context h3 {
        margin: 0;
        font-size: 18px;
        font-weight: 900;
    }

    .put-context-box {
        border-radius: 14px;
        border: 1px solid rgba(255,255,255,.16);
        background: rgba(255,255,255,.08);
        padding: 11px 13px;
    }

    .put-context-box small {
        display: block;
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .05em;
        opacity: .75;
    }

    .put-context-box strong {
        display: block;
        margin-top: 4px;
        font-size: 18px;
        line-height: 1.25;
    }

    .put-rotation {
        display: grid;
        grid-template-columns: repeat(3,minmax(0,1fr));
        gap: 12px;
        margin-bottom: 14px;
    }

    .put-rotation-card {
        display: flex;
        align-items: center;
        gap: 12px;
        border-radius: 18px;
        border: 2px solid transparent;
        padding: 14px;
        min-height: 100px;
        background: #fff;
        box-shadow: var(--put-shadow);
    }

    .put-rotation-icon {
        width: 52px;
        height: 52px;
        border-radius: 15px;
        display: grid;
        place-items: center;
        font-size: 24px;
        font-weight: 900;
        flex: 0 0 auto;
    }

    .put-rotation-card small {
        display: block;
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .put-rotation-card strong {
        display: block;
        margin-top: 2px;
        font-size: 20px;
        font-weight: 900;
    }

    .put-rotation-card span {
        display: block;
        margin-top: 2px;
        font-size: 13px;
        font-weight: 700;
    }

    .put-rotation-card.high { background: #f3fbf7; border-color: #c9ead7; }
    .put-rotation-card.high .put-rotation-icon { background: #dff3e7; color: var(--put-green); }
    .put-rotation-card.medium { background: #fff9ef; border-color: #f2dfb8; }
    .put-rotation-card.medium .put-rotation-icon { background: #fff0cf; color: var(--put-orange); }
    .put-rotation-card.low { background: #f4f8ff; border-color: #ccdcf6; }
    .put-rotation-card.low .put-rotation-icon { background: #e3edff; color: var(--put-blue); }

    .put-rule {
        margin-bottom: 14px;
        padding: 12px 14px;
        border-radius: 14px;
        border: 1px solid #e7d39e;
        background: #fff8e8;
        color: #705a1a;
        font-size: 13px;
        line-height: 1.45;
    }

    .put-rule strong { font-weight: 900; }

    .put-workspace {
        display: grid;
        grid-template-columns: minmax(0,1.05fr) minmax(360px,.95fr);
        gap: 14px;
        align-items: start;
    }

    .put-left {
        display: grid;
        gap: 14px;
    }

    .put-card {
        background: #fff;
        border: 1px solid var(--put-line);
        border-radius: 20px;
        box-shadow: var(--put-shadow);
        padding: 18px;
        position: relative;
        overflow: hidden;
    }

    .put-card::before {
        content: "";
        position: absolute;
        inset: 0 auto 0 0;
        width: 6px;
        background: var(--put-blue);
    }

    .put-card.step-2::before { background: var(--put-orange); }
    .put-card.step-3::before { background: var(--put-green); }

    .put-card.disabled {
        opacity: .62;
        background: #f5f7f8;
        box-shadow: none;
    }

    .put-card-label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border-radius: 999px;
        padding: 7px 10px;
        background: #e9f2ff;
        color: var(--put-blue);
        font-size: 12px;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .step-2 .put-card-label { background: #fff0d4; color: var(--put-orange); }
    .step-3 .put-card-label { background: #e4f5eb; color: var(--put-green); }

    .put-card h2 {
        margin: 12px 0 5px;
        font-size: 25px;
        font-weight: 900;
        color: var(--put-text);
    }

    .put-card p {
        margin: 0;
        color: var(--put-muted);
        font-size: 14px;
        line-height: 1.45;
    }

    .put-scan-row {
        display: grid;
        grid-template-columns: minmax(0,1fr) 170px;
        gap: 10px;
        margin-top: 15px;
    }

    .put-scan-row input {
        width: 100%;
        min-height: 58px;
        border-radius: 15px;
        border: 2px solid #c9d4dc;
        background: #fff;
        color: #17232d;
        padding: 0 16px;
        font-size: 20px;
        font-weight: 800;
        outline: none;
        box-sizing: border-box;
    }

    .put-scan-row input:focus {
        border-color: var(--put-blue);
        box-shadow: 0 0 0 4px rgba(13,110,253,.10);
    }

    .step-2 .put-scan-row input:focus {
        border-color: var(--put-orange);
        box-shadow: 0 0 0 4px rgba(217,130,0,.10);
    }

    .put-scan-row button,
    .put-confirm-btn {
        min-height: 58px;
        border: 0;
        border-radius: 15px;
        color: #fff;
        font-size: 16px;
        font-weight: 900;
        cursor: pointer;
    }

    #btnBuscarInventory { background: linear-gradient(180deg,#348cff,#0d6efd); }
    #btnValidateDestination { background: linear-gradient(180deg,#f1a928,#d98200); }
    .put-confirm-btn { width: 100%; margin-top: 16px; background: linear-gradient(180deg,#29a96a,#198754); font-size: 19px; }

    .put-scan-row button:disabled,
    .put-confirm-btn:disabled,
    .put-scan-row input:disabled {
        cursor: not-allowed;
        opacity: .55;
    }

    .put-note {
        margin-top: 10px;
        padding: 10px 12px;
        border-radius: 12px;
        background: #f7f9fa;
        border: 1px solid #dde5ea;
        color: var(--put-muted);
        font-size: 13px;
        font-weight: 700;
    }

    .put-note .candidate {
        display: block;
        margin-top: 4px;
        color: var(--put-orange);
        font-weight: 900;
        font-size: 15px;
    }

    .slotting-result {
        margin-top: 14px;
        min-height: 84px;
        border-radius: 14px;
        border: 1px dashed #b9c7d0;
        background: #f9fbfc;
        padding: 14px;
        color: #536675;
        font-size: 14px;
        line-height: 1.45;
    }

    .put-preview {
        position: sticky;
        top: 12px;
        background: #fff;
        border: 1px solid var(--put-line);
        border-radius: 20px;
        box-shadow: var(--put-shadow);
        overflow: hidden;
    }

    .put-preview-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        padding: 16px;
        background: linear-gradient(180deg,#ffffff,#f3f6f8);
        border-bottom: 1px solid var(--put-line);
    }

    .put-preview-head small {
        display: block;
        font-size: 11px;
        font-weight: 900;
        text-transform: uppercase;
        color: var(--put-burgundy);
        letter-spacing: .05em;
    }

    .put-preview-head h2 {
        margin: 3px 0 0;
        font-size: 20px;
        font-weight: 900;
    }

    .put-focus {
        min-height: 42px;
        border-radius: 12px;
        border: 1px solid #c9d7e4;
        background: #edf5ff;
        color: #0b5cc4;
        padding: 0 12px;
        font-weight: 900;
    }

    #putaway3d {
        min-height: 420px;
        border: 0 !important;
        border-radius: 0 !important;
    }

    #putaway3dInfo {
        padding: 10px 14px;
        font-size: 13px;
        color: var(--put-muted);
    }

    .put-preview-legend,
    .put-zone-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        padding: 0 14px 12px;
    }

    .put-preview-legend span,
    .put-zone-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border-radius: 999px;
        padding: 6px 9px;
        background: #f5f7f9;
        border: 1px solid #d7e0e6;
        font-size: 11px;
        font-weight: 800;
        color: #50606d;
    }

    .put-zone-badge.high { background: #e6f6ed; color: #176d43; border-color: #c7e7d3; }
    .put-zone-badge.medium { background: #fff2d9; color: #8c5d00; border-color: #efd6a6; }
    .put-zone-badge.low { background: #e8f1ff; color: #0e58b2; border-color: #c8dbf7; }

    .preview-location {
        width: calc(100% - 28px);
        margin: 0 14px 14px;
        min-height: 48px;
        border: 2px solid #cad5dd;
        border-radius: 13px;
        background: #f8fafb;
        color: var(--put-burgundy);
        text-align: center;
        font-size: 20px;
        font-weight: 900;
    }

    @@media (max-width: 1100px) {
        .put-hero-grid,
        .put-workspace {
            grid-template-columns: 1fr;
        }

        .put-preview {
            position: static;
        }

        #putaway3d {
            min-height: 330px;
        }
    }

    @@media (max-width: 800px) {
        .put-op { padding: 8px; }
        .put-hero { border-radius: 16px; padding: 15px; }
        .put-title { font-size: 26px; }
        .put-steps-top,
        .put-rotation { grid-template-columns: 1fr; }
        .put-scan-row { grid-template-columns: 1fr; }
        .put-card { border-radius: 16px; padding: 15px; }
        .put-scan-row button { width: 100%; }
    }
</style>
