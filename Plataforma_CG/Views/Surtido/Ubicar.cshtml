<div class="wms-v7 put-op">

    <main class="putaway-page">

        <a class="put-back"
           href="@Url.Action(
                "Surtido_cedis",
                "Surtido",
                new
                {
                    almacen = Model.Codigo
                }
           )">
            ‹ Volver al inicio
        </a>

        <section class="put-hero">
            <div class="put-hero-grid">
                <div>
                    <div class="put-kicker">UBICACIÓN INTELIGENTE · OPERACIÓN</div>
                    <h1 class="put-title">Ubicar tarima o caja</h1>
                    <p class="put-subtitle">
                        Sigue tres pasos: escanea el inventario, usa la ubicación sugerida y confirma el destino.
                        El sistema calcula la zona por rotación y mantiene el mismo SKU agrupado.
                    </p>

                    <div class="put-steps-top">
                        <div class="put-step-top">
                            <i>1</i>
                            <strong>Escanea producto</strong>
                            <span>Lee la tarima o caja real que vas a acomodar.</span>
                        </div>
                        <div class="put-step-top">
                            <i>2</i>
                            <strong>Ve al destino</strong>
                            <span>Usa la ubicación que SIGO te recomienda.</span>
                        </div>
                        <div class="put-step-top">
                            <i>3</i>
                            <strong>Confirma ubicación</strong>
                            <span>Escanea el rack/posición y confirma el movimiento.</span>
                        </div>
                    </div>
                </div>

                <div class="put-context">
                    <h3>Almacén actual</h3>

                    <div class="put-context-box">
                        <small>Planta / almacén</small>
                        <strong>@Model.Nombre</strong>
                    </div>

                    <div class="put-context-box">
                        <small>Clasificación</small>
                        <strong>@Model.Clasificacion</strong>
                    </div>

                    <div class="put-context-box">
                        <small>Layout</small>
                        <strong>@(Model.TieneLayout3D ? "3D CONFIRMADO" : "RACK 3D")</strong>
                    </div>
                </div>
            </div>
        </section>

        <section class="put-rotation">
            <article class="put-rotation-card high">
                <div class="put-rotation-icon">⚡</div>
                <div>
                    <small>Alta rotación</small>
                    <strong>≤ 7 días</strong>
                    <span>FRENTE · cerca de surtido</span>
                </div>
            </article>

            <article class="put-rotation-card medium">
                <div class="put-rotation-icon">↔</div>
                <div>
                    <small>Media rotación</small>
                    <strong>8–20 días</strong>
                    <span>ZONA MEDIA</span>
                </div>
            </article>

            <article class="put-rotation-card low">
                <div class="put-rotation-icon">◷</div>
                <div>
                    <small>Baja rotación</small>
                    <strong>&gt; 20 días</strong>
                    <span>FONDO · menor prioridad</span>
                </div>
            </article>
        </section>

        <div class="put-rule">
            <strong>Cómo decide SIGO:</strong>
            almacén correcto → TIF / NO TIF → rotación → zona física → mismo SKU junto → continuidad → ubicación final.
        </div>

        <section class="put-workspace">

            <div class="put-left">

                <article class="put-card step-1">
                    <div class="put-card-label">1 · Escanea inventario</div>

                    <h2>¿Qué producto vas a ubicar?</h2>
                    <p>
                        Escanea la tarima o caja. SIGO calculará su rotación y te dará la mejor zona disponible.
                    </p>

                    <div class="put-scan-row">
                        <input id="scanInventory"
                               placeholder="Escanea tarima o caja"
                               autocomplete="off" />

                        <button id="btnBuscarInventory"
                                type="button">
                            BUSCAR
                        </button>
                    </div>

                    <div class="put-note">
                        Usa el código real de la tarima o caja del inventario.
                    </div>

                    <div id="inventoryResult"
                         class="slotting-result">
                        Escanea una tarima o caja para iniciar.
                    </div>
                </article>

                <article id="stepDestination"
                         class="put-card step-2 disabled">

                    <div class="put-card-label">2 · Escanea ubicación destino</div>

                    <h2>Ve a la ubicación sugerida</h2>
                    <p>
                        La ubicación debe estar libre, corresponder a la zona calculada y respetar el bloque recomendado del SKU.
                    </p>

                    <div class="put-scan-row">
                        <input id="scanDestination"
                               placeholder="Escanea ubicación destino"
                               autocomplete="off"
                               disabled />

                        <button id="btnValidateDestination"
                                type="button"
                                disabled>
                            VALIDAR
                        </button>
                    </div>

                    <div class="put-note">
                        Ubicación sugerida:
                        <span id="suggestedLocationText"
                              class="candidate">
                            Probar cuando exista recomendación.
                        </span>
                    </div>
                </article>

                <article id="stepConfirm"
                         class="put-card step-3 disabled">

                    <div class="put-card-label">3 · Confirma movimiento</div>

                    <h2>Confirma el destino</h2>
                    <p id="confirmHelp">
                        Primero valida una ubicación.
                    </p>

                    <button id="btnConfirmLocation"
                            class="put-confirm-btn confirm-location-btn"
                            type="button"
                            disabled>
                        ✓ CONFIRMAR UBICACIÓN
                    </button>
                </article>

            </div>

            <aside class="put-preview">

                <div class="put-preview-head">
                    <div>
                        <small>VISTA PREVIA 3D</small>
                        <h2>Dónde quedará físicamente</h2>
                    </div>

                    <button id="btnFocus3d"
                            class="put-focus preview-focus"
                            type="button">
                        ◎ ENFOCAR
                    </button>
                </div>

                <div id="putaway3d"
                     class="wms-rack3d"
                     data-location="R7-11D"
                     data-layout-known="@Model.TieneLayout3D.ToString().ToLowerInvariant()"
                     data-compact="false"
                     data-info-target="#putaway3dInfo">
                </div>

                <div id="putaway3dInfo"
                     class="wms-3d-info">
                </div>

                <div class="put-preview-legend preview-legend">
                    <span><i class="leg-target"></i>Destino</span>
                    <span><i class="leg-inventory"></i>Inventario</span>
                    <span><i class="leg-assigned"></i>Asignado</span>
                    <span><i class="leg-empty"></i>Vacío</span>
                </div>

                <div class="put-zone-badges zone-badges">
                    <span class="put-zone-badge zone-badge high">ALTA · FRENTE</span>
                    <span class="put-zone-badge zone-badge medium">MEDIA</span>
                    <span class="put-zone-badge zone-badge low">BAJA · FONDO</span>
                </div>

                <input id="previewLocation"
                       class="preview-location"
                       value="R7-11D"
                       readonly />

            </aside>

        </section>

    </main>

</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
<script src="~/js/surtido-wms-3d.js"
        asp-append-version="true"></script>
<script src="~/js/surtido-ubicacion-inteligente-erp.js"
        asp-append-version="true"></script>
