@model Plataforma_CG.ViewModels.SurtidoPedidoPepsVM
@{
    ViewData["Title"] = "Montacarguista · Pedido activo";
    Layout = "~/Views/Shared/_Layout2.cshtml";
}
<link rel="stylesheet" href="~/css/surtido-wms-v7.css" asp-append-version="true" />
<style>
:root{--op-vino:#77232d;--op-green:#18764b;--op-blue:#255c9c;--op-border:#d7e1e7;--op-muted:#617381;--op-ink:#1c2d3a}
html,body{max-width:100%;overflow-x:hidden}
body:has(.wms-v7) .layout-main-content,body:has(.wms-v7) .layout-container-fluid{min-width:0;max-width:100%;box-sizing:border-box}
body:has(.wms-v7) .layout-container-fluid{padding:0!important}
.wms-v7{background:#f1f5f8;color:var(--op-ink);padding:15px;box-sizing:border-box;min-width:0}
.wms-content{width:100%;max-width:1480px;margin:0 auto;min-width:0}
.wms-content *{box-sizing:border-box}
.wms-back{display:inline-flex;align-items:center;min-height:45px;padding:0 16px;margin-bottom:12px;border:1px solid var(--op-border);border-radius:12px;background:#fff;color:#344b60;text-decoration:none;font-size:14px;font-weight:800}
.wms-alert-ok,.wms-alert-bad{padding:13px 15px;border-radius:12px;margin:10px 0;font-size:15px;font-weight:700}
.wms-alert-ok{background:#e8f6ec;color:#145b37;border:1px solid #b4dfc4}
.wms-alert-bad{background:#fff0f0;color:#922e34;border:1px solid #edc5ca}
.wms-site-line{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 12px}
.wms-site-line span{padding:7px 12px;background:#fff;border:1px solid var(--op-border);border-radius:999px;font-size:13px;font-weight:800}
.op-workflow-guide{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;margin:0 0 14px}
.op-workflow-guide>div{display:flex;align-items:center;gap:12px;background:#fff;border:1px solid var(--op-border);border-radius:14px;padding:13px;min-width:0}
.op-workflow-guide b{display:grid;place-items:center;flex:none;background:#e9f0f6;color:#2b526f;width:42px;height:42px;border-radius:50%;font-size:18px}
.op-workflow-guide strong{display:block;font-size:16px;line-height:1.25}.op-workflow-guide small{display:block;color:var(--op-muted);font-size:12px;margin-top:3px}
.wms-order-hero{display:flex;justify-content:space-between;align-items:center;gap:15px;background:linear-gradient(115deg,#51171f,var(--op-vino));color:#fff;border-radius:20px;padding:22px;margin-bottom:12px;min-width:0}
.wms-overline{font-size:12px;font-weight:900;letter-spacing:.03em;text-transform:uppercase}
.wms-order-hero h1{font-size:clamp(24px,4vw,40px);line-height:1.1;margin:7px 0;font-weight:950;overflow-wrap:anywhere}
.wms-order-hero p{font-size:15px;margin:0;line-height:1.5;color:#f2dce0}
.wms-order-percent{min-width:140px;text-align:center;border-radius:14px;padding:13px;background:#ffffff20;color:#fff;border:1px solid #ffffff36}
.wms-order-percent strong{display:block;font-size:30px}.wms-order-percent span,.wms-order-percent small{display:block;font-size:12px;font-weight:750}
.wms-summary-row{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin-bottom:12px}
.wms-summary-row>div{background:#fff;border:1px solid var(--op-border);border-radius:14px;padding:13px;min-width:0}
.wms-summary-row span{display:block;color:var(--op-muted);font-size:12px;font-weight:800;text-transform:uppercase}.wms-summary-row strong{display:block;font-size:30px;margin-top:4px;font-weight:950}
.op-message{background:#f2f9ff;border:1px solid #bad4f0;border-left:6px solid var(--op-blue);padding:15px 17px;border-radius:14px;margin:13px 0;font-size:15px;line-height:1.5}
.op-message strong{font-size:17px;display:block;margin-bottom:4px}.op-message span{display:block;color:#5a6570;font-size:13px;margin-top:6px}
.wms-main-action-grid{display:grid;grid-template-columns:minmax(0,1.3fr) minmax(0,.7fr);align-items:start;gap:12px;margin-bottom:18px}
.wms-recommend{background:#f7fffa;border:3px solid #80caa2;border-radius:20px;overflow:hidden;min-width:0}
.wms-recommend-top{display:flex;gap:10px;align-items:center;background:#e1f5e9;padding:12px 15px;border-bottom:1px solid #b9dcc8}
.wms-rec-badge{background:var(--op-green);color:white;border-radius:999px;padding:7px 12px;font-size:12px;font-weight:950}.wms-algo{color:#286d4a;font-size:13px;font-weight:850}
.wms-recommend-main{display:flex;align-items:flex-start;justify-content:space-between;gap:18px;padding:19px;min-width:0}
.wms-recommend-main>div:first-child{min-width:0;flex:1}.wms-recommend-main small{color:#526b5a;font-size:13px;font-weight:800}
.wms-recommend-main>div:first-child>strong{display:block;color:#0e6038;font-size:clamp(23px,3vw,35px);line-height:1.12;margin:5px 0 10px;overflow-wrap:anywhere}
.wms-rec-detail-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px}
.wms-rec-detail-grid>div{background:#fff;border:1px solid #cde4d5;border-radius:10px;padding:10px;min-width:0}
.wms-rec-detail-grid span{display:block;color:var(--op-muted);font-size:12px}.wms-rec-detail-grid b{display:block;font-size:17px;overflow-wrap:anywhere;margin-top:4px}
.wms-route-metric{border:1px solid #a5d4b6;border-radius:12px;padding:11px;background:#fff;min-width:125px;text-align:center}
.wms-route-metric strong{display:block;color:#0a6035;font-size:16px}.wms-route-metric span{display:block;color:#496556;font-size:15px;margin-top:4px}
.wms-primary-large{display:flex;justify-content:center;align-items:center;text-align:center;min-height:64px;padding:13px;margin:0 18px 18px;background:var(--op-green);color:#fff!important;font-size:18px;font-weight:950;border:0;border-radius:13px;cursor:pointer;line-height:1.35}
.wms-primary-large:disabled{background:#6e777d;cursor:not-allowed}
.wms-3d-card{border:1px solid var(--op-border);border-radius:17px;background:#fff;min-width:0;overflow:hidden}
.wms-3d-head{padding:14px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px;background:#f6f9fb;border-bottom:1px solid var(--op-border)}
.wms-3d-head h2{font-size:19px;margin:4px 0}.wms-3d-head p{margin:0}.wms-3d-open{display:inline-flex;align-items:center;min-height:43px;padding:8px 12px;background:var(--op-blue);color:#fff!important;text-decoration:none;font-size:13px;font-weight:850;border-radius:10px}
.wms-rack3d{height:220px;min-height:180px;background:#f0f4f7}.wms-3d-info,.wms-3d-legend{padding:8px 12px;font-size:12px;color:var(--op-muted)}.wms-3d-legend{display:flex;gap:20px}
.wms-3d-empty-body{padding:25px;color:var(--op-muted);text-align:center}
.wms-section-head{display:flex;align-items:center;justify-content:space-between;gap:10px;border-left:6px solid var(--op-vino);background:#fff;border-radius:14px;border-top:1px solid var(--op-border);border-right:1px solid var(--op-border);border-bottom:1px solid var(--op-border);padding:13px 16px;margin:8px 0}
.wms-section-head h2{margin:3px 0;font-size:22px}.wms-pill{font-size:12px;color:#6b3540;font-weight:800}
.op-secondary-help{font-size:14px;color:#4b606f;margin:7px 3px 12px;line-height:1.5}
.wms-product-block{border:1px solid var(--op-border);border-radius:15px;background:#fff;margin-bottom:11px;overflow:hidden;min-width:0}
.wms-product-summary{display:flex;justify-content:space-between;align-items:center;gap:15px;padding:16px;cursor:pointer;list-style:none;min-width:0}.wms-product-summary::-webkit-details-marker{display:none}
.wms-product-summary:focus-visible{outline:3px solid #2d6aa8;outline-offset:-3px}
.wms-product-title{min-width:0}.wms-product-title .wms-overline{color:var(--op-vino)}.wms-product-title h3{margin:5px 0;font-size:20px;overflow-wrap:anywhere}.wms-product-title small{font-size:13px;color:var(--op-muted)}
.wms-product-summary-right,.wms-product-open-info,.wms-counts{display:flex;align-items:center;gap:9px;flex-wrap:wrap}
.wms-counts span,.wms-product-status{padding:7px 10px;border-radius:999px;font-size:12px;font-weight:850;background:#edf3f9;color:#284d76}
.wms-product-status.done{background:#e1f4e9;color:#18623d}.wms-product-status.warning{background:#fff0db;color:#8c5400}
.wms-product-toggle-text{color:var(--op-blue);font-weight:950;font-size:13px}.wms-product-chevron{font-size:13px;transition:transform .15s}details[open]>.wms-product-summary .wms-product-chevron{transform:rotate(180deg)}
.wms-product-body{padding:13px 15px;border-top:1px solid var(--op-border)}.wms-pallet-list{display:grid;gap:12px}
.wms-pallet-card{display:grid;grid-template-columns:48px minmax(0,1fr) minmax(150px,195px);align-items:stretch;gap:13px;padding:14px;border:1px solid #ccdced;border-left:6px solid var(--op-blue);border-radius:14px;background:#f7fbff;min-width:0}
.wms-pallet-card.is-next{background:#f3fff8;border-color:#a8d6ba;border-left-color:var(--op-green)}
.wms-pallet-rank{display:grid;place-items:center;width:46px;height:46px;border-radius:12px;background:var(--op-blue);color:#fff;font-size:15px;font-weight:950}.wms-pallet-card.is-next .wms-pallet-rank{background:var(--op-green)}
.wms-pallet-main{min-width:0}.wms-pallet-title-row{display:flex;align-items:start;justify-content:space-between;gap:10px;flex-wrap:wrap;margin:0 0 9px}
.wms-pallet-title-row small{display:block;color:var(--op-muted);font-size:11px;font-weight:800}.wms-pallet-title-row strong{display:block;font-size:21px;overflow-wrap:anywhere}.wms-pallet-recommended{display:inline-flex;border-radius:999px;background:#e0f3e7;color:#146c3e;padding:6px 10px;font-size:11px;font-weight:950}
.wms-pallet-metrics{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:7px}.wms-pallet-metrics>div{padding:9px;border:1px solid var(--op-border);border-radius:9px;background:#fff;min-width:0}
.wms-pallet-metrics span{display:block;font-size:11px;color:var(--op-muted)}.wms-pallet-metrics strong{display:block;margin-top:3px;font-size:14px;overflow-wrap:anywhere}
.wms-pallet-action{display:flex;align-items:stretch;min-width:0}.wms-pallet-action a{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;background:var(--op-blue);color:#fff!important;text-decoration:none;text-align:center;width:100%;min-height:66px;padding:13px;border-radius:12px}
.wms-pallet-card.is-next .wms-pallet-action a{background:var(--op-green)}.wms-pallet-action span{font-size:14px;font-weight:950}.wms-pallet-action small{font-size:12px;color:#ebf4ff}
@@media(max-width:1030px){.wms-main-action-grid{grid-template-columns:1fr}.wms-rack3d{height:200px}.wms-pallet-metrics{grid-template-columns:repeat(3,minmax(0,1fr))}}
@@media(max-width:700px){.wms-v7{padding:7px}.op-workflow-guide{grid-template-columns:1fr;gap:7px}.op-workflow-guide>div{padding:9px;min-height:52px}.op-workflow-guide b{width:34px;height:34px}.op-workflow-guide strong{font-size:14px}.wms-order-hero{padding:13px;align-items:start}.wms-order-percent{min-width:100px;padding:9px}.wms-order-percent strong{font-size:23px}.wms-order-hero p{font-size:12px}.wms-summary-row{grid-template-columns:repeat(2,minmax(0,1fr))}.wms-summary-row strong{font-size:23px}.wms-recommend-main{flex-direction:column;padding:13px}.wms-route-metric{width:100%;text-align:left}.wms-rec-detail-grid{grid-template-columns:1fr 1fr}.wms-rec-detail-grid b{font-size:14px}.wms-primary-large{margin:0 12px 12px;font-size:16px}.wms-product-summary{align-items:start;flex-direction:column;gap:9px}.wms-product-summary-right{width:100%;justify-content:space-between}.wms-pallet-card{grid-template-columns:40px minmax(0,1fr);padding:10px;gap:9px}.wms-pallet-rank{width:38px;height:38px}.wms-pallet-action{grid-column:1/-1}.wms-pallet-metrics{grid-template-columns:repeat(2,minmax(0,1fr))}.wms-pallet-title-row strong{font-size:17px}.wms-pallet-action span{font-size:15px}.wms-section-head h2{font-size:18px}}
@@media(max-width:380px){.wms-order-hero{flex-direction:column}.wms-order-percent{width:100%;text-align:left}.wms-rec-detail-grid{grid-template-columns:1fr}.wms-pallet-metrics{grid-template-columns:1fr 1fr}}
</style>
<div class="wms-v7">

    <main class="wms-content">

        <a class="wms-back"
           href="@Url.Action(
                                      "Picking",
                                      "Surtido",
                                      new
                                      {
                                          almacen = Model.Almacen.Codigo
                                      }
                                 )">
            ← Volver a mis pedidos
        </a>


        @if (TempData["Exito"] != null)
        {
            <div class="wms-alert-ok">
                @TempData["Exito"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="wms-alert-bad">
                @TempData["Error"]
            </div>
        }


        <div class="wms-site-line">
            <span>@Model.Almacen.Planta</span>
            <span>@Model.Almacen.Nombre</span>
            <span>@Model.Almacen.Clasificacion</span>
        </div>

        <div class="op-workflow-guide" aria-label="Pasos para surtir">
            <div><b>1</b><span><strong>Ve a la ubicación</strong><small>Usa la recomendación PEPS</small></span></div>
            <div><b>2</b><span><strong>Ubica la tarima</strong><small>Comprueba su código y producto</small></span></div>
            <div><b>3</b><span><strong>Confirma la bajada</strong><small>Se confirma en la siguiente pantalla</small></span></div>
        </div>


        <section class="wms-order-hero">

            <div>
                <span class="wms-overline">
                    PEDIDO
                </span>

                <h1>
                    @Model.Pedido.Pedido
                </h1>

                <p>
                    @Model.Pedido.Cliente
                    · Solicitud @Model.Pedido.SolicitudSurtidoId
                </p>
            </div>

            <div class="wms-order-percent">
                <strong>
                    @Model.AvancePorcentaje%
                </strong>
                <span>Avance de bajada</span>
                <small>@Model.CajasBajadas de @Model.CajasSolicitadas cajas bajadas</small>
            </div>

        </section>


        <section class="wms-summary-row">

            <div>
                <span>Cajas solicitadas</span>
                <strong>@Model.CajasSolicitadas</strong>
            </div>

            <div>
                <span>Ya bajadas</span>
                <strong>@Model.CajasBajadas</strong>
            </div>

            <div>
                <span>Ya surtidas</span>
                <strong>@Model.CajasSurtidas</strong>
            </div>

            <div>
                <span>Por bajar</span>
                <strong>@Model.CajasPendientes</strong>
            </div>

        </section>


        @if (!string.IsNullOrWhiteSpace(Model.Error))
        {
            <div class="wms-alert-bad">
                @Model.Error
            </div>
        }


        <div class="op-message" role="note">
            <strong>¿Qué debo hacer?</strong>
            La cantidad del pedido se cuenta en CAJAS. Empieza por la tarima recomendada. Comprueba la ubicación y el código físico.
            Después presiona <b>Ir a bajar esta tarima</b> y confirma el producto en la siguiente pantalla.
            <span>Una tarima puede contener varias cajas. El peso en kg es informativo. Este botón NO confirma automáticamente toda la tarima.</span>
        </div>

        @if (Model.Recomendada != null)
        {
            <div class="wms-main-action-grid">
                <article class="wms-recommend">

                    <div class="wms-recommend-top">

                        <div class="wms-rec-badge">
                            EMPIEZA POR AQUÍ
                        </div>

                        <div class="wms-algo">
                            PRIORIDAD PEPS
                        </div>

                    </div>

                    <div class="wms-recommend-main">

                        <div>
                            <small>Busca esta tarima primero</small>

                            <strong>
                                @(string.IsNullOrWhiteSpace(Model.Recomendada.TarimaCodigo)
                                    ? "SIN TARIMA"
                                    : Model.Recomendada.TarimaCodigo)
                            </strong>

                            <div class="wms-rec-detail-grid">
                                <div>
                                    <span>Ve a esta ubicación</span>
                                    <b>
                                        @(string.IsNullOrWhiteSpace(Model.Recomendada.UbicacionOrigen)
                                        ? "SIN UBICACIÓN"
                                        : Model.Recomendada.UbicacionOrigen)
                                    </b>
                                </div>
                                <div>
                                    <span>Producto</span>
                                    <b>@Model.Recomendada.ProductoNombre</b>
                                </div>
                                <div>
                                    <span>Lote</span>
                                    <b>@(string.IsNullOrWhiteSpace(Model.Recomendada.Lote) ? "-" : Model.Recomendada.Lote)</b>
                                </div>
                                <div>
                                    <span>Producción</span>
                                    <b>@(Model.Recomendada.FechaProduccion?.ToString("dd/MM/yyyy") ?? "-")</b>
                                </div>
                            </div>
                        </div>

                        <div class="wms-route-metric">
                            <strong>#@Model.Recomendada.OrdenPeps PEPS</strong>
                            <span>@Model.Recomendada.PesoNeto.ToString("N2") kg</span>
                        </div>

                    </div>

                    @if (Model.Recomendada.PuedeBajar)
                    {
                        <a class="wms-primary-large"
                           style="display:grid;place-items:center;text-decoration:none;"
                           href="@Url.Action(
                                                                                  "PickingTarea",
                                                                                  "Surtido",
                                                                                  new
                                                                                  {
                                                                                      almacen = Model.Almacen.Codigo,
                                                                                      solicitudSurtidoId = Model.Pedido.SolicitudSurtidoId,
                                                                                      produccionId = Model.Recomendada.ProduccionId
                                                                                  }
                                                                             )">
                            IR A BAJAR ESTA TARIMA →
                        </a>
                    }
                    else
                    {
                        <button class="wms-primary-large"
                                type="button"
                                disabled>
                            NO SE PUEDE BAJAR (PEPS)
                        </button>

                        <div class="wms-alert-bad">
                            @Model.Recomendada.MotivoBloqueo
                        </div>
                    }

                </article>

                @if (!string.IsNullOrWhiteSpace(Model.Recomendada.UbicacionOrigen))
                {
                    <section class="wms-3d-card">

                        <div class="wms-3d-head">

                            <div>
                                <span class="wms-overline">
                                    APOYO VISUAL · MAPA 3D
                                </span>

                                <h2>
                                    @Model.Recomendada.UbicacionOrigen
                                </h2>

                                <p>

                                </p>
                            </div>

                            <a class="wms-3d-open"
                               href="@Url.Action(
                                                                                              "Mapa3D",
                                                                                              "Surtido",
                                                                                              new
                                                                                              {
                                                                                                  almacen = Model.Almacen.Codigo,
                                                                                                  ubicacion = Model.Recomendada.UbicacionOrigen
                                                                                              }
                                                                                         )">
                                Abrir mapa de ubicación
                            </a>

                        </div>

                        <div id="pedidoMini3d"
                             class="wms-rack3d compact"
                             data-location="@Model.Recomendada.UbicacionOrigen"
                             data-layout-known="@Model.Almacen.TieneLayout3D.ToString().ToLowerInvariant()"
                             data-compact="true"
                             data-info-target="#pedidoMini3dInfo">
                        </div>

                        <div id="pedidoMini3dInfo"
                             class="wms-3d-info">
                        </div>

                        <div class="wms-3d-legend">
                            <span><i class="target"></i>Destino PEPS</span>
                            <span><i class="rack"></i>Rack</span>
                        </div>

                    </section>
                }
                else
                {
                    <section class="wms-3d-card">
                        <div class="wms-3d-head">
                            <div>
                                <span class="wms-overline">UBICACIÓN EN MAPA 3D</span>
                                <h2>Sin ubicación asignada</h2>
                                <p></p>
                            </div>
                        </div>
                        <div class="wms-3d-empty-body">
                            <div>
                                <strong>Sin ubicación</strong>

                            </div>
                        </div>
                    </section>
                }
            </div>
        }
        else if (Model.CajasPendientes > 0)
        {
            <div class="wms-alert-bad">
                Sin tarimas disponibles para bajar.
            </div>
        }


        <div class="wms-section-head">

            <div>
                <span class="wms-overline">
                    OTRAS TARIMAS DEL PEDIDO
                </span>

                <h2>
                    Revisa las tarimas por producto
                </h2>
            </div>

            <span class="wms-pill">
                @Model.NombreConexion
            </span>

        </div>


        <p class="op-secondary-help">Estas son las demás opciones agrupadas por producto. Abre un producto para consultar sus tarimas. Respeta el orden PEPS marcado por SIGO.</p>

        @foreach (var producto in Model.Productos)
        {
            // =========================================================
            // VISTA OPERATIVA POR TARIMA
            // Producto -> Tarima.
            //
            // IMPORTANTE:
            // Se agrupan TODAS las cajas disponibles de la tarima para
            // mostrar la cantidad física de cajas que contiene el grupo.
            // Sólo se muestran tarimas que contienen al menos una caja
            // recomendada por PEPS y disponible para bajar.
            //
            // El enlace conserva ProduccionId porque PickingTarea y el
            // POST ConfirmarBajada actuales trabajan a nivel de registro.
            // Para confirmar toda la tarima en una sola operación se debe
            // agregar soporte de backend por TarimaCodigo.
            // =========================================================

            var cajasDisponiblesProducto =
                producto.Cajas
                    .Where(c => c.PuedeBajar)
                    .OrderBy(c => c.OrdenPeps)
                    .ToList();

            var gruposTarima =
                cajasDisponiblesProducto
                    .GroupBy(c => new
                    {
                        Tarima = string.IsNullOrWhiteSpace(c.TarimaCodigo)
                            ? "SIN TARIMA"
                            : c.TarimaCodigo,
                        Ubicacion = string.IsNullOrWhiteSpace(c.UbicacionOrigen)
                            ? "SIN UBICACIÓN"
                            : c.UbicacionOrigen
                    })
                    .Where(g => g.Any(c => c.EsRecomendada && c.PuedeBajar))
                    .OrderBy(g => g.Min(c => c.OrdenPeps))
                    .ToList();

            var esProductoRecomendado =
                Model.Recomendada != null
                &&
                producto.Cajas.Any(c =>
                    c.ProduccionId == Model.Recomendada.ProduccionId
                );

            var primeraBloqueada =
                producto.Cajas
                    .Where(c => c.EsRecomendada)
                    .OrderBy(c => c.OrdenPeps)
                    .FirstOrDefault(c => !c.PuedeBajar);

            <details class="wms-product-block wms-product-accordion"
                     data-product-recommended="@(esProductoRecomendado ? "true" : "false")">

                <summary class="wms-product-head wms-product-summary">

                    <div class="wms-product-title">
                        <span class="wms-overline">
                            PRODUCTO · SKU @producto.Articulo
                        </span>

                        <h3>
                            @producto.ProductoNombre
                        </h3>

                        <small>
                            @producto.AlmacenNombre
                        </small>
                    </div>

                    <div class="wms-product-summary-right">

                        <div class="wms-counts">
                            <span class="pending">PENDIENTES <b>@producto.CajasPendientes</b></span>
                        </div>

                        <div class="wms-product-open-info">
                            @if (producto.CajasPendientes <= 0)
                            {
                                <span class="wms-product-status done">✓ LISTO</span>
                            }
                            else if (gruposTarima.Any())
                            {
                                <span class="wms-product-status pallet">
                                    🧱 @gruposTarima.Count tarima@(gruposTarima.Count == 1 ? "" : "s")
                                </span>
                            }
                            else
                            {
                                <span class="wms-product-status warning">
                                    SIN TARIMA
                                </span>
                            }

                            <span class="wms-product-toggle-text">
                                VER TARIMAS
                            </span>

                            <span class="wms-product-chevron" aria-hidden="true">▼</span>
                        </div>

                    </div>

                </summary>

                <div class="wms-product-body">

                    @if (producto.CajasPendientes <= 0)
                    {
                        <div class="wms-alert-ok">
                            Producto completo.
                        </div>
                    }
                    else if (!producto.Cajas.Any())
                    {
                        <div class="wms-alert-bad">
                            Sin existencias disponibles para @producto.Articulo.
                        </div>
                    }
                    else if (gruposTarima.Any())
                    {
                        <div class="wms-pallet-list">

                            @foreach (var grupoTarima in gruposTarima)
                            {
                                var cajasTarima =
                                    grupoTarima
                                        .OrderBy(c => c.OrdenPeps)
                                        .ToList();

                                var primeraRecomendadaTarima =
                                    cajasTarima
                                        .Where(c => c.EsRecomendada && c.PuedeBajar)
                                        .OrderBy(c => c.OrdenPeps)
                                        .FirstOrDefault()
                                    ?? cajasTarima.First();

                                var esTarimaPrincipal =
                                    Model.Recomendada != null
                                    &&
                                    cajasTarima.Any(c =>
                                        c.ProduccionId == Model.Recomendada.ProduccionId
                                    );

                                var totalCajasTarima = cajasTarima.Count;
                                var totalKilosTarima = cajasTarima.Sum(c => c.PesoNeto);

                                var fechasProduccion =
                                    cajasTarima
                                        .Where(c => c.FechaProduccion.HasValue)
                                        .Select(c => c.FechaProduccion.Value.Date)
                                        .Distinct()
                                        .OrderBy(x => x)
                                        .ToList();

                                var fechaProduccionTexto =
                                    fechasProduccion.Count == 0
                                        ? "-"
                                        : fechasProduccion.Count == 1
                                            ? fechasProduccion[0].ToString("dd/MM/yyyy")
                                            : fechasProduccion.First().ToString("dd/MM/yyyy")
                                              + " - "
                                              + fechasProduccion.Last().ToString("dd/MM/yyyy");

                                var lotesTarima =
                                    cajasTarima
                                        .Select(c => c.Lote)
                                        .Where(x => !string.IsNullOrWhiteSpace(x))
                                        .Distinct()
                                        .ToList();

                                var loteTexto =
                                    lotesTarima.Any()
                                        ? string.Join(", ", lotesTarima)
                                        : "-";

                                <article class="wms-pallet-card @(esTarimaPrincipal ? "is-next" : "")">

                                    <div class="wms-pallet-rank">
                                        @if (esTarimaPrincipal)
                                        {
                                            <span>★</span>
                                        }
                                        else
                                        {
                                            <span>#@primeraRecomendadaTarima.OrdenPeps</span>
                                        }
                                    </div>

                                    <div class="wms-pallet-main">

                                        <div class="wms-pallet-title-row">
                                            <div>
                                                <small>TARIMA</small>
                                                <strong>@grupoTarima.Key.Tarima</strong>
                                            </div>

                                            @if (esTarimaPrincipal)
                                            {
                                                <span class="wms-pallet-recommended">
                                                    ✓ BAJAR PRIMERO · PEPS
                                                </span>
                                            }
                                        </div>

                                        <div class="wms-pallet-metrics">
                                            <div>
                                                <span>Ir a ubicación</span>
                                                <strong>@grupoTarima.Key.Ubicacion</strong>
                                            </div>

                                            <div>
                                                <span>Cajas elegibles mostradas</span>
                                                <strong>@totalCajasTarima</strong>
                                            </div>

                                            <div>
                                                <span>Producción</span>
                                                <strong>@fechaProduccionTexto</strong>
                                            </div>

                                            <div>
                                                <span>Lote</span>
                                                <strong>@loteTexto</strong>
                                            </div>

                                            <div>
                                                <span>Peso</span>
                                                <strong>@totalKilosTarima.ToString("N2") kg</strong>
                                            </div>

                                            <div>
                                                <span>PEPS inicial</span>
                                                <strong>#@primeraRecomendadaTarima.OrdenPeps</strong>
                                            </div>
                                        </div>

                                    </div>

                                    <div class="wms-pallet-action">
                                        <a href="@Url.Action(
                                                                                                                                      "PickingTarea",
                                                                                                                                      "Surtido",
                                                                                                                                      new
                                                                                                                                      {
                                                                                                                                          almacen = Model.Almacen.Codigo,
                                                                                                                                          solicitudSurtidoId = Model.Pedido.SolicitudSurtidoId,
                                                                                                                                          produccionId = primeraRecomendadaTarima.ProduccionId,
                                                                                                                                          tarima = grupoTarima.Key.Tarima
                                                                                                                                      }
                                                                                                                                 )">
                                            <span>IR A BAJAR TARIMA</span>
                                            <small>@totalCajasTarima caja@(totalCajasTarima == 1 ? "" : "s")</small>
                                        </a>
                                    </div>

                                </article>
                            }

                        </div>
                    }
                    else if (primeraBloqueada != null)
                    {
                        <div class="wms-alert-bad">
                            PEPS pendiente: @primeraBloqueada.MotivoBloqueo
                        </div>
                    }
                    else
                    {
                        <div class="wms-alert-bad">
                            Sin tarimas disponibles.
                        </div>
                    }

                    @if (
                        producto.CajasPendientes > 0
                        &&
                        producto.CajasDisponibles < producto.CajasPendientes
                    )
                    {
                        <div class="wms-alert-bad wms-product-shortage">
                            Faltan cajas: @producto.CajasDisponibles disponibles de @producto.CajasPendientes pendientes.
                        </div>
                    }

                </div>

            </details>
        }


    </main>

</div>




<script>
    document.addEventListener("DOMContentLoaded", function () {
        const productos = Array.from(
            document.querySelectorAll(".wms-product-accordion")
        );

        productos.forEach(function (producto) {
            producto.addEventListener("toggle", function () {
                if (!producto.open) return;

                productos.forEach(function (otro) {
                    if (otro !== producto) {
                        otro.open = false;
                    }
                });
            });
        });

        const productoRecomendado =
            document.querySelector(
                '.wms-product-accordion[data-product-recommended="true"]'
            );

        if (productoRecomendado) {
            productoRecomendado.open = true;
        }
    });
</script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
<script src="~/js/surtido-wms-3d.js" asp-append-version="true"></script>
