<div class="wms-v7">

    <main class="wms-content">

        <a class="wms-back"
           href="@Url.Action(
                                      "Picking",
                                      "Surtido",
                                      new
                                      {
                                          almacen = Model.Almacen.Codigo
                                      }
                                 )">
            ← REGRESAR A MIS PEDIDOS
        </a>


        @if (TempData["Exito"] != null)
        {
            <div class="wms-alert-ok">
                @TempData["Exito"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="wms-alert-bad">
                @TempData["Error"]
            </div>
        }


        <div class="wms-site-line">
            <span>@Model.Almacen.Planta</span>
            <span>@Model.Almacen.Nombre</span>
            <span>@Model.Almacen.Clasificacion</span>
        </div>

        <div class="op-workflow-guide" aria-label="Flujo de trabajo">
            <div class="is-active"><b>1</b><span><strong>PRODUCTO</strong></span></div>
            <div><b>2</b><span><strong>TARIMA</strong></span></div>
            <div><b>3</b><span><strong>CONFIRMAR</strong></span></div>
        </div>


        <section class="wms-order-hero">

            <div>
                <span class="wms-overline">
                    PEDIDO
                </span>

                <h1>
                    @Model.Pedido.Pedido
                </h1>

                <p>
                    @Model.Pedido.Cliente
                    · Solicitud @Model.Pedido.SolicitudSurtidoId
                </p>
            </div>

            <div class="wms-order-percent">
                <strong>
                    @Model.AvancePorcentaje%
                </strong>
                <span>Picking</span>
                <small>@Model.CajasSurtidas de @Model.CajasSolicitadas surtidas</small>
            </div>

        </section>


        <section class="wms-summary-row">

            <div>
                <span>Solicitadas</span>
                <strong>@Model.CajasSolicitadas</strong>
            </div>

            <div>
                <span>Bajadas</span>
                <strong>@Model.CajasBajadas</strong>
            </div>

            <div>
                <span>Surtidas</span>
                <strong>@Model.CajasSurtidas</strong>
            </div>

            <div>
                <span>Pendientes</span>
                <strong>@Model.CajasPendientes</strong>
            </div>

        </section>


        @if (!string.IsNullOrWhiteSpace(Model.Error))
        {
            <div class="wms-alert-bad">
                @Model.Error
            </div>
        }


        @if (Model.Recomendada != null)
        {
            <div class="wms-main-action-grid">
                <article class="wms-recommend">

                    <div class="wms-recommend-top">

                        <div class="wms-rec-badge">
                            SIGUIENTE
                        </div>

                        <div class="wms-algo">
                            TARIMA PEPS
                        </div>

                    </div>

                    <div class="wms-recommend-main">

                        <div>
                            <small>TARIMA</small>

                            <strong>
                                @(string.IsNullOrWhiteSpace(Model.Recomendada.TarimaCodigo)
                                    ? "SIN TARIMA"
                                    : Model.Recomendada.TarimaCodigo)
                            </strong>

                            <div class="wms-rec-detail-grid">
                                <div>
                                    <span>Ubicación</span>
                                    <b>
                                        @(string.IsNullOrWhiteSpace(Model.Recomendada.UbicacionOrigen)
                                        ? "SIN UBICACIÓN"
                                        : Model.Recomendada.UbicacionOrigen)
                                    </b>
                                </div>
                                <div>
                                    <span>Producto</span>
                                    <b>@Model.Recomendada.ProductoNombre</b>
                                </div>
                                <div>
                                    <span>Lote</span>
                                    <b>@(string.IsNullOrWhiteSpace(Model.Recomendada.Lote) ? "-" : Model.Recomendada.Lote)</b>
                                </div>
                                <div>
                                    <span>Producción</span>
                                    <b>@(Model.Recomendada.FechaProduccion?.ToString("dd/MM/yyyy") ?? "-")</b>
                                </div>
                            </div>
                        </div>

                        <div class="wms-route-metric">
                            <strong>#@Model.Recomendada.OrdenPeps PEPS</strong>
                            <span>@Model.Recomendada.PesoNeto.ToString("N2") kg</span>
                        </div>

                    </div>

                    @if (Model.Recomendada.PuedeBajar)
                    {
                        <a class="wms-primary-large"
                           style="display:grid;place-items:center;text-decoration:none;"
                           href="@Url.Action(
                                                                                  "PickingTarea",
                                                                                  "Surtido",
                                                                                  new
                                                                                  {
                                                                                      almacen = Model.Almacen.Codigo,
                                                                                      solicitudSurtidoId = Model.Pedido.SolicitudSurtidoId,
                                                                                      produccionId = Model.Recomendada.ProduccionId
                                                                                  }
                                                                             )">
                            ABRIR TARIMA →
                        </a>
                    }
                    else
                    {
                        <button class="wms-primary-large"
                                type="button"
                                disabled>
                            PEPS BLOQUEADO
                        </button>

                        <div class="wms-alert-bad">
                            @Model.Recomendada.MotivoBloqueo
                        </div>
                    }

                </article>

                @if (!string.IsNullOrWhiteSpace(Model.Recomendada.UbicacionOrigen))
                {
                    <section class="wms-3d-card">

                        <div class="wms-3d-head">

                            <div>
                                <span class="wms-overline">
                                    UBICACIÓN 3D
                                </span>

                                <h2>
                                    @Model.Recomendada.UbicacionOrigen
                                </h2>

                                <p>

                                </p>
                            </div>

                            <a class="wms-3d-open"
                               href="@Url.Action(
                                                                                              "Mapa3D",
                                                                                              "Surtido",
                                                                                              new
                                                                                              {
                                                                                                  almacen = Model.Almacen.Codigo,
                                                                                                  ubicacion = Model.Recomendada.UbicacionOrigen
                                                                                              }
                                                                                         )">
                                VER UBICACIÓN EN MAPA 3D
                            </a>

                        </div>

                        <div id="pedidoMini3d"
                             class="wms-rack3d compact"
                             data-location="@Model.Recomendada.UbicacionOrigen"
                             data-layout-known="@Model.Almacen.TieneLayout3D.ToString().ToLowerInvariant()"
                             data-compact="true"
                             data-info-target="#pedidoMini3dInfo">
                        </div>

                        <div id="pedidoMini3dInfo"
                             class="wms-3d-info">
                        </div>

                        <div class="wms-3d-legend">
                            <span><i class="target"></i>Destino PEPS</span>
                            <span><i class="rack"></i>Rack</span>
                        </div>

                    </section>
                }
                else
                {
                    <section class="wms-3d-card">
                        <div class="wms-3d-head">
                            <div>
                                <span class="wms-overline">UBICACIÓN EN MAPA 3D</span>
                                <h2>Sin ubicación asignada</h2>
                                <p></p>
                            </div>
                        </div>
                        <div class="wms-3d-empty-body">
                            <div>
                                <strong>Sin ubicación</strong>

                            </div>
                        </div>
                    </section>
                }
            </div>
        }
        else if (Model.CajasPendientes > 0)
        {
            <div class="wms-alert-bad">
                Sin tarimas disponibles para bajar.
            </div>
        }


        <div class="wms-section-head">

            <div>
                <span class="wms-overline">
                    PRODUCTOS PENDIENTES
                </span>

                <h2>
                    Productos por surtir
                </h2>
            </div>

            <span class="wms-pill">
                @Model.NombreConexion
            </span>

        </div>


        @foreach (var producto in Model.Productos)
        {
            // =========================================================
            // VISTA OPERATIVA POR TARIMA
            // Producto -> Tarima.
            //
            // IMPORTANTE:
            // Se agrupan TODAS las cajas disponibles de la tarima para
            // mostrar la cantidad física de cajas que contiene el grupo.
            // Sólo se muestran tarimas que contienen al menos una caja
            // recomendada por PEPS y disponible para bajar.
            //
            // El enlace conserva ProduccionId porque PickingTarea y el
            // POST ConfirmarBajada actuales trabajan a nivel de registro.
            // Para confirmar toda la tarima en una sola operación se debe
            // agregar soporte de backend por TarimaCodigo.
            // =========================================================

            var cajasDisponiblesProducto =
                producto.Cajas
                    .Where(c => c.PuedeBajar)
                    .OrderBy(c => c.OrdenPeps)
                    .ToList();

            var gruposTarima =
                cajasDisponiblesProducto
                    .GroupBy(c => new
                    {
                        Tarima = string.IsNullOrWhiteSpace(c.TarimaCodigo)
                            ? "SIN TARIMA"
                            : c.TarimaCodigo,
                        Ubicacion = string.IsNullOrWhiteSpace(c.UbicacionOrigen)
                            ? "SIN UBICACIÓN"
                            : c.UbicacionOrigen
                    })
                    .Where(g => g.Any(c => c.EsRecomendada && c.PuedeBajar))
                    .OrderBy(g => g.Min(c => c.OrdenPeps))
                    .ToList();

            var esProductoRecomendado =
                Model.Recomendada != null
                &&
                producto.Cajas.Any(c =>
                    c.ProduccionId == Model.Recomendada.ProduccionId
                );

            var primeraBloqueada =
                producto.Cajas
                    .Where(c => c.EsRecomendada)
                    .OrderBy(c => c.OrdenPeps)
                    .FirstOrDefault(c => !c.PuedeBajar);

            <details class="wms-product-block wms-product-accordion"
                     data-product-recommended="@(esProductoRecomendado ? "true" : "false")">

                <summary class="wms-product-head wms-product-summary">

                    <div class="wms-product-title">
                        <span class="wms-overline">
                            @producto.Articulo
                        </span>

                        <h3>
                            @producto.ProductoNombre
                        </h3>

                        <small>
                            @producto.AlmacenNombre
                        </small>
                    </div>

                    <div class="wms-product-summary-right">

                        <div class="wms-counts">
                            <span class="pending">PENDIENTES <b>@producto.CajasPendientes</b></span>
                        </div>

                        <div class="wms-product-open-info">
                            @if (producto.CajasPendientes <= 0)
                            {
                                <span class="wms-product-status done">✓ LISTO</span>
                            }
                            else if (gruposTarima.Any())
                            {
                                <span class="wms-product-status pallet">
                                    🧱 @gruposTarima.Count tarima@(gruposTarima.Count == 1 ? "" : "s")
                                </span>
                            }
                            else
                            {
                                <span class="wms-product-status warning">
                                    SIN TARIMA
                                </span>
                            }

                            <span class="wms-product-toggle-text">
                                ABRIR
                            </span>

                            <span class="wms-product-chevron" aria-hidden="true">▼</span>
                        </div>

                    </div>

                </summary>

                <div class="wms-product-body">

                    @if (producto.CajasPendientes <= 0)
                    {
                        <div class="wms-alert-ok">
                            Producto completo.
                        </div>
                    }
                    else if (!producto.Cajas.Any())
                    {
                        <div class="wms-alert-bad">
                            Sin existencias disponibles para @producto.Articulo.
                        </div>
                    }
                    else if (gruposTarima.Any())
                    {
                        <div class="wms-pallet-list">

                            @foreach (var grupoTarima in gruposTarima)
                            {
                                var cajasTarima =
                                    grupoTarima
                                        .OrderBy(c => c.OrdenPeps)
                                        .ToList();

                                var primeraRecomendadaTarima =
                                    cajasTarima
                                        .Where(c => c.EsRecomendada && c.PuedeBajar)
                                        .OrderBy(c => c.OrdenPeps)
                                        .FirstOrDefault()
                                    ?? cajasTarima.First();

                                var esTarimaPrincipal =
                                    Model.Recomendada != null
                                    &&
                                    cajasTarima.Any(c =>
                                        c.ProduccionId == Model.Recomendada.ProduccionId
                                    );

                                var totalCajasTarima = cajasTarima.Count;
                                var totalKilosTarima = cajasTarima.Sum(c => c.PesoNeto);

                                var fechasProduccion =
                                    cajasTarima
                                        .Where(c => c.FechaProduccion.HasValue)
                                        .Select(c => c.FechaProduccion.Value.Date)
                                        .Distinct()
                                        .OrderBy(x => x)
                                        .ToList();

                                var fechaProduccionTexto =
                                    fechasProduccion.Count == 0
                                        ? "-"
                                        : fechasProduccion.Count == 1
                                            ? fechasProduccion[0].ToString("dd/MM/yyyy")
                                            : fechasProduccion.First().ToString("dd/MM/yyyy")
                                              + " - "
                                              + fechasProduccion.Last().ToString("dd/MM/yyyy");

                                var lotesTarima =
                                    cajasTarima
                                        .Select(c => c.Lote)
                                        .Where(x => !string.IsNullOrWhiteSpace(x))
                                        .Distinct()
                                        .ToList();

                                var loteTexto =
                                    lotesTarima.Any()
                                        ? string.Join(", ", lotesTarima)
                                        : "-";

                                <article class="wms-pallet-card @(esTarimaPrincipal ? "is-next" : "")">

                                    <div class="wms-pallet-rank">
                                        @if (esTarimaPrincipal)
                                        {
                                            <span>★</span>
                                        }
                                        else
                                        {
                                            <span>#@primeraRecomendadaTarima.OrdenPeps</span>
                                        }
                                    </div>

                                    <div class="wms-pallet-main">

                                        <div class="wms-pallet-title-row">
                                            <div>
                                                <small>TARIMA</small>
                                                <strong>@grupoTarima.Key.Tarima</strong>
                                            </div>

                                            @if (esTarimaPrincipal)
                                            {
                                                <span class="wms-pallet-recommended">
                                                    ★ RECOMENDADA PEPS
                                                </span>
                                            }
                                        </div>

                                        <div class="wms-pallet-metrics">
                                            <div>
                                                <span>Ubicación</span>
                                                <strong>@grupoTarima.Key.Ubicacion</strong>
                                            </div>

                                            <div>
                                                <span>Cajas en tarima</span>
                                                <strong>@totalCajasTarima</strong>
                                            </div>

                                            <div>
                                                <span>Producción</span>
                                                <strong>@fechaProduccionTexto</strong>
                                            </div>

                                            <div>
                                                <span>Lote</span>
                                                <strong>@loteTexto</strong>
                                            </div>

                                            <div>
                                                <span>Peso</span>
                                                <strong>@totalKilosTarima.ToString("N2") kg</strong>
                                            </div>

                                            <div>
                                                <span>PEPS inicial</span>
                                                <strong>#@primeraRecomendadaTarima.OrdenPeps</strong>
                                            </div>
                                        </div>

                                    </div>

                                    <div class="wms-pallet-action">
                                        <a href="@Url.Action(
                                                                                                                                      "PickingTarea",
                                                                                                                                      "Surtido",
                                                                                                                                      new
                                                                                                                                      {
                                                                                                                                          almacen = Model.Almacen.Codigo,
                                                                                                                                          solicitudSurtidoId = Model.Pedido.SolicitudSurtidoId,
                                                                                                                                          produccionId = primeraRecomendadaTarima.ProduccionId,
                                                                                                                                          tarima = grupoTarima.Key.Tarima
                                                                                                                                      }
                                                                                                                                 )">
                                            <span>ABRIR TARIMA</span>
                                            <small>@totalCajasTarima caja@(totalCajasTarima == 1 ? "" : "s")</small>
                                        </a>
                                    </div>

                                </article>
                            }

                        </div>
                    }
                    else if (primeraBloqueada != null)
                    {
                        <div class="wms-alert-bad">
                            PEPS pendiente: @primeraBloqueada.MotivoBloqueo
                        </div>
                    }
                    else
                    {
                        <div class="wms-alert-bad">
                            Sin tarimas disponibles.
                        </div>
                    }

                    @if (
                        producto.CajasPendientes > 0
                        &&
                        producto.CajasDisponibles < producto.CajasPendientes
                    )
                    {
                        <div class="wms-alert-bad wms-product-shortage">
                            Faltan cajas: @producto.CajasDisponibles disponibles de @producto.CajasPendientes pendientes.
                        </div>
                    }

                </div>

            </details>
        }


    </main>

</div>




<script>
    document.addEventListener("DOMContentLoaded", function () {
        const productos = Array.from(
            document.querySelectorAll(".wms-product-accordion")
        );

        productos.forEach(function (producto) {
            producto.addEventListener("toggle", function () {
                if (!producto.open) return;

                productos.forEach(function (otro) {
                    if (otro !== producto) {
                        otro.open = false;
                    }
                });
            });
        });

        const productoRecomendado =
            document.querySelector(
                '.wms-product-accordion[data-product-recommended="true"]'
            );

        if (productoRecomendado) {
            productoRecomendado.open = true;
        }
    });
</script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
<script src="~/js/surtido-wms-3d.js" asp-append-version="true"></script>
