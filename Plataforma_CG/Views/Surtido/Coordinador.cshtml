@model Plataforma_CG.ViewModels.SurtidoModuloPedidosVM

@{
    ViewData["Title"] = "Coordinación";
    Layout = "~/Views/Shared/_Layout2.cshtml";
}

<style>
    body { background:#f4f7fb; }

    .coord-wrap {
        max-width:1240px;
        margin:0 auto;
        padding:14px 12px 32px;
    }

    .coord-head {
        background:linear-gradient(135deg,#151027,#392866);
        color:#fff;
        border-radius:18px;
        padding:17px;
    }

    .coord-row {
        display:flex;
        justify-content:space-between;
        align-items:center;
        gap:12px;
        flex-wrap:wrap;
    }

    .coord-title {
        font-size:1.45rem;
        font-weight:950;
    }

    .coord-sub {
        opacity:.78;
        font-size:.75rem;
        margin-top:4px;
    }

    .coord-actions {
        display:flex;
        gap:7px;
        flex-wrap:wrap;
    }

    .coord-back {
        color:#fff!important;
        text-decoration:none!important;
        border:1px solid rgba(255,255,255,.22);
        border-radius:999px;
        padding:8px 12px;
        background:rgba(255,255,255,.08);
        font-size:.72rem;
        font-weight:900;
    }

    .coord-panel,
    .stat,
    .coord-table-wrap,
    .coord-error {
        background:#fff;
        border:1px solid #dbe4ee;
        border-radius:14px;
    }

    .coord-panel {
        margin-top:11px;
        padding:12px;
    }

    .coord-filter {
        display:flex;
        gap:8px;
        flex-wrap:wrap;
        align-items:end;
    }

    .coord-filter label {
        display:block;
        font-size:.66rem;
        color:#6f8194;
        font-weight:900;
        margin-bottom:3px;
    }

    .coord-filter input {
        min-height:36px;
        border:1px solid #d4dde7;
        border-radius:9px;
        padding:6px 9px;
    }

    .coord-btn {
        min-height:36px;
        border:0;
        border-radius:9px;
        padding:6px 13px;
        background:#6f42c1;
        color:#fff;
        font-weight:900;
        font-size:.72rem;
    }

    .coord-stats {
        display:grid;
        grid-template-columns:repeat(auto-fit,minmax(160px,1fr));
        gap:8px;
        margin-top:10px;
    }

    .stat { padding:11px; }

    .stat small {
        color:#708196;
        font-size:.64rem;
        font-weight:900;
    }

    .stat strong {
        display:block;
        color:#152235;
        font-size:.95rem;
        margin-top:3px;
    }

    .coord-error {
        margin-top:10px;
        padding:14px;
        background:#fff3f3;
        border-color:#efb9b9;
        color:#9f1d1d;
        font-size:.78rem;
    }

    .coord-table-wrap {
        margin-top:10px;
        overflow:auto;
    }

    .coord-table {
        width:100%;
        border-collapse:collapse;
        min-width:820px;
    }

    .coord-table th {
        background:#f5f7fb;
        color:#526579;
        font-size:.66rem;
        font-weight:950;
        text-transform:uppercase;
        padding:9px;
        border-bottom:1px solid #dbe4ee;
        text-align:left;
    }

    .coord-table td {
        padding:10px 9px;
        border-bottom:1px solid #edf1f5;
        color:#243449;
        font-size:.76rem;
    }

    .pedido {
        font-weight:950;
        color:#6f42c1;
    }

    .badge-pend {
        display:inline-flex;
        padding:4px 7px;
        border-radius:999px;
        background:#fff2df;
        color:#b86500;
        font-size:.62rem;
        font-weight:950;
    }

    .btn-detalle {
        display:inline-flex;
        text-decoration:none!important;
        padding:6px 9px;
        border-radius:999px;
        background:#eee8ff;
        color:#6f42c1!important;
        font-size:.64rem;
        font-weight:950;
        white-space:nowrap;
    }

    @@media(max-width:800px) {
        .coord-stats { grid-template-columns:1fr 1fr; }
    }

    body[data-theme="dark"] .coord-panel,
    body[data-theme="dark"] .stat,
    body[data-theme="dark"] .coord-table-wrap {
        background:#111827!important;
        border-color:rgba(255,255,255,.12)!important;
    }

    body[data-theme="dark"] .coord-table th {
        background:#172033!important;
        color:#f8fafc!important;
    }

    body[data-theme="dark"] .coord-table td {
        color:#e5e7eb!important;
        border-color:rgba(255,255,255,.09)!important;
    }

    body[data-theme="dark"] .stat strong {
        color:#f8fafc!important;
    }
</style>


<div class="coord-wrap">

    <section class="coord-head">
        <div class="coord-row">

            <div>
                <div class="coord-title">
                    ◎ Coordinación de Surtido
                </div>

                <div class="coord-sub">
                    @Model.Almacen.Nombre
                    · @Model.Almacen.Sucursal
                    · @Model.Almacen.Codigo
                </div>
            </div>

            <div class="coord-actions">

                <a class="coord-back"
                   href="@Url.Action(
                        "ConfiguracionAlmacenes",
                        "Surtido"
                   )">
                    ⚙ Configurar almacenes
                </a>

                <a class="coord-back"
                   href="@Url.Action(
                        "Mapa3D",
                        "Surtido",
                        new
                        {
                            almacen = Model.Almacen.Codigo
                        }
                   )">
                    ▦ Mapa 3D
                </a>

                <a class="coord-back"
                   href="@Url.Action(
                        "Surtido_cedis",
                        "Surtido",
                        new { almacen = Model.Almacen.Codigo }
                   )">
                    ← Volver
                </a>

            </div>

        </div>
    </section>


    <section class="coord-panel">

        <form class="coord-filter"
              method="get"
              action="@Url.Action("Coordinador","Surtido")">

            <input type="hidden"
                   name="almacen"
                   value="@Model.Almacen.Codigo" />

            <div>
                <label>DESDE</label>
                <input type="date"
                       name="fechaInicio"
                       value="@Model.FechaInicio.ToString("yyyy-MM-dd")" />
            </div>

            <div>
                <label>HASTA</label>
                <input type="date"
                       name="fechaFin"
                       value="@Model.FechaFin.ToString("yyyy-MM-dd")" />
            </div>

            <button class="coord-btn"
                    type="submit">
                Consultar
            </button>

        </form>

    </section>


    <section class="coord-stats">

        <div class="stat">
            <small>PENDIENTES</small>
            <strong>@Model.TotalPedidos</strong>
        </div>

        <div class="stat">
            <small>SUCURSAL</small>
            <strong>@Model.Almacen.Sucursal</strong>
        </div>

        <div class="stat">
            <small>ALMACÉN</small>
            <strong>@Model.Almacen.Codigo</strong>
        </div>

        <div class="stat">
            <small>CONEXIÓN</small>
            <strong>@(string.IsNullOrWhiteSpace(Model.NombreConexion) ? "-" : Model.NombreConexion)</strong>
        </div>

        <div class="stat">
            <small>REGLA DE UBICACIÓN</small>
            <strong>
                @if (!Model.Almacen.TieneConfiguracionUbicacion)
                {
                    <text>SIN CONFIGURAR</text>
                }
                else if (Model.Almacen.ObligaUbicacion)
                {
                    <text>OBLIGATORIA</text>
                }
                else
                {
                    <text>OPCIONAL</text>
                }
            </strong>
        </div>

    </section>


    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="coord-error">
            <strong>No se pudieron cargar los pedidos.</strong><br />
            @Model.Error
            <br /><br />
            Prueba:
            <code>/Surtido/TestConexion?almacen=@Model.Almacen.Codigo</code>
        </div>
    }
    else
    {
        <section class="coord-table-wrap">

            <table class="coord-table">

                <thead>
                    <tr>
                        <th>Solicitud</th>
                        <th>Pedido</th>
                        <th>Cliente</th>
                        <th>Fecha / Hora</th>
                        <th>Estado</th>
                        <th>Sucursal</th>
                        <th>Acción</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model.Pedidos.Any())
                    {
                        @foreach (var p in Model.Pedidos)
                        {
                            <tr>

                                <td>
                                    @p.SolicitudSurtidoId
                                </td>

                                <td class="pedido">
                                    @p.Pedido
                                </td>

                                <td>
                                    @p.Cliente
                                </td>

                                <td>
                                    @p.FechaHora.ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td>
                                    <span class="badge-pend">
                                        PENDIENTE
                                    </span>
                                </td>

                                <td>
                                    @Model.Almacen.Sucursal
                                </td>

                                <td>
                                    <a class="btn-detalle"
                                       href="@Url.Action(
                                            "PedidoDetalle",
                                            "Surtido",
                                            new
                                            {
                                                almacen = Model.Almacen.Codigo,
                                                solicitudSurtidoId = p.SolicitudSurtidoId
                                            }
                                       )">
                                        Ver productos →
                                    </a>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7"
                                style="text-align:center;padding:24px;">
                                No hay pedidos pendientes
                                para el rango seleccionado.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </section>
    }

</div>
