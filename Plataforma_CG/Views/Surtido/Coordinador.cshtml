@model Plataforma_CG.ViewModels.SurtidoModuloPedidosVM

@{
    ViewData["Title"] = "Coordinación";
    Layout = "~/Views/Shared/_Layout2.cshtml";

    var prioridadesPedido =
        ViewBag.PrioridadesPedido as IDictionary<string, int>
        ?? new Dictionary<string, int>(StringComparer.OrdinalIgnoreCase);

    var plantaActiva =
        ViewBag.PlantaActiva as string
        ?? Model.Almacen.Planta;

    var pedidosOrdenados =
        Model.Pedidos
            .OrderBy(x => x.AlmacenNombre)
            .ThenBy(x =>
            {
                var clave =
                    $"{(x.AlmacenCodigo ?? "").Trim().ToUpperInvariant()}|{x.SolicitudSurtidoId}";

                return prioridadesPedido.TryGetValue(
                    clave,
                    out var prioridad
                )
                    ? prioridad
                    : int.MaxValue;
            })
            .ThenBy(x => x.FechaHora)
            .ThenBy(x => x.SolicitudSurtidoId)
            .ToList();
}

<link rel="stylesheet"
      href="~/css/surtido-coordinacion-erp.css"
      asp-append-version="true" />

<style>
    :root {
        --co-bg: #f3f5f7;
        --co-card: #ffffff;
        --co-line: #d8e0e6;
        --co-text: #1f2b37;
        --co-muted: #667788;
        --co-burgundy: #7a2029;
        --co-burgundy-dark: #55151c;
        --co-blue: #0d6efd;
        --co-green: #198754;
        --co-orange: #d98200;
        --co-purple: #6f42c1;
        --co-red: #b4232f;
        --co-shadow: 0 10px 30px rgba(22, 35, 48, .08);
    }

    html, body {
        width: 100% !important;
        max-width: 100% !important;
        overflow-x: hidden !important;
    }

    body {
        background: var(--co-bg) !important;
        color: var(--co-text);
        font-family: "Segoe UI", Tahoma, Arial, sans-serif;
    }

    body:has(.coord-op-wrap) .layout-main-content,
    body:has(.coord-op-wrap) .layout-container-fluid {
        width: 100% !important;
        max-width: 100% !important;
        min-width: 0 !important;
        box-sizing: border-box !important;
    }

    .coord-op-wrap {
        width: 100%;
        max-width: 100%;
        padding: 14px;
        box-sizing: border-box;
    }

    .coord-op-shell {
        width: 100%;
        max-width: 1680px;
        margin: 0 auto;
    }

    .coord-op-hero {
        background: linear-gradient(135deg, var(--co-burgundy-dark), var(--co-burgundy));
        color: #fff;
        border-radius: 22px;
        padding: 22px;
        box-shadow: var(--co-shadow);
        border: 1px solid #451118;
    }

    .coord-op-hero-grid {
        display: grid;
        grid-template-columns: 1.25fr .75fr;
        gap: 18px;
        align-items: center;
    }

    .coord-op-kicker {
        font-size: 13px;
        font-weight: 900;
        letter-spacing: .08em;
        text-transform: uppercase;
        opacity: .82;
    }

    .coord-op-title {
        margin-top: 7px;
        font-size: 34px;
        font-weight: 900;
        line-height: 1.05;
    }

    .coord-op-sub {
        margin-top: 6px;
        font-size: 16px;
        opacity: .95;
    }

    .coord-op-actions {
        display: grid;
        grid-template-columns: repeat(3, minmax(0,1fr));
        gap: 10px;
    }

    .coord-op-action {
        text-decoration: none !important;
        color: #fff !important;
        border: 1px solid rgba(255,255,255,.22);
        background: rgba(255,255,255,.11);
        border-radius: 16px;
        padding: 14px 12px;
        min-height: 82px;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        gap: 6px;
        text-align: center;
        font-size: 14px;
        font-weight: 900;
        transition: .15s ease;
    }

    .coord-op-action:hover {
        background: rgba(255,255,255,.18);
        transform: translateY(-1px);
    }

    .coord-op-action .ico {
        font-size: 23px;
        line-height: 1;
    }

    .coord-op-panel {
        margin-top: 16px;
        background: var(--co-card);
        border: 1px solid var(--co-line);
        border-radius: 22px;
        box-shadow: var(--co-shadow);
        overflow: hidden;
    }

    .coord-op-panel-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
        padding: 16px 18px;
        background: linear-gradient(180deg, #ffffff, #f5f7f9);
        border-bottom: 1px solid var(--co-line);
    }

    .coord-op-panel-head h2 {
        margin: 0;
        font-size: 23px;
        font-weight: 900;
    }

    .coord-op-panel-head p {
        margin: 4px 0 0;
        font-size: 14px;
        color: var(--co-muted);
    }

    .coord-op-filter {
        padding: 16px 18px;
        display: grid;
        grid-template-columns: 1fr 1fr auto;
        gap: 12px;
        align-items: end;
    }

    .coord-op-filter label {
        display: block;
        margin-bottom: 5px;
        font-size: 12px;
        font-weight: 900;
        color: var(--co-muted);
        letter-spacing: .04em;
    }

    .coord-op-filter input {
        width: 100%;
        min-height: 48px;
        border: 1px solid #bfcbd4;
        border-radius: 14px;
        padding: 0 14px;
        font-size: 16px;
        color: var(--co-text);
        background: #fff;
        outline: none;
        box-sizing: border-box;
    }

    .coord-op-filter input:focus {
        border-color: var(--co-burgundy);
        box-shadow: 0 0 0 3px rgba(122,32,41,.10);
    }

    .coord-op-btn {
        min-height: 48px;
        border: 0;
        border-radius: 14px;
        padding: 0 24px;
        background: linear-gradient(180deg, #922934, var(--co-burgundy));
        color: #fff;
        font-size: 15px;
        font-weight: 900;
        cursor: pointer;
    }

    .coord-op-stats {
        margin-top: 16px;
        display: grid;
        grid-template-columns: repeat(5, minmax(0,1fr));
        gap: 12px;
    }

    .coord-op-stat {
        background: #fff;
        border: 1px solid var(--co-line);
        border-radius: 18px;
        padding: 16px;
        min-height: 120px;
        box-shadow: var(--co-shadow);
    }

    .coord-op-stat small {
        display: block;
        color: var(--co-muted);
        font-size: 12px;
        font-weight: 900;
        text-transform: uppercase;
        letter-spacing: .05em;
    }

    .coord-op-stat strong {
        display: block;
        margin-top: 8px;
        color: var(--co-text);
        font-size: 25px;
        font-weight: 900;
        line-height: 1.1;
        word-break: break-word;
    }

    .coord-op-stat .sub {
        display: block;
        margin-top: 8px;
        color: var(--co-muted);
        font-size: 13px;
        line-height: 1.35;
    }

    .coord-op-stat.pending { border-top: 5px solid var(--co-orange); }
    .coord-op-stat.branch { border-top: 5px solid var(--co-blue); }
    .coord-op-stat.wh { border-top: 5px solid var(--co-green); }
    .coord-op-stat.conn { border-top: 5px solid var(--co-purple); }
    .coord-op-stat.rule { border-top: 5px solid var(--co-burgundy); }

    .coord-op-alert {
        margin-top: 16px;
        border-radius: 18px;
        padding: 16px 18px;
        background: #fff0f1;
        border: 1px solid #efbfc4;
        border-left: 6px solid var(--co-red);
        color: #7b1f28;
        font-size: 14px;
        line-height: 1.45;
    }

    .coord-op-alert code {
        display: inline-block;
        margin-top: 8px;
        background: rgba(255,255,255,.75);
        border: 1px solid #efc6ca;
        border-radius: 8px;
        padding: 5px 8px;
        color: #7b1f28;
    }

    .coord-op-orders {
        margin-top: 16px;
        background: #fff;
        border: 1px solid var(--co-line);
        border-radius: 22px;
        box-shadow: var(--co-shadow);
        overflow: hidden;
    }

    .coord-op-orders-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        padding: 16px 18px;
        background: linear-gradient(180deg, #ffffff, #f5f7f9);
        border-bottom: 1px solid var(--co-line);
    }

    .coord-op-orders-head h2 {
        margin: 0;
        font-size: 23px;
        font-weight: 900;
    }

    .coord-op-orders-head p {
        margin: 4px 0 0;
        color: var(--co-muted);
        font-size: 14px;
    }

    .coord-op-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 50px;
        height: 38px;
        border-radius: 999px;
        background: #fff4dc;
        color: #8d5b00;
        border: 1px solid #efd59b;
        font-size: 15px;
        font-weight: 900;
        padding: 0 12px;
    }

    .coord-op-grid {
        padding: 18px;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(330px, 1fr));
        gap: 14px;
    }

    .coord-op-order {
        border: 1px solid #d5dee5;
        border-left: 6px solid var(--co-orange);
        border-radius: 18px;
        background: #fff;
        padding: 16px;
        display: flex;
        flex-direction: column;
        min-height: 230px;
        transition: .15s ease;
    }

    .coord-op-order:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 28px rgba(20,34,46,.10);
    }

    .coord-op-order-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 12px;
    }

    .coord-op-order .sol {
        color: var(--co-muted);
        font-size: 12px;
        font-weight: 900;
        text-transform: uppercase;
    }

    .coord-op-order .pedido {
        display: block;
        margin-top: 3px;
        color: var(--co-burgundy);
        font-size: 27px;
        line-height: 1.05;
        font-weight: 900;
    }

    .coord-op-badge {
        border-radius: 999px;
        padding: 7px 10px;
        background: #fff3d6;
        color: #8a5a00;
        border: 1px solid #eed59e;
        font-size: 12px;
        font-weight: 900;
        white-space: nowrap;
    }

    .coord-op-client {
        margin-top: 14px;
        font-size: 18px;
        font-weight: 800;
        color: var(--co-text);
        line-height: 1.25;
    }

    .coord-op-meta {
        margin-top: 12px;
        display: grid;
        gap: 7px;
    }

    .coord-op-meta div {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        font-size: 13px;
        border-bottom: 1px dashed #e0e5e9;
        padding-bottom: 6px;
    }

    .coord-op-meta span { color: var(--co-muted); }
    .coord-op-meta strong { color: var(--co-text); text-align: right; }

    .coord-op-open {
        margin-top: auto;
        padding-top: 16px;
        text-decoration: none !important;
        min-height: 48px;
        border-radius: 14px;
        background: linear-gradient(180deg, #2d85ff, var(--co-blue));
        color: #fff !important;
        display: flex;
        align-items: center;
        justify-content: center;
        text-align: center;
        font-size: 15px;
        font-weight: 900;
    }

    .coord-op-empty {
        margin: 18px;
        min-height: 170px;
        display: grid;
        place-items: center;
        text-align: center;
        border: 2px dashed #ccd6dd;
        border-radius: 18px;
        color: var(--co-muted);
        background: #fafbfc;
        padding: 20px;
    }

    .coord-op-empty strong {
        display: block;
        color: var(--co-green);
        font-size: 25px;
        margin-bottom: 5px;
    }

    @@media (max-width: 1200px) {
        .coord-op-hero-grid { grid-template-columns: 1fr; }
        .coord-op-stats { grid-template-columns: repeat(3, minmax(0,1fr)); }
    }

    @@media (max-width: 820px) {
        .coord-op-wrap { padding: 8px; }
        .coord-op-hero { border-radius: 16px; padding: 16px; }
        .coord-op-title { font-size: 27px; }
        .coord-op-actions { grid-template-columns: 1fr; }
        .coord-op-action { min-height: 60px; flex-direction: row; }
        .coord-op-filter { grid-template-columns: 1fr; }
        .coord-op-stats { grid-template-columns: 1fr 1fr; }
        .coord-op-panel,
        .coord-op-orders { border-radius: 16px; }
        .coord-op-grid { padding: 12px; grid-template-columns: 1fr; }
    }

    @@media (max-width: 520px) {
        .coord-op-stats { grid-template-columns: 1fr; }
        .coord-op-panel-head,
        .coord-op-orders-head { align-items: flex-start; }
        .coord-op-order .pedido { font-size: 23px; }
    }
</style>
