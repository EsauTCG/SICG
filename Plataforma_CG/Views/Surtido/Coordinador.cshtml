    }

    .coord-op-filter-refresh {
        grid-template-columns:minmax(0,1fr) 150px !important;
        align-items:center !important;
    }

    .coord-refresh-copy {
        min-width:0;
    }

    .coord-refresh-copy strong {
        display:block;
        color:#263741;
        font-size:9px;
        font-weight:950;
    }

    .coord-refresh-copy span {
        display:block;
        margin-top:2px;
        color:#6c7b85;
        font-size:7px;
        line-height:1.25;
    }

    @@media(max-width:560px) {
        .coord-warehouse-summary {
            grid-template-columns:1fr 1fr;
        }

        .coord-op-filter-refresh {
            grid-template-columns:1fr !important;
        }
    }
</style>


<style id="coord-margen-layout-final">
    /* =========================================================
       MARGEN REAL CONTRA EL VIEWPORT
       Evita que _Layout2 + sidebar empujen Coordinación
       debajo del borde derecho visible.
       ========================================================= */

    body:has(.coord-op-wrap) .layout-main-content {
        min-width:0 !important;
        max-width:100% !important;
        overflow-x:hidden !important;
        box-sizing:border-box !important;
    }

    body:has(.coord-op-wrap) .layout-main-content .layout-container-fluid {
        width:auto !important;
        max-width:100% !important;
        min-width:0 !important;
        margin:0 !important;
        padding:0 !important;
        overflow-x:hidden !important;
        box-sizing:border-box !important;
    }

    .coord-op-wrap {
        /*
           Reserva real del lado derecho:
           sidebar/layout + colchón para scrollbar/borde.
        */
        --coord-layout-reserve:140px;

        width:100% !important;
        max-width:calc(100vw - var(--coord-layout-reserve)) !important;
        min-width:0 !important;

        margin-left:0 !important;
        margin-right:auto !important;

        padding-left:10px !important;
        padding-right:14px !important;

        overflow-x:hidden !important;
        box-sizing:border-box !important;
    }

    .coord-op-shell,
    .coord-op-hero,
    .coord-op-hero-grid,
    .coord-op-actions,
    .coord-op-panel,
    .coord-op-panel-head,
    .coord-op-filter,
    .coord-op-stats,
    .coord-op-stat,
    .coord-op-alert,
    .coord-op-orders,
    .coord-op-orders-head,
    .coord-op-grid,
    .coord-op-order,
    .coord-warehouse-summary,
    .coord-warehouse-chip,
    .coord-priority-help,
    .coord-priority-form {
        min-width:0 !important;
        max-width:100% !important;
        box-sizing:border-box !important;
    }

    .coord-op-shell {
        width:100% !important;
        margin-left:0 !important;
        margin-right:0 !important;
    }

    /* Los hijos de grid/flex sí pueden encogerse */
    .coord-op-hero-grid > *,
    .coord-op-actions > *,
    .coord-op-panel-head > *,
    .coord-op-filter > *,
    .coord-op-stats > *,
    .coord-op-orders-head > *,
    .coord-op-grid > *,
    .coord-op-order-top > *,
    .coord-priority-form > * {
        min-width:0 !important;
    }

    /* Evita que nombres largos de almacenes/clientes empujen el ancho */
    .coord-op-title,
    .coord-op-sub,
    .coord-op-panel-head h2,
    .coord-op-panel-head p,
    .coord-op-stat strong,
    .coord-op-stat .sub,
    .coord-op-orders-head h2,
    .coord-op-orders-head p,
    .coord-op-order .pedido,
    .coord-op-client,
    .coord-op-meta strong,
    .coord-warehouse-chip span,
    .coord-priority-help span {
        overflow-wrap:anywhere !important;
        word-break:break-word !important;
    }

    /* Laptop / escritorio angosto */
    @@media (max-width:1200px) {
        .coord-op-wrap {
            --coord-layout-reserve:115px;
            padding-right:12px !important;
        }
    }

    /* Tablet: el sidebar suele colapsar */
    @@media (max-width:900px) {
        .coord-op-wrap {
            --coord-layout-reserve:28px;
            padding-left:7px !important;
            padding-right:9px !important;
        }
    }

    /* Móvil */
    @@media (max-width:590px) {
        .coord-op-wrap {
            --coord-layout-reserve:14px;
            padding-left:5px !important;
            padding-right:6px !important;
        }
    }

    @@media (max-width:400px) {
        .coord-op-wrap {
            --coord-layout-reserve:8px;
            padding-left:4px !important;
            padding-right:4px !important;
        }
    }
</style>

<div class="coord-op-wrap">
    <div class="coord-op-shell">

        <section class="coord-op-hero">
            <div class="coord-op-hero-grid">
                <div>
                    <div class="coord-op-kicker">◎ Coordinación de Surtido</div>
                    <div class="coord-op-title">Control de la operación</div>
                    <div class="coord-op-sub">
                        @plantaActiva · @Model.Almacenes.Count almacén@(Model.Almacenes.Count == 1 ? "" : "es") · visión completa de la planta
                    </div>
                </div>

                <div class="coord-op-actions">
                    <a class="coord-op-action"
                       href="@Url.Action("ConfiguracionAlmacenes", "Surtido")">
                        <span class="ico">⚙</span>
                        Configurar almacenes
                    </a>

                    <a class="coord-op-action"
                       href="@Url.Action("Mapa3D", "Surtido", new { almacen = Model.Almacen.Codigo })">
                        <span class="ico">▦</span>
                        Mapa 3D
                    </a>

                    <a class="coord-op-action"
                       href="@Url.Action("Surtido_cedis", "Surtido", new { almacen = Model.Almacen.Codigo })">
                        <span class="ico">←</span>
                        Volver al inicio
                    </a>
                </div>
            </div>
        </section>

        @if (TempData["Exito"] != null)
        {
            <div class="coord-op-alert success">
                <strong>✓ Prioridad actualizada.</strong><br />
                @TempData["Exito"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="coord-op-alert">
                <strong>⚠ No fue posible actualizar la prioridad.</strong><br />
                @TempData["Error"]
            </div>
        }

        <section class="coord-op-panel">
            <div class="coord-op-panel-head">
                <div>
                    <h2>Operación completa de @plantaActiva</h2>
                    <p>Se consultan todos los almacenes de la planta y cada pedido conserva su almacén real.</p>
                </div>
            </div>

            <form class="coord-op-filter coord-op-filter-refresh"
                  method="get"
                  action="@Url.Action("Coordinador","Surtido")">

                <input type="hidden"
                       name="almacen"
                       value="@Model.Almacen.Codigo" />

                <div class="coord-refresh-copy">
                    <strong>Todos los pendientes de @plantaActiva</strong>
                    <span>La prioridad no se limita por fecha: se muestran los pedidos pendientes de todos los almacenes de la planta.</span>
                </div>

                <button class="coord-op-btn"
                        type="submit">
                    ACTUALIZAR OPERACIÓN
                </button>
            </form>
        </section>

        <section class="coord-op-stats">
            <article class="coord-op-stat pending">
                <small>Pedidos pendientes</small>
                <strong>@Model.TotalPedidos</strong>
                <span class="sub">Pendientes de todos los almacenes de la planta.</span>
            </article>

            <article class="coord-op-stat branch">
                <small>Planta</small>
                <strong>@plantaActiva</strong>
                <span class="sub">Coordinación por planta completa.</span>
            </article>

            <article class="coord-op-stat wh">
                <small>Almacenes</small>
                <strong>@Model.Almacenes.Count</strong>
                <span class="sub">Todos los configurados en @plantaActiva.</span>
            </article>

            <article class="coord-op-stat conn">
                <small>Conexión</small>
                <strong>@(string.IsNullOrWhiteSpace(Model.NombreConexion) ? "-" : Model.NombreConexion)</strong>
                <span class="sub">Origen de datos actual.</span>
            </article>

            <article class="coord-op-stat rule">
                <small>Colas activas</small>
                <strong>@Model.Almacenes.Count</strong>
                <span class="sub">Una prioridad 1 independiente por almacén.</span>
            </article>
        </section>

        @if (!string.IsNullOrWhiteSpace(Model.Error))
        {
            <div class="coord-op-alert">
                <strong>No se pudieron cargar los pedidos.</strong><br />
                @Model.Error
                <br />
                <code>/Surtido/TestConexion?almacen=@Model.Almacen.Codigo</code>
            </div>
        }
        else
        {
            <section class="coord-op-orders">
                <div class="coord-op-orders-head">
                    <div>
                        <h2>Prioridad de embarques · @plantaActiva</h2>
                        <p>Ves todos los almacenes de la planta. Cada almacén mantiene su propia cola 1, 2, 3...</p>
                    </div>
                    <div class="coord-op-count">@pedidosOrdenados.Count</div>
                </div>

                @if (pedidosOrdenados.Any())
                {
                    <div class="coord-warehouse-summary">
                        @foreach (var almacenItem in Model.Almacenes.OrderBy(x => x.Nombre))
                        {
                            var pedidosAlmacen =
                                pedidosOrdenados.Count(x =>
                                    string.Equals(
                                        x.AlmacenCodigo,
                                        almacenItem.Codigo,
                                        StringComparison.OrdinalIgnoreCase
                                    )
                                );

                            <div class="coord-warehouse-chip @(pedidosAlmacen > 0 ? "has-orders" : "")">
                                <strong>@almacenItem.Codigo</strong>
                                <span>@almacenItem.Nombre</span>
                                <b>@pedidosAlmacen pedido@(pedidosAlmacen == 1 ? "" : "s")</b>
                            </div>
                        }
                    </div>

                    <div class="coord-priority-help">
                        <div class="ico">↕</div>
                        <div>
                            <strong>La prioridad controla la cola de Picking.</strong>
                            <span>
                                Escribe 1 para surtir primero, 2 para después, 3 para el siguiente, etc.
                                Al guardar, el sistema reordena toda la cola del almacén sin dejar prioridades duplicadas.
                            </span>
                        </div>
                    </div>

                    <div class="coord-op-grid">
                        @foreach (var p in pedidosOrdenados)
                        {
                            var clavePrioridad =
                                $"{(p.AlmacenCodigo ?? "").Trim().ToUpperInvariant()}|{p.SolicitudSurtidoId}";

                            var prioridadActual =
                                prioridadesPedido.TryGetValue(
                                    clavePrioridad,
                                    out var prioridadEncontrada
                                )
                                    ? prioridadEncontrada
                                    : 1;

                            var totalColaAlmacen =
                                Math.Max(
                                    1,
                                    pedidosOrdenados.Count(x =>
                                        string.Equals(
                                            x.AlmacenCodigo,
                                            p.AlmacenCodigo,
                                            StringComparison.OrdinalIgnoreCase
                                        )
                                    )
                                );

                            <article class="coord-op-order @(prioridadActual == 1 ? "priority-one" : "")">
                                <div class="coord-op-order-top">
                                    <div>
                                        <span class="sol">Solicitud @p.SolicitudSurtidoId</span>
                                        <span class="pedido">@p.Pedido</span>
                                    </div>
                                    <span class="coord-op-badge @(prioridadActual == 1 ? "priority-one" : "")">
                                        @p.AlmacenCodigo · PRIORIDAD @prioridadActual
                                    </span>
                                </div>

                                <div class="coord-op-client">@p.Cliente</div>

                                <div class="coord-op-meta">
                                    <div>
                                        <span>Fecha / hora</span>
                                        <strong>@p.FechaHora.ToString("dd/MM/yyyy HH:mm")</strong>
                                    </div>
                                    <div>
                                        <span>Sucursal</span>
                                        <strong>@p.AlmacenSucursal</strong>
                                    </div>
                                    <div>
                                        <span>Almacén</span>
                                        <strong>@p.AlmacenCodigo</strong>
                                    </div>
                                </div>

                                <form class="coord-priority-form"
                                      method="post"
                                      action="@Url.Action("AsignarPrioridadPedido", "Surtido")">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="Almacen"
                                           value="@p.AlmacenCodigo" />

                                    <input type="hidden"
                                           name="SolicitudSurtidoId"
                                           value="@p.SolicitudSurtidoId" />

                                    <input type="hidden"
                                           name="FechaInicio"
                                           value="@Model.FechaInicio.ToString("yyyy-MM-dd")" />

                                    <input type="hidden"
                                           name="FechaFin"
                                           value="@Model.FechaFin.ToString("yyyy-MM-dd")" />

                                    <div class="coord-priority-current">
                                        <span>Orden actual</span>
                                        <strong>
                                            #@prioridadActual
                                            @(prioridadActual == 1 ? " · SURTIR AHORA" : "")
                                        </strong>
                                    </div>

                                    <div class="coord-priority-field">
                                        <label>Nueva prioridad</label>
                                        <input type="number"
                                               name="Prioridad"
                                               min="1"
                                               max="@totalColaAlmacen"
                                               value="@prioridadActual"
                                               required />
                                    </div>

                                    <button class="coord-priority-save"
                                            type="submit">
                                        GUARDAR PRIORIDAD
                                    </button>
                                </form>

                                <a class="coord-op-open"
                                   href="@Url.Action(
                                        "PedidoDetalle",
                                        "Surtido",
                                        new
                                        {
                                            almacen = p.AlmacenCodigo,
                                            solicitudSurtidoId = p.SolicitudSurtidoId
                                        }
                                   )">
                                    VER PRODUCTOS
                                </a>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <div class="coord-op-empty">
                        <div>
                            <strong>✓ Sin pendientes</strong>
                            No hay pedidos pendientes en los almacenes de @plantaActiva.
                        </div>
                    </div>
                }
            </section>
        }

    </div>
</div>
