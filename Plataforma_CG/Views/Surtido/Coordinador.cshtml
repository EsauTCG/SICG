<div class="coord-op-wrap">
    <div class="coord-op-shell">

        <section class="coord-op-hero">
            <div class="coord-op-hero-grid">
                <div>
                    <div class="coord-op-kicker">◎ Coordinación de Surtido</div>
                    <div class="coord-op-title">Control de la operación</div>
                    <div class="coord-op-sub">
                        @Model.Almacen.Nombre · @Model.Almacen.Sucursal · @Model.Almacen.Codigo
                    </div>
                </div>

                <div class="coord-op-actions">
                    <a class="coord-op-action"
                       href="@Url.Action("ConfiguracionAlmacenes", "Surtido")">
                        <span class="ico">⚙</span>
                        Configurar almacenes
                    </a>

                    <a class="coord-op-action"
                       href="@Url.Action("Mapa3D", "Surtido", new { almacen = Model.Almacen.Codigo })">
                        <span class="ico">▦</span>
                        Mapa 3D
                    </a>

                    <a class="coord-op-action"
                       href="@Url.Action("Surtido_cedis", "Surtido", new { almacen = Model.Almacen.Codigo })">
                        <span class="ico">←</span>
                        Volver al inicio
                    </a>
                </div>
            </div>
        </section>

        <section class="coord-op-panel">
            <div class="coord-op-panel-head">
                <div>
                    <h2>Consultar operación</h2>
                    <p>Selecciona el rango y actualiza los pedidos pendientes.</p>
                </div>
            </div>

            <form class="coord-op-filter"
                  method="get"
                  action="@Url.Action("Coordinador","Surtido")">

                <input type="hidden"
                       name="almacen"
                       value="@Model.Almacen.Codigo" />

                <div>
                    <label>DESDE</label>
                    <input type="date"
                           name="fechaInicio"
                           value="@Model.FechaInicio.ToString("yyyy-MM-dd")" />
                </div>

                <div>
                    <label>HASTA</label>
                    <input type="date"
                           name="fechaFin"
                           value="@Model.FechaFin.ToString("yyyy-MM-dd")" />
                </div>

                <button class="coord-op-btn"
                        type="submit">
                    CONSULTAR
                </button>
            </form>
        </section>

        <section class="coord-op-stats">
            <article class="coord-op-stat pending">
                <small>Pedidos pendientes</small>
                <strong>@Model.TotalPedidos</strong>
                <span class="sub">Pedidos por revisar en el rango.</span>
            </article>

            <article class="coord-op-stat branch">
                <small>Sucursal</small>
                <strong>@Model.Almacen.Sucursal</strong>
                <span class="sub">Sucursal activa.</span>
            </article>

            <article class="coord-op-stat wh">
                <small>Almacén</small>
                <strong>@Model.Almacen.Codigo</strong>
                <span class="sub">@Model.Almacen.Nombre</span>
            </article>

            <article class="coord-op-stat conn">
                <small>Conexión</small>
                <strong>@(string.IsNullOrWhiteSpace(Model.NombreConexion) ? "-" : Model.NombreConexion)</strong>
                <span class="sub">Origen de datos actual.</span>
            </article>

            <article class="coord-op-stat rule">
                <small>Regla de ubicación</small>
                <strong>
                    @if (!Model.Almacen.TieneConfiguracionUbicacion)
                    {
                        <text>SIN CONFIGURAR</text>
                    }
                    else if (Model.Almacen.ObligaUbicacion)
                    {
                        <text>OBLIGATORIA</text>
                    }
                    else
                    {
                        <text>OPCIONAL</text>
                    }
                </strong>
                <span class="sub">Configuración operativa del almacén.</span>
            </article>
        </section>

        @if (!string.IsNullOrWhiteSpace(Model.Error))
        {
            <div class="coord-op-alert">
                <strong>No se pudieron cargar los pedidos.</strong><br />
                @Model.Error
                <br />
                <code>/Surtido/TestConexion?almacen=@Model.Almacen.Codigo</code>
            </div>
        }
        else
        {
            <section class="coord-op-orders">
                <div class="coord-op-orders-head">
                    <div>
                        <h2>Pedidos pendientes</h2>
                        <p>Pica un pedido para revisar sus productos y continuar el seguimiento.</p>
                    </div>
                    <div class="coord-op-count">@Model.TotalPedidos</div>
                </div>

                @if (Model.Pedidos.Any())
                {
                    <div class="coord-op-grid">
                        @foreach (var p in Model.Pedidos)
                        {
                            <article class="coord-op-order">
                                <div class="coord-op-order-top">
                                    <div>
                                        <span class="sol">Solicitud @p.SolicitudSurtidoId</span>
                                        <span class="pedido">@p.Pedido</span>
                                    </div>
                                    <span class="coord-op-badge">PENDIENTE</span>
                                </div>

                                <div class="coord-op-client">@p.Cliente</div>

                                <div class="coord-op-meta">
                                    <div>
                                        <span>Fecha / hora</span>
                                        <strong>@p.FechaHora.ToString("dd/MM/yyyy HH:mm")</strong>
                                    </div>
                                    <div>
                                        <span>Sucursal</span>
                                        <strong>@Model.Almacen.Sucursal</strong>
                                    </div>
                                    <div>
                                        <span>Almacén</span>
                                        <strong>@Model.Almacen.Codigo</strong>
                                    </div>
                                </div>

                                <a class="coord-op-open"
                                   href="@Url.Action(
                                        "PedidoDetalle",
                                        "Surtido",
                                        new
                                        {
                                            almacen = Model.Almacen.Codigo,
                                            solicitudSurtidoId = p.SolicitudSurtidoId
                                        }
                                   )">
                                    VER PRODUCTOS
                                </a>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <div class="coord-op-empty">
                        <div>
                            <strong>✓ Sin pendientes</strong>
                            No hay pedidos pendientes para el rango seleccionado.
                        </div>
                    </div>
                }
            </section>
        }

