@@media(max-width:800px){.coord-op-wrap{padding:5px!important}.coord-op-hero-grid{grid-template-columns:1fr!important}.coord-op-actions{grid-template-columns:repeat(3,minmax(0,1fr))!important}.coord-op-filter{grid-template-columns:1fr 1fr!important}.coord-op-btn{grid-column:1/-1;width:100%!important}.coord-op-stats{grid-template-columns:repeat(3,minmax(0,1fr))!important}.coord-op-stat .sub{display:none!important}.coord-op-grid{grid-template-columns:repeat(2,minmax(0,1fr))!important}}
