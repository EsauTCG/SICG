<style id="coord-prioridades-embarques">
    /* =========================================================
       PRIORIDAD OPERATIVA DE EMBARQUES / PEDIDOS
       ========================================================= */

    .coord-priority-help {
        margin-top:6px;
        padding:8px 10px;
        display:grid;
        grid-template-columns:30px minmax(0,1fr);
        gap:8px;
        align-items:center;
        border:1px solid #d8c78f;
        border-left:5px solid var(--co-orange);
        border-radius:10px;
        background:#fff9e8;
        color:#665015;
    }

    .coord-priority-help .ico {
        width:30px;
        height:30px;
        display:grid;
        place-items:center;
        border-radius:8px;
        background:#fff0c2;
        font-size:15px;
        font-weight:950;
    }

    .coord-priority-help strong {
        display:block;
        font-size:9px;
        font-weight:950;
    }

    .coord-priority-help span {
        display:block;
        margin-top:2px;
        font-size:7px;
        line-height:1.25;
        font-weight:700;
    }

    .coord-op-order.priority-one {
        border-color:#9bcdb0 !important;
        border-left-color:var(--co-green) !important;
        background:#f8fdf9 !important;
        box-shadow:0 8px 24px rgba(25,135,84,.10) !important;
    }

    .coord-op-badge.priority-one {
        background:#e7f5ed !important;
        color:#17683f !important;
        border-color:#b8ddc7 !important;
    }

    .coord-priority-form {
        margin-top:8px;
        padding:7px;
        display:grid;
        grid-template-columns:minmax(0,1fr) 74px 122px;
        gap:5px;
        align-items:end;
        border:1px solid #d8e0e6;
        border-radius:9px;
        background:#f7f9fa;
    }

    .coord-priority-current {
        min-width:0;
    }

    .coord-priority-current span {
        display:block;
        color:var(--co-muted);
        font-size:6.5px;
        font-weight:900;
        text-transform:uppercase;
    }

    .coord-priority-current strong {
        display:block;
