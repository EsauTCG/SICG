        color:var(--co-burgundy);
        font-size:13px;
        line-height:1;
        font-weight:950;
    }

    .coord-priority-field label {
        display:block;
        margin-bottom:2px;
        color:var(--co-muted);
        font-size:6px;
        font-weight:900;
        text-transform:uppercase;
    }

    .coord-priority-field input {
        width:100%;
        height:31px;
        min-height:31px;
        padding:0 6px;
        border-radius:7px;
        border:1px solid #bdc9d1;
        background:#fff;
        color:var(--co-text);
        font-size:9px;
        font-weight:900;
        text-align:center;
        box-sizing:border-box;
    }

    .coord-priority-save {
        height:31px;
        min-height:31px;
        padding:0 7px;
        border:1px solid var(--co-burgundy-dark);
        border-radius:7px;
        background:linear-gradient(180deg,#922934,var(--co-burgundy));
        color:#fff;
        font-size:7px;
        line-height:1.1;
        font-weight:950;
        cursor:pointer;
    }

    .coord-priority-save:hover {
        filter:brightness(.97);
    }

    .coord-op-alert.success {
        background:#edf9f1 !important;
        border-color:#b9dfc8 !important;
        border-left-color:var(--co-green) !important;
        color:#17683f !important;
    }

    @@media(max-width:700px) {
        .coord-priority-form {
            grid-template-columns:1fr 72px;
        }

        .coord-priority-save {
            grid-column:1 / -1;
            width:100%;
