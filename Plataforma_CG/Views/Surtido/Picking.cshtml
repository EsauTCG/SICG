.pk-pending-box{grid-template-columns:repeat(4,minmax(0,1fr))!important;gap:4px!important;margin-top:7px!important}.pk-pending-box div{padding:5px 6px!important;border-radius:8px!important}.pk-pending-box span{font-size:6px!important}.pk-pending-box strong{font-size:17px!important}.pk-progress-row{margin-top:7px!important}.pk-progress-label{margin-bottom:3px!important;font-size:7px!important}.pk-progress-label strong{font-size:8px!important}.pk-progress{height:7px!important}.pk-open{padding-top:7px!important}.pk-open span{min-height:34px!important;border-radius:9px!important;font-size:9px!important}
@@media(max-width:1050px){.pk-kpis{grid-template-columns:repeat(3,minmax(0,1fr))!important}.pk-filter{grid-template-columns:1.2fr 1fr 1fr!important}.pk-filter button{grid-column:1/-1;width:100%!important}.pk-orders{grid-template-columns:repeat(2,minmax(0,1fr))!important}}
@@media(max-width:760px){.pk-wrap{padding:5px!important}.pk-topbar{display:grid!important;grid-template-columns:1fr!important}.pk-help{display:none!important}.pk-hero{grid-template-columns:1fr 76px!important}.pk-hero p{display:none!important}.pk-kpis{grid-template-columns:repeat(3,minmax(0,1fr))!important}.pk-kpi span{display:none!important}.pk-panel-head p{display:none!important}.pk-filter{grid-template-columns:1fr 1fr!important}.pk-filter .pk-field:first-child{grid-column:1/-1!important}.pk-orders{grid-template-columns:repeat(2,minmax(0,1fr))!important}.pk-order{min-height:185px!important}.pk-order-meta{display:none!important}}
