@model Plataforma_CG.ViewModels.SurtidoModuloPedidosVM

@{
    ViewData["Title"] = "Picking";
    Layout = "~/Views/Shared/_Layout2.cshtml";

    var cajasTotales = Model.Pedidos.Sum(x => x.CajasSolicitadas);
    var cajasProcesadas = Model.Pedidos.Sum(x => x.CajasSurtidas + x.CajasBajadas);

    var eficiencia =
        cajasTotales <= 0
            ? 0
            : Math.Min(
                100,
                (int)Math.Round(
                    cajasProcesadas * 100m / cajasTotales
                )
            );

    var todos = Model.EsTodosAlmacenes;

    // Prioridad calculada y validada por el servidor.
    // El coordinador puede modificarla desde /Surtido/Coordinador.
    var prioridadesBackend =
        ViewBag.PrioridadesPedido as IDictionary<string, int>;

    var prioridadesPorPedido =
        prioridadesBackend != null
            ? new Dictionary<string, int>(
                prioridadesBackend,
                StringComparer.OrdinalIgnoreCase
              )
            : new Dictionary<string, int>(
                StringComparer.OrdinalIgnoreCase
              );

    // Fallback únicamente si el controlador todavía no envía prioridades.
    foreach (var grupo in Model.Pedidos
        .Where(x => x.CajasPendientes > 0)
        .GroupBy(x =>
            (x.AlmacenCodigo ?? "").Trim().ToUpperInvariant()))
    {
        var numero = 0;

        foreach (var pedido in grupo
            .OrderBy(x => x.FechaHora)
            .ThenBy(x => x.SolicitudSurtidoId))
        {
            numero++;

            var clave =
                $"{(pedido.AlmacenCodigo ?? "").Trim().ToUpperInvariant()}|{pedido.SolicitudSurtidoId}";

            if (!prioridadesPorPedido.ContainsKey(clave))
            {
                prioridadesPorPedido[clave] =
                    numero;
            }
        }
    }

    var pedidosOrdenados =
        Model.Pedidos
            .Where(x => x.CajasPendientes > 0)
            .OrderBy(x => x.AlmacenNombre)
            .ThenBy(x =>
            {
                var clave =
                    $"{(x.AlmacenCodigo ?? "").Trim().ToUpperInvariant()}|{x.SolicitudSurtidoId}";

                return prioridadesPorPedido.TryGetValue(
                    clave,
                    out var prioridad
                )
                    ? prioridad
                    : int.MaxValue;
            })
            .ThenBy(x => x.FechaHora)
            .ThenBy(x => x.SolicitudSurtidoId)
            .ToList();
}

