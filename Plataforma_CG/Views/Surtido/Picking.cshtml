    }

    .pk-order::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0;
        bottom: 0;
        width: 7px;
        background: var(--pk-red);
    }

    .pk-order.status-start::before { background: var(--pk-red); }
    .pk-order.status-progress::before { background: var(--pk-orange); }
    .pk-order.status-advanced::before { background: var(--pk-blue); }
    .pk-order.status-done::before { background: var(--pk-green); }

