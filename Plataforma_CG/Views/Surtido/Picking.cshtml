<style id="pk-priority-live-sync-css">
    .pk-sync-dot {
        width:7px;
        height:7px;
        display:inline-block;
        margin-right:5px;
        border-radius:999px;
        background:#198754;
        box-shadow:0 0 0 3px rgba(25,135,84,.12);
        vertical-align:middle;
    }

    .pk-sync-dot.checking {
        background:#d98200;
        box-shadow:0 0 0 3px rgba(217,130,0,.12);
    }

    .pk-sync-dot.error {
        background:#c0392b;
        box-shadow:0 0 0 3px rgba(192,57,43,.12);
    }
</style>

<div class="pk-wrap">
    <main class="pk-shell">

        <div class="pk-topbar">
            <a class="pk-back" href="@Url.Action("Surtido_cedis", "Surtido")">
                ← Regresar al inicio
            </a>
            <div class="pk-help">
                <span id="pk-priority-sync-dot" class="pk-sync-dot"></span>
                Prioridades sincronizadas automáticamente
            </div>
        </div>

        <section class="pk-hero">
            <div>
                <div class="pk-kicker">
                    🚜 MONTACARGUISTA · @(todos ? "TODOS MIS ALMACENES" : Model.FiltroAlmacen)
                </div>

                <h1>
                    Hola, @(string.IsNullOrWhiteSpace(Model.NombreUsuario) ? "Operador" : Model.NombreUsuario)
                </h1>

                <p>
                    Los pedidos están ordenados por prioridad operativa. Debes terminar primero la Prioridad 1;
                    al completarla, el siguiente pedido pasa automáticamente a ser la nueva Prioridad 1.
                </p>
            </div>

            <div class="pk-score">
                <strong>@eficiencia%</strong>
                <span>Avance general</span>
            </div>
        </section>

        <section class="pk-kpis">
            <article class="pk-kpi">
                <div class="pk-kpi-icon">🏭</div>
                <div>
                    <small>Almacenes</small>
                    <strong>@Model.TotalAlmacenesConsultados</strong>
                    <span>@(todos ? "Todos los autorizados" : "Filtro activo")</span>
                </div>
            </article>

            <article class="pk-kpi">
                <div class="pk-kpi-icon">📋</div>
                <div>
                    <small>Pedidos pendientes</small>
                    <strong>@Model.TotalPedidos</strong>
                    <span>Pedidos listos para trabajar</span>
                </div>
            </article>

            <article class="pk-kpi">
                <div class="pk-kpi-icon">📦</div>
                <div>
                    <small>Cajas pendientes</small>
                    <strong>@Model.TotalCajasPendientes</strong>
                    <span>Prioridad operativa</span>
                </div>
            </article>
        </section>

        <section class="pk-panel">
            <div class="pk-panel-head">
                <div>
                    <h2>Filtrar por almacén</h2>
                    <p>La cola siempre incluye todos los pedidos pendientes; la fecha no puede cambiar la prioridad.</p>
                </div>
                <span class="pk-pill">@Model.Almacenes.Count almacén@(Model.Almacenes.Count == 1 ? "" : "es")</span>
            </div>

            <div class="pk-warehouses">
                <a class="pk-wh-btn @(todos ? "active" : "")"
                   href="@Url.Action(
                        "Picking",
                        "Surtido",
                        new { }
                   )">
                    TODOS
                </a>

                @foreach (var a in Model.Almacenes)
                {
                    var activo =
                        !todos &&
                        string.Equals(
                            Model.FiltroAlmacen,
                            a.Codigo,
                            StringComparison.OrdinalIgnoreCase
                        );

                    <a class="pk-wh-btn @(activo ? "active" : "")"
                       href="@Url.Action(
                            "Picking",
                            "Surtido",
                            new
                            {
                                almacen = a.Codigo
                            }
                       )">
                        @a.Codigo · @a.Nombre
                    </a>
                }
            </div>

            <form class="pk-filter pk-filter-priority"
                  method="get"
                  action="@Url.Action("Picking", "Surtido")">

                <div class="pk-field">
                    <label>Almacén</label>
                    <select name="almacen">
                        <option value="">TODOS MIS ALMACENES</option>

                        @foreach (var a in Model.Almacenes)
                        {
                            if (string.Equals(
                                    Model.FiltroAlmacen,
                                    a.Codigo,
                                    StringComparison.OrdinalIgnoreCase))
                            {
                                <option value="@a.Codigo" selected>@a.Codigo · @a.Nombre</option>
                            }
                            else
                            {
                                <option value="@a.Codigo">@a.Codigo · @a.Nombre</option>
                            }
                        }
                    </select>
                </div>

                <button type="submit">VER COLA</button>
            </form>
        </section>

        @if (!string.IsNullOrWhiteSpace(Model.Error))
        {
            <div class="pk-error">⚠️ @Model.Error</div>
        }

        <div class="pk-orders-head">
            <div>
                <h2>Cola de pedidos para surtir</h2>
                <p>Cada almacén tiene su propia cola. Solo la Prioridad 1 de cada almacén está habilitada.</p>
            </div>
            <span class="pk-pill">@Model.NombreConexion</span>
        </div>

        @if (pedidosOrdenados.Any())
        {
            <section class="pk-priority-notice">
                <div class="pk-priority-notice-icon">!</div>
                <div>
                    <strong>Orden obligatorio de surtido</strong>
                    <span>
                        En cada almacén trabaja primero el pedido marcado como <b>PRIORIDAD 1</b>.
                        Al terminarlo, la Prioridad 2 pasa automáticamente a Prioridad 1.
                    </span>
                </div>
            </section>

            <section class="pk-orders">
                @for (var indicePedido = 0; indicePedido < pedidosOrdenados.Count; indicePedido++)
                {
                    var o = pedidosOrdenados[indicePedido];

                    var clavePrioridad =
                        $"{(o.AlmacenCodigo ?? "").Trim().ToUpperInvariant()}|{o.SolicitudSurtidoId}";

                    var prioridadPedido =
                        prioridadesPorPedido.TryGetValue(
                            clavePrioridad,
                            out var prioridadCalculada
                        )
                            ? prioridadCalculada
                            : int.MaxValue;

                    var esPrioridadActiva = prioridadPedido == 1;

                    var urlPedido =
                        Url.Action(
                            "PedidoPicking",
                            "Surtido",
                            new
                            {
                                almacen = o.AlmacenCodigo,
                                solicitudSurtidoId = o.SolicitudSurtidoId
                            }
                        );
                    var statusClass =
                        o.AvancePorcentaje >= 100
                            ? "status-done"
                            : o.AvancePorcentaje >= 70
                                ? "status-advanced"
                                : o.AvancePorcentaje > 0
                                    ? "status-progress"
                                    : "status-start";

                    <a class="pk-order @statusClass @(esPrioridadActiva ? "priority-active" : "priority-locked")"
                       href="@(esPrioridadActiva ? urlPedido : "javascript:void(0);")"
                       aria-disabled="@(esPrioridadActiva ? "false" : "true")"
                       data-prioridad="@prioridadPedido"
                       data-locked="@(esPrioridadActiva ? "false" : "true")"
                       data-priority-key="@clavePrioridad">

                        <div class="pk-priority-row">
                            <span class="pk-priority-badge @(esPrioridadActiva ? "active" : "waiting")">
                                PRIORIDAD @prioridadPedido · @o.AlmacenCodigo
                            </span>

                            @if (esPrioridadActiva)
                            {
                                <span class="pk-priority-state active">
                                    ● SURTIR AHORA
                                </span>
                            }
                            else
                            {
                                <span class="pk-priority-state waiting">
                                    🔒 EN ESPERA
                                </span>
                            }
                        </div>

                        <div class="pk-order-top">
                            <div>
                                <span class="pk-order-label">Pedido</span>
                                <strong class="pk-order-number">@o.Pedido</strong>
                            </div>

                            <div class="pk-warehouse-badge">
                                🏭 @o.AlmacenCodigo · @o.Planta<br />
                                @o.AlmacenNombre
                            </div>
                        </div>

                        <div class="pk-client">@o.Cliente</div>

                        <div class="pk-order-meta">
                            Solicitud @o.SolicitudSurtidoId · @o.FechaHora.ToString("dd/MM/yyyy HH:mm")<br />
                            @o.AlmacenSucursal · @o.AlmacenClasificacion
                        </div>

                        <div class="pk-pending-box">
                            <div class="pending">
                                <span>Pendientes</span>
                                <strong>@o.CajasPendientes</strong>
                            </div>
                            <div>
                                <span>Solicitadas</span>
                                <strong>@o.CajasSolicitadas</strong>
                            </div>
                            <div>
                                <span>Bajadas</span>
                                <strong>@o.CajasBajadas</strong>
                            </div>
                            <div>
                                <span>Surtidas</span>
                                <strong>@o.CajasSurtidas</strong>
                            </div>
                        </div>

                        <div class="pk-progress-row">
                            <div class="pk-progress-label">
                                <span>Avance del pedido</span>
                                <strong>@o.AvancePorcentaje%</strong>
                            </div>
                            <div class="pk-progress">
                                <i style="width:@o.AvancePorcentaje%"></i>
                            </div>
                        </div>

                        <div class="pk-open">
                            @if (esPrioridadActiva)
                            {
                                <span>SURTIR PRIORIDAD 1 →</span>
                            }
                            else
                            {
                                <span class="locked">
                                    🔒 TERMINA PRIORIDAD @(prioridadPedido - 1) DE @o.AlmacenCodigo
                                </span>
                            }
                        </div>
                    </a>
                }
            </section>
        }
        else
        {
            <div class="pk-empty">
                <div>
                    <div style="font-size:42px;margin-bottom:8px;">✅</div>
                    @if (todos)
                    {
                        <text>
                            No hay pedidos pendientes en tus almacenes autorizados.
                        </text>
                    }
                    else
                    {
                        <text>
                            No hay pedidos pendientes en el almacén @Model.FiltroAlmacen.
                        </text>
                    }
                </div>
            </div>
        }

    </main>
</div>


<script>
document.addEventListener("DOMContentLoaded", function () {

    // ---------------------------------------------------------
    // 1. Bloqueo visual existente de prioridades no activas.
    // ---------------------------------------------------------
    document.querySelectorAll('.pk-order[data-locked="true"]').forEach(function (pedido) {
        pedido.addEventListener("click", function (event) {
            event.preventDefault();
            event.stopPropagation();
        });

        pedido.addEventListener("keydown", function (event) {
            if (event.key === "Enter" || event.key === " ") {
                event.preventDefault();
            }
        });
    });


    // ---------------------------------------------------------
    // 2. Sincronización automática con Coordinación.
    //
    // IMPORTANTE:
    // Este chequeo ya NO reconstruye colas completas de MEAT.
    // Sólo compara prioridades de SIGO + una firma mínima de IDs pendientes.
    // ---------------------------------------------------------
    const syncDot =
        document.getElementById("pk-priority-sync-dot");

    const filtroAlmacen =
        @Html.Raw(
            System.Text.Json.JsonSerializer.Serialize(
                Model.FiltroAlmacen ?? ""
            )
        );

    const endpointBase =
        @Html.Raw(
            System.Text.Json.JsonSerializer.Serialize(
                Url.Action(
                    "PrioridadesPicking",
                    "Surtido"
                ) ?? "/Surtido/PrioridadesPicking"
            )
        );

    let firmaVista =
        @Html.Raw(
            System.Text.Json.JsonSerializer.Serialize(
                (string?)ViewBag.FirmaPrioridades ?? ""
            )
        );

    let consultando = false;
    let recargando = false;

    async function revisarPrioridades() {
        if (consultando || recargando) {
            return;
        }

        if (document.hidden) {
            return;
        }

        consultando = true;

        if (syncDot) {
            syncDot.classList.add("checking");
            syncDot.classList.remove("error");
        }

        try {
            let url =
                endpointBase
                + "?_="
                + Date.now();

            if (filtroAlmacen) {
                url +=
                    "&almacen="
                    + encodeURIComponent(
                        filtroAlmacen
                    );
            }

            const response =
                await fetch(
                    url,
                    {
                        method: "GET",
                        cache: "no-store",
                        headers: {
                            "X-Requested-With":
                                "XMLHttpRequest"
                        }
                    }
                );

            if (!response.ok) {
                throw new Error(
                    "HTTP " + response.status
                );
            }

            const data =
                await response.json();

            if (!data || data.ok !== true) {
                throw new Error(
                    "Respuesta inválida"
                );
            }

            const firmaNueva =
                String(data.firma || "");

            if (firmaNueva !== firmaVista) {
                recargando = true;
                window.location.reload();
                return;
            }

            if (syncDot) {
                syncDot.classList.remove(
                    "checking",
                    "error"
                );
            }
        }
        catch (error) {
            if (syncDot) {
                syncDot.classList.remove(
                    "checking"
                );

                syncDot.classList.add(
                    "error"
                );
            }
        }
        finally {
            consultando = false;
        }
    }

    // Primer chequeo después de que la pantalla ya terminó de cargar.
    window.setTimeout(
        revisarPrioridades,
        5000
    );

    // Antes: cada 1.5 segundos reconstruyendo colas completas de MEAT.
    // Ahora: cada 15 segundos con una consulta de sincronización mínima.
    window.setInterval(
        revisarPrioridades,
        15000
    );

    document.addEventListener(
        "visibilitychange",
        function () {
            if (!document.hidden) {
                revisarPrioridades();
            }
        }
    );

    window.addEventListener(
        "focus",
        revisarPrioridades
    );
});
</script>

