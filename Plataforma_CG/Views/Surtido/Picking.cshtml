</style>

<style id="pk-margen-layout-final">
    /* =========================================================
       AJUSTE FINAL DE ANCHO CONTRA EL VIEWPORT
       Evita que _Layout2 + sidebar empujen esta vista fuera
       del borde derecho visible.
       ========================================================= */

    body:has(.pk-wrap) .layout-main-content,
    body:has(.pk-wrap) .layout-container-fluid,
    body:has(.pk-wrap) .container,
    body:has(.pk-wrap) .container-fluid {
        min-width:0 !important;
        box-sizing:border-box !important;
    }

    .pk-wrap {
        /* Reserva: sidebar/layout + colchón derecho visible */
        --pk-layout-reserve:140px;

        width:100% !important;
        max-width:calc(100vw - var(--pk-layout-reserve)) !important;
        min-width:0 !important;
        margin-left:0 !important;
        margin-right:auto !important;
        overflow-x:hidden !important;
        box-sizing:border-box !important;
    }

    .pk-shell,
    .pk-topbar,
    .pk-hero,
    .pk-kpis,
    .pk-kpi,
    .pk-panel,
    .pk-panel-head,
    .pk-warehouses,
    .pk-filter,
    .pk-field,
    .pk-orders-head,
    .pk-orders,
    .pk-order,
    .pk-order-top,
    .pk-pending-box,
    .pk-progress-row {
        min-width:0 !important;
        max-width:100% !important;
        box-sizing:border-box !important;
    }

    .pk-shell {
        width:100% !important;
        margin-left:0 !important;
        margin-right:0 !important;
    }

    /* Los hijos de grid/flex deben poder encogerse */
    .pk-hero > *,
    .pk-kpis > *,
    .pk-panel-head > *,
    .pk-filter > *,
    .pk-orders-head > *,
    .pk-orders > *,
    .pk-order-top > *,
    .pk-pending-box > * {
        min-width:0 !important;
    }

    /* Textos largos no deben ampliar tarjetas o filtros */
    .pk-hero h1,
    .pk-hero p,
    .pk-help,
    .pk-kpi small,
    .pk-kpi strong,
    .pk-kpi span,
    .pk-panel-head h2,
    .pk-panel-head p,
    .pk-pill,
    .pk-wh-btn,
    .pk-order-number,
    .pk-warehouse-badge,
    .pk-client,
    .pk-order-meta,
    .pk-pending-box span,
    .pk-pending-box strong {
        overflow-wrap:anywhere;
        word-break:break-word;
    }

    .pk-field select,
    .pk-field input,
    .pk-filter button {
        max-width:100% !important;
        min-width:0 !important;
        box-sizing:border-box !important;
    }

    /* Laptop: conserva margen derecho sin desperdiciar demasiado ancho */
    @@media (max-width:1200px) {
        .pk-wrap {
            --pk-layout-reserve:115px;
        }
    }

    /* Tablet: normalmente el sidebar cambia/colapsa */
    @@media (max-width:900px) {
        .pk-wrap {
            --pk-layout-reserve:28px;
        }
    }

    @@media (max-width:590px) {
        .pk-wrap {
            --pk-layout-reserve:14px;
        }
    }
</style>



<style id="pk-prioridad-obligatoria-final">
    /* =========================================================
       COLA OBLIGATORIA DE PEDIDOS
       Prioridad 1 = pedido pendiente más antiguo (FechaHora).
       ========================================================= */

    .pk-priority-notice {
        min-width:0;
        max-width:100%;
        box-sizing:border-box;

        margin-top:6px;
        padding:8px 10px;

        display:grid;
        grid-template-columns:30px minmax(0,1fr);
        gap:8px;
        align-items:center;

        background:#fff8e7;
        border:1px solid #efd69a;
        border-left:5px solid var(--pk-orange);
        border-radius:10px;
    }

    .pk-priority-notice-icon {
        width:30px;
        height:30px;
        display:grid;
        place-items:center;

        border-radius:8px;
        background:#fff0c9;
        color:#8b6500;

        font-size:14px;
        font-weight:950;
    }

    .pk-priority-notice strong {
        display:block;
        color:#604a10;
        font-size:9px;
        font-weight:950;
    }

    .pk-priority-notice span {
        display:block;
        margin-top:2px;
        color:#776326;
        font-size:7px;
        line-height:1.3;
        font-weight:700;
    }

    .pk-priority-row {
        display:flex;
        align-items:center;
        justify-content:space-between;
        gap:6px;
        flex-wrap:wrap;

        margin:-2px 0 7px;
        padding-left:4px;
    }

    .pk-priority-badge,
    .pk-priority-state {
        min-height:25px;
        display:inline-flex;
        align-items:center;
        justify-content:center;

        padding:0 8px;
        border-radius:999px;

        font-size:7px;
        line-height:1;
        font-weight:950;
        letter-spacing:.03em;
        white-space:nowrap;
    }

    .pk-priority-badge.active {
        background:#e7f5ed;
        color:#17683f;
        border:1px solid #b8ddc7;
    }

    .pk-priority-state.active {
        background:#198754;
        color:#fff;
        border:1px solid #146c43;
    }

    .pk-priority-badge.waiting {
        background:#f0f3f5;
        color:#65737d;
        border:1px solid #d5dde2;
    }

    .pk-priority-state.waiting {
        background:#eceff1;
        color:#697780;
        border:1px solid #d3dbe0;
    }

    /* Prioridad 1: se destaca visualmente */
    .pk-order.priority-active {
        border-color:#8cc7a6 !important;
        border-left-color:#198754 !important;
        background:#f8fdf9 !important;
        box-shadow:0 8px 24px rgba(25,135,84,.10) !important;
    }

    .pk-order.priority-active::before {
        background:#198754 !important;
    }

    .pk-order.priority-active .pk-open span {
        background:linear-gradient(180deg,#25a765,#198754) !important;
        border-color:#146c43 !important;
    }

    /* Prioridades siguientes: visibles, pero no seleccionables */
    .pk-order.priority-locked {
        cursor:not-allowed !important;
        opacity:.72;
        background:#f4f6f7 !important;
        border-color:#d6dde1 !important;
        box-shadow:none !important;
    }

    .pk-order.priority-locked::before {
        background:#9ba7ae !important;
    }

    .pk-order.priority-locked:hover {
        transform:none !important;
        box-shadow:none !important;
        border-color:#d6dde1 !important;
    }

    .pk-order.priority-locked .pk-open span.locked {
        background:#a5afb5 !important;
        border-color:#929da4 !important;
        color:#fff !important;
    }

    .pk-order.priority-locked .pk-progress > i {
        opacity:.55;
    }

    @@media(max-width:590px) {
        .pk-priority-notice {
            grid-template-columns:26px minmax(0,1fr);
        }

        .pk-priority-notice-icon {
            width:26px;
            height:26px;
        }

        .pk-priority-row {
            align-items:stretch;
        }

        .pk-priority-badge,
        .pk-priority-state {
            flex:1 1 auto;
            white-space:normal;
            text-align:center;
        }
    }
</style>


