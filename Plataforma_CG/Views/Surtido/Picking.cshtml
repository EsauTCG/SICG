        .pk-score { min-width: 0; min-height: 82px; flex-direction: row; gap: 10px; }
        .pk-score strong { font-size: 29px; }
        .pk-score span { margin: 0; font-size: 14px; }
        .pk-kpis { grid-template-columns: 1fr; }
        .pk-filter { grid-template-columns: 1fr; }
        .pk-orders { grid-template-columns: 1fr; }
        .pk-order { min-height: auto; }
        .pk-panel, .pk-orders-head { border-radius: 15px; }
