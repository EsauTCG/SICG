        .pk-warehouses { display: grid; grid-template-columns: 1fr; }
        .pk-wh-btn { width: 100%; }
        .pk-order-top { flex-direction: column; }
        .pk-warehouse-badge { max-width: 100%; width: 100%; text-align: left; }
        .pk-pending-box { grid-template-columns: 1fr 1fr; }
    }
</style>
