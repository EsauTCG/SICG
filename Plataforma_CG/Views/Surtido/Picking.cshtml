@model Plataforma_CG.ViewModels.SurtidoModuloPedidosVM

@{
    ViewData["Title"] = "Picking";
    Layout = "~/Views/Shared/_Layout2.cshtml";

    var cajasTotales =
        Model.Pedidos.Sum(x =>
            x.CajasSolicitadas
        );

    var cajasProcesadas =
        Model.Pedidos.Sum(x =>
            x.CajasSurtidas
            +
            x.CajasBajadas
        );

    var eficiencia =
        cajasTotales <= 0
            ? 0
            : Math.Min(
                100,
                (int)Math.Round(
                    cajasProcesadas
                    * 100m
                    / cajasTotales
                )
            );

    var todos =
        Model.EsTodosAlmacenes;
}

<link rel="stylesheet"
      href="~/css/surtido-wms-v7.css"
      asp-append-version="true" />

<style>
    .wms-warehouse-filter{
        display:flex;
        gap:6px;
        flex-wrap:wrap;
        margin:10px 0 13px;
    }

    .wms-warehouse-filter a{
        text-decoration:none!important;
        border:1px solid var(--wms-line);
        border-radius:999px;
        background:#0c1c2e;
        color:#88a6c4!important;
        padding:6px 9px;
        font-size:7px;
        font-weight:950;
    }

    .wms-warehouse-filter a.active{
        background:#267fff;
        border-color:#267fff;
        color:#fff!important;
    }

    .wms-order-warehouse{
        display:inline-flex;
        align-items:center;
        gap:4px;
        border:1px solid rgba(47,140,255,.26);
        background:rgba(47,140,255,.08);
        color:#7ab9ff;
        border-radius:999px;
        padding:4px 6px;
        font-size:7px;
        font-weight:950;
    }

    .wms-order-place{
        margin-top:7px;
        display:flex;
        flex-wrap:wrap;
        gap:5px;
    }

    .wms-order-place span{
        color:#7691ac;
        font-size:7px;
    }

    .wms-filter select{
        background:#081522;
        border:1px solid #274463;
        color:#fff;
        border-radius:10px;
        padding:9px;
        min-height:36px;
        outline:0;
    }
</style>



