<div class="pk-wrap">
    <main class="pk-shell">

        <div class="pk-topbar">
            <a class="pk-back" href="@Url.Action("Surtido_cedis", "Surtido")">
                ← Regresar al inicio
            </a>
            <div class="pk-help">Selecciona un pedido y toca <strong>ABRIR PEDIDO</strong>.</div>
        </div>

        <section class="pk-hero">
            <div>
                <div class="pk-kicker">
                    🚜 MONTACARGUISTA · @(todos ? "TODOS MIS ALMACENES" : Model.FiltroAlmacen)
                </div>

                <h1>
                    Hola, @(string.IsNullOrWhiteSpace(Model.NombreUsuario) ? "Operador" : Model.NombreUsuario)
                </h1>

                <p>
                    Aquí están tus pedidos para surtir. Busca el pedido, revisa las cajas pendientes y toca el botón azul para empezar.
                    Cada pedido conserva su propio almacén para trabajar correctamente.
                </p>
            </div>

            <div class="pk-score">
                <strong>@eficiencia%</strong>
                <span>Avance general</span>
            </div>
        </section>

        <section class="pk-kpis">
            <article class="pk-kpi">
                <div class="pk-kpi-icon">🏭</div>
                <div>
                    <small>Almacenes</small>
                    <strong>@Model.TotalAlmacenesConsultados</strong>
                    <span>@(todos ? "Todos los autorizados" : "Filtro activo")</span>
                </div>
            </article>

            <article class="pk-kpi">
                <div class="pk-kpi-icon">📋</div>
                <div>
                    <small>Pedidos pendientes</small>
                    <strong>@Model.TotalPedidos</strong>
                    <span>Pedidos listos para trabajar</span>
                </div>
            </article>

            <article class="pk-kpi">
                <div class="pk-kpi-icon">📦</div>
                <div>
                    <small>Cajas pendientes</small>
                    <strong>@Model.TotalCajasPendientes</strong>
                    <span>Prioridad operativa</span>
                </div>
            </article>
        </section>

        <section class="pk-panel">
            <div class="pk-panel-head">
                <div>
                    <h2>Filtrar pedidos</h2>
                    <p>Toca un almacén o cambia las fechas si necesitas buscar otro pedido.</p>
                </div>
                <span class="pk-pill">@Model.Almacenes.Count almacén@(Model.Almacenes.Count == 1 ? "" : "es")</span>
            </div>

            <div class="pk-warehouses">
                <a class="pk-wh-btn @(todos ? "active" : "")"
                   href="@Url.Action(
                        "Picking",
                        "Surtido",
                        new
                        {
                            fechaInicio = Model.FechaInicio.ToString("yyyy-MM-dd"),
                            fechaFin = Model.FechaFin.ToString("yyyy-MM-dd")
                        }
                   )">
                    TODOS
                </a>

                @foreach (var a in Model.Almacenes)
                {
                    var activo =
                        !todos &&
                        string.Equals(
                            Model.FiltroAlmacen,
                            a.Codigo,
                            StringComparison.OrdinalIgnoreCase
                        );

                    <a class="pk-wh-btn @(activo ? "active" : "")"
                       href="@Url.Action(
                            "Picking",
                            "Surtido",
                            new
                            {
                                almacen = a.Codigo,
                                fechaInicio = Model.FechaInicio.ToString("yyyy-MM-dd"),
                                fechaFin = Model.FechaFin.ToString("yyyy-MM-dd")
                            }
                       )">
                        @a.Codigo · @a.Nombre
                    </a>
                }
            </div>

            <form class="pk-filter"
                  method="get"
                  action="@Url.Action("Picking", "Surtido")">

                <div class="pk-field">
                    <label>Almacén</label>
                    <select name="almacen">
                        <option value="">TODOS MIS ALMACENES</option>

                        @foreach (var a in Model.Almacenes)
                        {
                            if (string.Equals(
                                    Model.FiltroAlmacen,
                                    a.Codigo,
                                    StringComparison.OrdinalIgnoreCase))
                            {
                                <option value="@a.Codigo" selected>@a.Codigo · @a.Nombre</option>
                            }
                            else
                            {
                                <option value="@a.Codigo">@a.Codigo · @a.Nombre</option>
                            }
                        }
                    </select>
                </div>

                <div class="pk-field">
                    <label>Desde</label>
                    <input type="date"
                           name="fechaInicio"
                           value="@Model.FechaInicio.ToString("yyyy-MM-dd")" />
                </div>

                <div class="pk-field">
                    <label>Hasta</label>
                    <input type="date"
                           name="fechaFin"
                           value="@Model.FechaFin.ToString("yyyy-MM-dd")" />
                </div>

                <button type="submit">Aplicar filtros</button>
            </form>
        </section>

        @if (!string.IsNullOrWhiteSpace(Model.Error))
        {
            <div class="pk-error">⚠️ @Model.Error</div>
        }

        <div class="pk-orders-head">
            <div>
                <h2>Mis pedidos para surtir</h2>
                <p>Los que tienen más cajas pendientes necesitan más trabajo.</p>
            </div>
            <span class="pk-pill">@Model.NombreConexion</span>
        </div>

        @if (Model.Pedidos.Any())
        {
            <section class="pk-orders">
                @foreach (var o in Model.Pedidos)
                {
                    var statusClass =
                        o.AvancePorcentaje >= 100
                            ? "status-done"
                            : o.AvancePorcentaje >= 70
                                ? "status-advanced"
                                : o.AvancePorcentaje > 0
                                    ? "status-progress"
                                    : "status-start";

                    <a class="pk-order @statusClass"
                       href="@Url.Action(
                            "PedidoPicking",
                            "Surtido",
                            new
                            {
                                // CRÍTICO: el pedido siempre abre con SU almacén.
                                almacen = o.AlmacenCodigo,
                                solicitudSurtidoId = o.SolicitudSurtidoId
                            }
                       )">

                        <div class="pk-order-top">
                            <div>
                                <span class="pk-order-label">Pedido</span>
                                <strong class="pk-order-number">@o.Pedido</strong>
                            </div>

                            <div class="pk-warehouse-badge">
                                🏭 @o.AlmacenCodigo · @o.Planta<br />
                                @o.AlmacenNombre
                            </div>
                        </div>

                        <div class="pk-client">@o.Cliente</div>

                        <div class="pk-order-meta">
                            Solicitud @o.SolicitudSurtidoId · @o.FechaHora.ToString("dd/MM/yyyy HH:mm")<br />
                            @o.AlmacenSucursal · @o.AlmacenClasificacion
                        </div>

                        <div class="pk-pending-box">
                            <div class="pending">
                                <span>Pendientes</span>
                                <strong>@o.CajasPendientes</strong>
                            </div>
                            <div>
                                <span>Solicitadas</span>
                                <strong>@o.CajasSolicitadas</strong>
                            </div>
                            <div>
                                <span>Bajadas</span>
                                <strong>@o.CajasBajadas</strong>
                            </div>
                            <div>
                                <span>Surtidas</span>
                                <strong>@o.CajasSurtidas</strong>
                            </div>
                        </div>

                        <div class="pk-progress-row">
                            <div class="pk-progress-label">
                                <span>Avance del pedido</span>
                                <strong>@o.AvancePorcentaje%</strong>
                            </div>
                            <div class="pk-progress">
                                <i style="width:@o.AvancePorcentaje%"></i>
                            </div>
                        </div>

                        <div class="pk-open">
                            <span>ABRIR PEDIDO →</span>
                        </div>
                    </a>
                }
            </section>
        }
        else
        {
            <div class="pk-empty">
                <div>
                    <div style="font-size:42px;margin-bottom:8px;">✅</div>
                    @if (todos)
                    {
                        <text>
                            No hay pedidos pendientes en tus almacenes autorizados para las fechas seleccionadas.
                        </text>
                    }
                    else
                    {
                        <text>
                            No hay pedidos pendientes en el almacén @Model.FiltroAlmacen para las fechas seleccionadas.
                        </text>
                    }
                </div>
            </div>
        }

    </main>
</div>
