@model Plataforma_CG.ViewModels.SurtidoModuloPedidosVM

@{
    ViewData["Title"] = "Picking";
    Layout = "~/Views/Shared/_Layout2.cshtml";

    var cajasTotales = Model.Pedidos.Sum(x => x.CajasSolicitadas);
    var cajasProcesadas = Model.Pedidos.Sum(x => x.CajasSurtidas + x.CajasBajadas);

    var eficiencia =
        cajasTotales <= 0
            ? 0
            : Math.Min(
                100,
                (int)Math.Round(
                    cajasProcesadas * 100m / cajasTotales
                )
            );

    var todos = Model.EsTodosAlmacenes;
}

<style>
