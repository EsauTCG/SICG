@{
    ViewBag.Title = "Configurar Imagen para Carrusel";
    Layout = "~/Views/Shared/_Layout2.cshtml";
}

@await Html.PartialAsync("_KpiAdminTheme")

<style>
    /* ============================================================
           CREAR CARRUSEL - AJUSTE VISUAL
        ============================================================ */

    .carousel-create-page .dashboard-panel {
        overflow: visible;
    }

    .upload-layout {
        display: grid;
        grid-template-columns: minmax(0, 1.1fr) minmax(320px, 0.9fr);
        gap: 1.25rem;
        align-items: stretch;
    }

    .drop-zone {
        border: 2px dashed var(--kpi-border-strong);
        border-radius: 16px;
        padding: 3rem 2rem;
        text-align: center;
        background: var(--kpi-panel-soft);
        cursor: pointer;
        transition: all 0.25s ease;
        min-height: 330px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--kpi-text);
    }

        .drop-zone:hover {
            border-color: var(--brand-main);
            transform: translateY(-2px);
            box-shadow: var(--kpi-shadow);
        }

        .drop-zone.drag-over {
            border-color: var(--brand-main);
            background: rgba(122, 11, 11, 0.06);
            transform: scale(1.01);
        }

        .drop-zone.has-file {
            border-color: #16a34a;
            background: rgba(22, 163, 74, 0.08);
        }

    .drop-zone-icon {
        width: 76px;
        height: 76px;
        border-radius: 20px;
        background: rgba(122, 11, 11, 0.10);
        color: var(--brand-main);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
        border: 1px solid rgba(122, 11, 11, 0.18);
    }

        .drop-zone-icon i {
            font-size: 2.6rem;
        }

    body[data-theme="dark"] .drop-zone-icon {
        background: rgba(248,113,113,0.12);
        color: #fca5a5;
        border-color: rgba(248,113,113,0.30);
    }

    body[data-theme="dark"] .drop-zone.drag-over {
        background: rgba(248,113,113,0.10);
    }

    body[data-theme="dark"] .drop-zone.has-file {
        border-color: #4ade80;
        background: rgba(34,197,94,0.10);
    }

    .upload-help-card {
        background: var(--kpi-card-bg);
        border: 1px solid var(--kpi-border);
        border-radius: 16px;
        box-shadow: var(--kpi-shadow);
        padding: 1.25rem;
        height: 100%;
    }

    .help-item {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        padding: 0.75rem 0;
        border-bottom: 1px solid var(--kpi-border);
    }

        .help-item:last-child {
            border-bottom: none;
        }

    .help-icon {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        background: rgba(122, 11, 11, 0.08);
        color: var(--brand-main);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    body[data-theme="dark"] .help-icon {
        background: rgba(248,113,113,0.12);
        color: #fca5a5;
    }

    .file-info-card {
        border-radius: 14px;
        border: 1px solid rgba(59,130,246,0.28);
        background: rgba(59,130,246,0.08);
        color: var(--kpi-text);
        padding: 0.9rem 1rem;
        display: none;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
    }

    body[data-theme="dark"] .file-info-card {
        background: rgba(59,130,246,0.12);
        border-color: rgba(59,130,246,0.30);
    }

    .preview-card {
        display: none;
        margin-top: 1rem;
    }

    .preview-frame {
        border: 1px solid var(--kpi-border);
        border-radius: 16px;
        background: var(--kpi-panel-soft);
        padding: 0.75rem;
        box-shadow: var(--kpi-shadow);
    }

        .preview-frame img {
            width: 100%;
            max-height: 360px;
            object-fit: contain;
            border-radius: 12px;
            display: block;
            background: #111827;
        }

    .dynamic-message {
        display: none;
    }

    @@media (max-width: 992px) {
        .upload-layout {
            grid-template-columns: 1fr;
        }

        .drop-zone {
            min-height: 280px;
        }
    }

    @@media (max-width: 576px) {
        .drop-zone {
            padding: 2rem 1rem;
        }
    }
</style>

<div class="container-fluid py-4 px-3 px-md-4 container-custom carousel-create-page">

    <div class="top-banner d-flex justify-content-between align-items-center flex-wrap gap-3 shadow-sm">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-image me-2"></i> Nueva Imagen de Carrusel
            </h2>
            <p class="mb-0" style="font-size: 0.85rem; opacity: 0.85;">
                Sube una imagen para el carrusel principal y posteriormente asígnala a perfiles específicos.
            </p>
        </div>

        <div>
            <a class="btn btn-sm btn-outline-light fw-bold px-3 border-2" href="@Url.Action("CarouselConfiguracion", "Permisos")">
                <i class="bi bi-arrow-left-circle me-1"></i> Regresar
            </a>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-3 mb-4">

        <div class="action-group shadow-sm">
            <div class="action-label">
                <i class="bi bi-sliders me-1"></i> Acciones
            </div>

            <div class="d-flex gap-2">
                <button type="button" id="btnGuardar" class="btn-rojo">
                    <i class="bi bi-save"></i> Guardar
                </button>

                <button type="button" class="btn-rojo" onclick="location.href='@Url.Action("CarouselConfiguracion", "Permisos")'">
                    <i class="bi bi-x-lg"></i> Cancelar
                </button>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <div class="stat-card">
                <div class="stat-label">Formato</div>
                <div class="stat-value" style="font-size:1rem;">JPG / PNG</div>
            </div>

            <div class="stat-card">
                <div class="stat-label">Máximo</div>
                <div class="stat-value" style="font-size:1rem;">5 MB</div>
            </div>

            <div class="stat-card">
                <div class="stat-label">Sugerido</div>
                <div class="stat-value" style="font-size:1rem;">1920×600</div>
            </div>
        </div>

    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Exito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["Exito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div id="mensajeDinamico" class="alert dynamic-message"></div>

    <div class="dashboard-panel">
        <div class="dashboard-panel-head">
            <div>
                <h6 class="dashboard-panel-title">
                    <i class="bi bi-upload me-1"></i> Datos de la Imagen
                </h6>
                <p class="dashboard-panel-subtitle">
                    Arrastra la imagen o haz clic en el recuadro para seleccionarla desde tu equipo.
                </p>
            </div>
        </div>

        <div class="p-3 p-md-4">
            <form id="frmCarousel" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()

                <div class="upload-layout">

                    <div>
                        <label class="form-label fw-bold text-muted small">IMAGEN DEL CARRUSEL</label>

                        <div id="dropZone" class="drop-zone">
                            <div>
                                <div class="drop-zone-icon">
                                    <i class="bi bi-cloud-upload"></i>
                                </div>

                                <h5 class="fw-bold text-dark mb-2">Arrastra tu imagen aquí</h5>
                                <p class="text-muted mb-1">o haz clic para seleccionar un archivo</p>
                                <small class="text-muted d-block mt-2">
                                    JPG, PNG o GIF · Máximo 5MB · Resolución sugerida 1024×320 a 1920×600 px
                                </small>
                            </div>
                        </div>

                        <div id="fileInfo" class="file-info-card mt-3">
                            <div>
                                <i class="bi bi-file-earmark-image me-1"></i>
                                <strong id="fileName"></strong>
                            </div>

                            <button type="button" class="btn btn-sm btn-outline-danger fw-bold" onclick="limpiarArchivo()">
                                <i class="bi bi-x-lg"></i> Quitar
                            </button>
                        </div>

                        <div id="preview" class="preview-card">
                            <label class="form-label fw-bold text-muted small">VISTA PREVIA</label>

                            <div class="preview-frame">
                                <img id="imgPreview" src="" alt="Vista previa de imagen" />
                            </div>
                        </div>
                    </div>

                    <div>
                        <div class="upload-help-card">
                            <h6 class="fw-bold text-dark mb-3">
                                <i class="bi bi-info-circle me-1"></i> Recomendaciones
                            </h6>

                            <div class="help-item">
                                <div class="help-icon">
                                    <i class="bi bi-aspect-ratio"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-dark">Tamaño panorámico</div>
                                    <small class="text-muted">
                                        Usa imágenes horizontales para evitar recortes extraños en el carrusel.
                                    </small>
                                </div>
                            </div>

                            <div class="help-item">
                                <div class="help-icon">
                                    <i class="bi bi-file-earmark-image"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-dark">Peso recomendado</div>
                                    <small class="text-muted">
                                        Mantén el archivo debajo de 5MB para no afectar la carga de la página.
                                    </small>
                                </div>
                            </div>

                            <div class="help-item">
                                <div class="help-icon">
                                    <i class="bi bi-shield-check"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-dark">Asignación posterior</div>
                                    <small class="text-muted">
                                        Después de subirla, podrás decidir si se muestra a todos o solo a un perfil.
                                    </small>
                                </div>
                            </div>

                            <div class="help-item">
                                <div class="help-icon">
                                    <i class="bi bi-eye"></i>
                                </div>
                                <div>
                                    <div class="fw-bold text-dark">Vista previa</div>
                                    <small class="text-muted">
                                        Antes de guardar podrás revisar visualmente que la imagen sea correcta.
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

    <script>
        console.log('🟢 Script Drag & Drop iniciado');

        let archivoSeleccionado = null;

        const dropZone = document.getElementById('dropZone');
        const preview = document.getElementById('preview');
        const imgPreview = document.getElementById('imgPreview');
        const fileInfo = document.getElementById('fileInfo');
        const fileName = document.getElementById('fileName');

        ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
            dropZone.addEventListener(eventName, preventDefaults, false);
            document.body.addEventListener(eventName, preventDefaults, false);
        });

        function preventDefaults(e) {
            e.preventDefault();
            e.stopPropagation();
        }

        ['dragenter', 'dragover'].forEach(eventName => {
            dropZone.addEventListener(eventName, () => {
                dropZone.classList.add('drag-over');
            }, false);
        });

        ['dragleave', 'drop'].forEach(eventName => {
            dropZone.addEventListener(eventName, () => {
                dropZone.classList.remove('drag-over');
            }, false);
        });

        dropZone.addEventListener('drop', handleDrop, false);

        function handleDrop(e) {
            const dt = e.dataTransfer;
            const files = dt.files;
            handleFiles(files);
        }

        dropZone.addEventListener('click', () => {
            const input = document.createElement('input');
            input.type = 'file';
            input.accept = 'image/*';
            input.onchange = (e) => handleFiles(e.target.files);
            input.click();
        });

        function handleFiles(files) {
            if (files.length === 0) return;

            const file = files[0];
            console.log('📁 Archivo recibido:', file.name);

            if (!file.type.startsWith('image/')) {
                mostrarMensaje('Solo se permiten imágenes', 'danger');
                return;
            }

            if (file.size > 5 * 1024 * 1024) {
                mostrarMensaje('La imagen no debe superar los 5MB', 'danger');
                return;
            }

            archivoSeleccionado = file;

            fileName.textContent = file.name + ' (' + formatBytes(file.size) + ')';
            fileInfo.style.display = 'flex';
            dropZone.classList.add('has-file');

            const reader = new FileReader();

            reader.onload = (e) => {
                imgPreview.src = e.target.result;
                preview.style.display = 'block';
                console.log('🖼️ Preview generado');
            };

            reader.readAsDataURL(file);
        }

        function limpiarArchivo() {
            archivoSeleccionado = null;
            fileInfo.style.display = 'none';
            preview.style.display = 'none';
            imgPreview.src = '';
            dropZone.classList.remove('has-file');
            console.log('🗑️ Archivo limpiado');
        }

        document.getElementById('btnGuardar').addEventListener('click', function(e) {
            console.log('💾 === INICIO SUBMIT ===');
            e.preventDefault();

            if (!archivoSeleccionado) {
                mostrarMensaje('Debe seleccionar una imagen', 'danger');
                return;
            }

            const formData = new FormData();
            formData.append('imagen', archivoSeleccionado);

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;

            mostrarMensaje('Subiendo imagen...', 'info');

            fetch('@Url.Action("CrearCarousel", "Permisos")', {
                method: 'POST',
                body: formData,
                headers: {
                    'RequestVerificationToken': token
                }
            })
            .then(response => {
                console.log('📡 Response:', response.status);

                if (response.ok || response.redirected) {
                    window.location.href = '@Url.Action("CarouselConfiguracion", "Permisos")';
                } else {
                    return response.text().then(text => {
                        console.error('❌ Error:', text);
                        mostrarMensaje('Error del servidor: ' + response.status, 'danger');
                    });
                }
            })
            .catch(error => {
                console.error('❌ Error de red:', error);
                mostrarMensaje('Error: ' + error.message, 'danger');
            });
        });

        function mostrarMensaje(texto, tipo) {
            const div = document.getElementById('mensajeDinamico');

            const icono = tipo === 'danger'
                ? 'exclamation-triangle'
                : tipo === 'success'
                    ? 'check-circle'
                    : 'info-circle';

            div.className = 'alert alert-' + tipo + ' alert-dismissible fade show mt-3';
            div.innerHTML = `
                <i class="bi bi-${icono}-fill me-2"></i>
                ${texto}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            `;

            div.style.display = 'block';
        }

        function formatBytes(bytes) {
            if (bytes === 0) return '0 Bytes';

            const k = 1024;
            const sizes = ['Bytes', 'KB', 'MB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));

            return Math.round(bytes / Math.pow(k, i) * 100) / 100 + ' ' + sizes[i];
        }

        console.log('🟢 Script cargado completamente');
    </script>
}