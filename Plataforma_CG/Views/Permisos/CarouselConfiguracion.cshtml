@model List<CarouselPerfil>
@using System.Linq

@{
    ViewBag.Title = "Configurar Carrusel";
    Layout = "~/Views/Shared/_Layout2.cshtml";

    var totalImagenes = Model?.Count ?? 0;
    var totalActivas = Model?.Count(x => x.Activo) ?? 0;
    var totalTodos = Model?.Count(x => x.PerfilId == 0) ?? 0;
}

@await Html.PartialAsync("_KpiAdminTheme")

<style>
    /* ============================================================
           CONFIGURACIÓN CARRUSEL - AJUSTE VISUAL
        ============================================================ */

    .carousel-config-page .dashboard-panel {
        overflow: visible;
    }

    .carousel-config-page .table-responsive {
        max-height: 68vh;
        overflow: auto;
    }

    .carousel-img {
        width: 180px;
        height: 78px;
        object-fit: cover;
        border-radius: 14px;
        border: 1px solid var(--kpi-border);
        box-shadow: var(--kpi-shadow);
        background: var(--kpi-panel-soft);
    }

    .carousel-img-wrap {
        display: flex;
        align-items: center;
        gap: 0.8rem;
    }

    .carousel-img-meta {
        min-width: 0;
    }

    .carousel-img-title {
        color: var(--kpi-text-strong);
        font-weight: 900;
        margin: 0;
        line-height: 1.15;
    }

    .carousel-img-sub {
        color: var(--kpi-text-muted);
        font-size: 0.76rem;
        font-weight: 700;
        margin: 0.25rem 0 0;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.32rem 0.65rem;
        border-radius: 999px;
        background: rgba(107,114,128,0.10);
        border: 1px solid var(--kpi-border);
        color: var(--kpi-text-muted);
        font-size: 0.76rem;
        font-weight: 900;
        white-space: nowrap;
    }

        .status-badge .dot {
            width: 8px;
            height: 8px;
            border-radius: 999px;
            background: #6b7280;
        }

        .status-badge.saved {
            background: rgba(34,197,94,0.12);
            color: #198754;
            border-color: rgba(34,197,94,0.28);
        }

            .status-badge.saved .dot {
                background: #22c55e;
            }

        .status-badge.error {
            background: rgba(220,38,38,0.12);
            color: #dc2626;
            border-color: rgba(220,38,38,0.28);
        }

            .status-badge.error .dot {
                background: #dc2626;
            }

    body[data-theme="dark"] .status-badge.saved {
        color: #bbf7d0;
        border-color: rgba(34,197,94,0.35);
    }

    body[data-theme="dark"] .status-badge.error {
        color: #fecaca;
        border-color: rgba(248,113,113,0.35);
    }

    .switch {
        position: relative;
        width: 48px;
        height: 26px;
        display: inline-block;
    }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

    .slider {
        position: absolute;
        cursor: pointer;
        inset: 0;
        background: #cbd5e1;
        border-radius: 999px;
        transition: .25s;
        border: 1px solid rgba(0,0,0,0.08);
    }

        .slider::before {
            content: "";
            position: absolute;
            height: 20px;
            width: 20px;
            left: 2px;
            top: 2px;
            background: #ffffff;
            border-radius: 50%;
            transition: .25s;
            box-shadow: 0 2px 6px rgba(0,0,0,.25);
        }

    .switch input:checked + .slider {
        background: linear-gradient(90deg,#16a34a,#22c55e);
    }

        .switch input:checked + .slider::before {
            transform: translateX(22px);
        }

    body[data-theme="dark"] .slider {
        background: #4b5563;
        border-color: rgba(255,255,255,0.12);
    }

        body[data-theme="dark"] .slider::before {
            background: #e5e7eb;
        }

    tr.saving {
        opacity: .55;
    }

    tr.saved {
        outline: 2px solid rgba(34,197,94,0.75);
        outline-offset: -2px;
    }

    tr.error {
        outline: 2px solid rgba(220,38,38,0.75);
        outline-offset: -2px;
    }

    .orden-input {
        width: 90px;
        text-align: center;
        font-weight: 800;
    }

    .modal-content {
        border-radius: 14px;
        border: 1px solid var(--kpi-border);
        overflow: hidden;
        background: var(--kpi-card-bg);
        color: var(--kpi-text);
    }

    .modal-header {
        background: var(--kpi-panel-bg);
        border-bottom: 1px solid var(--kpi-border);
        color: var(--kpi-text-strong);
    }

    .modal-footer {
        background: var(--kpi-panel-soft);
        border-top: 1px solid var(--kpi-border);
    }

    body[data-theme="dark"] .modal-content {
        background: #111827;
        border-color: rgba(255,255,255,0.12);
    }

    body[data-theme="dark"] .btn-close {
        filter: invert(1);
    }

    @@media (max-width: 992px) {
        .carousel-config-page .table-responsive {
            max-height: none;
        }

        .carousel-img {
            width: 140px;
            height: 66px;
        }
    }

    @@media (max-width: 576px) {
        .carousel-img-wrap {
            flex-direction: column;
            align-items: flex-start;
        }

        .carousel-img {
            width: 100%;
            height: 120px;
        }
    }
</style>

<div class="container-fluid py-4 px-3 px-md-4 container-custom carousel-config-page">

    <div class="top-banner d-flex justify-content-between align-items-center flex-wrap gap-3 shadow-sm">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-images me-2"></i> Configuración de Carrusel
            </h2>
            <p class="mb-0" style="font-size: 0.85rem; opacity: 0.85;">
                Administra las imágenes visibles en el carrusel y define si aplican para todos o para perfiles específicos.
            </p>
        </div>

        <div>
            <a asp-action="CrearCarousel" class="btn btn-sm btn-outline-light fw-bold px-3 border-2">
                <i class="bi bi-plus-circle me-1"></i> Nueva Imagen
            </a>
        </div>
    </div>

    <div class="d-flex flex-wrap gap-3 mb-4">

        <div class="action-group shadow-sm">
            <div class="action-label">
                <i class="bi bi-sliders me-1"></i> Acciones
            </div>

            <div class="d-flex gap-2">
                <button class="btn-rojo" type="button" onclick="location.reload()">
                    <i class="bi bi-arrow-clockwise"></i> Refrescar
                </button>

                <button class="btn-rojo" type="button" onclick="location.href='/Home/Inicio'">
                    <i class="bi bi-door-closed"></i> Salir
                </button>
            </div>
        </div>

        <div class="action-group shadow-sm">
            <div class="action-label">
                <i class="bi bi-search me-1"></i> Buscar
            </div>

            <div class="d-flex gap-2 flex-wrap">
                <div class="input-group input-group-sm" style="min-width:280px;">
                    <span class="input-group-text">
                        <i class="bi bi-funnel"></i>
                    </span>
                    <input id="searchCarousel"
                           class="form-control"
                           type="search"
                           placeholder="Buscar por perfil, estado u orden..." />
                </div>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <div class="stat-card">
                <div class="stat-label">Imágenes</div>
                <div class="stat-value">@totalImagenes</div>
            </div>

            <div class="stat-card">
                <div class="stat-label">Activas</div>
                <div class="stat-value">@totalActivas</div>
            </div>

            <div class="stat-card">
                <div class="stat-label">Para todos</div>
                <div class="stat-value">@totalTodos</div>
            </div>
        </div>

    </div>

    <div class="dashboard-panel">
        <div class="dashboard-panel-head">
            <div>
                <h6 class="dashboard-panel-title">
                    <i class="bi bi-sliders me-1"></i> Imágenes del Carrusel
                </h6>
                <p class="dashboard-panel-subtitle">
                    Los cambios se guardan automáticamente al modificar perfil, estado u orden.
                </p>
            </div>
        </div>

        <div class="p-3">
            @Html.AntiForgeryToken()

            <div class="table-responsive border rounded">
                <table class="table table-custom table-hover align-middle mb-0" id="tablaCarousel">
                    <thead>
                        <tr>
                            <th style="min-width: 310px;">Imagen</th>
                            <th style="min-width: 220px;">Perfil</th>
                            <th class="text-center" style="width: 120px;">Activo</th>
                            <th style="width: 120px;">Orden</th>
                            <th style="width: 140px;">Estado</th>
                            <th class="text-end" style="width: 100px;">Eliminar</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="6">
                                    <div class="empty-state">
                                        <i class="bi bi-images"></i>
                                        <span class="fw-bold">No hay imágenes configuradas.</span><br />
                                        <small>Usa el botón “Nueva Imagen” para agregar la primera imagen del carrusel.</small>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr data-id="@item.Id">
                                    <td>
                                        <div class="carousel-img-wrap">
                                            <img src="@item.ImagenUrl"
                                                 class="carousel-img"
                                                 alt="Imagen carrusel" />

                                            <div class="carousel-img-meta">
                                                <p class="carousel-img-title">Imagen #@item.Id</p>
                                                <p class="carousel-img-sub">
                                                    Orden actual: @item.Orden
                                                </p>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <select class="form-select form-select-sm perfil">
                                            <option value="0" selected="@(item.PerfilId == 0)">Todos los perfiles</option>

                                            @foreach (var p in ViewBag.Perfiles)
                                            {
                                                <option value="@p.Id" selected="@(item.PerfilId == p.Id)">
                                                    @p.Nombre
                                                </option>
                                            }
                                        </select>
                                    </td>

                                    <td class="text-center">
                                        <label class="switch">
                                            <input type="checkbox" class="activo" @(item.Activo ? "checked" : "") />
                                            <span class="slider"></span>
                                        </label>
                                    </td>

                                    <td>
                                        <input type="number"
                                               class="form-control form-control-sm orden orden-input"
                                               value="@item.Orden" />
                                    </td>

                                    <td>
                                        <span class="status-badge estado">
                                            <span class="dot"></span>
                                            <span class="txt">Listo</span>
                                        </span>
                                    </td>

                                    <td class="text-end">
                                        <button type="button" class="btn btn-sm btn-outline-danger fw-bold btn-eliminar">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="modal fade" id="modalEliminar" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>
                        Confirmar eliminación
                    </h5>

                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>

                <div class="modal-body p-4">
                    <p class="mb-1 fw-bold text-dark">¿Estás seguro que deseas eliminar esta imagen del carrusel?</p>
                    <p class="text-muted small mb-0">
                        Esta acción no se puede deshacer.
                    </p>
                </div>

                <div class="modal-footer gap-2">
                    <button type="button" class="btn btn-outline-secondary fw-bold" data-bs-dismiss="modal">
                        <i class="bi bi-x-lg me-1"></i> Cancelar
                    </button>

                    <button type="button" class="btn btn-danger fw-bold" id="btnConfirmarEliminar">
                        <i class="bi bi-trash me-1"></i> Eliminar
                    </button>
                </div>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />

    <script>
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        const debounce = (fn, delay = 500) => {
            let t;

            return (...args) => {
                clearTimeout(t);
                t = setTimeout(() => fn(...args), delay);
            };
        };

        function setEstado(row, estado, texto) {
            const badge = row.querySelector(".estado");
            const txt = row.querySelector(".txt");

            if (!badge || !txt) return;

            badge.classList.remove("saved", "error");

            if (estado === "saved") {
                badge.classList.add("saved");
            }

            if (estado === "error") {
                badge.classList.add("error");
            }

            txt.textContent = texto;
        }

        document.querySelectorAll("tr[data-id]").forEach(row => {

            const save = debounce(async () => {

                row.classList.add("saving");
                row.classList.remove("saved", "error");
                setEstado(row, "", "Guardando...");

                const payload = {
                    Id: parseInt(row.dataset.id),
                    PerfilId: parseInt(row.querySelector(".perfil").value),
                    Activo: row.querySelector(".activo").checked,
                    Orden: parseInt(row.querySelector(".orden").value)
                };

                try {
                    const resp = await fetch("/Permisos/GuardarCarouselAjax", {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json",
                            "RequestVerificationToken": token
                        },
                        body: JSON.stringify(payload)
                    });

                    if (!resp.ok) throw "error";

                    row.classList.remove("saving");
                    row.classList.add("saved");
                    setEstado(row, "saved", "Guardado");

                    setTimeout(() => {
                        row.classList.remove("saved");
                        setEstado(row, "", "Listo");
                    }, 1000);
                }
                catch (e) {
                    console.error(e);
                    row.classList.remove("saving");
                    row.classList.add("error");
                    setEstado(row, "error", "Error");
                }

            }, 600);

            row.querySelectorAll("select, input").forEach(el =>
                el.addEventListener("change", save)
            );
        });

        let rowToDelete = null;

        document.querySelectorAll(".btn-eliminar").forEach(btn => {
            btn.addEventListener("click", e => {
                e.stopPropagation();
                rowToDelete = btn.closest("tr");

                const modal = new bootstrap.Modal(document.getElementById('modalEliminar'));
                modal.show();
            });
        });

        document.getElementById("btnConfirmarEliminar")?.addEventListener("click", async () => {
            if (!rowToDelete) return;

            const id = rowToDelete.dataset.id;
            const modal = bootstrap.Modal.getInstance(document.getElementById('modalEliminar'));

            modal.hide();
            rowToDelete.classList.add("saving");

            try {
                const resp = await fetch("/Permisos/EliminarCarouselAjax", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json",
                        "RequestVerificationToken": token
                    },
                    body: JSON.stringify({
                        Id: parseInt(id)
                    })
                });

                if (!resp.ok) throw "error";

                rowToDelete.style.transition = "opacity .3s, transform .3s";
                rowToDelete.style.opacity = 0;
                rowToDelete.style.transform = "translateX(20px)";

                setTimeout(() => rowToDelete.remove(), 300);
            }
            catch (e) {
                console.error(e);
                alert("No se pudo eliminar la imagen.");
                rowToDelete.classList.remove("saving");
            }

            rowToDelete = null;
        });

        const searchCarousel = document.getElementById("searchCarousel");

        searchCarousel?.addEventListener("input", () => {
            const txt = (searchCarousel.value || "").toLowerCase().trim();

            document.querySelectorAll("#tablaCarousel tbody tr[data-id]").forEach(row => {
                const contenido = row.textContent.toLowerCase();
                row.style.display = !txt || contenido.includes(txt) ? "" : "none";
            });
        });
    </script>
}